<!-- TTS 播放器控制区 -->
<view class="flex-column" style="background-color: transparent;">
  

  <!-- 播放中/暂停状态：白色药丸形状播放器 -->
  <!-- <block wx:else=""> -->
    <view class="player-container">
      <view class="player-pill">
        <!-- 左侧按钮组 -->
        <view class="player-controls-left">
          <!-- 停止按钮 -->
          <view wx:if="{{isPlaying || isLoading}}" bindtap="onPause" class="player-control">
            <view class="control-icon stop-icon">⏸</view>
            <text class="control-text">停止</text>
          </view>
          
          <!-- 再朗读按钮 -->
          <view wx:if="{{isPaused && !isPlaying && !isLoading}}" bindtap="onRestart" class="player-control">
            <view class="control-icon replay-icon">↻</view>
            <text class="control-text">再朗读</text>
          </view>
          
          <!-- 关闭按钮 -->
          <view wx:if="{{isPaused && !isPlaying && !isLoading}}" bindtap="onColse" class="player-control">
            <view class="control-icon close-icon">✕</view>
            <text class="control-text">关闭</text>
          </view>
        </view>
        
        <!-- 启动按钮（右侧）- 绿色小喇叭图标（可拖拽隐藏） -->
        <view bindtap="reuploadOrders">
        
          <image src="/images/del.png" class="play-icon-green" mode="aspectFit" style="width: 48rpx; height: 48rpx;"></image>
        </view>

        <view bindtap="closeCheck">
          <image src="/images/edit-3.png" class="play-icon-green" mode="aspectFit" style="width: 48rpx; height: 48rpx;"></image>
        </view>
        <view 
         
          class="player-control play-control-right"
          catchtouchstart="onPlayButtonTouchStart"
          catchtouchmove="onPlayButtonTouchMove"
          catchtouchend="onPlayButtonTouchEnd"
        >
        
          <image src="/images/laba.png" class="play-icon-green" mode="aspectFit" style="width: 48rpx; height: 48rpx;"></image>
        </view>

        <view wx:if="{{isPaused && !isPlaying && !isLoading}}" bindtap="onContinue" class="player-control play-control-right" style="margin-right: 20rpx;">
          <image src="/images/laba.png" class="play-icon-green" mode="aspectFit" style="width: 48rpx; height: 48rpx;"></image>
          <text class="control-text">继续</text>

        </view>
      </view>
    </view>
  <!-- </block> -->
 
</view>

