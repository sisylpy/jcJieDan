<wxs src="/utils/fn.wxs" module="tool" />


<view class="order-list-container">
  <!-- 全屏识别文本弹窗（使用 root-portal 渲染到页面根节点，突破 movable-area 等组件的层级限制） -->
  <root-portal>
    <view class="recognition-modal-mask" wx:if="{{showRecognitionModal}}" catchtap="onCancelRecognition">
      <view class="recognition-modal-content" catchtap="stopPropagation">
        <view class="recognition-modal-header">
          <view class="flex-column">
            <text class="recognition-modal-title">ai语音助手</text>
            <view style="font-size: 24rpx;">
              <text>帮您修改、删除、添加订单</text>
            </view>
          </view>
          <view class="recognition-modal-close" bindtap="onCancelRecognition">×</view>
        </view>

        <view class="recognition-modal-body">
          <view class="recognition-text-display">{{recognitionText || (isRecording ? '正在录音...' : '')}}</view>
        </view>
        <view class="recognition-modal-footer">
          <!-- <view wx:if="{{isRecording}}" class="btn-stop-record btn-secondary" bindtap="onStopRecord">停止录音</view> -->
          <view wx:if="{{isRecording}}" class="btn-rerecord btn-secondary" bindtap="onReRecord">重新录入</view>
          <view class="btn-cancel btn-secondary" bindtap="onCancelRecognition">关闭</view>
          <view class="btn-ai-parse btn-ai" bindtap="onAIParseRecognition">确认</view>
        </view>
      </view>
    </view>
  </root-portal>


  <view wx:for="{{list}}" wx:for-index="orderIndex" wx:key="orderIndex">

    <!-- 订单项 -->
    <view id="order-item-{{orderIndex}}"
      class="flex-column border-bottom p-20 font-lg order-item {{activeIndex == orderIndex && isPlaying ? 'orderReading' : (stoppedIndex == orderIndex && !isPlaying ? 'orderstop' : (orderArrIndex == orderIndex ? 'orderEditing' : ''))}} {{recentlyModifiedOrderIndex == orderIndex ? 'order-recently-modified' : ''}} {{deletingIndex == orderIndex ? 'order-deleting' : ''}} {{(activeIndex != orderIndex || !isPlaying) && (stoppedIndex != orderIndex || isPlaying) && orderArrIndex != orderIndex && recentlyModifiedOrderIndex != orderIndex && deletingIndex != orderIndex && item.nxDoStatus >= 0 ? (item.nxDoPurchaseStatus == 4 ? 'bg-white' : 'liziBack') : ''}} {{(activeIndex != orderIndex || !isPlaying) && (stoppedIndex != orderIndex || isPlaying) && orderArrIndex != orderIndex && recentlyModifiedOrderIndex != orderIndex && deletingIndex != orderIndex && item.nxDoStatus >= 0 ? (item.nxDoPurchaseStatus == 5 ? 'liziDelivery' : '') : ''}} {{(activeIndex != orderIndex || !isPlaying) && (stoppedIndex != orderIndex || isPlaying) && orderArrIndex != orderIndex && recentlyModifiedOrderIndex != orderIndex && deletingIndex != orderIndex && item.nxDoStatus >= 0 ? (item.nxDoPurchaseStatus == 3 ? 'liziClock' : '') : ''}} {{(activeIndex != orderIndex || !isPlaying) && (stoppedIndex != orderIndex || isPlaying) && orderArrIndex != orderIndex && recentlyModifiedOrderIndex != orderIndex && deletingIndex != orderIndex && item.nxDoStatus >= 0 ? (item.nxDoPurchaseStatus == 1 ? 'liziCollBack' : '') : ''}}">
      <view class="flex-column">
        <view class="flex-row-default order-main-row">
          <view class="flex-row-default ">
            <view class="flex-row" style="width: 60rpx; text-align: center;">
              <text class="text-secondary">{{orderIndex + 1}}.</text>
            </view>
            <view class="flex-row" style="position: relative; flex: 1; min-width: 0; max-width: 100%;">
              <!-- 已保存订单：显示商品名称 -->
              <view class="goods-name-row flex-row-wrap" wx:if="{{item.nxDoStatus !== -2}}"
                style="width: {{windowWidth / 3 + 80}}rpx;">
                <text wx:if="{{item.nxDistributerGoodsEntity.nxDgDistributerId !== disId}}"
                  class="distributer-tag font-xs mainColor">[{{item.nxDistributerGoodsEntity.nxDgDistributerName}}]</text>
                <text class="goods-name font-md">{{item.nxDoGoodsName}}</text>

                <text wx:if="{{item.standardWeight !== 'null' && item.standardWeight !== ''}}"
                  class="goods-standard font-md">({{item.standardWeight}}/{{item.itemUnit}})</text>
                <text wx:else class="goods-standard font-md">({{item.itemUnit}})</text>
                <text wx:if="{{item.cartonUnit !== '' && item.itemsPerCarton !== ''}}"
                  class="goods-carton font-md">*{{item.itemsPerCarton}}{{item.itemUnit}}</text>
                <text wx:if="{{item.cartonUnit !== ''}}"
                  class="goods-carton font-md">{{item.cartonUnit}}</text>
              </view>

              <!-- 草稿订单：可编辑商品名称（确认后搜索） -->
              <input wx:else
                class="input {{item.nxDoQuantity == '' || item.nxDoStandard == '' ? 'slock' : ''}} {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}"
                type="text" bindfocus="onFocusOrderIndex" bindinput="onEditOrderName" bindconfirm="onConfirmSearch"
                bindblur="onBlurSearch" data-type="name" data-index="{{orderIndex}}" value="{{item.nxDoGoodsName}}"
                adjust-position="true" placeholder="商品名称"
                style="width: {{windowWidth / 3 }}rpx;margin-right: 20rpx; "
                disabled="{{item.nxDoQuantity == '' || item.nxDoStandard == '' ? true : false}}" />

              <block
                wx:if="{{item.nxDoStatus == -2 && (item.nxDistributerGoodsEntityList.length > 0  || item.nxGoodsEntities.length > 0 || (orderArrIndex == orderIndex && (strArr.length > 0 || nxArr.length > 0)))}}">
                <view class="toggle-btn flex-column-center" bind:tap="onShowGoodsList" data-index="{{orderIndex}}"
                  style="margin-right: 20rpx;">
                  <image wx:if="{{item.nxDoIsAgent == '2'}}" src="/images/arrow-down-3.png" mode="aspectFill"
                    class="icon-sm toggle-arrow-up" />
                  <image wx:else src="/images/arrow-down-3.png" mode="aspectFill" class="icon-sm toggle-arrow-down" />
                </view>
              </block>
              <view wx:else="">
                <view class="p-20" style="width: 40rpx;">
                </view>
              </view>
            </view>
          </view>

          <!-- 数量 -->
          <text wx:if="{{item.nxDoStatus !== -2}}"
            style="width: {{(windowWidth / 7 - 50)}}rpx; text-align: center;">{{item.nxDoQuantity}}</text>
          <input wx:else class="input input-quantity {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}"
            type="digit" bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder"
            data-type="quantity" data-index="{{orderIndex}}" value="{{item.nxDoQuantity}}"
            style="width: {{(windowWidth / 7)}}rpx; text-align: center; margin-right: 20rpx;" placeholder="数量"
            placeholder-style="font-size: 24rpx; color: #999;" />
          <!-- 规格 -->
          <text wx:if="{{item.nxDoStatus !== -2}}"
            style="width: {{(windowWidth / 7 - 50)}}rpx; text-align: center; margin-right: 100rpx;">{{item.nxDoStandard || '规格'}}</text>
          <input wx:else class="input input-standard {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}"
            type="text" bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder"
            data-type="standard" data-index="{{orderIndex}}" value="{{item.nxDoStandard}}"
            style="width: {{windowWidth / 7}}rpx; text-align: center; margin-right: 20rpx;" placeholder="规格"
            placeholder-style="font-size: 24rpx; color: #999;" />

          <!-- 三点操作按钮：绝对定位在右侧，保证始终完整显示 -->
          <view class="points-btn" bindtap="onShowPasteOperation" data-index="{{orderIndex}}">
            <image src="/images/points.png" mode="aspectFill" class="icon" />
          </view>

        </view>


        <!-- 规格编辑（特殊规格） -->
        <view class="flex-row p-20 bg-white"
          wx:if="{{item.standardWeight !== '' && item.standardWeight !== '500g' && item.nxDoStatus == '-2'}}">
          <view class="flex-row ml-10">
            <input class="input p-10 {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}" type="text"
              bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder" data-type="standard"
              data-index="{{orderIndex}}" value="{{item.standardWeight}}" style="width: {{windowWidth / 5}}rpx;"
              placeholder="规格" />
            <text class="pl-10 pr-10">/</text>
            <input class="input p-10 {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}" type="text"
              bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder" data-type="standard"
              data-index="{{orderIndex}}" value="{{item.itemUnit}}" style="width: {{windowWidth / 8}}rpx;"
              placeholder="规格" />
            <block>
              <view class="flex-row ml-10" wx:if="{{item.cartonUnit !== ''}}">
                <block wx:if="{{item.itemsPerCarton !== ''}}">
                  <text class="pl-10 pr-10">*</text>
                  <input class="input p-10 {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}"
                    type="text" bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder"
                    data-type="standard" data-index="{{orderIndex}}" value="{{item.itemsPerCarton}}"
                    style="width: {{windowWidth / 8}}rpx;" />
                  <text>{{item.itemUnit}}/</text>
                </block>
                <input wx:if="{{item.cartonUnit !== ''}}"
                  class="input p-10 {{orderArrIndex == orderIndex ? 'status-draft' : 'status-saved'}}" type="text"
                  bindfocus="onFocusOrderIndex" bindblur="onBlurOrderIndex" bindinput="onEditOrder" data-type="standard"
                  data-index="{{orderIndex}}" value="{{item.cartonUnit}}" style="width: {{windowWidth / 8}}rpx;" />
              </view>
            </block>
          </view>
        </view>

        <!-- 备注（有内容时显示，或点击添加备注后显示输入框） -->
        <view class="flex-row p-20" wx:if="{{(item.nxDoRemark && item.nxDoRemark.length > 0) || item.nxDoAddRemark}}">
          <text class="text-secondary mr-10  font-sl" style="margin-left: 40rpx;">备注:</text>
          <text wx:if="{{item.nxDoStatus !== -2 && item.nxDoRemark && item.nxDoRemark.length > 0}}" class="text-danger">{{item.nxDoRemark}}</text>
          <textarea wx:else auto-height
            style="width: {{windowWidth - 350}}rpx; padding: 20rpx 20rpx; border-radius: 10rpx; border: 1px solid lightgray; background-color: white; height: 200rpx;"
            bindinput="onEditOrder" data-type="remark" data-index="{{orderIndex}}" value="{{item.nxDoRemark || ''}}" placeholder="请输入备注"
            placeholder-style="font-size: 24rpx; color: #999;" />
        </view>

        <!-- 订单带的配送商商品列表 -->
        <view class="flex-column"
          wx:if="{{orderArrIndex == orderIndex && item.nxDoStatus !== 0 && item.nxDoIsAgent == '2' && item.nxDoQuantity !== '' && item.nxDoStandard !== '' }}">
          <view class="flex-row-between font-xs p-20 mt-10" style="background-color: #eeee ;"
            wx:if="{{nxArr.length == 0 && strArr.length == 0}}">
            <view class="flex-column"
              wx:if="{{item.nxDistributerGoodsEntityList.length > 0 ||item.nxGoodsEntities.length > 0}}">
              <view class="flex-row">
                <text class="text-secondary">配送商品:</text>
                <text class="mr-10">{{item.nxDistributerGoodsEntityList.length}}个 </text>
                <text class="text-secondary">新商品:</text>
                <text>{{item.nxGoodsEntities.length}}个 </text>
              </view>
            </view>

            <text class="" wx:if="{{item.nxDistributerGoodsEntityList.length > 0 ||item.nxGoodsEntities.length > 0}}" bind:tap="onShowGoodsList" data-index="{{orderIndex}}">关闭</text>
              <view wx:else="" class="flex-column-center p-20 text-secondary font-xs">暂无匹配商品</view> 
          </view>
         
          <scroll-view scroll-y="true"
            style="max-height: 400rpx; width: {{windowWidth - 136}}rpx; margin-top: 12rpx; z-index: 9999999; ">
            <view class="flex-column"
              wx:if="{{item.nxDistributerGoodsEntityList && item.nxDistributerGoodsEntityList.length > 0 && strArr.length == 0 && nxArr.length == 0}}"
              style="width: {{windowWidth - 140}}rpx; ">

              <view class="flex-row-between p-20 " wx:for="{{item.nxDistributerGoodsEntityList}}"
                wx:for-item="orderGoods" wx:for-index="orderGoodsIndex" wx:key="nxDistributerGoodsId"
                style="width:{{windowWidth - 180}}rpx;  border-bottom: 1px solid #979797;  align-items: center; box-sizing: border-box;">

                <view class="flex-column">

                  <view class="flex-row-wrap flex-1 font-s" style="width: {{windowWidth - 320}}rpx;  ">
                    <text class="mr-10">{{orderGoodsIndex + 1}}.</text>
                    <block wx:if="{{orderGoods.nxDgDistributerId !== disId}}">
                      <text class="font-xs mainColor">[{{orderGoods.nxDgDistributerName}}]</text>
                    </block>
                    <block wx:if="{{orderGoods.nxDgGoodsBrand !== 'null' && orderGoods.nxDgGoodsBrand.length > 0}}">
                      <text class="brand">{{orderGoods.nxDgGoodsBrand}}</text>
                    </block>
                    <text class="mr-10">{{orderGoods.nxDgGoodsName}}</text>
                    <block
                      wx:if="{{orderGoods.nxDgGoodsStandardWeight !== 'null' && orderGoods.nxDgGoodsStandardWeight.length > 0}}">
                      <text
                        class="">({{orderGoods.nxDgGoodsStandardWeight}}/{{orderGoods.nxDgGoodsStandardname}})</text>
                    </block>
                    <block wx:else>
                      <text class="">({{orderGoods.nxDgGoodsStandardname}})</text>
                    </block>
                  </view>
                  <block wx:if="{{orderGoods.departmentDisGoodsEntity !== null}}">
                    <view class="flex-row font-xs p-10"
                      style="width: {{windowWidth - 340}}rpx; margin-left: 10rpx; background-color: rgb(0, 128, 233); color: #FFF; border-radius: 10rpx;">
                      <view class="flex-row third-row">
                        <text>{{tool.transferDateString(orderGoods.departmentDisGoodsEntity.nxDdgOrderDate)}}</text>
                      </view>
                      <view class="flex-row third-row">
                        <text>单价:</text>
                        <text>{{orderGoods.departmentDisGoodsEntity.nxDdgOrderPrice}}/{{orderGoods.nxDgGoodsStandardname}}</text>
                      </view>
                      <view class="flex-row third-row">
                        <text>订货:</text>
                        <text>{{orderGoods.departmentDisGoodsEntity.nxDdgOrderQuantity}}{{orderGoods.departmentDisGoodsEntity.nxDdgOrderStandard}}</text>
                      </view>
                    </view>

                  </block>

                </view>


                <text class="bg-success font-xs p-10 radius-10" bindtap="onSaveOrder"
                  data-id="{{orderGoods.nxDistributerGoodsId}}" data-index="{{orderIndex}}"
                  data-name="{{orderGoods.nxDgGoodsName}}" data-item="{{orderGoods}}">选择</text>
              </view>
            </view>

            <!-- 订单带的推荐系统商品列表（无搜索结果时显示） -->
            <block
              wx:if="{{item.nxGoodsEntities && item.nxGoodsEntities.length > 0 && orderArrIndex == orderIndex && strArr.length == 0 && nxArr.length == 0}}">
              <view class="flex-column">

                <view class="border-bottom p-20 flex-row-between" wx:for="{{item.nxGoodsEntities}}" wx:for-item="goods"
                  wx:for-index="nxIndex" wx:key="nxGoodsId" style="border-bottom: 1px solid gray;">
                  <view class="flex-row-default font-sl">
                    <text class="">{{nxIndex + 1}}.</text>
                    <view class="flex-row-wrap">

                      <text class="brand" wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !== 'null'}}"
                        style="margin-right: 8rpx;">{{goods.nxGoodsBrand}}</text>
                      <text class="mr-20">{{goods.nxGoodsName}}</text>
                      <text class="font-xs text-primary"
                        wx:if="{{goods.nxAliasEntities && goods.nxAliasEntities.length > 0}}"
                        wx:for="{{goods.nxAliasEntities}}" wx:for-item="alias"
                        wx:key="nxDaAliasName">@{{alias.nxAliasName}}</text>
                      <block
                        wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
                        <text
                          class="mr-10 font-md">({{goods.nxGoodsStandardWeight}}/{{goods.nxGoodsStandardname}})</text>
                      </block>
                      <block wx:else>
                        <text class="font-md mr-10">({{goods.nxGoodsStandardname}})</text>
                      </block>
                      <text class="small mr-20 gray"
                        wx:if="{{goods.nxGoodsPlace !== 'null' && goods.nxGoodsPlace.length > 0}}">产地:{{goods.nxGoodsPlace}}</text>
                      <text class="small gray"
                        wx:if="{{goods.nxGoodsDetail && goods.nxGoodsDetail.length > 0 && goods.nxGoodsDetail !== 'null'}}">{{goods.nxGoodsDetail}}</text>
                    </view>
                  </view>
                  <view class="button-container" bindtap="onDownloadGoods" data-index="{{orderIndex}}"
                    data-item="{{goods}}">
                    <image src="/images/download.png" mode="aspectFill" class="icon"
                      style="opacity: 0.7; width: 44rpx; height: 44rpx;" />
                  </view>
                </view>
              </view>
              <view class="text-secondary"
                style="height: 200rpx; text-align: center; font-size: 24rpx; line-height: 100rpx;">到底了!</view>
            </block>

          </scroll-view>
        </view>
        <!-- 商品输入框新内容搜索结果列表（strArr 和 nxArr） -->
        <block
          wx:if="{{orderArrIndex == orderIndex && item.nxDoIsAgent == '2' && item.nxDoStatus !== 0 && (strArr.length > 0 || nxArr.length > 0)}}">
          <view class="flex-column" style="margin-top: 12rpx;  max-height: 900rpx; width: {{windowWidth - 180}}rpx; ">
            <view class="flex-row-between font-xs p-20 bg-success mt-10" style="width: {{windowWidth - 160}}rpx;">
              <view class="flex-column">
                <view class="flex-row">
                  <text class="mr-20">配送商品:{{strArr.length}}个 </text>
                  <text>新商品:{{nxArr.length}}个 </text>
                </view>

                <!-- <view class="flex-row">
            <text>原文:</text>
            <text>{{item.nxDoGoodsOriginalName}}}</text>
            </view> -->
              </view>

              <text class="" bind:tap="onShowGoodsList" data-index="{{orderIndex}}">关闭</text>
            </view>


            <scroll-view scroll-y="true" style="margin-top: 12rpx;max-height: 900rpx; width: 100%;">
              <!-- 配送商商品搜索结果 -->
              <block wx:if="{{strArr.length > 0}}">
                <view class="flex-row-default p-20  border-bottom " wx:for="{{strArr}}" wx:for-item="goods"
                  wx:for-index="goodsIndex" wx:key="nxDistributerGoodsId"
                  style="background-color: #d9e4fb; border-bottom: 1px solid rgb(255, 255, 255);">
                  <text class="mr-10">{{goodsIndex + 1}}.</text>
                  <view class="flex-1" style="min-width: 0; flex: 1;">
                    <view class="flex-row-wrap" style="align-items: center;">
                      <block wx:if="{{goods.nxDgDistributerId !== disId}}">
                        <text class="font-xs mainColor">[{{goods.goodsNxDistributerName}}]</text>
                      </block>
                      <block wx:if="{{goods.nxDgGoodsBrand !== 'null' && goods.nxDgGoodsBrand.length > 0}}">
                        <text class="brand">{{goods.nxDgGoodsBrand}}</text>
                      </block>
                      <text class="mr-10">{{goods.nxDgGoodsName}}</text>
                      <block
                        wx:if="{{goods.nxDgGoodsStandardWeight !== 'null' && goods.nxDgGoodsStandardWeight.length > 0}}">
                        <text class="font-md">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
                      </block>
                      <block wx:else>
                        <text class="font-md">({{goods.nxDgGoodsStandardname}})</text>
                      </block>
                    </view>
                  </view>
                  <block wx:if="{{goods.nxDgNxGoodsId !== null}}">
                    <view class="ml-20" style="flex-shrink: 0; width: 100rpx;" bindtap="onSaveOrder"
                      data-id="{{goods.nxDistributerGoodsId}}" data-index="{{orderArrIndex}}"
                      data-name="{{goods.nxDgGoodsName}}" data-item="{{goods}}">
                      <text class="bg-success font-xs p-10 radius-10">选择</text>
                    </view>
                  </block>
                  <block wx:else>
                    <view class="ml-20" style="flex-shrink: 0; width: 100rpx;" bindtap="onSaveOrder"
                      data-id="{{goods.nxDistributerGoodsId}}" data-index="{{orderArrIndex}}"
                      data-name="{{goods.nxDgGoodsName}}" data-item="{{goods}}">
                      <text class="bg-warning font-xs radius-10 p-10">选择</text>
                    </view>
                  </block>
                </view>
              </block>
              <!-- 系统商品搜索结果 -->
              <block wx:if="{{nxArr.length > 0}}">
                <view class="flex-row-between p-20" style="border-bottom: 1px solid #FFF; padding: 10rpx 0;"
                  wx:for="{{nxArr}}" wx:for-item="goods" wx:for-index="nxIndex" wx:key="nxGoodsId">
                  <view class="flex-row-default font-lg flex-1" style="min-width: 0; flex: 1; ">
                    <text class="mr-10 text-primary p-10">{{nxIndex + 1}}.</text>
                    <view class="flex-row-wrap flex-1 p-10" style="min-width: 0; align-items: center;">
                      <text class="brand"
                        wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !== 'null'}}">{{goods.nxGoodsBrand}}</text>
                      <text class="font-lg mr-20">{{goods.nxGoodsName}}</text>
                      <block
                        wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
                        <text
                          class="mr-10 font-md">({{goods.nxGoodsStandardWeight}}/{{goods.nxGoodsStandardname}})</text>
                      </block>
                      <block wx:else>
                        <text class="mr-10 font-md">({{goods.nxGoodsStandardname}})</text>
                      </block>
                    </view>
                  </view>
                  <view class="button-container" bindtap="onDownloadGoods" data-item="{{goods}}"
                    data-index="{{orderArrIndex}}">
                    <image src="/images/download.png" mode="aspectFill" class="icon" />
                  </view>
                </view>
              </block>
              <view style="height: 100rpx; text-align: center; font-size: 24rpx; line-height: 100rpx;">到底了!</view>
            </scroll-view>
          </view>
        </block>

      </view>
    </view>
  </view>

  <!-- 底部留白，仅在展开推荐商品时显示，便于将最后一个订单滚动到顶部；浏览时分页不受影响 -->
  <!-- <view  class="order-list-bottom-spacer"></view> -->

</view>