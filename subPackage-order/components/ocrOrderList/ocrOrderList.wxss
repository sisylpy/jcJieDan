/* 全屏识别文本弹窗 */
.recognition-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.recognition-modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.recognition-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.recognition-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.recognition-modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.recognition-modal-close:active {
  background-color: #f5f5f5;
  color: #666;
}

.recognition-modal-body {
  padding: 40rpx;
  min-height: 200rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.recognition-text-display {
  color: #333;
  font-size: 32rpx;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
  padding: 30rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid #e5e5e5;
}

.recognition-modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 40rpx 40rpx;
  border-top: 1rpx solid #e5e5e5;
}

.recognition-modal-footer .btn-confirm,
.recognition-modal-footer .btn-ai-parse,
.recognition-modal-footer .btn-cancel,
.recognition-modal-footer .btn-stop-record,
.recognition-modal-footer .btn-rerecord {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.recognition-modal-footer .btn-confirm {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 196, 140, 0.3);
}

.recognition-modal-footer .btn-confirm:active {
  opacity: 0.9;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 196, 140, 0.25);
}

.recognition-modal-footer .btn-cancel {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  color: #666;
  border: 2rpx solid #e5e5e5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.recognition-modal-footer .btn-cancel:active {
  background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.recognition-modal-footer .btn-ai-parse {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.recognition-modal-footer .btn-ai-parse:active {
  opacity: 0.9;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.25);
}
/* V2 商品匹配区：保留原事件，只重新组织信息和操作层级 */
