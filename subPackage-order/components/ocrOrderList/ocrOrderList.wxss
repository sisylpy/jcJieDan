/* 订单项基础样式 */
.order-item {
  transition: all 0.3s ease;
  overflow: hidden;
}

/* 采购/出库状态颜色（与 orderPage 一致，组件内需单独定义因 app.wxss 不作用于组件） */
.liziBack {
