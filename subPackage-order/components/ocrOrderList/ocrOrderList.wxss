}

/* 删除动画效果 */
.order-deleting {
  animation: orderDeleteAnimation 0.3s ease-out forwards;
  opacity: 0;
  transform: translateX(-100%);
  max-height: 0;
  margin: 0;
  padding: 0;
  border: none;
}

@keyframes orderDeleteAnimation {
  0% {
    opacity: 1;
    transform: translateX(0);
    max-height: 500rpx;
  }
  50% {
    opacity: 0.5;
    transform: translateX(-50%);
  }
  100% {
    opacity: 0;
    transform: translateX(-100%);
    max-height: 0;
    margin: 0;
    padding: 0;
  }
}





/* 美化输入框 */
