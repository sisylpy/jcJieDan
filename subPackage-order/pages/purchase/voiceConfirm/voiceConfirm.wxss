.page {
  min-height: 100vh;
  color: #20322e;
  background: #f4f7f6;
}

.navbar-spacer {
  width: 100%;
}

.confirm-scroll {
  box-sizing: border-box;
  padding: 20rpx 22rpx 0;
}

.summary-card,
.row-head,
.edit-row,
.candidate-title,
.candidate-card,
.research-row,
.submit-bar,
.submit-summary {
  display: flex;
  align-items: center;
}

.summary-card {
  justify-content: space-between;
  padding: 25rpx;
  border-radius: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #096e5a, #1b967c);
}

.summary-card > view:first-child,
.recognized-copy,
.candidate-copy,
.submit-summary {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.summary-title {
  font-size: 31rpx;
  font-weight: 700;
}

.summary-copy {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, .76);
  font-size: 22rpx;
}

.summary-count {
  font-size: 34rpx;
  font-weight: 700;
}

.notice-card {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #edd6a4;
  border-radius: 16rpx;
  color: #8a641e;
  background: #fff9e9;
  font-size: 22rpx;
  line-height: 1.55;
}

.purchase-row {
  margin-top: 18rpx;
  padding: 21rpx;
  border: 1rpx solid #dfe7e4;
  border-radius: 22rpx;
  background: #fff;
}

.row-index {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #18836e;
  font-size: 22rpx;
}

.recognized-copy {
  margin-left: 13rpx;
  flex: 1;
}

.recognized-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recognized-quantity {
  margin-top: 4rpx;
  color: #7d8986;
  font-size: 21rpx;
}

.choice-state {
  padding: 7rpx 12rpx;
  border-radius: 20rpx;
  color: #9a6817;
  background: #fff3d8;
  font-size: 20rpx;
}

.choice-state.ready {
  color: #10705d;
  background: #e4f7f0;
}

.edit-row {
  justify-content: space-between;
  margin-top: 17rpx;
}

.edit-field {
  width: 48%;
  color: #71807c;
  font-size: 21rpx;
}

.edit-field input {
  height: 64rpx;
  margin-top: 7rpx;
  padding: 0 14rpx;
  border: 1rpx solid #dfe6e4;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #273633;
  background: #fafcfb;
  font-size: 25rpx;
}

.candidate-title {
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ef;
  font-size: 24rpx;
  font-weight: 650;
}

.candidate-count {
  color: #82908c;
  font-size: 20rpx;
  font-weight: 400;
}

.candidate-card {
  margin-top: 12rpx;
  padding: 13rpx;
  border: 2rpx solid #e2e8e6;
  border-radius: 15rpx;
  background: #fcfdfd;
}

.candidate-card.selected {
  border-color: #1a8a73;
  background: #eef9f5;
}

.goods-image {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #6f7e79;
  background: #edf2f0;
  font-size: 24rpx;
}

.candidate-copy {
  margin-left: 14rpx;
  flex: 1;
}

.candidate-name {
  font-size: 25rpx;
  font-weight: 650;
}

.candidate-spec {
  margin-top: 7rpx;
  color: #788581;
  font-size: 21rpx;
  line-height: 1.4;
}

.radio {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #cbd5d2;
  border-radius: 50%;
  color: #fff;
  font-size: 21rpx;
}

.radio.checked {
  border-color: #17836d;
  background: #17836d;
}

.research-row {
  margin-top: 16rpx;
}

.research-row input {
  min-width: 0;
  height: 66rpx;
  padding: 0 15rpx;
  flex: 1;
  border: 1rpx solid #dfe6e4;
  border-radius: 13rpx;
  box-sizing: border-box;
  background: #f7f9f8;
  font-size: 24rpx;
}

.research-row button {
  width: 154rpx;
  height: 66rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 13rpx;
  color: #14745f;
  background: #e7f6f1;
  font-size: 23rpx;
  line-height: 66rpx;
}

.empty {
  padding: 160rpx 30rpx;
  color: #8b9693;
  text-align: center;
  font-size: 26rpx;
}

.bottom-space {
  height: 170rpx;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  justify-content: space-between;
  border-top: 1rpx solid #dfe5e3;
  background: rgba(255, 255, 255, .96);
}

.submit-summary {
  color: #50605b;
  font-size: 22rpx;
  line-height: 1.5;
}

.submit-summary text:first-child {
  color: #16806a;
  font-size: 27rpx;
  font-weight: 700;
}

.submit-bar button {
  width: 250rpx;
  margin: 0;
  border-radius: 40rpx;
  color: #fff;
  background: #16836d;
  font-size: 27rpx;
}
