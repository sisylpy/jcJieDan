.page {
  min-height: 100vh;
  color: #20322e;
  background: #f4f7f6;
}

.navbar-spacer {
  width: 100%;
}

.page-scroll {
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

.hero-card {
  display: flex;
  padding: 24rpx;
  align-items: center;
  border-radius: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #086d59, #23a087);
  box-shadow: 0 12rpx 28rpx rgba(12, 111, 91, .15);
}

.hero-mark {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  color: #096b58;
  background: #dff9ef;
  font-size: 21rpx;
  font-weight: 800;
}

.hero-copy {
  display: flex;
  margin-left: 18rpx;
  flex-direction: column;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 21rpx;
}

.input-card,
.item-card {
  border: 1rpx solid #dfe7e4;
  border-radius: 22rpx;
  background: #fff;
}

.input-card {
  margin-top: 20rpx;
  padding: 22rpx;
}

.input-card.is-recording {
  border-color: #e37a7a;
  box-shadow: 0 0 0 6rpx rgba(227, 91, 91, .08);
}

.card-head,
.item-head,
.result-title-row,
.field-row,
.quantity-row,
.record-status {
  display: flex;
  align-items: center;
}

.card-head,
.item-head,
.result-title-row {
  justify-content: space-between;
}

.card-title,
.result-title {
  font-size: 28rpx;
  font-weight: 700;
}

.head-actions,
.add-line {
  color: #167b67;
  font-size: 23rpx;
}

.purchase-textarea {
  width: 100%;
  height: 300rpx;
  margin-top: 14rpx;
  padding-top: 16rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #edf1f0;
  font-size: 29rpx;
  line-height: 1.65;
}

.record-status {
  margin-top: 12rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #edf1f0;
  color: #d84f4f;
  font-size: 23rpx;
}

.record-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #e74c4c;
  box-shadow: 0 0 0 7rpx rgba(231, 76, 76, .12);
}

.record-time {
  margin-left: auto;
}

.source-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.source-action {
  display: flex;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx solid #dce5e2;
  border-radius: 19rpx;
  background: #fff;
  font-size: 23rpx;
}

.source-action.recording {
  border-color: #efb0b0;
  color: #d84f4f;
  background: #fff3f3;
}

.source-icon {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 7rpx;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.source-icon.voice {
  color: #d84f4f;
  background: #fff0f0;
}

.source-icon.paste {
  color: #08745e;
  background: #e7f8f2;
}

.parse-button {
  display: flex;
  height: 88rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #168a73;
  font-size: 27rpx;
  font-weight: 650;
}

.parse-button.disabled {
  opacity: .42;
  pointer-events: none;
}

.result-section {
  margin-top: 28rpx;
}

.item-card {
  margin-top: 16rpx;
  padding: 20rpx;
}

.item-card.needs-review {
  border-color: #efca7c;
  background: #fffdf7;
}

.item-index {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #18836e;
  font-size: 22rpx;
}

.review-tip {
  margin-right: auto;
  margin-left: 12rpx;
  color: #a56c11;
  font-size: 21rpx;
}

.delete-line {
  color: #b66b6b;
  font-size: 22rpx;
}

.field-row {
  min-width: 0;
  margin-top: 17rpx;
}

.field-row.compact {
  width: 48%;
}

.quantity-row {
  justify-content: space-between;
}

.field-label {
  width: 78rpx;
  flex-shrink: 0;
  color: #71807c;
  font-size: 23rpx;
}

.field-input {
  min-width: 0;
  height: 68rpx;
  padding: 0 16rpx;
  flex: 1;
  border: 1rpx solid #dfe6e4;
  border-radius: 13rpx;
  box-sizing: border-box;
  background: #fafcfb;
  font-size: 26rpx;
}

.spoken-remark {
  margin-top: 14rpx;
  color: #86918e;
  font-size: 21rpx;
}

.confirm-button {
  margin-top: 24rpx;
  border-radius: 44rpx;
  color: #fff;
  background: #14816c;
  font-size: 28rpx;
}

.safe-space {
  height: 80rpx;
}
