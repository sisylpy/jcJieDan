<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="flex-column height-100">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{name}}-价格" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <view class="flex flex-column">

    <view class="section">

      <view class="maodianPrice" style="height:{{windowHeight - 580 - statusBarHeight}}rpx;">
          <view id="NAV{{index}}" wx:for="{{applyArr.length}}" wx:key="index">NAV{{index}}</view>
        </view>

        <view class="section_body bg-white">
          <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV{{focusIndex}}"
            scroll-with-animation="true">

            <!-- single bumen -->
            <view class="flex-column border-bottom  p-10 font-md" wx:for="{{applyArr}}" wx:key="nxDepartmentOrdersId"
              wx:for-index="index" data-id="{{item.nxDepartmentOrdersId}}">
              <view class="flex flex-row" id="NAV{{index}}">
                <view class="flex-column">
                  <view class="flex flex-row" bind:tap="toHistoryPrice"
                    data-id="{{item.nxDistributerGoodsEntity.nxDistributerGoodsId}}"
                    data-item="{{item.nxDistributerGoodsEntity}}">
                    <text class="">{{index + 1}}.</text>
                    <view class="flex-row-wrap  align-center" bindtap="toGoodsDetail"
                      data-item="{{item.nxDistributerGoodsEntity}}">
                      <text class="brand"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                      <text class="mr-10 font-lg font-bold">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                      <block
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                        <text
                          class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}})</text>
                      </block>
                      <block wx:else>
                        <text class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                      </block>

                      <text class=" mr-20 text-secondary"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                      <text class=" text-secondary"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && item.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{item.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>

                    </view>
                    <view>
                      <image src="/images/searchmore.png" mode="aspectFill" class="icon ml-20" />
                    </view>
                  </view>

                  <view class="flex flex-row">
                    <text class="text-white">{{index + 1}}.</text>
                    <view class="flex-column">
                      <view class="flex-row-between font-xs" style="width: {{windowWidth / 2 - 60}}rpx; ">

                        <view class=" flex-row">
                          <text class="text-secondary">出货:</text>
                          <view class="flex-row " wx:if="{{item.nxDoWeight !== null}}">
                            <text class="">{{item.nxDoWeight}}</text>
                            <text class="">{{item.nxDoPrintStandard}}</text>
                          </view>
                        </view>
                      </view>
                      <view class="flex-row" style="width: {{windowWidth / 2 - 100}}rpx;">
                        <text class="text-danger font-sm"
                          wx:if="{{item.nxDoRemark.length > 0}}">({{item.nxDoRemark}})</text>
                      </view>

                    </view>

                    <view class="flex-row ">
                      <text class="text-secondary">单价:</text>
                      <view class="flex weightInput m-10 flex-row {{index == focusIndex ? 'is-active' : ''}}"
                        bindtap="changeFocusIndexPrice" data-index="{{index}}"
                        style="width: {{item.nxDepartmentDisGoodsEntity !== null &&  item.nxDoPrice == null ? windowWidth / 3 - 200 : windowWidth / 3 - 140}}rpx;">
                        <text class="input_number"
                          wx:if="{{item.nxDoPrice !== null && item.nxDoPrice !== '0.1' && item.nxDoPrice !== 0.1}}">{{item.nxDoPrice}}</text>
                        <view class='analog_cursor {{index == focusIndex ? "is-active" : "" }}'></view>
                      </view>
                      <text>元/{{item.nxDoPrintStandard}}</text>
                    </view>
                  </view>

                  <block wx:if="{{item.nxDoCostPrice != null && item.nxDoCostPrice != '0.1'}}">
                    <view class="flex-row plr-20">
                      <view class="flex-row half-row">
                        <text class="text-secondary">进价:</text>
                        <text>{{item.nxDoCostPrice}}</text>
                        <text>元/{{item.nxDoPrintStandard}}</text>

                      </view>
                      <view class="flex-row half-row">
                        <text class="text-secondary">协作伙伴:</text>
                        <text>{{item.nxDistributerGoodsEntity.goodsNxDistributerName}}</text>

                      </view>

                    </view>

                  </block>

                </view>
              </view>

            </view>
            <!-- ./single bumen -->
            <view class="bottom_place"></view>
          </scroll-view>
        </view>

