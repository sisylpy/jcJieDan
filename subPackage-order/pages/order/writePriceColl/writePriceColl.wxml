    </view>

  </view>

</view>


<view class='customize_key_board liziBack flex flex-row {{focusIndex == -1 ? "hidden" : ""}}'>

  <view class="flex-row-wrap" style="width: {{windowWidth/4 * 3 }}rpx;">
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="7" hover-class="hoverKey"> 7</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="8" hover-class="hoverKey"> 8</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="9" hover-class="hoverKey"> 9</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="4" hover-class="hoverKey"> 4</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="5" hover-class="hoverKey"> 5</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="6" hover-class="hoverKey"> 6</view>
    <view class="num border-bottom border-right border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="1" hover-class="hoverKey"> 1</view>
    <view class="num border-bottom border-right border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="2" hover-class="hoverKey"> 2</view>
    <view class="num border-bottom border-right border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="3" hover-class="hoverKey"> 3</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="del" hover-class="hoverKey"> X</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="0" hover-class="hoverKey"> 0</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="." hover-class="hoverKey">.</view>
  </view>

  <view class="input_operation_part flex-column" style="width: {{windowWidth - (windowWidth / 4 * 3)}}rpx;">
    <view class="double_num border-bottom border-top with-border-left" style="width:100%; height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="close" hover-class="hoverKey">关闭</view>
    <!-- 0 -->
    <view wx:if="{{depHasSubs == 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next" hover-class="hoverKey" wx:if='{{focusIndex == applyArr.length - 1}}'> 完成</view>
      <view class="double_num with-border-left" style=" height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next" hover-class="hoverKey" wx:else>保存</view>
    </view>
    <!-- 1 -->
    <view wx:if="{{depHasSubs > 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next" hover-class="hoverKey" wx:if='{{focusParentIndex == depArr.length -1 && focusIndex == depArr[focusParentIndex].depOrders.length - 1}}'> 完成</view>
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next" hover-class="hoverKey" wx:else> 保存</view>
    </view>





  </view>


</view>