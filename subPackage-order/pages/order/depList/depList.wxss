.dep-filter-input {
  height: 64rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 28rpx;
}

/* 标签筛选样式 */
.label-filter-scroll {
  width: 100%;
  white-space: nowrap;
  height: 88rpx;
}

.label-filter-container {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 20rpx;
}

.label-filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
  white-space: nowrap;
}

.label-filter-item.active {
  background: #07c160;
  color: #fff;
}

/* 客户标签样式 */
.customer-label-tag {
  padding: 4rpx 12rpx;
  background: #e8f5e9;
  color: #07c160;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}
