          <view class="fee-detail-row" wx:if="{{orderPreview.startFeeAmount}}">
            <text class="fee-detail-label">起步价</text>
            <text class="fee-detail-value">¥{{orderPreview.startFeeAmount}}</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.baseWeightJin}}">
            <text class="fee-detail-label">起步重量</text>
            <text class="fee-detail-value">{{orderPreview.baseWeightJin}} 斤</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.pricePerJin}}">
            <text class="fee-detail-label">超出每斤</text>
            <text class="fee-detail-value">¥{{orderPreview.pricePerJin}}/斤</text>
          </view>
        </block>

        <!-- 按距离计费 -->
        <block wx:if="{{orderPreview.feeMode === 'DISTANCE_ONLY'}}">
          <view class="fee-detail-row" wx:if="{{orderPreview.distanceKm}}">
            <text class="fee-detail-label">配送距离</text>
            <text class="fee-detail-value">{{orderPreview.distanceKm}} km</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.startFeeAmount}}">
            <text class="fee-detail-label">起步价</text>
            <text class="fee-detail-value">¥{{orderPreview.startFeeAmount}}</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.baseDistanceKm}}">
            <text class="fee-detail-label">起步里程</text>
            <text class="fee-detail-value">{{orderPreview.baseDistanceKm}} km 内</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.pricePerKm}}">
            <text class="fee-detail-label">超出每公里</text>
            <text class="fee-detail-value">¥{{orderPreview.pricePerKm}}/km</text>
          </view>
        </block>

        <!-- 重量+距离计费 -->
        <block wx:if="{{orderPreview.feeMode === 'WEIGHT_DISTANCE'}}">
          <view class="fee-detail-row" wx:if="{{orderPreview.grossWeightJin}}">
            <text class="fee-detail-label">商品总重</text>
            <text class="fee-detail-value">{{orderPreview.grossWeightJin}} 斤</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.distanceKm}}">
            <text class="fee-detail-label">配送距离</text>
            <text class="fee-detail-value">{{orderPreview.distanceKm}} km</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.startFeeAmount}}">
            <text class="fee-detail-label">起步价</text>
            <text class="fee-detail-value">¥{{orderPreview.startFeeAmount}}</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.baseDistanceKm}}">
            <text class="fee-detail-label">起步里程</text>
            <text class="fee-detail-value">{{orderPreview.baseDistanceKm}} km</text>
          </view>
          <view class="fee-detail-row" wx:if="{{orderPreview.pricePerJinPerKm}}">
            <text class="fee-detail-label">每斤每公里</text>
            <text class="fee-detail-value">¥{{orderPreview.pricePerJinPerKm}}/斤/km</text>
          </view>
        </block>

        <!-- 固定运费 -->
        <block wx:if="{{orderPreview.feeMode === 'FIXED_AMOUNT'}}">
          <view class="fee-detail-row" wx:if="{{orderPreview.startFeeAmount}}">
            <text class="fee-detail-label">固定运费</text>
            <text class="fee-detail-value">¥{{orderPreview.startFeeAmount}}</text>
          </view>
        </block>
      </view>

      <!-- 计算说明：仅当无下方公式卡片（WEIGHT_ONLY/DISTANCE_ONLY 会重复显示）时展示 -->
      <view class="fee-detail-explain" wx:if="{{orderPreview.deliveryFeeFormula && orderPreview.feeMode !== 'WEIGHT_ONLY' && orderPreview.feeMode !== 'DISTANCE_ONLY'}}">
        <view class="fee-detail-explain-title">计算说明</view>
        <text class="fee-detail-explain-text">{{orderPreview.deliveryFeeFormula}}</text>
      </view>

      <!-- 按重量计费公式卡片 -->
      <view class="fee-detail-formula-card" wx:if="{{orderPreview.feeMode === 'WEIGHT_ONLY'}}">
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">商品总重</text>
          <text class="fee-detail-formula-value">{{orderPreview.grossWeightJin}}斤</text>
          <text class="fee-detail-formula-sub" wx:if="{{orderPreview.extraWeightJin}}">(超出{{orderPreview.extraWeightJin}}斤)</text>
        </view>
        <text class="fee-detail-formula-op">×</text>
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">超出每斤</text>
          <text class="fee-detail-formula-value">¥{{orderPreview.pricePerJin}}/斤</text>
        </view>
        <text class="fee-detail-formula-op">=</text>
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">配送费</text>
          <text class="fee-detail-formula-value fee-detail-formula-result">¥{{orderPreview.deliveryFee}}</text>
        </view>
      </view>

      <!-- 按距离计费公式卡片 -->
      <view class="fee-detail-formula-card" wx:if="{{orderPreview.feeMode === 'DISTANCE_ONLY'}}">
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">超出里程</text>
          <text class="fee-detail-formula-value">{{orderPreview.extraDistanceKm}}km</text>
        </view>
        <text class="fee-detail-formula-op">×</text>
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">超出每公里</text>
          <text class="fee-detail-formula-value">¥{{orderPreview.pricePerKm}}/km</text>
        </view>
        <text class="fee-detail-formula-op">=</text>
        <view class="fee-detail-formula-item">
          <text class="fee-detail-formula-label">配送费</text>
          <text class="fee-detail-formula-value fee-detail-formula-result">¥{{orderPreview.deliveryFee}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="fee-detail-footer">
      <view class="fee-detail-total-row">
        <text class="fee-detail-total-label">预计应付</text>
        <text class="fee-detail-total-value">¥{{orderPreview.estimatedPayAmount}}</text>
      </view>
      <view class="fee-detail-total-tip" wx:if="{{orderPreview.deliveryFeePending}}">暂无匹配运费规则，配送费将在送货出账后一并结算</view>
      <view class="fee-detail-total-tip" wx:elif="{{orderPreview.deliveryFeeEstimate && orderPreview.deliveryFee != '0.00'}}">配送费为下单预估，出账时按实际规则结算</view>
      <view class="fee-detail-btn" bindtap="hideFeeDetail">知道了</view>
    </view>
  </view>
</view>
<!-- ../配送费计算详情弹窗 -->
