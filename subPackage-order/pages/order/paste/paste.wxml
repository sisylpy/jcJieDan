<view class="page paste-v2-page">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="AI 智能下单"
    avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"
  ></back-navbar>

  <!-- back-navbar 为固定定位，这里保留真实高度，避免内容被导航栏遮挡 -->
  <view class="navbar-spacer" style="height: {{navBarHeight}}rpx;"></view>

  <!-- 快速输入区 -->
  <view wx:if="{{showInputPanel}}" class="input-stage">
    <view class="hero-card">
      <view class="hero-topline">
        <view class="hero-brand">
          <view class="ai-orb">AI</view>
          <text>智能识单 V2</text>
        </view>
        <view class="department-hint">
          <text class="department-hint-label">部门</text>
          <text class="department-name">{{depName}}</text>
        </view>
      </view>
    </view>

    <view class="editor-card {{isRecording ? 'editor-card--recording' : ''}}">
      <view class="editor-header">
        <text class="editor-label">订单清单</text>
        <view class="editor-header-actions">
          <text wx:if="{{inputFocused}}" class="keyboard-done-link" bindtap="finishInput">完成</text>
          <text wx:if="{{!inputContent}}" class="example-link" bindtap="useExample">试用示例</text>
          <text wx:if="{{inputContent}}" class="clear-link" bindtap="clearAll">清空</text>
        </view>
      </view>
      <textarea
        class="order-textarea"
        style="height: {{inputAreaHeight}}rpx;"
        value="{{inputContent}}"
        bindinput="onInput"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        bindconfirm="finishInput"
        focus="{{inputFocused}}"
        maxlength="-1"
        auto-height="{{false}}"
        show-confirm-bar="{{true}}"
        confirm-type="done"
        disabled="{{isRecording}}"
        placeholder="{{inputPlaceholder}}"
        placeholder-style="color: #9aa6a2; line-height: 1.65;"
      ></textarea>
      <view wx:if="{{isRecording || recognitionStatus}}" class="record-status {{isRecording ? 'record-status--active' : ''}}">
        <view wx:if="{{isRecording}}" class="record-dot"></view>
        <text>{{recognitionStatus}}</text>
        <text wx:if="{{isRecording}}" class="record-time">{{duration}}s</text>
      </view>
    </view>

    <view class="source-actions">
      <view
        class="source-action {{isRecording ? 'source-action--recording' : ''}}"
        bindtap="{{isRecording ? 'stopRecord' : 'startRecord'}}"
      >
        <view class="source-icon source-icon--voice">{{isRecording ? '■' : '●'}}</view>
        <text>{{isRecording ? '停止录音' : '语音说单'}}</text>
      </view>
      <view
        class="source-action source-action--primary {{isRecording ? 'source-action--disabled' : ''}}"
        bindtap="pasteFromClipboard"
      >
        <view class="source-icon source-icon--paste">粘</view>
        <text>粘贴清单</text>
      </view>
      <view
        class="source-action {{isRecording || ocrSubmitting ? 'source-action--disabled' : ''}}"
        bindtap="recognizeOrder"
      >
        <view class="source-icon source-icon--image">图</view>
        <text>{{ocrSubmitting ? '正在识别' : '图片识别'}}</text>
      </view>
    </view>

    <view class="parse-actions">
      <view class="smart-parse-button {{!inputContent || isRecording ? 'button--disabled' : ''}}" bindtap="smartParse">
        <text class="sparkle">✦</text>
        <text>{{inputContent ? '立即生成订单' : '请先粘贴或输入订单'}}</text>
        <text class="button-arrow">›</text>
      </view>
      <view class="ai-parse-button {{!inputContent || isRecording || isAiOptimizing ? 'button--disabled' : ''}}" bindtap="aiEnhance">
        <view class="ai-button-mark">DS</view>
        <text>{{isAiOptimizing ? 'DeepSeek 识别中…' : 'DeepSeek 智能识别'}}</text>
      </view>
    </view>
  </view>

  <!-- 智能解析结果 -->
  <view wx:else="" class="review-stage">
    <view class="review-topbar">
      <view>
        <text class="review-title">识别完成</text>
        <view class="review-subtitle">
          <text wx:if="{{aiEnhanced}}" class="ai-result-badge">DeepSeek已精修</text>
          <text>请快速扫一眼，确认后即可下单</text>
        </view>
      </view>
      <view class="review-top-actions">
        <view class="review-deepseek-button {{isAiOptimizing ? 'button--disabled' : ''}}" bindtap="aiEnhance">
          <text class="review-deepseek-mark">DS</text>
          <text>{{aiEnhanced ? '再次精修' : 'DeepSeek'}}</text>
        </view>
        <view class="edit-source-button" bindtap="editOriginal">修改原文</view>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-item">
        <text class="summary-number">{{parseSummary.totalCount}}</text>
        <text class="summary-label">商品</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item summary-item--success">
        <text class="summary-number">{{parseSummary.validCount}}</text>
        <text class="summary-label">已确认</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item {{parseSummary.reviewCount > 0 ? 'summary-item--warning' : ''}}">
        <text class="summary-number">{{parseSummary.reviewCount}}</text>
        <text class="summary-label">待检查</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item summary-item--ai">
        <text class="summary-number">{{parseSummary.correctionCount}}</text>
        <text class="summary-label">智能修正</text>
      </view>
    </view>

    <view wx:if="{{departmentSegments.length > 0}}" class="department-result-card">
      <view class="result-icon result-icon--department">部</view>
      <view class="result-copy">
        <text class="result-title">已识别部门标题</text>
        <view class="department-chips">
          <text class="department-chip" wx:for="{{departmentSegments}}" wx:key="lineIndex">{{item.departmentName}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{corrections.length > 0}}" class="correction-card">
      <view class="correction-head" bindtap="toggleCorrectionDetails">
        <view class="result-icon result-icon--correction">✦</view>
        <view class="result-copy">
          <text class="result-title">AI 已自动修正 {{corrections.length}} 处</text>
          <text class="result-desc">原文保留，修正结果已写入订单</text>
        </view>
        <text class="expand-icon">{{showCorrectionDetails ? '⌃' : '⌄'}}</text>
      </view>
      <view wx:if="{{showCorrectionDetails}}" class="correction-list">
        <view class="correction-row" wx:for="{{corrections}}" wx:key="lineIndex">
          <text class="correction-source">{{item.segmentText}}</text>
          <view class="correction-change">
            <text class="wrong-text">{{item.from}}</text>
            <text class="change-arrow">→</text>
            <text class="right-text">{{item.to}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{parseSummary.reviewCount > 0}}" class="review-warning-card">
      <view class="warning-symbol">!</view>
      <view class="result-copy">
        <text class="result-title">有 {{parseSummary.reviewCount}} 条需要确认</text>
        <text class="result-desc">正确商品已保留，可补全黄色项目，或用 DeepSeek 精修</text>
      </view>
      <view class="warning-ai-button" bindtap="aiEnhance">DeepSeek</view>
    </view>

    <scroll-view
      class="orders-scroll"
      scroll-y="true"
      scroll-with-animation="true"
      scroll-into-view="{{scrollIntoViewId}}"
    >
      <view
        id="paste-v2-order-{{index}}"
        class="order-card {{item.v2NeedsReview ? 'order-card--review' : ''}} {{invalidOrderIndex == index ? 'order-card--invalid' : ''}}"
        wx:for="{{orderArr}}"
        wx:key="index"
      >
        <view class="order-card-head">
          <view class="order-sequence">{{index + 1}}</view>
          <view class="confidence-pill confidence-pill--{{item.v2Confidence}}">
            <text>{{item.v2NeedsReview ? '待确认' : (item.v2Confidence == 'high' ? '高置信' : '已确认')}}</text>
          </view>
          <picker
            wx:if="{{departmentOptions.length > 1}}"
            class="department-picker"
            mode="selector"
            range="{{departmentOptions}}"
            range-key="name"
            bindchange="changeOrderDepartment"
            data-index="{{index}}"
          >
            <view class="department-picker-value">{{item.v2DepartmentName || depName}}⌄</view>
          </picker>
          <text wx:else="" class="department-static">{{item.v2DepartmentName || depName}}</text>
          <view class="order-delete" bindtap="deleteOrder" data-index="{{index}}">删除</view>
        </view>

        <view class="order-fields">
          <view class="field field--name {{invalidOrderIndex == index && invalidOrderField == 'name' ? 'field--invalid' : ''}}">
            <text class="field-label">商品名称</text>
            <input
              class="field-input"
              value="{{item.nxDoGoodsName}}"
              bindinput="editOrder"
              data-index="{{index}}"
              data-field="name"
              placeholder="请输入商品"
            />
          </view>
          <view class="field field--quantity {{invalidOrderIndex == index && invalidOrderField == 'quantity' ? 'field--invalid' : ''}}">
            <text class="field-label">数量</text>
            <input
              class="field-input field-input--center"
              type="digit"
              value="{{item.nxDoQuantity}}"
              bindinput="editOrder"
              data-index="{{index}}"
              data-field="quantity"
              placeholder="0"
            />
          </view>
          <view class="field field--unit {{invalidOrderIndex == index && invalidOrderField == 'standard' ? 'field--invalid' : ''}}">
            <text class="field-label">单位</text>
            <input
              class="field-input field-input--center"
              value="{{item.nxDoStandard}}"
              bindinput="editOrder"
              data-index="{{index}}"
              data-field="standard"
              placeholder="斤"
            />
          </view>
        </view>

        <view wx:if="{{item.v2CorrectionText}}" class="inline-correction">
          <text class="inline-sparkle">✦</text>
          <text>已修正单位：{{item.v2CorrectionText}}</text>
        </view>
        <view wx:if="{{item.v2NeedsReview}}" class="inline-warning">
          <text>请确认：{{item.v2Warning}}</text>
        </view>

        <view wx:if="{{item.nxDoAddRemark || item.nxDoRemark}}" class="remark-field">
          <text class="remark-label">备注</text>
          <input
            class="remark-input"
            value="{{item.nxDoRemark}}"
            bindinput="editOrder"
            data-index="{{index}}"
            data-field="remark"
            placeholder="例如：要新鲜的、不要太大"
          />
        </view>

        <view class="order-quick-actions">
          <text wx:if="{{!item.nxDoAddRemark && !item.nxDoRemark}}" bindtap="addRemark" data-index="{{index}}">＋备注</text>
          <text bindtap="insertOrderBefore" data-index="{{index}}">＋在前面加一条</text>
          <text wx:if="{{item.v2SourceText}}" class="source-preview">原文：{{item.v2SourceText}}</text>
        </view>
      </view>

      <view class="append-order" bindtap="appendOrder">
        <text class="append-plus">＋</text>
        <text>手动补一条商品</text>
      </view>
      <view class="scroll-spacer"></view>
    </scroll-view>

    <view class="bottom-action-bar">
      <view class="secondary-bottom-button" bindtap="clearAll">重新下单</view>
      <view class="primary-bottom-button {{saving ? 'button--disabled' : ''}}" bindtap="saveOrders">
        <text>{{saving ? '正在生成订单…' : '确认下单'}}</text>
        <text wx:if="{{!saving}}" class="order-count">{{parseSummary.totalCount}}条</text>
      </view>
    </view>
  </view>

  <deepseek-loading show="{{showDeepSeekLoading}}" />

  <ocrUpload
    id="pasteV2OcrUpload"
    hide-upload="{{true}}"
    reset-key="{{ocrResetKey}}"
    image-list="{{ocrImageList}}"
    bind:imageChange="onOcrImageChange"
    bind:startOCR="onStartOCR"
    bind:startOCRFast="onStartOCRFast"
  ></ocrUpload>
</view>
