<!-- OCR 订单复核 V2：业务事件与原版保持一致，只调整信息层级和操作说明 -->
<view class="flex flex-column page-bg ocr-order-page ocr-order-v2">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{depName}}" avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"></back-navbar>

  <view class="flex flex-column ocr-order-content" style="flex: 1; min-height: 0;">
    <!-- 原图/原文对照和朗读检查模式 -->
    <view wx:if="{{isTTSReading || isCheckMode}}"
      class="flex flex-column reading-mode-container v2-reading-mode {{isResizing ? 'resizing' : ''}}"
      style="flex: 1; min-height: 0;">
      <view class="image-preview-container v2-source-preview"
        style="position: relative; flex-shrink: 0; height: {{imagePreviewHeight}}px; overflow: hidden;"
        wx:if="{{task.nxOcrTaskType == 1}}">
        <ocrImagePreview wx:if="{{task.nxOcrTaskImagePath}}" image-path="{{url + task.nxOcrTaskImagePath}}"
          image-index="{{0}}" total-orders="{{task.nxOcrTaskTotalOrders || 0}}"
          completed-orders="{{task.nxOcrTaskCompletedOrders || 0}}"
          pending-orders="{{task.nxOcrTaskPendingOrders || 0}}" show-stats-mask="{{false}}"
          initial-transform="{{imageTransformCache && imageTransformCache.transform}}"
          bind:transformChange="onImageTransformChange"
          style="position: absolute; top: 0; left: 0; z-index: 1001; width: 100%; height: 100%; box-sizing: border-box;">
        </ocrImagePreview>
      </view>

      <view class="text-content-container v2-source-preview"
        style="height: {{imagePreviewHeight}}px; flex-shrink: 0; overflow: hidden;"
        wx:if="{{task.nxOcrTaskType == 3}}">
        <scroll-view scroll-y="true" class="text-content-scroll" style="height: {{imagePreviewHeight}}px;">
          <view class="text-content-wrapper">
            <rich-text wx:if="{{highlightedText}}" class="text-content" nodes="{{highlightedText}}"></rich-text>
            <text wx:else class="text-content">{{task.nxOcrTaskOcrText || '暂无文字内容'}}</text>
          </view>
        </scroll-view>
      </view>

      <view class="resize-bar v2-resize-bar" bindtouchstart="onResizeTouchStart"
        catchtouchmove="onResizeTouchMove" bindtouchend="onResizeTouchEnd"
        bindtouchcancel="onResizeTouchEnd">
        <view class="v2-resize-summary">
          <text class="v2-source-label">{{task.nxOcrTaskType == 1 ? '原图对照' : '订单原文'}}</text>
          <view class="resize-bar-stats">
            <text class="resize-bar-item">共 {{task && task.nxOcrTaskTotalOrders || 0}}</text>
            <text class="resize-bar-item v2-success-text">已确认 {{task && task.nxOcrTaskCompletedOrders || 0}}</text>
            <text class="resize-bar-item v2-pending-text">待确认 {{task && task.nxOcrTaskPendingOrders || 0}}</text>
          </view>
        </view>
        <text class="resize-bar-hint">上下拖动</text>
      </view>

      <view class="v2-reading-guide">
        <view class="v2-guide-title-row">
          <text class="v2-guide-title">逐条核对订单</text>
          <text class="v2-guide-state" wx:if="{{isTTSLoading}}">正在准备朗读</text>
          <text class="v2-guide-state is-playing" wx:elif="{{isTTSPlaying}}">正在朗读第 {{currentTTSIndex + 1}} 条</text>
          <text class="v2-guide-state" wx:else>可编辑，也可开启朗读检查</text>
        </view>
      </view>

      <scroll-view scroll-y="{{!scrollLockedForGoods}}"
        class="order-list-scroll-view order-list-scroll-view-reading flex-1 {{scrollLockedForGoods ? 'order-list-expanded' : ''}} {{recognitionModalOpen ? 'order-list-recognition-modal-open' : ''}}"
        id="order-list-scroll-view-reading" style="min-height: 0;" scroll-top="{{scrollTop}}"
        scroll-with-animation="true" enhanced="true" show-scrollbar="false">
        <ocrOrderList list="{{orderArr}}" active-index="{{currentTTSIndex}}"
          is-reading-mode="{{isTTSReading && !isCheckMode}}" is-playing="{{isTTSPlaying}}"
          stopped-index="{{stoppedIndex}}" order-arr-index="{{orderArrIndex}}"
          recently-modified-order-index="{{recentlyModifiedOrderIndex}}" str-arr="{{strArr}}" nx-arr="{{nxArr}}"
          window-width="{{windowWidth}}" scroll-into-view-id="{{scrollIntoViewId}}" dep-id="{{depId}}"
          dep-father-id="{{depFatherId}}" dis-id="{{disId}}" user-id="{{userId}}"
          bind:edit="onOrderEdit" bind:editName="onOrderEditName" bind:focus="onOrderFocus"
          bind:showGoods="onOrderShowGoods" bind:closeGoods="onOrderCloseGoods"
          bind:saveOrder="onOrderSaveOrder" bind:downloadGoods="onOrderDownloadGoods"
          bind:showOperation="onOrderShowOperation" bind:scrollToItem="onScrollToItem"
          bind:confirmSearch="confirmSearchGoods" bind:orderUpdated="onOrderUpdated"
          bind:orderDeleted="onOrderDeleted" bind:addOrderBefore="onAddOrderBefore"
          bind:addDisAlias="onOrderAddDisAlias"
          bind:recognitionModalChange="onRecognitionModalChange"></ocrOrderList>

        <view class="v2-list-end flex-column-center text-secondary font-xs"
          style="height: {{isOrderInputFocused ? 600 : 100}}rpx;">已显示全部订单</view>
        <view wx:if="{{orderArr.length === 0}}" class="v2-empty flex-column-center">
          <text class="v2-empty-title">暂无订单</text>
          <text class="v2-empty-tip">返回后可重新上传订单内容</text>
        </view>
      </scroll-view>
    </view>

    <!-- 普通复核模式 -->
    <view wx:else class="flex flex-column v2-normal-mode" style="flex: 1; min-height: 0;">
      <view class="v2-overview-card">
        <view class="v2-overview-main">
          <view class="v2-eyebrow-row">
            <view class="v2-status-dot"></view>
            <text class="v2-eyebrow">识别结果</text>
          </view>
          <view class="v2-count-row">
            <text class="v2-count-current">{{task && task.nxOcrTaskCompletedOrders || 0}}</text>
            <text class="v2-count-total"> / {{task && task.nxOcrTaskTotalOrders || 0}} 条已确认</text>
          </view>
          <text wx:if="{{task && task.nxOcrTaskPendingOrders > 0}}" class="v2-pending-tip">
            还有 {{task.nxOcrTaskPendingOrders}} 条需要确认商品
          </text>
          <text wx:else class="v2-complete-tip">识别内容已全部确认</text>
        </view>

        <view class="v2-overview-actions">
          <view class="v2-action-button v2-action-danger" bind:tap="reuploadOrders" hover-class="v2-action-hover">
            <image src="/images/ashbin.png" mode="aspectFit" class="v2-action-icon" />
            <text>重新上传</text>
          </view>
          <view class="v2-action-button v2-action-primary" bind:tap="onMenuOpenCheck" hover-class="v2-action-hover">
            <image src="/images/Focus-Auto.png" mode="aspectFit" class="v2-action-icon" />
            <text>对照检查</text>
          </view>
        </view>
      </view>

      <view class="v2-list-header">
        <view class="v2-list-title-row">
          <text class="v2-list-title">订单明细</text>
          <text class="v2-list-tip">未确认内容可直接填写，更多操作点 ···</text>
        </view>
        <view class="v2-column-guide">
          <text class="v2-column-index">序号</text>
          <text class="v2-column-goods">商品</text>
          <text class="v2-column-number">数量</text>
          <text class="v2-column-unit">单位</text>
          <text class="v2-column-more">更多</text>
        </view>
      </view>

      <scroll-view scroll-y="true" class="order-list-scroll-view flex-1 v2-order-scroll"
        id="order-list-scroll-view-normal" style="min-height: 0;"
        scroll-top="{{scrollTop}}" scroll-into-view="{{scrollIntoViewId}}" scroll-with-animation="true">
        <ocrOrderList list="{{orderArr}}" active-index="{{currentTTSIndex}}"
          is-reading-mode="{{isTTSReading && !isCheckMode}}" is-playing="{{isTTSPlaying}}"
          stopped-index="{{stoppedIndex}}" order-arr-index="{{orderArrIndex}}"
          recently-modified-order-index="{{recentlyModifiedOrderIndex}}" str-arr="{{strArr}}" nx-arr="{{nxArr}}"
          window-width="{{windowWidth}}" scroll-into-view-id="{{scrollIntoViewId}}" dep-id="{{depId}}"
          dep-father-id="{{depFatherId}}" dis-id="{{disId}}" user-id="{{userId}}"
          bind:edit="onOrderEdit" bind:editName="onOrderEditName" bind:focus="onOrderFocus"
          bind:showGoods="onOrderShowGoods" bind:closeGoods="onOrderCloseGoods"
          bind:saveOrder="onOrderSaveOrder" bind:downloadGoods="onOrderDownloadGoods"
          bind:showOperation="onOrderShowOperation" bind:scrollToItem="onScrollToItem"
          bind:confirmSearch="confirmSearchGoods" bind:orderUpdated="onOrderUpdated"
          bind:orderDeleted="onOrderDeleted" bind:addOrderBefore="onAddOrderBefore"
          bind:addDisAlias="onOrderAddDisAlias"
          bind:recognitionModalChange="onRecognitionModalChange"></ocrOrderList>

        <view wx:if="{{currentPage < totalPages && isLoadingRemainingPages}}"
          class="flex-column-center text-secondary font-xs order-list-loading-more">
          <view class="order-list-loading-spinner"></view>
          <text class="order-list-loading-text">正在加载剩余订单</text>
        </view>
        <view wx:if="{{currentPage >= totalPages && orderArr.length > 0}}"
          class="v2-list-end flex-column-center text-center text-secondary font-xs"
          style="height: {{isOrderInputFocused ? 600 : 150}}rpx;">已显示全部订单</view>
        <view wx:if="{{orderArr.length === 0}}" class="v2-empty flex-column-center">
          <text class="v2-empty-title">暂无订单</text>
          <text class="v2-empty-tip">返回后可重新上传订单内容</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 朗读控制：仍使用原有开始、暂停、继续事件 -->
  <view class="player-menu-container v2-player-menu" wx:if="{{!showOperationPaste}}">
    <view wx:if="{{isCheckMode && !isTTSPlaying && !isTTSLoading && stoppedIndex < 0}}"
      class="player-expand-btn v2-read-button" bindtap="onMenuStartReading">
      <image src="/images/laba.png" class="v2-read-icon" mode="aspectFit"></image>
      <text>朗读检查</text>
    </view>
    <view wx:if="{{isTTSPlaying || isTTSLoading || stoppedIndex >= 0}}" class="player-menu-reading v2-reading-controls">
      <view wx:if="{{isTTSPlaying || isTTSLoading}}" class="player-menu-item v2-player-item" bindtap="pauseReading">
        <view class="control-icon stop-icon">⏸</view>
        <text class="menu-text">暂停朗读</text>
      </view>
      <view wx:if="{{stoppedIndex >= 0 && !isTTSPlaying && !isTTSLoading && !isStoppedByStatusMinus2}}"
        class="player-menu-item v2-player-item" bindtap="continueReading">
        <view class="control-icon replay-icon">↻</view>
        <text class="menu-text">继续朗读</text>
      </view>
    </view>
  </view>
</view>

<!-- 单条订单操作菜单：操作项及显示条件与原版一致 -->
<view class='overlay {{showOperationPaste ? "show" : "hide"}}' catchtouchmove='ture' catchtap="hideMask">
  <view class="nnn bg-white font-lg v2-operation-sheet">
    <view class="v2-sheet-handle"></view>
    <view class="v2-sheet-header border-bottom">
      <text class="v2-sheet-caption">订单操作</text>
      <text class="v2-sheet-title">{{orderItem && orderItem.nxDoGoodsName ? orderItem.nxDoGoodsName : ''}}</text>
    </view>
    <view class="flex-column v2-sheet-list">
      <block wx:if="{{orderItem && orderItem.nxDoStatus == 0}}">
        <view class="flex-row v2-sheet-item border-bottom" catchtap="editOrderItem" hover-class="hover">
          <image src="/images/edit.png" class="icon v2-sheet-icon"></image><text>修改订单</text>
        </view>
        <view class="flex-row v2-sheet-item border-bottom" catchtap="revertOrder" hover-class="hover">
          <image src="/images/Focus-Auto-2.png" class="icon v2-sheet-icon"></image><text>重新识别</text>
        </view>
      </block>
      <block wx:if="{{orderItem.nxDoStatus == -2}}">
        <view class="flex-row v2-sheet-item border-bottom" catchtap="delOrder" hover-class="hover">
          <image src="/images/edit.png" class="icon v2-sheet-icon"></image><text>删除订单</text>
        </view>
        <view class="flex-row v2-sheet-item border-bottom" catchtap="addRemark" hover-class="hover"
          wx:if="{{orderItem && (!orderItem.nxDoRemark || orderItem.nxDoRemark.length == 0)}}">
          <image src="/images/edit.png" class="icon v2-sheet-icon"></image><text>添加备注</text>
        </view>
        <view class="flex-row v2-sheet-item border-bottom" catchtap="clearRemark" hover-class="hover"
          wx:if="{{orderItem && orderItem.nxDoRemark && orderItem.nxDoRemark.length > 0}}">
          <image src="/images/edit.png" class="icon v2-sheet-icon"></image><text>清除备注</text>
        </view>
      </block>
      <view class="flex-row v2-sheet-item" catchtap="addNewPasteOrderBefore" hover-class="hover">
        <image src="/images/add.png" class="icon v2-sheet-icon"></image><text>在这条之前添加新订单</text>
      </view>
      <view class="flex-row v2-sheet-item" catchtap="addDisAlias" hover-class="hover"
        wx:if="{{orderItem && orderItem.nxDoStatus == -2}}">
        <image src="/images/add-bold-2.png" class="icon v2-sheet-icon"></image><text>保存新配送商品</text>
      </view>
      <view class="flex-row v2-sheet-item" catchtap="startReadingFromHere" hover-class="hover">
        <image src="/images/record.png" class="icon v2-sheet-icon"></image><text>从这里开始朗读</text>
      </view>
    </view>
    <view class="v2-sheet-safe"></view>
  </view>
</view>

<addOrder visible="{{show}}" bindconfirm="confirm" bindcancle="cancle" binddelApply="delApply"
  binddelStandard="delStandard" applyStandardName="{{applyStandardName}}" bindconfirmStandard="confirmStandard"
  applyNumber="{{applyNumber}}" applyRemark="{{applyRemark}}" editApply="{{editApply}}"
  bindchangeStandard="changeStandard" applyGoodsName="{{applyGoodsName}}" applyGoodsId="{{applyGoodsId}}"
  item="{{itemDis}}" windowWidth="{{windowWidth}}" newStandardName="{{newStandardName}}" />

<delWarnModal wx:if="{{showPopupWarn}}" type="{{popupType}}" warnContent="{{warnContent}}"
  bind:closeWarn="closeWarn" bind:confirmWarn="confirmWarn" />

