<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="flex-column height-100">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{name}}-价格" avatar="/images/back-gray.png" button-text="设置"
    bindnavbuttontap="toBack"></back-navbar>


  <view class="flex flex-column">

    <view class="section">

      <!-- 单部门 -->
      <view wx:if="{{depHasSubs  == 0}}">
        <view class="maodianPrice" style="height:{{windowHeight - 580 - statusBarHeight}}rpx;">
          <view id="NAV{{index}}" wx:for="{{applyArr.length}}" wx:key="index">NAV{{index}}</view>
        </view>

        <view class="section_body bg-white">
          <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV{{focusIndex}}"
            scroll-with-animation="true">

            <!-- single bumen：与多部门统一的卡片列表 -->
            <view class="wp-multi-orders font-md">
              <view class="wp-multi-order-card" wx:for="{{applyArr}}" wx:key="nxDepartmentOrdersId"
                wx:for-index="index" data-id="{{item.nxDepartmentOrdersId}}" id="NAV{{index}}">

                <view class="flex-column p-20">
                  <view class="flex flex-row wp-multi-order-title-row1" bind:tap="toHistoryPrice"
                    data-id="{{item.nxDistributerGoodsEntity.nxDistributerGoodsId}}"
                    data-item="{{item.nxDistributerGoodsEntity}}">
                    <text class="wp-multi-serial1 mr-10">{{index + 1}}</text>
                    <view class="flex-row-wrap align-center flex-1" bindtap="toGoodsDetail"
                      data-item="{{item.nxDistributerGoodsEntity}}">
                      <text class="brand"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                      <text class="mr-10 font-lg font-bold">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                      <block
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                        <text
                          class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                      </block>
                      <block wx:else>
                        <text class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                      </block>

                      <text class=" mr-20 text-secondary"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                      <text class=" text-secondary"
                        wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && item.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{item.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>

                    </view>
                    <view class="wp-multi-history-icon">
                      <image src="/images/searchmore.png" mode="aspectFill" class="icon ml-20" />
                    </view>
                  </view>

                  <view class="wp-multi-bottom-block">
                    <view class="flex flex-row wp-multi-bottom-row wp-multi-bottom-row-main">
                      <text class="text-white wp-multi-row-spacer">{{index + 1}}.</text>
                      <view class="flex-row wp-multi-qty-with-input wp-single-ship-row">
                        <text class="text-secondary">出货:</text>
                        <view class="flex-row " wx:if="{{item.nxDoWeight !== null}}">
                          <text class="">{{item.nxDoWeight}}</text>
                          <text class="">{{item.nxDoPrintStandard}}</text>
                        </view>
                      </view>
                      <view class="flex-row wp-multi-bottom-right wp-single-price-row">
                        <text class="text-secondary">单价:</text>
                        <view
                          class="flex weightInput wp-multi-weight-input flex-row {{index == focusIndex ? 'is-active' : ''}}"
                          bindtap="changeFocusIndexPrice" data-index="{{index}}">
                          <text class="input_number"
                            wx:if="{{item.nxDoPrice !== null && item.nxDoPrice !== '0.1' && item.nxDoPrice !== 0.1}}">{{item.nxDoPrice}}</text>
                          <view class='analog_cursor {{index == focusIndex ? "is-active" : "" }}'></view>
                        </view>
                        <text class="wp-single-price-unit">元/{{item.nxDoPrintStandard}}</text>
                      </view>
                    </view>
                    <view class="flex flex-row wp-multi-remark-line"
                      wx:if="{{item.nxDoRemark && item.nxDoRemark.length > 0}}">
                      <text class="text-white wp-multi-row-spacer"></text>
                      <view class="flex-row wp-multi-remark-row">
                        <text class="text-danger font-sm">({{item.nxDoRemark}})</text>
                      </view>
                    </view>
                  </view>

                  <block wx:if="{{item.nxDoCostPrice != null && item.nxDoCostPrice > 0.1}}">
                    <view class="flex-row wp-single-cost-row">
                      <view class="flex-row half-row">
                        <text class="text-secondary">进价:</text>
                        <text>{{item.nxDoCostPrice}}</text>
                        <text>元/{{item.nxDoPrintStandard}}</text>

                      </view>
                      <view class="flex-row half-row" wx:if="{{item.nxDistributerGoodsEntity.nxDgDistributerId !== disId}}">
                        <text class="text-secondary">协作伙伴:</text>
                        <text>{{item.nxDistributerGoodsEntity.goodsNxDistributerName}}</text>
                      </view>
                      <view class="flex-row half-row" wx:if="{{item.purchaseGoodsEntity !== null
                       && item.purchaseGoodsEntity.nxDpgDistributerId == disId 
                       && item.purchaseGoodsEntity.sellerUserEntity !== null 
                       &&  item.purchaseGoodsEntity.sellerUserEntity.nxJrdhWxNickName !== '' }}">
                        <text class="text-secondary">供货商:</text>
                        <text>{{item.purchaseGoodsEntity.sellerUserEntity.nxJrdhWxNickName}}</text>
                      </view>
                    </view>

                  </block>

                </view>
              </view>
            </view>
            <!-- ./single bumen -->
            <view class="bottom_place"></view>
          </scroll-view>
        </view>

      </view>

      <!-- 多部门 -->

      <view wx:else="">
        <view class="maodianSubsPrice" style="height:{{windowHeight - 580 - statusBarHeight}}rpx;">
          <view wx:for="{{depArr}}" wx:key="" wx:for-index="parentIndex" wx:for-item="dep" wx:key="depId">
            <view id="NAV_{{parentIndex}}_{{index}}" wx:for="{{dep.list.length}}">NAV_{{parentIndex}}_{{index}}</view>
          </view>
        </view>

        <view class="section_body bg-white">
          <scroll-view class="tui-city-scroll-y" scroll-y="true"
            scroll-into-view="NAV_{{focusParentIndex}}_{{focusIndex}}" scroll-with-animation="true">

            <view class="wp-multi-dep-section font-md" wx:for="{{applyArr}}" wx:for-index="parentIndex"
              wx:for-item="dep" wx:key="depId">
              <view class="wp-multi-dep-header">
                <view class="wp-multi-dep-header-accent"></view>
                <view class="wp-multi-dep-header-body">
                  <!-- <text class="wp-multi-dep-badge">子部门</text> -->
                  <text class="wp-multi-dep-name">{{dep.depName}}</text>
                  <text class="wp-multi-dep-meta">{{dep.list.length}} 条</text>
                </view>
              </view>
              <view class="wp-multi-orders">
                <view class="wp-multi-order-card" wx:for="{{dep.list}}" wx:for-item="order"
                  id="NAV_{{parentIndex}}_{{index}}" data-id="{{order.nxDepartmentOrdersId}}">

                  <view class="flex-column p-20">
                    <view class="flex flex-row wp-multi-order-title-row1" bind:tap="toHistoryPrice"
                      data-id="{{order.nxDistributerGoodsEntity.nxDistributerGoodsId}}"
                      data-item="{{order.nxDistributerGoodsEntity}}">
                      <text class="wp-multi-serial1 mr-10">{{index + 1}}.</text>
                      <view class="flex-row-wrap align-center flex-1" bindtap="toGoodsDetail"
                        data-item="{{order.nxDistributerGoodsEntity}}">
                        <text class="brand"
                          wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{order.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                        <text class="mr-10 font-lg font-bold">{{order.nxDistributerGoodsEntity.nxDgGoodsName}} </text>
                        <block
                          wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                          <text class=" m-10"
                            wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}}/{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                        </block>
                        <block wx:else>
                          <text class=" m-10">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                        </block>

                        <text class=" mr-20 text-secondary"
                          wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">产地:{{order.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                        <text class=" text-secondary"
                          wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && order.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{order.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>
                      </view>
                      <view class="wp-multi-history-icon">
                        <image src="/images/searchmore.png" mode="aspectFill" class="icon ml-20" />
                      </view>
                    </view>

                    <view class="wp-multi-bottom-block">
                      <view class="flex flex-row wp-multi-bottom-row wp-multi-bottom-row-main">
                        <text class="text-white wp-multi-row-spacer">{{index + 1}}.</text>
                        <view class="flex-row-between wp-multi-qty-row wp-multi-qty-with-input">
                          <view class="flex-row half-row">
                            <text class="text-secondary flex-fixed ">订货:</text>

                            <text class="">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>

                          </view>
                          <view class="flex flex-row half-row">
                            <text class="text-secondary">出货:</text>
                            <view class="flex-row " wx:if="{{order.nxDoWeight !== null}}">
                              <text class="">{{order.nxDoWeight}}</text>
                              <text class="">{{order.nxDoPrintStandard}}</text>
                            </view>
                          </view>
                        </view>
                        <view class="flex-row wp-multi-bottom-right">
                          <view
                            class="flex weightInput wp-multi-weight-input flex-row {{index == focusIndex && parentIndex == focusParentIndex ? 'is-active' : ''}}"
                            bindtap="changeFocusIndexPrice" data-parentindex="{{parentIndex}}" data-index="{{index}}">
                            <text class="input_number"
                              wx:if="{{order.nxDoPrice !== null && order.nxDoPrice !== '-1' && order.nxDoPrice !== '0.1' && order.nxDoPrice !== 0.1}}">{{order.nxDoPrice}}</text>
                            <view
                              class='analog_cursor {{index == focusIndex && parentIndex == focusParentIndex ? "is-active" : "" }}'>
                            </view>
                          </view>
                        </view>
                      </view>
                      <view class="flex flex-row wp-multi-remark-line" wx:if="{{order.nxDoRemark && order.nxDoRemark.length > 0}}">
                        <text class="text-white wp-multi-row-spacer"></text>
                        <view class="flex-row wp-multi-remark-row">
                          <text class="text-danger font-sm">({{order.nxDoRemark}})</text>
                        </view>
                      </view>
                    </view>


                  </view>


                </view>
              </view>

            </view>

            <view class="bottom_place"></view>

          </scroll-view>
        </view>

      </view>

    </view>

  </view>

</view>


<view class='customize_key_board liziBack flex flex-row {{focusIndex == -1 ? "hidden" : ""}}'>

  <view class="flex-row-wrap" style="width: {{windowWidth/4 * 3 }}rpx;">
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="1" hover-class="hoverKey"> 1</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="2" hover-class="hoverKey"> 2</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="3" hover-class="hoverKey"> 3</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="4" hover-class="hoverKey"> 4</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="5" hover-class="hoverKey"> 5</view>
    <view class="num border-bottom border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="6" hover-class="hoverKey"> 6</view>
    <view class="num border-bottom border-right border-top"
      style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="7"
      hover-class="hoverKey"> 7</view>
    <view class="num border-bottom border-right border-top"
      style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="8"
      hover-class="hoverKey"> 8</view>
    <view class="num border-bottom border-right border-top"
      style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="9"
      hover-class="hoverKey"> 9</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="del" hover-class="hoverKey"> X</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="0" hover-class="hoverKey"> 0</view>
    <view class="num border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;"
      bindtap="inputValue" data-value="." hover-class="hoverKey">.</view>
  </view>

  <view class="input_operation_part flex-column" style="width: {{windowWidth - (windowWidth / 4 * 3)}}rpx;">
    <view class="double_num border-bottom border-top with-border-left"
      style="width:100%; height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="close"
      hover-class="hoverKey">关闭</view>
    <!-- 0 -->
    <view wx:if="{{depHasSubs == 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue"
        data-value="next" hover-class="hoverKey" wx:if='{{focusIndex == applyArr.length - 1}}'> 完成</view>
      <view class="double_num with-border-left" style=" height:240rpx;line-height:240rpx;" bindtap="inputValue"
        data-value="next" hover-class="hoverKey" wx:else>保存</view>
    </view>
    <!-- 1 -->
    <view wx:if="{{depHasSubs > 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue"
        data-value="next" hover-class="hoverKey"
        wx:if='{{focusParentIndex == depArr.length -1 && focusIndex == depArr[focusParentIndex].depOrders.length - 1}}'>
        完成</view>
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue"
        data-value="next" hover-class="hoverKey" wx:else> 保存</view>
    </view>





  </view>


</view>