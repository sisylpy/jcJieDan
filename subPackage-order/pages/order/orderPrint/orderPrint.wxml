<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="flex flex-column">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{name}}备货单" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>



  <!-- dd -->
  <scroll-view scroll-y="true" style="height: {{windowHeight - 280}}rpx; background-color: #fff;">



    <view class="flex-column p-20">
      <block wx:if="{{depItem.nxDepartmentSubAmount == 0}}">

        <view class="flex-row-between border-bottom  p-10 " wx:for="{{applyArr}}" wx:for-item="order" wx:key="nxDepartmentOrdersId" wx:for-index="applyIndex">

          <view class="flex-row-default middle ">
            <text class="m-10">{{applyIndex + 1}}.</text>
            <view class="flex-cloumn" style="width: {{windowWidth - 160}}rpx; ">
              <view class="flex-row-wrap">
                <text class="brand" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{order.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                <text class=" m-10">{{order.nxDoGoodsName}}</text>
                <text>({{order.nxDoPrintStandard}})</text>

                <text class="text-sm darktext-secondary" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && order.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{order.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>

                <text class="margin-left m-10">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                <text class="red text-sm" wx:if="{{order.nxDoRemark !== null  && order.nxDoRemark.length > 0}}">({{order.nxDoRemark}})</text>

              </view>



