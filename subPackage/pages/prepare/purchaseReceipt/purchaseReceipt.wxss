.page { min-height: 100vh; background: #f4f7f6; color: #173e36; }
.content { padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 150rpx; }
.loading { padding: 100rpx 0; color: #71817d; text-align: center; }
.amount-card, .goods-card { margin-top: 20rpx; padding: 22rpx; border-radius: 16rpx; background: #fff; }
.amount-card { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.amount-card view { display: flex; flex-direction: column; gap: 6rpx; color: #71817d; font-size: 24rpx; }
.amount-card view text:last-child { color: #173e36; font-size: 30rpx; font-weight: 700; }
.amount-card .net text:last-child { color: #07806a; }
.title, .form-row, .actions, .stock-return { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.title { font-size: 30rpx; font-weight: 700; }
.title text:last-child { color: #07806a; font-size: 22rpx; }
.facts { margin: 12rpx 0; color: #71817d; font-size: 22rpx; }
.form-row { min-height: 76rpx; border-top: 1rpx solid #edf2f0; color: #49635c; font-size: 24rpx; }
.form-row input { flex: 1; height: 58rpx; padding: 0 14rpx; border-radius: 8rpx; background: #f4f7f6; text-align: right; }
.note { height: 66rpx; padding: 0 14rpx; border-radius: 8rpx; background: #f4f7f6; font-size: 23rpx; }
.event { margin-top: 16rpx; padding: 16rpx; border-radius: 10rpx; background: #fafcfb; color: #49635c; font-size: 22rpx; }
.actions { margin-top: 10rpx; justify-content: flex-end; }
.actions button, .stock-return button { flex: none; margin: 0; color: #07806a; font-size: 21rpx; }
.stock-return { margin-top: 8rpx; color: #71817d; }
.stock-return button { color: #a24d27; }
.confirm { position: fixed; right: 24rpx; bottom: 36rpx; left: 24rpx; color: #fff; background: #07806a; }
