page { background: #f4f7f6; color: #173b35; }
.self-page { box-sizing: border-box; padding-left: 24rpx; padding-right: 24rpx; }
.page-intro { padding: 24rpx 26rpx; margin-bottom: 20rpx; background: #e9f6f2; border-left: 6rpx solid #15947f; }
.intro-title { font-size: 34rpx; font-weight: 700; }
.intro-text { margin-top: 8rpx; color: #58716c; font-size: 27rpx; line-height: 1.55; }
.goods-card { margin-bottom: 22rpx; overflow: hidden; background: #fff; border: 1rpx solid #dfe8e5; border-radius: 14rpx; }
.goods-head { padding: 24rpx 24rpx 18rpx; border-bottom: 1rpx solid #e7eeec; }
.goods-title-row { display: flex; align-items: center; }
.goods-index { display: inline-flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 14rpx; color: #fff; background: #178d79; border-radius: 8rpx; font-size: 24rpx; }
.goods-name { font-size: 34rpx; font-weight: 700; }
.goods-standard { margin-left: 12rpx; color: #71847f; font-size: 26rpx; }
.planned { margin-top: 10rpx; margin-left: 54rpx; color: #71847f; font-size: 26rpx; }
.unit-warning { padding: 16rpx 24rpx; color: #b64b3b; background: #fff1ee; font-size: 27rpx; }
.price-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.field-label { font-size: 29rpx; font-weight: 600; }
.input-wrap { display: flex; align-items: center; }
.number-input { width: 170rpx; height: 66rpx; box-sizing: border-box; padding: 0 16rpx; text-align: right; background: #f3f7f6; border: 1rpx solid #cfddda; border-radius: 10rpx; font-size: 31rpx; }
.input-unit { width: 120rpx; margin-left: 10rpx; color: #58716c; font-size: 25rpx; }
.orders-title { padding: 15rpx 24rpx; color: #657b76; background: #f7f9f8; font-size: 26rpx; font-weight: 600; }
.order-row { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; padding: 16rpx 24rpx; border-top: 1rpx solid #edf1f0; }
.order-main { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.customer-name { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.ordered-quantity { margin-top: 6rpx; color: #748681; font-size: 25rpx; }
.order-remark { margin-top: 5rpx; color: #bc5c43; font-size: 24rpx; }
.actual-box { display: flex; align-items: center; margin-left: 20rpx; }
.actual-label { margin-right: 8rpx; color: #657b76; font-size: 25rpx; }
.quantity-input { width: 128rpx; height: 62rpx; box-sizing: border-box; padding: 0 12rpx; text-align: right; background: #f3f7f6; border: 1rpx solid #cfddda; border-radius: 10rpx; font-size: 30rpx; }
.quantity-unit { width: 55rpx; margin-left: 8rpx; color: #58716c; font-size: 25rpx; }
.goods-total { display: flex; align-items: center; justify-content: flex-end; padding: 20rpx 24rpx; background: #fafcfb; color: #657b76; font-size: 27rpx; }
.subtotal { min-width: 150rpx; margin-left: 18rpx; text-align: right; color: #d66a3a; font-size: 32rpx; font-weight: 700; }
.empty { padding: 120rpx 0; text-align: center; color: #7c8d89; font-size: 29rpx; }
.bottom-space { height: 150rpx; }
.submit-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #dce6e3; box-shadow: 0 -8rpx 30rpx rgba(27, 72, 63, .08); }
.total-block { display: flex; flex-direction: column; }
.total-label { color: #6c807b; font-size: 24rpx; }
.total-value { color: #d65f31; font-size: 36rpx; font-weight: 700; }
.submit-button { width: 320rpx; height: 78rpx; margin: 0; line-height: 78rpx; color: #fff; background: #168f7a; border-radius: 10rpx; font-size: 31rpx; font-weight: 700; }
.submit-button::after { border: 0; }
