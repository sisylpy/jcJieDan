<view class="flex-column flex">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{printViewMode == 'department' ? purchaseSelectedDepName || printCustomerName : '商品'}}-{{isPrintMode ? '打印采购单' : '复制订货'}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!-- here -->
  <view class="flex-column " >
    <view class="flex flex-row border-bottom p-20 bg-white" wx:for='{{purGoodsArr}}' wx:for-item="item" wx:for-index='goodsIndex' wx:key='nxDistributerPurchaseGoodsId'>

      <view class=" flex-column" >
        <view class="flex flex-row-between">
           <text>{{goodsIndex + 1}}.</text>
          <view class="flex-row-wrap" style="width: {{windowWidth / 3 * 2 - 40}}rpx;">
            <!-- 适配简化DTO：使用扁平化字段（数据已在js中统一格式化） -->
            <text class="brand" wx:if="{{item.nxDgGoodsBrand && item.nxDgGoodsBrand !== 'null' && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
            <text class=" font-lg font-bold">{{item.nxDgGoodsName}}</text>
            <text class="" wx:if="{{item.nxDgGoodsStandardWeight && item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
            <text class="" wx:else>({{item.nxDgGoodsStandardname}})</text>
            <text class="text-secondary" wx:if="{{item.nxDgGoodsPlace && item.nxDgGoodsPlace !== null && item.nxDgGoodsPlace.length > 0}}">{{item.nxDgGoodsPlace}}</text>
            <text class="text-secondary  text-secondary" wx:if="{{item.nxDgGoodsDetail && item.nxDgGoodsDetail.length > 0 && item.nxDgGoodsDetail !== 'null'}}">{{item.nxDgGoodsDetail}}</text>
          </view>
          <view class="center-content" style="width: {{windowWidth / 3 - 20}}rpx;" bindtap="toEditPurchaseGoods" data-item="{{item}}" data-index="{{goodsIndex}}">
          <!-- <text class="font-md mr-10">采购:</text> -->
            <image src="/images/add.png" mode="aspectFill" class="icon-lg" wx:if="{{item.nxDpgQuantity == 'null'}}"/>
            <view class="flex-row" wx:else="">   
              <text class="mr-20 font-lg">{{item.nxDpgQuantity}}{{item.nxDpgStandard}}</text>
              <image src="/images/edit-main.png" mode="aspectFill" class="icon"/>
            </view> 
          </view>
        </view>
     
          <!-- 适配简化DTO：使用 orders 字段（数据已在js中统一格式化） -->
          <view class="flex flex-row font-md" wx:for="{{item.orders}}" wx:for-item="order" wx:key="uniqueKey" wx:for-index="orderIndex" >
            <!-- 适配简化DTO：使用扁平化的 isSelected 字段 -->

            <view class="circle_default mr-10"></view>

            <!-- 协作订单：显示 [协作商名称]fatherDepartmentOrderCode（不含空格） -->
            <block wx:if="{{order.nxDoCollaborativeNxDisId !== undefined && order.nxDoCollaborativeNxDisId !== -1}}">
              <view class="flex-row ">
                <text class="mr-10">[{{order.nxDoCollaborativeDistributerName}}]{{order.fatherDepartmentOrderCode || ''}}</text>
              </view>
            </block>
            <!-- 适配简化DTO：使用扁平化字段（数据已在js中统一格式化） -->
            <block wx:elif="{{order.gbDepName}}">
              <view class="flex-row ">
                <text>{{order.gbDepName}}</text>
              </view>
            </block>

            <block wx:elif="{{order.restrauntName}}">
              <view class="flex-row ">
                <text>{{order.restrauntName}}</text>
              </view>
            </block>

            <block wx:else>
              <view class="flex-row ">
                <text wx:if="{{order.depName}}">{{order.depName}}</text>
                <text class="" wx:else>{{order.nxDepartmentOrderCode}}</text>
              </view>
            </block>

            <text class="ml-20">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
            <text wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark && order.nxDoRemark.length > 0}}" class="red">({{order.nxDoRemark}})</text>
          </view>
      
      </view>
    </view>

      <view  class="flex-column-center text-secondary font-sm" style="height: 100rpx;">没有数据了！</view>
  </view>
  <!-- ../here -->
</view>



<view  class="flex-row bottom-button-container p-10 ">
  <view class="flex flex-row ">
    <!-- <view class="flex-row" bindtap="changeHaveOrder" style="width:{{windowWidth /3 -20 }}rpx;">
      <label>带订单内容</label> <checkbox checked="{{haveOrder}}" />
    </view> -->
    <view class="btn {{canSave ? 'is-active' : ''}}" bind:tap="saveBatch"  style="width: {{windowWidth - 80}}rpx; line-height: 60rpx;text-align: center;border-radius: 20rpx; ">
      <text class="font-lg-2">{{isPrintMode ? '打印采购单' : '复制订货'}}</text>
    </view>
    
  </view>

</view>

<!-- 确认弹窗 -->
<view class="modal-overlay" wx:if="{{showConfirmModal}}" bindtap="closeConfirmModal" catchtouchmove="preventScroll">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
       <view class="flex-column">
        <text class="modal-title">复制内容预览：</text>
       </view>
       <view class="flex-column">
        <view class="modal-title mt-10 mb-10" style="font-size: 24rpx; margin-right: 10rpx;">隐藏订单</view>
        <switch checked="{{onlyGoodsNameAndTotal}}" bindchange="changeShowOrder"/>
         </view>
      <!-- <view class="modal-close" bindtap="closeConfirmModal">×</view> -->
    </view>
    <scroll-view class="modal-body" scroll-y="true" enable-back-to-top="true">
      <view class="content-preview">
        <view class="preview-content">
          <text>{{pasteContent}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="closeConfirmModal">关闭</view>
      <view class="modal-btn confirm-btn" bindtap="confirmSaveBatch">确认保存</view>
    </view>
  </view>
</view>

<editPurGoodsModal showPopup="{{showEditPurchase}}" bindconfirmEditGoods="confirmEditPurGoods" item="{{item}}" bindcloseEditPurGoods="closeEditPurGoods" applyStandardName="{{applyStandardName}}" planOrder="{{planOrder}}" />