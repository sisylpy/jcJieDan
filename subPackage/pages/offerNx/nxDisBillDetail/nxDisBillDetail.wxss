/* 账单详情卡片 */
.bill-detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bill-detail-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.bill-detail-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bill-detail-avatar-placeholder {
  background: #e8e8e8;
}

.bill-detail-info {
  flex: 1;
  min-width: 0;
}

.bill-detail-row {
  margin-bottom: 12rpx;
}

.bill-detail-row:last-of-type {
  margin-bottom: 16rpx;
}

.bill-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.bill-detail-amount-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bill-detail-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #276afa;
}

.purchase-order-source {
  box-sizing: border-box;
  width: 100%;
  margin: 12rpx 0 18rpx;
  padding: 14rpx 18rpx;
  border-left: 6rpx solid #18a889;
  border-radius: 8rpx;
  background: #f1faf7;
}

.purchase-order-source-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  line-height: 42rpx;
}

.purchase-order-source-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #68726f;
  font-size: 25rpx;
}

.purchase-order-source-id {
  color: #188c75;
  font-size: 26rpx;
  font-weight: 600;
}

.purchase-order-customer {
  min-width: 0;
  color: #202725;
  font-size: 27rpx;
  font-weight: 600;
  word-break: break-all;
}

