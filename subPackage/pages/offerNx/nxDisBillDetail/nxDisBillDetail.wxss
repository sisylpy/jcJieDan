/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #fff 0%, #f8fafb 100%);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.bottom-action-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.bottom-action-btn:active {
  transform: scale(0.98);
}

/* 主操作：确认收货 / 确认收款 */
.bottom-action-btn-primary {
  flex: 1;
  min-width: 0;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
}

.bottom-action-btn-primary:active {
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.4);
}

/* 申请收款 */
.bottom-action-btn-pay {
  flex: 1;
  min-width: 0;
  background: linear-gradient(135deg, #0a5acb 0%, #084a9e 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(10, 90, 203, 0.35);
}

.bottom-action-btn-pay:active {
  box-shadow: 0 4rpx 12rpx rgba(10, 90, 203, 0.4);
}

/* 已付款切换 */
.bottom-action-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  background: #f0f0f0;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.bottom-action-toggle.is-paid {
  color: #07c160;
  font-weight: 600;
  background: rgba(7, 193, 96, 0.12);
  border-color: rgba(7, 193, 96, 0.4);
}

.bottom-action-toggle:active {
  opacity: 0.8;
}

.toggle-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}
