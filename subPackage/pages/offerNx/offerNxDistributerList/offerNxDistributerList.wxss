

page{
  background: #f5f5f5;
}


/* 供货商卡片容器 */
.supplier-card-wrapper {
  padding: 20rpx;
  position: relative;
}

/* 经销商标签 */
.distributor-tag {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  margin-bottom: 10rpx;
  width: fit-content;
  margin-left: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #999;
}

/* 供货商信息卡片 - 基础，默认互为协作色 */
.supplier-info-card {
  border-radius: 16rpx;
  padding: 30rpx;
  transition: all 0.3s ease;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

/* 互为协作：双向供货/采购 */
.supplier-info-card.role-mutual {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

/* 我的供货商：不给他看 */
.supplier-info-card.role-supplier {
  background: linear-gradient(135deg, #ff9a56 0%, #ffd89b 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 86, 0.35);
}

/* 我的客户：不看他的 */
.supplier-info-card.role-customer {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  box-shadow: 0 8rpx 24rpx rgba(17, 153, 142, 0.35);
}

/* 双方暂停 */
.supplier-info-card.role-paused {
  background: linear-gradient(135deg, #b0b0b0 0%, #e0e0e0 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.supplier-info-card-hover {
  transform: translateY(-4rpx);
}
.supplier-info-card.role-mutual.supplier-info-card-hover { box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.45); }
.supplier-info-card.role-supplier.supplier-info-card-hover { box-shadow: 0 12rpx 32rpx rgba(255, 154, 86, 0.45); }
.supplier-info-card.role-customer.supplier-info-card-hover { box-shadow: 0 12rpx 32rpx rgba(17, 153, 142, 0.45); }
.supplier-info-card.role-paused.supplier-info-card-hover { box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2); }

/* 卡片头部 */
.supplier-info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.supplier-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.supplier-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.supplier-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.visibility-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.visibility-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 标签：我的客户(绿)、我的供货商(橙)、互为协作(紫) */
.tag-customer {
  background: rgba(17, 153, 142, 0.25);
  color: #0d7a6f;
}

.tag-supplier {
  background: rgba(255, 154, 86, 0.3);
  color: #c76b2a;
}

.tag-mutual {
  background: rgba(102, 126, 234, 0.25);
  color: #4c5fd5;
}

.tag-paused {
  background: rgba(176, 176, 176, 0.35);
  color: #666;
}

.supplier-menu-btn {
  background: rgba(255, 255, 255, 0.6);
  padding: 12rpx;
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-btn-hover {
  background: rgba(255, 255, 255, 0.8);
}

/* 邀请按钮样式 */
.invite-btns {
  gap: 20rpx;
}

.invite-btns-compact {
  padding-top: 12rpx !important;
  padding-bottom: 12rpx !important;
}

.invite-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: none;
  background: transparent;
}

.invite-btn::after {
  border: none;
}

/* 求供货给我 - 供货色(橙)，与「我的供货商」卡片一致 */
.invite-btn-primary {
  background: linear-gradient(135deg, #fff5eb 0%, #ffe4cc 100%) !important;
  border: 1rpx solid #ffd89b !important;
}

.invite-btn-primary .invite-btn-main {
  color: #c76b2a;
}

/* 求采购我的货 - 客户色(绿)，与「我的客户」卡片一致 */
.invite-btn-secondary {
  background: linear-gradient(135deg, #e8faf7 0%, #d4f5e8 100%) !important;
  border: 1rpx solid #38ef7d !important;
}

.invite-btn-secondary .invite-btn-main {
  color: #0d7a6f;
}

.invite-btn-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.invite-btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.invite-btn-main {
  font-size: 26rpx;
  font-weight: 600;
}

button{
  font-size: 32rpx;
}
.menu-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 操作菜单样式 */
.op-menu-header {
  padding: 24rpx 30rpx 16rpx;
  font-size: 26rpx;
  color: #999;
}

.op-menu-item {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.op-menu-item-hover {
  background: #f8f8f8;
}

.op-menu-item:last-child {
  border-bottom: none;
}

/* 协作设置项：开启/关闭状态视觉区分 */
.op-menu-item-setting {
  border-left: 6rpx solid transparent;
}

.op-menu-item-setting.op-menu-item-on {
  border-left-color: #11998e;
  background: rgba(17, 153, 142, 0.04);
}

.op-menu-item-setting.op-menu-item-off {
  border-left-color: #999;
  background: rgba(0, 0, 0, 0.02);
}

.op-menu-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.op-menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.op-menu-icon-customer {
  background: rgba(17, 153, 142, 0.15);
}

.op-menu-icon-supplier {
  background: rgba(255, 154, 86, 0.2);
}

.op-menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.op-menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.op-menu-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.op-menu-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.op-menu-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.op-menu-badge-on {
  background: rgba(17, 153, 142, 0.2);
  color: #0d7a6f;
}

.op-menu-badge-off {
  background: rgba(153, 153, 153, 0.2);
  color: #666;
}

.op-menu-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.op-menu-item-danger .op-menu-text {
  color: #e64340;
}

.op-menu-divider {
  height: 16rpx;
  background: #f5f5f5;
  margin: 0;
}

/* 订单统计 */
.supplier-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.supplier-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.6);
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  flex: 1;
  margin: 0 5rpx;
  backdrop-filter: blur(10rpx);
}

.supplier-stat-item:first-child {
  margin-left: 0;
}

.supplier-stat-item:last-child {
  margin-right: 0;
}

.supplier-stat-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.supplier-stat-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.supplier-stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-value-primary {
  color: #4c5fd5;
}

.stat-value-success {
  color: #11998e;
}

/* 付款详情 */
.payment-detail {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.payment-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.5);
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
}

.payment-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.payment-count {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.payment-value {
  font-size: 26rpx;
  font-weight: 700;
}

.payment-success {
  color: #11998e;
}

.payment-warning {
  color: #f5576c;
}

.payment-danger {
  color: #fa709a;
}

.ml-20 {
  margin-left: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}