page {
  background: #f5f5f5;
}

.invite-content {
  padding: 0 30rpx 40rpx;
}

/* 绿色顶部横幅 */
.invite-banner {
  padding: 40rpx;
  border-radius: 0 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.invite-banner-green {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

.invite-banner-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.invite-banner-text {
  font-size: 28rpx;
  color: #fff;
}

/* 信息卡片 */
.invite-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.invite-card-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.invite-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8e8e8;
  margin-right: 24rpx;
}

.invite-card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.partner-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.invite-card-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 详情行 */
.invite-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}

.invite-detail-row:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f0;
}

.invite-detail-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.invite-detail-text {
  font-size: 28rpx;
  color: #333;
}

/* 接受提示 */
.invite-accept-tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  padding: 20rpx 0;
}

/* 按钮 */
.invite-btns {
  margin-top: 20rpx;
}

.invite-btns-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.invite-btn {
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.invite-btns-row .invite-btn {
  flex: 1;
}

.invite-btn-primary {
  background: #07c160;
  color: #fff;
}

.invite-btn-secondary {
  background: #fff;
  color: #333;
  border: 1rpx solid #e0e0e0;
}
