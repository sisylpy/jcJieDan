<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="flex flex-column">
<back-navbar title="{{collItem.nxDistributerName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

<!--  top -->
<view class=" flex-row-between border-bottom bg-white"  style="margin-top: {{navBarHeight}}rpx;">
  <view class="flex-row">
    <view class="p-20" bindtap="toDatePage">
      <image src="/subPackage/images/calender.png" class="icon"></image>
    </view>
    <view class="flex-column">
      <view class="flex-row" wx:if="{{startDate == stopDate}}">
        <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
      </view>
      <view class="flex-row" wx:else>
        <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        <text class="p-10">-</text>
        <view class=" small" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
      </view>
    </view>
  </view>
  
  <view class="flex-row p-20" bindtap="toFilter">
    <!-- <image src="{{searchDepIds !== -1 ? '../../../../images/filter.png' : '../../../../images/filter-3-fill.png'}}" class="icon mr-20"></image> -->
  </view>
</view>


<view class="flex-column" style="height: {{windowHeight - navBarHeight - 120}}rpx;">

  <!-- Tabs：2 个按钮，显示选中状态 -->
  <view class="bill-type-tabs">
    <view class="bill-type-tab {{swiperCurrent == 0 ? 'bill-type-tab-active' : ''}}" bind:tap="switchToOffer">
      <image src="/images/xianhuoxiaoshoudanluzhisvg.png" class="bill-type-tab-icon"></image>
      <text class="bill-type-tab-label">销售单</text>
      <text class="bill-type-tab-count">({{offerBillArr.length}}个)</text>
    </view>
    <view class="bill-type-tab {{swiperCurrent == 1 ? 'bill-type-tab-active' : ''}}" bind:tap="switchToBuy">
      <image src="/images/jinhuodan.png" class="bill-type-tab-icon"></image>
      <text class="bill-type-tab-label">订货单</text>
      <text class="bill-type-tab-count">({{buyBillArr.length > 0 ? buyBillArr.length : buyCollCount}}个)</text>
    </view>
  </view>

  <!-- Swiper：左右滑动切换内容 -->
  <swiper class="bill-type-swiper" style="height: {{windowHeight - navBarHeight - 220}}rpx;" current="{{swiperCurrent}}" duration="300"
    indicator-dots="{{false}}" bindchange="onBillTypeChange" bindanimationfinish="onBillTypeAnimationFinish">
    <!-- 销售单列表 -->
    <swiper-item>
      <view class="bill-list-wrap p-20">
        <view wx:if="{{offerBillArr.length == 0}}" class="flex-column center-content" style="height: 200rpx;">
          <image class="empty_image" src="/images/xiuxi.png"></image>
          <text class="p-30">暂无销售单</text>
        </view>
        <scroll-view wx:else scroll-y="true" style="height: {{windowHeight - navBarHeight - 320}}rpx;">
          <view class="bill-item" wx:for="{{offerBillArr}}" wx:for-item="item" wx:key="nxDistributerBillId"
            bind:tap="openBatchDetail" data-id="{{item.nxDistributerBillId}}" data-value="{{item.nxDbdTotal}}" data-item="{{item}}">
            <view class="bill-content">
              <view class="bill-header p-20">
                <view class="bill-date-section">
                  <view class="font-md"><text class="text-secondary mr-10">协作商家:</text><text>{{item.offerNxDistributer.nxDistributerShowName || ''}}</text></view>
                  <view class="font-md"><text class="text-secondary mr-10">订单来源:</text><text>{{item.orderNxDistributer.nxDistributerShowName || ''}}</text></view>
                  <view class="font-xs">{{item.nxDbdTime}}</view>
                  <view class="status-badge status-settled" wx:if="{{item.nxDbdStatus == 0}}">收货确认</view>
                  <view class="status-badge status-pay" wx:elif="{{item.nxDbdStatus == 1}}">待付款</view>
                  <view class="status-badge status-pending" wx:elif="{{item.nxDbdStatus == 2}}">收款确认</view>
                  <view class="status-badge status-done" wx:elif="{{item.nxDbdStatus == 3}}">已付款</view>
                </view>
              </view>
              <view class="bill-amount-section flex-column">
                <view class="bill-amount">{{item.nxDbdTotal}}元</view>
                <text class="bill-type-text tag-offer" wx:if="{{item.nxDbdOfferNxDisId == disId}}">销售单</text>
                <text class="bill-type-text tag-purchase" wx:else="">订货单</text>
              </view>
            </view>
          </view>
          <view class="text-secondary center-content font-sm" style="height: 100rpx;">没有数据了!</view>
        </scroll-view>
      </view>
    </swiper-item>
    <!-- 订货单列表 -->
    <swiper-item>
      <view class="bill-list-wrap p-20">
        <view wx:if="{{buyBillArr.length == 0}}" class="flex-column center-content" style="height: 200rpx;">
          <image class="empty_image" src="/images/xiuxi.png"></image>
          <text class="p-30">暂无订货单</text>
        </view>
        <scroll-view wx:else scroll-y="true" style="height: {{windowHeight - navBarHeight - 320}}rpx;">
          <view class="bill-item" wx:for="{{buyBillArr}}" wx:for-item="item" wx:key="nxDistributerBillId"
            bind:tap="openBatchDetail" data-id="{{item.nxDistributerBillId}}" data-value="{{item.nxDbdTotal}}" data-item="{{item}}">
            <view class="bill-content">
              <view class="bill-header p-20">
                <view class="bill-date-section">
                  <view class="font-md"><text class="text-secondary mr-10">协作商家:</text><text>{{item.offerNxDistributer.nxDistributerShowName || ''}}</text></view>
                  <view class="font-md"><text class="text-secondary mr-10">订单来源:</text><text>{{item.orderNxDistributer.nxDistributerShowName || ''}}</text></view>
                  <view class="font-xs">{{item.nxDbdTime}}</view>
                  <view class="status-badge status-settled" wx:if="{{item.nxDbdStatus == 0}}">收货确认</view>
                  <view class="status-badge status-pay" wx:elif="{{item.nxDbdStatus == 1}}">待付款</view>
                  <view class="status-badge status-pending" wx:elif="{{item.nxDbdStatus == 2}}">收款确认</view>
                  <view class="status-badge status-done" wx:elif="{{item.nxDbdStatus == 3}}">已付款</view>
                </view>
              </view>
              <view class="bill-amount-section flex-column">
                <view class="bill-amount">{{item.nxDbdTotal}}元</view>
                <text class="bill-type-text tag-offer" wx:if="{{item.nxDbdOfferNxDisId == disId}}">销售单</text>
                <text class="bill-type-text tag-purchase" wx:else="">订货单</text>
              </view>
            </view>
          </view>
          <view class="text-secondary center-content font-sm" style="height: 100rpx;">没有数据了!</view>
        </scroll-view>
      </view>
    </swiper-item>
  </swiper>

</view>

</view>
