.agreement-container {
  padding: 30rpx;
  min-height: 100vh;
  background: #fff;
}

.agreement-content {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.update-time {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
  display: block;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 0 16rpx 0;
  display: block;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
  display: block;
}
