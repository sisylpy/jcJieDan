<wxs src="../../../../utils/fn.wxs" module="tool" />



<view class="flex flex-column">

<back-navbar style="height: {{navBarHeight}}rpx;" title="{{name}}-价格" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


    <!-- 单部门 -->
    <view wx:if="{{depHasSubs  == 0}}">
      <view class="maodianPrice" style="height:{{windowHeight - 580 - statusBarHeight}}rpx;">
        <view id="NAV{{index}}" wx:for="{{applyArr.length}}" wx:key="index">NAV{{index}}</view>
      </view>

      <view class="section_body" style="top: 40rpx; ">
        <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV{{focusIndex}}" scroll-with-animation="true">

          <!-- single bumen -->
          <view class="flex-column with-border-bottom  " wx:for="{{applyArr}}" wx:key="nxDepartmentOrdersId" wx:for-index="index" data-id="{{item.nxDepartmentOrdersId}}" >
            <view class="flex-row with-tbl-padding" id="NAV{{index}}">
              <view class="flex-column">

                <view class="flex-row">
                  <text class="">{{index + 1}}.</text>
                  <view class="flex-row-wrap normal five-weight" bindtap="toGoodsDetail" data-item="{{item.nxDistributerGoodsEntity}}" >
                    <text class="brand" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                    <text class="margin-l-right">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                    <block wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                      <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}})</text>
                    </block>
                    <block wx:else>
                      <text class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                    </block>

                    <text class=" margin-right gray" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                    <text class=" gray" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && item.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{item.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>

                  </view>
                </view>

                <view class="flex-row">
                  <text class="empty">{{index + 1}}.</text>
                  <view class="flex-column" >
                      <view class="flex-row-between small" style="width: {{windowWidth / 3 * 2 }}rpx; ">
                        <view class="flex-row half-row">
                          <text class=" margin-right flex-fixed ">订货:</text>
                           <view class="flex-column">
                            <text class="">{{item.nxDoQuantity}}{{item.nxDoStandard}}</text>
                        
                           </view>  
                        </view>
                        <view class="flex-row half-row">
                          <text class=" margin-right flex-fixed ">出货:</text>
                          <view class="flex-row" wx:if="{{item.nxDoWeight !== null}}">
                            <text class="">{{item.nxDoWeight}}</text>
                            <text class="">{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                          </view>
                        </view>
                      </view>
                      <view class="flex-row">
                        <text class="red " wx:if="{{item.nxDoRemark.length > 0}}">({{item.nxDoRemark}})</text> 
                      </view>

                      <block wx:if="{{disInfo.nxDistributerType  == '2'}}">
                        <view class="flex-row">
                        <view class="flex-row half-row">
                         <text class="margin-l-right">利润:</text>
                         <text >{{item.nxDoProfitSubtotal == null ? '0': item.nxDoProfitSubtotal}}元</text>
                       </view>
                      <view class="flex-row half-row">
                         <text class="margin-l-right">利润率:</text>
                         <text >{{item.nxDoProfitScale == null ? '0': item.nxDoProfitScale}}%</text>
                       </view>
                     
                     </view>
                      <view class="flex-row" wx:if="{{item.nxDoCostPrice !== null}}" style="width: {{windowWidth / 3 * 2 }}rpx;">
                        <view class="flex-row half-row">
                          <text class="margin-l-right">进货:</text>
                          <text class="margin-l-right">{{tool.transferDateString(item.nxDoCostPriceUpdate)}}</text>
                        </view>
                        <view class="flex-row half-row">
                          <text class="margin-l-right">进价:</text>
                          <text>{{item.nxDoCostPrice}}</text>
                          <text class="margin-right">元/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                        </view>
                      </view> 
                      </block>
                     
                  </view>
                  <view class="flex-row">
                   
                    <view class="flex-row ">
                      <view class=" weightInput margin-l-right flex-row {{index == focusIndex ? 'is-active' : ''}}" bindtap="changeFocusIndexPrice" data-index="{{index}}" style="width: {{item.nxDepartmentDisGoodsEntity !== null &&  item.nxDoPrice == null ? windowWidth / 3 - 200 : windowWidth / 3 - 140}}rpx;">
                        <text class="input_number" wx:if="{{item.nxDoPrice !== null && item.nxDoPrice !== '-1'}}">{{item.nxDoPrice}}</text>
                        <view class='analog_cursor {{index == focusIndex && parentIndex == focusParentIndex ? "is-active" : "" }}'></view>
                      </view>
                      
                    </view>
                    <view class=" flex-row margin_l_bottom" wx:if="{{item.nxDepartmentDisGoodsEntity !== null &&  item.nxDoPrice == null}}">
                        <text class="quickBtn" bindtap="quickPrice" data-index="{{index}}"> {{item.nxDepartmentDisGoodsEntity.nxDdgOrderPrice}}</text>
                      </view>
                     
                  </view>

                </view>


              </view>
            </view>

          </view>
          <!-- ./single bumen -->
          <view class="bottom_place"></view>
        </scroll-view>
      </view>

    </view>

    <!-- 多部门 -->

    <view wx:if="{{depHasSubs  == 1}}">
      <view class="maodianSubsPrice" style="height:{{windowHeight - 580  - statusBarHeight}}rpx;">
        <view wx:for="{{applyArr.arr}}" wx:key="" wx:for-index="parentIndex" wx:for-item="dep" wx:key="depId">
          <view id="NAV_{{parentIndex}}_{{index}}" wx:for="{{dep.depOrders.length}}">NAV_{{parentIndex}}_{{index}}</view>
        </view>
      </view>

      <view class="section_body" style="top: 140rpx; ">
        <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV_{{focusParentIndex}}_{{focusIndex}}" scroll-with-animation="true">

          <view class="flex-column " wx:for="{{applyArr.arr}}" wx:for-index="parentIndex" wx:for-item="dep" wx:key="depId">
            <text class="with-border-bottom  with-tb-padding  gray">#{{dep.depName}}</text>
            <view class="flex-row with-border-bottom with-tbl-padding" wx:for="{{dep.list}}" wx:for-item="order" id="NAV_{{parentIndex}}_{{index}}" data-id="{{order.nxDepartmentOrdersId}}">

              <view class="flex-column goods_name " bindtap="toGoodsDetail" data-item="{{order.nxDistributerGoodsEntity}}">
                <view class="flex-row ">
                  <text class="margin-right">{{index + 1}}.</text>
                  <view class="flex-row-wrap">
                    <text class="brand" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{order.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                    <text class="">{{order.nxDistributerGoodsEntity.nxDgGoodsName}} </text>
                    <block wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                      <text class=" margin-l-right" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}})</text>
                    </block>
                    <block wx:else>
                      <text class=" margin-l-right">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                    </block>

                    <text class=" margin-right gray" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">产地:{{order.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                    <text class=" gray" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && order.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{order.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>
                  </view>
                </view>

                <view class="flex-row">
                  <text class="margin-right white">{{index + 1}}.</text>
                  <view class="flex-column">
                    <view class="flex-row-wrap">
                      <text class=" flex-fixed">今日订货: {{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                      <text class="red " wx:if="{{order.nxDoRemark.length > 0}}">({{order.nxDoRemark}})</text>
                    </view>
                    <view class="" wx:if="{{order.nxDepartmentDisGoodsEntity.nxDdgOrderPrice !== null }}">
                      <text>上次价格:</text>
                      <text>{{order.nxDepartmentDisGoodsEntity.nxDdgOrderPrice}}/{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                    </view>
                  </view>
                </view>


              </view>

              <view class="today_price">
                <view class="weightInput margin-l-right flex-row" bindtap="changeFocusIndex" data-index="{{index}}" data-parentindex="{{parentIndex}}">
                  <text class="input_number" wx:if="{{order.nxDoPrice !== null && order.nxDoPrice !== '-1'}}">{{order.nxDoPrice}}</text>
                  <view class='analog_cursor {{index == focusIndex && parentIndex == focusParentIndex ? "is-active" : "" }}'></view>
                </view>
              </view>
            </view>
          </view>

          <view style="height: {{windowHeight / 2}}rpx;"></view>
        </scroll-view>
      </view>

    </view>

 
  
</view>


<view class='customize_key_board liziBack flex-row {{lastInput ? "hidden" : ""}}'>

  <view class="flex-row-wrap" style="width: {{windowWidth/4 * 3 }}rpx;">
    <view class="num with-border-bottom with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="7" hover-class="hoverKey"> 7</view>
    <view class="num with-border-bottom with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="8"  hover-class="hoverKey"> 8</view>
    <view class="num with-border-bottom" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="9"  hover-class="hoverKey"> 9</view>
    <view class="num with-border-bottom with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="4"  hover-class="hoverKey"> 4</view>
    <view class="num with-border-bottom with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="5"  hover-class="hoverKey"> 5</view>
    <view class="num with-border-bottom " style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="6"  hover-class="hoverKey"> 6</view>
    <view class="num with-border-bottom with-border-right with-border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="1"  hover-class="hoverKey"> 1</view>
    <view class="num with-border-bottom with-border-right with-border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="2"  hover-class="hoverKey"> 2</view>
    <view class="num with-border-bottom  with-border-top" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="3"  hover-class="hoverKey"> 3</view>
    <view class="num with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="del"  hover-class="hoverKey"> X</view>
    <view class="num with-border-right" style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="0"  hover-class="hoverKey"> 0</view>
    <view class="num " style="width:{{windowWidth/4}}rpx; height:120rpx; line-height:120rpx;" bindtap="inputValue" data-value="."  hover-class="hoverKey">.</view>
  </view>

  <view class="input_operation_part flex-column" style="width: {{windowWidth - (windowWidth / 4 * 3)}}rpx;">
    <view class="double_num with-border-bottom with-border-top with-border-left" style="width:100%; height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="close"  hover-class="hoverKey">关闭</view>
    <!-- 0 -->
    <view wx:if="{{depHasSubs == 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next"  hover-class="hoverKey" wx:if='{{focusIndex == applyArr.length - 1}}'> 完成</view>
      <view class="double_num with-border-left" style=" height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next"  hover-class="hoverKey" wx:else>保存</view>
    </view>
    <!-- 1 -->
    <view wx:if="{{depHasSubs > 0}}">
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next"  hover-class="hoverKey" wx:if='{{focusParentIndex == depArr.length -1 && focusIndex == depArr[focusParentIndex].depOrders.length - 1}}'> 完成</view>
      <view class="double_num with-border-left" style="height:240rpx;line-height:240rpx;" bindtap="inputValue" data-value="next"  hover-class="hoverKey" wx:else> 保存</view>
    </view>





  </view>


</view>