<import src='../../../../template/resGoods/resGoods.wxml' />
<import src='../../../../template/resGroup/resGroup.wxml' />

<view class="flex flex-column">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{editDepAttrName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <block wx:if="{{depGoodsArr.length == 0}}">
    <view class="flex-column center-content" style="height: {{windowHeight  - navBarHeight}}rpx; ">
      <view class="flex flex-column center-content">
        <image class="empty_image" src="../../../images/xiuxi.png"></image>
        <text class="font-xl p-20">暂时无订货商品</text>
        <text class=" darktext-secondary">显示配送成功的商品</text>
      </view>

    </view>
  </block>
  <view wx:else="" class="flex-column">

    <!--  top -->
    <view class=" flex-row-reverse p-20 border-bottom bg-white">

      <view class="button-container" bindtap="toPdf">
        <image src="/images/loanManage.png" mode="aspectFill" class="button-image" />
      </view>

      <view class="flex-row p-20" bindtap="toFilter">
        <image src="" class="icon mr-20"></image>
      </view>
    </view>
    <view class="flex-column  font-md bg-white" wx:for="{{depGoodsArr}}" wx:for-item="father" wx:for-index="fatherIndex" wx:key="nxDistributerFatherGoodsId">
      <view class=" flex-row-between p-20 border-bottom" bindtap="openFather" data-fatherindex="{{fatherIndex}}" id="Pur{{father.nxDistributerFatherGoodsId}}" data-id="{{father.nxDistributerFatherGoodsId}}" hover-class="hover">
        <view class="flex-column">
          <text class="wordColor"> {{father.nxDfgFatherGoodsName}}</text>
          <!-- <view class="flex-row">

                  <text class="mainColor small"> {{father.dgGoodsSubNames}}</text>

                </view> -->

        </view>
        <view>
          <image src="{{father.isSelected ? '/images/reduce-btn.png' : '/images/iconadd.png'}}" mode="aspectFill" class="icon" />

        </view>
      </view>

      <view class="flex-column   goodsList {{father.isSelected ? 'is-active' : ''}}">
        <view class="flex-column border-bottom" wx:for="{{father.nxDepartmentDisGoodsEntities}}" wx:for-item="depGoods" wx:key="nxDepartmentDisGoodsId">
          <view class="p-20 font-lg flex-row-between">
            <view class="flex-column">
              <view class="flex-row">
               
                <text class="mr-20">{{depGoods.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                <text>({{depGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                 <block wx:if="{{depGoods.nxDistributerGoodsEntity.nxDgWillPriceTwoStandard !== null}}">
                  <text>erji:{{depGoods.nxDistributerGoodsEntity.nxDgWillPriceTwoStandard}}</text>
                 </block>
                <text class="font-sl text-secondary">{{depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail !== null ? depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail : '' }}</text>
                <text class="font-xs" wx:if="{{depInfo.nxDepartmentEntities.length > 1}}">({{depGoods.nxDepartmentEntity.nxDepartmentAttrName}})</text>
              </view>

              <view class="flex-row">
                <text class=" mr-20">商品名称：{{depGoods.nxDdgDepGoodsName}}</text>
                <text class=" mr-20">客户订货：{{depGoods.nxDdgOrderGoodsName}}</text>
              </view>

              <view class="flex-row-between small pt-10 pb-10" style=" width: {{windowWidth - 40}}rpx;">
                <view class="flex-row">
                  <text class="mr-10 text-secondary">订货日期:</text>
                  <text class="mr-20">{{depGoods.nxDdgOrderDate}}</text>
                </view>
                <view class="flex-row">
                  <text class="mr-10 text-secondary">订货日期:</text>
                  <text class="mr-20">{{depGoods.nxDdgOrderQuantity}}{{depGoods.nxDdgOrderStandard}}</text>
                </view>


              </view>

              <view class="flex-row-between small  pt-10 pb-10">
                <view class="flex-row">
                  <text class="mr-10 text-secondary">出货要求:</text>
                  <text class="mr-20">{{depGoods.nxDdgPickDetail == null ? "无" : depGoods.nxDdgPickDetail }}</text>
                </view>
                <view class="flex-row">
                  <text class="mr-10 text-secondary">订货商品名称:</text>
                  <text class="" >{{depGoods.nxDdgOrderGoodsName}}</text>                
                  </view>

              </view>
              <view class="flex-row-default small  pt-10 pb-10">
                <text class="mr-10 text-secondary">配送价格:</text>
                <text class="mr-20">{{depGoods.nxDdgOrderPrice}}元/{{depGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>

               
              </view>

              <view class="flex-row-between">
              

                <view class="p-20" bindtap="deleteDepGoods" data-id="{{depGoods.nxDepartmentDisGoodsId}}">
              <image src="/images/ashbin.png" mode="aspectFill" class="icon" />
            </view>

              <view class="plr-20" bindtap="selDepartment" data-goods="{{depGoods.nxDistributerGoodsEntity}}" data-depgoods="{{depGoods}}">
                <image src="/images/edit.png" mode="aspectFill" class="icon" />
              </view>

            </view>

            </view>

           

             

            
           


          </view>

        </view>
      </view>

    </view>
    <view class="center-content font-xs text-secondary" style="height: 200rpx;">
      没有数据啦！
    </view>
  </view>
</view>







<!-- mask -->
<view class='overlay {{showOperationPrice ? "show" : ""}}'>

  <!-- + edit -->
  <view class="popup">
    <view class="p-20  flex-column">
      <view class="flex-row big p-20">
        <text class="mr-10">{{disGoods.nxDgGoodsName}}</text>
        <text wx:if="{{disGoods.nxDgGoodsDetail != null && disGoods.nxDgGoodsDetail.length > 0}}"> {{disGoods.nxDgGoodsDetail}}</text>
      </view>

      <view class="flex-row p-20 font-lg">
        <view class="mr-20 shrink_fix text-secondary">配送单价:</view>
        <input type="digit" class="input shrink_change" bindinput="inputSellingPrice" value="{{sellingPrice}}" />元{{disGoods.nxDsStandardName}}
      </view>
      <view class="flex-row p-20 font-lg">
        <view class="mr-20 shrink_fix text-secondary">出货要求:</view>
        <input type="digit" class="input shrink_change" bindinput="inputPickDetail" value="{{pickDetail}}" />
      </view>
      <view class="flex-row p-20 font-lg">
        <view class="mr-20 shrink_fix text-secondary">订货商品名称:</view>
        <input type="digit" class="input shrink_change" bindinput="inputOrderName" value="{{orderName}}" />
      </view>

    </view>

    <view class="flex-row-between p-30">
      <view class="p-20 bg-light" catchtap="hideMask">
        <text class="bg-light"> 取消</text>
      </view>
      <view class="p-20 bg-success" catchtap="_updateDepGoods">
        <text class="">保存</text>
      </view>
    </view>

  </view>


</view>