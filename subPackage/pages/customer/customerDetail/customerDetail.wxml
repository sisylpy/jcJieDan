<view class="page-container">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="客户资料" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-content" style="padding-top: {{navBarHeight + 20}}rpx;">
    <!-- 客户身份摘要 -->
    <view class="customer-header-card" bindtap="showProfileEditor">
      <view class="header-main">
        <image class="header-avatar" src="{{customerImageSrc || '/images/customer.png'}}" mode="aspectFill"></image>
        <view class="header-info">
          <view class="header-name-row">
            <text class="header-name">{{depInfo.nxDepartmentName || '未命名客户'}}</text>
            <text class="header-status-chip {{depInfo.nxDepartmentWorkingStatus == 0 ? 'is-open' : 'is-closed'}}">
              {{depInfo.nxDepartmentWorkingStatus == 0 ? '合作中' : '已关闭'}}
            </text>
          </view>
          <text class="header-code">对外订货代号：{{depInfo.nxDepartmentOrderCode || '未设置'}}</text>
          <text class="header-meta">{{depInfo.nxDepartmentSettleType == 0 ? '现金结算' : '记账结算'}} · {{depInfo.nxDepartmentDeliveryMode == 'SELF_PICKUP' ? '客户自提' : '配送到店'}}</text>
          <view class="header-labels" wx:if="{{depInfo.selectedLabels && depInfo.selectedLabels.length}}">
            <text class="label-pill" wx:for="{{depInfo.selectedLabels}}" wx:key="nxDistributerLabelId">{{item.nxDlName}}</text>
          </view>
        </view>
      </view>
      <view class="header-edit-cue">
        <text>编辑</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>

    <!-- 客户与打印 -->
    <view class="section-card module-card">
      <view class="section-header tappable" bindtap="showProfileEditor">
        <view class="section-icon icon-basic">客</view>
        <view class="section-heading-copy">
          <text class="section-title">客户与打印</text>
          <text class="section-subtitle">客户称呼、订货代号和打印格式</text>
        </view>
        <text class="module-action">修改</text>
      </view>
      <view class="section-row tappable" bindtap="showProfileEditor">
        <text class="row-label">配送单名称</text>
        <view class="row-value"><text>{{depInfo.nxDepartmentName || '未设置'}}</text><image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image></view>
      </view>
      <view class="section-row tappable" bindtap="showProfileEditor">
        <text class="row-label">标签简称</text>
        <view class="row-value"><text>{{depInfo.nxDepartmentAttrName || '未设置'}}</text><image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image></view>
      </view>
      <view class="section-row tappable" bindtap="showProfileEditor">
        <text class="row-label">送货单格式</text>
        <view class="row-value">
          <text wx:if="{{depInfo.nxDepartmentPrintName == 'ApplyPanel'}}">一张一列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyFiftyPanel'}}">一张两列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyHalfWholePanel'}}">半张一列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyHalfPanel'}}">半张两列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyWholePanel'}}">三分之一张一列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyPanel'}}">三分之一张两列</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'BlueToothPrint'}}">蓝牙打印机</text>
          <text wx:elif="{{depInfo.nxDepartmentPrintName == 'feiEPrint'}}">飞鹅打印机</text>
          <text wx:else>半张一列</text>
          <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
        </view>
      </view>
    </view>

  <!-- 负责员工（业务员 / 录单员） -->
  <view class="section-card module-card" wx:if="{{depInfo.nxDepartmentIsGroupDep == 1}}">
    <view class="section-header">
      <view class="section-icon icon-staff">员</view>
      <view class="section-heading-copy">
        <text class="section-title">负责员工</text>
        <text class="section-subtitle">分别指定业务跟进和订单录入人员</text>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">负责业务员</text>
      <view class="row-value">
        <picker mode="selector" range="{{salesOptions}}" range-key="name" value="{{salesIndex}}" bindchange="changeSalesUser">
          <view class="picker-value">
            <text>{{salesOptions[salesIndex] ? salesOptions[salesIndex].name : '加载中'}}</text>
            <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
          </view>
        </picker>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">负责录单员</text>
      <view class="row-value">
        <picker mode="selector" range="{{clerkOptions}}" range-key="name" value="{{clerkIndex}}" bindchange="changeClerkUser">
          <view class="picker-value">
            <text>{{clerkOptions[clerkIndex] ? clerkOptions[clerkIndex].name : '加载中'}}</text>
            <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
          </view>
        </picker>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label"></text>
      <view class="row-value">
        <button class="staff-save-btn" size="mini" disabled="{{staffSaving}}" bindtap="saveResponsibilityStaff">保存负责人</button>
      </view>
    </view>
  </view>

    <!-- 交易规则 -->
    <view class="section-card module-card">
    <view class="section-header tappable" bindtap="showTradeSettingsEditor">
      <view class="section-icon icon-trade">交</view>
      <view class="section-heading-copy">
        <text class="section-title">交易规则</text>
        <text class="section-subtitle">结算、定价和客户经营业态</text>
      </view>
      <text class="module-action">修改规则</text>
    </view>
    <view class="section-row tappable" bindtap="showTradeSettingsEditor">
      <text class="row-label">支付方式</text>
      <view class="row-value"><text>{{depInfo.nxDepartmentSettleType == 0 ? '现金' : '记账'}}</text><image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image></view>
    </view>
    <view class="section-row tappable" bindtap="showTradeSettingsEditor">
      <text class="row-label">定价类型</text>
      <view class="row-value"><text>{{depInfo.nxDepartmentType == 'unFixed' ? '市场变动' : '固定价格'}}</text><image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image></view>
    </view>
    <view class="section-row tappable" bindtap="showBusinessTypeEditor">
      <text class="row-label">经营业态</text>
      <view class="row-value">
        <text class="{{customerBusinessTypeName ? 'business-type-value' : 'text-secondary'}}">
          {{customerBusinessTypeName || '点击选择'}}
        </text>
        <text class="business-type-inherited" wx:if="{{businessTypeInherited}}">继承</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
  </view>

    <!-- 标签与分组 -->
    <view class="section-card module-card">
    <view class="section-header">
      <view class="section-icon icon-label">标</view>
      <view class="section-heading-copy">
        <text class="section-title">标签与分组</text>
        <text class="section-subtitle">用于客户筛选和经营分类</text>
      </view>
      <text class="module-action" bindtap="showLabelModal">管理标签</text>
    </view>
    <view class="section-row" bindtap="showLabelModal">
      <text class="row-label">客户标签</text>
      <view class="row-value">
        <block wx:if="{{!depInfo.selectedLabels || depInfo.selectedLabels.length === 0}}">
          <text class="text-secondary">暂无标签</text>
        </block>
        <block wx:else>
          <view class="label-list-inline">
            <text class="label-pill" wx:for="{{depInfo.selectedLabels}}" wx:key="nxDistributerLabelId">{{item.nxDlName}}</text>
          </view>
        </block>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
  </view>

    <!-- 路线配送 -->
    <view class="section-card module-card">
    <view class="section-header tappable" bindtap="showLocationTimeModal">
      <view class="section-icon icon-delivery">配</view>
      <view class="section-heading-copy">
        <text class="section-title">路线配送</text>
        <text class="section-subtitle">位置、地址、配送时段和卸货要求</text>
      </view>
      <text class="module-action">修改配送</text>
    </view>
    <view class="section-row" bindtap="showLocationTimeModal">
      <text class="row-label">地址与位置</text>
      <view class="row-value">
        <text class="delivery-summary-value {{depInfo.nxDepartmentLat && depInfo.nxDepartmentAddress ? 'text-success' : 'text-danger'}}">
          {{depInfo.nxDepartmentAddress || (depInfo.nxDepartmentLat ? '已设置地图位置' : '未设置')}}
        </text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">配送时段</text>
      <text class="row-value">{{(formattedEarliestTime && formattedLatestTime) ? formattedEarliestTime + ' - ' + formattedLatestTime : '未设置'}}</text>
    </view>
    <view class="section-row">
      <text class="row-label">卸货时间</text>
      <text class="row-value">{{depInfo.nxDepartmentUnloadDuration ? depInfo.nxDepartmentUnloadDuration + '分钟' : '未设置'}}</text>
    </view>
    
  </view>

    <!-- 门店与部门 -->
    <view class="section-card module-card">
    <view class="section-header">
      <view class="section-icon icon-address">门</view>
      <view class="section-heading-copy">
        <text class="section-title">门店与部门</text>
        <text class="section-subtitle">调整客户归属或维护下级门店</text>
      </view>
    </view>
    
    <view class="section-row" bindtap="trunasferDep">
      <text class="row-label">调整客户归属</text>
      <view class="row-value"><text>选择目标部门</text><image class="icon" src="/images/exchange.png" mode="aspectFill"></image></view>
    </view>
    <view class="section-row">
      <text class="row-label">下级门店</text>
      <view class="row-value" bindtap="showSubDeps">
        <block wx:if="{{depInfo.nxDepartmentEntities && depInfo.nxDepartmentEntities.length > 0}}">
          <text class="text-wrap" wx:for="{{depInfo.nxDepartmentEntities}}" wx:key="nxDepartmentId">{{item.nxDepartmentName}}</text>
        </block>
        <block wx:else>
          <text class="text-secondary">未设置</text>
          <view class="add-btn">+</view>
        </block>
      </view>
    </view>
  </view>

    <!-- 订货渠道；业务入口已移至客户业务流程页 -->
    <view class="section-card module-card" wx:if="{{disInfo.nxDistributerAppId !== '-1'}}">
    <view class="section-header">
      <view class="section-icon icon-goods">订</view>
      <view class="section-heading-copy">
        <text class="section-title">订货渠道</text>
        <text class="section-subtitle">客户小程序账号与订货入口</text>
      </view>
    </view>
    <view class="section-row tappable" bindtap="toCustomerUser">
      <text class="row-label">小程序用户</text>
      <view class="row-value">
        <text>查看绑定用户</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">订货小程序</text>
      <text class="row-value">{{depInfo.nxDepartmentAppId == 'wx159c5a46d80e4500' ? '通用订货' : '定制订货'}}</text>
    </view>
  </view>

    <!-- 合作状态 -->
    <view class="section-card module-card" wx:if="{{depInfo.nxDepartmentSettleType == 0}}">
    <view class="section-header">
      <view class="section-icon icon-status">通</view>
      <view class="section-heading-copy">
        <text class="section-title">合作状态</text>
        <text class="section-subtitle">关闭后客户将不能继续下单</text>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">当前状态</text>
      <text class="row-value {{depInfo.nxDepartmentWorkingStatus == 0 ? 'status-open' : 'status-closed'}}">{{depInfo.nxDepartmentWorkingStatus == 0 ? '已开通' : '未开通'}}</text>
    </view>
    <view class="section-row">
      <text class="row-label">账号操作</text>
      <view class="row-value"><button class="staff-save-btn {{depInfo.nxDepartmentWorkingStatus == 0 ? 'btn-close' : ''}}" size="mini" disabled="{{workingStatusSaving}}" bindtap="toggleWorkingStatus">{{depInfo.nxDepartmentWorkingStatus == 0 ? '关闭客户' : '开通客户'}}</button></view>
    </view>
  </view>

    <view class="archive-line" wx:if="{{depInfo.nxDepartmentCreateTime}}">客户创建于 {{depInfo.nxDepartmentCreateTime}}</view>

    <view class="danger-zone">
      <view>
        <text class="danger-title">删除客户</text>
        <text class="danger-desc">删除后客户相关记录不可恢复</text>
      </view>
      <button class="danger-button" size="mini" bindtap="deleteDep">删除</button>
    </view>
  </view>

</view>

<!-- 客户与打印弹窗：只修改本模块字段 -->
<view class="overlay {{profileEditorVisible ? 'show' : ''}}" catchtouchmove="stopPropagation" catchtap="hideProfileEditor">
  <view class="edit-popup profile-popup" catchtap="stopPropagation">
    <view class="modal-header">
      <view><text class="modal-title">客户与打印</text><text class="modal-subtitle">只修改客户称呼、订货代号和打印方式</text></view>
      <text class="modal-close" bindtap="hideProfileEditor">×</text>
    </view>
    <scroll-view scroll-y class="profile-form-scroll">
      <view class="profile-image-editor">
        <image class="profile-image-preview" src="{{profileDraft.imagePreview || customerImageSrc || '/images/customer.png'}}" mode="aspectFill"></image>
        <view class="profile-image-copy">
          <text class="profile-image-title">客户主图片</text>
          <text class="profile-image-hint">辅助识别客户，不影响订货资料</text>
        </view>
        <button class="profile-image-button" loading="{{profileImageUploading}}" disabled="{{profileImageUploading}}" bindtap="chooseCustomerImage">更换图片</button>
      </view>
      <view class="form-group">
        <text class="form-label">客户名称</text>
        <input class="form-input" value="{{profileDraft.name}}" bindinput="getDepName" placeholder="用于配送单打印" />
      </view>
      <view class="form-group">
        <text class="form-label">简称（标签打印）</text>
        <input class="form-input" value="{{profileDraft.shortName}}" bindinput="getDepAttrName" placeholder="用于商品标签" />
      </view>
      <view class="form-group">
        <text class="form-label">对外订货代号</text>
        <input class="form-input" value="{{profileDraft.orderCode}}" bindinput="getDepOrderCode" placeholder="客户订货时显示" />
      </view>
      <view class="form-group print-group">
        <text class="form-label">送货单与打印设备</text>
        <radio-group class="print-options" bindchange="radioChangePrint">
          <label class="choice-option"><radio value="ApplyPanel" checked="{{profileDraft.printName == 'ApplyPanel'}}" color="#0a8f61"/><text>一张一列</text></label>
          <label class="choice-option"><radio value="ApplyFiftyPanel" checked="{{profileDraft.printName == 'ApplyFiftyPanel'}}" color="#0a8f61"/><text>一张两列</text></label>
          <label class="choice-option"><radio value="ApplyHalfWholePanel" checked="{{profileDraft.printName == 'ApplyHalfWholePanel'}}" color="#0a8f61"/><text>半张一列</text></label>
          <label class="choice-option"><radio value="ApplyHalfPanel" checked="{{profileDraft.printName == 'ApplyHalfPanel'}}" color="#0a8f61"/><text>半张两列</text></label>
          <label class="choice-option"><radio value="ApplyThirtyWholePanel" checked="{{profileDraft.printName == 'ApplyThirtyWholePanel'}}" color="#0a8f61"/><text>三分之一张一列</text></label>
          <label class="choice-option"><radio value="ApplyThirtyPanel" checked="{{profileDraft.printName == 'ApplyThirtyPanel'}}" color="#0a8f61"/><text>三分之一张两列</text></label>
          <label class="choice-option"><radio value="BlueToothPrint" checked="{{profileDraft.printName == 'BlueToothPrint'}}" color="#0a8f61"/><text>蓝牙打印机</text></label>
          <label class="choice-option"><radio value="feiEPrint" checked="{{profileDraft.printName == 'feiEPrint'}}" color="#0a8f61"/><text>飞鹅打印机</text></label>
        </radio-group>
      </view>
    </scroll-view>
    <view class="modal-actions"><button class="modal-button secondary" disabled="{{profileImageUploading}}" bindtap="hideProfileEditor">取消</button><button class="modal-button primary" loading="{{profileSaving}}" disabled="{{profileSaving || profileImageUploading}}" bindtap="saveProfileInfo">保存</button></view>
  </view>
</view>

<!-- 交易规则弹窗：不混入打印或配送字段 -->
<view class="overlay {{tradeEditorVisible ? 'show' : ''}}" catchtouchmove="stopPropagation" catchtap="hideTradeSettingsEditor">
  <view class="edit-popup trade-popup" catchtap="stopPropagation">
    <view class="modal-header">
      <view><text class="modal-title">交易规则</text><text class="modal-subtitle">只修改结算方式和定价规则</text></view>
      <text class="modal-close" bindtap="hideTradeSettingsEditor">×</text>
    </view>
    <view class="trade-form">
      <view class="choice-group">
        <text class="form-label">支付方式</text>
        <radio-group class="choice-row" bindchange="radioChange">
          <label class="choice-card"><radio value="0" checked="{{tradeDraft.settleType == 0}}" color="#0a8f61"/><view><text>现金</text><text>每单即时结算</text></view></label>
          <label class="choice-card"><radio value="1" checked="{{tradeDraft.settleType == 1}}" color="#0a8f61"/><view><text>记账</text><text>按账期统一结算</text></view></label>
        </radio-group>
      </view>
      <view class="choice-group">
        <text class="form-label">定价方式</text>
        <radio-group class="choice-row" bindchange="radioChangeFixed">
          <label class="choice-card"><radio value="unFixed" checked="{{tradeDraft.pricingType == 'unFixed'}}" color="#0a8f61"/><view><text>市场变动</text><text>订单价格可调整</text></view></label>
          <label class="choice-card"><radio value="fixed" checked="{{tradeDraft.pricingType == 'fixed'}}" color="#0a8f61"/><view><text>固定价格</text><text>使用客户固定价</text></view></label>
        </radio-group>
      </view>
    </view>
    <view class="modal-actions"><button class="modal-button secondary" bindtap="hideTradeSettingsEditor">取消</button><button class="modal-button primary" loading="{{tradeSaving}}" disabled="{{tradeSaving}}" bindtap="saveTradeSettings">保存</button></view>
  </view>
</view>

<!-- 地理位置和配送时间设置弹窗 -->
<view class='overlay {{showLocationTimeModal ? "show" : ""}}' catchtouchmove="stopPropagation" catchtap="hideLocationTimeModal">
  <view class="edit-popup delivery-popup bg-white p-20" catchtap="stopPropagation">
    <view class="flex-column">
      <view class="modal-header delivery-modal-header">
        <view><text class="modal-title">路线配送</text><text class="modal-subtitle">只修改位置、地址、配送时段和卸货要求</text></view>
        <text class="modal-close" bindtap="hideLocationTimeModal">×</text>
      </view>
      
      <!-- 设置提示 -->
      <view class="flex-row p-10" style="background-color: #f0f8ff; border-radius: 8rpx; margin: 10rpx 0;">
        <text class="text-secondary" style="font-size: 24rpx;">配送位置必填，配送时间可按需设置</text>
      </view>
      
      <!-- 当前设置状态 -->
      <view class="flex-row p-10" style="background-color: #f8f9fa; border-radius: 8rpx; margin: 10rpx 0;" wx:if="{{formattedEarliestTime || formattedLatestTime}}">
        <text class="text-secondary" style="font-size: 24rpx;">当前设置: {{formattedEarliestTime}} - {{formattedLatestTime}}</text>
      </view>
      
      <!-- 地理位置设置 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">地理位置:</text>
        <view class="flex-column" style="flex: 1;">
          <view class="flex-row-between p-10">
            <text class="delivery-status {{selectedLatitude ? 'set' : 'unset'}}">纬度: {{selectedLatitude || '未设置'}}</text>
            <text class="delivery-status {{selectedLongitude ? 'set' : 'unset'}}">经度: {{selectedLongitude || '未设置'}}</text>
          </view>
          <view class="flex-row p-10">
            <button class="btn-primary" bindtap="chooseLocation" style="width: 200rpx; height: 60rpx; font-size: 24rpx;">选择位置</button>
          </view>
        </view>
      </view>

      <!-- 详细地址 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">详细地址:</text>
        <view class="flex-column" style="flex: 1;">
          <textarea class="delivery-address" placeholder="请输入详细地址（可选）" value="{{deliveryAddress}}" bindinput="onDeliveryAddressInput" style="width: 100%; height: 80rpx; font-size: 24rpx;"></textarea>
          <view class="flex-row p-5">
            <text class="delivery-status {{deliveryAddress ? 'set' : 'unset'}}" style="font-size: 20rpx;">{{deliveryAddress ? '已设置地址' : '未设置地址'}}</text>
          </view>
        </view>
      </view>

      <!-- 配送时间设置 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">最早配送时间:</text>
        <picker mode="time" value="{{earliestDeliveryTime}}" bindchange="onEarliestTimeChange">
          <view class="picker-item {{earliestDeliveryTime ? 'selected' : ''}}">
            {{earliestDeliveryTime || '请选择时间'}}
          </view>
        </picker>
      </view>

      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">最晚配送时间:</text>
        <picker mode="time" value="{{latestDeliveryTime}}" bindchange="onLatestTimeChange">
          <view class="picker-item {{latestDeliveryTime ? 'selected' : ''}}">
            {{latestDeliveryTime || '请选择时间'}}
          </view>
        </picker>
      </view>

      <!-- 卸货时间 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">卸货时间:</text>
        <input class="input" type="number" maxlength="4" placeholder="请输入卸货时间（分钟）" value="{{unloadDuration}}" bindinput="onUnloadDurationInput" style="width: 200rpx; text-align: right;" />
        <text class="ml-10 text-secondary">分钟</text>
      </view>

      <!-- 配送备注 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">配送备注:</text>
        <textarea class="delivery-notes" maxlength="256" placeholder="请输入配送备注信息（可选）" value="{{deliveryNotes}}" bindinput="onDeliveryNotesInput" style="width: 100%; height: 100rpx;"></textarea>
      </view>

      <!-- 配送优先级 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">配送优先级:</text>
        <picker mode="selector" range="{{priorityOptions}}" value="{{priorityIndex}}" bindchange="onPriorityChange">
          <view class="picker-item">
            {{priorityOptions[priorityIndex]}}
          </view>
        </picker>
      </view>

      <!-- 是否允许提前配送 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">允许提前配送:</text>
        <switch checked="{{allowEarlyDelivery}}" bindchange="onEarlyDeliveryChange" color="#07c160"/>
      </view>
    </view>

    <view class="flex-row-between" style="padding: 30rpx 40rpx;">
      <view class="p-10 third-row center-content hover" bindtap="hideLocationTimeModal">取消</view>
      <view class="p-10 third-row center-content {{canSave && !savingDeliverySettings ? 'bg-success' : 'bg-gray'}}" bindtap="updateLocationTimeInfo">
        {{savingDeliverySettings ? '保存中...' : (canSave ? '保存设置' : '请完善设置')}}
      </view>
    </view>
  </view>
</view>









<!-- 调整客户归属前选择下级门店 -->
<view class='overlay {{showChoice ? "show" : ""}}' catchtap="hideChoiceMask">
  <view class='popup' style="width:{{windowWidth/3 * 2}}rpx; ">
    <!-- 分店列表 -->
    <view class="flex-column p-20 p-20 bg-white">
      <view class="flex flex-row border-bottom p-20 {{depInfo.nxDepartmentEntities.length -1 == index ? 'is-last' : ''}} flex-row-default" wx:for="{{depInfo.nxDepartmentEntities}}" wx:key="nxDepartmentId" wx:for-item="dep" bindtap="selectDepartment" data-item="{{dep}}" hover-class="hover">
        <text class=''>{{dep.nxDepartmentName}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 客户标签管理弹窗 -->
<view class='overlay {{showLabelModal ? "show" : ""}}' catchtap="hideLabelModal">
  <view class='popup label-popup bg-white' catchtap="stopPropagation">
    <!-- 标题栏 -->
    <view class="flex-row-between p-20 border-bottom">
      <text class="font-lg font-bold">客户标签管理</text>
      <view bindtap="hideLabelModal">
        <image src="/images/close-2.png" mode="aspectFill" class="icon-sm" />
      </view>
    </view>
    
    <!-- 标签内容区域 -->
    <view class="label-content">
      <!-- 全部标签（配送商标签） -->
      <view class="label-section">
        <view class="flex-row-between p-20 border-bottom" style="background: #f5f5f5;">
          <text class="text-secondary font-sm">全部标签（配送商标签）</text>
          <view class="flex-row">
            <input class="new-label-input" placeholder="新标签名称" value="{{newLabelName}}" bindinput="getNewLabelName" />
            <view class="btn-add-label" bindtap="addNewLabel">+</view>
          </view>
        </view>
        
        <!-- 标签列表 -->
        <scroll-view scroll-y class="label-list">
          <view class="p-20 border-bottom" wx:for="{{labelList}}" wx:key="nxDistributerLabelId">
            <view class="flex-row-between">
              <view class="flex-row" bindtap="toggleLabel" data-id="{{item.nxDistributerLabelId}}">
                <image src="{{item.selected ? '/images/selected-2.png' : '/images/radiobuttonunselect-2.png'}}" mode="aspectFill" class="icon-sm mr-10" />
                <text>{{item.nxDlName}}</text>
              </view>
              <view class="btn-delete-label" bindtap="deleteDistributerLabel" data-id="{{item.nxDistributerLabelId}}" data-label="{{item}}">
                <text class="text-danger font-sm">删除</text>
              </view>
            </view>
          </view>
          
          <!-- 无标签提示 -->
          <view class="p-40 center-content" wx:if="{{labelList.length === 0}}">
            <text class="text-secondary">暂无标签，请添加</text>
          </view>
        </scroll-view>
      </view>
      
      <!-- 已选标签（当前客户的标签） -->
      <view class="selected-section">
        <view class="p-20 border-bottom" style="background: #f5f5f5;">
          <text class="text-secondary font-sm">已选标签（当前客户） ({{selectedLabels.length}})</text>
        </view>
        
        <scroll-view scroll-y class="selected-list">
          <view class="p-20 border-bottom" wx:for="{{selectedLabels}}" wx:key="nxDistributerLabelId">
            <view class="flex-row-between">
              <text>{{item.nxDlName}}</text>
              <view class="btn-remove-label" bindtap="removeSelectedLabel" data-id="{{item.nxDistributerLabelId}}">
                <text class="text-danger font-sm">移除</text>
              </view>
            </view>
          </view>
          
          <!-- 无已选标签提示 -->
          <view class="p-40 center-content" wx:if="{{selectedLabels.length === 0}}">
            <text class="text-secondary">点击上方标签添加</text>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- 底部按钮 -->
    <view class="flex-row p-20 border-top">
      <view class="flex-1 p-20 center-content bg-light mr-10" bindtap="hideLabelModal">取消</view>
      <view class="flex-1 p-20 center-content bg-success" bindtap="saveCustomerLabels">保存</view>
    </view>
  </view>
</view>
