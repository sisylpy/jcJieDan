<import src='../../../../template/resGoods/resGoods.wxml' />
<import src='../../../../template/resGroup/resGroup.wxml' />

<view class="page-container">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{editDepAttrName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!-- 头部客户卡片 -->
  <view class="customer-header-card" bindtap="editGroupInfo" style="margin-top: 180rpx;">
    <view class="header-main">
      <image class="header-avatar" src="{{url + (depInfo.nxDepartmentUserEntities && depInfo.nxDepartmentUserEntities.length > 0 && depInfo.nxDepartmentUserEntities[0].nxDuWxAvartraUrl) || '/images/customer.png'}}" mode="aspectFill"></image>
      <view class="header-info">
        <view class="header-name-row">
          <text class="header-name">{{depInfo.nxDepartmentName}}</text>
          <!-- <view class="tag tag-primary">客户</view> -->
        </view>
        <view class="header-code-row">
          <text class="header-code">对外订货：{{depInfo.nxDepartmentOrderCode}}</text>
        </view>
        <view class="header-status-row">
          <text class="header-code">分组标签：</text>
          <text class="label-pill" wx:for="{{depInfo.selectedLabels}}" wx:key="nxDistributerLabelId">{{item.nxDlName}}</text>
        </view>
      </view>
    </view>
    <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
  </view>

  <!-- 基本信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-basic">基</view>
      <text class="section-title">打印信息</text>
    </view>
    <view class="section-row" bindtap="editGroupInfo">
      <text class="row-label">客户名称（配送单打印）</text>
      <view class="row-value">
        <text>{{depInfo.nxDepartmentName}}</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row" bindtap="editGroupInfo">
      <text class="row-label">简称名称（标签打印）</text>
      <view class="row-value">
        <text>{{depInfo.nxDepartmentAttrName}}</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row" bindtap="editGroupInfo">
      <text class="row-label">送货单尺寸格式</text>
      <view class="row-value">
        <block wx:if="{{depInfo.nxDepartmentPrintName == 'ApplyPanel'}}">一张一列</block>
        <block wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyFiftyPanel'}}">一张二列</block>
        <block wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyHalfWholePanel'}}">半张一列</block>
        <block wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyHalfPanel'}}">半张两列</block>
        <block wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyWholePanel'}}">三分之一张一列</block>
        <block wx:elif="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyPanel'}}">三分之一张两列</block>
        <block wx:else>半张一列</block>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    
  </view>

  <!-- 交易信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-trade">交</view>
      <text class="section-title">交易信息</text>
    </view>
    <view class="section-row">
      <text class="row-label">是否送货</text>
      <text class="row-value">{{depInfo.nxDepartmentDeliveryMode  == 'SELF_PICKUP'  ?  '自提': '送货'}} </text>
    </view>
    <view class="section-row">
      <text class="row-label">支付方式</text>
      <text class="row-value">{{depInfo.nxDepartmentSettleType == 0 ? '现金' : '记账'}}</text>
    </view>
    <view class="section-row">
      <text class="row-label">定价类型</text>
      <text class="row-value">{{depInfo.nxDepartmentType == 'unFixed' ? '市场变动' : '固定'}}</text>
    </view>
    <view class="section-row" bindtap="showBusinessTypeEditor">
      <text class="row-label">经营业态</text>
      <view class="row-value">
        <text class="{{customerBusinessTypeName ? 'business-type-value' : 'text-secondary'}}">
          {{customerBusinessTypeName || '点击选择'}}
        </text>
        <text class="business-type-inherited" wx:if="{{businessTypeInherited}}">继承</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
  </view>

  <!-- 标签与分组 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-label">标</view>
      <text class="section-title">标签与分组</text>
    </view>
    <view class="section-row" bindtap="showLabelModal">
      <text class="row-label">客户标签</text>
      <view class="row-value">
        <block wx:if="{{!depInfo.selectedLabels || depInfo.selectedLabels.length === 0}}">
          <text class="text-secondary">暂无标签</text>
        </block>
        <block wx:else>
          <view class="label-list-inline">
            <text class="label-pill" wx:for="{{depInfo.selectedLabels}}" wx:key="nxDistributerLabelId">{{item.nxDlName}}</text>
          </view>
        </block>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
  </view>

  <!-- 配送设置 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-delivery">配</view>
      <text class="section-title">配送设置</text>
    </view>
    <view class="section-row" bindtap="showLocationTimeModal">
      <text class="row-label">配送位置</text>
      <view class="row-value">
        <text class="{{depInfo.nxDepartmentLat || depInfo.nxDepartmentAddress || formattedEarliestTime ? 'text-success' : 'text-danger'}}">
          {{depInfo.nxDepartmentLat ? '已设置位置' : '未设置位置'}}、{{depInfo.nxDepartmentAddress ? '已设置地址' : '未设置地址'}}、{{formattedEarliestTime && formattedLatestTime ? '已设置时间' : '未设置时间'}}
        </text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row">
      <text class="row-label">配送时间信息</text>
      <text class="row-value">{{(formattedEarliestTime && formattedLatestTime) ? formattedEarliestTime + ' - ' + formattedLatestTime : '-'}}</text>
    </view>
    <view class="section-row">
      <text class="row-label">卸货时间</text>
      <text class="row-value">{{depInfo.nxDepartmentUnloadDuration ? depInfo.nxDepartmentUnloadDuration + '分钟' : '未设置'}}</text>
    </view>
    
  </view>

  <!-- 配送详情 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-address">门</view>
      <text class="section-title">门店修改</text>
    </view>
    
    <view class="section-row" bindtap="trunasferDep">
      <text class="row-label">转部门</text>
      <image class="icon" src="/images/exchange.png" mode="aspectFill"></image>
    </view>
    <view class="section-row">
      <text class="row-label">部门</text>
      <view class="row-value" bindtap="showSubDeps">
        <block wx:if="{{depInfo.nxDepartmentEntities && depInfo.nxDepartmentEntities.length > 0}}">
          <text class="text-wrap" wx:for="{{depInfo.nxDepartmentEntities}}" wx:key="nxDepartmentId">{{item.nxDepartmentName}}</text>
        </block>
        <block wx:else>
          <text class="text-secondary">未设置</text>
          <view class="add-btn">+</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 订货与商品 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-goods">订</view>
      <text class="section-title">订货与商品</text>
    </view>
    <view class="section-row" bindtap="toDepGoods">
      <text class="row-label">订货商品</text>
      <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
    </view>
    <view class="section-row" bindtap="toCustomerUser" wx:if="{{disInfo.nxDistributerAppId !== '-1'}}">
      <text class="row-label">小程序用户</text>
      <view class="row-value">
        <text class="text-secondary">未绑定</text>
        <image class="icon" src="/images/arrow-right-3.png" mode="aspectFill"></image>
      </view>
    </view>
    <view class="section-row" wx:if="{{disInfo.nxDistributerAppId !== '-1'}}">
      <text class="row-label">订货单</text>
      <view class="row-value radio-group">
        <view class="radio-item">
          <image class="radio-icon" src="{{depInfo.nxDepartmentAppId == 'wx159c5a46d80e4500' ? '/images/selected-2.png' : '/images/radiobuttonunselect-2.png'}}" mode="aspectFill"></image>
          <text>通用App</text>
        </view>
        <view class="radio-item">
          <image class="radio-icon" src="{{depInfo.nxDepartmentAppId !== 'wx159c5a46d80e4500' ? '/images/selected-2.png' : '/images/radiobuttonunselect-2.png'}}" mode="aspectFill"></image>
          <text>定制App</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 其他信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon icon-other">其</view>
      <text class="section-title">其他信息</text>
    </view>
    <view class="section-row">
      <text class="row-label">配送单备注</text>
      <text class="row-value text-success">点击添加</text>
    </view>
    <view class="section-row">
      <text class="row-label">客户备注</text>
      <text class="row-value text-success">点击添加</text>
    </view>
    <view class="section-row">
      <text class="row-label">创建时间</text>
      <text class="row-value">{{depInfo.nxDepartmentCreateTime || '2025-06-01 12:30'}}</text>
    </view>
  </view>

  <!-- 删除客户 -->
  <view class="delete-section" bindtap="deleteDep">
    <text class="text-danger">删除客户</text>
  </view>

</view>

<!--  操作  -->
<view class='overlay {{showOperation ? "show" : ""}}' catchtouchmove='ture' catchtap="{{!deleteShow && !editArrShow ? 'hideMask' : ''}}">

  <view class="edit-popup bg-white p-20" wx:if="{{editArrShow}}">
    <view class="flex-column">
      <view class="flex-row p-10" style="margin-top: 30rpx;">
        <text class="flex-fixed text-secondary">客户名称:</text>
        <input class="nickInput"  value="{{editDepName}}" bindinput="getDepName"></input>
      </view>
      <view class="flex-row p-10">
        <text  class="flex-fixed text-secondary" >简称(标签打印):</text>
        <input class="nickInput"  value="{{editDepAttrName}}" bindinput="getDepAttrName"></input>
      </view>
      <view class="flex-row p-10">
        <text  class="flex-fixed text-secondary" >代号名称(对外订货):</text>
        <input class="nickInput"  value="{{editDepOrderCode}}" bindinput="getDepOrderCode"></input>
      </view>
     

      <view class="flex-row-default p-10">
        <text class="flex-fixed text-secondary">支付方式:</text>
        <radio-group class="radio-group flex-row"  bindchange="radioChange">
          <label class="radio flex-row " style="margin-right: 20rpx;">
            <radio value="0" checked="{{depInfo.nxDepartmentSettleType == 0 ? 'true' :''}}" />
            <text class="">现金</text>
          </label>

          <label class="radio flex-row border-bottom ">
            <radio value="1" checked="{{depInfo.nxDepartmentSettleType == 1 ? 'true' :''}}" />
            <text class="">记账</text>
          </label>
        </radio-group>

      </view>
      <view class="flex-row-default p-20">
        <text class="flex-fixed text-secondary" >定价方式:</text>
        <radio-group class="radio-group flex-row"  bindchange="radioChangeFixed">
          <label class="radio flex-row " style="margin-right: 20rpx;">
            <radio value="0" checked="{{depInfo.nxDepartmentType == 'unFixed' ? 'true' :''}}" />
            <text class="">不定</text>
          </label>

          <label class="radio flex-row border-bottom ">
            <radio value="1" checked="{{depInfo.nxDepartmentType == 'fixed' ? 'true' :''}}" />
            <text class="">固定</text>
          </label>
        </radio-group>

      </view>
      <view class="flex-row-default p-10">
        <text class="flex-fixed text-secondary p-10">打印格式:</text>
        <radio-group class="radio-group flex-column" bindchange="radioChangePrint">
          <label class="radio flex-row p-10">
            <radio value="0" checked="{{depInfo.nxDepartmentPrintName == 'ApplyPanel' ? 'true' :''}}" />
            <text class="">一张一列</text>
          </label>

          <label class="radio flex-row p-10">
            <radio value="1" checked="{{depInfo.nxDepartmentPrintName == 'ApplyFiftyPanel' ? 'true' :''}}" />
            <text class="">一张两列</text>
          </label>
          <label class="radio flex-row  p-10">
            <radio value="2" checked="{{depInfo.nxDepartmentPrintName == 'ApplyHalfWholePanel' ? 'true' :''}}" />
            <text class="">半张一列</text>
          </label>

          <label class="radio flex-row  p-10">
            <radio value="3" checked="{{depInfo.nxDepartmentPrintName == 'ApplyHalfPanel' ? 'true' :''}}" />
            <text class="">半张两列</text>
          </label>
          <label class="radio flex-row p-10">
            <radio value="7" checked="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyWholePanel' ? 'true' :''}}" />
            <text class="">三分之一张一列</text>
          </label>
          <label class="radio flex-row  p-10">
            <radio value="6" checked="{{depInfo.nxDepartmentPrintName == 'ApplyThirtyPanel' ? 'true' :''}}" />
            <text class="">三分之一张两列</text>
          </label>

          <label class="radio flex-row  p-10" >
            <radio value="4" checked="{{depInfo.nxDepartmentPrintName == 'BlueToothPrint' ? 'true' :''}}" />
            <text class="">蓝牙打印机</text>
          </label>
          <label class="radio flex-row  p-10">
            <radio value="5" checked="{{depInfo.nxDepartmentPrintName == 'feiEPrint' ? 'true' :''}}" />
            <text class="">飞鹅打印机</text>
          </label>
        </radio-group>

      </view>
    </view>

    <!-- <view class="flex-row p-20 border-bottom">
      <text class="mr-10 text-secondary">订货单:</text>
      <view class="flex-row">
        <checkbox-group bindchange="changeAppId">
          <label class="">
            <checkbox checked="{{depInfo.nxDepartmentAppId == 'wx159c5a46d80e4500'}}" />
            通用App
          </label>
          <label class="">
            <checkbox checked="{{depInfo.nxDepartmentAppId !== 'wx159c5a46d80e4500'}}" />
            定制App
          </label>
        </checkbox-group>
      </view>
    </view> -->

    <view class="flex-row-between" style="padding: 30rpx 40rpx;">
      <view class="p-10 third-row center-content hover" bindtap="closeEditGroupInfo">取消</view>
      <view class="p-10 third-row center-content bg-success" bindtap="updateDepInfo">
        确定
      </view>
    </view>

  </view>
</view>

<!-- 地理位置和配送时间设置弹窗 -->
<view class='overlay {{showLocationTimeModal ? "show" : ""}}' catchtouchmove="stopPropagation" catchtap="hideLocationTimeModal">
  <view class="edit-popup bg-white p-20" catchtap="stopPropagation">
    <view class="flex-column">
      <view class="font-lg-2 center-content p-20 border-bottom">配送设置</view>
      
      <!-- 设置提示 -->
      <view class="flex-row p-10" style="background-color: #f0f8ff; border-radius: 8rpx; margin: 10rpx 0;">
        <text class="text-secondary" style="font-size: 24rpx;">配送位置必填，配送时间可按需设置</text>
      </view>
      
      <!-- 当前设置状态 -->
      <view class="flex-row p-10" style="background-color: #f8f9fa; border-radius: 8rpx; margin: 10rpx 0;" wx:if="{{formattedEarliestTime || formattedLatestTime}}">
        <text class="text-secondary" style="font-size: 24rpx;">当前设置: {{formattedEarliestTime}} - {{formattedLatestTime}}</text>
      </view>
      
      <!-- 地理位置设置 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">地理位置:</text>
        <view class="flex-column" style="flex: 1;">
          <view class="flex-row-between p-10">
            <text class="delivery-status {{selectedLatitude ? 'set' : 'unset'}}">纬度: {{selectedLatitude || '未设置'}}</text>
            <text class="delivery-status {{selectedLongitude ? 'set' : 'unset'}}">经度: {{selectedLongitude || '未设置'}}</text>
          </view>
          <view class="flex-row p-10">
            <button class="btn-primary" bindtap="chooseLocation" style="width: 200rpx; height: 60rpx; font-size: 24rpx;">选择位置</button>
          </view>
        </view>
      </view>

      <!-- 详细地址 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">详细地址:</text>
        <view class="flex-column" style="flex: 1;">
          <textarea class="delivery-address" placeholder="请输入详细地址（可选）" value="{{deliveryAddress}}" bindinput="onDeliveryAddressInput" style="width: 100%; height: 80rpx; font-size: 24rpx;"></textarea>
          <view class="flex-row p-5">
            <text class="delivery-status {{deliveryAddress ? 'set' : 'unset'}}" style="font-size: 20rpx;">{{deliveryAddress ? '已设置地址' : '未设置地址'}}</text>
          </view>
        </view>
      </view>

      <!-- 配送时间设置 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">最早配送时间:</text>
        <picker mode="time" value="{{earliestDeliveryTime}}" bindchange="onEarliestTimeChange">
          <view class="picker-item {{earliestDeliveryTime ? 'selected' : ''}}">
            {{earliestDeliveryTime || '请选择时间'}}
          </view>
        </picker>
      </view>

      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">最晚配送时间:</text>
        <picker mode="time" value="{{latestDeliveryTime}}" bindchange="onLatestTimeChange">
          <view class="picker-item {{latestDeliveryTime ? 'selected' : ''}}">
            {{latestDeliveryTime || '请选择时间'}}
          </view>
        </picker>
      </view>

      <!-- 卸货时间 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">卸货时间:</text>
        <input class="input" type="number" maxlength="4" placeholder="请输入卸货时间（分钟）" value="{{unloadDuration}}" bindinput="onUnloadDurationInput" style="width: 200rpx; text-align: right;" />
        <text class="ml-10 text-secondary">分钟</text>
      </view>

      <!-- 配送备注 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">配送备注:</text>
        <textarea class="delivery-notes" maxlength="256" placeholder="请输入配送备注信息（可选）" value="{{deliveryNotes}}" bindinput="onDeliveryNotesInput" style="width: 100%; height: 100rpx;"></textarea>
      </view>

      <!-- 配送优先级 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">配送优先级:</text>
        <picker mode="selector" range="{{priorityOptions}}" value="{{priorityIndex}}" bindchange="onPriorityChange">
          <view class="picker-item">
            {{priorityOptions[priorityIndex]}}
          </view>
        </picker>
      </view>

      <!-- 是否允许提前配送 -->
      <view class="flex-row p-20 border-bottom">
        <text class="mr-10 text-secondary" style="width: 200rpx;">允许提前配送:</text>
        <switch checked="{{allowEarlyDelivery}}" bindchange="onEarlyDeliveryChange" color="#07c160"/>
      </view>
    </view>

    <view class="flex-row-between" style="padding: 30rpx 40rpx;">
      <view class="p-10 third-row center-content hover" bindtap="hideLocationTimeModal">取消</view>
      <view class="p-10 third-row center-content {{canSave && !savingDeliverySettings ? 'bg-success' : 'bg-gray'}}" bindtap="updateLocationTimeInfo">
        {{savingDeliverySettings ? '保存中...' : (canSave ? '保存设置' : '请完善设置')}}
      </view>
    </view>
  </view>
</view>









<!-- mask -->
<view class='overlay {{showOperationPrice ? "show" : ""}}'>

  <!-- + edit -->
  <view class="popup">
    <view class="p-20  flex-column">
      <view class="flex-row big p-20">
        <text class="mr-10">{{disGoods.nxDgGoodsName}}</text>
        <text wx:if="{{disGoods.nxDgGoodsDetail != null && disGoods.nxDgGoodsDetail.length > 0}}"> {{disGoods.nxDgGoodsDetail}}</text>
      </view>

      <view class="flex-row p-20 font-lg">
        <view class="mr-20shrink_fix">配送单价:</view>
        <input type="digit" class="input shrink_change" bindinput="inputSellingPrice" value="{{sellingPrice}}" />元{{disGoods.nxDsStandardName}}
      </view>
    </view>

    <view class="flex-row-between p-30">
      <view class="p-20 bg-light" catchtap="hideMask">
        <text class="bg-light"> 取消</text>
      </view>
      <view class="p-20 bg-success" catchtap="_updateDepGoods">
        <text class="">保存</text>
      </view>
    </view>

  </view>


</view>


<!-- 采购员链接打开页面之前判断是否有子部门 -->
<view class='overlay {{showChoice ? "show" : ""}}' catchtap="hideChoiceMask">
  <view class='popup' style="width:{{windowWidth/3 * 2}}rpx; ">
    <!-- 分店列表 -->
    <view class="flex-column p-20 p-20 bg-white">
      <view class="flex flex-row border-bottom p-20 {{depInfo.nxDepartmentEntities.length -1 == index ? 'is-last' : ''}} flex-row-default" wx:for="{{depInfo.nxDepartmentEntities}}" wx:key="nxDepartmentId" wx:for-item="dep" bindtap="selectDepartment" data-item="{{dep}}" hover-class="hover">
        <text class=''>{{dep.nxDepartmentName}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 客户标签管理弹窗 -->
<view class='overlay {{showLabelModal ? "show" : ""}}' catchtap="hideLabelModal">
  <view class='popup label-popup bg-white' catchtap="stopPropagation">
    <!-- 标题栏 -->
    <view class="flex-row-between p-20 border-bottom">
      <text class="font-lg font-bold">客户标签管理</text>
      <view bindtap="hideLabelModal">
        <image src="/images/close-2.png" mode="aspectFill" class="icon-sm" />
      </view>
    </view>
    
    <!-- 标签内容区域 -->
    <view class="label-content">
      <!-- 全部标签（配送商标签） -->
      <view class="label-section">
        <view class="flex-row-between p-20 border-bottom" style="background: #f5f5f5;">
          <text class="text-secondary font-sm">全部标签（配送商标签）</text>
          <view class="flex-row">
            <input class="new-label-input" placeholder="新标签名称" value="{{newLabelName}}" bindinput="getNewLabelName" />
            <view class="btn-add-label" bindtap="addNewLabel">+</view>
          </view>
        </view>
        
        <!-- 标签列表 -->
        <scroll-view scroll-y class="label-list">
          <view class="p-20 border-bottom" wx:for="{{labelList}}" wx:key="nxDistributerLabelId">
            <view class="flex-row-between">
              <view class="flex-row" bindtap="toggleLabel" data-id="{{item.nxDistributerLabelId}}">
                <image src="{{item.selected ? '/images/selected-2.png' : '/images/radiobuttonunselect-2.png'}}" mode="aspectFill" class="icon-sm mr-10" />
                <text>{{item.nxDlName}}</text>
              </view>
              <view class="btn-delete-label" bindtap="deleteDistributerLabel" data-id="{{item.nxDistributerLabelId}}" data-label="{{item}}">
                <text class="text-danger font-sm">删除</text>
              </view>
            </view>
          </view>
          
          <!-- 无标签提示 -->
          <view class="p-40 center-content" wx:if="{{labelList.length === 0}}">
            <text class="text-secondary">暂无标签，请添加</text>
          </view>
        </scroll-view>
      </view>
      
      <!-- 已选标签（当前客户的标签） -->
      <view class="selected-section">
        <view class="p-20 border-bottom" style="background: #f5f5f5;">
          <text class="text-secondary font-sm">已选标签（当前客户） ({{selectedLabels.length}})</text>
        </view>
        
        <scroll-view scroll-y class="selected-list">
          <view class="p-20 border-bottom" wx:for="{{selectedLabels}}" wx:key="nxDistributerLabelId">
            <view class="flex-row-between">
              <text>{{item.nxDlName}}</text>
              <view class="btn-remove-label" bindtap="removeSelectedLabel" data-id="{{item.nxDistributerLabelId}}">
                <text class="text-danger font-sm">移除</text>
              </view>
            </view>
          </view>
          
          <!-- 无已选标签提示 -->
          <view class="p-40 center-content" wx:if="{{selectedLabels.length === 0}}">
            <text class="text-secondary">点击上方标签添加</text>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- 底部按钮 -->
    <view class="flex-row p-20 border-top">
      <view class="flex-1 p-20 center-content bg-light mr-10" bindtap="hideLabelModal">取消</view>
      <view class="flex-1 p-20 center-content bg-success" bindtap="saveCustomerLabels">保存</view>
    </view>
  </view>
</view>
