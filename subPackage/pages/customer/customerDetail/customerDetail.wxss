.icon-staff { background: #2f54eb; }
.icon-status { background: #fa8c16; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 行 */
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
