}

.radio-item {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.radio-item:first-child {
  margin-left: 0;
}

.radio-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.text-wrap {
  word-break: break-all;
}

/* 删除区域 */
.delete-section {
  display: flex;
