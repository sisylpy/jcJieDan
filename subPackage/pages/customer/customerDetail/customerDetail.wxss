@import "/template/resGoods/resGoods.wxss";
@import "/template/resGroup/resGroup.wxss";

/* 配送设置弹窗样式 */
.picker-item {
  padding: 10rpx 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  min-width: 200rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.picker-item.selected {
  border-color: #07c160;
  background-color: #f0f9ff;
  color: #07c160;
}

.delivery-notes {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 10rpx;
  background-color: #f9f9f9;
  font-size: 28rpx;
}

.btn-primary {
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.btn-primary:active {
  background-color: #06ad56;
}

.bg-gray {
  background-color: #cccccc !important;
  color: #666666 !important;
}

/* 配送设置项样式 */
.delivery-setting-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.delivery-setting-label {
  width: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.delivery-setting-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.delivery-status {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.delivery-status.set {
  color: #07c160;
}

.delivery-status.unset {
  color: #ff6b6b;
}
/* 标签管理样式 */
.label-popup {
  width: 90%;
  max-height: 85vh;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
}

.label-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.label-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid #eee;
  min-height: 200rpx;
}

.selected-section {
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
}

.label-list,
.selected-list {
  flex: 1;
  max-height: 45vh;
}

.new-label-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  width: 200rpx;
  background: #f8f8f8;
}

.btn-add-label {
  background: #07c160;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-size: 28rpx;
}

.btn-delete-label,
.btn-remove-label {
  padding: 4rpx 12rpx;
  border: 1rpx solid #ff6b6b;
  border-radius: 6rpx;
}

.label-tag-small {
  background: #e8f5e9;
  color: #07c160;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.icon-sm {
  width: 36rpx;
  height: 36rpx;
}

.text-danger {
  color: #ff6b6b;
}

.font-sm {
  font-size: 24rpx;
}

.border-top {
  border-top: 1rpx solid #eee;
}

/* 客户业态 */
.business-type-value {
  color: #07c160;
  font-weight: 500;
}

.business-type-inherited {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  background: #f0f5ff;
  color: #597ef7;
  font-size: 20rpx;
}

/* ===================== 客户详情页新卡片式样式 ===================== */

/* 页面容器 */
.page-container {
  min-height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 头部客户卡片 */
.customer-header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.header-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.header-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.header-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}
.header-code-row {
  margin-bottom: 10rpx;
}

.header-code {
  font-size: 26rpx;
  color: #999999;
}

.header-status-row {
  display: flex;
  align-items: center;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-success {
  background: #e6f7f0;
  color: #07c160;
}

/* 分组卡片 */
.section-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  margin-right: 16rpx;
  font-weight: 500;
}

.icon-basic { background: #07c160; }
.icon-trade { background: #faad14; }
.icon-label { background: #1890ff; }
.icon-delivery { background: #722ed1; }
.icon-address { background: #eb2f96; }
.icon-goods { background: #13c2c2; }
.icon-other { background: #8c8c8c; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 行 */
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 48rpx;
}

.section-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  min-width: 0;
}

.row-value .icon {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.label-list-inline {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.label-pill {
  background: #e6f7f0;
  color: #07c160;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
}

.add-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #dddddd;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 28rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.radio-group {
  display: flex;
  align-items: center;
}

.radio-item {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.radio-item:first-child {
  margin-left: 0;
}

.radio-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.text-wrap {
  word-break: break-all;
}

/* 删除区域 */
.delete-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.delete-section text {
  font-size: 30rpx;
}
