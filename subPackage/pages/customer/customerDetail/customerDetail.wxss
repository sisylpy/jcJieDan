}

.section-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  min-width: 0;
}

.row-value .icon {
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 负责员工 */
.picker-value {
  display: flex;
  align-items: center;
  min-width: 0;
}

.picker-value .icon {
  margin-left: 12rpx;
  flex-shrink: 0;
}

