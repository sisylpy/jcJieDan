  font-size: 22rpx;
}

.modal-close {
  width: 50rpx;
  height: 50rpx;
  color: #7f8b84;
  font-size: 42rpx;
  line-height: 46rpx;
  text-align: center;
}

.profile-form-scroll {
  height: 760rpx;
  max-height: 62vh;
  padding: 8rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.form-group {
  padding-top: 22rpx;
}

.form-label {
  display: block;
  color: #394941;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  color: #213229;
  font-size: 28rpx;
  border: 1rpx solid #dce7e1;
  border-radius: 12rpx;
  background: #f8fbf9;
  box-sizing: border-box;
}

.print-options {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.choice-option {
  min-height: 70rpx;
  padding: 10rpx 12rpx;
  display: flex;
  align-items: center;
  color: #35453d;
  font-size: 24rpx;
  border: 1rpx solid #e2eae6;
  border-radius: 12rpx;
  background: #fafcfb;
  box-sizing: border-box;
}

.choice-option radio,
.choice-card radio {
  transform: scale(0.82);
}

.modal-actions {
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  border-top: 1rpx solid #edf2ef;
  background: #fff;
}

.modal-button {
  height: 76rpx;
  flex: 1;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
}

.modal-button::after {
  border: 0;
}

.modal-button.secondary {
  color: #68766e;
  background: #f1f4f2;
}

.modal-button.primary {
  color: #fff;
  background: #0a8055;
}

.trade-form {
  padding: 8rpx 28rpx 30rpx;
}

.choice-group {
  padding-top: 24rpx;
}

.choice-row {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.choice-card {
  min-height: 106rpx;
  padding: 16rpx 12rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #dfe9e4;
  border-radius: 14rpx;
  background: #f9fcfa;
  box-sizing: border-box;
}

.choice-card view {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.choice-card view text:first-child {
  color: #293a31;
  font-size: 27rpx;
  font-weight: 600;
}

.choice-card view text:last-child {
  margin-top: 4rpx;
  color: #8a968f;
  font-size: 20rpx;
}

.delivery-popup {
  max-height: 88vh;
  padding: 20rpx;
  overflow-y: auto;
}

.delivery-modal-header {
  margin: -20rpx -20rpx 4rpx;
}
