<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="flex-column height-100">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="客户" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <view class=" bg-white flex-row-reverse plr-20  border-bottom-text-secondary" style="height:100rpx; width: {{windowWidth - 40}}rpx; margin-top: {{navBarHeight}}rpx; ">

    <view class="newBtnBack flex-column-center" bindtap="addNewCustomer">
      <image src="../../../../images/add.png" class="icon"></image>
    </view>
  </view>
  <!-- bb -->
  <view class="flex-column ">
    <!-- <block wx:if="{{showInvite}}">
      <view class="flex-column p-20">
        <view class="flex-row-reverse p-10" bind:tap="closeTishi">
          <image src="/images/del.png" mode="aspectFill" class="icon" />
        </view>
        <view class="flex-row-default" style="width: {{windowWidth - 40}}rpx;">
          <image src="/images/jjcg.png" mode="aspectFill" class="logoimg mr-30 " />
