
.depments{
  margin-left: 10rpx;
  margin-right: 10rpx;
  padding-bottom: 200rpx;
}
.selcet_content{
  display: flex;
  flex-flow: row nowrap;
}

.dep_content{
  display: flex;
  flex-flow: row nowrap;
  display: none;
}
.dep_content.is-active{
  display: block;
}

.trigle{
  width: 50rpx;
  height: 30rpx;
  margin-left: -50rpx;
  /* margin-bottom: 0; */
  
}
.nabla {
  width: 0px;
  height: 0px;
  border-top: 10px solid black;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  z-index: 9999;
}

.numInput{
  border: 1px solid lightgray;
  border-radius: 10rpx;
  background-color: #fff;
  font-size: 38rpx;
}
.numInput.is-active{
  border: 1px solid #147062;
  color: #147062;
 
}

.result {
  background: #fff;
  border: 1px solid lightgray;
  position: absolute;
  height: 454rpx;
  z-index: 999;
  display: none;

}

.result.is-active {
  display: block;
  background-color: #e5f8f6;
}

.result-row {
  /* width: 100%; */
  line-height: 70rpx; 
  padding: 10rpx 10rpx;
  border-bottom: 1px solid lightgray;
}


input {
  border: 1px solid #eee;
  height: 100rpx;
  border-radius: 10rpx;
  float: left;
  padding: 0 10rpx;
}

.inputBehind {
  float: left;
  height: 100rpx;
  margin-top: 10px;
  margin-left: 4rpx;
}
