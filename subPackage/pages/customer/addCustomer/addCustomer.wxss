/* 让页面随内容增高，超出一屏时可以正常向上滚动，避免底部固定按钮遮挡输入框 */
page {
  height: auto;
  min-height: 100%;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 名称输入区域 */
.name-field {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.name-field:last-of-type {
  border-bottom: none;
}

.name-label {
  display: block;
  flex: 0 0 180rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  padding-right: 20rpx;
}

.name-input {
  flex: 1 1 auto;
  width: auto;
  float: none;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  border: 1px solid #e5e5e5;
  border-radius: 12rpx;
  background: #ffffff;
  margin-bottom: 0;
}

.name-input:focus {
  background: #fff;
  border-color: #147062;
}

.name-hint {
  flex-basis: 100%;
  margin-left: 200rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.depments{
  margin-left: 10rpx;
  margin-right: 10rpx;
  padding: 20rpx;
  padding-bottom: 40rpx;
  background-color: #f6fdfd;
  border-radius: 12rpx;
  /* 包含浮动的部门输入框，避免背景高度塌陷 */
  overflow: hidden;
}
.selcet_content{
  display: flex;
  flex-flow: row nowrap;
}

.dep_content{
  display: flex;
  flex-flow: row nowrap;
  display: none;
}
.dep_content.is-active{
  display: block;
}

.trigle{
  width: 50rpx;
  height: 30rpx;
  margin-left: -50rpx;
  /* margin-bottom: 0; */
  
}
.nabla {
  width: 0px;
  height: 0px;
  border-top: 10px solid black;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  z-index: 9999;
}

.numInput{
  border: 1px solid lightgray;
  border-radius: 10rpx;
  background-color: #fff;
  font-size: 38rpx;
  /* 摒弃全局 input 的 float:left，避免父容器高度塌陷、背景包不住输入框 */
  display: block;
  float: none;
}
.numInput.is-active{
  border: 1px solid #147062;
  color: #147062;
 
}

.result {
  background: #fff;
  border: 1px solid lightgray;
  position: absolute;
  height: 454rpx;
  z-index: 999;
  display: none;

}

.result.is-active {
  display: block;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.result-row {
  /* width: 100%; */
  line-height: 70rpx; 
  padding: 10rpx 10rpx;
  border-bottom: 1px solid lightgray;
}


input {
  border: 1px solid #eee;
  height: 100rpx;
  border-radius: 10rpx;
  float: left;
  padding: 0 10rpx;
}

.inputBehind {
  float: left;
  height: 100rpx;
  margin-top: 10px;
  margin-left: 4rpx;
}

/* 保存按钮尽量宽 */
.bottom_view .big_button {
  width: 92%;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
