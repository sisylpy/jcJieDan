<view class='flex-column '>

  <back-navbar style="height: {{navBarHeight}}rpx;" title="添加客户" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class='flex-column p-20 bg-white' style='margin-top: {{navBarHeight}}rpx;' >
    <view class='flex-row p-20'>
      <text class="sub-title mr-10 text-secondary">客户名称:</text>
      <input class="font-lg" focus="true" bindblur="bindKeyInput" style="width:{{windowWidth /2}}rpx;" placeholder="" style="width:{{windowWidth /2}}rpx;" />
    </view>

    <view class="flex-row p-20 font-lg">
      <view class='mr-10 text-secondary'>付款方式:</view>
      <radio-group class="p-20 flex-row " bindchange="radioChangeType">
        <label class="radio mr-20">
          <view class="flex-row with-tb-padding">
            <radio value="1" checked="true" />
            <text class=''>记账</text>
          </view>
        </label>
        <label class="radio ">
          <view class="flex-row with-tb-padding ">
            <radio value="0" />
            <text class=''>现金</text>
          </view>
        </label>

      </radio-group>
    </view>

    <view class="flex-row font-lg p-20">
      <text class="mr-10 text-secondary">订货部门:</text>
      <view class="flex-column">
        <view class="flex-row">
          <radio-group class="plr-20  flex-row" bindchange="radioChange">
            <label class="radio mr-20">
              <view class="flex-row with-tb-padding">
                <radio value="0" checked="true" />
                <text class=''>不分部门</text>
              </view>
            </label>

            <label class="radio">
              <view class="flex-row with-tb-padding">
                <radio value="2" />
                <text class=''>分部门</text>
              </view>
            </label>
          </radio-group>
        </view>


      </view>

    </view>

    <view class='type p-20 font-lg' wx:if="{{hasSubs == 2}}">
   
      <view class="selcet_content">
        <text class="text-secondary" style="margin-right:10rpx; margin-top:0rpx;">一共有</text>
        <view class="flex-row" style="margin-right:20rpx;" catchtap="showNumber">
          <view class="flex-column">
            <input class="numInput" style="width:{{windowWidth / 3}}rpx; font-size: 40rpx;  height: 90rpx; line-height: 90rpx; padding-left: 20rpx;" disabled="true" value="{{selNumber}}"></input>
            <scroll-view scroll-y class="result {{showNumber ? 'is-active' : ''}}" style="width: {{windowWidth/3 + 30}}rpx; margin-top: 92rpx;">
              <view style="width:{{windowWidth/3}}rpx; " class="flex-column result-row" wx:for="23456789" wx:for-item="item" wx:key="index" wx:for-index="index" catchtap="selIndex" data-index="{{index}}" hover-class="hover">
                {{item}}
              </view>
            </scroll-view>

          </view>
          <view class="nabla trigle" catchtap="showNumber"></view>
        </view>
        <text style="margin-top:20rpx;">个部门</text>
      </view>
    </view>

    <view class='depments flex-column'  wx:if="{{selNumber  > 0}}">
      <view class="pt-10 pb-10 text-secondary font-md">部门名称:</view>
      <view class="dep_content {{selNumber !== '' ? 'is-active' : ''}} flex-column">
        <input wx:for="{{nxDepartmentEntities}}"  wx:key="index" wx:for-index="inputIndex" class="numInput {{inputIndex == myInPutIndex ? 'is-active' : ''}}" style="width:{{windowWidth/2}}rpx; height: 90rpx; line-height: 90rpx;padding-left: 10rpx; margin-bottom:20rpx;" bindinput="getDepartmentName" data-index="{{inputIndex}}" value="{{item.nxDepartmentName}}" adjust-position="true" placeholder="部门名称" confirm-type='{{inputIndex == selNumber -1 ? "done" : "next"}}' hold-keyboard="true" bindconfirm='clickConfirm' focus='{{focusIndex == inputIndex ? "true" : ""}}'></input>
      </view>
    </view>
  </view>


</view>



<view class=" bottom_view" >
   <view class=" p-20 center-content big_button {{canSave ? 'is-active' : ''}}"  bind:tap="{{canSave ? 'toSave' : ''}}">保存</view>
 </view>