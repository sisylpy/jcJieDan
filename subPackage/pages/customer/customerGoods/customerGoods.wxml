<view class="page">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="{{editDepAttrName}}商品"
    avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"
  ></back-navbar>

  <view class="toolbar" style="margin-top: {{navBarHeight}}rpx;">
    <view class="search-box">
      <image class="search-icon" src="/images/search-3.png" mode="aspectFit"></image>
      <input
        class="search-input"
        value="{{searchKeyword}}"
        placeholder="搜索商品名称、规格"
        confirm-type="search"
        bindinput="onSearchInput"
      ></input>
      <text wx:if="{{searchKeyword}}" class="clear" bindtap="clearSearch">×</text>
    </view>
  </view>

  <view wx:if="{{!loading}}" class="content">
    <view class="view-toolbar">
      <view class="view-switch">
        <view class="view-option {{viewMode === 'frequency' ? 'active' : ''}}" bindtap="setViewMode" data-mode="frequency">订货频率</view>
        <view class="view-option {{viewMode === 'amount' ? 'active' : ''}}" bindtap="setViewMode" data-mode="amount">订货金额</view>
      </view>
      <picker
        wx:if="{{viewMode === 'amount'}}"
        mode="selector"
        range="{{amountWindows}}"
        range-key="label"
        value="{{amountWindowIndex}}"
        bindchange="onAmountWindowChange"
      >
        <view class="amount-window">{{amountWindowLabel}}⌄</view>
      </picker>
    </view>

    <view wx:if="{{viewMode === 'frequency'}}" class="summary">
      <view class="summary-item">
        <text class="summary-label">部门商品</text>
        <view class="summary-value">{{stats.total}}<text>个</text></view>
      </view>
      <view class="summary-item">
        <text class="summary-label">有要求</text>
        <view class="summary-value emphasis">{{stats.requirement}}<text>个</text></view>
      </view>
      <view class="summary-item">
        <text class="summary-label">周期稳定</text>
        <view class="summary-value">{{stats.stable}}<text>个</text></view>
      </view>
      <view class="summary-item">
        <text class="summary-label">近7天订货</text>
        <view class="summary-value">{{stats.recent}}<text>个</text></view>
      </view>
    </view>

    <view wx:else class="summary amount-summary">
      <view class="summary-item">
        <text class="summary-label">统计范围</text>
        <view class="summary-value compact">{{amountWindowLabel}}</view>
      </view>
      <view class="summary-item">
        <text class="summary-label">订货总额</text>
        <view class="summary-value money">{{amountStats.totalAmountText}}</view>
      </view>
      <view class="summary-item">
        <text class="summary-label">核心商品</text>
        <view class="summary-value">{{amountStats.core}}<text>个</text></view>
      </view>
      <view class="summary-item">
        <text class="summary-label">有金额</text>
        <view class="summary-value">{{amountStats.withAmount}}<text>个</text></view>
      </view>
    </view>

    <view
      wx:if="{{anomalyAvailable}}"
      class="anomaly-card {{anomalySummary.totalCount > 0 ? 'has-anomaly' : 'is-normal'}}"
      bindtap="toOrderAnomalies"
    >
      <view class="anomaly-card-head">
        <view>
          <view class="anomaly-title-row">
            <text class="anomaly-title">订货异常</text>
            <text wx:if="{{anomalySummary.totalCount > 0}}" class="anomaly-total">{{anomalySummary.totalCount}}</text>
          </view>
          <text class="anomaly-subtitle">
            {{anomalySummary.totalCount > 0 ? '根据该客户各部门商品自身历史识别' : '暂未发现明显订货偏离'}}
          </text>
        </view>
        <text class="anomaly-link">查看分析 ›</text>
      </view>
      <view class="anomaly-types">
        <view class="anomaly-type stop">
          <text class="anomaly-type-count">{{anomalySummary.suspectedStopCount}}</text>
          <text class="anomaly-type-label">疑似停订</text>
        </view>
        <view class="anomaly-type decline">
          <text class="anomaly-type-count">{{anomalySummary.declineCount}}</text>
          <text class="anomaly-type-label">订货下降</text>
        </view>
        <view class="anomaly-type surge">
          <text class="anomaly-type-count">{{anomalySummary.surgeCount}}</text>
          <text class="anomaly-type-label">订货激增</text>
        </view>
      </view>
      <text class="anomaly-disclaimer">异常只代表订货行为变化，具体原因需要人工核实</text>
    </view>

    <view wx:if="{{groupedGoods.length}}" class="sort-line">
      <text>{{viewMode === 'amount' ? '按订货金额' : '按订货频次'}}</text>
      <text class="sort-desc">{{viewMode === 'amount' ? amountWindowLabel + ' · 金额从高到低' : '频次从高到低'}}</text>
    </view>

    <block wx:for="{{groupedGoods}}" wx:key="key" wx:for-item="group">
      <view class="goods-group group-{{group.tone}}">
        <view class="group-title" bindtap="toggleGroup" data-key="{{group.key}}">
          <view class="group-name-wrap">
            <view class="group-line"></view>
            <text class="group-name">{{group.title}}</text>
            <text class="group-range">（{{group.range}}）</text>
          </view>
          <view class="group-title-right">
            <text class="group-count">{{group.count}}</text>
            <text class="group-arrow {{group.collapsed ? 'collapsed' : ''}}">▾</text>
          </view>
        </view>

        <view
          wx:if="{{!group.collapsed}}"
          class="goods-row"
          wx:for="{{group.items}}"
          wx:key="relationId"
          wx:for-item="item"
          bindtap="toCustomerGoodsPrice"
          data-id="{{item.relationId}}"
        >
          <view class="goods-avatar">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <text wx:else>{{item.initials}}</text>
          </view>

          <view class="goods-main">
            <text class="goods-name">{{item.goodsName}}</text>
            <view class="goods-relation-meta">
              <text class="department-tag">{{item.customerName}}</text>
              <text wx:if="{{item.spec}}" class="goods-spec">{{item.spec}}</text>
            </view>
            <view wx:if="{{item.hasRequirement || item.imageCount > 0}}" class="goods-tags">
              <text
                wx:if="{{item.hasRequirement}}"
                class="requirement-tag"
                catchtap="toCustomerGoodsStandard"
                data-id="{{item.relationId}}"
              >有要求</text>
              <view
                wx:if="{{item.imageCount > 0}}"
                class="image-tag"
                catchtap="toCustomerGoodsStandard"
                data-id="{{item.relationId}}"
              >
                <text class="image-symbol">▧</text>
                <text>{{item.imageCount}}</text>
              </view>
            </view>
            <text
              wx:if="{{item.anomalyLabel}}"
              class="goods-anomaly-tag anomaly-{{item.anomalyType}} {{item.anomalySeverity === 'HIGH' ? 'high' : ''}}"
            >{{item.anomalyLabel}}</text>
          </view>

          <view class="primary-metric {{viewMode === 'amount' ? 'amount-metric' : ''}}">
            <text class="metric-label">{{viewMode === 'amount' ? '订货金额' : '订货频率'}}</text>
            <text class="metric-value">{{viewMode === 'amount' ? item.amountText : item.intervalText}}</text>
            <text class="metric-note">{{viewMode === 'amount' ? '占总额 ' + item.amountShareText : '天/次'}}</text>
          </view>

          <view class="order-habit">
            <text class="metric-label">平均每次</text>
            <text class="habit-value">{{item.averageQuantityText}}</text>
            <text wx:if="{{viewMode === 'amount'}}" class="habit-cadence">{{item.cadenceText}}</text>
          </view>

          <view class="last-order">
            <text class="last-label">上次订货</text>
            <text class="last-value">{{item.lastOrderText}}</text>
          </view>

          <text class="row-arrow">›</text>
        </view>
      </view>
    </block>

    <view wx:if="{{!groupedGoods.length && searchKeyword}}" class="empty-state">
      <text class="empty-title">没有找到商品</text>
      <text class="empty-desc">换个名称或规格试试</text>
    </view>

    <view wx:if="{{!groupedGoods.length && !searchKeyword}}" class="empty-state">
      <text class="empty-title">暂无客户商品</text>
      <text class="empty-desc">有真实订货记录后会显示在这里</text>
    </view>
  </view>
</view>
