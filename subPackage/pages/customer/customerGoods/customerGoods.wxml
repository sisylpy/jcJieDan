<import src='../../../../template/resGoods/resGoods.wxml' />
<import src='../../../../template/resGroup/resGroup.wxml' />

<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{editDepAttrName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column flex " style="margin-top:  20rpx;">   
  
   <!-- 空状态页面 -->
   <block wx:if="{{depGoodsArr.length == 0}}">
    <view class="empty-container" style="height: {{windowHeight - navBarHeight}}rpx;">
      <view class="empty-content">
        <image class="empty-image" src="../../../images/xiuxi.png"></image>
        <text class="empty-title">暂时无订货商品</text>
        <text class="empty-desc">显示配送成功的商品</text>
      </view>
    </view>
  </block>

  <!-- 商品列表页面 -->
  <view wx:else class="goods-container"  >
    <!-- 搜索无结果提示 -->
    <view wx:if="{{searchKeyword && filteredDepGoodsArr.length === 0}}" class="empty-search">
      <view class="empty-content">
        <image class="empty-image" src="../../../images/xiuxi.png"></image>
        <text class="empty-title">未找到相关商品</text>
        <text class="empty-desc">请尝试其他关键词</text>
      </view>
    </view>

    <!-- 顶部操作栏 -->
    <view class="top-actions">
      <view class="search-container">
        <view class="search-box">
          <image src="/images/search-3.png" mode="aspectFill" class="search-icon" />
          <input 
            class="search-input" 
            type="text" 
            placeholder="搜索商品名称" 
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
            confirm-type="search"
          />
          <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">
            <image src="/images/close.png" mode="aspectFill" class="clear-icon" />
          </view>
        </view>
      </view>
    </view>

    <!-- 左右分栏布局 -->
    <view class="tree-layout" wx:if="{{!searchKeyword || filteredDepGoodsArr.length > 0}}">
      <!-- 左侧分类栏 -->
      <view class="category-sidebar">
        <scroll-view class="sidebar-scroll" scroll-y>
          <view 
            class="category-sidebar-item {{selectedCategoryId === father.nxDistributerFatherGoodsId ? 'active' : ''}}" 
            wx:for="{{filteredDepGoodsArr}}" 
            wx:for-item="father" 
            wx:for-index="fatherIndex" 
            wx:key="nxDistributerFatherGoodsId"
            bindtap="selectCategory"
            data-fatherindex="{{fatherIndex}}"
            data-id="{{father.nxDistributerFatherGoodsId}}"
          >
            <view class="category-sidebar-content">
              <text class="category-sidebar-name">{{father.nxDfgFatherGoodsName}}</text>
              <text class="category-sidebar-count" wx:if="{{father.filteredGoods && father.filteredGoods.length > 0}}">({{father.filteredGoods.length}})</text>
              <text class="category-sidebar-count" wx:elif="{{father.nxDepartmentDisGoodsEntities}}">({{father.nxDepartmentDisGoodsEntities.length}})</text>
            </view>
          </view>
          <!-- 左侧底部空白区域 -->
          <view class="sidebar-bottom-spacer"></view>
        </scroll-view>
      </view>

      <!-- 右侧商品列表 -->
      <view class="goods-content">
        <scroll-view 
          class="content-scroll" 
          scroll-y 
          scroll-into-view="{{scrollIntoView}}"
          scroll-with-animation="{{true}}"
        >
          <view 
            class="category-goods-section" 
            wx:for="{{filteredDepGoodsArr}}" 
            wx:for-item="father" 
            wx:for-index="fatherIndex" 
            wx:key="nxDistributerFatherGoodsId"
            id="category-{{father.nxDistributerFatherGoodsId}}"
          >
            <!-- 分类标题 -->
            <view class="category-section-header">
              <view class="category-title-wrapper">
                <text class="category-section-name">{{father.nxDfgFatherGoodsName}}</text>
                <text class="category-section-count" wx:if="{{father.filteredGoods && father.filteredGoods.length > 0}}">({{father.filteredGoods.length}})</text>
                <text class="category-section-count" wx:elif="{{father.nxDepartmentDisGoodsEntities}}">({{father.nxDepartmentDisGoodsEntities.length}})</text>
                <view class="category-dash-line"></view>
              </view>
            </view>
            
            <!-- 该分类下的商品列表 -->
            <view class="goods-item" wx:for="{{father.filteredGoods || father.nxDepartmentDisGoodsEntities}}" wx:for-item="depGoods" wx:key="nxDepartmentDisGoodsId">
              
              <!-- 商品基本信息 -->
              <view class="goods-header">
                <view class="goods-title">
                  <text class="goods-name">{{depGoods.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                  <text class="goods-standard">客名:</text>
                  <text class="goods-name">{{depGoods.nxDdgOrderGoodsName}}</text>
                </view>
                <view class="goods-detail" wx:if="{{depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail !== null}}">
                  {{depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail}}
                </view>
                <view class="goods-attr" wx:if="{{depInfo.nxDepartmentEntities.length > 1}}">
                  {{depGoods.nxDepartmentEntity.nxDepartmentAttrName}}
                </view>
              </view>

              <view
                class="standard-entry"
                bindtap="toCustomerGoodsStandard"
                data-id="{{depGoods.nxDepartmentDisGoodsId}}"
                data-goodsname="{{depGoods.nxDistributerGoodsEntity.nxDgGoodsName}}"
                data-customername="{{depGoods.nxDdgOrderGoodsName || depGoods.nxDdgDepGoodsName}}"
                data-departmentname="{{depGoods.nxDepartmentEntity.nxDepartmentAttrName || depGoods.nxDepartmentEntity.nxDepartmentName}}"
              >
                <view class="standard-entry-main">
                  <text class="standard-entry-title">客户商品标准</text>
                  <text class="standard-entry-desc">查看文字要求、合格与禁止图片</text>
                </view>
                <text class="standard-entry-arrow">›</text>
              </view>

              <!-- 操作按钮 -->
              <view class="goods-actions">
                <view
                  class="action-item standard-btn"
                  bindtap="toCustomerGoodsStandard"
                  data-id="{{depGoods.nxDepartmentDisGoodsId}}"
                  data-goodsname="{{depGoods.nxDistributerGoodsEntity.nxDgGoodsName}}"
                  data-customername="{{depGoods.nxDdgOrderGoodsName || depGoods.nxDdgDepGoodsName}}"
                  data-departmentname="{{depGoods.nxDepartmentEntity.nxDepartmentAttrName || depGoods.nxDepartmentEntity.nxDepartmentName}}"
                >
                  <text class="action-text">进入客户标准</text>
                </view>
                <view class="action-item delete-btn" bindtap="deleteDepGoods" data-id="{{depGoods.nxDepartmentDisGoodsId}}">
                  <image src="/images/ashbin.png" mode="aspectFill" class="action-icon" />
                  <text class="action-text">删除</text>
                </view>
              </view>

            </view>
          </view>
          <!-- 底部空白区域 -->
          <view class="bottom-spacer"></view>
        </scroll-view>
      </view>
    </view>

  </view>
  </view>
 
</view>
