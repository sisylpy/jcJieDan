<import src='../../../../template/resGoods/resGoods.wxml' />
<import src='../../../../template/resGroup/resGroup.wxml' />

<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{editDepAttrName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!-- 空状态页面 -->
  <block wx:if="{{depGoodsArr.length == 0}}">
    <view class="empty-container" style="height: {{windowHeight - navBarHeight}}rpx;">
      <view class="empty-content">
        <image class="empty-image" src="../../../images/xiuxi.png"></image>
        <text class="empty-title">暂时无订货商品</text>
        <text class="empty-desc">显示配送成功的商品</text>
      </view>
    </view>
  </block>

  <!-- 商品列表页面 -->
  <view wx:else class="goods-container">

    <!-- 顶部操作栏 -->
    <view class="top-actions">
      <view class="action-buttons">
        <!-- <view class="action-btn filter-btn" bindtap="toFilter">
          <image src="/images/search-3.png" mode="aspectFill" class="btn-icon" />
          <text class="btn-text">筛选</text>
        </view> -->
        <view class="action-btn pdf-btn" bindtap="toPdf">
          <image src="/images/loanManage.png" mode="aspectFill" class="btn-icon" />
          <text class="btn-text">导出PDF</text>
        </view>
      </view>
    </view>

    <!-- 商品分类列表 -->
    <view class="goods-categories">
             
      <view class="category-item" wx:for="{{depGoodsArr}}" wx:for-item="father" wx:for-index="fatherIndex" wx:key="nxDistributerFatherGoodsId">
        
        <!-- 分类标题栏 -->
        <view class="category-header" bindtap="openFather" data-fatherindex="{{fatherIndex}}" id="Pur{{father.nxDistributerFatherGoodsId}}" data-id="{{father.nxDistributerFatherGoodsId}}" hover-class="header-hover" >
          <view class="category-info">
            <text class="category-name">{{father.nxDfgFatherGoodsName}}</text>
            <text class="category-count" wx:if="{{father.nxDepartmentDisGoodsEntities}}">({{father.nxDepartmentDisGoodsEntities.length}})</text>
          </view>
          <view class="expand-icon">
            <image src="{{father.isSelected ? '/images/reduce.png' : '/images/add.png'}}" mode="aspectFill" class="icon" />
          </view>
        </view>

        <!-- 商品列表 -->
        <view class="goods-list {{father.isSelected ? 'expanded' : ''}}">
          <view class="goods-item" wx:for="{{father.nxDepartmentDisGoodsEntities}}" wx:for-item="depGoods" wx:key="nxDepartmentDisGoodsId">
            
            <!-- 商品基本信息 -->
            <view class="goods-header">
              <view class="goods-title">
                <text class="goods-name">{{depGoods.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                <text class="goods-standard">客名:</text>
                <text class="goods-name">{{depGoods.nxDdgOrderGoodsName}}</text>

                <!-- <text class="goods-standard">({{depGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text> -->
                <!-- <text class="goods-price" wx:if="{{depGoods.nxDistributerGoodsEntity.nxDgWillPriceTwoStandard !== null}}">{{depGoods.nxDistributerGoodsEntity.nxDgWillPriceTwoStandard}} </text> -->
              </view>
              <view class="goods-detail" wx:if="{{depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail !== null}}">
                {{depGoods.nxDistributerGoodsEntity.nxDgGoodsDetail}}
              </view>
              <view class="goods-attr" wx:if="{{depInfo.nxDepartmentEntities.length > 1}}">
                {{depGoods.nxDepartmentEntity.nxDepartmentAttrName}}
              </view>
            </view>

            <!-- 商品详细信息 -->
            <view class="goods-info">
              <!-- <view class="info-row">
                <view class="info-item">
                  <text class="info-label">商品名称:</text>
                  <text class="info-value">{{depGoods.nxDdgDepGoodsName}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">客户订货:</text>
                  <text class="info-value">{{depGoods.nxDdgOrderGoodsName}}</text>
                </view>
              </view> -->

              <view class="info-row">
                <view class="info-item">
                  <text class="info-label">订货日期:</text>
                  <text class="info-value">{{depGoods.nxDdgOrderDate}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">订货数量:</text>
                  <text class="info-value highlight">{{depGoods.nxDdgOrderQuantity}}{{depGoods.nxDdgOrderStandard}}</text>
                </view>
              </view>

              <view class="info-row">
                <view class="info-item">
                  <text class="info-label">出货要求:</text>
                  <text class="info-value">{{depGoods.nxDdgPickDetail == null ? "无" : depGoods.nxDdgPickDetail}}</text>
                </view>
                <view class="info-item">
                  <text class="info-label">配送价格:</text>
                  <text class="info-value price">¥{{depGoods.nxDdgOrderPrice}}/{{depGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                </view>
              </view>
            </view>

            <!-- 操作按钮 -->
            <view class="goods-actions">
              <view class="action-item edit-btn" bindtap="selDepartment" data-goods="{{depGoods.nxDistributerGoodsEntity}}" data-depgoods="{{depGoods}}">
                <image src="/images/edit.png" mode="aspectFill" class="action-icon" />
                <text class="action-text">编辑</text>
              </view>
              <view class="action-item delete-btn" bindtap="deleteDepGoods" data-id="{{depGoods.nxDepartmentDisGoodsId}}">
                <image src="/images/ashbin.png" mode="aspectFill" class="action-icon" />
                <text class="action-text">删除</text>
              </view>
            </view>

          </view>
        </view>

      </view>
    </view>

    <!-- 底部提示 -->
    <view class="bottom-tip">
      <text class="tip-text">没有更多数据啦！</text>
    </view>

  </view>
</view>

<!-- 编辑弹窗 -->
<view class='overlay {{showOperationPrice ? "show" : ""}}' catchtouchmove='true'>
  <view class="edit-popup">
    <view class="popup-header">
      <text class="popup-title">编辑商品信息</text>
    </view>
    
    <view class="popup-content">
      <view class="goods-info-header">
        <text class="goods-name">{{disGoods.nxDgGoodsName}}</text>
        <text class="goods-detail" wx:if="{{disGoods.nxDgGoodsDetail != null && disGoods.nxDgGoodsDetail.length > 0}}">
          {{disGoods.nxDgGoodsDetail}}
        </text>
      </view>

      <view class="input-group">
        <view class="input-item">
          <text class="input-label">配送单价:</text>
          <view class="input-wrapper">
            <input  wx:if="{{showOperationPrice}}" type="digit" class="input-field" bindinput="inputSellingPrice" value="{{sellingPrice}}" placeholder="请输入价格" />
            <text class="input-unit">元{{disGoods.nxDsStandardName}}</text>
          </view>
        </view>

        <view class="input-item">
          <text class="input-label">出货要求:</text>
          <input  wx:if="{{showOperationPrice}}" type="text" class="input-field" bindinput="inputPickDetail" value="{{pickDetail}}" placeholder="请输入出货要求" />
        </view>

        <view class="input-item">
          <text class="input-label">订货商品名称:</text>
          <input wx:if="{{showOperationPrice}}" type="text" class="input-field" bindinput="inputOrderName" value="{{orderName}}" placeholder="请输入商品名称" />
        </view>
      </view>
    </view>

    <view class="popup-actions">
      <view class="popup-btn cancel-btn" catchtap="hideMask">
        <text class="btn-text">取消</text>
      </view>
      <view class="popup-btn confirm-btn" catchtap="_updateDepGoods">
        <text class="btn-text">保存</text>
      </view>
    </view>
  </view>
</view>