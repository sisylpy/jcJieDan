page {
  background: #f6f7f8;
  color: #18201c;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.toolbar {
  padding: 16rpx 24rpx 10rpx;
  background: #fff;
}

.search-box {
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f3f4f5;
  border-radius: 12rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.58;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.clear {
  padding: 10rpx;
  color: #87918c;
  font-size: 34rpx;
  line-height: 1;
}

.content {
  padding: 14rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.view-toolbar {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.view-switch {
  display: flex;
  padding: 4rpx;
  background: #e9efec;
  border-radius: 12rpx;
}

.view-option {
  min-width: 142rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f7b75;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 9rpx;
}

.view-option.active {
  color: #fff;
  background: #169b59;
  box-shadow: 0 4rpx 12rpx rgba(22, 155, 89, 0.18);
}

.amount-window {
  min-width: 132rpx;
  height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #314039;
  font-size: 24rpx;
  font-weight: 650;
  background: #fff;
  border: 1rpx solid #dce6e1;
  border-radius: 11rpx;
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 20rpx 0;
  background: #fff;
  border: 1rpx solid #edf0ee;
  border-radius: 12rpx;
}

.summary-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #edf0ee;
}

.summary-item:last-child {
  border-right: 0;
}

.summary-label {
  margin-bottom: 8rpx;
  color: #7f8984;
  font-size: 22rpx;
  white-space: nowrap;
}

.summary-value {
  color: #202923;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-value text {
  margin-left: 4rpx;
  color: #8c9691;
  font-size: 20rpx;
  font-weight: 400;
}

.summary-value.emphasis {
  color: #d24c43;
}

.summary-value.compact {
  font-size: 26rpx;
}

.summary-value.money {
  color: #0c9254;
  font-size: 29rpx;
}

.amount-summary {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  row-gap: 20rpx;
}

.amount-summary .summary-item:nth-child(2) {
  border-right: 0;
}

.anomaly-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx 18rpx;
  background: #fff;
  border: 1rpx solid #e7ece9;
  border-radius: 14rpx;
  box-shadow: 0 6rpx 18rpx rgba(27, 53, 40, 0.04);
}

.anomaly-card.has-anomaly {
  border-color: #f1d4ce;
  background: linear-gradient(135deg, #fff 0%, #fff9f7 100%);
}

.anomaly-card-head,
.anomaly-title-row,
.anomaly-types {
  display: flex;
  align-items: center;
}

.anomaly-card-head {
  justify-content: space-between;
}

.anomaly-title {
  color: #243029;
  font-size: 29rpx;
  font-weight: 700;
}

.anomaly-total {
  min-width: 31rpx;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  color: #fff;
  font-size: 20rpx;
  line-height: 27rpx;
  text-align: center;
  background: #d85c4b;
  border-radius: 16rpx;
}

.anomaly-subtitle {
  display: block;
  margin-top: 5rpx;
  color: #8a948f;
  font-size: 21rpx;
}

.anomaly-link {
  color: #168a62;
  font-size: 23rpx;
}

.anomaly-types {
  margin-top: 18rpx;
  overflow: hidden;
  background: #f7f8f7;
  border-radius: 10rpx;
}

.anomaly-type {
  flex: 1;
  padding: 13rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-right: 1rpx solid #e9ecea;
}

.anomaly-type:last-child {
  border-right: 0;
}

.anomaly-type-count {
  color: #35423b;
  font-size: 27rpx;
  font-weight: 700;
}

.anomaly-type-label {
  color: #737e78;
  font-size: 21rpx;
}

.anomaly-type.stop .anomaly-type-count {
  color: #d24f43;
}

.anomaly-type.decline .anomaly-type-count {
  color: #dd831f;
}

.anomaly-type.surge .anomaly-type-count {
  color: #3976cd;
}

.anomaly-disclaimer {
  display: block;
  margin-top: 13rpx;
  color: #9b817a;
  font-size: 20rpx;
  line-height: 28rpx;
}

.sort-line {
  height: 68rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #35403a;
  font-size: 26rpx;
  font-weight: 600;
}

.sort-desc {
  color: #8a948f;
  font-size: 22rpx;
  font-weight: 400;
}

.goods-group {
  margin-bottom: 18rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e9edeb;
  border-radius: 10rpx;
}

.group-title {
  height: 88rpx;
  padding: 0 24rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafbfa;
}

.group-name-wrap {
  height: 100%;
  display: flex;
  align-items: center;
}

.group-line {
  width: 6rpx;
  height: 32rpx;
  margin-right: 16rpx;
  background: #169b59;
  border-radius: 0 4rpx 4rpx 0;
}

.group-name {
  color: #1e2822;
  font-size: 28rpx;
  font-weight: 700;
}

.group-range {
  margin-left: 6rpx;
  color: #7f8984;
  font-size: 22rpx;
}

.group-count {
  min-width: 34rpx;
  padding: 3rpx 9rpx;
  color: #168a52;
  font-size: 21rpx;
  text-align: center;
  background: #eaf6ef;
  border-radius: 8rpx;
}

.group-title-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-arrow {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa39e;
  font-size: 24rpx;
  line-height: 1;
  transition: transform 0.2s ease;
}

.group-arrow.collapsed {
  transform: rotate(-90deg);
}

.group-blue .group-line {
  background: #4f81dc;
}

.group-blue .group-count {
  color: #3972d1;
  background: #edf3fd;
}

.group-orange .group-line {
  background: #e88923;
}

.group-orange .group-count {
  color: #d57413;
  background: #fff3e7;
}

.group-gray .group-line {
  background: #7e8993;
}

.group-gray .group-count,
.group-light .group-count {
  color: #6e7973;
  background: #f0f2f1;
}

.group-light .group-line {
  background: #b4bbb7;
}

.goods-row {
  min-height: 152rpx;
  padding: 18rpx 16rpx;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 116rpx 130rpx 104rpx 18rpx;
  gap: 10rpx;
  align-items: center;
  border-top: 1rpx solid #edf0ee;
}

.goods-avatar {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #63716a;
  font-size: 26rpx;
  font-weight: 700;
  background: #f1f4f2;
  border: 1rpx solid #e5eae7;
  border-radius: 10rpx;
}

.goods-avatar image {
  width: 100%;
  height: 100%;
}

.goods-main {
  min-width: 0;
}

.goods-name {
  display: block;
  overflow: hidden;
  color: #172019;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-relation-meta {
  display: flex;
  min-width: 0;
  margin-top: 3rpx;
  align-items: center;
  gap: 8rpx;
}

.department-tag {
  max-width: 130rpx;
  padding: 1rpx 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 6rpx;
  color: #167c68;
  background: #e8f5f2;
  font-size: 19rpx;
  line-height: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #747f79;
  font-size: 22rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-tags {
  margin-top: 5rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.requirement-tag {
  padding: 2rpx 8rpx;
  color: #c93e38;
  font-size: 19rpx;
  line-height: 25rpx;
  background: #fff0ef;
  border-radius: 5rpx;
}

.image-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #6f7a74;
  font-size: 20rpx;
}

.image-symbol {
  font-size: 22rpx;
}

.goods-anomaly-tag {
  display: inline-block;
  margin-top: 6rpx;
  padding: 2rpx 8rpx;
  color: #bd5a3f;
  font-size: 19rpx;
  line-height: 26rpx;
  background: #fff1ed;
  border-radius: 6rpx;
}

.goods-anomaly-tag.anomaly-ORDERING_DECLINE {
  color: #bd741d;
  background: #fff4e5;
}

.goods-anomaly-tag.anomaly-ORDERING_SURGE {
  color: #3971bc;
  background: #edf4ff;
}

.goods-anomaly-tag.high {
  font-weight: 600;
}

.primary-metric,
.order-habit,
.last-order {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.metric-label {
  color: #89938e;
  font-size: 18rpx;
  line-height: 23rpx;
}

.metric-value {
  margin-top: 5rpx;
  color: #168f55;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.metric-note,
.last-label {
  margin-top: 4rpx;
  color: #89938e;
  font-size: 18rpx;
  line-height: 24rpx;
}

.amount-metric .metric-value {
  font-size: 23rpx;
}

.habit-value {
  margin-top: 5rpx;
  color: #26342d;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 29rpx;
}

.habit-cadence {
  margin-top: 4rpx;
  color: #7b8781;
  font-size: 17rpx;
  line-height: 23rpx;
}

.last-value {
  margin-top: 3rpx;
  color: #2e3933;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.row-arrow {
  color: #9ba49f;
  font-size: 36rpx;
  line-height: 1;
}

.empty-state {
  padding: 140rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  color: #3c4741;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: #929b96;
  font-size: 23rpx;
}
