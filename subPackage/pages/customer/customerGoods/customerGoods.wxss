.goodsList{
  display: none;
}

.goodsList.is-active{
  display: block;
}

.goodsList.is-hideen{
  display: none;
}

.sendBtn{
  padding: 10rpx 40rpx;
  color: #fff;
  border-radius: 40rpx;

}


.input{
  border-bottom: 1px solid gray;
}

/* 空状态样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 商品容器 */
.goods-container {
  background: #f8f9fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部操作栏 */
.top-actions {
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

/* 搜索容器 */
.search-container {
  width: 100%;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.search-box:focus-within {
  border-color: #2196f3;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.15);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #2c3e50;
  background: transparent;
}

.search-input::placeholder {
  color: #999;
}

.search-clear {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
}

.clear-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* 搜索无结果 */
.empty-search {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 30rpx;
  min-height: 400rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 50rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
  background: #e9ecef;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.filter-btn {
  background: #e3f2fd;
  border-color: #2196f3;
}

.filter-btn .btn-text {
  color: #2196f3;
}

.pdf-btn {
  background: #e8f5e8;
  border-color: #4caf50;
}

.pdf-btn .btn-text {
  color: #4caf50;
}

/* 左右分栏树形布局 */
.tree-layout {
  display: flex;
  flex: 1;
  min-height: 0;
  background: #f8f9fa;
  overflow: hidden;
}

/* 左侧分类栏 */
.category-sidebar {
  width: 150rpx;
  background: #fff;
  border-right: 1rpx solid #e9ecef;
  flex-shrink: 0;
}

.sidebar-scroll {
  height: 100%;
  width: 100%;
}

.category-sidebar-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  background: #fff;
}

.category-sidebar-item:active {
  background: #f8f9fa;
}

.category-sidebar-item.active {
  background: #e3f2fd;
  border-left: 4rpx solid #2196f3;
  position: relative;
}

.category-sidebar-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.category-sidebar-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c3e50;
  line-height: 1.4;
  word-break: break-all;
}

.category-sidebar-item.active .category-sidebar-name {
  color: #2196f3;
  font-weight: 600;
}

.category-sidebar-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.category-sidebar-item.active .category-sidebar-count {
  color: #1976d2;
}

/* 左侧底部空白区域 */
.sidebar-bottom-spacer {
  height: 200rpx;
  width: 100%;
}

/* 右侧商品内容区 */
.goods-content {
  flex: 1;
  background: #f8f9fa;
  overflow: hidden;
}

.content-scroll {
  height: 100%;
  width: 100%;
}

/* 分类商品区块 */
.category-goods-section {
  margin-bottom: 40rpx;
}

.category-section-header {
  padding: 24rpx 30rpx 24rpx 30rpx;
  margin: 20rpx 20rpx 20rpx 20rpx;
}

.category-title-wrapper {
  display: flex;
  align-items: center;
  position: relative;
}

.category-section-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-right: 8rpx;
}

.category-section-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.category-dash-line {
  flex: 1;
  height: 0;
  border-top: 1rpx dashed #ddd;
  margin-left: 16rpx;
}

/* 底部空白区域 */
.bottom-spacer {
  height: 200rpx;
  width: 100%;
}

/* 未选择分类提示 */
.empty-content-sidebar {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 30rpx;
  min-height: 400rpx;
  height: 100%;
}

.goods-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.goods-item:first-child {
  margin-top: 20rpx;
}

/* 商品头部信息 */
.goods-header {
  margin-bottom: 24rpx;
}

.goods-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.goods-standard {
  font-size: 26rpx;
  color: #7f8c8d;
  background: #f8f9fa;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.goods-price {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: 600;
  background: #fdf2f2;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.goods-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.goods-attr {
  font-size: 24rpx;
  color: #3498db;
  background: #ebf3fd;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  display: inline-block;
}

/* 商品详细信息 */
.goods-info {
  margin-bottom: 24rpx;
}

.standard-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #effaf4 0%, #f7fcf9 100%);
  border: 2rpx solid #cdebd9;
}

.standard-entry-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.standard-entry-title {
  color: #18784b;
  font-size: 30rpx;
  font-weight: 700;
}

.standard-entry-desc {
  margin-top: 8rpx;
  color: #688074;
  font-size: 24rpx;
}

.standard-entry-arrow {
  margin-left: 20rpx;
  color: #22945c;
  font-size: 46rpx;
  line-height: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-right: 12rpx;
  min-width: 120rpx;
}

.info-value {
  font-size: 30rpx;
  color: #2c3e50;
  flex: 1;
}

.info-value.highlight {
  color: #e74c3c;
  font-weight: 600;
}

.info-value.price {
  color: #27ae60;
  font-weight: 600;
}

/* 操作按钮 */
.goods-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f3f4;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 50rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 24rpx;
  font-weight: 500;
}

.edit-btn {
  background: #e3f2fd;
  color: #2196f3;
}

.standard-btn {
  background: #e8f7ef;
  color: #168a52;
}

.edit-btn:active {
  background: #bbdefb;
}

.delete-btn {
  background: #ffebee;
  color: #f44336;
}

.delete-btn:active {
  background: #ffcdd2;
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 60rpx 20rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #999;
}

/* 弹窗样式 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  
}

.overlay.show {
  opacity: 1;
  visibility: visible;
  /* display: block; */
}

.edit-popup {
  background: #fff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  /* overflow: hidden; */
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
  transform: scale(0.8);
  transition: transform 0.3s ease;
}

.overlay.show .edit-popup {
  transform: scale(1);
}

.popup-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  text-align: center;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.popup-content {
  padding: 30rpx;
}

.goods-info-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f3f4;
}

.goods-info-header .goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.goods-info-header .goods-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
}

.input-field {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #2c3e50;
  background: transparent;
}

.input-unit {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-left: 12rpx;
}

.input-field {
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  background: #f8f9fa;
}

.input-field:focus {
  border-color: #667eea;
  background: #fff;
}

.popup-actions {
  display: flex;
  border-top: 1rpx solid #f1f3f4;
}

.popup-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.popup-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #f8f9fa;
  color: #6c757d;
}

.cancel-btn:active {
  background: #e9ecef;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.confirm-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .info-row {
    flex-direction: column;
    gap: 12rpx;
  }
  
  .info-item {
    flex: none;
  }
  
  .goods-actions {
    flex-direction: column;
    gap: 12rpx;
  }
  
  .action-item {
    justify-content: center;
  }
}


/* 确保页面布局正确 */
.flex.flex-column {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

page, .page {
  height: 100vh;
  overflow: hidden;
}
