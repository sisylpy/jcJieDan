          <image src="../../../../images/adduser.png" class="icon mr-20"></image>
          <text>邀请客户注册订货小程序</text>
        </view>
      </view>


    </view> -->
  </view>
</view>




<view class='overlay {{showOperationUser ? "show" : ""}}' catchtouchmove='ture' catchtap="hideMaskUser" catchtouchmove='ture'>
  <view class="flex-column nnn bg-white">
    <!-- <view class="flex-row p-30 border-bottom"  bindtap="editUser">
      <image src="../../../../images/edit.png" class="icon mr-10"></image>
