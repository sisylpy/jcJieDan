<import src='../../../../template/resGoods/resGoods.wxml' />
<import src='../../../../template/resGroup/resGroup.wxml' />


<view class="flex-column flex">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{editDepAttrName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column">

    <block wx:if="{{userArr.length == 0}}">
      <view class="flex-column center-content" style="height: {{windowHeight  - navBarHeight - 220}}rpx; ">

        <view class="flex flex-column center-content">
          <image class="empty_image" src="../../../images/xiuxi.png"></image>
          <text class="font-xl p-20">暂时无注册成功的小程序用户</text>
          <text class=" darktext-secondary">客户用小程序下单</text>
        </view>

      </view>
    </block>
    <!-- <scroll-view wx:else="" scroll-y style="height:{{windowHeight  - navBarHeight - 120}}rpx; "> -->

      <template is="resGroup" data="{{userArr:userArr,windowWidth:windowWidth, url: url }}"></template>
      <view style="height: 100rpx;"> </view>
    <!-- </scroll-view> -->

    <!-- <view class="center-content flex-column">
      <view class="flex-row-default  applyBtn text-center" bindtap="toOpenOrder">
