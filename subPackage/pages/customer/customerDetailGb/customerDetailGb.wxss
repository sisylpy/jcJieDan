@import "/template/resGoods/resGoods.wxss";
@import "/template/resGroup/resGroup.wxss";

/* 配送设置弹窗样式 */
.picker-item {
  padding: 10rpx 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  min-width: 200rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.picker-item.selected {
  border-color: #07c160;
  background-color: #f0f9ff;
  color: #07c160;
}

.delivery-notes {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 10rpx;
  background-color: #f9f9f9;
  font-size: 28rpx;
}

.btn-primary {
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.btn-primary:active {
  background-color: #06ad56;
}

.bg-gray {
  background-color: #cccccc !important;
  color: #666666 !important;
}

/* 配送设置项样式 */
.delivery-setting-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.delivery-setting-label {
  width: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.delivery-setting-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.delivery-status {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.delivery-status.set {
  color: #07c160;
}

.delivery-status.unset {
  color: #ff6b6b;
}