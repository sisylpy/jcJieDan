page {
  height: 100%;
  background: #f4f6f5;
  color: #20332a;
}

.standard-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f4f6f5;
}

.goods-summary {
  flex-shrink: 0;
  padding: 24rpx 32rpx 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #173f30 0%, #226b49 100%);
  box-shadow: 0 10rpx 30rpx rgba(22, 74, 49, 0.18);
}

.goods-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-summary-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.goods-summary-tag {
  margin-left: 20rpx;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  color: #ddf8e9;
  font-size: 22rpx;
}

.goods-summary-customer,
.goods-summary-alias {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-content {
  padding: 30rpx 28rpx 80rpx;
}

.goods-relation-card {
  margin-bottom: 30rpx;
  padding: 26rpx;
  border: 2rpx solid #dbe9e2;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(32, 57, 45, 0.06);
}

.goods-relation-heading,
.linked-goods,
.linked-goods-name-row,
.relation-picker-head,
.relation-search-row,
.relation-result {
  display: flex;
  align-items: center;
}

.goods-relation-heading,
.relation-picker-head {
  justify-content: space-between;
}

.goods-relation-eyebrow,
.goods-relation-title,
.linked-goods-meta,
.linked-goods-detail,
.goods-relation-tip,
.relation-picker-title,
.relation-picker-subtitle,
.relation-result-name,
.relation-result-meta,
.relation-result-detail {
  display: block;
}

.goods-relation-eyebrow {
  color: #2b9b61;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.goods-relation-title {
  margin-top: 4rpx;
  color: #20332a;
  font-size: 32rpx;
  font-weight: 800;
}

.goods-relation-change {
  padding: 14rpx 0 14rpx 18rpx;
  color: #16864f;
  font-size: 25rpx;
}

.linked-goods {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f4f8f6;
}

.linked-goods-image,
.linked-goods-placeholder,
.relation-result-image,
.relation-result-placeholder {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.linked-goods-placeholder,
.relation-result-placeholder {
  color: #fff;
  background: #5a8d74;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
}

.linked-goods-main,
.relation-result-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.linked-goods-name-row {
  min-width: 0;
}

.linked-goods-name {
  overflow: hidden;
  flex: 1;
  min-width: 0;
  color: #1f3429;
  font-size: 31rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.linked-goods-id {
  margin-left: 12rpx;
  color: #91a099;
  font-size: 21rpx;
}

.linked-goods-meta,
.relation-result-meta {
  margin-top: 8rpx;
  color: #5f7168;
  font-size: 23rpx;
}

.linked-goods-detail,
.relation-result-detail {
  overflow: hidden;
  margin-top: 6rpx;
  color: #87938d;
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-relation-tip {
  margin-top: 18rpx;
  color: #7d8b84;
  font-size: 22rpx;
  line-height: 1.55;
}

.relation-picker-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(10, 25, 17, 0.48);
}

.relation-picker {
  position: fixed;
  z-index: 81;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  height: 76vh;
  padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}

.relation-picker-title {
  color: #20332a;
  font-size: 34rpx;
  font-weight: 800;
}

.relation-picker-subtitle {
  margin-top: 6rpx;
  color: #87938d;
  font-size: 22rpx;
}

.relation-picker-close {
  padding: 14rpx 0 14rpx 24rpx;
  color: #5f7168;
  font-size: 25rpx;
}

.relation-search-row {
  margin-top: 24rpx;
}

.relation-search-input {
  box-sizing: border-box;
  height: 82rpx;
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
  border: 2rpx solid #dfe7e3;
  border-radius: 16rpx;
  background: #f7f9f8;
  font-size: 27rpx;
}

.relation-search-button {
  height: 82rpx;
  margin-left: 14rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  color: #fff;
  background: #218d56;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.relation-result-list {
  height: calc(76vh - 210rpx - env(safe-area-inset-bottom));
  margin-top: 18rpx;
}

.relation-loading,
.relation-empty {
  padding: 70rpx 20rpx;
  color: #89958f;
  font-size: 25rpx;
  text-align: center;
}

.relation-result {
  min-height: 126rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #edf1ef;
}

.relation-result.current {
  opacity: 0.72;
  background: #f6faf8;
}

.relation-result-name {
  color: #20332a;
  font-size: 29rpx;
  font-weight: 750;
}

.relation-current-tag {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #267d51;
  background: #e5f5ec;
  font-size: 21rpx;
}

.relation-select-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #87938d;
  font-size: 44rpx;
}

.loading-card,
.error-card,
.empty-standard {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 80rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #708079;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(32, 57, 45, 0.06);
}

.loading-dot {
  width: 26rpx;
  height: 26rpx;
  margin-bottom: 20rpx;
  border: 5rpx solid #d9ebe2;
  border-top-color: #20955a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-title,
.empty-standard-title {
  color: #243b30;
  font-size: 32rpx;
  font-weight: 700;
}

.error-message,
.empty-standard-desc {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #7a8881;
  font-size: 26rpx;
  line-height: 1.7;
}

.retry-button {
  margin-top: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  color: #16894f;
  background: #e9f7ef;
  font-size: 26rpx;
  font-weight: 600;
}

.section-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 8rpx 4rpx 26rpx;
}

.section-eyebrow,
.section-title {
  display: block;
}

.section-eyebrow {
  color: #2b9b61;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: 4rpx;
  color: #20332a;
  font-size: 40rpx;
  font-weight: 800;
}

.section-count {
  margin-left: 12rpx;
  color: #7d8b84;
  font-size: 28rpx;
  font-weight: 600;
}

.section-subtitle {
  display: block;
  margin-top: 2rpx;
  color: #8b9791;
  font-size: 21rpx;
}

.image-section-heading {
  margin-top: 46rpx;
}

.add-requirement-button,
.edit-images-button {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #16864c 0%, #27a864 100%);
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(27, 145, 85, 0.2);
}

.edit-images-button {
  color: #28704d;
  background: #fff;
  border: 2rpx solid #cfe3d8;
  box-shadow: none;
}

.empty-standard-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  margin-bottom: 26rpx;
  border-radius: 28rpx;
  color: #fff;
  background: #23975b;
  font-size: 38rpx;
  font-weight: 800;
  transform: rotate(-4deg);
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #198b50 0%, #28a967 100%);
  box-shadow: 0 10rpx 24rpx rgba(27, 145, 85, 0.22);
}

.primary-action.compact {
  width: 300rpx;
  height: 82rpx;
  margin-top: 34rpx;
}

/* —— 客户要求编号列表 —— */

.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.requirement-list-item {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 26rpx 24rpx;
  border: 2rpx solid #edf0ee;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(32, 57, 45, 0.06);
}

.requirement-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #198b50 0%, #28a967 100%);
  font-size: 30rpx;
  font-weight: 800;
}

.requirement-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.requirement-top {
  display: flex;
  align-items: center;
  min-width: 0;
}

.requirement-text {
  overflow: hidden;
  flex: 1;
  min-width: 0;
  color: #182a21;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.importance-badge {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  color: #67756e;
  background: #f0f3f1;
  font-size: 19rpx;
}

.importance-badge.level-4 {
  color: #a26413;
  background: #fff3d9;
}

.importance-badge.level-5 {
  color: #9a5705;
  background: #ffe7a8;
  font-weight: 800;
}

.requirement-dimension {
  display: block;
  margin-top: 8rpx;
  color: #7b8982;
  font-size: 25rpx;
}

.requirement-thumb {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  margin-left: 18rpx;
  border-radius: 14rpx;
  background: #edf3f0;
}

.requirement-arrow {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #b6c0bb;
  font-size: 40rpx;
}

/* —— 参考图片宫格 —— */

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.grid-image-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  border: 3rpx solid #d9eee3;
  border-radius: 18rpx;
  background: #edf3f0;
}

.grid-image-card.prohibited {
  border-color: #f2b5b5;
  background: #fff0f0;
}

.grid-image {
  display: block;
  width: 100%;
  height: 200rpx;
}

.grid-corner {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.18);
}

.grid-corner.pass {
  background: rgba(34, 152, 93, 0.92);
}

.grid-corner.prohibited {
  background: rgba(214, 62, 62, 0.92);
}

.grid-caption {
  display: block;
  overflow: hidden;
  padding: 10rpx 12rpx;
  color: #45574e;
  background: #fff;
  font-size: 21rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid-add-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 200rpx;
  border: 3rpx dashed #cfe0d7;
  border-radius: 18rpx;
  color: #7d8b84;
  background: #fbfdfc;
}

.grid-add-plus {
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.grid-add-text {
  margin-top: 10rpx;
  font-size: 22rpx;
}

/* 参考图片删除按钮 */
.grid-delete {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  line-height: 1;
  background: rgba(0, 0, 0, 0.55);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 参考图片：本次新增待上传 */
.grid-image-card.pending {
  border-color: #bcd9ff;
  background: #f0f6ff;
}

.grid-uploading {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.45);
}

.grid-upload-failed {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  background: rgba(214, 62, 62, 0.55);
}

/* —— 提示 & 修改记录 —— */

.standard-tip {
  margin-top: 34rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  color: #52635b;
  background: #e8f2ed;
  font-size: 24rpx;
  line-height: 1.6;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  color: #28704d;
  background: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(32, 57, 45, 0.05);
}

.history-arrow {
  color: #7d8b84;
  font-size: 36rpx;
}

/* —— 修改记录弹层 —— */

.history-mask {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(10, 25, 17, 0.48);
}

.history-popup {
  position: fixed;
  z-index: 91;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  height: 78vh;
  padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #f4f6f5;
}

.history-popup-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.history-popup-title {
  display: block;
  color: #20332a;
  font-size: 36rpx;
  font-weight: 800;
}

.history-popup-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #2b9b61;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.history-popup-close {
  padding: 14rpx 0 14rpx 24rpx;
  color: #5f7168;
  font-size: 25rpx;
}

.history-popup-body {
  height: calc(78vh - 140rpx - env(safe-area-inset-bottom));
  margin-top: 24rpx;
}

.history-empty {
  margin-top: 10rpx;
  padding: 60rpx;
}

.timeline {
  padding-top: 8rpx;
}

.timeline-item {
  display: flex;
}

.timeline-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 26rpx;
  border: 6rpx solid #d6eee1;
  border-radius: 50%;
  background: #22975b;
}

.timeline-line {
  flex: 1;
  width: 3rpx;
  min-height: 50rpx;
  background: #dce6e0;
}

.history-card {
  flex: 1;
  min-width: 0;
  margin: 0 0 22rpx 14rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 7rpx 22rpx rgba(31, 57, 44, 0.06);
}

.history-time,
.history-title,
.history-line,
.history-operator {
  display: block;
}

.history-time {
  color: #268455;
  font-size: 24rpx;
  font-weight: 700;
}

.history-title {
  margin-top: 9rpx;
  color: #263a30;
  font-size: 30rpx;
  font-weight: 800;
}

.history-lines {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f8f6;
}

.history-line {
  color: #44564d;
  font-size: 25rpx;
  line-height: 1.7;
}

.history-operator {
  margin-top: 16rpx;
  color: #8a9690;
  font-size: 23rpx;
}
