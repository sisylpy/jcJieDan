<view class="flex flex-column ">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{gbDisInfo.gbDistributerName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-row-between">
    <view class="flex-column border-bottom top_padding p-20" >

      <view class="p-20">
        <text class="big">{{gbDisInfo.gbDistributerName}}</text>
      </view>
      <view class="flex-row ">
        <text class="mr-10 text-secondary">配送单格式:飞鹅打印</text>

      </view>


    </view>

    <view class="flex-row">

      <view class="flex-column center-content mr-30" bind:tap="openDetail">
        <image src="/images/edit-3.png" mode="aspectFill" class="icon" />
        <view>修改简称</view>
      </view>

      <!-- <view class="flex-column center-content" bindtap="toDepGoods" hover-class="hover">
        <image src="/images/icon_goods.png" mode="aspectFill" class="icon" />
        <view>客户商品</view>
      </view> -->

    </view>


  </view>




  <!--  -->
  <view class="{{totalArr == 0   ? 'show' : 'hide'}}" style="height: {{windowHeight - 760}}rpx; ">
    <view class=" flex-column flex-column-center center-content" style="margin-top: 200rpx;">
      <image class="empty_image" src="../../../../images/xiuxi.png"></image>
      <text class="text-secondary font-sm p-20">无配送账单</text>
    </view>
  </view>

  <block wx:if="{{ totalArr > 0}}">
    <view class="p-20">
      <view class="flex-column liziBack big_full_padding ">
        <text class="font-xs gray">账款总额</text>
        <view class="flex-row-between mb-10">
          <view class="flex-row">
            <text class="excreambig mr-20">{{totalSettle}}</text> <text class="small">元</text>
          </view>
          <view class="mainBack settleBtn" bindtap="toSettleBills">结账</view>
        </view>
        <view class="flex-row-reverse mt-10">

          <text class="text-danger mainBack p-20" bind:tap="toStars"> 低星批次</text>
        </view>
      </view>
    </view>

    <view class="flex-column" wx:for="{{accountBillArr}}" wx:for-item="month" wx:for-index="index">
      <view wx:if="{{month.arr.length > 0}}">
        <view class="flex-column border-bottom p-20 ">
          <text class="normal">{{month.month}}月</text>
          <view class="flex-row gray font-xs">
            <text class="mr-10">全部账单</text>
            <text class="mr-10">{{month.arr.length}}个</text>
            <text class="mr-10">未结账单</text>
            <text>{{month.unSettleTotal}}个</text>
          </view>
        </view>

        <view class="flex-row-between p-20 border-bottom bg-white" wx:for="{{month.arr}}" wx:for-item="item" style="width: {{windowWidth - 40}}rpx; " hover-class="hover" bindtap="openOperation" data-id="{{item.nxDepartmentBillId}}" data-item="{{item}}" wx:key="nxDepartmentBillId" data-dep="{{item.gbDepartmentEntity}}">

          <view class="flex-column">
            <view class="flex-row">
              <text class="mr-20">{{item.gbDepartmentEntity.gbDepartmentName}}</text>
            </view>
            <view class="flex-row">
              <text class="mr-20">{{item.nxDbDate}}</text>
            </view>
            <!-- <view class="flex-row extremeSmall gray">
                <text>利润:</text>
                <text>{{item.nxDbProfitTotal}}元</text>
              </view>
              <view class="flex-row extremeSmall gray">
                <text>利润率:</text>
                <text>{{item.nxDbProfitScale}}%</text>
              </view> -->
          </view>

          <view class="flex-row with-mr-20">
            <view class="flex-column">
              <view class="flex-row mr-20">
                <text class="big ">{{item.nxDbTotal}}</text>
                <text class="font-sm">元</text>
                <text class="red" wx:if="{{item.nxDbTotal < 0}}">（退货）</text>
              </view>
              <text wx:if="{{item.nxDbStatus == 0}}" class="font-sm text-danger">未结账</text>
              <text wx:elif="{{item.nxDbStatus == 1}}" class="font-sm text-secondary">已结账</text>
            </view>
            <view>
              <image src="../../../../images/points.png" class="icon"></image>
            </view>
          </view>
        </view>

      </view>
    </view>

    <view class="gray extremeSmall p-20  " style="text-align:center;">显示最近3个月的账单</view>

  </block>
  <!-- ./jizhang账单 -->


</view>



<!-- operation -->
<view class='overlay {{showOperation ? "show" : "hide"}}' catchtouchmove='ture' catchtap="hideMask">
  <view class="flex-column nnn bg-white " wx:if="{{chooseSize}}" animation='{{animationData}}'>

    <!-- -->
    <view class="p-30  flex-row border-bottom" bindtap="openAccountBill">
      <image src="../../../../images/BusinessIcons_DocPaper-.png" class="icon icon_operation"></image>
      <text class="text_operation">查看详细</text>
    </view>

    <view class="p-30 flex-row border-bottom" bindtap="toOpenPrint">
      <image src="../../../../images/weight-2.png" class="icon icon_operation"></image>
      <text class="text_operation">重新打印</text>
    </view>

    <!-- <view class="p-30 flex-row" bindtap="finishBill">
      <image src="../../../../images/pricefilled.png" class="icon icon_operation"></image>
      <text class="text_operation">完成结账单</text>
    </view> -->
    <view class="p-30 flex-row border-bottom" wx:if="{{billItem.nxDbStatus == 0}}" bindtap="deleteBill">
      <image src="../../../../images/ashbin.png" class="icon mr-20"></image>
      <text class="font-md">删除结账单</text>
    </view>

    <view style="height: 30rpx;"></view>


  </view>
</view>
<!-- ../operation -->



<!--  操作  -->
