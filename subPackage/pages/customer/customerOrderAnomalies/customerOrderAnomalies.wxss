page {
  background: #f5f7f6;
  color: #17201a;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  font-size: 36rpx;
}

.content {
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.overview-card {
  padding: 26rpx 24rpx 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #176e58 0%, #1ca779 100%);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 26rpx rgba(18, 112, 82, 0.18);
}

.overview-head,
.overview-grid,
.overview-foot,
.notice,
.filters,
.item-main,
.goods-title-line,
.goods-meta,
.quantity-line,
.date-line,
.history-list,
.cause-tags {
  display: flex;
  align-items: center;
}

.overview-head,
.overview-foot,
.date-line {
  justify-content: space-between;
}

.customer-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.overview-desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.overview-total {
  display: flex;
  align-items: baseline;
}

.overview-number {
  font-size: 58rpx;
  font-weight: 750;
  line-height: 1;
}

.overview-unit {
  margin-left: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
}

.overview-grid {
  margin-top: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
}

.overview-stat {
  flex: 1;
  padding: 14rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.16);
}

.overview-stat:last-child {
  border-right: 0;
}

.overview-stat text:first-child {
  font-size: 34rpx;
  font-weight: 700;
}

.overview-stat text:last-child {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
}

.overview-foot {
  margin-top: 15rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.notice {
  margin-top: 16rpx;
  padding: 15rpx 18rpx;
  align-items: flex-start;
  color: #8d6355;
  font-size: 25rpx;
  line-height: 31rpx;
  background: #fff7f2;
  border: 1rpx solid #f0ded5;
  border-radius: 12rpx;
}

.notice-mark {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  color: #fff;
  line-height: 30rpx;
  text-align: center;
  background: #d98a65;
  border-radius: 50%;
}

.filter-scroll {
  width: 100%;
  margin: 20rpx 0 16rpx;
  white-space: nowrap;
}

.filters {
  gap: 12rpx;
}

.filter {
  padding: 12rpx 18rpx;
  display: inline-flex;
  align-items: center;
  color: #64716a;
  font-size: 27rpx;
  background: #fff;
  border: 1rpx solid #e3e8e5;
  border-radius: 26rpx;
}

.filter.active {
  color: #fff;
  background: #178c69;
  border-color: #178c69;
}

.filter-count {
  min-width: 25rpx;
  margin-left: 8rpx;
  text-align: center;
}

.anomaly-item {
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e7ebe8;
  border-left: 6rpx solid #d48657;
  border-radius: 14rpx;
  box-shadow: 0 5rpx 16rpx rgba(24, 48, 36, 0.04);
}

.anomaly-item.tone-stop {
  border-left-color: #d85b4e;
}

.anomaly-item.tone-decline {
  border-left-color: #dc8b2a;
}

.anomaly-item.tone-surge {
  border-left-color: #4a7fd2;
}

.item-main {
  min-height: 132rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
}

.goods-avatar {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  color: #607168;
  font-size: 31rpx;
  font-weight: 700;
  background: #f0f4f2;
  border-radius: 11rpx;
}

.goods-avatar image {
  width: 100%;
  height: 100%;
}

.goods-info {
  min-width: 0;
  margin-left: 14rpx;
  flex: 1;
}

.goods-title-line {
  min-width: 0;
}

.goods-name {
  max-width: 220rpx;
  overflow: hidden;
  color: #18221b;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-tag {
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  color: #bc5a42;
  font-size: 23rpx;
  background: #fff0ec;
  border-radius: 6rpx;
}

.tone-decline .type-tag {
  color: #b46f1b;
  background: #fff3e4;
}

.tone-surge .type-tag {
  color: #3f70b7;
  background: #edf4ff;
}

.goods-meta {
  margin-top: 5rpx;
  gap: 8rpx;
  color: #89928d;
  font-size: 24rpx;
}

.department-tag {
  padding: 1rpx 7rpx;
  color: #177b65;
  background: #eaf5f2;
  border-radius: 5rpx;
}

.reason {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #59665f;
  font-size: 25rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confidence {
  width: 74rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.confidence text:first-child {
  color: #24765f;
  font-size: 29rpx;
  font-weight: 700;
}

.confidence text:last-child {
  margin-top: 3rpx;
  color: #9aa29e;
  font-size: 21rpx;
}

.expand-arrow {
  margin-left: 5rpx;
  color: #9ca59f;
  font-size: 32rpx;
  transform: rotate(-90deg);
}

.expand-arrow.expanded {
  transform: rotate(0deg);
}

.detail {
  padding: 0 18rpx 20rpx;
  border-top: 1rpx solid #edf0ee;
}

.detail-section {
  padding: 20rpx 2rpx 16rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.detail-title {
  display: block;
  margin-bottom: 14rpx;
  color: #354139;
  font-size: 28rpx;
  font-weight: 700;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  background: #f7f9f8;
  border-radius: 10rpx;
}

.evidence-item {
  padding: 13rpx 5rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #e9edeb;
}

.evidence-item:last-child {
  border-right: 0;
}

.evidence-item text:first-child {
  color: #213129;
  font-size: 28rpx;
  font-weight: 700;
}

.evidence-item text:last-child {
  margin-top: 5rpx;
  color: #8a948f;
  font-size: 21rpx;
}

.date-line {
  margin-top: 12rpx;
  color: #7b8680;
  font-size: 23rpx;
}

.quantity-line > view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quantity-line view text:first-child {
  color: #26342c;
  font-size: 31rpx;
  font-weight: 700;
}

.quantity-line view text:last-child {
  margin-top: 4rpx;
  color: #929b96;
  font-size: 22rpx;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-list {
  gap: 10rpx;
}

.history-point {
  min-width: 138rpx;
  padding: 11rpx 12rpx;
  display: inline-flex;
  flex-direction: column;
  background: #f6f8f7;
  border-radius: 8rpx;
}

.history-point text:first-child {
  color: #7c8781;
  font-size: 22rpx;
}

.history-point text:last-child {
  margin-top: 4rpx;
  color: #27342d;
  font-size: 25rpx;
  font-weight: 600;
}

.data-quality {
  display: block;
  margin-top: 11rpx;
  color: #929b96;
  font-size: 22rpx;
}

.cause-tags {
  flex-wrap: wrap;
  gap: 9rpx;
}

.cause-tags text {
  padding: 5rpx 10rpx;
  color: #856d60;
  font-size: 22rpx;
  background: #faf3ef;
  border-radius: 7rpx;
}

.action-hint {
  display: block;
  margin-top: 13rpx;
  color: #68756e;
  font-size: 24rpx;
  line-height: 30rpx;
}

.detail-action {
  margin-top: 18rpx;
  height: 66rpx;
  color: #168360;
  font-size: 27rpx;
  line-height: 66rpx;
  text-align: center;
  background: #edf7f3;
  border-radius: 10rpx;
}

.empty-state,
.load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-state {
  padding: 110rpx 20rpx;
}

.empty-icon {
  width: 62rpx;
  height: 62rpx;
  color: #fff;
  font-size: 36rpx;
  line-height: 62rpx;
  text-align: center;
  background: #4ca87e;
  border-radius: 50%;
}

.empty-title,
.load-error-title {
  margin-top: 18rpx;
  color: #334038;
  font-size: 31rpx;
  font-weight: 650;
}

.empty-desc,
.load-error-desc {
  margin-top: 9rpx;
  color: #929b96;
  font-size: 25rpx;
}

.algorithm-note {
  padding: 24rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #a0a8a4;
  font-size: 22rpx;
  line-height: 29rpx;
}

.retry-button {
  margin-top: 24rpx;
  padding: 16rpx 50rpx;
  color: #fff;
  font-size: 28rpx;
  background: #178d68;
  border-radius: 10rpx;
}
