<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="输入菜品名" bindinput="onInput" />
  </view>
  
  <video
  src="https://grainservice.club:8443/nongxinle/userImage/assests/AAA_H264.mp4"
  autoplay
  loop
  muted
  show-center-play-btn="false"
  object-fit="contain"
  style="width: 150rpx; height: 150rpx;"
  bindtap="navigateToRecommend">
</video>



  <view wx:if="{{showOrder}}" class="order-popup">
    <view class="order-content">
      <text class="order-title">{{selectedDish}}</text>
      <button class="order-btn" bindtap="confirmOrder">确认下单</button>
      <button class="cancel-btn" bindtap="cancelOrder">取消</button>
    </view>
  </view>
</view>
