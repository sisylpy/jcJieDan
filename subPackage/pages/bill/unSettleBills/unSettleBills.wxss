.tab-bar {
  display: flex;
  height: 90rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666;
}

.tab-item.active {
  color: #147062;
  font-weight: bold;
  border-bottom: 4rpx solid #147062;
}

.unsettle-swiper {
  width: 100%;
}
