page { background: #f5f5f2; color: #26302f; }
.after-page { padding: 22rpx 24rpx 60rpx; box-sizing: border-box; }
.date-bar { display: flex; justify-content: center; align-items: center; gap: 20rpx; color: #5f6b69; font-size: 26rpx; margin-bottom: 20rpx; }
.date-bar picker { background: #fff; padding: 13rpx 22rpx; border-radius: 14rpx; }
.loading, .error-card, .empty-card { padding: 60rpx 24rpx; text-align: center; color: #7a8583; background: #fff; border-radius: 18rpx; }
.delivery-total-card { background: linear-gradient(135deg, #315f62, #477d78); color: #fff; border-radius: 22rpx; padding: 30rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.metric-label { font-size: 29rpx; }
.metric-number { font-size: 60rpx; line-height: 1; font-weight: 700; }
.metric-unit { font-size: 26rpx; }
.severity-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 16rpx; }
.severity-cell { background: #fff; border-radius: 16rpx; padding: 20rpx 8rpx; display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #6d7775; }
.severity-value { margin-top: 8rpx; font-size: 36rpx; font-weight: 700; color: #34413f; }
.severity-cell.light { border-bottom: 5rpx solid #b9c7a5; }
.severity-cell.medium { border-bottom: 5rpx solid #e0a84b; }
.severity-cell.serious { border-bottom: 5rpx solid #c94f43; }
.status-line { display: flex; justify-content: space-around; background: #fff; padding: 22rpx 10rpx; margin-top: 16rpx; border-radius: 16rpx; font-size: 25rpx; color: #57625f; }
.section-head { display: flex; justify-content: space-between; align-items: flex-end; margin: 32rpx 4rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-hint { font-size: 22rpx; color: #929a98; }
.case-card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; border-left: 7rpx solid #b9c7a5; }
.case-card.severity-medium { border-left-color: #e0a84b; }
.case-card.severity-serious { border-left-color: #c94f43; background: #fffaf9; }
.case-top, .case-bottom { display: flex; align-items: center; }
.case-top { justify-content: space-between; }
.case-customer { font-size: 31rpx; font-weight: 650; }
.severity-badge { font-size: 23rpx; padding: 6rpx 15rpx; border-radius: 20rpx; background: #f1f0ec; }
.severity-serious .severity-badge { background: #fde4df; color: #b83b30; }
.severity-medium .severity-badge { background: #fff0d4; color: #a86c16; }
.case-summary { margin: 18rpx 0; font-size: 27rpx; color: #4f5b58; line-height: 1.55; }
.case-bottom { gap: 16rpx; font-size: 23rpx; color: #78817f; }
.case-status { color: #315f62; font-weight: 600; }
.replenishment-tag { color: #a85a22; background: #fff0dc; border-radius: 16rpx; padding: 4rpx 12rpx; }
.case-time { margin-left: auto; }
