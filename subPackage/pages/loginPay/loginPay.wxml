<view class='flex-column'>



  <back-navbar style="height: {{navBarHeight}}rpx;" title="登录" avatar="/images/logo.jpg" button-text="设置" bindnavbuttontap="toBack"></back-navbar>
  
  <view class='flex-column p-20' style="margin-top: {{navBarHeight}}rpx;">

    <view class="flex-column center-content">
    <view class='word'>京采接单</view>
    <view class="small gray" style="margin-bottom: 40rpx;">专业配送商户专用版</view>
  </view>

   
    
    <!-- 登录按钮 -->
    <view class=' reg_btn  ' style="width: {{windowWidth - 40}}rpx;margin-top: 200rpx;">
     
     
      <button  class="addBtn"  bindtap="_login" plain='true' style="width: {{windowWidth - 80}}rpx;">登录</button>
  
    </view>
  </view>
</view>


<view class="overlay {{showSelect ? 'show' : 'hide'}}">

  <view class='popup p-30'>

      <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text> 请选择您的经营方式。</text>
        <view bindtap="closeType">
          <image src="../../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row p-10'>
        <radio-group class="radio-group" bindchange="radioChange" >
          <label class="radio" wx:for="{{items}}" wx:key="value">
            <radio value="{{item.name}}" checked="{{item.checked}}" />{{item.value}}
          </label>
        </radio-group>
      </view>
  </view>

</view>


<view class="overlay {{showMarket ? 'show' : 'hide'}}">
  <view class='popup'>
  <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text> 请选所在位置</text>
        <view bindtap="closeMarket">
          <image src="../../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row'>
        <radio-group class="radio-group" bindchange="radioChangeMarket" >
          <label class="radio" wx:for="{{itemsMarket}}" wx:key="value">
            <radio value="{{index}}" data-name="{{item.sysCmMarketName}}" checked="{{item.sysCityMarketId == marketId}}" />{{item.sysCmMarketName}}
          </label>
        </radio-group>
      </view>
  </view>

</view>