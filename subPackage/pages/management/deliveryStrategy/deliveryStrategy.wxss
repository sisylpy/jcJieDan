.delivery-page {
  min-height: 100vh;
  background: #f5f7f6;
}

.page-scroll {
  height: calc(100vh - 0rpx);
  box-sizing: border-box;
}

.hero-card {
  margin: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #12b96b 0%, #057a69 100%);
  box-shadow: 0 16rpx 42rpx rgba(7, 128, 88, 0.22);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.86);
}

.hero-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 26rpx;
}

.hero-stat {
  display: flex;
  align-items: baseline;
}

.hero-stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-stat-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-add-btn,
.empty-btn {
  margin: 0;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #087952;
  background: #fff;
}

.rule-list {
  padding: 0 24rpx;
}

.rule-card {
  margin-bottom: 24rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(32, 56, 48, 0.07);
}

.rule-main {
  display: flex;
  min-height: 182rpx;
  background: #fff;
}

.rule-left {
  width: 218rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(180deg, #f0fff7 0%, #f9fffb 100%);
}

.rule-fee {
  max-width: 190rpx;
  font-size: 48rpx;
  line-height: 1;
  color: #07875c;
  font-weight: 800;
  text-align: center;
  word-break: break-all;
}

.rule-fee-label {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #7a9188;
}

.rule-divider {
  width: 1rpx;
  margin: 22rpx 0;
  border-left: 2rpx dashed rgba(6, 128, 103, 0.24);
}

.rule-right {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}

.rule-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.rule-name-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.mode-badge {
  flex-shrink: 0;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 8rpx;
  line-height: 48rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #0ac06f, #047d69);
}

.rule-name {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  font-size: 31rpx;
  color: #27352f;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-summary {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #44514c;
  line-height: 1.45;
}

.rule-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.rule-tag {
  margin: 0 12rpx 10rpx 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #07875c;
  background: #e9f8f0;
}

.rule-remark {
  display: block;
  margin-top: 2rpx;
  font-size: 23rpx;
  color: #8a938f;
  line-height: 1.4;
}

.status-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-on {
  color: #08a858;
  background: #e8f9ef;
}

.status-off {
  color: #999;
  background: #f2f2f2;
}

.operate-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f2f2f2;
}

.operate-hint {
  font-size: 24rpx;
  color: #8a938f;
}

.operate-actions {
  display: flex;
  align-items: center;
}

.operate-link {
  margin-left: 32rpx;
  font-size: 28rpx;
  color: #07875c;
}

.operate-link.danger {
  color: #e54d42;
}

.empty-card {
  margin: 24rpx;
  padding: 70rpx 40rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(32, 56, 48, 0.06);
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  line-height: 96rpx;
  border-radius: 50%;
  color: #0a9d63;
  font-size: 36rpx;
  font-weight: 700;
  background: #eaf8f0;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  color: #27352f;
  font-weight: 700;
}

.empty-sub {
  display: block;
  margin: 14rpx 0 30rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #8a938f;
}

.empty-btn {
  color: #fff;
  background: #0abf6f;
}

.edit-card {
  margin: 24rpx;
  padding: 28rpx 26rpx 30rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(32, 56, 48, 0.08);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  color: #1d2f28;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #8a938f;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f2;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #27352f;
  font-weight: 600;
}

.picker-value,
.input {
  font-size: 28rpx;
  color: #27352f;
}

.picker-value {
  padding-right: 8rpx;
}

.input {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
}

.form-grid {
  display: flex;
  gap: 18rpx;
  margin: 22rpx 0;
}

.mini-field {
  flex: 1;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7faf8;
  box-sizing: border-box;
}

.mini-field.large {
  margin-top: 18rpx;
}

.mini-label {
  display: block;
  font-size: 24rpx;
  color: #7a8580;
}

.mini-input,
.mini-picker {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  color: #1d2f28;
  font-weight: 700;
}

.price-panel {
  padding: 24rpx;
  margin: 18rpx 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #f0fff7 0%, #ffffff 100%);
  border: 1rpx solid #d9f3e6;
}

.panel-title {
  font-size: 27rpx;
  color: #07875c;
  font-weight: 700;
}

.free-panel {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin: 18rpx 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #eefcf6 0%, #ffffff 100%);
  border: 1rpx solid #d9f3e6;
}

.free-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 24rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #0ac06f, #047d69);
}

.free-title {
  font-size: 30rpx;
  color: #1d2f28;
  font-weight: 700;
}

.free-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a938f;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f2;
}

.status-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a938f;
}

.btn-cancel,
.btn-save {
  flex: 1;
  margin: 0 8rpx;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 30rpx;
  border-radius: 18rpx;
}

.btn-cancel {
  background: #f2f4f3;
  color: #69736f;
}

.btn-save {
  background: #0abf6f;
  color: #fff;
}

.edit-actions {
  display: flex;
  margin-top: 28rpx;
}

.scroll-safe {
  height: 60rpx;
}
