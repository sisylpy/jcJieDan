<view class="flex flex-column height-100">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="修改商家信息" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


<view class="flex-column bg-white font-lg" >
 
<view class="">
  <image class=""  style="width: 100%; height: 360rpx;"  wx:if="{{url.length > 0}}" src="{{ src}}"></image>
</view>

<!-- aaa -->
<view class=" flex-row-reverse plr-20" style="margin-top:-110rpx;" bindtap="choiceImg">
  <view class="flex-column-center plr-20">
    <image src="../../../../images/photo-4.png" style="width: 100rpx;height: 100rpx; margin-top: 40rpx;"> </image>
  </view>
</view>



<view class="flex-column p-20">

  <view class="flex-row p-20">
    <text class=" text-secondary " style="width:200rpx;">店铺名称:</text>
    <input class="standardInput mainColor" value="{{disInfo.nxDistributerName}}" bindinput="getName"></input>
  </view>


  <!-- <view class="border-bottom flex-row-default p-20 ">
    <text class="five-weight " style="width:200rpx;">配送范围</text>
    <view class="flex-column">
      <view class="flex-row-between with-tbl-padding" wx:for="{{disInfo.nxDistributerServiceCityEntities}}" wx:for-item="city" wx:for-index="cityIndex" style="width: {{windowWidth - 300}}rpx;">
        <text class="mainColor">{{city.nxDsCityName}}</text>
        <view class="flex-row">
          <text>-</text>
          <text>+</text>
        </view>
      </view>
    </view>
  </view> -->


  <view class="flex-row-default p-20 ">
    <text class=" text-secondary" style="width:160rpx;">地址:</text>
    <textarea  class="mainColor" style="border: 1px solid lightgray; border-radius: 20rpx; padding: 20rpx 20rpx; " value="{{disInfo.nxDistributerAddress}}"  bindinput="getAddress"/>
  </view>
  <!-- <view class="flex-row p-20 " bind:tap="editPhone">
    <text class="text-secondary " style="width:200rpx;">手机号:</text>
    <text>{{disInfo.nxDistributerPhone}}</text>
  </view> -->
</view>

<view class="flex-row p-20 border-bottom" bind:tap="chooseLocation">
            <text class="mr-10 text-secondary">定位经纬度:</text>
            <view class="flex-row font-sl mainColor" wx:if="{{disInfo.nxDistributerLan !== null}}">
             <text>{{disInfo.nxDistributerLan}}</text>
             <text>{{disInfo.nxDistributerLun}}</text>
            </view>

          </view>


<view class="center-content " >
  <view class="flex-row p-30 {{canSave ? 'mainColor' : 'text-secondary'}}" bindtap="save">保存</view>

</view>


</view>

</view>