.store-img-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 1px dashed #ddd;
}

.placeholder-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  font-size: 26rpx;
  color: #999;
}
