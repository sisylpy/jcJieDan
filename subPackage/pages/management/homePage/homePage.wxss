.settings-page {
  min-height: 100vh;
  background: #f5f7f6;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.store-hero {
  position: relative;
  margin: 20rpx 24rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 14rpx 40rpx rgba(34, 55, 48, 0.08);
}

.store-cover {
  display: block;
  width: 100%;
  height: 310rpx;
  background: #eef2f0;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 170rpx;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.42));
  pointer-events: none;
}

.store-card {
  position: relative;
  padding: 24rpx;
  background: #fff;
}

.store-profile {
  display: flex;
  align-items: center;
}

.profile-avatar,
.avatar-placeholder {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: #e9f8f0;
  flex-shrink: 0;
}

.avatar-placeholder {
  line-height: 104rpx;
  text-align: center;
  font-size: 36rpx;
  color: #07875c;
  font-weight: 700;
}

.store-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.store-name {
  display: block;
  font-size: 38rpx;
  color: #1d2f28;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-user {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7a8580;
}

.edit-pill {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #07875c;
  background: #e9f8f0;
  font-size: 26rpx;
}

.store-img-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eef8f3, #f7faf8);
  border: 2rpx dashed #b9ded0;
  box-sizing: border-box;
}

.placeholder-title {
  font-size: 32rpx;
  color: #087952;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.placeholder-desc {
  font-size: 25rpx;
  color: #7a8580;
}

.info-card,
.section-card,
.quick-grid {
  margin: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(34, 55, 48, 0.06);
}

.info-card {
  padding: 8rpx 26rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f1;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  width: 150rpx;
  font-size: 25rpx;
  color: #8a938f;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  color: #26342f;
  font-weight: 600;
  line-height: 1.45;
}

.info-value.address {
  font-weight: 500;
  color: #52605b;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 8rpx;
}

.quick-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
}

.quick-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 12rpx;
}

.quick-item text {
  max-width: 150rpx;
  font-size: 23rpx;
  color: #27352f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-card {
  padding: 28rpx 24rpx 12rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  color: #1d2f28;
  font-weight: 800;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a938f;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.menu-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
  border-radius: 24rpx;
  background: #f7faf8;
}

.tile-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 16rpx;
}

.tile-title {
  font-size: 26rpx;
  color: #26342f;
  font-weight: 700;
}

.setting-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f2f1;
}

.setting-row.highlight {
  padding: 26rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  border-top: 0;
  background: linear-gradient(135deg, #f0fff7, #ffffff);
  border: 1rpx solid #d9f3e6;
}

.setting-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon-wrap.blue {
  background: #eaf7ff;
}

.setting-icon-wrap.green {
  background: #e9f8f0;
}

.setting-icon-wrap.cyan {
  background: #eef9f7;
}

.setting-icon-wrap.red {
  background: #fff0ed;
}

.setting-icon-wrap.amber {
  background: #fff2dc;
}

.setting-row.highlight.after-sales-entry {
  background: linear-gradient(135deg, #fff6f3, #ffffff);
  border-color: #f4d8d1;
}

.setting-row.highlight.compensation-entry {
  background: linear-gradient(135deg, #fff8ea, #ffffff);
  border-color: #f1dfbb;
}

.setting-row.highlight.announcement-entry {
  background: linear-gradient(135deg, #effaf5, #ffffff);
  border-color: #d2ecdf;
}

.setting-icon-letter {
  color: #07875c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.setting-icon {
  width: 42rpx;
  height: 42rpx;
}

.setting-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.setting-title {
  display: block;
  font-size: 30rpx;
  color: #1d2f28;
  font-weight: 800;
}

.setting-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8581;
  line-height: 1.42;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.compact-list {
  border-radius: 22rpx;
  overflow: hidden;
  background: #f8faf9;
}

.compact-row {
  display: flex;
  align-items: center;
  padding: 24rpx 18rpx;
  border-bottom: 1rpx solid #eef1ef;
}

.compact-row:last-child {
  border-bottom: 0;
}

.compact-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 20rpx;
}

.compact-title {
  flex: 1;
  font-size: 29rpx;
  color: #26342f;
  font-weight: 700;
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  padding-bottom: 12rpx;
}

.analysis-card {
  min-height: 176rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7faf8;
  box-sizing: border-box;
}

.analysis-icon {
  width: 48rpx;
  height: 48rpx;
}

.analysis-title {
  display: block;
  margin-top: 18rpx;
  font-size: 29rpx;
  color: #26342f;
  font-weight: 800;
}

.analysis-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a938f;
  line-height: 1.35;
}

.version-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 150rpx;
  color: #9aa29f;
  font-size: 26rpx;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 32rpx 24rpx 0;
  border: 1rpx solid #f0c8c4;
  border-radius: 22rpx;
  background: #fff;
  color: #cf3f37;
  font-size: 30rpx;
}

.hover {
  opacity: 0.72;
}
