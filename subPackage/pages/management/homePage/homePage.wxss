.settings-page {
  min-height: 100vh;
  background: #f5f7f6;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.section-card,
.quick-grid {
  margin: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(34, 55, 48, 0.06);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 8rpx;
}

.quick-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
}

.quick-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 12rpx;
}

.quick-item text {
  max-width: 150rpx;
  font-size: 23rpx;
  color: #27352f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-card {
  padding: 28rpx 24rpx 12rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  color: #1d2f28;
  font-weight: 800;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a938f;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.menu-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
  border-radius: 24rpx;
  background: #f7faf8;
}

.tile-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 16rpx;
}

.tile-title {
  font-size: 26rpx;
  color: #26342f;
  font-weight: 700;
}

.setting-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f2f1;
}

.setting-row.highlight {
  padding: 26rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  border-top: 0;
  background: linear-gradient(135deg, #f0fff7, #ffffff);
  border: 1rpx solid #d9f3e6;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.service-grid .setting-row.highlight {
  padding: 22rpx 18rpx;
  margin-bottom: 0;
}

.service-grid .setting-main {
  margin-left: 16rpx;
}

.service-grid .setting-title {
  font-size: 28rpx;
}

.service-grid .setting-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.service-grid .arrow-icon {
  width: 26rpx;
  height: 26rpx;
  margin-left: 10rpx;
}

.setting-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon-wrap.blue {
  background: #eaf7ff;
}

.setting-icon-wrap.green {
  background: #e9f8f0;
}

.setting-icon-wrap.cyan {
  background: #eef9f7;
}

.setting-icon-wrap.red {
  background: #fff0ed;
}

.setting-icon-wrap.amber {
  background: #fff2dc;
}

.setting-row.highlight.after-sales-entry {
  background: linear-gradient(135deg, #fff6f3, #ffffff);
  border-color: #f4d8d1;
}

.setting-row.highlight.compensation-entry {
  background: linear-gradient(135deg, #fff8ea, #ffffff);
  border-color: #f1dfbb;
}

.setting-row.highlight.announcement-entry {
  background: linear-gradient(135deg, #effaf5, #ffffff);
  border-color: #d2ecdf;
}

.setting-icon-letter {
  color: #07875c;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.anomaly-analysis-card {
  background: linear-gradient(145deg, #fff8f3, #ffffff);
  border: 1rpx solid #f0dfd3;
}

.anomaly-analysis-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #dc7f55, #cf5d4d);
  border-radius: 18rpx;
}

.setting-icon {
  width: 42rpx;
  height: 42rpx;
}

.setting-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.setting-title {
  display: block;
  font-size: 30rpx;
  color: #1d2f28;
  font-weight: 800;
}

.setting-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8581;
  line-height: 1.42;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.compact-list {
  border-radius: 22rpx;
  overflow: hidden;
  background: #f8faf9;
}

.compact-row {
  display: flex;
  align-items: center;
  padding: 24rpx 18rpx;
  border-bottom: 1rpx solid #eef1ef;
}

.compact-row:last-child {
  border-bottom: 0;
}

.compact-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 20rpx;
}

.compact-title {
  flex: 1;
  font-size: 29rpx;
  color: #26342f;
  font-weight: 700;
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  padding-bottom: 12rpx;
}

.analysis-card {
  min-height: 176rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7faf8;
  box-sizing: border-box;
}

.sales-analysis-card {
  background: linear-gradient(145deg, #edf9f3, #f8fcfa);
  border: 1rpx solid #cfe9da;
}

.smart-replenishment-card {
  background: linear-gradient(145deg, #eaf8f1, #f8fcfa);
  border: 1rpx solid #c5e7d5;
}

.smart-replenishment-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
  background: #0b8d52;
  border-radius: 13rpx;
}

.sales-analysis-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
  background: #109c5c;
  border-radius: 13rpx;
}

.analysis-icon {
  width: 48rpx;
  height: 48rpx;
}

.analysis-title {
  display: block;
  margin-top: 18rpx;
  font-size: 29rpx;
  color: #26342f;
  font-weight: 800;
}

.analysis-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a938f;
  line-height: 1.35;
}

.version-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 150rpx;
  color: #9aa29f;
  font-size: 26rpx;
}

.bottom-entry {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(34, 55, 48, 0.06);
}

.bottom-entry-icon {
  width: 54rpx;
  height: 54rpx;
}

.bottom-entry-title {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #1d2f28;
  font-weight: 700;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 32rpx 24rpx 0;
  border: 1rpx solid #f0c8c4;
  border-radius: 22rpx;
  background: #fff;
  color: #cf3f37;
  font-size: 30rpx;
}

.hover {
  opacity: 0.72;
}
.management-icon{display:flex;align-items:center;justify-content:center;background:#e8f6f2;color:#148b76;font-size:22rpx;font-weight:700;border-radius:6rpx}
