.settings-page {
  min-height: 100vh;
  background: #f3f6f5;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.quick-grid,
.business-section {
  margin: 20rpx;
  background: #fff;
  border: 1rpx solid #edf1ef;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 68, 53, 0.045);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding: 18rpx 6rpx;
}

.quick-item {
  min-width: 0;
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 10rpx;
}

.quick-item text {
  max-width: 126rpx;
  color: #65716c;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.business-section {
  padding: 22rpx 18rpx 18rpx;
}

.business-heading {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.heading-copy {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.heading-mark {
  width: 7rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: #12987c;
}

.heading-title {
  color: #172a24;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.heading-subtitle {
  margin-left: 24rpx;
  color: #8a9490;
  font-size: 22rpx;
}

.heading-link {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #168f78;
  font-size: 23rpx;
  font-weight: 650;
}

.business-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.two-column-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.business-tile {
  position: relative;
  min-width: 0;
  min-height: 146rpx;
  padding: 17rpx 8rpx 15rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(22, 143, 120, 0.08);
  border-radius: 19rpx;
  background: linear-gradient(145deg, #f1faf7, #fbfdfc);
}

.horizontal-tile {
  min-height: 122rpx;
  padding: 20rpx 24rpx;
  flex-direction: row;
  justify-content: flex-start;
}

.horizontal-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.business-icon-box {
  width: 57rpx;
  height: 57rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.72);
}

.business-icon {
  width: 43rpx;
  height: 43rpx;
  object-fit: contain;
}

.business-letter {
  color: #0b9270;
  font-size: 30rpx;
  font-weight: 850;
}

.business-title {
  display: block;
  max-width: 100%;
  margin-top: 11rpx;
  color: #1a2d27;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.18;
  text-align: center;
  word-break: break-all;
}

.business-desc {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  color: #7e8984;
  font-size: 19rpx;
  line-height: 1.28;
  text-align: center;
}

.horizontal-tile .business-title,
.horizontal-tile .business-desc {
  margin-top: 0;
  text-align: left;
}

.horizontal-tile .business-desc {
  margin-top: 6rpx;
}

.tone-green,
.tone-mint {
  background: linear-gradient(145deg, #edf9f5, #fbfdfc);
  border-color: #dcefe8;
}

.tone-blue {
  background: linear-gradient(145deg, #edf7ff, #fbfdff);
  border-color: #dceaf7;
}

.tone-orange {
  background: linear-gradient(145deg, #fff5e9, #fffdf9);
  border-color: #f5e4ce;
}

.tone-red {
  background: linear-gradient(145deg, #fff0f1, #fffafa);
  border-color: #f5dfe1;
}

.tone-amber {
  background: linear-gradient(145deg, #fff8e8, #fffdf7);
  border-color: #f4e6c8;
}

.tone-purple {
  background: linear-gradient(145deg, #f5f0ff, #fcfbff);
  border-color: #e8ddfa;
}

.tone-blue .business-letter { color: #337fe5; }
.tone-orange .business-letter { color: #f28c28; }
.tone-red .business-letter { color: #e84c57; }
.tone-purple .business-letter { color: #7553df; }

.pending-badge {
  position: absolute;
  top: -8rpx;
  right: -5rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  border-radius: 18rpx;
  background: #f13f3f;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
}

.logout-button {
  height: 86rpx;
  margin: 30rpx 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #efcfcb;
  border-radius: 20rpx;
  background: #fff;
  color: #cf433a;
  font-size: 28rpx;
}

.version-footer {
  height: 142rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a1aaa6;
  font-size: 23rpx;
}

.hover {
  opacity: 0.7;
  transform: scale(0.985);
}
