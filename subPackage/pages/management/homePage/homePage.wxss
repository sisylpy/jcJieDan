.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.profile-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 40rpx 20rpx 40rpx;
  min-height: 180rpx;
  box-sizing: border-box;
}

.profile-left {
  flex: 1;
  min-width: 0;
}

.profile-avatar {
  border-radius: 50%;
}

.profile-edit {
  flex-shrink: 0;
  padding-top: 60rpx;
}

.profile-info-block {
  margin-top: 20rpx;
}

.menu-section {
  position: relative;
  z-index: 2;
}

.menu-item {
  position: relative;
  z-index: 2;
}

.store-img-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 1px dashed #ddd;
}

.placeholder-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  font-size: 26rpx;
  color: #999;
}
