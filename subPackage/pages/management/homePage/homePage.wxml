<view class="settings-page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{userInfo.nxDistributerEntity.nxDistributerName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y="true" class="home-scroll">
    <view class="quick-grid">
      <view class="quick-item" bindtap="toStaff" hover-class="hover"><image src="../../../../images/user-group-2.png" class="quick-icon"></image><text>账号</text></view>
      <view class="quick-item" bindtap="toPayPageList" hover-class="hover"><image src="/images/contract-pay-history.png" class="quick-icon"></image><text>充值记录</text></view>
      <view class="quick-item" bindtap="toPayPage" data-type="0" hover-class="hover"><image src="/images/wallet.png" class="quick-icon"></image><text>流量 {{disInfo.nxDistributerBuyQuantity || 0}}点</text></view>
      <view class="quick-item" bindtap="editHome" hover-class="hover"><image src="/images/edit.png" class="quick-icon"></image><text>修改店铺</text></view>
      <view class="quick-item" bindtap="toPrinterSetting" hover-class="hover" wx:if="{{disInfo.machinePayList && disInfo.machinePayList.length > 0}}"><image src="{{userInfo.nxDiuPrintDeviceId !== -1 ? '../../../../images/print-7.png' : '../../../../images/print-3.png'}}" class="quick-icon"></image><text>{{userInfo.nxDiuPrintDeviceId == sysDeviceId ? 'PT-380' : '打印机'}}</text></view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">客户与销售</text><text class="heading-subtitle">管理客户、商品和协作伙伴</text></view></view>
      <view class="business-grid">
        <view class="business-tile tone-green" bindtap="toCustomer" hover-class="hover"><view class="business-icon-box"><image src="/images/dianpu.png" class="business-icon"></image></view><text class="business-title">客户</text><text class="business-desc">客户管理</text></view>
        <view class="business-tile tone-green" bindtap="toGoods" hover-class="hover"><view class="business-icon-box"><image src="/images/icons/icon_goods_active.png" class="business-icon"></image></view><text class="business-title">商品</text><text class="business-desc">商品管理</text></view>
        <view class="business-tile tone-blue" bindtap="toNxDisList" hover-class="hover" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}"><view class="business-icon-box"><image src="/images/gongyingshang.png" class="business-icon"></image></view><text class="business-title">协作伙伴</text><text class="business-desc">协作配送商</text></view>
        <view class="business-tile tone-amber" bindtap="toCustomerOrderAnomalies" hover-class="hover"><view class="business-icon-box"><image src="/images/warn-3.png" class="business-icon"></image></view><text class="business-title">订货异常</text><text class="business-desc">订货变化核查</text></view>
      </view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">采购管理</text><text class="heading-subtitle">采购执行与供应方管理</text></view></view>
      <view class="business-grid">
        <view class="business-tile tone-green pending-tile" bindtap="toPurchaseManagement" hover-class="hover"><view class="pending-badge" wx:if="{{purchasePendingCount > 0}}">{{purchasePendingCount > 99 ? '99+' : purchasePendingCount}}</view><view class="business-icon-box business-letter">采</view><text class="business-title">采购总览</text><text class="business-desc">采购概况与待处理</text></view>
        <view class="business-tile tone-green" bindtap="toPurchasePerformance" hover-class="hover" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}"><view class="business-icon-box business-letter">库</view><text class="business-title">库存经营</text><text class="business-desc">库存批次经营结果</text></view>
        <view class="business-tile tone-green" bindtap="toPurchaseBatchList" hover-class="hover"><view class="business-icon-box"><image src="/images/a-gouwuchejinhuocaigouhuo.png" class="business-icon"></image></view><text class="business-title">采购批次</text><text class="business-desc">批次管理</text></view>
        <view class="business-tile tone-blue" bindtap="toPurchaseSupplierList" hover-class="hover"><view class="business-icon-box"><image src="/images/supplier.png" class="business-icon"></image></view><text class="business-title">供应方</text><text class="business-desc">供应方管理</text></view>
        <view class="business-tile tone-green" bindtap="toPurchaserList" hover-class="hover"><view class="business-icon-box"><image src="/images/user-group-2.png" class="business-icon"></image></view><text class="business-title">采购员</text><text class="business-desc">采购员管理</text></view>
        <view class="business-tile tone-mint" bindtap="toSmartReplenishment" hover-class="hover" wx:if="{{canViewSmartReplenishment}}"><view class="business-icon-box business-letter">智</view><text class="business-title">智能备货</text><text class="business-desc">采购需求预测</text></view>
      </view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">库存管理</text><text class="heading-subtitle">库存批次与库房管理</text></view></view>
      <view class="business-grid two-column-grid">
        <view class="business-tile horizontal-tile tone-green" bindtap="toShelf" hover-class="hover" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}"><view class="business-icon-box"><image src="/images/Focus-Auto.png" class="business-icon"></image></view><view class="horizontal-copy"><text class="business-title">货架</text><text class="business-desc">货架与库位</text></view></view>
        <view class="business-tile horizontal-tile tone-green" bindtap="toStock" hover-class="hover"><view class="business-icon-box"><image src="/images/goods.png" class="business-icon"></image></view><view class="horizontal-copy"><text class="business-title">库存</text><text class="business-desc">当前库存查询</text></view></view>
      </view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">资金结算</text><text class="heading-subtitle">报销、结账与付款记录</text></view></view>
      <view class="business-grid">
        <view class="business-tile tone-orange" bindtap="toFinanceOverview" hover-class="hover"><view class="business-icon-box business-letter">¥</view><text class="business-title">资金总览</text><text class="business-desc">资金情况</text></view>
        <view class="business-tile tone-red" bindtap="toReimbursementList" hover-class="hover"><view class="business-icon-box"><image src="/images/user-group-2.png" class="business-icon"></image></view><text class="business-title">采购员报销</text><text class="business-desc">垫付与报销</text></view>
        <view class="business-tile tone-blue" bindtap="toSettlementList" hover-class="hover"><view class="business-icon-box"><image src="/images/contract-pay-history.png" class="business-icon"></image></view><text class="business-title">供应商结账</text><text class="business-desc">货款结算</text></view>
        <view class="business-tile tone-purple" bindtap="toPaymentList" hover-class="hover"><view class="business-icon-box"><image src="/images/pay-2.png" class="business-icon"></image></view><text class="business-title">付款记录</text><text class="business-desc">付款明细</text></view>
      </view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">配送管理</text><text class="heading-subtitle">派单与配送规则</text></view></view>
      <view class="business-grid two-column-grid">
        <view class="business-tile horizontal-tile tone-blue" bindtap="toDispatchPerformance" hover-class="hover"><view class="business-icon-box"><image src="/images/car.png" class="business-icon"></image></view><view class="horizontal-copy"><text class="business-title">派单管理</text><text class="business-desc">司机与路线</text></view></view>
        <view class="business-tile horizontal-tile tone-blue" bindtap="toDeliveryStrategy" hover-class="hover"><view class="business-icon-box"><image src="/images/car.png" class="business-icon"></image></view><view class="horizontal-copy"><text class="business-title">配送设置</text><text class="business-desc">配送与自提规则</text></view></view>
      </view>
    </view>

    <view class="business-section" wx:if="{{canViewSalesAnalysis || disInfo.nxDistributerBusinessTypeId > 2}}">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">经营分析</text><text class="heading-subtitle">经营数据与业务分析</text></view></view>
      <view class="business-grid">
        <view class="business-tile tone-green" bindtap="toMyPurchase" hover-class="hover"><view class="business-icon-box business-letter">看</view><text class="business-title">经营看板</text><text class="business-desc">整体经营情况</text></view>
        <view class="business-tile tone-orange" bindtap="toPurGoodsFenxi" hover-class="hover" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}"><view class="business-icon-box"><image src="/images/caigou2.png" class="business-icon"></image></view><text class="business-title">采购统计</text><text class="business-desc">采购数据分析</text></view>
        <view class="business-tile tone-purple" bindtap="toCostGoodsFenxi" hover-class="hover" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}"><view class="business-icon-box"><image src="/images/money-2.png" class="business-icon"></image></view><text class="business-title">库存分析</text><text class="business-desc">库存与损耗分析</text></view>
        <view class="business-tile tone-blue" bindtap="toSalesAnalysis" hover-class="hover" wx:if="{{canViewSalesAnalysis}}"><view class="business-icon-box business-letter">销</view><text class="business-title">销售分析</text><text class="business-desc">销售与客户贡献</text></view>
      </view>
    </view>

    <view class="business-section">
      <view class="business-heading"><view class="heading-copy"><view class="heading-mark"></view><text class="heading-title">店铺运营</text><text class="heading-subtitle">公告、售后与营销活动</text></view></view>
      <view class="business-grid">
        <view class="business-tile tone-green" bindtap="toAnnouncementBoard" hover-class="hover"><view class="business-icon-box"><image src="/images/edit-main.png" class="business-icon"></image></view><text class="business-title">公司公告牌</text><text class="business-desc">发布与查看</text></view>
        <view class="business-tile tone-red" bindtap="toAfterSales" hover-class="hover"><view class="business-icon-box"><image src="/images/warn-3.png" class="business-icon"></image></view><text class="business-title">售后问题</text><text class="business-desc">售后处理</text></view>
        <view class="business-tile tone-amber" bindtap="toCompensationCoupon" hover-class="hover"><view class="business-icon-box"><image src="/images/money-2.png" class="business-icon"></image></view><text class="business-title">补偿券</text><text class="business-desc">售后补偿</text></view>
        <view class="business-tile tone-purple" bindtap="toCoupon" hover-class="hover"><view class="business-icon-box"><image src="/images/money-2.png" class="business-icon"></image></view><text class="business-title">普通优惠券</text><text class="business-desc">营销活动</text></view>
      </view>
    </view>

    <view class="logout-button" bindtap="logoutOwner" hover-class="hover">退出当前账号</view>
    <view class="version-footer"><text>版本 3.0.7</text></view>
  </scroll-view>
</view>
