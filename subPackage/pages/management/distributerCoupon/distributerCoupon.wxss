.page-scroll {
  height: calc(100vh - 0rpx);
  box-sizing: border-box;
}
.coupon-item {
  background: #fff;
}
.status-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.status-on {
  color: #07c160;
  background: #e8f9ef;
}
.status-off {
  color: #999;
  background: #f2f2f2;
}
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}
.form-row {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.label {
  font-size: 30rpx;
  color: #333;
}
.picker-value {
  font-size: 30rpx;
  color: #333;
  padding-right: 10rpx;
}
.input {
  text-align: right;
  font-size: 30rpx;
  min-width: 200rpx;
}
.btn-cancel, .btn-save {
  flex: 1;
  margin: 0 10rpx;
  font-size: 30rpx;
  border-radius: 10rpx;
}
.btn-cancel {
  background: #f2f2f2;
  color: #666;
}
.btn-save {
  background: #07c160;
  color: #fff;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  background: #07c160;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.4);
  z-index: 10;
}
.flex-1 { flex: 1; }
.mt-10 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 40rpx; }
.text-danger { color: #e54d42; }
.operate-row { justify-content: space-between; }
.mr-40 { margin-right: 40rpx; }
.font-md { font-size: 32rpx; color: #333; }
