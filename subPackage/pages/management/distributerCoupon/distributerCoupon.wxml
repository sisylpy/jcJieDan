<view class="flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="优惠券" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y="true" class="page-scroll">
    <view class="bg-white" wx:if="{{list.length > 0}}">
      <view class="coupon-item" wx:for="{{list}}" wx:key="nxDistributerCouponId">
        <view class="flex-row-between p-20 border-bottom">
          <view class="flex-column flex-1">
            <text class="font-md">{{item.nxDistributerCouponName}}</text>
            <text class="font-sm text-secondary mt-10">{{item.typeText}}</text>
            <text class="font-sm text-secondary">{{item.descText}}</text>
            <text class="font-sm text-secondary">交付:{{item.applyDeliveryModeText}}  结算:{{item.applySettlementTypeText}}</text>
          </view>
          <view class="flex-row">
            <text class="status-tag {{item.nxDcStatus === 1 ? 'status-on' : 'status-off'}}">{{item.statusText}}</text>
          </view>
        </view>
        <view class="flex-row-between p-20 border-bottom operate-row">
          <switch checked="{{item.nxDcStatus === 1}}" bindchange="bindStatusChange" data-id="{{item.nxDistributerCouponId}}" color="#07c160"/>
          <view>
            <text class="mainColor mr-40" bindtap="toEdit" data-id="{{item.nxDistributerCouponId}}">编辑</text>
            <text class="text-danger" bindtap="deleteItem" data-id="{{item.nxDistributerCouponId}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <text class="text-secondary">暂无优惠券，点击下方按钮新增</text>
    </view>

    <view class="bg-white mt-10 p-30" wx:if="{{editing}}">
      <view class="font-lg mb-20">优惠券编辑</view>

      <view class="form-row flex-row-between">
        <text class="label">优惠券名称</text>
        <input class="input" value="{{formData.nxDistributerCouponName}}" bindinput="bindName" placeholder="如 满100减10"/>
      </view>

      <view class="form-row flex-row-between">
        <text class="label">优惠券类型</text>
        <picker mode="selector" range="{{typeTexts}}" value="{{typeIndex}}" bindchange="bindTypeChange">
          <view class="picker-value">{{typeTexts[typeIndex]}}</view>
        </picker>
      </view>

      <view class="form-row flex-row-between">
        <text class="label">门槛金额</text>
        <input class="input" type="digit" value="{{formData.nxDcSubtotalPrice}}" bindinput="bindSubtotal" placeholder="如 100"/>
      </view>

      <block wx:if="{{formData.nxDcType === 0}}">
        <view class="form-row flex-row-between">
          <text class="label">优惠金额</text>
          <input class="input" type="digit" value="{{formData.nxDcPrice}}" bindinput="bindPrice" placeholder="如 10"/>
        </view>
      </block>
      <block wx:else>
        <view class="form-row flex-row-between">
          <text class="label">折扣率(%)</text>
          <input class="input" type="digit" value="{{formData.nxDcPricePercent}}" bindinput="bindPercent" placeholder="如 90 表示9折"/>
        </view>
      </block>

      <view class="form-row flex-row-between">
        <text class="label">适用交付方式</text>
        <picker mode="selector" range="{{deliveryModeTexts}}" value="{{deliveryModeIndex}}" bindchange="bindDeliveryModeChange">
          <view class="picker-value">{{deliveryModeTexts[deliveryModeIndex]}}</view>
        </picker>
      </view>

      <view class="form-row flex-row-between">
        <text class="label">适用结算方式</text>
        <picker mode="selector" range="{{settlementTexts}}" value="{{settlementIndex}}" bindchange="bindSettlementChange">
          <view class="picker-value">{{settlementTexts[settlementIndex]}}</view>
        </picker>
      </view>

      <view class="flex-row-between mt-20">
        <button class="btn-cancel" bindtap="cancelEdit">取消</button>
        <button class="btn-save" bindtap="save">保存</button>
      </view>
    </view>
  </scroll-view>

  <view class="fab" bindtap="toAdd" wx:if="{{!editing}}">+ 新增</view>
</view>
