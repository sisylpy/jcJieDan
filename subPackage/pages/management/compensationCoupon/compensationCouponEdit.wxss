page { background: #f5f5f2; color: #273230; }
.edit-page { padding: 22rpx 24rpx 70rpx; box-sizing: border-box; }
.notice { padding: 20rpx 22rpx; border-radius: 16rpx; background: #fff1dc; color: #93602d; font-size: 24rpx; line-height: 1.55; }
.form-card { margin-top: 18rpx; padding: 26rpx; border-radius: 20rpx; background: #fff; }
.field-title { display: block; margin-top: 28rpx; font-size: 27rpx; font-weight: 650; }
.field-title:first-child { margin-top: 0; }
.form-card input, .form-card textarea, .picker-field { box-sizing: border-box; width: 100%; margin-top: 13rpx; padding: 18rpx; border-radius: 14rpx; background: #f5f6f4; font-size: 28rpx; }
.form-card textarea { height: 150rpx; }
.amount-input, .days-input { display: flex; align-items: center; margin-top: 13rpx; border-radius: 14rpx; background: #f5f6f4; }
.amount-input > text { padding-left: 20rpx; color: #34776d; font-size: 35rpx; font-weight: 700; }
.amount-input input, .days-input input { margin-top: 0; }
.days-input text { padding-right: 20rpx; color: #6f7976; }
.field-help { display: block; margin-top: 9rpx; color: #929a98; font-size: 22rpx; }
.picker-field { display: flex; align-items: center; justify-content: space-between; }
.picker-field text { color: #8a9391; font-size: 34rpx; }
.save-button { margin-top: 24rpx; background: #315f62; color: #fff; }
