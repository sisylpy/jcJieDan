page {
  background: #f4f7f6;
}

.staff-customers-page {
  height: 100vh;
  overflow: hidden;
  color: #20332e;
}

.staff-customers-body {
  box-sizing: border-box;
  height: 100vh;
}

.staff-customers-scroll {
  box-sizing: border-box;
  height: 100%;
}

.page-content {
  padding: 22rpx 22rpx calc(40rpx + env(safe-area-inset-bottom));
}

.staff-summary-card {
  display: flex;
  align-items: center;
  padding: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #087a60, #18a37f);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(16, 111, 88, 0.18);
}

.staff-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 20rpx;
  color: #087a60;
  font-size: 34rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
}

.staff-summary-main {
  min-width: 0;
}

.staff-name-row {
  display: flex;
  align-items: center;
}

.staff-name {
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 14rpx;
}

.staff-customer-count {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.assignment-note {
  margin: 18rpx 4rpx 0;
  color: #70847e;
  font-size: 22rpx;
  line-height: 1.6;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid #e0e9e6;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(30, 69, 59, 0.04);
}

.search-icon {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  height: 78rpx;
  font-size: 27rpx;
}

.search-placeholder {
  color: #a5b1ad;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  color: #879792;
  font-size: 34rpx;
}

.customer-list {
  margin-top: 20rpx;
}

.customer-card {
  margin-bottom: 18rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e1e9e6;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 69, 59, 0.06);
}

.customer-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf2f0;
}

.customer-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-right: 18rpx;
  color: #117b61;
  font-size: 29rpx;
  font-weight: 700;
  background: #e4f4ef;
  border-radius: 18rpx;
}

.customer-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.customer-name {
  overflow: hidden;
  color: #1c302b;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-address {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7d8d88;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-departments {
  margin-top: 7rpx;
  color: #159475;
  font-size: 21rpx;
}

.assignment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #edf2f0;
}

.assignment-label-wrap {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  margin-right: 20rpx;
}

.assignment-label {
  color: #3a504a;
  font-size: 26rpx;
  font-weight: 600;
}

.assignment-hint {
  margin-top: 3rpx;
  color: #9aa7a3;
  font-size: 19rpx;
}

.assignment-row picker {
  min-width: 0;
}

.assignment-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 390rpx;
  padding: 12rpx 16rpx;
  color: #13785f;
  font-size: 25rpx;
  background: #edf7f4;
  border-radius: 14rpx;
}

.assignment-picker text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 10rpx;
}

.customer-save-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
}

.change-status {
  color: #98a5a1;
  font-size: 21rpx;
}

.change-status.changed {
  color: #c77a12;
}

.save-assignment-button {
  min-width: 160rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 60rpx;
  background: #147062;
  border-radius: 30rpx;
}

.save-assignment-button::after {
  border: 0;
}

.save-assignment-button[disabled] {
  color: #9eaaa6;
  background: #e8edeb;
}

.state-card {
  margin-top: 22rpx;
  padding: 70rpx 24rpx;
  color: #82938e;
  font-size: 25rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #e1e9e6;
  border-radius: 22rpx;
}

.state-card.error {
  color: #ba5b4b;
}

.retry-text,
.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: #159475;
  font-size: 22rpx;
}

.empty-title {
  color: #657771;
  font-size: 27rpx;
  font-weight: 600;
}

.empty-desc {
  color: #97a5a1;
}

.page-bottom {
  height: 40rpx;
}
