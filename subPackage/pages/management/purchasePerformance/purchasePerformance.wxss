.page{height:100vh;background:#f4f7f6}.body{height:100%;box-sizing:border-box}.card{margin:20rpx;padding:24rpx;background:#fff;border-radius:20rpx}.tabs,.dates,.head{display:flex;justify-content:space-between;align-items:center}.tabs text{width:48%;text-align:center;padding:18rpx;background:#f3f5f4;border-radius:12rpx}.tabs .on{background:#15977f;color:white}.dates{padding-top:20rpx}.name{font-size:31rpx;font-weight:700}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:22rpx}.grid view{background:#f5faf8;padding:14rpx;border-radius:12rpx}.grid text{display:block;font-size:22rpx}.grid .metric-value{font-size:26rpx;font-weight:700;margin-top:6rpx}.sub{display:block;color:#7c8886;font-size:22rpx;margin:20rpx 0}.notice{margin:20rpx;padding:16rpx;border-radius:12rpx;background:#fff4df;color:#a96700;font-size:23rpx}.batch-list{white-space:nowrap}.batch-list text{display:inline-block;padding:10rpx 16rpx;margin-right:12rpx;background:#eef8f6;color:#168e7a;border-radius:10rpx}.state{text-align:center;padding:80rpx;color:#899491}
