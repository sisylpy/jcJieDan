page { background: #f3f8f6; color: #173d35; }
.page { min-height: 100vh; padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 60rpx; box-sizing: border-box; }
.balance-card, .offer-detail, .intro-card, .history-card, .empty-card { background: #fff; border: 1rpx solid #dcece6; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(20, 91, 70, .05); }
.balance-card { display: flex; justify-content: space-between; align-items: flex-end; padding: 30rpx; margin-top: 20rpx; background: linear-gradient(135deg, #eafff5, #f8fffc); }
.eyebrow { color: #668078; font-size: 24rpx; }
.balance { color: #059669; font-size: 56rpx; line-height: 1.2; font-weight: 700; margin-top: 8rpx; }
.balance text { font-size: 24rpx; font-weight: 500; }
.balance-meta { display: flex; flex-direction: column; align-items: flex-end; color: #789089; font-size: 22rpx; line-height: 1.7; }
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 8rpx 18rpx; }
.section-title > text:first-child { font-size: 34rpx; font-weight: 700; }
.section-note { color: #82948f; font-size: 22rpx; }
.offer-scroll { width: 100%; white-space: nowrap; }
.offer-row { display: inline-flex; padding: 2rpx 4rpx 12rpx; }
.offer-card { position: relative; width: 250rpx; min-height: 280rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-right: 18rpx; padding: 30rpx 18rpx 24rpx; border: 2rpx solid #d6e3df; border-radius: 22rpx; background: #fff; }
.offer-card.selected { border-color: #10a873; background: #f0fff8; box-shadow: 0 8rpx 22rpx rgba(16, 168, 115, .15); }
.activity-label { position: absolute; left: 16rpx; top: 14rpx; max-width: 210rpx; overflow: hidden; text-overflow: ellipsis; color: #087a55; font-size: 20rpx; background: #dff8ec; border-radius: 20rpx; padding: 6rpx 12rpx; }
.offer-quantity { margin-top: 28rpx; font-size: 34rpx; font-weight: 650; color: #173d35; }
.price { margin: 12rpx 0 4rpx; color: #ef3e2f; font-size: 50rpx; font-weight: 750; }
.price text { font-size: 28rpx; }
.original-price { color: #9ca9a5; font-size: 20rpx; text-decoration: line-through; }
.unit-price { color: #5d716b; font-size: 24rpx; margin-top: 6rpx; }
.bonus { color: #c66a0a; font-size: 21rpx; margin-top: 10rpx; }
.offer-detail { padding: 26rpx 28rpx; margin-top: 20rpx; }
.detail-line { display: flex; justify-content: space-between; color: #637b74; font-size: 26rpx; padding: 10rpx 0; }
.detail-line .strong { color: #078d62; font-weight: 700; }
.activity-copy { display: block; margin-top: 12rpx; padding: 16rpx; color: #7c5a1d; background: #fff8e6; border-radius: 12rpx; font-size: 23rpx; }
.purchase-button { margin-top: 24rpx; color: #fff; background: linear-gradient(90deg, #08a66e, #18bd82); border-radius: 16rpx; font-size: 30rpx; font-weight: 650; }
.purchase-button[disabled] { opacity: .6; }
.purchase-button::after { border: none; }
.intro-card { padding: 8rpx 28rpx; }
.intro-item { display: flex; flex-direction: column; padding: 24rpx 0; border-bottom: 1rpx solid #edf3f1; color: #637b74; font-size: 25rpx; line-height: 1.6; }
.intro-item:last-child { border-bottom: none; }
.intro-title { color: #173d35; font-size: 28rpx; font-weight: 650; margin-bottom: 5rpx; }
.history-card { padding: 0 28rpx; }
.history-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #edf3f1; }
.history-row:last-child { border-bottom: none; }
.history-copy { display: flex; flex-direction: column; color: #81918c; font-size: 22rpx; line-height: 1.6; }
.history-name { color: #274b42; font-size: 27rpx; font-weight: 600; }
.history-status { color: #9b7a35; font-size: 23rpx; background: #fff7dc; border-radius: 18rpx; padding: 7rpx 14rpx; }
.history-status.paid { color: #078d62; background: #e4faef; }
.empty-card { padding: 56rpx 24rpx; color: #8a9a95; text-align: center; font-size: 25rpx; }
.safe-tip { color: #8b9a96; font-size: 22rpx; text-align: center; line-height: 1.6; margin: 30rpx 16rpx 0; }
