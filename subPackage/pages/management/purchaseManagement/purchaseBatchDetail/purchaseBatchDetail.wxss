@import "../common.wxss";
.summary-card,.context-card,.section-card,.data-note{background:#fff;border:1rpx solid #e0e8e5;margin-bottom:12rpx;padding:18rpx}.summary-head,.summary-amount,.progress-row,.goods-head,.source-toggle,.stock-entry{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.purpose-badge{font-size:20rpx;color:#116f61;background:#e8f5f1;padding:4rpx 8rpx}.purpose-badge.warn{color:#936119;background:#fff4df}.batch-number,.summary-meta,.goods-date,.goods-spec,.field-label,.source-entry,.stock-meta,.data-note{font-size:21rpx;color:#71807c}
.summary-title{display:block;font-size:31rpx;font-weight:700;color:#24312f;margin-top:15rpx}.summary-meta{display:block;margin-top:8rpx}.summary-amount{padding:16rpx 0;border-bottom:1rpx solid #edf1ef;font-size:23rpx;color:#65736f}
.amount-value{font-size:32rpx;font-weight:700;color:#d55b31}.amount-pending{color:#9a6b25}.progress-row{padding-top:14rpx;font-size:23rpx}.progress-value{color:#147967}.role-note{display:block;margin-top:10rpx;color:#7d6a47;font-size:21rpx;line-height:1.45}
.confirm-button{display:block;margin-top:14rpx;background:#15806d;color:#fff;text-align:center;padding:14rpx;font-size:24rpx}.notice{margin-top:12rpx;padding:10rpx 12rpx;background:#fff8ea;color:#8a5a13;font-size:21rpx;line-height:1.45}
.context-title,.section-title,.note-title{display:block;font-size:27rpx;font-weight:650;color:#26342f}.context-text{display:block;margin-top:8rpx;font-size:22rpx;color:#687772;line-height:1.5}.goods-row{padding:18rpx 0;border-bottom:1rpx solid #e9efed}.goods-row:last-child{border-bottom:0}
.goods-name{font-size:28rpx;font-weight:650;color:#26342f}.goods-spec{display:block;margin-top:5rpx}.quantity-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx 22rpx;margin-top:16rpx}.field-label,.field-value{display:block}.field-value{font-size:24rpx;color:#2e3d39;margin-top:5rpx}.amount-inline{color:#d55b31;font-weight:650}
.source-status{display:block;margin-top:14rpx;color:#147967;font-size:22rpx}.warn-text{color:#9b6220}.source-toggle{border-top:1rpx solid #edf1ef;margin-top:14rpx;padding-top:12rpx;color:#147967;font-size:22rpx}.source-panel{background:#f7faf9;margin-top:10rpx;padding:12rpx}.source-empty{font-size:21rpx;color:#7a8783}
.source-entry{display:flex;flex-direction:column;gap:5rpx;padding:10rpx 0;border-bottom:1rpx solid #e4ebe8}.source-entry:last-child{border-bottom:0}.source-name{font-size:23rpx;font-weight:650;color:#33433e;margin-right:10rpx}.source-kind{font-size:19rpx;color:#147967;background:#e8f5f1;padding:3rpx 6rpx}
.stock-entry{padding:15rpx 0;border-bottom:1rpx solid #edf1ef}.stock-entry:last-child{border-bottom:0}.stock-name,.stock-meta{display:block}.stock-name{font-size:24rpx;color:#2e3d39}.stock-meta{margin-top:5rpx}.stock-link{color:#147967;font-size:22rpx}
.data-note{color:#74817d;line-height:1.55}.data-note text{display:block;margin-top:7rpx}.data-note .note-title{margin-top:0;color:#41504c}.detail-state{text-align:center;color:#75827f;padding:120rpx 20rpx}.detail-state text{display:block}.error-detail{font-size:21rpx;margin:12rpx 0 22rpx}.retry-button{display:inline-block!important;background:#15806d;color:#fff;padding:11rpx 22rpx;font-size:23rpx}.inline-empty{text-align:center;color:#7f8c88;padding:60rpx 0}
