<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购批次详情" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
    <view wx:if="{{loading}}" class="pm-state">正在加载…</view><view wx:elif="{{error}}" class="pm-state">{{error}}</view>
    <block wx:else>
      <view class="pm-card"><view class="pm-row"><text class="pm-name">{{detail.batchNumber}}</text><text class="pm-badge {{detail.hasException?'warn':''}}">{{detail.dataCompletenessText}}</text></view><text class="pm-muted">业务日期 {{detail.businessDate}} · 到货 {{detail.arrivalDate||'未设置'}}</text><view class="pm-line"><text>负责人</text><text>{{detail.purchaserName||'待分配'}}</text></view><view class="pm-line"><text>供应商</text><text>{{detail.supplierName||'自采/无固定供应商'}}</text></view><view class="pm-line"><text>采购方式</text><text>{{detail.procurementModeText}}</text></view><view class="pm-line"><text>供货商收单</text><text>{{detail.supplierOrderReceiptStatusText}}</text></view><view class="pm-line"><text>执行 / 买方收货 / 入库</text><text>{{detail.executionStatusText}} / {{detail.receiptStatusText}} / {{detail.putawayStatusText}}</text></view><text class="pm-muted">创建 {{detail.createdTime}} · 最后事实 {{detail.lastUpdatedAt}}</text></view>
      <view class="pm-card"><text class="pm-section-title">金额与经营</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">预计金额</text><text>¥{{detail.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际收货</text><text>{{detail.actualReceiptAmount==null?'—':'¥'}}{{detail.actualReceiptAmount}}</text></view><view class="pm-metric"><text class="pm-label">退货 / 实际净额</text><text>{{detail.supplierReturnAmount==null?'—':'¥'}}{{detail.supplierReturnAmount}} / {{detail.actualNetPurchaseAmount==null?'—':'¥'}}{{detail.actualNetPurchaseAmount}}</text></view><view class="pm-metric"><text class="pm-label">损耗 / 废弃</text><text>{{detail.lossQuantity==null?'—':detail.lossQuantity}} / {{detail.discardQuantity==null?'—':detail.discardQuantity}}</text></view><view class="pm-metric"><text class="pm-label">降价数量 / 影响</text><text>{{detail.markdownQuantity==null?'—':detail.markdownQuantity}} / {{detail.markdownImpact==null?'—':'¥'}}{{detail.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">当前 / 最终毛利</text><text>{{detail.currentRealizedMargin==null?'—':'¥'}}{{detail.currentRealizedMargin}} / {{detail.finalMargin==null?'—':'¥'}}{{detail.finalMargin}}</text></view></view><text class="pm-muted">{{detail.businessStatusText}} · 数量 {{detail.quantityConservedText||'历史不可判断'}}</text></view>
      <view class="pm-card"><text class="pm-section-title">商品明细</text><view wx:if="{{!detail.lines.length}}" class="pm-state">暂无商品明细</view><view class="goods" wx:for="{{detail.lines}}" wx:key="purchaseGoodsId"><text class="pm-name">{{item.displayName}}</text><text class="pm-muted">{{item.demandSourceText}} · {{item.procurementModeText}} · {{item.fulfillmentModeText}}</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">计划数量 / 单位</text><text>{{item.plannedQuantity}} {{item.purchaseUom}}</text></view><view class="pm-metric"><text class="pm-label">预计单价 / 金额</text><text>¥{{item.expectedPrice}} / ¥{{item.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">送达 / 接受 / 拒收</text><text>{{item.deliveredQuantity}} / {{item.acceptedQuantity}} / {{item.rejectedQuantity}}</text></view><view class="pm-metric"><text class="pm-label">最终采购价</text><text>{{item.finalPurchaseUnitPrice==null?'—':'¥'}}{{item.finalPurchaseUnitPrice}}</text></view><view class="pm-metric"><text class="pm-label">收货 / 退货 / 净额</text><text>{{item.actualReceiptAmount==null?'—':'¥'}}{{item.actualReceiptAmount}} / {{item.supplierReturnAmount==null?'—':'¥'}}{{item.supplierReturnAmount}} / {{item.actualNetPurchaseAmount==null?'—':'¥'}}{{item.actualNetPurchaseAmount}}</text></view><view class="pm-metric" wx:if="{{item.fulfillmentMode==='WAREHOUSE_STOCK'}}"><text class="pm-label">入库 / 剩余</text><text>{{item.stockInQuantity}} / {{item.remainingQuantity}}</text></view><view class="pm-metric" wx:if="{{item.fulfillmentMode==='WAREHOUSE_STOCK'}}"><text class="pm-label">损耗 / 废弃 / 调价</text><text>{{item.lossQuantity}} / {{item.discardQuantity}} / {{item.priceVersionCount}}</text></view><view class="pm-metric"><text class="pm-label">销售收入 / 毛利</text><text>{{item.salesRevenue==null?'—':'¥'}}{{item.salesRevenue}} / {{item.currentRealizedMargin==null?'—':'¥'}}{{item.currentRealizedMargin}}</text></view></view><text class="pm-muted status">{{item.receiptStatusText}} / {{item.putawayStatusText}} · {{item.businessStatusText}} · {{item.dataCompletenessText}}</text></view></view>
      <view class="pm-card" wx:if="{{detail.stockBatches.length}}"><text class="pm-section-title">关联库存批次</text><view class="entry pm-row" wx:for="{{detail.stockBatches}}" wx:key="stockBatchId" data-id="{{item.stockBatchId}}" bindtap="openStock"><view><text class="pm-name">{{item.displayName}}</text><text class="pm-muted">入库 {{item.stockInQuantity}} {{item.baseUom}} · 剩余 {{item.remainingQuantity}}</text></view><text class="pm-link">库存经营 ›</text></view></view>
      <view class="pm-card"><text class="pm-section-title">完整时间线</text><view wx:if="{{!detail.timeline.length}}" class="pm-state">暂无新事实时间线</view><view class="pm-timeline"><view class="pm-event" wx:for="{{detail.timeline}}" wx:key="index"><text class="pm-name">{{item.title}}</text><text class="pm-muted">{{item.eventTime||'时间未记录'}} · {{item.eventType}}</text></view></view></view>
    </block>
  </scroll-view>
</view>
