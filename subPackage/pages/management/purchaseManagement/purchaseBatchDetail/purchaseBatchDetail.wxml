<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购批次详情" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
    <view wx:if="{{loading}}" class="detail-state">正在加载…</view>
    <view wx:elif="{{error}}" class="detail-state error-state"><text>采购批次详情加载失败</text><text class="error-detail">{{error}}</text><text class="retry-button" bindtap="retry">重新加载</text></view>
    <block wx:else>
      <view class="summary-card">
        <view class="summary-head"><text class="purpose-badge {{detail.purchasePurpose==='UNRESOLVED'?'warn':''}}">{{detail.purchasePurposeText}}</text><text class="batch-number">{{detail.batchNumber}}</text></view>
        <text class="summary-title">{{detail.supplierName||detail.purchaseKindText}}</text>
        <text class="summary-meta">业务日期 {{detail.businessDate}} · {{detail.goodsLineCount}}条商品记录</text>
        <view class="summary-amount"><text>{{detail.supplyAmountLabel}}</text><text wx:if="{{detail.recognizedSupplyAmount!=null}}" class="amount-value">¥{{detail.recognizedSupplyAmount}}</text><text wx:else class="amount-pending">{{detail.supplyAmountStatus==='UNRESOLVED'?'金额待核对':'金额尚未形成'}}</text></view>
        <view wx:if="{{detail.supplyAmountStatus==='PARTIAL'}}" class="notice">部分商品金额待核对，以上仅合计已识别金额</view>
        <view wx:if="{{detail.purchasePurpose==='UNRESOLVED'}}" class="notice">采购用途来源不完整，以下仅展示当前能够核实的业务记录</view>
        <view class="progress-row"><text>当前进度</text><text class="progress-value">{{detail.businessProgressText}}</text></view>
        <text wx:if="{{detail.buyerConfirmationRequired&&detail.purchasePurpose==='CUSTOMER_ORDER'}}" class="role-note">{{detail.buyerConfirmationRoleText}}</text>
        <text wx:if="{{detail.buyerConfirmationRequired&&detail.purchasePurpose==='CUSTOMER_ORDER'}}" class="confirm-button" bindtap="openBuyerConfirmation">前往精彩订货确认供货信息</text>
        <text wx:if="{{detail.inventoryReceiptRequired&&detail.purchasePurpose==='INVENTORY_REPLENISHMENT'}}" class="role-note">{{detail.inventoryReceiptRoleText}}</text>
        <text wx:if="{{detail.inventoryReceiptRequired&&detail.purchasePurpose==='INVENTORY_REPLENISHMENT'}}" class="confirm-button" bindtap="openInventoryReceipt">前往精彩订货库存备货接收</text>
      </view>

      <view wx:if="{{detail.purchasePurpose==='CUSTOMER_ORDER'}}" class="context-card"><text class="context-title">为客户订单采购</text><text class="context-text" wx:if="{{detail.customerCount}}">关联{{detail.customerCount}}个客户：{{detail.customerNamesText}}</text><text class="context-text" wx:else>尚未取得可核对的客户订单关联</text></view>
      <view wx:elif="{{detail.purchasePurpose==='INVENTORY_REPLENISHMENT'}}" class="context-card"><text class="context-title">用于库存备货</text><text class="context-text">这里只展示真实采购与供货信息；存在已确认库存记录时，可在下方查看。</text></view>

      <view class="section-card">
        <text class="section-title">商品明细</text>
        <view wx:if="{{!detail.lines.length}}" class="inline-empty">暂无商品明细</view>
        <view class="goods-row" wx:for="{{detail.lines}}" wx:key="purchaseGoodsId">
          <view class="goods-head"><text class="goods-name">{{item.goodsName||item.displayName}}</text><text class="goods-date">{{item.purchaseDate||detail.businessDate}}</text></view>
          <text wx:if="{{item.purchaseUom}}" class="goods-spec">规格/单位 {{item.purchaseUom}}</text>
          <view class="quantity-grid">
            <view><text class="field-label">订购数量</text><text class="field-value">{{item.plannedQuantity==null?'—':item.plannedQuantity}}{{item.purchaseUom||''}}</text></view>
            <view><text class="field-label">{{item.procurementMode==='SELF_BUY'?'实际采购数量':(item.purchasePurpose==='CUSTOMER_ORDER'?'供应方填报数量':'采购来源数量')}}</text><text class="field-value">{{item.sourceQuantity==null?'—':item.sourceQuantity}}{{item.sourceUom||item.purchaseUom||''}}</text></view>
            <view><text class="field-label">{{item.procurementMode==='SELF_BUY'?'采购单价':'供货单价'}}</text><text class="field-value">{{item.sourceUnitPrice==null?'—':'¥'+item.sourceUnitPrice+(item.sourceUom?'/'+item.sourceUom:'')}}</text></view>
            <view><text class="field-label">{{item.procurementMode==='SELF_BUY'?'采购小计':'供货小计'}}</text><text class="field-value amount-inline">{{item.sourceSubtotal==null?'—':'¥'+item.sourceSubtotal}}</text></view>
          </view>
          <text class="source-status {{item.sourceFactStatus==='MISSING'?'warn-text':''}}">{{item.sourceFactStatusText}}</text>
          <view wx:if="{{item.purchasePurpose==='CUSTOMER_ORDER'}}" class="source-toggle" data-id="{{item.purchaseGoodsId}}" bindtap="toggleSource"><text>订单来源</text><text>{{item.sourceExpanded?'收起⌃':'展开⌄'}}</text></view>
          <view wx:if="{{item.sourceExpanded}}" class="source-panel">
            <view wx:if="{{!item.orderSources.length}}" class="source-empty">未取得可核对的客户订单主键</view>
            <view class="source-entry" wx:for="{{item.orderSources}}" wx:for-item="source" wx:key="orderId"><view><text class="source-name">{{source.customerName}}</text><text class="source-kind">{{source.orderSource==='HISTORY'?'历史订单':'当前订单'}}</text></view><text>客户订单号 {{source.orderId}}</text><text>商品记录编号 {{source.purchaseGoodsId}}</text><text wx:if="{{source.orderQuantity}}">订购数量 {{source.orderQuantity}}</text><text wx:if="{{source.orderActualQuantity}}">订单实际数量 {{source.orderActualQuantity}}</text></view>
          </view>
        </view>
      </view>

      <view class="section-card" wx:if="{{detail.purchasePurpose==='INVENTORY_REPLENISHMENT'&&detail.stockBatches.length}}"><text class="section-title">关联库存记录</text><view class="stock-entry" wx:for="{{detail.stockBatches}}" wx:key="stockBatchId" data-id="{{item.stockBatchId}}" bindtap="openStock"><view><text class="stock-name">{{item.displayName}}</text><text class="stock-meta">记录数量 {{item.stockInQuantity}} {{item.baseUom}}</text></view><text class="stock-link">查看库存记录 ›</text></view></view>

      <view class="data-note"><text class="note-title">数据说明</text><text>供货金额来自采购商品中的供货数量、单价和小计；金额可识别不代表已经付款。</text><text wx:if="{{detail.purchasePurpose==='CUSTOMER_ORDER'}}">客户订单订货不经过配送商采购收货和入库，本页不会显示相关状态。</text><text wx:if="{{detail.purchasePurpose==='INVENTORY_REPLENISHMENT'}}">未出现库存记录只表示当前未查询到已确认记录，不据此判断“未收货”。</text></view>
    </block>
  </scroll-view>
</view>
