<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购员" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" scroll-top="{{scrollTop}}" bindscroll="recordScroll" bindscrolltolower="more">
    <view class="toolbar">
      <view class="date-line">
        <picker mode="date" value="{{startDate}}" bindchange="changeStart"><text class="pm-date">{{startDate}}</text></picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{stopDate}}" bindchange="changeStop"><text class="pm-date">{{stopDate}}</text></picker>
      </view>
      <view class="search-line">
        <input value="{{keyword}}" placeholder="搜索采购员姓名" confirm-type="search" bindinput="input" bindconfirm="search"></input>
        <text class="search-button" bindtap="search">搜索</text>
      </view>
      <view class="filter-line">
        <view class="pm-tabs status-tabs">
          <text class="pm-tab {{!purchaserStatus?'on':''}}" data-value="" bindtap="chooseStatus">全部人员</text>
          <text class="pm-tab {{purchaserStatus==='CURRENT'?'on':''}}" data-value="CURRENT" bindtap="chooseStatus">当前人员</text>
          <text class="pm-tab {{purchaserStatus==='HISTORICAL'?'on':''}}" data-value="HISTORICAL" bindtap="chooseStatus">历史人员</text>
        </view>
        <picker mode="selector" range="{{sortOptions}}" range-key="name" value="{{sortIndex}}" bindchange="changeSort">
          <text class="sort-picker">{{sortOptions[sortIndex].name}}⌄</text>
        </picker>
      </view>
    </view>

    <view wx:if="{{error}}" class="pm-state error-state">
      <text>{{error}}</text><text class="retry" bindtap="retry">重新加载</text>
    </view>
    <view wx:elif="{{!loading&&!items.length}}" class="pm-state">没有符合条件的采购员</view>

    <view class="person-card" wx:for="{{items}}" wx:key="purchaserUserId" data-id="{{item.purchaserUserId}}" bindtap="open">
      <view class="person-head">
        <view class="identity">
          <image class="avatar" src="{{item.avatarUrl||'/images/user.png'}}"></image>
          <view>
            <view><text class="pm-name">{{item.purchaserName||('历史采购员 #'+item.purchaserUserId)}}</text><text class="pm-badge status-badge">{{item.purchaserStatusText}}</text></view>
            <text class="pm-muted">{{item.accountStatusText}}</text>
          </view>
        </view>
        <text class="pm-link">详情 ›</text>
      </view>

      <view wx:if="{{item.currentTaskCount}}" class="task-line">
        <text class="task-main">当前 {{item.currentTaskCount}} 项任务</text>
        <text wx:if="{{item.actionRequiredTaskCount}}" class="task-attention">待本人处理 {{item.actionRequiredTaskCount}}</text>
        <text wx:if="{{item.waitingSupplierTaskCount}}" class="task-wait">等待供应商 {{item.waitingSupplierTaskCount}}</text>
      </view>
      <view wx:else class="no-task">当前无待处理任务</view>

      <view class="period-line">
        <view><text class="pm-label">本期采购记录</text><text class="period-value">{{item.periodPurchaseRecordCount||0}} 条</text></view>
        <view class="amount-block"><text class="pm-label">本期采购金额</text><text class="period-money">{{item.periodPurchaseAmount==null?'—':'¥'+item.periodPurchaseAmount}}</text></view>
      </view>
      <text wx:if="{{item.periodUnresolvedAmountCount}}" class="amount-note">另有 {{item.periodUnresolvedAmountCount}} 条采购记录金额尚未形成</text>
      <text wx:elif="{{!item.periodPurchaseFactCount}}" class="pm-muted">所选日期内暂无采购记录</text>
      <text wx:else class="pm-muted">最近采购 {{item.periodLastPurchaseDate||item.lastPurchaseDate||'日期待核对'}}</text>
    </view>

    <view wx:if="{{loading}}" class="pm-state">正在加载…</view>
  </scroll-view>
</view>
