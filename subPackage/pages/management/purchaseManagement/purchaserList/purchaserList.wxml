<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购员" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
<view class="pm-tabs sort"><text class="pm-tab {{sort==='LAST_PURCHASE'?'on':''}}" data-value="LAST_PURCHASE" bindtap="sort">最近采购</text><text class="pm-tab {{sort==='NET_AMOUNT'?'on':''}}" data-value="NET_AMOUNT" bindtap="sort">净采购金额</text><text class="pm-tab {{sort==='LOSS_RATE'?'on':''}}" data-value="LOSS_RATE" bindtap="sort">损耗率</text></view>
<view wx:if="{{error}}" class="pm-state">{{error}}</view><view wx:if="{{!loading&&!items.length&&!error}}" class="pm-state">当前范围暂无采购员数据</view>
<view class="pm-card" wx:for="{{items}}" wx:key="purchaserUserId" data-id="{{item.purchaserUserId}}" bindtap="open"><view class="pm-row"><view class="identity"><image class="avatar" src="{{item.avatarUrl||'/images/user.png'}}"></image><view><text class="pm-name">{{item.purchaserName||'历史账号'}}</text><view><text class="pm-badge">{{item.purchaserStatusText}}</text> <text class="pm-badge {{item.accountStatus==='ACTIVE'?'':'warn'}}">{{item.accountStatusText}}</text></view></view></view><text class="pm-link">详情 ›</text></view><view class="pm-grid"><view class="pm-metric"><text class="pm-label">待采购 / 采购中</text><text>{{item.pendingGoodsLineCount||0}} / {{item.purchasingBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">部分收货 / 完结</text><text>{{item.partiallyReceivedBatchCount||0}} / {{item.completedBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">实际净采购</text><text class="pm-money">{{item.actualNetPurchaseAmount==null?'—':'¥'}}{{item.actualNetPurchaseAmount}}</text></view><view class="pm-metric"><text class="pm-label">退货金额 / 拒收率</text><text>{{item.supplierReturnAmount==null?'—':'¥'}}{{item.supplierReturnAmount}} / {{item.rejectionRate==null?'—':item.rejectionRate}}</text></view><view class="pm-metric"><text class="pm-label">损耗率 / 责任损耗率</text><text>{{item.lossRate==null?'—':item.lossRate}} / {{item.purchaserResponsibilityLossRate==null?'—':item.purchaserResponsibilityLossRate}}</text></view><view class="pm-metric"><text class="pm-label">当前 / 最终毛利</text><text>{{item.currentRealizedMargin==null?'—':'¥'}}{{item.currentRealizedMargin}} / {{item.completedFinalMargin==null?'—':'¥'}}{{item.completedFinalMargin}}</text></view></view><text class="pm-muted">{{item.dataCompletenessText}} · 有效 {{item.effectiveBatchCount||0}}/{{item.totalBatchCount||0}} · 覆盖率 {{item.dataCoverageRate}} · 最后采购 {{item.lastPurchaseDate||'—'}}</text></view><view wx:if="{{loading}}" class="pm-state">正在加载…</view>
</scroll-view></view>
