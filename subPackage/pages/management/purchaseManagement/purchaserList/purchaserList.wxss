@import "../common.wxss";
.toolbar{background:#fff;border:1rpx solid #e1e9e6;margin-bottom:14rpx;padding:14rpx}.date-line,.search-line,.filter-line,.person-head,.period-line{display:flex;align-items:center}.date-line{gap:10rpx;margin-bottom:12rpx}.date-separator{color:#60706b;font-size:23rpx}.search-line{border:1rpx solid #dce6e2;margin-bottom:12rpx}.search-line input{flex:1;height:68rpx;padding:0 16rpx;font-size:24rpx}.search-button{height:68rpx;line-height:68rpx;padding:0 22rpx;background:#157f6d;color:#fff;font-size:24rpx}.filter-line{justify-content:space-between;gap:12rpx}.status-tabs{margin:0;flex:1}.sort-picker{display:block;border:1rpx solid #dce6e2;padding:10rpx 14rpx;font-size:23rpx;color:#42635b;background:#fff}.person-card{background:#fff;border:1rpx solid #e1e9e6;margin-bottom:12rpx;padding:18rpx 20rpx}.person-head{justify-content:space-between}.identity{display:flex;align-items:center;min-width:0}.avatar{width:62rpx;height:62rpx;border-radius:50%;background:#eef3f1;margin-right:14rpx}.status-badge{margin-left:10rpx}.task-line{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;margin-top:18rpx;padding:14rpx 0;border-top:1rpx solid #edf1ef;border-bottom:1rpx solid #edf1ef}.task-main{font-size:26rpx;font-weight:650;color:#126f60}.task-attention,.task-wait{font-size:21rpx;padding:4rpx 9rpx}.task-attention{background:#fff1df;color:#a45e00}.task-wait{background:#eef5f3;color:#41635b}.no-task{margin-top:18rpx;padding:13rpx 0;border-top:1rpx solid #edf1ef;border-bottom:1rpx solid #edf1ef;color:#71807c;font-size:23rpx}.period-line{justify-content:space-between;margin-top:15rpx}.period-line view text{display:block}.period-value{font-size:27rpx;margin-top:4rpx}.amount-block{text-align:right}.period-money{font-size:31rpx;font-weight:700;color:#d25c2f;margin-top:3rpx}.amount-note{display:block;margin-top:10rpx;color:#9a5b00;font-size:22rpx}.error-state text{display:block}.retry{color:#147967;margin-top:18rpx}
