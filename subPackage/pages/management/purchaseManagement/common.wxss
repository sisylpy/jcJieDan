.pm-page{height:100vh;background:#f5f7f6;color:#24312f}.pm-body{height:100%;box-sizing:border-box;padding:14rpx 20rpx 40rpx}.pm-card{background:#fff;border:1rpx solid #e4ebe8;margin-bottom:14rpx;padding:20rpx}.pm-section-title{display:block;font-size:29rpx;font-weight:700;margin-bottom:14rpx}.pm-subtitle,.pm-muted{color:#71807c;font-size:23rpx}.pm-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.pm-list-row{padding:18rpx 0;border-bottom:1rpx solid #edf1ef}.pm-list-row:last-child{border-bottom:0}.pm-name{font-size:28rpx;font-weight:650}.pm-value{font-size:28rpx;font-weight:700;color:#116f61}.pm-money{color:#d25c2f}.pm-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx}.pm-metric{background:#f7faf9;border:1rpx solid #e8efec;padding:14rpx}.pm-metric text{display:block}.pm-label{font-size:22rpx;color:#71807c;margin-bottom:5rpx}.pm-tabs{display:flex;gap:10rpx;overflow-x:auto;white-space:nowrap;margin-bottom:14rpx}.pm-tab{padding:10rpx 16rpx;border:1rpx solid #dce6e2;background:#fff;color:#576762;font-size:23rpx}.pm-tab.on{background:#157f6d;color:#fff;border-color:#157f6d}.pm-filter{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}.pm-date{border:1rpx solid #dfe7e4;padding:9rpx 12rpx;font-size:23rpx;background:#fff}.pm-button{background:#157f6d;color:#fff;padding:12rpx 20rpx;font-size:24rpx;border-radius:4rpx}.pm-state{text-align:center;color:#75827f;padding:90rpx 20rpx}.pm-badge{font-size:20rpx;padding:4rpx 9rpx;background:#eef5f3;color:#41635b}.pm-badge.warn{background:#fff2df;color:#9a5b00}.pm-badge.error{background:#fff0ee;color:#b33b31}.pm-link{color:#147967;font-size:24rpx}.pm-progress{height:8rpx;background:#e9efed;margin-top:8rpx}.pm-progress view{height:100%;background:#1b907b}.pm-line{display:flex;justify-content:space-between;margin:9rpx 0;font-size:24rpx}.pm-spec{font-weight:400;color:#65736f}.pm-timeline{border-left:2rpx solid #cddbd7;padding-left:20rpx;margin-left:6rpx}.pm-event{position:relative;padding:0 0 22rpx 4rpx}.pm-event:before{content:'';position:absolute;width:10rpx;height:10rpx;background:#168471;left:-27rpx;top:8rpx;border-radius:50%}
