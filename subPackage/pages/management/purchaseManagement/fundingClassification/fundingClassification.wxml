<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="资金归类" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx"><view class="pm-card"><text class="pm-muted">以确认收货后的实际采购净额为上限，可拆分归类。采购方式不决定资金来源。</text></view><view class="pm-card" wx:if="{{pendingDeclarations.length}}"><text class="pm-section-title">采购员垫付申报待确认</text><view wx:for="{{pendingDeclarations}}" wx:key="allocationId" class="line"><view class="pm-row"><text>采购员 {{item.purchaserUserId}} · 商品 {{item.purchaseGoodsId}}</text><text>¥{{item.allocationAmount}}</text></view><view class="actions"><button size="mini" data-id="{{item.allocationId}}" data-state="CONFIRMED" bindtap="confirmDeclaration">确认</button><button size="mini" data-id="{{item.allocationId}}" data-state="REJECTED" bindtap="confirmDeclaration">驳回</button></view></view></view><view wx:for="{{list}}" wx:key="purchaseGoodsId" class="pm-card source {{selected.purchaseGoodsId===item.purchaseGoodsId?'chosen':''}}" data-index="{{index}}" bindtap="select"><view class="pm-row"><text>{{item.goodsName||('采购商品 '+item.purchaseGoodsId)}}</text><text class="pm-money">可归类 ¥{{item.availableAmount}}</text></view><text class="pm-muted">采购员 {{item.purchaserName||item.purchaserUserId||'未分配'}} · 供应商 {{item.supplierName||item.supplierRelationId||'无'}}</text></view><view wx:if="{{selected}}" class="pm-card editor"><picker range="{{names}}" value="{{typeIndex}}" bindchange="type"><view class="field">资金类型：{{names[typeIndex]}}</view></picker><input class="field" type="digit" value="{{amount}}" bindinput="amount" placeholder="归类金额"/><button class="pm-button" bindtap="submit">确认归类</button></view><view wx:if="{{!loading&&!list.length}}" class="pm-state">没有待归类采购净额</view><view class="pm-card"><text class="pm-section-title">公司直付待付款</text><view wx:for="{{directAllocations}}" wx:key="allocationId" class="pm-row line" data-index="{{index}}" bindtap="selectDirect"><text>商品 {{item.purchaseGoodsId}}</text><text>¥{{item.directPaidAmount}} / {{item.allocationAmount}}</text></view></view><view wx:if="{{directSelected}}" class="pm-card editor"><picker range="{{methodNames}}" value="{{methodIndex}}" bindchange="paymentMethod"><view class="field">付款方式：{{methodNames[methodIndex]}}</view></picker><input class="field" type="digit" value="{{paymentAmount}}" bindinput="paymentAmount" placeholder="本次付款金额"/><button class="pm-button" bindtap="payDirect">记录公司直付</button></view></scroll-view></view>
