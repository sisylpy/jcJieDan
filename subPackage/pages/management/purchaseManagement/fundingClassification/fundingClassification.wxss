@import "../common.wxss";

.funding-page{background:#f3f7f5}.funding-body{padding:14rpx 18rpx 56rpx}.funding-hero,.funding-section,.editor-card,.explain-card{background:#fff;border:1rpx solid #e2ebe7;margin-bottom:16rpx;padding:20rpx;box-sizing:border-box}.funding-hero{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#effaf7 0%,#fff 78%);border-color:#d8ebe5}.hero-main{display:flex;align-items:center;gap:14rpx;min-width:0}.hero-symbol{width:54rpx;height:54rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#36ad94;color:#fff;font-size:28rpx;font-weight:700}.hero-main text{display:block}.hero-title{font-size:28rpx;font-weight:750;color:#173b34;margin-bottom:3rpx}.hero-main text+text{font-size:20rpx;color:#74847f}.hero-side{text-align:right;margin-left:12rpx}.hero-side text{display:block}.hero-money{color:#de5b2b;font-size:31rpx;font-weight:750}.hero-action{display:inline-block;margin-top:8rpx;background:#178975;color:#fff;padding:9rpx 17rpx;font-size:21rpx}.funding-tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border:1rpx solid #e2ebe7;padding:7rpx;margin-bottom:16rpx}.funding-tabs view{text-align:center;padding:12rpx 6rpx;color:#64736f;font-size:23rpx}.funding-tabs .on{background:#d9f1eb;color:#117965;font-weight:700}.section-title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:12rpx;margin-bottom:12rpx;color:#7b8985;font-size:21rpx}.section-title-row>view text{display:block}.section-title{font-size:27rpx;color:#203a34;font-weight:750;border-left:6rpx solid #15917c;padding-left:12rpx}.section-subtitle{font-size:20rpx;color:#7b8985;margin:5rpx 0 0 18rpx}.declaration-section{border-left:5rpx solid #e2a03b}.declaration-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:16rpx 0;border-top:1rpx solid #edf1ef}.declaration-main{min-width:0}.declaration-main text{display:block}.declaration-main text+text{color:#71817c;font-size:21rpx;margin-top:5rpx}.declaration-actions{display:flex;gap:8rpx}.declaration-actions button{margin:0;padding:0 14rpx;font-size:21rpx;background:#fff;color:#94563a;border:1rpx solid #ead8cf}.declaration-actions button:after{border:0}.declaration-actions .confirm{background:#178975;color:#fff;border-color:#178975}.source-card{padding:18rpx 0;border-top:1rpx solid #e8eeec}.source-card.selected{background:#f5fbf9;margin:0 -10rpx;padding:18rpx 10rpx}.source-head{display:flex;justify-content:space-between;gap:16rpx}.source-head>view:first-child{min-width:0}.source-head text,.source-amount text{display:block}.goods-name{font-size:26rpx;color:#20312d;font-weight:700}.source-no{font-size:20rpx;color:#899692;margin-top:4rpx}.source-amount{text-align:right;white-space:nowrap}.source-amount text:first-child{font-size:20rpx;color:#dd5d2e}.source-amount text+text{font-size:29rpx;color:#dd5d2e;font-weight:750;margin-top:2rpx}.source-parties{display:flex;gap:10rpx;flex-wrap:wrap;margin:12rpx 0}.party{font-size:20rpx;padding:6rpx 10rpx;background:#edf7f4;color:#407167}.supplier-party{background:#eef5fc;color:#52718f}.source-rule{background:#f7f9f8;color:#72817d;padding:12rpx;font-size:20rpx;line-height:1.5}.classify-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:12rpx}.classify-actions view{display:flex;align-items:center;justify-content:center;gap:5rpx;padding:13rpx 5rpx;background:#fff5e9;color:#8b5c2a;font-size:19rpx;border:1rpx solid #f0e2ce}.classify-actions view:nth-child(2){background:#edf8f5;color:#2f6e61;border-color:#dcece7}.classify-actions view:nth-child(3){background:#eef6ff;color:#426e94;border-color:#dfeaf5}.classify-actions .disabled{opacity:.42}.action-symbol{width:28rpx;height:28rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.8);font-size:17rpx;font-weight:700}.processed-row{display:flex;justify-content:space-between;align-items:center;gap:14rpx;padding:17rpx 0;border-top:1rpx solid #e