<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购资金" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx"><view wx:if="{{loading}}" class="pm-state">正在加载…</view><view wx:elif="{{error}}" class="pm-state">{{error}}</view><block wx:else><view class="pm-card"><text class="pm-section-title">资金总览</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">未归类净额</text><text class="pm-value pm-money">¥{{summary.unclassifiedAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">待采购员报销</text><text class="pm-value">¥{{summary.pendingReimbursementAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">待供应商结算</text><text class="pm-value">¥{{summary.pendingSettlementAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">报销未付款</text><text class="pm-value">¥{{summary.reimbursementOutstandingAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">供应商未付款</text><text class="pm-value">¥{{summary.settlementOutstandingAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">有效付款</text><text class="pm-value">¥{{summary.paidAmount||0}}</text></view><view class="pm-metric"><text class="pm-label">部分付款批次</text><text class="pm-value">{{summary.partialPaymentBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">缺付款凭证</text><text class="pm-value">{{summary.missingVoucherCount||0}}</text></view><view class="pm-metric"><text class="pm-label">争议结算</text><text class="pm-value">{{summary.disputedSettlementCount||0}}</text></view><view class="pm-metric"><text class="pm-label">待处理贷项</text><text class="pm-value">{{summary.openAdjustmentCount||0}}</text></view></view></view><view class="pm-card"><text class="pm-section-title">最近付款</text><view wx:for="{{summary.recentPayments}}" wx:key="paymentId" class="pm-row line"><text>{{item.recipientName||item.recipientType}} · {{item.paymentMethod}}</text><text class="pm-money">¥{{item.paymentAmount}}</text></view></view><view class="pm-card"><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/fundingClassification/fundingClassification" bindtap="open"><text>未归类与资金归类</text><text class="pm-link">处理 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/reimbursementList/reimbursementList" bindtap="open"><text>采购员报销</text><text class="pm-link">处理 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/settlementList/settlementList" bindtap="open"><text>供应商结算</text><text class="pm-link">处理 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/paymentList/paymentList" bindtap="open"><text>付款与凭证</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/financeExceptionList/financeExceptionList" bindtap="open"><text>资金异常</text><text class="pm-link">查看 ›</text></view></view></block></scroll-view></view>
