<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购资金" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
    <view wx:if="{{loading && !purchasers.length && !suppliers.length}}" class="pm-state">正在汇总采购资金…</view>
    <view wx:elif="{{error}}" class="pm-state"><text>{{error}}</text><text class="pm-link retry" bindtap="retry">重新加载</text></view>
    <block wx:else>
      <view class="scope-note">当前待处理金额按全部历史未结事实统计，不随下方付款日期变化。</view>
      <view class="pm-card work-card">
        <view class="section-head"><view><text class="pm-section-title">采购员款项</text><text class="pm-muted">垫付报销与已开报销单分开展示</text></view><text class="pm-link" bindtap="openPurchaser">全部 ›</text></view>
        <view class="obligation-row" bindtap="openPurchaser"><view><text class="obligation-label">尚未生成报销单</text><text class="pm-muted">有正式垫付依据、尚未归入报销单</text></view><text class="amount">¥{{purchaserAvailableText}} ›</text></view>
        <view class="obligation-row" bindtap="openPurchaser"><view><text class="obligation-label">报销单尚未付清</text><text class="pm-muted">已核定报销单的当前剩余金额</text></view><text class="amount">¥{{purchaserOutstandingText}} ›</text></view>
        <view wx:if="{{!purchasers.length}}" class="empty">当前没有采购员待处理款项</view>
        <view wx:for="{{purchasers}}" wx:key="purchaserUserId" class="person-row" data-id="{{item.purchaserUserId}}" bindtap="openPurchaser"><view class="person-main"><text class="pm-name">{{item.displayName}}</text><text class="pm-muted">最近处理 {{item.lastProcessedTime||'—'}}</text></view><view class="person-money"><text>待开单 ¥{{item.availableText}}</text><text wx:if="{{item.pendingReviewAmount>0}}">核定中 ¥{{item.pendingReviewText}}</text><text>未付 ¥{{item.outstandingText}}</text><text wx:if="{{item.pendingConfirmationAmount>0}}">来源待确认 ¥{{item.pendingConfirmationText}}</text></view><text class="chevron">›</text></view>
      </view>
      <view class="pm-card work-card">
        <view class="section-head"><view><text class="pm-section-title">外部供应商款项</text><text class="pm-muted">待结采购与已开结账单分开展示</text></view><text class="pm-link" bindtap="openSupplier">全部 ›</text></view>
        <view class="obligation-row" bindtap="openSupplier"><view><text class="obligation-label">尚未生成结账单</text><text class="pm-muted">已确认供应商账期、尚未归入结账单</text></view><text class="amount">¥{{supplierAvailableText}} ›</text></view>
        <view class="obligation-row" bindtap="openSupplier"><view><text class="obligation-label">结账单尚未付清</text><text class="pm-muted">已核定结账单的当前剩余金额</text></view><text class="amount">¥{{supplierOutstandingText}} ›</text></view>
        <view wx:if="{{!suppliers.length}}" class="empty">当前没有供应商待处理款项</view>
        <view wx:for="{{suppliers}}" wx:key="supplierRelationId" class="person-row" data-id="{{item.supplierRelationId}}" bindtap="openSupplier"><view class="person-main"><text class="pm-name">{{item.displayName}}</text><text class="pm-muted">最近处理 {{item.lastProcessedTime||'—'}}</text></view><view class="person-money"><text>待开单 ¥{{item.availableText}}</text><text wx:if="{{item.pendingBatchAmount>0}}">核定中 ¥{{item.pendingBatchText}}</text><text>未付 ¥{{item.outstandingText}}</text><text wx:if="{{item.amountToVerify>0}}">金额待核对 ¥{{item.verifyText}}</text></view><text class="chevron">›</text></view>
      </view>
      <view wx:if="{{summary.unclassifiedAmount>0 || summary.disputedSettlementCount>0 || summary.openAdjustmentCount>0}}" class="pm-card attention" bindtap="openExceptions"><view class="section-head"><text class="pm-section-title">待核对事项</text><text class="pm-link">查看 ›</text></view><text class="pm-muted">未归类 ¥{{summary.unclassifiedAmount||0}} · 争议 {{summary.disputedSettlementCount||0}} · 待处理调整 {{summary.openAdjustmentCount||0}}</text><text class="explain">这些金额尚未形成明确欠付，不计入上方待报销或待结账。</text></view>
      <view class="pm-card payment-card">
        <view class="section-head"><view><text class="pm-section-title">已登记付款</text><text class="pm-muted">按实际付款日期筛选</text></view><text class="pm-link" bindtap="openPayments">付款记录 ›</text></view>
        <view class="date-row"><picker mode="date" value="{{periodStart}}" bindchange="startDate"><view class="pm-date">{{periodStart}}</view></picker><text>至</text><picker mode="date" value="{{periodEnd}}" bindchange="endDate"><view class="pm-date">{{periodEnd}}</view></picker></view>
        <view class="payment-total" bindtap="openPayments"><view><text class="total-money">¥{{summary.periodPaidAmount||0}}</text><text class="pm-muted">净付款发生额</text></view><view><text class="total-count">{{summary.periodPaymentCount||0}}笔</text><text class="pm-muted">有效付款记录</text></view></view>
        <view wx:if="{{!recentPayments.length}}" class="empty">所选付款日期内没有记录</view>
        <view wx:for="{{recentPayments}}" wx:key="paymentId" class="recent-row" data-id="{{item.paymentId}}" bindtap="openPayments"><view><text class="pm-name">{{item.recipientName||'收款对象待补全'}}</text><text class="pm-muted">{{item.typeName}} · {{item.methodName}} · {{item.paidAt}}</text></view><view class="recent-amount"><text>¥{{item.amountText}}</text><text class="chevron">›</text></view></view>
      </view>
      <view class="quick-links"><view bindtap="openFunding">资金归类</view><view bindtap="openExceptions">异常与待核对</view></view>
    </block>
  </scroll-view>
</view>
