.scope-note{background:#edf7f4;color:#37685f;border-left:6rpx solid #168471;padding:16rpx 18rpx;margin-bottom:14rpx;font-size:23rpx;line-height:1.5}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;margin-bottom:10rpx}.section-head .pm-section-title{margin-bottom:4rpx}.section-head view text{display:block}.obligation-row{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-top:1rpx solid #edf1ef}.obligation-row view text{display:block}.obligation-label{font-size:25rpx;font-weight:650}.amount{font-size:31rpx;color:#d25c2f;font-weight:700;white-space:nowrap}.person-row{display:grid;grid-template-columns:minmax(0,1fr) auto 18rpx;gap:14rpx;align-items:center;padding:18rpx 0;border-top:1rpx solid #edf1ef}.person-main text,.person-money text{display:block}.person-main{min-width:0}.person-money{text-align:right;color:#315e56;font-size:22rpx;line-height:1.65}.chevron{color:#168471;font-size:30rpx}.empty{padding:24rpx 0;color:#81908c;font-size:23rpx;text-align:center;border-top:1rpx solid #edf1ef}.attention{border-left:6rpx solid #e7a128}.explain{display:block;color:#9a6508;font-size:22rpx;margin-top:10rpx}.date-row{display:flex;align-items:center;gap:12rpx;margin:12rpx 0}.payment-total{display:grid;grid-template-columns:1fr 1fr;background:#f3f8f6;margin:14rpx 0}.payment-total>view{padding:18rpx}.payment-total>view+view{border-left:1rpx solid #dfe9e5}.payment-total text{display:block}.total-money{font-size:34rpx;color:#d25c2f;font-weight:700}.total-count{font-size:32rpx;color:#116f61;font-weight:700}.recent-row{display:flex;justify-content:space-between;align-items:center;padding:17rpx 0;border-top:1rpx solid #edf1ef}.recent-row view:first-child text{display:block}.recent-amount{display:flex;align-items:center;gap:8rpx;color:#d25c2f;font-weight:700;white-space:nowrap}.retry{display:block;margin-top:18rpx}.quick-links{display:flex;background:#fff;border:1rpx solid #e4ebe8}.quick-links view{width:50%;padding:22rpx;text-align:center;color:#147967;font-size:24rpx}.quick-links view+view{border-left:1rpx solid #e4ebe8}
