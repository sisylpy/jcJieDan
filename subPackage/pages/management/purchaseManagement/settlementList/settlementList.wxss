@import "../common.wxss";

.settlement-body{padding-bottom:150rpx;background:#f4f7f6}
.page-intro{padding:18rpx 22rpx;background:#edf7f4;border-left:5rpx solid #178673;margin-bottom:12rpx}
.page-intro text{display:block}.page-intro text:first-child{font-size:29rpx;font-weight:700;color:#1d3932}.page-intro text:last-child{font-size:22rpx;color:#687873;margin-top:6rpx}
.supplier-row,.section,.batch-row,.payment-row,.empty-card{background:#fff;border:1rpx solid #dfe8e5;margin-bottom:12rpx;padding:20rpx}
.row-title,.money-line,.selection-summary,.section-head,.sheet-head,.form-row,.voucher-row,.voucher-picker,.selected-voucher{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.supplier-name,.goods-name{font-size:28rpx;font-weight:700;color:#213a34}
.supplier-money{display:grid;grid-template-columns:1fr 1fr;border-top:1rpx solid #e7eeec;margin-top:16rpx;padding-top:14rpx}
.supplier-money view{display:flex;flex-direction:column;gap:5rpx}.supplier-money text:first-child{font-size:21rpx;color:#7b8985}.supplier-money text:last-child{font-size:27rpx;color:#26453d;font-weight:650}
.supplier-meta{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:13rpx;color:#7b8985;font-size:20rpx}.supplier-meta text{background:#f3f7f5;padding:5rpx 8rpx}
.important,.summary-money,.amount,.batch-amount{color:#d75c2b!important;font-weight:700}
.supplier-summary{display:flex;justify-content:space-between;align-items:flex-end;background:#fff;padding:20rpx;border-bottom:1rpx solid #dfe8e5}.supplier-summary>view text{display:block}.supplier-summary>view:first-child text:last-child,.supplier-summary>view:last-child text:first-child{font-size:21rpx;color:#75847f;margin-top:5rpx}.summary-money{font-size:31rpx;margin-top:3rpx}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border-bottom:1rpx solid #dce6e2;margin-bottom:12rpx}.tabs view{text-align:center;padding:18rpx 4rpx;color:#5f6f6a;font-size:25rpx;border-bottom:5rpx solid transparent}.tabs .active{color:#147967;font-weight:700;border-color:#178673}
.date-filter{display:flex;align-items:center;gap:12rpx;background:#fff;padding:14rpx 18rpx;margin-bottom:12rpx;font-size:22rpx;color:#657570}.date-filter picker{border:1rpx solid #d8e3df;padding:9rpx 12rpx;min-width:150rpx;text-align:center;color:#30473f}
.notice{font-size:22rpx;padding:13rpx 15rpx;margin:10rpx 0}.notice text{display:block}.notice text+text{margin-top:5rpx}.warning{background:#fff8e8;color:#845f18;border-left:5rpx solid #dfaa3f}
.section{padding-bottom:6rpx}.section-head .pm-section-title{display:block}.section-head .pm-muted{display:block;margin-top:4rpx}.selected-count{font-size:22rpx;color:#147967;white-space:nowrap}
.source-row{display:flex;gap:12rpx;padding:19rpx 0;border-bottom:1rpx solid #e8efed}.source-row.selected{background:#eff8f5;margin:0 -10rpx;padding-left:10rpx;padding-right:10rpx;border-left:4rpx solid #178673}.check-mark{width:32rpx;color:#178673;font-size:27rpx}.source-main{flex:1;min-width:0}.source-main .pm-muted{display:block;margin-top:7rpx}.amount,.batch-amount{font-size:27rpx;white-space:nowrap}
.selection-summary{padding:15rpx 0 2rpx;color:#334842;font-size:23rpx}.create-button{margin:16rpx 0}
.batch-row.voided{opacity:.55}.batch-no{display:block;font-size:23rpx;font-weight:650;color:#354b44}.batch-row .goods-name{display:block;font-size:24rpx;margin-top:7rpx}.status-line{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:13rpx}.status-line text{font-size:20rpx;background:#eef5f2;color:#49675f;padding:5rpx 8rpx}.money-line{font-size:23rpx;color:#5f716b;margin-top:14rpx}
.actions{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:14rpx}.actions button{margin:0;border-radius:3rpx}.actions .plain{background:#fff;color:#51645f;border:1rpx solid #ccd9d5}.actions .pay-button{background:#178673;color:#fff}.actions .danger-button{color:#9c473a;border-color:#e8d0cb}
.payment-row .pm-muted{display:block;margin-top:8rpx}.empty-card{text-align:center;padding:45rpx 20rpx}.empty-card text{display:block;color:#788681;font-size:24rpx}.empty-card text+text{font-size:21rpx;margin-top:8rpx}.empty-line{text-align:center;color:#82908c;font-size:23rpx;padding:28rpx 0}.error-state text{display:block;margin-bottom:18rpx;color:#b34134}
.detail-sheet{position:fixed;z-index:18;left:0;right:0;top:calc(120rpx + env(safe-area-inset-top));bottom:0;background:#f4f7f6;border-top:5rpx solid #178673;padding:20rpx;box-sizing:border-box}.sheet-head{background:#fff;padding:4rpx 0 16rpx}.sheet-head text{display:block}.sheet-scroll{height:calc(100% - 85rpx)}.detail-total{display:grid;grid-template-columns:repeat(3,1fr);background:#edf7f4;border:1rpx solid #d7e9e3;margin-bottom:18rpx}.detail-total view{padding:14rpx;border-right:1rpx solid #d7e9e3}.detail-total view:last-child{border-right:0}.detail-total text{display:block;font-size:20rpx;color:#6a7b75}.detail-total text:last-child{font-size:26rpx;color:#29483f;margin-top:5rpx}.detail-title{display:block;font-size:26rpx;font-weight:700;color:#244139;margin:18rpx 0 10rpx}.detail-line{background:#fff;border:1rpx solid #dfe8e5;padding:17rpx;margin-bottom:10rpx}.detail-line .pm-muted{display:block;margin:6rpx 0}.line-basis{display:flex;gap:26rpx;color:#566963;font-size:22rpx}
.pay-mask{position:fixed;z-index:30;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.35)}.pay-panel{position:fixed;z-index:31;left:20rpx;right:20rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:6rpx solid #178673;padding:24rpx}.field{box-sizing:border-box;width:100%;background:#f5f8f7;border:1rpx solid #d7e3df;padding:19rpx;margin:15rpx 0}.form-row{border-top:1rpx solid #e5ecea;padding:16rpx 2rpx;font-size:24rpx;color:#344941}.pay-panel>.pm-muted{display:block;margin:13rpx 0}.pay-panel>.pm-button{margin-top:18rpx}.voucher-row{padding:16rpx 0;border-bottom:1rpx solid #e5ecea;font-size:23rpx}
.voucher-picker{border-top:1rpx solid #e5ecea;padding:16rpx 2rpx;font-size:24rpx;color:#344941}.voucher-picker>view text{display:block}.voucher-picker button{margin:0;background:#fff;color:#157f6d;border:1rpx solid #b9d6ce}.selected-voucher{background:#edf7f4;padding:13rpx 15rpx;font-size:21rpx;color:#38564e}.selected-voucher text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
