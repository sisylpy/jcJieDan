<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购管理" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
<scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
  <view class="shortcut"><text class="pm-tab {{range==='TODAY'?'on':''}}" data-range="TODAY" bindtap="chooseRange">今日</text><text class="pm-tab {{range==='LAST_7_DAYS'?'on':''}}" data-range="LAST_7_DAYS" bindtap="chooseRange">近7天</text><text class="pm-tab {{range==='LAST_30_DAYS'?'on':''}}" data-range="LAST_30_DAYS" bindtap="chooseRange">近30天</text></view>
  <view class="pm-card pm-filter"><picker mode="date" value="{{startDate}}" bindchange="changeStart"><text class="pm-date">{{startDate||'开始日期'}}</text></picker><text>至</text><picker mode="date" value="{{stopDate}}" bindchange="changeStop"><text class="pm-date">{{stopDate||'结束日期'}}</text></picker><text class="pm-muted">采购业务日期</text></view>
  <view wx:if="{{loading}}" class="pm-state">正在加载采购管理数据…</view><view wx:elif="{{error}}" class="pm-state">{{error}}<view class="pm-button" bindtap="load">重新加载</view></view>
  <block wx:else>
    <view class="pm-card"><text class="pm-section-title">当前待办</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">待采购商品行</text><text class="pm-value">{{tasks.pendingPurchaseGoodsLines||0}}</text></view><view class="pm-metric"><text class="pm-label">采购中批次</text><text class="pm-value">{{tasks.purchasingBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">部分收货批次</text><text class="pm-value">{{tasks.partiallyReceivedBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">待入库商品行</text><text class="pm-value">{{tasks.waitingStockInGoodsLines||0}}</text></view><view class="pm-metric"><text class="pm-label">待分配负责人</text><text class="pm-value">{{tasks.unassignedDemandCount||0}}</text></view><view class="pm-metric"><text class="pm-label">当前异常</text><text class="pm-value pm-money">{{tasks.currentExceptionCount||0}}</text></view></view></view>
    <view class="pm-card"><text class="pm-section-title">期间金额</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">预计采购</text><text class="pm-value pm-money">{{period.expectedAmount==null?'—':'¥'+period.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际收货</text><text class="pm-value pm-money">{{period.actualReceiptAmount==null?'—':'¥'+period.actualReceiptAmount}}</text></view><view class="pm-metric"><text class="pm-label">供应商退货</text><text class="pm-value">{{period.supplierReturnAmount==null?'—':'¥'+period.supplierReturnAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际净采购</text><text class="pm-value pm-money">{{period.actualNetPurchaseAmount==null?'—':'¥'+period.actualNetPurchaseAmount}}</text></view><view class="pm-metric"><text class="pm-label">库房商品入库</text><text class="pm-value">{{period.warehouseStockInAmount==null?'—':'¥'+period.warehouseStockInAmount}}</text></view><view class="pm-metric"><text class="pm-label">对外采购实际</text><text class="pm-value">{{period.orderPurchaseActualAmount==null?'—':'¥'+period.orderPurchaseActualAmount}}</text></view></view><text wx:if="{{period.totalBatchCount||period.directSelfBuyRecordCount}}" class="pm-muted"><text wx:if="{{period.totalBatchCount}}">有效批次 {{period.effectiveBatchCount||0}} / 总批次 {{period.totalBatchCount}} · {{period.dataCompletenessText}} · 覆盖率 {{period.dataCoverageRateText||'—'}}</text><text wx:if="{{period.directSelfBuyRecordCount}}">{{period.totalBatchCount?' · ':''}}直接采购 {{period.directSelfBuyRecordCount}} 条（待采购 {{period.directSelfBuyPendingCount||0}} 条 · 已采购 {{period.directSelfBuyPurchaseCount||0}} 条 · 已入库 {{period.directSelfBuyStockInCount||0}} 条）</text></text><text wx:else class="pm-muted">当前范围暂无采购记录</text></view>
    <view class="pm-card"><text class="pm-section-title">经营结果</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">损耗 / 废弃</text><text class="pm-value">{{period.lossQuantity==null?'—':period.lossQuantity}} / {{period.discardQuantity==null?'—':period.discardQuantity}}</text></view><view class="pm-metric"><text class="pm-label">损耗成本</text><text class="pm-value pm-money">{{period.lossCost==null?'—':'¥'+period.lossCost}}</text></view><view class="pm-metric"><text class="pm-label">降价销售数量</text><text class="pm-value">{{period.markdownQuantity==null?'—':period.markdownQuantity}}</text></view><view class="pm-metric"><text class="pm-label">降价收入影响</text><text class="pm-value pm-money">{{period.markdownImpact==null?'—':'¥'+period.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">当前实现毛利 / 率</text><text class="pm-value">{{period.currentRealizedMargin==null?'—':'¥'+period.currentRealizedMargin}} / {{period.currentRealizedMarginRateText||'—'}}</text></view><view class="pm-metric"><text class="pm-label">完结最终毛利 / 率</text><text class="pm-value">{{period.completedFinalMargin==null?'—':'¥'+period.completedFinalMargin}} / {{period.completedFinalMarginRateText||'—'}}</text></view></view></view>
    <view class="pm-card"><text class="pm-section-title">管理入口</text><view class="entry pm-row" bindtap="openInternalCollaboration"><text>协作配送商</text><text class="pm-link">内部配送商伙伴关系 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/supplierCollaboration/supplierCollaboration" bindtap="open"><text>外部供应商协同</text><text class="pm-link">邀请到精彩订货并履约 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/financeOverview/financeOverview" bindtap="open"><text>采购资金</text><text class="pm-link">归类、报销与结算 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaserList/purchaserList" bindtap="open"><text>采购员</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/supplierList/supplierList" bindtap="open"><text>供应商</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaseBatchList/purchaseBatchList" bindtap="open"><text>采购批次</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaseExceptionList/purchaseExceptionList" bindtap="open"><text>待办与异常</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchasePerformance/purchasePerformance" bindtap="open"><text>库存批次经营</text><text class="pm-link">查看 ›</text></view></view>
    <view class="pm-card"><text class="pm-section-title">结构分析</text><text class="pm-label">需求来源</text><view wx:for="{{structures.DEMAND_SOURCE}}" wx:key="structureCode" class="pm-line"><text>{{item.structureText}}</text><text>{{item.goodsLineCount}} 行 · {{item.actualReceiptAmount==null?'—':'¥'+item.actualReceiptAmount}}</text></view><text class="pm-label">采购方式</text><view class="structure" wx:for="{{structures.PROCUREMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.batchCount}} 批次 · {{item.goodsLineCount}} 商品行</text></view></view><text class="pm-label">履约模式</text><view class="structure" wx:for="{{structures.FULFILLMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.actualReceiptAmount==null?'—':'¥'+item.actualReceiptAmount}}</text></view></view></view>
  </block>
</scroll-view></view>
