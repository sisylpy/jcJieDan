<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购管理" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
<scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
  <view class="shortcut"><text class="pm-tab {{range==='TODAY'?'on':''}}" data-range="TODAY" bindtap="chooseRange">今日</text><text class="pm-tab {{range==='LAST_7_DAYS'?'on':''}}" data-range="LAST_7_DAYS" bindtap="chooseRange">近7天</text><text class="pm-tab {{range==='LAST_30_DAYS'?'on':''}}" data-range="LAST_30_DAYS" bindtap="chooseRange">近30天</text></view>
  <view class="pm-card pm-filter"><picker mode="date" value="{{startDate}}" bindchange="changeStart"><text class="pm-date">{{startDate||'开始日期'}}</text></picker><text>至</text><picker mode="date" value="{{stopDate}}" bindchange="changeStop"><text class="pm-date">{{stopDate||'结束日期'}}</text></picker><text class="pm-muted">采购业务日期</text></view>
  <view wx:if="{{loading}}" class="pm-state">正在加载采购管理数据…</view><view wx:elif="{{error}}" class="pm-state"><text>采购数据加载失败</text><text class="load-error-copy">{{error}}</text><view class="pm-button retry-button" bindtap="retry">重新加载</view></view>
  <block wx:else>
    <view class="pm-card"><text class="pm-section-title">当前待办</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">待采购商品行</text><text class="pm-value">{{tasks.pendingPurchaseGoodsLines||0}}</text></view><view class="pm-metric"><text class="pm-label">采购中批次</text><text class="pm-value">{{tasks.purchasingBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">部分收货批次</text><text class="pm-value">{{tasks.partiallyReceivedBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">待入库商品行</text><text class="pm-value">{{tasks.waitingStockInGoodsLines||0}}</text></view><view class="pm-metric"><text class="pm-label">待分配负责人</text><text class="pm-value">{{tasks.unassignedDemandCount||0}}</text></view><view class="pm-metric"><text class="pm-label">当前异常</text><text class="pm-value pm-money">{{tasks.currentExceptionCount||0}}</text></view></view></view>
    <view class="pm-card purchase-amount-card">
      <view class="amount-heading"><view><text class="pm-section-title amount-title">本期采购金额</text><text class="amount-period">{{startDate}} 至 {{stopDate}}</text></view><text class="purchase-total {{purchaseAmount.hasRecognizedAmount?'':'muted'}}">{{purchaseAmount.amountText}}</text></view>
      <text class="amount-state">{{purchaseAmount.stateText}}</text>
      <view wx:if="{{purchaseAmount.hasAnyRecord}}" class="amount-groups">
        <view class="amount-group" wx:for="{{purchaseAmount.groups}}" wx:key="sourceType"><text class="group-name">{{item.sourceText}}</text><text class="group-value">{{item.recognizedAmountText}}</text><text class="group-count">{{item.includedRecordCount}}条</text></view>
      </view>
      <view wx:if="{{purchaseAmount.unresolvedAmountCount}}" class="amount-notice warn">另有{{purchaseAmount.unresolvedAmountCount}}条采购记录金额尚未形成，未计入上述金额</view>
      <view wx:if="{{purchaseAmount.conflictRecordCount}}" class="amount-notice conflict">另有{{purchaseAmount.conflictRecordCount}}条记录来源信息冲突，未计入本期采购金额</view>
      <view wx:if="{{purchaseAmount.undatedRecordCount}}" class="amount-notice separate">另有{{purchaseAmount.undatedRecordCount}}条记录没有可靠业务日期，无法判断是否属于本期</view>
      <view wx:if="{{purchaseAmount.historicalDateFallbackCount}}" class="amount-notice neutral">包含{{purchaseAmount.historicalDateFallbackCount}}条按采购需求日期归期的历史采购，合计{{purchaseAmount.historicalDateFallbackAmountText}}</view>
      <view wx:if="{{purchaseAmount.historicalBillUnresolvedCount}}" class="amount-notice separate">另有{{purchaseAmount.historicalBillUnresolvedCount}}条历史账单<text wx:if="{{purchaseAmount.historicalBillIssueAmountKnown}}">（{{purchaseAmount.historicalBillIssueAmountText}}）</text>来源待核对，不计入本期采购金额</view>
      <view class="amount-detail-link" bindtap="openAmountRecords"><text>查看采购明细</text><text>›</text></view>
      <view wx:if="{{period.warehouseStockInAmount!=null}}" class="stock-in-line"><view><text class="stock-label">库房入库金额</text><text class="stock-note">库存口径，未计入上方金额</text></view><text class="stock-value">{{warehouseStockInAmountText}}</text></view>
    </view>
    <view class="pm-card"><text class="pm-section-title">经营结果</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">损耗 / 废弃</text><text class="pm-value">{{period.lossQuantity==null?'—':period.lossQuantity}} / {{period.discardQuantity==null?'—':period.discardQuantity}}</text></view><view class="pm-metric"><text class="pm-label">损耗成本</text><text class="pm-value pm-money">{{period.lossCost==null?'—':'¥'+period.lossCost}}</text></view><view class="pm-metric"><text class="pm-label">降价销售数量</text><text class="pm-value">{{period.markdownQuantity==null?'—':period.markdownQuantity}}</text></view><view class="pm-metric"><text class="pm-label">降价收入影响</text><text class="pm-value pm-money">{{period.markdownImpact==null?'—':'¥'+period.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">当前实现毛利 / 率</text><text class="pm-value">{{period.currentRealizedMargin==null?'—':'¥'+period.currentRealizedMargin}} / {{period.currentRealizedMarginRateText||'—'}}</text></view><view class="pm-metric"><text class="pm-label">完结最终毛利 / 率</text><text class="pm-value">{{period.completedFinalMargin==null?'—':'¥'+period.completedFinalMargin}} / {{period.completedFinalMarginRateText||'—'}}</text></view></view></view>
    <view class="pm-card"><text class="pm-section-title">管理入口</text><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/financeOverview/financeOverview" bindtap="open"><text>采购资金</text><text class="pm-link">归类、报销与结算 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaserList/purchaserList" bindtap="open"><text>采购员</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/supplierList/supplierList" bindtap="open"><text>供应商</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaseBatchList/purchaseBatchList" bindtap="open"><text>采购批次</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchaseManagement/purchaseExceptionList/purchaseExceptionList" bindtap="open"><text>待办与异常</text><text class="pm-link">查看 ›</text></view><view class="entry pm-row" data-url="/subPackage/pages/management/purchasePerformance/purchasePerformance" bindtap="open"><text>库存批次经营</text><text class="pm-link">查看 ›</text></view></view>
    <view class="pm-card"><text class="pm-section-title">结构分析</text><text class="pm-label">需求来源</text><view wx:for="{{structures.DEMAND_SOURCE}}" wx:key="structureCode" class="pm-line"><text>{{item.structureText}}</text><text>{{item.goodsLineCount||0}} 商品行</text></view><text class="pm-label">采购方式</text><view class="structure" wx:for="{{structures.PROCUREMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.batchCount}} 批次 · {{item.goodsLineCount}} 商品行</text></view></view><text class="pm-label">履约模式</text><view class="structure" wx:for="{{structures.FULFILLMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.goodsLineCount||0}} 商品行</text></view></view></view>
  </block>
</scroll-view></view>
