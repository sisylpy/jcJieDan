<template name="pendingSection">
  <view class="pending-section" wx:if="{{items.length}}">
    <view class="pending-heading"><view><text class="pending-title">{{title}}</text><text class="pending-note">{{note}}</text></view><text class="pending-count {{tone}}">{{items.length}}</text></view>
    <view class="pending-item" wx:for="{{items}}" wx:key="resourceId">
      <view class="pending-item-head"><view><text class="pending-subject">{{item.subjectName||item.title}}</text><text class="pending-meta">{{item.businessDateText}} · {{item.exceptionTypeText}}</text></view><text class="pending-status">{{item.statusText}}</text></view>
      <text class="pending-event">{{item.title}}</text>
      <view class="pending-fact"><text>发生了什么</text><text>{{item.detailText}}</text></view>
      <view class="pending-fact"><text>业务影响</text><text>{{item.impactText}}</text></view>
      <text class="pending-owner">当前负责：{{item.responsibleRole||'仅核查'}}</text>
      <view class="pending-actions" wx:if="{{item.canAssign||item.canView}}">
        <button wx:if="{{item.canAssign}}" data-relation="{{item.supplierRelationId}}" data-subject="{{item.subjectName}}" bindtap="beginAssign">分配采购负责人</button>
        <button wx:if="{{item.canView}}" data-resource="{{item.resourceType}}" data-id="{{item.resourceId}}" bindtap="openPending">{{item.actionLabel}}</button>
      </view>
      <text wx:else class="pending-no-action">当前没有安全的直接处理入口，请按原因联系对应角色或查看来源资料。</text>
    </view>
  </view>
</template>

<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购总览" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
    <report-date-filter label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>
    <text class="date-basis">上方日期仅筛选采购业务与金额；当前未结束事项始终显示。</text>

    <view wx:if="{{loading}}" class="pm-state">正在加载采购总览…</view>
    <view wx:elif="{{error}}" class="pm-state"><text>采购总览加载失败</text><text class="load-error-copy">{{error}}</text><view class="pm-button retry-button" bindtap="retry">重新加载</view></view>
    <block wx:else>
      <view class="pm-card"><text class="pm-section-title">当前待办概况</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">待采购商品行</text><text class="pm-value">{{tasks.pendingPurchaseGoodsLines||0}}</text></view><view class="pm-metric"><text class="pm-label">采购中批次</text><text class="pm-value">{{tasks.purchasingBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">部分收货批次</text><text class="pm-value">{{tasks.partiallyReceivedBatchCount||0}}</text></view><view class="pm-metric"><text class="pm-label">待分配负责人</text><text class="pm-value">{{tasks.unassignedDemandCount||0}}</text></view><view class="pm-metric"><text class="pm-label">需处理或核查</text><text class="pm-value pm-money">{{tasks.currentExceptionCount||0}}</text></view><view class="pm-metric pm-metric-link" bindtap="openCollaborationPending"><text class="pm-label">协作待出货</text><view class="metric-action"><text class="pm-value">{{tasks.collaborationPendingOrderLines||0}}</text><text class="pm-link">处理 ›</text></view></view></view></view>

      <view class="pm-card pending-stock-card" bindtap="openPendingStockIns"><view class="pending-stock-heading"><view><text class="pm-section-title pending-stock-title">待接收入库</text><text class="pending-stock-copy">采购员已完成采购，等待老板在货架确认接收</text></view><text class="pm-link">集中处理 ›</text></view><view class="pending-stock-summary"><view><text class="pending-stock-number">{{tasks.waitingStockInGoodsLines||0}}</text><text class="pending-stock-unit">件商品</text></view><view class="pending-stock-amount"><text>已记录金额</text><text>{{waitingStockInAmountText}}</text></view></view><text wx:if="{{tasks.waitingStockInUnresolvedAmountCount}}" class="pending-stock-warning">另有 {{tasks.waitingStockInUnresolvedAmountCount}} 件商品金额待核对</text></view>

      <view class="pm-card purchase-amount-card">
        <view class="amount-heading"><view><text class="pm-section-title amount-title">本期采购金额</text><text class="amount-period">{{startDate}} 至 {{stopDate}}</text></view><text class="purchase-total {{purchaseAmount.hasRecognizedAmount?'':'muted'}}">{{purchaseAmount.amountText}}</text></view><text class="amount-state">{{purchaseAmount.stateText}}</text>
        <view wx:if="{{purchaseAmount.hasAnyRecord}}" class="amount-groups"><view class="amount-group" wx:for="{{purchaseAmount.groups}}" wx:key="sourceType"><text class="group-name">{{item.sourceText}}</text><text class="group-value">{{item.recognizedAmountText}}</text><text class="group-count">{{item.includedRecordCount}}条</text></view></view>
        <view wx:if="{{purchaseAmount.unresolvedAmountCount}}" class="amount-notice warn">另有{{purchaseAmount.unresolvedAmountCount}}条采购记录金额尚未形成，未计入上述金额</view><view wx:if="{{purchaseAmount.conflictRecordCount}}" class="amount-notice conflict">另有{{purchaseAmount.conflictRecordCount}}条记录来源信息冲突，未计入本期采购金额</view><view wx:if="{{purchaseAmount.undatedRecordCount}}" class="amount-notice separate">另有{{purchaseAmount.undatedRecordCount}}条记录没有可靠业务日期，无法判断是否属于本期</view><view wx:if="{{purchaseAmount.historicalDateFallbackCount}}" class="amount-notice neutral">包含{{purchaseAmount.historicalDateFallbackCount}}条按采购需求日期归期的历史采购，合计{{purchaseAmount.historicalDateFallbackAmountText}}</view><view wx:if="{{purchaseAmount.historicalBillUnresolvedCount}}" class="amount-notice separate">另有{{purchaseAmount.historicalBillUnresolvedCount}}条历史账单<text wx:if="{{purchaseAmount.historicalBillIssueAmountKnown}}">（{{purchaseAmount.historicalBillIssueAmountText}}）</text>来源待核对，不计入本期采购金额</view>
        <view class="amount-detail-link" bindtap="openAmountRecords"><text>查看采购明细</text><text>›</text></view><view wx:if="{{period.warehouseStockInAmount!=null}}" class="stock-in-line"><view><text class="stock-label">库房入库金额</text><text class="stock-note">库存口径，未计入上方金额</text></view><text class="stock-value">{{warehouseStockInAmountText}}</text></view>
      </view>

      <view class="pm-card"><text class="pm-section-title">采购结构</text><text class="pm-label">需求来源</text><view wx:for="{{structures.DEMAND_SOURCE}}" wx:key="structureCode" class="pm-line"><text>{{item.structureText}}</text><text>{{item.goodsLineCount||0}} 商品行</text></view><text class="pm-label">采购方式</text><view class="structure" wx:for="{{structures.PROCUREMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.batchCount}} 批次 · {{item.goodsLineCount}} 商品行</text></view></view><text class="pm-label">履约模式</text><view class="structure" wx:for="{{structures.FULFILLMENT_MODE}}" wx:key="structureCode"><view class="pm-line"><text>{{item.structureText}}</text><text>{{item.goodsLineCount||0}} 商品行</text></view></view></view>
    </block>

    <view class="pm-card pending-root"><view class="pending-root-head"><view><text class="pm-section-title">待处理事项</text><text class="pending-root-note">按真实来源状态展示，不复制采购、资金或库存流程</text></view><text class="pending-root-total">{{pendingTotal}}</text></view><view wx:if="{{pendingError}}" class="pending-state"><text>{{pendingError}}</text><text class="pm-link" bindtap="loadPending">重新加载</text></view><view wx:elif="{{pendingLoading}}" class="pending-state">正在读取当前事项…</view><view wx:elif="{{!pendingTotal}}" class="pending-state success">当前没有待处理、等待或历史提示</view><block wx:else><template is="pendingSection" data="{{items:actionItems,title:'当前可处理',note:'当前老板有正式操作入口的事项',tone:'action'}}"></template><template is="pendingSection" data="{{items:waitingItems,title:'等待其他角色',note:'正常业务进度，不计入紧急异常',tone:'waiting'}}"></template><template is="pendingSection" data="{{items:blockedItems,title:'阻断与核查',note:'只查看可靠来源，不允许直接改数字消除问题',tone:'blocked'}}"></template><template is="pendingSection" data="{{items:historyItems,title:'历史只读提示',note:'仅供追溯，不计入当前待办',tone:'history'}}"></template></block></view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view wx:if="{{showAssignment}}" class="assignment-mask" bindtap="closeAssignment"><view class="assignment-panel" catchtap="noop"><view class="assignment-head"><view><text class="assignment-title">分配采购负责人</text><text class="assignment-subject">{{assignItem.subjectName}}</text></view><text class="pm-link" bindtap="closeAssignment">关闭</text></view><text class="assignment-note">设置的是供应关系采购负责人，不会直接改采购批次负责人。</text><view wx:if="{{purchasersLoading}}" class="pending-state">正在读取当前采购员…</view><view wx:elif="{{!purchasers.length}}" class="pending-state">没有可分配的当前采购员</view><scroll-view wx:else scroll-y class="purchaser-list"><view class="purchaser-row" wx:for="{{purchasers}}" wx:key="purchaserUserId" data-id="{{item.purchaserUserId}}" data-name="{{item.purchaserName}}" bindtap="choosePurchaser"><view><text class="purchaser-name">{{item.purchaserName||('采购员 #'+item.purchaserUserId)}}</text><text class="purchaser-status">{{item.accountStatusText}}</text></view><text>{{assigning?'保存中…':'选择 ›'}}</text></view></scroll-view></view></view>
</view>
