@import "../common.wxss";
.shortcut{display:flex;gap:10rpx;margin-bottom:14rpx}.shortcut text{flex:1;text-align:center}.entry{padding:18rpx 0;border-bottom:1rpx solid #edf1ef}.entry:last-child{border-bottom:0}.structure{margin-top:10rpx;padding-top:10rpx;border-top:1rpx solid #edf1ef}
.load-error-copy{display:block;margin:14rpx 0;color:#8a9693;font-size:23rpx}.retry-button{display:inline-block;margin-top:8rpx}.purchase-amount-card{padding:22rpx}.amount-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.amount-title{margin-bottom:6rpx}.amount-period{display:block;color:#71807c;font-size:22rpx}.purchase-total{font-size:40rpx;line-height:1.2;font-weight:700;color:#d25c2f;white-space:nowrap}.purchase-total.muted{color:#75827f;font-size:30rpx}.amount-state{display:block;margin-top:12rpx;color:#53635f;font-size:23rpx}.amount-groups{display:grid;grid-template-columns:repeat(3,1fr);margin-top:18rpx;border-top:1rpx solid #edf1ef;border-bottom:1rpx solid #edf1ef}.amount-group{padding:16rpx 8rpx;text-align:center;border-right:1rpx solid #edf1ef}.amount-group:last-child{border-right:0}.amount-group text{display:block}.group-name{color:#63726e;font-size:21rpx}.group-value{margin-top:5rpx;color:#24312f;font-size:25rpx;font-weight:650}.group-count{margin-top:2rpx;color:#8a9693;font-size:19rpx}.amount-notice{margin-top:12rpx;padding:12rpx 14rpx;border-left:4rpx solid #d7a33d;background:#fff8e9;color:#77551b;font-size:22rpx;line-height:1.5}.amount-notice.neutral{border-color:#5c998e;background:#f1f8f6;color:#41635b}.amount-notice.separate{border-color:#9c8a72;background:#f8f5f0;color:#695d4e}.amount-detail-link{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding:15rpx 0 2rpx;color:#147967;font-size:25rpx}.stock-in-line{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #edf1ef}.stock-label,.stock-note{display:block}.stock-label{color:#41504c;font-size:23rpx}.stock-note{margin-top:4rpx;color:#8a9693;font-size:19rpx}.stock-value{font-size:25rpx;color:#53635f;font-weight:600}
.amount-notice.conflict{border-color:#b95b4d;background:#fff1ef;color:#8e392f}
.pending-stock-card{border-left:6rpx solid #178b78;background:#fbfefd}.pending-stock-heading,.pending-stock-summary{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.pending-stock-title,.pending-stock-copy{display:block}.pending-stock-copy{margin-top:6rpx;color:#60716d;font-size:22rpx}.pending-stock-summary{margin-top:20rpx;padding:18rpx 0;border-top:1rpx solid #e5efec;border-bottom:1rpx solid #e5efec}.pending-stock-number{font-size:42rpx;font-weight:700;color:#147967}.pending-stock-unit{margin-left:8rpx;color:#60716d;font-size:22rpx}.pending-stock-amount{text-align:right}.pending-stock-amount text{display:block}.pending-stock-amount text:first-child{color:#7a8985;font-size:20rpx}.pending-stock-amount text:last-child{margin-top:4rpx;color:#d25c2f;font-size:29rpx;font-weight:650}.pending-stock-note{display:block;margin-top:14rpx;color:#7a8985;font-size:20rpx;line-height:1.5}
.pending-stock-warning{display:block;margin-top:12rpx;color:#8b621e;font-size:21rpx}
