@import "../common.wxss";

.pm-page{background:#f2f6f4}.overview-body{padding:16rpx 18rpx 44rpx}.date-card,.overview-module,.stock-action-card{margin-bottom:18rpx;border:1rpx solid #dfe9e5;border-radius:18rpx;background:#fff;box-shadow:0 5rpx 18rpx rgba(24,78,66,.05)}
.date-card{padding:16rpx 18rpx 14rpx}report-date-filter{display:block}.date-basis{display:block;margin:10rpx 4rpx 0;padding-top:10rpx;border-top:1rpx solid #edf2f0;color:#73827e;font-size:20rpx;line-height:1.5}.overview-state{margin-bottom:18rpx;border-radius:18rpx;background:#fff}.error-state{color:#7c4941}.load-error-copy{display:block;margin:14rpx 0;color:#8a9693;font-size:23rpx}.retry-button{display:inline-block;margin-top:8rpx}

.overview-module{padding:22rpx}.module-heading,.module-heading-copy,.task-label-row,.task-value-row,.stock-action-main,.stock-action-summary,.amount-hero,.performance-entry,.stock-in-line,.structure-heading,.structure-row,.pending-root-head,.pending-heading,.pending-item-head,.assignment-head,.purchaser-row{display:flex}.module-heading,.task-label-row,.stock-action-main,.stock-action-summary,.amount-hero,.performance-entry,.stock-in-line,.structure-row,.pending-root-head,.pending-heading,.pending-item-head,.assignment-head,.purchaser-row{align-items:center;justify-content:space-between}.module-heading{gap:18rpx;margin-bottom:20rpx}.module-heading-copy{align-items:center;min-width:0}.module-mark{width:7rpx;height:48rpx;margin-right:14rpx;border-radius:8rpx;background:#178b78;flex:none}.module-mark.amount{background:#df6a36}.module-mark.structure{background:#397ea5}.module-mark.issues{background:#8b6c4d}.module-title,.module-subtitle{display:block}.module-title{color:#1e332e;font-size:31rpx;font-weight:700;line-height:1.25}.module-subtitle{margin-top:5rpx;color:#74837f;font-size:21rpx;line-height:1.4}.module-tag{padding:6rpx 12rpx;border-radius:18rpx;background:#e9f6f2;color:#167965;font-size:20rpx;flex:none}

.task-module{padding-bottom:18rpx}.task-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx}.task-tile{min-height:156rpx;padding:16rpx;border:1rpx solid #e3ece8;border-radius:12rpx;background:#f8fbfa;box-sizing:border-box}.task-tile.actionable{border-color:#cde5de;background:#f0faf7}.task-tile.warning{border-color:#f1dfd3;background:#fff9f5}.task-tile-hover{opacity:.72}.task-label-row{gap:8rpx}.task-label{color:#536560;font-size:22rpx}.task-open{color:#16806c;font-size:20rpx}.task-value-row{justify-content:flex-start;align-items:baseline;margin-top:6rpx}.task-value{color:#117865;font-size:38rpx;font-weight:750;line-height:1.2}.task-tile.warning .task-value{color:#d35f35}.task-unit{margin-left:7rpx;color:#697a75;font-size:20rpx}.task-help{display:block;margin-top:7rpx;color:#85918e;font-size:19rpx;line-height:1.4}

.stock-action-card{padding:22rpx;border-left:7rpx solid #15917b;background:linear-gradient(135deg,#fbfffd 0%,#f2faf7 100%)}.action-card-hover,.performance-entry-hover{opacity:.72}.stock-action-main{gap:14rpx}.stock-action-icon,.performance-icon,.structure-icon{display:flex;align-items:center;justify-content:center;flex:none}.stock-action-icon{width:62rpx;height:62rpx;border-radius:16rpx;background:#168a75;color:#fff;font-size:27rpx;font-weight:700}.stock-action-copy{flex:1;min-width:0}.stock-action-title,.stock-action-note{display:block}.stock-action-title{color:#1d332e;font-size:30rpx;font-weight:700}.stock-action-note{margin-top:5rpx;color:#647570;font-size:21rpx}.stock-action-link{color:#14816d;font-size:23rpx;white-space:nowrap}.stock-action-summary{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #dcebe6}.stock-action-number{color:#12806b;font-size:42rpx;font-weight:750}.stock-action-unit{margin-left:8rpx;color:#5e706b;font-size:21rpx}.stock-action-amount{text-align:right}.stock-action-amount text{display:block}.stock-action-amount text:first-child{color:#7a8985;font-size:20rpx}.stock-action-amount text:last-child{margin-top:3rpx;color:#d45c31;font-size:28rpx;font-weight:700}.stock-action-warning{display:block;margin-top:13rpx;padding:10rpx 12rpx;border-radius:8rpx;background:#fff4df;color:#855b18;font-size:20rpx}

.amount-module-heading{align-items:flex-start}.amount-period{padding-top:4rpx;color:#75837f;font-size:20rpx;white-space:nowrap}.amount-hero{align-items:flex-end;padding:18rpx;border-radius:14rpx;background:#fff7f2}.amount-eyebrow{display:block;color:#806758;font-size:21rpx}.purchase-total{display:block;margin-top:4rpx;color:#d85e2c;font-size:44rpx;font-weight:750;line-height:1.2}.purchase-total.muted{color:#75827f;font-size:32rpx}.amount-state{max-width:240rpx;color:#70675f;font-size:21rpx;line-height:1.45;text-align:right}.amount-groups{display:grid;grid-template-columns:repeat(3,1fr);margin-top:14rpx;border:1rpx solid #e7edeb;border-radius:12rpx;overflow:hidden}.amount-group{padding:16rpx 8rpx;text-align:center;border-right:1rpx solid #e7edeb;background:#fbfcfc}.amount-group:last-child{border-right:0}.amount-group text{display:block}.group-name{color:#697874;font-size:20rpx}.group-value{margin-top:5rpx;color:#263733;font-size:25rpx;font-weight:700}.group-count{margin-top:3rpx;color:#8a9693;font-size:18rpx}.amount-alerts{margin-top:14rpx}.amount-notice{margin-top:9rpx;padding:11rpx 13rpx;border-left:5rpx solid #d7a33d;border-radius:4rpx;background:#fff8e9;color:#77551b;font-size:21rpx;line-height:1.5}.amount-notice.neutral{border-color:#5c998e;background:#f1f8f6;color:#41635b}.amount-notice.separate{border-color:#9c8a72;background:#f8f5f0;color:#695d4e}.amount-notice.conflict{border-color:#b95b4d;background:#fff1ef;color:#8e392f}.performance-entry{gap:14rpx;margin-top:17rpx;padding:16rpx;border:1rpx solid #d8e8e3;border-radius:12rpx;background:#f2f9f7}.performance-icon{width:52rpx;height:52rpx;border-radius:14rpx;background:#178b78;color:#fff;font-size:23rpx;font-weight:700}.performance-copy{flex:1}.performance-title,.performance-note{display:block}.performance-title{color:#166f60;font-size:25rpx;font-weight:700}.performance-note{margin-top:4rpx;color:#6c7d78;font-size:19rpx}.performance-arrow{color:#178b78;font-size:38rpx}.stock-in-line{gap:20rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #edf1ef}.stock-label,.stock-note{display:block}.stock-label{color:#41504c;font-size:23rpx}.stock-note{margin-top:4rpx;color:#8a9693;font-size:19rpx}.stock-value{color:#53635f;font-size:25rpx;font-weight:650}

.structure-module{padding-bottom:10rpx}.structure-block{margin-bottom:13rpx;padding:16rpx;border:1rpx solid #e4ebe8;border-radius:13rpx;background:#fafcfb}.structure-heading{justify-content:flex-start;gap:12rpx;margin-bottom:12rpx}.structure-icon{width:48rpx;height:48rpx;border-radius:12rpx;color:#fff;font-size:20rpx;font-weight:700}.structure-icon.source{background:#5a91ad}.structure-icon.method{background:#41907f}.structure-icon.delivery{background:#8a765f}.structure-title,.structure-note{display:block}.structure-title{color:#2c403b;font-size:25rpx;font-weight:700}.structure-note{margin-top:2rpx;color:#82908c;font-size:19rpx}.structure-row{min-height:52rpx;padding:0 4rpx;border-top:1rpx solid #edf1ef;color:#4c5e59;font-size:22rpx}.structure-row text:last-child{color:#1e7867;font-weight:650;text-align:right}

.pending-root{padding:22rpx}.pending-root-head{align-items:flex-start;gap:16rpx}.pending-root-total,.pending-count{min-width:46rpx;height:46rpx;border-radius:23rpx;line-height:46rpx;text-align:center;background:#168672;color:#fff;font-size:21rpx}.pending-state{padding:44rpx 12rpx;text-align:center;color:#778681}.pending-state text{display:block;margin-top:10rpx}.pending-state.success{color:#168672}.pending-section{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #e6eeeb}.pending-title{display:block;color:#263a35;font-size:27rpx;font-weight:700}.pending-note{display:block;margin-top:4rpx;color:#74837f;font-size:20rpx;line-height:1.45}.pending-count.waiting{background:#81918e}.pending-count.blocked{background:#c25f3d}.pending-count.history{background:#8b8b8b}.pending-item{margin-top:14rpx;padding:17rpx;border:1rpx solid #e5ece9;border-radius:12rpx;background:#fafcfb}.pending-item-head{align-items:flex-start;gap:14rpx}.pending-subject,.pending-event{display:block;color:#193d36;font-weight:700}.pending-subject{font-size:26rpx}.pending-event{margin-top:13rpx;font-size:23rpx}.pending-meta{display:block;margin-top:5rpx;color:#83918e;font-size:19rpx}.pending-status{padding:5rpx 9rpx;border-radius:6rpx;background:#fff1d2;color:#875200;font-size:19rpx;white-space:nowrap}.pending-fact{display:flex;margin-top:11rpx;font-size:21rpx;line-height:1.55}.pending-fact text:first-child{width:120rpx;flex:none;color:#758682}.pending-fact text:last-child{color:#344f49}.pending-owner{display:block;margin-top:11rpx;padding:9rpx 11rpx;border-radius:6rpx;background:#eef6f3;color:#536a64;font-size:21rpx}.pending-actions{display:flex;justify-content:flex-end;margin-top:13rpx}.pending-actions button{margin:0 0 0 12rpx;padding:0 20rpx;height:58rpx;line-height:58rpx;border-radius:8rpx;background:#e7f5f1;color:#118c76;font-size:21rpx}.pending-no-action{display:block;margin-top:11rpx;color:#8a7770;font-size:19rpx}.assignment-mask{position:fixed;inset:0;z-index:90;display:flex;align-items:flex-end;background:rgba(0,0,0,.46)}.assignment-panel{width:100%;max-height:72vh;padding:24rpx;box-sizing:border-box;background:#fff}.assignment-title{display:block;font-size:30rpx;font-weight:700}.assignment-subject{display:block;margin-top:5rpx;color:#6d807c;font-size:22rpx}.assignment-note{display:block;margin:18rpx 0;padding:14rpx;background:#eef7f5;color:#48645e;font-size:21rpx}.purchaser-list{max-height:46vh}.purchaser-row{align-items:flex-start;gap:16rpx;padding:20rpx 4rpx;border-top:1rpx solid #e8eeec;color:#118c76}.purchaser-name{display:block;color:#173f36;font-size:26rpx}.purchaser-status{display:block;margin-top:4rpx;color:#7d8c89;font-size:20rpx}.bottom-space{height:34rpx}
