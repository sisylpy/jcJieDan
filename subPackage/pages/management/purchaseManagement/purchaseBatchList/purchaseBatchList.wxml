<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购批次" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" scroll-top="{{scrollTop}}" bindscroll="recordScroll" bindscrolltolower="more">
    <view class="query-panel">
      <view class="date-row">
        <picker mode="date" value="{{startDate}}" bindchange="changeStart"><text class="date-value">{{startDate}}</text></picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{stopDate}}" bindchange="changeStop"><text class="date-value">{{stopDate}}</text></picker>
      </view>
      <view class="search-row">
        <input class="search-input" value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="搜索商品、供应方或批次编号"></input>
        <text class="search-button" bindtap="search">搜索</text>
      </view>
      <view class="purpose-tabs">
        <text class="purpose-tab {{!purchasePurpose?'on':''}}" data-value="" bindtap="choosePurpose">全部</text>
        <text class="purpose-tab {{purchasePurpose==='CUSTOMER_ORDER'?'on':''}}" data-value="CUSTOMER_ORDER" bindtap="choosePurpose">客户订单订货</text>
        <text class="purpose-tab {{purchasePurpose==='INVENTORY_REPLENISHMENT'?'on':''}}" data-value="INVENTORY_REPLENISHMENT" bindtap="choosePurpose">库存备货</text>
        <text class="purpose-tab {{purchasePurpose==='UNRESOLVED'?'on':''}}" data-value="UNRESOLVED" bindtap="choosePurpose">用途待核对</text>
      </view>
      <view class="compact-filters">
        <picker mode="selector" range="{{supplierOptions}}" range-key="supplierName" value="{{supplierIndex}}" bindchange="changeSupplier"><text class="filter-value">{{supplierOptions[supplierIndex].supplierName}}⌄</text></picker>
        <picker mode="selector" range="{{sortOptions}}" range-key="name" value="{{sortIndex}}" bindchange="changeSort"><text class="filter-value">{{sortOptions[sortIndex].name}}⌄</text></picker>
      </view>
    </view>

    <view wx:if="{{error}}" class="state-panel error-state"><text>采购批次加载失败</text><text class="state-detail">{{error}}</text><text class="retry-button" bindtap="retry">重新加载</text></view>
    <view wx:elif="{{!loading&&!items.length}}" class="state-panel">当前条件下没有采购批次</view>

    <view class="batch-card" wx:for="{{items}}" wx:key="batchId" data-id="{{item.batchId}}" bindtap="open">
      <view class="card-head"><view class="head-left"><text class="purpose-badge {{item.purchasePurpose==='UNRESOLVED'?'warn':''}}">{{item.purchasePurposeText}}</text><text class="batch-number">{{item.batchNumber}}</text></view><text class="business-date">{{item.businessDate}} ›</text></view>
      <view class="supplier-row"><text class="supplier-name">{{item.supplierName||item.purchaseKindText}}</text><text class="progress-text">{{item.businessProgressText}}</text></view>
      <text class="goods-summary">{{item.goodsSummary||'商品信息待核对'}}<text wx:if="{{item.goodsLineCount}}"> · {{item.goodsLineCount}}条商品记录</text></text>
      <view class="amount-row"><text class="amount-label">{{item.supplyAmountLabel}}</text><text wx:if="{{item.recognizedSupplyAmount!=null}}" class="amount-value">¥{{item.recognizedSupplyAmount}}</text><text wx:elif="{{item.supplyAmountStatus==='UNRESOLVED'}}" class="amount-pending">金额待核对</text><text wx:else class="amount-pending">金额尚未形成</text></view>
      <view wx:if="{{item.supplyAmountStatus==='PARTIAL'}}" class="notice">部分商品金额待核对，以上仅合计已识别金额</view>
      <view wx:if="{{item.purchasePurpose==='UNRESOLVED'}}" class="notice">采购用途来源不完整，暂不归入客户订单订货或库存备货</view>
    </view>
    <view wx:if="{{loading}}" class="loading-state">正在加载…</view>
    <view wx:if="{{!loading&&items.length&&items.length>=total}}" class="end-state">已显示全部采购批次</view>
  </scroll-view>
</view>
