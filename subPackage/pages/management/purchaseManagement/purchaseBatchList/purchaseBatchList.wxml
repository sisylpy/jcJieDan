<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购批次" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
    <view class="pm-card">
      <view class="pm-row"><input class="search" value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="search" placeholder="搜索商品"></input><text class="pm-button" bindtap="search">查询</text><text class="pm-link" bindtap="toggle">{{filtersOpen?'收起':'筛选'}}</text></view>
      <view class="filters {{filtersOpen?'open':''}}">
        <text class="pm-label">采购员 / 供应商</text>
        <view class="pm-row"><picker mode="selector" range="{{purchaserOptions}}" range-key="name" value="{{purchaserIndex}}" bindchange="changePurchaser"><text class="pm-date">{{purchaserOptions[purchaserIndex].name}}</text></picker><picker mode="selector" range="{{supplierOptions}}" range-key="name" value="{{supplierIndex}}" bindchange="changeSupplier"><text class="pm-date">{{supplierOptions[supplierIndex].name}}</text></picker></view>
        <text class="pm-label">需求来源</text><view class="pm-tabs"><text class="pm-tab {{!demandSource?'on':''}}" data-key="demandSource" data-value="" bindtap="choose">全部</text><text class="pm-tab {{demandSource==='ORDER_GENERATED'?'on':''}}" data-key="demandSource" data-value="ORDER_GENERATED" bindtap="choose">订单</text><text class="pm-tab {{demandSource==='SHELF_REPLENISHMENT'?'on':''}}" data-key="demandSource" data-value="SHELF_REPLENISHMENT" bindtap="choose">货架</text><text class="pm-tab {{demandSource==='SMART_REPLENISHMENT'?'on':''}}" data-key="demandSource" data-value="SMART_REPLENISHMENT" bindtap="choose">智能</text></view>
        <text class="pm-label">采购方式</text><view class="pm-tabs"><text class="pm-tab {{!procurementMode?'on':''}}" data-key="procurementMode" data-value="" bindtap="choose">全部</text><text class="pm-tab {{procurementMode==='SELF_BUY'?'on':''}}" data-key="procurementMode" data-value="SELF_BUY" bindtap="choose">自采</text><text class="pm-tab {{procurementMode==='AUTO_SUPPLIER'?'on':''}}" data-key="procurementMode" data-value="AUTO_SUPPLIER" bindtap="choose">自动供应商</text><text class="pm-tab {{procurementMode==='EXTERNAL_SUPPLIER'?'on':''}}" data-key="procurementMode" data-value="EXTERNAL_SUPPLIER" bindtap="choose">外部供应商</text></view>
        <text class="pm-label">履约模式</text><view class="pm-tabs"><text class="pm-tab {{!fulfillmentMode?'on':''}}" data-key="fulfillmentMode" data-value="" bindtap="choose">全部</text><text class="pm-tab {{fulfillmentMode==='WAREHOUSE_STOCK'?'on':''}}" data-key="fulfillmentMode" data-value="WAREHOUSE_STOCK" bindtap="choose">库房</text><text class="pm-tab {{fulfillmentMode==='ORDER_PURCHASE'?'on':''}}" data-key="fulfillmentMode" data-value="ORDER_PURCHASE" bindtap="choose">对外采购</text></view>
        <text class="pm-label">收货状态</text><view class="pm-tabs"><text class="pm-tab {{!receiptStatus?'on':''}}" data-key="receiptStatus" data-value="" bindtap="choose">全部</text><text class="pm-tab {{receiptStatus==='NOT_RECEIVED'?'on':''}}" data-key="receiptStatus" data-value="NOT_RECEIVED" bindtap="choose">未收货</text><text class="pm-tab {{receiptStatus==='PARTIALLY_RECEIVED'?'on':''}}" data-key="receiptStatus" data-value="PARTIALLY_RECEIVED" bindtap="choose">部分收货</text><text class="pm-tab {{receiptStatus==='RECEIVED'?'on':''}}" data-key="receiptStatus" data-value="RECEIVED" bindtap="choose">已收货</text></view>
        <text class="pm-label">入库状态</text><view class="pm-tabs"><text class="pm-tab {{!putawayStatus?'on':''}}" data-key="putawayStatus" data-value="" bindtap="choose">全部</text><text class="pm-tab {{putawayStatus==='NOT_PUT_AWAY'?'on':''}}" data-key="putawayStatus" data-value="NOT_PUT_AWAY" bindtap="choose">待入库</text><text class="pm-tab {{putawayStatus==='PARTIALLY_PUT_AWAY'?'on':''}}" data-key="putawayStatus" data-value="PARTIALLY_PUT_AWAY" bindtap="choose">部分入库</text><text class="pm-tab {{putawayStatus==='COMPLETED'?'on':''}}" data-key="putawayStatus" data-value="COMPLETED" bindtap="choose">已入库</text><text class="pm-tab {{putawayStatus==='NOT_REQUIRED'?'on':''}}" data-key="putawayStatus" data-value="NOT_REQUIRED" bindtap="choose">无需入库</text></view>
        <text class="pm-label">退货状态</text><view class="pm-tabs"><text class="pm-tab {{!returnStatus?'on':''}}" data-key="returnStatus" data-value="" bindtap="choose">全部</text><text class="pm-tab {{returnStatus==='CONFIRMED'?'on':''}}" data-key="returnStatus" data-value="CONFIRMED" bindtap="choose">有退货</text><text class="pm-tab {{returnStatus==='NONE'?'on':''}}" data-key="returnStatus" data-value="NONE" bindtap="choose">无退货</text></view>
        <text class="pm-label">事实标记</text><view class="pm-tabs"><text class="pm-tab {{hasLoss==='true'?'on':''}}" data-key="hasLoss" data-value="true" bindtap="choose">有损耗</text><text class="pm-tab {{hasMarkdown==='true'?'on':''}}" data-key="hasMarkdown" data-value="true" bindtap="choose">有调价</text><text class="pm-tab {{hasException==='true'?'on':''}}" data-key="hasException" data-value="true" bindtap="choose">有异常</text><text class="pm-tab {{!hasLoss&&!hasMarkdown&&!hasException?'on':''}}" bindtap="resetFacts">清除</text></view>
      </view>
    </view>
    <view wx:if="{{error}}" class="pm-state">{{error}}</view><view wx:if="{{!loading&&!items.length&&!error}}" class="pm-state">当前筛选暂无采购批次</view>
    <view class="pm-card batch" wx:for="{{items}}" wx:key="batchId" data-id="{{item.batchId}}" bindtap="open"><view class="pm-row"><text class="pm-name">{{item.batchNumber}}</text><text class="pm-link">{{item.businessDate}} ›</text></view><text class="pm-muted">{{item.purchaserName||'待分配'}} · {{item.supplierName||'自采/无固定供应商'}} · {{item.procurementModeText}}</text><text class="pm-muted">来源 {{item.demandSources||'未解析'}} · 履约 {{item.fulfillmentModes||'未解析'}}</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">商品行 / 计划</text><text>{{item.goodsLineCount}} / ¥{{item.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际收货 / 净采购</text><text>{{item.actualReceiptAmount==null?'—':'¥'}}{{item.actualReceiptAmount}} / {{item.actualNetPurchaseAmount==null?'—':'¥'}}{{item.actualNetPurchaseAmount}}</text></view><view class="pm-metric"><text class="pm-label">收货 / 入库</text><text>{{item.receiptStatusText}} / {{item.putawayStatusText}}</text></view><view class="pm-metric"><text class="pm-label">当前 / 最终毛利</text><text>{{item.currentRealizedMargin==null?'—':'¥'}}{{item.currentRealizedMargin}} / {{item.finalMargin==null?'—':'¥'}}{{item.finalMargin}}</text></view></view><text class="pm-badge {{item.hasException?'warn':''}}">{{item.dataCompletenessText}}</text></view>
    <view wx:if="{{loading}}" class="pm-state">正在加载…</view>
  </scroll-view>
</view>
