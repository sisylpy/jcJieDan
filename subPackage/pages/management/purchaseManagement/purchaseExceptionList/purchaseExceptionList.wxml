<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购待办与异常" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more"><view class="pm-tabs"><text class="pm-tab {{!type?'on':''}}" data-value="" bindtap="choose">全部</text><text class="pm-tab {{type==='UNASSIGNED_PURCHASER'?'on':''}}" data-value="UNASSIGNED_PURCHASER" bindtap="choose">待分配</text><text class="pm-tab {{type==='RECEIPT_VARIANCE'?'on':''}}" data-value="RECEIPT_VARIANCE" bindtap="choose">收货差异</text><text class="pm-tab {{type==='INVENTORY_QUANTITY_NOT_CONSERVED'?'on':''}}" data-value="INVENTORY_QUANTITY_NOT_CONSERVED" bindtap="choose">数量不守恒</text><text class="pm-tab {{type==='LEGACY_DATA_INCOMPLETE'?'on':''}}" data-value="LEGACY_DATA_INCOMPLETE" bindtap="choose">历史数据</text></view><view wx:if="{{error}}" class="pm-state">{{error}}</view><view wx:if="{{!loading&&!items.length&&!error}}" class="pm-state">当前没有此类待办或异常</view><view class="pm-card"><view class="exception" wx:for="{{items}}" wx:key="index" data-resource="{{item.resourceType}}" data-id="{{item.resourceId}}" bindtap="open"><view class="pm-row"><text class="pm-name">{{item.title}}</text><text class="pm-badge {{item.statusCode==='BLOCKED'?'error':'warn'}}">{{item.statusText}}</text></view><text class="pm-muted">{{item.exceptionTypeText}} · {{item.businessDate||'实时待办'}} · {{item.resourceType}} #{{item.resourceId}}</text><text class="pm-link">查看或前往现有处理入口 ›</text></view></view><view wx:if="{{loading}}" class="pm-state">正在加载…</view></scroll-view></view>
