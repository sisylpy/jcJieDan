<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="外部供应商协同" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" refresher-enabled refresher-triggered="{{loading}}" bindrefresherrefresh="onPullDownRefresh">
    <view class="pm-tabs"><text class="pm-tab {{tab==='BATCH'?'on':''}}" data-tab="BATCH" bindtap="switchTab">自动批次</text><text class="pm-tab {{tab==='RELATION'?'on':''}}" data-tab="RELATION" bindtap="switchTab">外部关系</text><text class="pm-tab {{tab==='INVITE'?'on':''}}" data-tab="INVITE" bindtap="switchTab">邀请记录</text></view>
    <view class="pm-card pm-row"><view><text class="pm-name">外部供应商邀请与供货协同</text><text class="pm-muted block">适用于没有老板端配送商身份、通过精彩订货供货的外部供应商</text></view><button size="mini" class="plain-button" bindtap="openInvite">邀请外部供应商</button></view><view wx:if="{{invitationToken}}" class="pm-card pm-row"><text class="ready">新的外部供应商安全邀请已生成</text><view class="invite-actions"><button size="mini" data-token="{{invitationToken}}" bindtap="copyTokenValue">复制路径</button><button size="mini" type="primary" bindtap="openInvitation">打开精彩订货</button></view></view>
    <view wx:if="{{error}}" class="pm-state">{{error}}</view>
    <view wx:if="{{!loading&&!error&&tab==='BATCH'&&!batches.length}}" class="pm-state">暂无自动订货批次</view>
    <view wx:for="{{batches}}" wx:key="batchId" wx:if="{{tab==='BATCH'}}" class="pm-card" data-id="{{item.batchId}}" bindtap="openBatch">
      <view class="pm-row"><text class="pm-name">批次 #{{item.batchId}} · {{item.supplierName}}</text><text class="pm-link">详情 ›</text></view>
      <text class="pm-muted block">{{item.businessDate||'—'}} / 到货 {{item.needDate||'—'}} · 负责人 {{item.purchaserUserId||'待分配'}}</text>
      <view class="status-line"><text>激活 {{item.activationStatus}}</text><text>投递 {{item.deliveryStatus}}</text><text>接单 {{item.receiptStatus}}</text><text>备货 {{item.preparationStatus}}</text><text>发货 {{item.shipmentStatus}}</text><text>买方收货 {{item.buyerReceiptStatus||'—'}}</text></view>
      <text wx:if="{{item.remainingStatus==='ACTION_REQUIRED'}}" class="warning">存在未满足需求，待处理</text>
    </view>
    <view wx:for="{{relations}}" wx:key="supplierRelationId" wx:if="{{tab==='RELATION'}}" class="pm-card">
      <view class="pm-row"><text class="pm-name">{{item.supplierName}}</text><text class="pm-badge {{item.activationStatus!=='ACTIVE'?'warn':''}}">{{item.activationStatus||'LEGACY_ONLY'}}</text></view>
      <text class="pm-muted block">首次邀请人：{{item.invitedByUserId||'历史未记录'}} · 当前负责人：{{item.responsiblePurchaserUserId||'待分配'}}</text>
      <text class="pm-muted block">邀请状态：{{item.invitationStatus||'未邀请'}} · 供应商账号：{{item.sellerJrdhUserId||'未绑定'}}</text><text class="{{item.automaticOrderReady?'ready':'warning'}}">自动订货：{{item.automaticOrderReady?'可执行':item.automaticOrderBlockedReason}}</text>
      <picker range="{{purchasers}}" range-key="purchaserName" data-id="{{item.supplierRelationId}}" bindchange="choosePurchaser"><text class="pm-link">设置/交接负责人（只影响新批次）</text></picker>
    </view>
    <view wx:for="{{invitations}}" wx:key="invitationId" wx:if="{{tab==='INVITE'}}" class="pm-card">
      <view class="pm-row"><text class="pm-name">{{item.supplierName}}</text><text class="pm-badge">{{item.invitationStatus}}</text></view>
      <text class="pm-muted block">邀请人 {{item.invitedByUserId}} · 当前负责人 {{item.responsiblePurchaserUserId||'待分配'}}</text><text class="pm-muted block">{{item.targetContact||'未填联系方式'}} · 到期 {{item.expiresAt}}</text><button wx:if="{{item.invitationStatus==='PENDING'}}" size="mini" data-id="{{item.invitationId}}" bindtap="reissue">重新生成安全邀请</button>
    </view>
  </scroll-view>
</view>

<view wx:if="{{showInvite}}" class="dialog-mask"><view class="dialog"><text class="pm-section-title">邀请外部供应商进入精彩订货</text><text wx:if="{{supplierRelationId}}" class="pm-muted block">将为现有外部供应商关系生成激活邀请，不会新建重复关系。</text><input class="field" placeholder="外部供应商名称（必填）" data-field="supplierName" bindinput="input" value="{{supplierName}}"/><input class="field" placeholder="联系人或手机号" data-field="targetContact" bindinput="input" value="{{targetContact}}"/><input class="field" type="number" placeholder="配送商商品ID（可选，绑定自动订货）" data-field="goodsId" bindinput="input" value="{{goodsId}}"/><text class="pm-muted block">邀请人将初始化为当前负责人；交接不会改写历史批次。拥有老板端配送商身份的伙伴请使用“协作配送商”入口。</text><view class="dialog-actions"><button size="mini" bindtap="closeInvite">取消</button><button size="mini" type="primary" bindtap="submitInvite">生成外部供应商邀请</button></view></view></view>

<view wx:if="{{detail}}" class="dialog-mask"><scroll-view scroll-y class="detail-panel"><view class="pm-row"><text class="pm-section-title">批次 #{{detail.batchId}}</text><text class="pm-link" bindtap="closeDetail">关闭</text></view><text class="pm-muted block">{{detail.supplierName}} · 负责人 {{detail.purchaserUserId}} · 投递 {{detail.deliveryStatus}}</text><view class="status-line"><text>接单 {{detail.receiptStatus}}</text><text>备货 {{detail.preparationStatus}}</text><text>发货 {{detail.shipmentStatus}}</text><text>买方收货 {{detail.buyerReceiptStatus||'—'}}</text></view><view wx:for="{{detail.lines}}" wx:key="purchaseGoodsId" class="line-card"><text class="pm-name">{{item.goodsName}} <text class="pm-spec">{{item.standard}}</text></text><text class="pm-muted block">来源 {{item.demandSource}} · 需求 {{item.requestedQuantity}} · 可供 {{item.availableQuantity==null?'待回复':item.availableQuantity}} · 缺货 {{item.shortageQuantity||0}} · 已发 {{item.shippedQuantity||0}}</text><text wx:if="{{item.shortageReason}}" class="warning">缺货原因：{{item.shortageReason}}</text><view wx:if="{{item.shortageQuantity>0}}" class="actions"><button size="mini" data-goods="{{item.purchaseGoodsId}}" data-action="WAIT" bindtap="actRemaining">继续等待</button><button size="mini" data-goods="{{item.purchaseGoodsId}}" data-action="SELF_BUY" bindtap="actRemaining">转自采</button><button size="mini" data-goods="{{item.purchaseGoodsId}}" data-action="CANCEL" bindtap="actRemaining">取消剩余</button></view></view><input class="field" type="number" placeholder="更换供应商时填写新关系ID" data-field="replacementSupplierRelationId" bindinput="input" value="{{replacementSupplierRelationId}}"/><view wx:for="{{detail.lines}}" wx:key="purchaseGoodsId"><button wx:if="{{item.shortageQuantity>0}}" size="mini" data-goods="{{item.purchaseGoodsId}}" data-action="CHANGE_SUPPLIER" bindtap="actRemaining">将 {{item.goodsName}} 更换供应商</button></view></scroll-view></view>
