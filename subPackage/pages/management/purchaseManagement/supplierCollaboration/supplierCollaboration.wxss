@import "../common.wxss";
.block{display:block;margin-top:8rpx}.status-line,.invite-actions{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:14rpx}.status-line text{font-size:21rpx;color:#40534e;background:#eef4f2;padding:5rpx 8rpx}.warning,.ready{display:block;font-size:22rpx;margin-top:10rpx}.warning{color:#a85c00}.ready{color:#11735f}.invite-actions{margin-top:0}.invite-actions button{margin:0;border-radius:4rpx}.plain-button{margin:0;background:#157f6d;color:#fff;border-radius:4rpx}.dialog-mask{position:fixed;z-index:30;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.dialog,.detail-panel{width:100%;box-sizing:border-box;background:#fff;padding:26rpx 22rpx 42rpx}.detail-panel{max-height:84vh}.field{height:72rpx;border:1rpx solid #dce5e2;padding:0 18rpx;margin:14rpx 0;font-size:25rpx}.dialog-actions,.actions{display:flex;gap:12rpx;margin-top:20rpx}.dialog-actions button,.actions button{margin:0;border-radius:4rpx}.line-card{border-top:1rpx solid #e5ece9;padding:18rpx 0}
