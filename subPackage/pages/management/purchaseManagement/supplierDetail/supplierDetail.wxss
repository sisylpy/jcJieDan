@import "../common.wxss";

.detail-scroll{height:100%;box-sizing:border-box}.detail-body{padding:16rpx 20rpx 48rpx}.summary-card,.record-card,.goods-card{background:#fff;border:1rpx solid #dfe8e4}.summary-card{padding:22rpx}.identity-row,.identity{display:flex;align-items:flex-start}.identity-row{justify-content:space-between;gap:16rpx}.identity{align-items:center;flex-wrap:wrap;gap:9rpx;min-width:0}.supplier-name{font-size:32rpx;font-weight:700;color:#22332e}.type-badge,.relation-badge{padding:4rpx 10rpx;font-size:20rpx;line-height:1.4}.type-badge.internal{color:#116f61;background:#e9f5f1}.type-badge.external{color:#9a6020;background:#fff3e2}.relation-badge{color:#8e5f22;background:#fff8e9}.data-note-link{color:#157f6d;font-size:23rpx;white-space:nowrap}.period-text{display:block;margin-top:14rpx;color:#6d7d78;font-size:23rpx}.summary-amount{display:flex;align-items:baseline;justify-content:space-between;margin-top:22rpx;color:#667671;font-size:24rpx}.amount-value{color:#d25c2f;font-size:38rpx;font-weight:750}.amount-value.muted{color:#9a6020;font-size:29rpx}.summary-meta{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx;margin-top:16rpx;color:#667671;font-size:22rpx;line-height:1.7}.amount-note{margin-top:14rpx;padding:12rpx 14rpx;background:#fff8e9;color:#855b1b;font-size:22rpx;line-height:1.5}.amount-note.no-record{background:#f3f6f5;color:#697873}.manage-button{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:15rpx 2rpx 2rpx;border-top:1rpx solid #e8eeeb;color:#157f6d;font-size:25rpx}.detail-tabs{display:flex;margin-top:14rpx;background:#fff;border:1rpx solid #dfe8e4}.detail-tab{position:relative;flex:1;padding:20rpx 0;text-align:center;color:#667671;font-size:26rpx}.detail-tab.active{color:#157f6d;font-weight:700}.detail-tab.active:after{content:'';position:absolute;left:26%;right:26%;bottom:0;height:4rpx;background:#157f6d}.tab-content{margin-top:12rpx}.record-card,.goods-card{margin-bottom:12rpx;padding:20rpx}.record-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.goods-title{display:flex;align-items:baseline;flex-wrap:wrap;gap:9rpx;color:#263732;font-size:28rpx;font-weight:700}.goods-spec{color:#71807c;font-size:21rpx;font-weight:400}.record-date{color:#71807c;font-size:22rpx;white-space:nowrap}.record-values{display:grid;grid-template-columns:repeat(2,1fr);column-gap:26rpx;row-gap:14rpx;margin-top:18rpx}.value-item{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx;font-size:24rpx}.value-label{color:#71807c;font-size:21rpx}.money-text{color:#d25c2f;font-weight:700}.record-status{margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #edf1ef;color:#3d5d55;font-size:22rpx}.record-status.cancelled{color:#7f8986}.record-warning{margin-top:12rpx;padding:11rpx 13rpx;border-left:4rpx solid #d79432;background:#fff8e9;color:#855b1b;font-size:22rpx;line-height:1.5}.source-toggle{display:flex;align-items:center;justify-content:space-between;margin-top:15rpx;color:#157f6d;font-size:23rpx}.source-detail{margin-top:13rpx;padding:14rpx 16rpx;background:#f5f8f7;color:#52645e;font-size:22rpx}.source-title{display:block;margin-bottom:9rpx;color:#30423d;font-weight:700}.source-line{display:flex;justify-content:space-between;padding:6rpx 0}.source-copy{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding-top:8rpx}.source-copy text:last-child{max-width:68%;text-align:right;line-height:1.5}.goods-meta{margin-top:12rpx}.empty-panel,.state-panel,.loading-state{padding:90rpx 24rpx;text-align:center;color:#74827e;font-size:24rpx}.state-panel text{display:block}.state-title{font-size:28rpx;color:#34443f;font-weight:650}.state-copy{margin-top:14rpx;font-size:23rpx;line-height:1.6}.state-button{display:inline-block!important;margin-top:24rpx;padding:12rpx 24rpx;background:#157f6d;color:#fff;font-size:24rpx}.loading-state{padding:32rpx}.load-more{padding:24rpx;text-align:center;color:#157f6d;font-size:23rpx}.sheet-mask{position:fixed;z-index:1000;left:0;right:0;top:0;bottom:0;background:rgba(22,35,31,.4);display:flex;align-items:flex-end}.bottom-sheet{width:100%;padding:26rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;border-radius:14rpx 14rpx 0 0}.sheet-title{padding-bottom:18rpx;border-bottom:1rpx solid #e8eeeb;color:#24342f;font-size:30rpx;font-weight:700}.sheet-copy{display:block;margin-top:18rpx;color:#53655f;font-size:24rpx;line-height:1.7}.sheet-close{margin-top:24rpx;padding:15rpx;text-align:center;background:#f0f5f3;color:#157f6d;font-size:25rpx}
