<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="待接收入库" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
    <view class="receive-intro">
      <text class="intro-title">采购完成，按采购员接收入库</text>
      <text class="intro-copy">这里按采购员汇总已经完成采购、但老板尚未接收入库的商品。直接在本页打开入库弹窗，接收完成后商品会自动移出清单。</text>
      <view class="intro-summary"><text>{{total}} 件待接收</text><text>{{purchaserGroups.length}} 位采购员</text></view>
    </view>

    <view wx:if="{{error}}" class="pm-state error-state"><text>{{error}}</text><text class="retry" bindtap="retry">重新加载</text></view>
    <view wx:elif="{{!loading&&!items.length}}" class="pm-state"><text>当前没有待接收入库商品</text></view>

    <view class="purchaser-group" wx:for="{{purchaserGroups}}" wx:key="purchaserKey" wx:for-item="group">
      <view class="purchaser-heading">
        <view class="purchaser-avatar">{{group.purchaserInitial}}</view>
        <view class="purchaser-copy">
          <text class="purchaser-name">{{group.purchaserName}}</text>
          <text class="purchaser-note">以下商品尚未接收入库</text>
        </view>
        <text class="purchaser-count">{{group.itemCount}} 件</text>
      </view>

      <view class="receive-card" wx:for="{{group.items}}" wx:key="purchaseGoodsId" wx:for-item="item">
        <view class="receive-heading"><view><text class="goods-name">{{item.goodsName}}</text><text wx:if="{{item.specification}}" class="goods-spec">{{item.specification}}</text></view><text class="goods-amount">{{item.amountText}}</text></view>
        <text class="stage-label">{{item.waitingStageText}}</text>
        <view class="detail-grid"><view><text class="field-label">采购数量</text><text class="field-value">{{item.quantityText}}</text></view><view><text class="field-label">采购单价</text><text class="field-value">{{item.unitPriceText}}</text></view><view><text class="field-label">采购日期</text><text class="field-value">{{item.businessDate||'待核对'}}</text></view><view><text class="field-label">采购用途</text><text class="field-value purpose">{{item.purchasePurposeText}}</text></view></view>
        <view class="location-line"><text>{{item.shelfText}}</text></view>
        <view class="receive-action {{receiptLoadingId==item.purchaseGoodsId?'is-loading':''}}" data-purchase-goods-id="{{item.purchaseGoodsId}}" bindtap="openReceipt">{{receiptLoadingId==item.purchaseGoodsId?'正在加载…':item.actionText}}</view>
      </view>
    </view>

    <view wx:if="{{loading||loadingMore}}" class="pm-state small-state">正在加载…</view>
    <view wx:elif="{{items.length&&items.length>=total}}" class="pm-state small-state">已显示全部待接收商品</view>
  </scroll-view>

  <input-pur-stock show="{{showInputPurStock}}" receipt-only="{{true}}" show-wait-option="{{false}}" bindconfirm="confirmInputPurStock" bindcancle="cancleInputPurStock" item="{{receiptItem}}" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}" />
</view>
