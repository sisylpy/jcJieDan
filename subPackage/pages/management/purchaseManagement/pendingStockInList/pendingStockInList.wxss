@import "../common.wxss";
.receive-intro{margin-bottom:16rpx;padding:22rpx;background:#eaf7f4;border-left:6rpx solid #178b78}.intro-title,.intro-copy{display:block}.intro-title{color:#173f37;font-size:29rpx;font-weight:700}.intro-copy{margin-top:9rpx;color:#526b65;font-size:22rpx;line-height:1.55}.intro-summary{display:flex;justify-content:space-between;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #cfe7e1;color:#147967;font-size:22rpx}.receive-card{margin-bottom:14rpx;padding:22rpx;background:#fff;border:1rpx solid #e1e9e6}.receive-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.goods-name{font-size:29rpx;font-weight:700;color:#21312e}.goods-spec{display:block;margin-top:5rpx;color:#778580;font-size:21rpx}.goods-amount{color:#d25c2f;font-size:29rpx;font-weight:700}.stage-label{display:block;margin-top:14rpx;padding:9rpx 12rpx;background:#fff7e6;border-left:4rpx solid #d8a13c;color:#77551b;font-size:21rpx}.detail-grid{display:grid;grid-template-columns:1fr 1fr;margin-top:18rpx;border-top:1rpx solid #edf1ef;border-left:1rpx solid #edf1ef}.detail-grid view{padding:13rpx;border-right:1rpx solid #edf1ef;border-bottom:1rpx solid #edf1ef}.field-label,.field-value{display:block}.field-label{color:#84908d;font-size:19rpx}.field-value{margin-top:5rpx;color:#34433f;font-size:23rpx}.location-line{display:flex;justify-content:space-between;gap:18rpx;margin-top:14rpx;color:#6f7e7a;font-size:21rpx}.purpose{color:#147967;white-space:nowrap}.receive-action{margin-top:18rpx;padding:16rpx;text-align:center;background:#178b78;color:#fff;font-size:25rpx}.error-state .retry{display:block;margin-top:12rpx;color:#147967}.small-state{padding:18rpx}
