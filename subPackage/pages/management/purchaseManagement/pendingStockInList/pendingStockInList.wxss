@import "../common.wxss";
.receive-intro{margin-bottom:18rpx;padding:22rpx;background:#eaf7f4;border-left:6rpx solid #178b78}.intro-title,.intro-copy{display:block}.intro-title{color:#173f37;font-size:29rpx;font-weight:700}.intro-copy{margin-top:9rpx;color:#526b65;font-size:22rpx;line-height:1.55}.intro-summary{display:flex;justify-content:space-between;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #cfe7e1;color:#147967;font-size:22rpx}
.purchaser-group{margin-bottom:22rpx;padding:0 14rpx 2rpx;background:#f0f6f4;border-radius:10rpx}.purchaser-heading{display:flex;align-items:center;padding:18rpx 8rpx}.purchaser-avatar{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin-right:14rpx;border-radius:50%;background:#178b78;color:#fff;font-size:25rpx;font-weight:700}.purchaser-copy{display:flex;flex:1;min-width:0;flex-direction:column}.purchaser-name{color:#173f37;font-size:27rpx;font-weight:700}.purchaser-note{margin-top:4rpx;color:#7b8b86;font-size:19rpx}.purchaser-count{padding:7rpx 13rpx;border-radius:999rpx;background:#d9ebe6;color:#147967;font-size:21rpx;font-weight:600}
.receive-card{margin-bottom:14rpx;padding:22rpx;background:#fff;border:1rpx solid #dce7e3}.receive-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.goods-name{font-size:29rpx;font-weight:700;color:#21312e}.goods-spec{display:block;margin-top:5rpx;color:#778580;font-size:21rpx}.goods-amount{color:#d25c2f;font-size:29rpx;font-weight:700}.stage-label{display:block;margin-top:14rpx;padding:9rpx 12rpx;background:#fff7e6;border-left:4rpx solid #d8a13c;color:#77551b;font-size:21rpx}.detail-grid{display:grid;grid-template-columns:1fr 1fr;margin-top:18rpx;border-top:1rpx solid #edf1ef;border-left:1rpx solid #edf1ef}.detail-grid view{padding:13rpx;border-right:1rpx solid #edf1ef;border-bottom:1rpx solid #edf1ef}.field-label,.field-value{display:block}.field-label{color:#84908d;font-size:19rpx}.field-value{margin-top:5rpx;color:#34433f;font-size:23rpx}.purpose{color:#147967}.location-line{margin-top:14rpx;color:#6f7e7a;font-size:21rpx}.receive-action{margin-top:18rpx;padding:16rpx;text-align:center;background:#178b78;color:#fff;font-size:25rpx;font-weight:600}.receive-action.is-loading{background:#88aaa3}.error-state .retry{display:block;margin-top:12rpx;color:#147967}.small-state{padding:18rpx}
