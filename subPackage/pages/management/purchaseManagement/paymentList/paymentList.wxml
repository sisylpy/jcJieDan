<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="付款与凭证" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx"><view wx:for="{{list}}" wx:key="paymentId" class="pm-card" data-index="{{index}}" bindtap="show"><view class="pm-row"><text>{{item.paymentNo}}</text><text class="pm-money">¥{{item.paymentAmount}}</text></view><text class="pm-muted">{{item.businessType}} · {{item.paymentMethod}} · 收款确认 {{item.confirmationStatus}}</text></view><view wx:if="{{selected}}" class="pm-card"><text class="pm-section-title">凭证（{{vouchers.length}}）</text><view wx:for="{{vouchers}}" wx:key="voucherId" class="pm-row line" data-index="{{index}}" bindtap="openVoucher"><text>{{item.originalFilename}}</text><view><text>{{item.status}} · 查看</text><button wx:if="{{item.status==='ACTIVE'}}" size="mini" data-index="{{index}}" catchtap="voidVoucher">作废</button></view></view><view class="actions"><button size="mini" bindtap="upload">上传凭证</button><button wx:if="{{!selected.reversalOfPaymentId}}" size="mini" bindtap="reverse">冲正付款</button></view></view></scroll-view></view>
