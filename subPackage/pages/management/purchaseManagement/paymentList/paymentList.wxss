@import "../common.wxss";
.filters{position:sticky;top:0;z-index:2}.date-row,.select-row,.search-row{display:flex;align-items:center;gap:10rpx;margin-bottom:12rpx}.select-row picker{flex:1}.search-row input{flex:1;background:#f5f7f6;border:1rpx solid #dfe7e4;padding:10rpx 12rpx;font-size:23rpx}.search-row button{margin:0;background:#157f6d;color:#fff}.search-row>text{color:#687671;font-size:23rpx}.scope-text{display:block;color:#71807c;font-size:21rpx;line-height:1.5}.summary-bar{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border:1rpx solid #e4ebe8;margin-bottom:14rpx}.summary-bar view{padding:14rpx 6rpx;text-align:center}.summary-bar view+view{border-left:1rpx solid #edf1ef}.summary-bar text{display:block;font-size:19rpx;color:#71807c}.summary-bar .summary-value{font-size:24rpx;color:#116f61;font-weight:700;margin-top:5rpx}.payment-row{padding:18rpx 20rpx}.payment-row .pm-row>view:first-child text{display:block}.type-line{font-size:22rpx;color:#60706b;margin-top:4rpx}.row-amount{display:flex;align-items:center;gap:8rpx;color:#d25c2f;font-weight:700}.row-amount.negative{color:#65736f}.meta-line{display:flex;justify-content:space-between;gap:12rpx;margin-top:12rpx;color:#71807c;font-size:21rpx}.warn-text{color:#a36108}.load-more{text-align:center;color:#147967;padding:18rpx}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:99;display:flex;align-items:flex-end}.detail-panel{background:#f5f7f6;width:100%;height:84vh;padding:22rpx;box-sizing:border-box}.detail-head{display:flex;justify-content:space-between;align-items:center}.close{color:#147967}.detail-scroll{height:calc(84vh - 72rpx)}.detail-block{background:#fff;border:1rpx solid #e4ebe8;padding:20rpx;margin-bottom:14rpx}.detail-money{font-size:34rpx;color:#d25c2f;font-weight:700}.detail-no{display:block;color:#71807c;font-size:21rpx;margin:7rpx 0 14rpx}.detail-grid{display:grid;grid-template-columns:140rpx 1fr;gap:11rpx;font-size:23rpx}.detail-grid>text{color:#71807c}.detail-grid .detail-value{color:#26332f;font-weight:650}.source-title{display:block;font-size:27rpx;font-weight:650;margin-bottom:8rpx}.source-line{display:flex;justify-content:space-between;gap:14rpx;border-top:1rpx solid #edf1ef;padding:14rpx 0;margin-top:12rpx}.source-line view text{display:block}.voucher-empty{color:#9a6508;background:#fff8e8;padding:14rpx;font-size:22rpx}.voucher-row{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #edf1ef;padding:14rpx 0}.voucher-row view text{display:block}.voucher-row button{margin:0}.actions{display:flex;gap:14rpx;margin-top:16rpx}.actions button{margin:0;background:#edf7f4;color:#116f61}
