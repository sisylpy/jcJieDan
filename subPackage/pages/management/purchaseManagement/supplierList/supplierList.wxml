<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购供应方" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
    <view class="pm-card scope-note">
      <text class="pm-section-title">采购供应方查询</text>
      <text class="pm-muted">统一查看内部协作配送商和外部供应商的采购次数、商品、数量、单价与已识别金额。日期只筛选采购记录，不隐藏已经建立的供应方。</text>
    </view>
    <view class="pm-card pm-filter">
      <picker mode="date" value="{{startDate}}" bindchange="changeStart"><text class="pm-date">{{startDate||'开始日期'}}</text></picker>
      <text>至</text>
      <picker mode="date" value="{{stopDate}}" bindchange="changeStop"><text class="pm-date">{{stopDate||'结束日期'}}</text></picker>
    </view>
    <view class="pm-card search-row">
      <input class="search-input" value="{{keyword}}" placeholder="搜索供应方名称" bindinput="inputKeyword" confirm-type="search" bindconfirm="search" />
      <text class="pm-button" bindtap="search">搜索</text>
    </view>
    <view class="pm-tabs">
      <text class="pm-tab {{supplierType===''?'on':''}}" data-value="" bindtap="chooseType">全部</text>
      <text class="pm-tab {{supplierType==='INTERNAL_DISTRIBUTER'?'on':''}}" data-value="INTERNAL_DISTRIBUTER" bindtap="chooseType">内部协作配送商</text>
      <text class="pm-tab {{supplierType==='EXTERNAL_JRDH'?'on':''}}" data-value="EXTERNAL_JRDH" bindtap="chooseType">外部供应商</text>
    </view>
    <view class="pm-tabs">
      <text class="pm-tab {{sort==='LAST_PURCHASE'?'on':''}}" data-value="LAST_PURCHASE" bindtap="chooseSort">最近采购</text>
      <text class="pm-tab {{sort==='PURCHASE_AMOUNT'?'on':''}}" data-value="PURCHASE_AMOUNT" bindtap="chooseSort">已识别金额</text>
      <text class="pm-tab {{sort==='PURCHASE_COUNT'?'on':''}}" data-value="PURCHASE_COUNT" bindtap="chooseSort">采购次数</text>
    </view>
    <view wx:if="{{error}}" class="pm-state">{{error}}</view>
    <view wx:if="{{!loading&&!items.length&&!error}}" class="pm-state">
      <text>暂无统一采购供应方数据</text>
      <text class="empty-hint">若原业务已有采购记录，请确认采购事实同步已经运行。</text>
      <text class="pm-button retry-button" bindtap="retry">重新加载</text>
    </view>
    <view class="pm-card supplier" wx:for="{{items}}" wx:key="purchaseSupplierRefId" data-id="{{item.purchaseSupplierRefId}}" bindtap="open">
      <view class="pm-row">
        <view><text class="pm-name">{{item.supplierName||'名称未解析'}}</text><text class="type-badge">{{item.supplierTypeText}}</text></view>
        <text class="pm-link">详情 ›</text>
      </view>
      <view class="pm-grid summary-grid">
        <view class="pm-metric"><text class="pm-label">采购次数</text><text>{{item.purchaseCount}} 次</text></view>
        <view class="pm-metric"><text class="pm-label">商品行数</text><text>{{item.goodsLineCount}} 行</text></view>
        <view class="pm-metric"><text class="pm-label">已识别采购金额</text><text class="pm-money">{{item.purchaseAmountText}}</text></view>
        <view class="pm-metric"><text class="pm-label">最近采购日期</text><text>{{item.lastPurchaseDate||'—'}}</text></view>
      </view>
      <view class="pm-row quality-row">
        <text class="pm-badge {{item.qualityClass}}">{{item.dataQualityText}}</text>
        <text class="pm-muted">{{item.amountScopeText}}</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="pm-state">正在加载…</view>
  </scroll-view>
</view>
