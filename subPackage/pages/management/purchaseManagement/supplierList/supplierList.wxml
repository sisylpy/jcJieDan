<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="供应商" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more"><view class="pm-tabs"><text class="pm-tab {{sort==='LAST_PURCHASE'?'on':''}}" data-value="LAST_PURCHASE" bindtap="sort">最近供货</text><text class="pm-tab {{sort==='NET_AMOUNT'?'on':''}}" data-value="NET_AMOUNT" bindtap="sort">净采购金额</text><text class="pm-tab {{sort==='LOSS_RATE'?'on':''}}" data-value="LOSS_RATE" bindtap="sort">质量损耗率</text></view><view wx:if="{{error}}" class="pm-state">{{error}}</view><view wx:if="{{!loading&&!items.length&&!error}}" class="pm-state">当前范围暂无供应商</view><view class="pm-card" wx:for="{{items}}" wx:key="supplierRelationId" data-id="{{item.supplierRelationId}}" bindtap="open"><view class="pm-row"><view><text class="pm-name">{{item.supplierName||'历史供应商'}}</text><text class="pm-badge">{{item.relationStatusText}}</text></view><text class="pm-link">详情 ›</text></view><text class="pm-muted">当前负责人：{{item.responsiblePurchaserName||'待分配'}} · 首次邀请人：{{item.invitedByName||'历史未记录'}} · 关联商品 {{item.relatedGoodsCount||0}}</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">采购批次 / 异常</text><text>{{item.totalBatchCount||0}} / {{item.exceptionCount||0}}</text></view><view class="pm-metric"><text class="pm-label">实际净采购</text><text class="pm-money">{{item.actualNetPurchaseAmount==null?'—':'¥'}}{{item.actualNetPurchaseAmount}}</text></view><view class="pm-metric"><text class="pm-label">退货率 / 拒收率</text><text>{{item.supplierReturnRate==null?'—':item.supplierReturnRate}} / {{item.rejectionRate==null?'—':item.rejectionRate}}</text></view><view class="pm-metric"><text class="pm-label">供货质量损耗率</text><text>{{item.supplierQualityLossRate==null?'—':item.supplierQualityLossRate}}</text></view><view class="pm-metric"><text class="pm-label">降价影响</text><text>{{item.markdownImpact==null?'—':'¥'}}{{item.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">完结最终毛利</text><text>{{item.completedFinalMargin==null?'—':'¥'}}{{item.completedFinalMargin}}</text></view></view><text class="pm-muted">{{item.dataCompletenessText}} · 覆盖 {{item.effectiveBatchCount||0}}/{{item.totalBatchCount||0}}（{{item.dataCoverageRate}}）· 最近 {{item.lastSupplyTime||'—'}}</text></view><view wx:if="{{loading}}" class="pm-state">正在加载…</view></scroll-view></view>
