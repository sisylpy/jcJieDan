@import "../common.wxss";

.supplier-scroll{height:100%;box-sizing:border-box}.supplier-body{padding:16rpx 20rpx 48rpx}.date-bar{display:flex;align-items:center;min-height:68rpx;padding:0 18rpx;background:#fff;border:1rpx solid #dfe8e4;font-size:24rpx;color:#30413d}.calendar-icon{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;margin-right:12rpx;border:2rpx solid #17816e;color:#17816e;font-size:18rpx;font-weight:700}.date-picker{padding:12rpx 4rpx}.date-separator{margin:0 8rpx;color:#91a09b}.search-bar{display:flex;align-items:center;height:72rpx;margin-top:12rpx;background:#fff;border:1rpx solid #dfe8e4}.search-icon{padding-left:18rpx;color:#73817d;font-size:32rpx}.search-input{flex:1;min-width:0;padding:0 12rpx;font-size:25rpx}.search-action{height:72rpx;line-height:72rpx;padding:0 22rpx;color:#fff;background:#157f6d;font-size:24rpx}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:14rpx 0}.toolbar-left{display:flex;gap:10rpx;min-width:0}.toolbar-button{padding:10rpx 14rpx;background:#fff;border:1rpx solid #dce6e2;color:#465954;font-size:22rpx;white-space:nowrap}.toolbar-button.active{color:#157f6d;border-color:#74aa9f}.data-note-link{color:#157f6d;font-size:23rpx;white-space:nowrap}.status-notice{margin-bottom:12rpx;padding:13rpx 16rpx;border-left:5rpx solid #90a29c;background:#f0f4f2;color:#5a6c67;font-size:22rpx;line-height:1.5}.status-notice.warn{border-left-color:#d99b36;background:#fff8e9;color:#8c621d}.state-panel{padding:110rpx 30rpx;text-align:center;color:#74827e}.state-panel text{display:block}.state-title{font-size:28rpx;color:#34443f;font-weight:650}.state-copy{margin-top:14rpx;font-size:23rpx;line-height:1.6}.state-button{display:inline-block!important;margin-top:24rpx;padding:12rpx 24rpx;background:#157f6d;color:#fff;font-size:24rpx}.error-state{padding-top:78rpx}.supplier-card{margin-bottom:14rpx;padding:20rpx 22rpx 0;background:#fff;border:1rpx solid #dfe8e4}.card-heading{display:flex;align-items:flex-start;justify-content:space-between}.identity{display:flex;align-items:center;flex-wrap:wrap;gap:9rpx;min-width:0}.supplier-name{font-size:31rpx;font-weight:700;color:#22332e}.type-badge,.relation-badge{padding:4rpx 10rpx;font-size:20rpx;line-height:1.4}.type-badge.internal{color:#116f61;background:#e9f5f1}.type-badge.external{color:#9a6020;background:#fff3e2}.relation-badge{color:#8e5f22;background:#fff8e9}.card-arrow{color:#9aa6a2;font-size:38rpx;line-height:1}.amount-row{display:flex;align-items:baseline;justify-content:space-between;margin-top:22rpx}.amount-label{color:#6f7e79;font-size:23rpx}.amount-value{color:#d25c2f;font-size:36rpx;font-weight:750}.amount-value.muted{color:#9a6020;font-size:28rpx}.meta-row{display:flex;align-items:center;flex-wrap:wrap;margin-top:14rpx;color:#65746f;font-size:22rpx;line-height:1.8}.meta-dot{margin:0 7rpx;color:#a6b0ad}.amount-note{display:flex;align-items:flex-start;gap:9rpx;margin-top:14rpx;padding:12rpx 14rpx;background:#fff8e9;color:#855b1b;font-size:22rpx;line-height:1.5}.amount-note.no-record{background:#f3f6f5;color:#697873}.amount-note.unresolved{background:#fff4e6}.note-mark{flex:none;font-weight:700}.quality-warning{margin-top:10rpx;color:#ae4538;font-size:22rpx}.card-footer{display:flex;align-items:center;justify-content:flex-end;gap:7rpx;margin-top:18rpx;padding:15rpx 0;border-top:1rpx solid #edf1ef;color:#157f6d;font-size:24rpx}.loading-state,.list-end{padding:38rpx;text-align:center;color:#87938f;font-size:22rpx}.sheet-mask{position:fixed;z-index:1000;left:0;right:0;top:0;bottom:0;background:rgba(22,35,31,.4);display:flex;align-items:flex-end}.bottom-sheet{width:100%;padding:26rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;border-radius:14rpx 14rpx 0 0}.sheet-title{padding-bottom:18rpx;border-bottom:1rpx solid #e8eeeb;color:#24342f;font-size:30rpx;font-weight:700}.sheet-option{padding:23rpx 4rpx;border-bottom:1rpx solid #edf1ef;color:#42534e;font-size:26rpx}.sheet-option.selected{color:#157f6d;font-weight:700}.sheet-copy{display:block;margin-top:18rpx;color:#53655f;font-size:24rpx;line-height:1.7}.sheet-close{margin-top:24rpx;padding:15rpx;text-align:center;background:#f0f5f3;color:#157f6d;font-size:25rpx}
