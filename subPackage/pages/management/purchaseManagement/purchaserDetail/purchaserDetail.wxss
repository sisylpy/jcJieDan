@import "../common.wxss";

.detail-topbar {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.top-date-filter {
  flex: 1;
  min-width: 0;
}

.top-filter-button {
  position: relative;
  width: 126rpx;
  min-height: 108rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfe2dc;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #536660;
}

.top-filter-button.selected {
  border-color: #178e77;
  background: #eaf8f4;
  color: #087861;
}

.top-filter-label {
  font-size: 27rpx;
  font-weight: 650;
}

.top-filter-count {
  position: absolute;
  top: 13rpx;
  right: 12rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #0c8d72;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.person-summary {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #e0ebe7;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 22rpx rgba(40, 79, 68, 0.05);
}

.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-scope,
.summary-kicker,
.summary-title,
.summary-label,
.summary-number,
.summary-money {
  display: block;
}

.summary-scope {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  color: #80908b;
  font-size: 21rpx;
}

.summary-title {
  margin-top: 4rpx;
  overflow: hidden;
  color: #213a33;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-status {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 18rpx;
  background: #eef8f5;
  color: #18806b;
  font-size: 20rpx;
}

.summary-line {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f0;
}

.completed-summary-line {
  grid-template-columns: 1fr 1fr;
}

.summary-item {
  min-width: 0;
  padding: 15rpx 16rpx;
  border-radius: 12rpx;
  background: #f7faf9;
}

.summary-label {
  color: #778782;
  font-size: 20rpx;
}

.summary-number,
.summary-money {
  margin-top: 7rpx;
  color: #243b34;
  font-size: 31rpx;
  font-weight: 700;
  white-space: nowrap;
}

.summary-unit {
  margin-left: 5rpx;
  color: #74847f;
  font-size: 20rpx;
  font-weight: 400;
}

.amount-summary {
  background: #fff8f2;
  text-align: right;
}

.summary-money {
  color: #d65c2d;
}

.amount-note {
  display: block;
  margin-top: 12rpx;
  color: #9a5b00;
  font-size: 21rpx;
  text-align: right;
}

.goods-toolbar {
  margin-bottom: 13rpx;
  padding: 18rpx;
  border: 1rpx solid #e0e9e6;
  border-radius: 15rpx;
  background: #ffffff;
}

.goods-toolbar-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 15rpx;
}

.goods-toolbar-title,
.goods-toolbar-copy {
  display: block;
}

.goods-toolbar-title {
  color: #263a34;
  font-size: 29rpx;
  font-weight: 700;
}

.goods-toolbar-copy {
  margin-top: 5rpx;
  color: #879590;
  font-size: 19rpx;
}

.goods-toolbar-count {
  flex-shrink: 0;
  padding-top: 5rpx;
  color: #16816b;
  font-size: 21rpx;
}

.goods-filters {
  display: flex;
  gap: 10rpx;
}

.goods-filters picker {
  flex: 1;
  min-width: 0;
}

.goods-filter {
  padding: 13rpx 10rpx;
  overflow: hidden;
  border: 1rpx solid #dfe8e5;
  border-radius: 9rpx;
  background: #f8faf9;
  color: #53645f;
  font-size: 22rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-tree-layout {
  display: flex;
  align-items: stretch;
  min-height: 520rpx;
  overflow: hidden;
  border: 1rpx solid #e0e9e6;
  border-radius: 16rpx;
  background: #ffffff;
}

.goods-category-tree {
  width: 142rpx;
  max-height: 1050rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #e0e9e6;
  background: #f2f6f5;
}

.goods-category {
  position: relative;
  padding: 23rpx 11rpx 22rpx 24rpx;
  border-bottom: 1rpx solid #e2e9e7;
  color: #576a64;
  font-size: 22rpx;
  line-height: 1.3;
}

.goods-category.on {
  background: #e5f6f1;
  color: #08745f;
  font-weight: 700;
}

.goods-category.on::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: #139a7f;
}

.goods-category-name,
.goods-category-count {
  display: block;
}

.goods-category-count {
  margin-top: 6rpx;
  color: #8c9a96;
  font-size: 18rpx;
  font-weight: 400;
}

.goods-category.on .goods-category-count {
  color: #4e8f81;
}

.goods-list {
  flex: 1;
  min-width: 0;
  padding: 13rpx 12rpx 4rpx;
  background: #fbfcfc;
}

.record-empty {
  padding: 60rpx 14rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #87938f;
  font-size: 21rpx;
  text-align: center;
}

.purchased-goods-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 13rpx;
  padding: 15rpx;
  border: 1rpx solid #dfe9e5;
  border-radius: 15rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 17rpx rgba(38, 77, 66, 0.045);
}

.goods-thumb {
  width: 86rpx;
  height: 86rpx;
  margin-right: 13rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #f0f4f2;
}

.goods-card-main {
  flex: 1;
  min-width: 0;
}

.purchased-goods-name {
  display: -webkit-box;
  overflow: hidden;
  color: #1e302a;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-date {
  display: block;
  margin-top: 5rpx;
  color: #87938f;
  font-size: 19rpx;
}

.goods-badges {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7rpx;
  margin: 10rpx 0 12rpx;
}

.goods-badge {
  padding: 4rpx 8rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
}

.goods-badge.purchaser {
  background: #f3effa;
  color: #67528d;
}

.goods-badge.source {
  background: #eef4fb;
  color: #55739b;
}

.goods-badge.complete {
  background: #e7f8f2;
  color: #0b8b70;
}

.goods-card-foot,
.goods-purpose-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.goods-quantity {
  min-width: 0;
  color: #667670;
  font-size: 21rpx;
  line-height: 1.4;
}

.goods-money {
  flex-shrink: 0;
  color: #0b9b76;
  font-size: 29rpx;
  font-weight: 700;
  white-space: nowrap;
}

.goods-money.unresolved {
  color: #a16d1a;
  font-size: 19rpx;
  font-weight: 500;
}

.goods-purpose-line {
  align-items: flex-start;
  margin-top: 11rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #edf1ef;
  color: #7d8a86;
  font-size: 19rpx;
  line-height: 1.4;
}

.goods-supplier {
  min-width: 0;
  overflow: hidden;
  color: #58716a;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-empty-state {
  border: 1rpx solid #e0e9e6;
  border-radius: 16rpx;
  background: #ffffff;
}

.small-state {
  padding: 35rpx 20rpx;
}

.error-state text,
.small-state text {
  display: block;
}

.retry {
  margin-top: 14rpx;
  color: #147967;
}

.purchaser-filter-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(23, 35, 31, 0.48);
}

.purchaser-filter-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  background: #ffffff;
}

.filter-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.filter-sheet-title,
.filter-sheet-copy,
.filter-option-name,
.filter-option-copy {
  display: block;
}

.filter-sheet-title {
  color: #20352f;
  font-size: 32rpx;
  font-weight: 700;
}

.filter-sheet-copy {
  margin-top: 5rpx;
  color: #75837f;
  font-size: 21rpx;
}

.filter-sheet-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-clear,
.filter-close {
  padding: 8rpx;
  font-size: 23rpx;
}

.filter-clear {
  color: #0a8b70;
}

.filter-close {
  color: #667670;
}

.filter-select-all,
.filter-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e0e8e5;
  border-radius: 12rpx;
  background: #ffffff;
}

.filter-select-all {
  justify-content: space-between;
  margin-bottom: 12rpx;
  background: #f8faf9;
}

.filter-select-all.selected,
.filter-option.selected {
  border-color: #8fd1bf;
  background: #eefaf6;
}

.filter-options {
  max-height: 48vh;
}

.filter-option {
  margin-bottom: 10rpx;
}

.filter-avatar {
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eef3f1;
}

.filter-option-main {
  flex: 1;
  min-width: 0;
}

.filter-option-name {
  color: #263a34;
  font-size: 26rpx;
  font-weight: 650;
}

.filter-option-copy {
  margin-top: 5rpx;
  color: #788681;
  font-size: 20rpx;
}

.filter-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  border: 2rpx solid #bdcbc7;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
}

.selected .filter-check {
  border-color: #129477;
  background: #129477;
}

.filter-sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 14rpx;
}

.filter-selected-count {
  color: #697873;
  font-size: 22rpx;
}

.filter-apply {
  height: 72rpx;
  margin: 0;
  padding: 0 38rpx;
  border: 0;
  border-radius: 12rpx;
  background: #128c72;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.filter-apply::after {
  border: 0;
}
