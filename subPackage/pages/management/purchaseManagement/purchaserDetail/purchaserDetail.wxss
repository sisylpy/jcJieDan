@import "../common.wxss";
.person-summary{background:#fff;border:1rpx solid #e1e9e6;padding:20rpx;margin-bottom:12rpx}.name-badge{margin-left:10rpx}.date-line{display:flex;align-items:center;gap:10rpx;color:#63726e;font-size:23rpx;margin-top:16rpx}.summary-line{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:10rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf1ef}.summary-label,.summary-number,.summary-money{display:block}.summary-label{color:#71807c;font-size:21rpx}.summary-number{font-size:27rpx;margin-top:5rpx}.amount-summary{text-align:right}.summary-money{font-size:31rpx;font-weight:700;color:#d25c2f;margin-top:3rpx}.amount-note{display:block;margin-top:10rpx;color:#9a5b00;font-size:22rpx}.detail-tabs{display:flex;background:#fff;border:1rpx solid #e1e9e6;margin-bottom:10rpx}.detail-tab{flex:1;text-align:center;padding:18rpx 0;color:#60706b;font-size:25rpx;border-bottom:3rpx solid transparent}.detail-tab.on{color:#147967;font-weight:650;border-bottom-color:#168471}.section-note{display:block;color:#71807c;font-size:21rpx;padding:8rpx 4rpx 12rpx}.task-card{background:#fff;border:1rpx solid #e1e9e6;margin-bottom:12rpx;padding:18rpx}.purpose{color:#147967;font-weight:650;font-size:23rpx}.task-progress{font-size:21rpx;padding:5rpx 9rpx;background:#eef5f3;color:#41635b}.task-progress.attention{background:#fff1df;color:#9a5b00}.goods-summary{display:block;font-size:29rpx;font-weight:650;margin:16rpx 0 12rpx}.task-meta,.handler-line{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx;color:#64736f;margin-top:9rpx}.handler-line{border-top:1rpx solid #edf1ef;padding-top:13rpx;margin-top:14rpx}.task-action{color:#147967;white-space:nowrap}.route-note{display:block;margin-top:9rpx;color:#9a5b00;font-size:21rpx}.small-state{padding:35rpx 20rpx}.error-state text,.small-state text{display:block}.retry{color:#147967;margin-top:14rpx}

.record-toolbar{background:#fff;border:1rpx solid #e1e9e6;padding:16rpx 14rpx;margin-bottom:10rpx}.record-period{display:block;color:#71807c;font-size:21rpx;margin-bottom:14rpx}.record-filters{display:flex;justify-content:flex-end;gap:10rpx}.record-filter{min-width:120rpx;padding:12rpx 14rpx;border:1rpx solid #e2e9e7;background:#fafcfb;color:#52635e;font-size:21rpx;text-align:center;white-space:nowrap}.record-layout{display:flex;align-items:flex-start;gap:12rpx}.record-groups{width:142rpx;flex-shrink:0;background:#f8faf9;border:1rpx solid #e1e9e6}.record-group{position:relative;padding:20rpx 10rpx;text-align:center;color:#5e6d69;font-size:22rpx;border-bottom:1rpx solid #e8edeb}.record-group:last-child{border-bottom:0}.record-group.on{background:#e7f8f2;color:#0b8b70;font-weight:650}.record-group.on::before{content:"";position:absolute;left:0;top:0;bottom:0;width:6rpx;background:#11977d}.record-group-name,.record-group-count{display:block}.record-group-count{font-size:19rpx;margin-top:3rpx}.record-list{flex:1;min-width:0}.record-empty{background:#fff;border:1rpx solid #e1e9e6;padding:60rpx 20rpx;text-align:center;color:#87938f;font-size:22rpx}.purchase-record-card{display:flex;align-items:stretch;background:#fff;border:1rpx solid #e1e9e6;padding:14rpx;margin-bottom:10rpx}.record-thumb{width:92rpx;height:92rpx;flex-shrink:0;background:#f3f6f5;margin-right:14rpx}.record-card-main{flex:1;min-width:0}.record-card-head,.record-card-foot,.record-purpose-line{display:flex;align-items:center;justify-content:space-between;gap:10rpx}.record-goods-name{font-size:27rpx;font-weight:650;color:#253631;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-date{font-size:19rpx;color:#87938f;white-space:nowrap}.record-badges{display:flex;align-items:center;gap:8rpx;margin:8rpx 0}.record-badge{font-size:19rpx;padding:4rpx 8rpx}.record-badge.source{color:#55739b;background:#eef4fb}.record-badge.status{color:#0b8b70;background:#e7f8f2}.record-badge.status.attention{color:#d56a2f;background:#fff1e6}.record-quantity{font-size:21rpx;color:#667670}.record-money{font-size:28rpx;color:#0b9b76;font-weight:700;white-space:nowrap}.record-money.unresolved{font-size:20rpx;color:#a16d1a;font-weight:500}.record-purpose-line{border-top:1rpx solid #edf1ef;margin-top:10rpx;padding-top:9rpx;color:#7d8a86;font-size:19rpx}.record-link{color:#147967;white-space:nowrap}
