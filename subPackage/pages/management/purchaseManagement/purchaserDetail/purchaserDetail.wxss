@import "../common.wxss";
.person-summary{background:#fff;border:1rpx solid #e1e9e6;padding:20rpx;margin-bottom:12rpx}.name-badge{margin-left:10rpx}.date-line{display:flex;align-items:center;gap:10rpx;color:#63726e;font-size:23rpx;margin-top:16rpx}.summary-line{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:10rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf1ef}.summary-label,.summary-number,.summary-money{display:block}.summary-label{color:#71807c;font-size:21rpx}.summary-number{font-size:27rpx;margin-top:5rpx}.amount-summary{text-align:right}.summary-money{font-size:31rpx;font-weight:700;color:#d25c2f;margin-top:3rpx}.amount-note{display:block;margin-top:10rpx;color:#9a5b00;font-size:22rpx}.detail-tabs{display:flex;background:#fff;border:1rpx solid #e1e9e6;margin-bottom:10rpx}.detail-tab{flex:1;text-align:center;padding:18rpx 0;color:#60706b;font-size:25rpx;border-bottom:3rpx solid transparent}.detail-tab.on{color:#147967;font-weight:650;border-bottom-color:#168471}.section-note{display:block;color:#71807c;font-size:21rpx;padding:8rpx 4rpx 12rpx}.task-card,.record-section{background:#fff;border:1rpx solid #e1e9e6;margin-bottom:12rpx;padding:18rpx}.purpose{color:#147967;font-weight:650;font-size:23rpx}.task-progress{font-size:21rpx;padding:5rpx 9rpx;background:#eef5f3;color:#41635b}.task-progress.attention{background:#fff1df;color:#9a5b00}.goods-summary{display:block;font-size:29rpx;font-weight:650;margin:16rpx 0 12rpx}.task-meta,.handler-line,.record-amount{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx;color:#64736f;margin-top:9rpx}.handler-line{border-top:1rpx solid #edf1ef;padding-top:13rpx;margin-top:14rpx}.task-action{color:#147967;white-space:nowrap}.route-note{display:block;margin-top:9rpx;color:#9a5b00;font-size:21rpx}.record-title{display:block;font-weight:700;font-size:26rpx;margin-bottom:8rpx}.record-row{padding:16rpx 0;border-bottom:1rpx solid #edf1ef}.record-row:last-child{border-bottom:0}.record-amount{color:#35433f}.small-state{padding:35rpx 20rpx}.error-state text,.small-state text{display:block}.retry{color:#147967;margin-top:14rpx}
