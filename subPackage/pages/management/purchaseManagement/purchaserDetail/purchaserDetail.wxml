<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购详细" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx">
    <view wx:if="{{error}}" class="pm-state error-state"><text>{{error}}</text><text class="retry" bindtap="retry">重新加载</text></view>
    <block wx:else>
      <view class="detail-topbar">
        <report-date-filter class="top-date-filter" style="flex:1;min-width:0;" label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>
        <view class="top-filter-button {{selectedAllPurchasers?'':'selected'}}" bindtap="openPurchaserFilter">
          <text class="top-filter-label">筛选</text>
          <text wx:if="{{!selectedAllPurchasers}}" class="top-filter-count">{{selectedPurchaserIds.length}}</text>
        </view>
      </view>

      <view class="person-summary">
        <view class="summary-head">
          <view class="summary-scope">
            <text class="summary-kicker">采购员范围</text>
            <text class="summary-title">{{purchaserSelectionText}}</text>
          </view>
          <text class="scope-status">{{detail.purchaserStatusText||'当前采购员'}}</text>
        </view>
        <view class="summary-line completed-summary-line">
          <view class="summary-item"><text class="summary-label">采购完成商品</text><text class="summary-number">{{completedGoodsCount}}<text class="summary-unit">条</text></text></view>
          <view class="summary-item amount-summary"><text class="summary-label">已确认金额</text><text class="summary-money">{{completedGoodsAmountText}}</text></view>
        </view>
        <text wx:if="{{completedUnresolvedCount}}" class="amount-note">另有 {{completedUnresolvedCount}} 条已采购商品金额待形成或核对</text>
      </view>

      <view class="goods-toolbar">
        <view class="goods-toolbar-head">
          <view><text class="goods-toolbar-title">已采购商品</text><text class="goods-toolbar-copy">仅展示采购完成的商品明细</text></view>
          <text class="goods-toolbar-count">{{goodsItems.length}} 条</text>
        </view>
        <view class="goods-filters">
          <picker value="{{goodsSourceIndex}}" range="{{goodsSourceOptions}}" range-key="label" bindchange="changeGoodsSource">
            <view class="goods-filter">{{goodsSourceOptions[goodsSourceIndex].label}}⌄</view>
          </picker>
          <picker value="{{goodsSortIndex}}" range="{{goodsSortOptions}}" range-key="label" bindchange="changeGoodsSort">
            <view class="goods-filter">{{goodsSortOptions[goodsSortIndex].label}}⌄</view>
          </picker>
        </view>
      </view>

      <view wx:if="{{goodsError}}" class="pm-state small-state"><text>{{goodsError}}</text><text class="retry" bindtap="retryGoods">重新加载</text></view>
      <view wx:elif="{{!goodsLoading&&!purchasedGoods.length}}" class="pm-state goods-empty-state">所选日期内暂无采购完成商品</view>

      <view wx:if="{{purchasedGoods.length}}" class="goods-tree-layout">
        <scroll-view scroll-y class="goods-category-tree">
          <view class="goods-category {{activeGoodsCategory===item.key?'on':''}}" wx:for="{{goodsCategories}}" wx:key="key" data-value="{{item.key}}" bindtap="chooseGoodsCategory">
            <text class="goods-category-name">{{item.name}}</text>
            <text class="goods-category-count">{{item.count}} 条</text>
          </view>
        </scroll-view>
        <view class="goods-list">
          <view wx:if="{{!goodsItems.length&&!goodsLoading}}" class="record-empty">当前筛选条件下暂无商品</view>
          <view class="purchased-goods-card" wx:for="{{goodsItems}}" wx:key="key">
            <image class="goods-thumb" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view class="goods-card-main">
              <view class="goods-card-head">
                <text class="purchased-goods-name">{{item.title}}</text>
                <text class="goods-date">{{item.businessDate}}</text>
              </view>
              <view class="goods-badges">
                <text class="goods-badge purchaser">{{item.purchaserName}}</text>
                <text class="goods-badge source">{{item.sourceText}}</text>
                <text class="goods-badge complete">{{item.completionText}}</text>
              </view>
              <view class="goods-card-foot">
                <text class="goods-quantity">{{item.quantityPriceText}}</text>
                <text class="goods-money {{item.amount==null?'unresolved':''}}">{{item.amountText}}</text>
              </view>
              <view class="goods-purpose-line">
                <text>{{item.purposeText}}</text>
                <text class="goods-supplier">{{item.supplierText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{goodsLoading}}" class="pm-state small-state">正在加载已采购商品…</view>
    </block>
  </scroll-view>

  <view wx:if="{{showPurchaserFilter}}" class="purchaser-filter-mask" bindtap="closePurchaserFilter">
    <view class="purchaser-filter-sheet" catchtap="noop">
      <view class="filter-sheet-head">
        <view><text class="filter-sheet-title">筛选采购员</text><text class="filter-sheet-copy">可选择一位或多位，汇总和商品明细会一起更新</text></view>
        <view class="filter-sheet-actions"><text class="filter-clear" bindtap="clearDraftPurchasers">清空</text><text class="filter-close" bindtap="closePurchaserFilter">关闭</text></view>
      </view>
      <view class="filter-select-all {{draftAllPurchasers?'selected':''}}" bindtap="selectAllPurchasers">
        <view><text class="filter-option-name">全部采购员</text><text class="filter-option-copy">查看所有采购员的已采购商品</text></view>
        <text class="filter-check">{{draftAllPurchasers?'✓':''}}</text>
      </view>
      <scroll-view scroll-y class="filter-options">
        <view class="filter-option {{item.selected?'selected':''}}" wx:for="{{draftPurchasers}}" wx:key="purchaserUserId" data-id="{{item.purchaserUserId}}" bindtap="togglePurchaser">
          <image class="filter-avatar" src="{{item.avatarUrl||'/images/user.png'}}" mode="aspectFill"></image>
          <view class="filter-option-main"><text class="filter-option-name">{{item.purchaserName||('采购员 #'+item.purchaserUserId)}}</text><text class="filter-option-copy">{{item.purchaserStatusText}} · 本期 {{item.periodPurchaseRecordCount||0}} 条采购</text></view>
          <text class="filter-check">{{item.selected?'✓':''}}</text>
        </view>
      </scroll-view>
      <view class="filter-sheet-foot">
        <text class="filter-selected-count">已选 {{draftSelectedCount}} 位</text>
        <button class="filter-apply" bindtap="applyPurchaserFilter">应用筛选</button>
      </view>
    </view>
  </view>
</view>
