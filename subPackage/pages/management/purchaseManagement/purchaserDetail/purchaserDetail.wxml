<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购员详情" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
<view wx:if="{{loading}}" class="pm-state">正在加载…</view><view wx:elif="{{error}}" class="pm-state">{{error}}</view><block wx:else>
<view class="pm-card"><view class="pm-row"><text class="pm-name">{{detail.purchaserName||'历史采购员'}}</text><text class="pm-badge">{{detail.purchaserStatusText}}</text></view><text wx:if="{{detail.summary.totalBatchCount||detail.summary.directSelfBuyRecordCount}}" class="pm-muted">{{detail.accountStatusText}} · <text wx:if="{{detail.summary.totalBatchCount}}">{{detail.summary.dataCompletenessText}} · 有效批次 {{detail.summary.effectiveBatchCount||0}}/{{detail.summary.totalBatchCount}} · 覆盖率 {{detail.summary.dataCoverageRateText||'—'}}</text><text wx:if="{{detail.summary.directSelfBuyRecordCount}}">{{detail.summary.totalBatchCount?' · ':''}}直接采购 {{detail.summary.directSelfBuyRecordCount}} 条（待采购 {{detail.summary.directSelfBuyPendingCount||0}} 条 · 已采购 {{detail.summary.directSelfBuyPurchaseCount||0}} 条 · 已入库 {{detail.summary.directSelfBuyStockInCount||0}} 条）</text></text><text wx:else class="pm-muted">{{detail.accountStatusText}} · 当前范围暂无采购记录</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">批次 / 商品行</text><text>{{detail.summary.totalBatchCount||0}} / {{detail.summary.goodsLineCount||0}}</text></view><view class="pm-metric"><text class="pm-label">预计金额</text><text>{{detail.summary.expectedAmount==null?'—':'¥'+detail.summary.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际收货</text><text>{{detail.summary.actualReceiptAmount==null?'—':'¥'+detail.summary.actualReceiptAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际净采购 / 退货</text><text class="pm-money">{{detail.summary.actualNetPurchaseAmount==null?'—':'¥'+detail.summary.actualNetPurchaseAmount}} / {{detail.summary.supplierReturnAmount==null?'—':'¥'+detail.summary.supplierReturnAmount}}</text></view><view class="pm-metric"><text class="pm-label">损耗 / 降价影响</text><text>{{detail.summary.lossCost==null?'—':'¥'+detail.summary.lossCost}} / {{detail.summary.markdownImpact==null?'—':'¥'+detail.summary.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">当前 / 最终毛利</text><text>{{detail.summary.currentRealizedMargin==null?'—':'¥'+detail.summary.currentRealizedMargin}} / {{detail.summary.completedFinalMargin==null?'—':'¥'+detail.summary.completedFinalMargin}}</text></view></view></view>
<view class="pm-card"><text class="pm-section-title">需求来源</text><view class="pm-tabs"><text class="pm-tab {{!demandSource?'on':''}}" data-value="" bindtap="chooseSource">全部</text><text class="pm-tab {{demandSource==='ORDER_GENERATED'?'on':''}}" data-value="ORDER_GENERATED" bindtap="chooseSource">订单</text><text class="pm-tab {{demandSource==='SHELF_REPLENISHMENT'?'on':''}}" data-value="SHELF_REPLENISHMENT" bindtap="chooseSource">货架</text><text class="pm-tab {{demandSource==='SMART_REPLENISHMENT'?'on':''}}" data-value="SMART_REPLENISHMENT" bindtap="chooseSource">智能备货</text></view><text class="pm-section-title">执行方式</text><view class="pm-tabs"><text class="pm-tab {{!procurementMode?'on':''}}" data-value="" bindtap="chooseMode">全部</text><text class="pm-tab {{procurementMode==='SELF_BUY'?'on':''}}" data-value="SELF_BUY" bindtap="chooseMode">自采</text><text class="pm-tab {{procurementMode==='AUTO_SUPPLIER'?'on':''}}" data-value="AUTO_SUPPLIER" bindtap="chooseMode">自动供应商</text><text class="pm-tab {{procurementMode==='EXTERNAL_SUPPLIER'?'on':''}}" data-value="EXTERNAL_SUPPLIER" bindtap="chooseMode">供应商采购</text></view></view>
<block wx:if="{{showDirect && !listEmpty}}"><view class="pm-card"><view class="pm-row"><text class="pm-section-title">直接采购记录（{{directTotal}}）</text></view><view wx:if="{{!directItems.length && !directLoading}}" class="pm-state">当前筛选暂无直接采购记录</view><view class="batch" wx:for="{{directItems}}" wx:key="purchaseGoodsId"><view class="pm-row"><text class="pm-name">{{item.goodsName}}</text><text class="pm-badge">{{item.recordKindText}}</text></view><text class="pm-muted">{{item.purchaseStatusText}} · {{item.demandSourceText}} · 规格 {{item.specText||'—'}}</text><view class="pm-line"><text>数量 {{item.quantityText}}</text><text>单价 {{item.priceText}}</text></view><view class="pm-line"><text>小计 {{item.subtotalText}}</text><text>{{item.timeText}}</text></view><view class="pm-line"><text>入库位置 {{item.shelfText}}</text></view></view><view wx:if="{{directLoading && directItems.length}}" class="pm-state">正在加载更多…</view></view></block>
<view wx:if="{{!listEmpty}}"><view class="pm-card"><view class="pm-row"><text class="pm-section-title">订货批次（{{total}}）</text></view><view wx:if="{{!items.length && !batchLoading}}" class="pm-state">当前筛选暂无订货批次</view><view class="batch" wx:for="{{items}}" wx:key="batchId" data-id="{{item.batchId}}" bindtap="openBatch"><view class="pm-row"><text class="pm-name">{{item.batchNumber}}</text><text class="pm-link">{{item.businessDate}} ›</text></view><text class="pm-muted">{{item.supplierName||'自采/无固定供应商'}} · {{item.procurementModeText}} · {{item.demandSources}}</text><view class="pm-line"><text>计划 {{item.expectedAmount==null?'—':'¥'+item.expectedAmount}}</text><text>实际净额 {{item.actualNetPurchaseAmount==null?'—':'¥'+item.actualNetPurchaseAmount}}</text></view><view class="pm-line"><text>{{item.receiptStatusText}} / {{item.putawayStatusText}}</text><text>{{item.dataCompletenessText}}</text></view></view><view wx:if="{{batchLoading && items.length}}" class="pm-state">正在加载更多…</view></view></view>
<view wx:if="{{listEmpty}}" class="pm-state">当前筛选暂无采购记录</view>
</block>
</scroll-view></view>
