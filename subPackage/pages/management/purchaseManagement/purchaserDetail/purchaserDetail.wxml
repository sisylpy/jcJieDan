<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购详细" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
    <view wx:if="{{error}}" class="pm-state error-state"><text>{{error}}</text><text class="retry" bindtap="retry">重新加载</text></view>
    <block wx:else>
      <view class="detail-topbar">
        <report-date-filter class="top-date-filter" style="flex:1;min-width:0;" label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>
        <view class="top-filter-button {{selectedAllPurchasers?'':'selected'}}" bindtap="openPurchaserFilter">
          <text class="top-filter-label">筛选</text>
          <text wx:if="{{!selectedAllPurchasers}}" class="top-filter-count">{{selectedPurchaserIds.length}}</text>
        </view>
      </view>

      <view class="person-summary">
        <view class="summary-head">
          <view class="summary-scope">
            <text class="summary-kicker">采购员范围</text>
            <text class="summary-title">{{purchaserSelectionText}}</text>
          </view>
          <text class="scope-status">{{detail.purchaserStatusText}}</text>
        </view>
        <view class="summary-line">
          <view class="summary-item"><text class="summary-label">当前任务</text><text class="summary-number">{{detail.summary.currentTaskCount||0}}<text class="summary-unit">项</text></text></view>
          <view class="summary-item"><text class="summary-label">采购记录</text><text class="summary-number">{{detail.summary.periodPurchaseRecordCount||0}}<text class="summary-unit">条</text></text></view>
          <view class="summary-item amount-summary"><text class="summary-label">采购金额</text><text class="summary-money">{{detail.summary.periodPurchaseAmount==null?'—':'¥'+detail.summary.periodPurchaseAmount}}</text></view>
        </view>
        <text wx:if="{{detail.summary.periodUnresolvedAmountCount}}" class="amount-note">另有 {{detail.summary.periodUnresolvedAmountCount}} 条采购记录金额尚未形成</text>
      </view>

      <view class="detail-tabs">
        <text class="detail-tab {{activeTab==='TASKS'?'on':''}}" data-value="TASKS" bindtap="chooseTab">当前任务</text>
        <text class="detail-tab {{activeTab==='RECORDS'?'on':''}}" data-value="RECORDS" bindtap="chooseTab">采购记录</text>
      </view>

      <block wx:if="{{activeTab==='TASKS'}}">
        <text class="section-note">当前未结束任务，不受上方历史日期范围限制</text>
        <view wx:if="{{taskError}}" class="pm-state small-state"><text>{{taskError}}</text><text class="retry" bindtap="retryTasks">重新加载</text></view>
        <view wx:elif="{{!taskLoading&&!tasks.length}}" class="pm-state">当前没有待处理任务</view>
        <view class="task-card" wx:for="{{tasks}}" wx:key="taskKey">
          <view class="pm-row"><text class="purpose">{{item.purchasePurposeText}}</text><text class="task-progress {{item.currentHandlerRole==='PURCHASER'?'attention':''}}">{{item.progressText}}</text></view>
          <text class="goods-summary">{{item.goodsSummary}}</text>
          <view class="task-meta"><text>{{item.purchaserName||('采购员 #'+item.purchaserUserId)}}</text><text>{{item.businessDate||'业务日期待核对'}}</text></view>
          <view class="task-meta"><text>{{item.batchNumber||('商品记录 #'+item.purchaseGoodsId)}}</text><text>{{item.goodsLineCount}} 条商品记录</text></view>
          <view class="task-meta"><text>{{item.supplierName}}</text></view>
          <view class="handler-line"><text>当前处理：{{item.currentHandlerText}}（{{item.handlerClientText}}）</text><text wx:if="{{item.canOperate||item.actionCode==='OPEN_BOSS_BATCH'}}" class="task-action" data-item="{{item}}" bindtap="openTask">{{item.actionText}} ›</text><text wx:else class="route-note">{{item.actionText}}</text></view>
        </view>
        <view wx:if="{{taskLoading}}" class="pm-state small-state">正在加载任务…</view>
      </block>

      <block wx:else>
        <view class="record-toolbar">
          <view class="record-toolbar-head">
            <text class="record-toolbar-title">采购记录</text>
            <text class="record-toolbar-copy">按类型、状态和金额筛选</text>
          </view>
          <view class="record-filters">
            <picker value="{{recordModeIndex}}" range="{{recordModeOptions}}" range-key="label" bindchange="changeRecordMode">
              <view class="record-filter">{{recordModeOptions[recordModeIndex].label}}⌄</view>
            </picker>
            <picker value="{{recordStatusIndex}}" range="{{recordStatusOptions}}" range-key="label" bindchange="changeRecordStatus">
              <view class="record-filter">{{recordStatusOptions[recordStatusIndex].label}}⌄</view>
            </picker>
            <picker value="{{recordSortIndex}}" range="{{recordSortOptions}}" range-key="label" bindchange="changeRecordSort">
              <view class="record-filter">{{recordSortOptions[recordSortIndex].label}}⌄</view>
            </picker>
          </view>
        </view>
        <view wx:if="{{batchError||directError}}" class="pm-state small-state"><text>{{batchError||directError}}</text><text class="retry" bindtap="retryRecords">重新加载</text></view>
        <view wx:elif="{{recordsLoaded&&!batchLoading&&!directLoading&&!batches.length&&!directItems.length}}" class="pm-state">所选日期内暂无采购记录</view>

        <view wx:if="{{batches.length||directItems.length}}" class="record-layout">
          <scroll-view scroll-y class="record-groups">
            <view class="record-group {{activeRecordGroup===item.key?'on':''}}" wx:for="{{recordGroups}}" wx:key="key" data-value="{{item.key}}" bindtap="chooseRecordGroup">
              <text class="record-group-name">{{item.name}}</text>
              <text class="record-group-count">{{item.count}} 条</text>
            </view>
          </scroll-view>
          <view class="record-list">
            <view wx:if="{{!recordItems.length&&!batchLoading&&!directLoading}}" class="record-empty">当前筛选条件下暂无记录</view>
            <view class="purchase-record-card" wx:for="{{recordItems}}" wx:key="key" data-id="{{item.batchId}}" bindtap="openRecord">
              <image class="record-thumb" src="{{item.imageUrl}}" mode="aspectFill"></image>
              <view class="record-card-main">
                <view class="record-card-head">
                  <text class="record-goods-name">{{item.title}}</text>
                  <text class="record-date">{{item.businessDate}}</text>
                </view>
                <view class="record-badges">
                  <text class="record-badge purchaser">{{item.purchaserName}}</text>
                  <text class="record-badge source">{{item.sourceText}}</text>
                  <text class="record-badge status {{item.statusKey==='WAITING_STOCK'?'attention':''}}">{{item.statusText}}</text>
                </view>
                <view class="record-card-foot">
                  <text class="record-quantity">{{item.quantityPriceText}}</text>
                  <text class="record-money {{item.amount==null?'unresolved':''}}">{{item.amountText}}</text>
                </view>
                <view class="record-purpose-line">
                  <text>{{item.purposeText}}</text>
                  <text wx:if="{{item.clickable}}" class="record-link">查看批次 ›</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{batchLoading||directLoading}}" class="pm-state small-state">正在加载采购记录…</view>
      </block>
    </block>
  </scroll-view>

  <view wx:if="{{showPurchaserFilter}}" class="purchaser-filter-mask" bindtap="closePurchaserFilter">
    <view class="purchaser-filter-sheet" catchtap="noop">
      <view class="filter-sheet-head">
        <view><text class="filter-sheet-title">筛选采购员</text><text class="filter-sheet-copy">可选择一位或多位，统计和明细会一起更新</text></view>
        <view class="filter-sheet-actions"><text class="filter-clear" bindtap="clearDraftPurchasers">清空</text><text class="filter-close" bindtap="closePurchaserFilter">关闭</text></view>
      </view>
      <view class="filter-select-all {{draftAllPurchasers?'selected':''}}" bindtap="selectAllPurchasers">
        <view><text class="filter-option-name">全部采购员</text><text class="filter-option-copy">查看所有采购员的合计数据</text></view>
        <text class="filter-check">{{draftAllPurchasers?'✓':''}}</text>
      </view>
      <scroll-view scroll-y class="filter-options">
        <view class="filter-option {{item.selected?'selected':''}}" wx:for="{{draftPurchasers}}" wx:key="purchaserUserId" data-id="{{item.purchaserUserId}}" bindtap="togglePurchaser">
          <image class="filter-avatar" src="{{item.avatarUrl||'/images/user.png'}}" mode="aspectFill"></image>
          <view class="filter-option-main"><text class="filter-option-name">{{item.purchaserName||('采购员 #'+item.purchaserUserId)}}</text><text class="filter-option-copy">{{item.purchaserStatusText}} · 本期 {{item.periodPurchaseRecordCount||0}} 条采购</text></view>
          <text class="filter-check">{{item.selected?'✓':''}}</text>
        </view>
      </scroll-view>
      <view class="filter-sheet-foot">
        <text class="filter-selected-count">已选 {{draftSelectedCount}} 位</text>
        <button class="filter-apply" bindtap="applyPurchaserFilter">应用筛选</button>
      </view>
    </view>
  </view>
</view>
