<view class="pm-page"><back-navbar style="height:{{navBarHeight}}rpx" title="采购员详情" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar><scroll-view scroll-y class="pm-body" style="padding-top:{{navBarHeight}}rpx" bindscrolltolower="more">
<view wx:if="{{loading}}" class="pm-state">正在加载…</view><view wx:elif="{{error}}" class="pm-state">{{error}}</view><block wx:else><view class="pm-card"><view class="pm-row"><text class="pm-name">{{detail.purchaserName||'历史采购员'}}</text><text class="pm-badge">{{detail.purchaserStatusText}}</text></view><text class="pm-muted">{{detail.accountStatusText}} · {{detail.summary.dataCompletenessText}} · 覆盖率 {{detail.summary.dataCoverageRate}}</text><view class="pm-grid"><view class="pm-metric"><text class="pm-label">批次 / 商品行</text><text>{{detail.summary.totalBatchCount||0}} / {{detail.summary.goodsLineCount||0}}</text></view><view class="pm-metric"><text class="pm-label">预计金额</text><text>¥{{detail.summary.expectedAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际收货</text><text>{{detail.summary.actualReceiptAmount==null?'—':'¥'}}{{detail.summary.actualReceiptAmount}}</text></view><view class="pm-metric"><text class="pm-label">实际净采购 / 退货</text><text class="pm-money">{{detail.summary.actualNetPurchaseAmount==null?'—':'¥'}}{{detail.summary.actualNetPurchaseAmount}} / {{detail.summary.supplierReturnAmount==null?'—':'¥'}}{{detail.summary.supplierReturnAmount}}</text></view><view class="pm-metric"><text class="pm-label">损耗 / 降价影响</text><text>{{detail.summary.lossCost==null?'—':'¥'}}{{detail.summary.lossCost}} / {{detail.summary.markdownImpact==null?'—':'¥'}}{{detail.summary.markdownImpact}}</text></view><view class="pm-metric"><text class="pm-label">当前 / 最终毛利</text><text>{{detail.summary.currentRealizedMargin==null?'—':'¥'}}{{detail.summary.currentRealizedMargin}} / {{detail.summary.completedFinalMargin==null?'—':'¥'}}{{detail.summary.completedFinalMargin}}</text></view></view></view>
<view class="pm-card"><text class="pm-section-title">需求来源</text><view class="pm-tabs"><text class="pm-tab {{!demandSource?'on':''}}" data-value="" bindtap="chooseSource">全部</text><text class="pm-tab {{demandSource==='ORDER_GENERATED'?'on':''}}" data-value="ORDER_GENERATED" bindtap="chooseSource">订单</text><text class="pm-tab {{demandSource==='SHELF_REPLENISHMENT'?'on':''}}" data-value="SHELF_REPLENISHMENT" bindtap="chooseSource">货架</text><text class="pm-tab {{demandSource==='SMART_REPLENISHMENT'?'on':''}}" data-value="SMART_REPLENISHMENT" bindtap="chooseSource">智能备货</text></view><text class="pm-section-title">执行方式</text><view class="pm-tabs"><text class="pm-tab {{!procurementMode?'on':''}}" data-value="" bindtap="chooseMode">全部</text><text class="pm-tab {{procurementMode==='SELF_BUY'?'on':''}}" data-value="SELF_BUY" bindtap="chooseMode">自采</text><text class="pm-tab {{procurementMode==='AUTO_SUPPLIER'?'on':''}}" data-value="AUTO_SUPPLIER" bindtap="chooseMode">自动供应商</text><text class="pm-tab {{procurementMode==='EXTERNAL_SUPPLIER'?'on':''}}" data-value="EXTERNAL_SUPPLIER" bindtap="chooseMode">供应商采购</text></view></view>
<view class="pm-card"><text class="pm-section-title">采购批次</text><view wx:if="{{!items.length}}" class="pm-state">当前筛选暂无批次</view><view class="batch" wx:for="{{items}}" wx:key="batchId" data-id="{{item.batchId}}" bindtap="openBatch"><view class="pm-row"><text class="pm-name">{{item.batchNumber}}</text><text class="pm-link">{{item.businessDate}} ›</text></view><text class="pm-muted">{{item.supplierName||'自采/无固定供应商'}} · {{item.procurementModeText}} · {{item.demandSources}}</text><view class="pm-line"><text>计划 ¥{{item.expectedAmount}}</text><text>实际净额 {{item.actualNetPurchaseAmount==null?'—':'¥'}}{{item.actualNetPurchaseAmount}}</text></view><view class="pm-line"><text>{{item.receiptStatusText}} / {{item.putawayStatusText}}</text><text>{{item.dataCompletenessText}}</text></view></view><view wx:if="{{batchLoading}}" class="pm-state">正在加载更多…</view></view></block>
</scroll-view></view>
