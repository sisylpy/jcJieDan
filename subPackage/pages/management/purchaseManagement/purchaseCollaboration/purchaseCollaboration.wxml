<view class="pm-page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购协同" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="supplier-scroll" style="padding-top:{{navBarHeight}}rpx" scroll-top="{{scrollTop}}"
    bindscroll="rememberScroll" bindscrolltolower="more">
    <view class="supplier-body">
      <report-date-filter label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>

      <view class="page-heading">
        <view>
          <text class="page-title">供应方</text>
          <text class="page-caption">按合作关系查看采购，点击供应方查看其采购记录</text>
        </view>
        <text class="supplier-total">{{supplierTotal||0}}家</text>
      </view>

      <view class="search-bar">
        <text class="search-icon">⌕</text>
        <input class="search-input" value="{{keyword}}" placeholder="搜索供应方名称" bindinput="inputKeyword"
          confirm-type="search" bindconfirm="search" />
        <text class="search-action" bindtap="search">搜索</text>
      </view>

      <view class="toolbar">
        <view class="toolbar-left">
          <text class="toolbar-button {{supplierType?'active':''}}" bindtap="openTypeSheet">
            {{supplierType==='INTERNAL_DISTRIBUTER'?'内部协作配送商':(supplierType==='EXTERNAL_JRDH'?'外部供应商':'全部供应方')}}⌄
          </text>
          <text class="toolbar-button" bindtap="openSortSheet">{{sortText}}⌄</text>
        </view>
        <text class="data-note-link" bindtap="openDataNote">数据说明</text>
      </view>

      <view wx:if="{{supplierSyncing}}" class="status-notice neutral">正在更新当前日期范围的供应方采购数据…</view>
      <view wx:if="{{supplierSyncNotice}}" class="status-notice warn">{{supplierSyncNotice}}</view>

      <view wx:if="{{supplierError}}" class="state-panel error-state">
        <text class="state-title">供应方数据加载失败</text>
        <text class="state-copy">{{supplierError}}</text>
        <text class="state-button" bindtap="retrySuppliers">重新加载</text>
      </view>

      <view wx:if="{{!supplierSyncing&&!supplierLoading&&!supplierItems.length&&!supplierError}}" class="state-panel">
        <text class="state-title">没有符合条件的供应方</text>
        <text class="state-copy">可以调整日期、类型或搜索条件后重试。</text>
      </view>

      <view class="supplier-card" wx:for="{{supplierItems}}" wx:key="purchaseSupplierRefId"
        data-id="{{item.purchaseSupplierRefId}}" bindtap="openSupplier">
        <view class="card-heading">
          <view class="identity">
            <text class="supplier-name">{{item.supplierName||'名称待核对'}}</text>
            <text class="type-badge {{item.typeClass}}">{{item.supplierTypeText}}</text>
            <text wx:if="{{item.relationText}}" class="relation-badge">{{item.relationText}}</text>
          </view>
          <text class="card-arrow">›</text>
        </view>

        <view class="amount-row">
          <text class="amount-label">本期采购金额</text>
          <text class="amount-value {{item.amountState==='unresolved'?'muted':''}}">{{item.purchaseAmountText}}</text>
        </view>

        <view class="meta-row">
          <text>{{item.purchaseCountText}}张采购单</text>
          <text class="meta-dot">·</text>
          <text>{{item.goodsLineCountText}}条商品记录</text>
          <text class="meta-dot">·</text>
          <text>最近采购 {{item.lastPurchaseDate||'—'}}</text>
        </view>

        <view wx:if="{{item.amountScopeText}}" class="amount-note {{item.amountState}}">
          <text class="note-mark">{{item.amountState==='no-record'?'':'!'}}</text>
          <text>{{item.amountScopeText}}</text>
        </view>
        <view wx:if="{{item.qualityText}}" class="quality-warning">{{item.qualityText}}</view>

        <view class="card-footer">
          <text>查看采购记录与批次</text><text>›</text>
        </view>
      </view>

      <view wx:if="{{supplierLoading}}" class="loading-state">正在加载供应方…</view>
      <view wx:elif="{{!supplierHasMore&&supplierItems.length}}" class="list-end">已显示全部供应方</view>
    </view>
  </scroll-view>

  <view class="sheet-mask" wx:if="{{showTypeSheet||showSortSheet||showDataNote}}" bindtap="closeSheets">
    <view class="bottom-sheet" catchtap="stopPropagation">
      <block wx:if="{{showTypeSheet}}">
        <view class="sheet-title">供应方类型</view>
        <view class="sheet-option {{supplierType===''?'selected':''}}" data-value="" bindtap="chooseType">全部供应方</view>
        <view class="sheet-option {{supplierType==='INTERNAL_DISTRIBUTER'?'selected':''}}" data-value="INTERNAL_DISTRIBUTER" bindtap="chooseType">内部协作配送商</view>
        <view class="sheet-option {{supplierType==='EXTERNAL_JRDH'?'selected':''}}" data-value="EXTERNAL_JRDH" bindtap="chooseType">外部供应商</view>
      </block>
      <block wx:elif="{{showSortSheet}}">
        <view class="sheet-title">排序方式</view>
        <view class="sheet-option {{sort==='LAST_PURCHASE'?'selected':''}}" data-value="LAST_PURCHASE" bindtap="chooseSort">最近采购</view>
        <view class="sheet-option {{sort==='PURCHASE_AMOUNT'?'selected':''}}" data-value="PURCHASE_AMOUNT" bindtap="chooseSort">采购金额从高到低</view>
        <view class="sheet-option {{sort==='PURCHASE_COUNT'?'selected':''}}" data-value="PURCHASE_COUNT" bindtap="chooseSort">采购单数从多到少</view>
      </block>
      <block wx:else>
        <view class="sheet-title">供应方数据说明</view>
        <text class="sheet-copy">采购金额是当前日期范围内，来源小计可以识别且未取消的采购记录合计，不代表已收货、已付款或实际净采购。</text>
        <text class="sheet-copy">点击供应方可查看该供应方在所选日期内的采购记录、来源批次及商品汇总。</text>
        <text class="sheet-copy">金额待核对的记录不会按0元处理，也不会计入已识别采购金额。</text>
      </block>
      <view class="sheet-close" bindtap="closeSheets">关闭</view>
    </view>
  </view>
</view>
