@import "../common.wxss";

.collaboration-page{height:100vh;background:linear-gradient(180deg,#f2f8f6 0,#f6f8f7 360rpx,#f5f7f6 100%);color:#20312d}
.collaboration-scroll{height:100%;box-sizing:border-box}.page-body{padding:8rpx 18rpx 54rpx}.intro-copy{text-align:center;color:#84928e;font-size:21rpx;letter-spacing:1rpx;padding:0 0 16rpx}
.mode-switch{display:flex;margin-bottom:14rpx;padding:6rpx;background:#e8f1ee;border-radius:18rpx}.mode-option{flex:1;display:flex;align-items:baseline;justify-content:center;gap:10rpx;padding:16rpx 10rpx;color:#63736e;font-size:27rpx;border-radius:14rpx}.mode-option.active{background:#fff;color:#117c68;font-weight:700;box-shadow:0 6rpx 18rpx rgba(31,88,75,.08)}.mode-caption{font-size:19rpx;font-weight:400;color:#91a09c}
.query-card{padding:16rpx;background:rgba(255,255,255,.96);border:1rpx solid #e2ece8;border-radius:20rpx;box-shadow:0 8rpx 26rpx rgba(41,83,73,.06)}
.search-bar{display:flex;align-items:center;height:68rpx;margin-top:12rpx;background:#f2f6f4;border-radius:34rpx;overflow:hidden}.search-mark{padding-left:18rpx;color:#80908b;font-size:29rpx}.search-input{flex:1;min-width:0;padding:0 12rpx;font-size:23rpx;color:#263833}.search-action{height:68rpx;line-height:68rpx;padding:0 24rpx;background:#e5f3ef;color:#117d69;font-size:23rpx;font-weight:650}
.progress-scroll{width:100%;margin-top:14rpx}.progress-tabs{display:inline-flex;gap:10rpx;padding-bottom:2rpx}.progress-tab{display:inline-block;min-width:92rpx;padding:10rpx 16rpx;text-align:center;background:#f3f7f5;color:#61716c;border-radius:25rpx;font-size:21rpx;white-space:nowrap}.progress-tab.active{background:#138b74;color:#fff;box-shadow:0 5rpx 14rpx rgba(19,139,116,.2)}
.filter-row{display:flex;align-items:center;gap:9rpx;margin-top:13rpx;min-width:0}.filter-picker{flex:1;min-width:0}.filter-chip{display:block;max-width:205rpx;padding:11rpx 12rpx;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#fff;border:1rpx solid #dfe9e5;border-radius:10rpx;color:#52635e;font-size:20rpx}.filter-chip.selected{border-color:#9fd0c5;background:#edf8f5;color:#117e69}.filter-trigger{flex:none;max-width:none}.supplier-filters .data-note-link{margin-left:auto;color:#168471;font-size:21rpx;white-space:nowrap}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);margin:14rpx 0;background:linear-gradient(135deg,#f4fbf8,#eaf7f3);border:1rpx solid #dcece7;border-radius:18rpx;overflow:hidden}.summary-item{position:relative;display:flex;align-items:center;justify-content:center;gap:10rpx;min-height:92rpx;border-right:1rpx solid #d9e9e4}.summary-item:last-child{border-right:0}.summary-icon{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;color:#168a74;font-size:25rpx}.purchaser-icon{font-size:27rpx}.summary-label,.summary-value{display:block}.summary-label{color:#71827d;font-size:18rpx}.summary-value{margin-top:2rpx;color:#193d34;font-size:30rpx;font-weight:750}.summary-arrow{position:absolute;right:7rpx;color:#8bb7ad;font-size:29rpx}.tappable{background:rgba(255,255,255,.24)}
.batch-card,.supplier-card{margin-bottom:14rpx;background:#fff;border:1rpx solid #e3ece9;border-radius:18rpx;box-shadow:0 7rpx 22rpx rgba(41,75,67,.055);overflow:hidden}.batch-card{padding:18rpx}.card-topline,.badge-group,.supplier-heading,.supplier-identity,.supplier-amount,.supplier-footer{display:flex;align-items:center}.card-topline,.supplier-heading,.supplier-amount,.supplier-footer{justify-content:space-between}.badge-group{gap:8rpx;min-width:0}.purpose-badge,.type-badge,.relation-badge,.progress-badge{display:inline-block;padding:5rpx 10rpx;border-radius:9rpx;font-size:18rpx}.purpose-badge{background:#e7f6f1;color:#11806a}.purpose-badge.warning{background:#fff1dc;color:#a66113}.batch-number{font-size:20rpx;color:#84918d}.progress-badge{max-width:230rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#e8f6f2;color:#16816d}.progress-badge.action{background:#fff0df;color:#eb7626}.card-title{display:block;margin-top:14rpx;font-size:30rpx;color:#1f302c;font-weight:750}
.context-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx 16rpx;margin-top:14rpx}.context-line{display:flex;align-items:center;min-width:0;color:#697873;font-size:20rpx}.context-line.wide{grid-column:1 / 3}.context-mark{flex:none;display:flex;align-items:center;justify-content:center;width:28rpx;height:28rpx;margin-right:7rpx;background:#e7f6f1;color:#16816d;border-radius:50%;font-size:16rpx;font-weight:700}.context-mark.supplier{background:#eef6f9;color:#478196}.context-mark.goods{background:#f0f5f3;color:#4e7168}.context-mark.date{background:#eff7f4;color:#1a8c76}.context-label{flex:none;margin-right:6rpx;color:#7f8e89}.context-value{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#4e5f5a}
.metric-row{display:grid;grid-template-columns:1.08fr .72fr 1.08fr .78fr;gap:8rpx;margin:17rpx -8rpx -8rpx;padding:10rpx 8rpx 8rpx;background:#f7faf9;border-radius:13rpx}.metric-cell{min-width:0;padding:4rpx 8rpx;border-right:1rpx solid #e6eeeb}.metric-label,.metric-value{display:block}.metric-label{color:#87948f;font-size:18rpx}.metric-value{margin-top:4rpx;color:#283934;font-size:22rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.metric-value.money{color:#ef7b28}.metric-value.pending{color:#d76d30;font-size:19rpx}.progress-value{color:#287bdc;font-size:19rpx}.detail-entry{display:flex;align-items:center;justify-content:space-between;color:#14836e;font-size:20rpx;font-weight:650;padding-left:4rpx}
.warning-note{margin-top:12rpx;padding:11rpx 13rpx;border-radius:10rpx;background:#fff5e8;color:#a3631e;font-size:20rpx;line-height:1.5}.quality-warning{margin-top:10rpx;color:#b24b3e;font-size:21rpx}
.state-card{padding:90rpx 24rpx;text-align:center;background:#fff;border:1rpx solid #e3ece9;border-radius:18rpx}.state-card text{display:block}.state-title{font-size:27rpx;font-weight:700;color:#34443f}.state-copy{margin-top:12rpx;color:#788681;font-size:22rpx}.state-button{display:inline-block!important;margin-top:22rpx;padding:12rpx 25rpx;background:#168471;color:#fff;border-radius:23rpx;font-size:22rpx}.error-state .state-title{color:#914d42}.loading-state,.list-end{padding:30rpx;text-align:center;color:#87948f;font-size:21rpx}
.status-notice{margin:14rpx 0;padding:13rpx 16rpx;border-radius:12rpx;background:#ebf4f1;color:#58706a;font-size:21rpx}.status-notice.warning{background:#fff5e7;color:#93601f}
.supplier-card{padding:20rpx 20rpx 0}.supplier-heading{align-items:flex-start}.supplier-identity{flex-wrap:wrap;gap:8rpx;min-width:0}.supplier-name{font-size:29rpx;font-weight:750;color:#20332e}.type-badge.internal{color:#117763;background:#e7f6f1}.type-badge.external{color:#9a611f;background:#fff2df}.relation-badge{color:#985f1a;background:#fff6e8}.card-arrow{color:#9caaa5;font-size:35rpx}.supplier-amount{margin-top:19rpx;color:#71817c;font-size:21rpx}.amount-value{color:#ef7927;font-size:33rpx;font-weight:750}.amount-value.muted{color:#a26b27;font-size:25rpx}.supplier-meta{display:flex;align-items:center;flex-wrap:wrap;gap:7rpx;margin-top:12rpx;color:#687873;font-size:20rpx;line-height:1.6}.supplier-footer{margin-top:17rpx;padding:14rpx 0;border-top:1rpx solid #edf2f0;color:#168471;font-size:21rpx}
.sheet-mask{position:fixed;z-index:1000;left:0;right:0;top:0;bottom:0;display:flex;align-items:flex-end;background:rgba(25,43,38,.42)}.bottom-sheet{width:100%;padding:27rpx 27rpx calc(25rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;border-radius:28rpx 28rpx 0 0}.sheet-heading{display:flex;align-items:center;justify-content:space-between;padding-bottom:18rpx;border-bottom:1rpx solid #e9efed}.sheet-title{font-size:30rpx;font-weight:750;color:#22342f}.sheet-reset{color:#168471;font-size:23rpx}.sheet-label{display:block;margin-top:23rpx;color:#667772;font-size:22rpx}.sheet-options{display:flex;flex-wrap:wrap;gap:11rpx;margin-top:11rpx}.sheet-chip{padding:10rpx 17rpx;background:#f3f6f5;border:1rpx solid transparent;border-radius:22rpx;color:#596a65;font-size:21rpx}.sheet-chip.selected{background:#e6f6f1;border-color:#95cdbf;color:#117d69}.sheet-apply{margin-top:28rpx;padding:15rpx;text-align:center;background:#158772;color:#fff;border-radius:29rpx;font-size:24rpx;font-weight:650}.sheet-apply.secondary{background:#edf5f2;color:#147e6a}.sheet-copy{display:block;margin-top:18rpx;color:#53655f;font-size:23rpx;line-height:1.7}
