page {
  background: #f3f6f5;
}

.staff-page {
  min-height: 100vh;
  color: #20322d;
}

.staff-content {
  padding: 18rpx 18rpx calc(40rpx + env(safe-area-inset-bottom));
}

.staff-group-card {
  margin-bottom: 18rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e1e9e6;
  border-radius: 22rpx;
  box-shadow: 0 7rpx 22rpx rgba(28, 65, 56, 0.06);
}

.staff-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(135deg, #edf6f3 0%, #f7faf9 100%);
  border-bottom: 1rpx solid #e2ebe8;
  box-sizing: border-box;
}

.staff-section-heading {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-right: 16rpx;
}

.staff-section-title {
  color: #173f36;
  font-size: 29rpx;
  font-weight: 700;
}

.staff-section-subtitle {
  margin-top: 5rpx;
  color: #84948f;
  font-size: 21rpx;
}

button.staff-invite-button,
.staff-invite-ghost {
  flex-shrink: 0;
  min-width: 154rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
  background: #147b65;
  border-radius: 30rpx;
  box-sizing: border-box;
}

.staff-invite-ghost {
  color: #147b65;
  line-height: 56rpx;
  background: #fff;
  border: 1rpx solid #71b8a8;
}

button.staff-invite-button::after {
  border: 0;
}

button.staff-invite-button[disabled] {
  color: #a1ada9;
  background: #e6ecea;
}

.staff-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 122rpx;
  padding: 24rpx 18rpx 24rpx 22rpx;
  background: #fff;
  border-bottom: 1rpx solid #edf1f0;
  box-sizing: border-box;
}

.staff-user-row:last-of-type {
  border-bottom: 0;
}

.staff-sales-row,
.driver-staff-row {
  align-items: flex-start;
}

.staff-person-main {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.staff-person-top {
  align-items: flex-start;
}

.member_url {
  flex-shrink: 0;
  width: 74rpx;
  height: 74rpx;
  margin-right: 18rpx;
  background: #edf2f0;
  border: 3rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(28, 65, 56, 0.12);
}

.staff-user-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.staff-user-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.staff-user-name {
  overflow: hidden;
  color: #1d2e29;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self-tag,
.duty-self-tag {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 3rpx 10rpx;
  color: #147b65;
  font-size: 19rpx;
  background: #e7f5f1;
  border-radius: 12rpx;
}

.staff-user-phone {
  margin-top: 5rpx;
  overflow: hidden;
  color: #6f807b;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role-caption {
  align-self: flex-start;
  margin-top: 11rpx;
  padding: 5rpx 14rpx;
  color: #66756f;
  font-size: 22rpx;
  background: #f0f3f2;
  border-radius: 11rpx;
}

.role-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 10rpx;
}

.staff-field-label {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #71817c;
  font-size: 23rpx;
}

.role-row picker {
  min-width: 0;
}

.role-picker {
  max-width: 330rpx;
  overflow: hidden;
  padding: 7rpx 15rpx;
  color: #147b65;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #eaf7f3;
  border-radius: 11rpx;
  box-sizing: border-box;
}

.role-picker.locked {
  color: #66736f;
  background: #f0f3f2;
}

.clerk-picker {
  max-width: 360rpx;
}

.picker-arrow {
  margin-left: 4rpx;
}

.staff-more-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-left: 8rpx;
  border-radius: 50%;
}

.staff-more-top {
  margin-top: 2rpx;
}

.staff-more-hover {
  background: #edf3f1;
}

.staff-more-icon {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.72;
}

.staff-empty {
  padding: 38rpx 20rpx;
  color: #99a5a1;
  font-size: 24rpx;
  text-align: center;
  background: #fff;
}

.driver-staff-main {
  min-width: 0;
}

.driver-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 8rpx;
}

.driver-duty-switch {
  margin-right: -4rpx;
  transform: scale(0.78);
}

.duty-status-label {
  align-self: flex-start;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.duty-status-label-on {
  color: #0b8c70;
}

.duty-status-label-off {
  color: #929d99;
}

.driver-employment-row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.driver-employment-label {
  flex-shrink: 0;
  margin: 7rpx 10rpx 0 0;
  color: #7a8984;
  font-size: 21rpx;
}

.driver-employment-options {
  display: flex;
  flex-wrap: wrap;
}

.driver-employment-option {
  margin: 0 7rpx 7rpx 0;
  padding: 6rpx 11rpx;
  color: #687771;
  font-size: 20rpx;
  line-height: 1.35;
  background: #f1f4f3;
  border: 1rpx solid #d9e1df;
  border-radius: 10rpx;
}

.driver-employment-option-active {
  color: #087b63;
  font-weight: 600;
  background: #e6f5f1;
  border-color: #83c7b8;
}

.driver-employment-option-disabled {
  opacity: 0.55;
}

.page-bottom {
  height: 20rpx;
}

.operation-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  padding: 0 18rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #f4f6f5;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -12rpx 36rpx rgba(0, 0, 0, 0.16);
}

.operation-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 14rpx auto 12rpx;
  background: #cbd3d0;
  border-radius: 6rpx;
}

.operation-user-summary {
  display: flex;
  align-items: center;
  padding: 15rpx 14rpx 20rpx;
}

.operation-avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  background: #e5ece9;
  border-radius: 50%;
}

.operation-user-copy {
  display: flex;
  flex-direction: column;
}

.operation-user-name {
  color: #1d302a;
  font-size: 29rpx;
  font-weight: 700;
}

.operation-user-role {
  margin-top: 4rpx;
  color: #84918d;
  font-size: 21rpx;
}

.operation-menu {
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}

.operation-item {
  display: flex;
  align-items: center;
  min-height: 102rpx;
  padding: 0 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #edf1f0;
  box-sizing: border-box;
}

.operation-item.danger {
  border-bottom: 0;
}

.operation-symbol {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 17rpx;
  color: #147b65;
  font-size: 24rpx;
  font-weight: 700;
  background: #eaf6f2;
  border-radius: 16rpx;
}

.customer-symbol {
  color: #137f68;
  background: #e4f5ef;
}

.danger-symbol {
  background: #fff0ef;
}

.operation-icon {
  width: 31rpx;
  height: 31rpx;
}

.operation-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.operation-title {
  color: #253832;
  font-size: 27rpx;
  font-weight: 600;
}

.operation-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #8b9894;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operation-item.danger .operation-title {
  color: #c64c43;
}

.operation-arrow {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #a7b0ad;
  font-size: 42rpx;
  font-weight: 300;
}

.operation-cancel {
  margin-top: 12rpx;
  color: #53645f;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 82rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
}
