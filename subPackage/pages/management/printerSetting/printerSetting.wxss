.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.section-list {
  padding: 20rpx;
  box-sizing: border-box;
}

.printer-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
}

.status-row,
.input-row,
.size-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.status-label,
.input-label {
  font-size: 30rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.status-on {
  font-size: 28rpx;
  color: #167063;
  word-break: break-all;
  text-align: right;
}

.status-off {
  font-size: 28rpx;
  color: #d94841;
}

.size-value {
  font-size: 28rpx;
  color: #167063;
}

.input-row {
  justify-content: flex-start;
}

.sn-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.btn-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 30rpx;
}

.btn {
  min-width: 180rpx;
  padding: 18rpx 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border: none;
  margin-left: 20rpx;
}

.btn-primary {
  background-color: #167063;
  color: #fff;
}

.btn-primary[disabled] {
  background-color: #a3c9c3;
  color: #fff;
}

.btn-default {
  background-color: #f0f0f0;
  color: #333;
}

.btn-default::after,
.btn-primary::after {
  border: none;
}
