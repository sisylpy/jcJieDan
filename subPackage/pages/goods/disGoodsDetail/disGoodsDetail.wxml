    <view class="text-secondary p-20">可填:</view>
    <view class="bg-white flex-column">
      <view class=" flex-row p-20">
        <view class="flex-row flex-fixed">
          <text class="text-secondary  m-10">单位重量</text>
        </view>
        <input value="{{goods.nxDgGoodsStandardWeight}}" class="inputAddGoods with-tb-padding" bindinput="getDisGoodsContent" data-type="2"></input>
      </view>
      
      <view class=" flex-row p-20">
        <text class="text-secondary flex-fixed m-10">外箱名称</text>
        <input class="inputAddGoods with-tb-padding" value="{{goods.nxDgCartonUnit}}" bindinput="getDisGoodsContent" data-type="9"></input>
      </view>
      <view class=" flex-row p-20">
        <text class="text-secondary flex-fixed m-10">外箱装数量</text>
        <input class="inputAddGoods with-tb-padding" type="digit" value="{{goods.nxDgItemsPerCarton}}" bindinput="getDisGoodsContent" data-type="10"></input>
      </view>

      <view class=" flex-row p-20">
        <text class="text-secondary flex-fixed m-10">品牌</text>
        <input class="inputAddGoods with-tb-padding" bindinput="getDisGoodsContent" data-type="3" value="{{goods.nxDgGoodsBrand}}"></input>
      </view>

      <view class=" flex-row p-20">
        <text class="text-secondary flex-fixed m-10">产地</text>
        <input class="inputAddGoods with-tb-padding" value="{{goods.nxDgGoodsPlace}}" bindinput="getDisGoodsContent" data-type="4"></input>
      </view>
      <view class=" flex-row p-20">
        <text class="text-secondary flex-fixed m-10">详细</text>
        <input class="inputAddGoods with-tb-padding" value="{{goods.nxDgGoodsDetail}}" bindinput="getDisGoodsContent" data-type="7"></input>
      </view>
     

    </view>
  </view>

</view>