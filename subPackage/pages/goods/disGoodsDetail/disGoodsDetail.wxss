

page{
  background: #f5f5f5;
}

.inputPrice{
  border-bottom: 1px solid rgb(233, 231, 231);
  line-height: 80rpx;
  padding: 10rpx 10rpx;
}

.inputAddGoods{
  border-bottom: 1px solid rgb(233, 231, 231);
  /* width: 100%; */
  padding-left: 10rpx;
}
.inputAddGoodsHalf{
  border-bottom: 1px solid rgb(233, 231, 231);
  width: 30%;
  padding-left: 10rpx;
  line-height: 70rpx;
}

.saveBtn{
  width: 80%;
  line-height: 80rpx;
  background: rgb(21, 181, 187);
  color: #fff;
  margin-left: 10%;
  border-radius: 10rpx;
  text-align: center;
}


.addBtn{
  border-radius: 40rpx;
  padding: 6rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  background-color: rgb(184, 183, 183);
}
.addBtn.is-active{
  color: #fff;
  background-color: #187e6e;

}

.addBtn-sm{
  border-radius: 30rpx;
  padding: 4rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background-color: #187e6e;
}

.tier-row{
  border-bottom: 1px solid rgb(233, 231, 231);
}
