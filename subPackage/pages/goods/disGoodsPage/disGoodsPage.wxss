/* 编辑按钮样式 */
.edit-btn-small {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 50rpx;
  background: #e3f2fd;
  transition: all 0.3s ease;
}

.edit-btn-small:active {
  transform: scale(0.95);
  background: #bbdefb;
}

.icon-small {
  width: 24rpx;
  height: 24rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.mr-5 {
  margin-right: 5rpx;
}

/* 弹窗遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 编辑弹窗 */
.edit-popup {
  background: #fff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
  transform: scale(0.8);
  transition: transform 0.3s ease;
}

.overlay.show .edit-popup {
  transform: scale(1);
}

/* 弹窗头部 */
.popup-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  text-align: center;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 弹窗内容 */
.popup-content {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.goods-info-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f3f4;
}

.goods-info-header .goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
  display: block;
}

.goods-info-header .goods-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}

/* 输入组 */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
}

.input-wrapper .input-field {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #2c3e50;
  background: transparent;
  border: none;
}

.input-unit {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-left: 12rpx;
}

.input-field {
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  background: #f8f9fa;
}

.input-field:focus {
  border-color: #667eea;
  background: #fff;
}

/* 弹窗操作按钮 */
.popup-actions {
  display: flex;
  border-top: 1rpx solid #f1f3f4;
}

.popup-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.popup-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #f8f9fa;
  border-radius: 0 0 0 20rpx;
}

.cancel-btn .btn-text {
  color: #6c757d;
}

.cancel-btn:active {
  background: #e9ecef;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 20rpx 0;
}

.confirm-btn .btn-text {
  color: #fff;
}

.confirm-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
}

.popup-btn .btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

/* 溯源报告弹窗 */
.trace-report-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.modal-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content-trace {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  height: 80vh;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e9ecef;
  flex-shrink: 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.modal-body-content {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
}

.input-field {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  background-color: #f8f9fa;
  box-sizing: border-box;
}

.picker-view {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  background-color: #f8f9fa;
  box-sizing: border-box;
}

.file-upload-area {
  width: 100%;
}

.file-preview {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.preview-content {
  margin-bottom: 10rpx;
}

.preview-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.preview-pdf {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ddd;
  color: #666;
  font-size: 24rpx;
}

.file-name {
  margin-bottom: 10rpx;
  color: #333;
  font-size: 24rpx;
}

.file-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
}

.file-upload-btn {
  width: 100%;
  padding: 20rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  text-align: center;
  color: #333;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #e9ecef;
  flex-shrink: 0;
}

.modal-footer .btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
}

.modal-footer .btn-cancel {
  background-color: #f8f9fa;
  color: #6c757d;
  border-radius: 0 0 0 20rpx;
}

.modal-footer .btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 0 0 20rpx 0;
}
