  <!-- + scrollViewTop -->
  <view class="popup" wx:if="{{showChoice}}">
    <view class="p-20 mb-20 border-bottom" bindtap="edit">
      编辑
    </view>
    <view class="p-20" bindtap="delete">删除</view>
  </view>

  <view class="flex-column nnn bg-white font-md" wx:else>

    <view class=" flex-row p-20 border-bottom" bindtap="toOpenDetail">
      <image src="../../../../images/edit.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">修改商品</text>
    </view>

    <view class=" flex-row p-20 border-bottom" bindtap="toSupplier" wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}">
      <image src="../../../../images/supplier.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">指定供货商</text>
    </view>
    <view class=" flex-row p-20 border-bottom" bindtap="exchangeGoods">
      <image src="../../../../images/del.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">转商品</text>
    </view>

    <!-- <view class=" flex-row p-20 border-bottom" bindtap="addBrotherGoods">
      <image src="../../../../images/del.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">添加兄弟商品</text>
    </view> -->


    <!-- <view class=" flex-row p-20 border-bottom" bindtap="toCustomerServicePages" hover-class="hoverIcon">
      <image src="../../../../images/kefu.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">找客服协助</text>
    </view> -->

    <view class="flex-row p-20 border-bottom" bindtap="deleteDisGoods">
      <image src="../../../../images/ashbin.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation mr-20">删除商品</text>
    </view>

    <view style="height: 20rpx;"></view>

  </view>
</view>
<!-- ./mask -->


<addStandard show="{{showAdd}}" bindgetFocus="getFocus" bindconfirm="confirmStandard" bindcancle="cancle" depGoodsName="{{depGoodsName}}" standardName="{{standardName}}" edit="{{editStandard}}" itemStandard="{{itemStandard}}" modalHeight="{{maskHeight > windowHeight ? maskHeight : windowHeight}}" scrollViewTop="{{scrollViewTop}}" modalContentHeight="{{modalContentHeight}}" />


<addDisAlias show="{{showAddAlias}}" bindgetFocus="getFocus" bindconfirm="confirmAlias" bindcancle="cancle" depGoodsName="{{depGoodsName}}" standardName="{{standardName}}" edit="{{editAlias}}" standardName="{{standardName}}" modalHeight="{{windowHeight > maskHeight ? windowHeight : maskHeight }}" scrollViewTop="{{scrollViewTop}}" modalContentHeight="{{modalContentHeight}}" itemAlias="{{itemAlias}}" />


<!-- 编辑客户商品价格弹窗 -->
<view class='overlay {{showOperationPrice ? "show" : ""}}' catchtouchmove='true'>
  <view class="edit-popup">
    <view class="popup-header">
      <text class="popup-title">编辑客户商品信息</text>
    </view>
    
    <view class="popup-content">
      <view class="goods-info-header">
        <text class="goods-name">{{goods.nxDgGoodsName}}</text>
        <text class="goods-detail" wx:if="{{goods.nxDgGoodsDetail != null && goods.nxDgGoodsDetail.length > 0}}">
          {{goods.nxDgGoodsDetail}}
        </text>
      </view>

      <view class="input-group">
        <view class="input-item">
          <text class="input-label">配送单价:</text>
          <view class="input-wrapper">
            <input wx:if="{{showOperationPrice}}" type="digit" class="input-field" bindinput="inputSellingPrice" value="{{sellingPrice}}" placeholder="请输入价格" />
            <text class="input-unit">元/{{goods.nxDgGoodsStandardname}}</text>
          </view>
        </view>

        <view class="input-item">
          <text class="input-label">出货要求:</text>
          <input wx:if="{{showOperationPrice}}" type="text" class="input-field" bindinput="inputPickDetail" value="{{pickDetail}}" placeholder="请输入出货要求" />
        </view>

        <view class="input-item">
          <text class="input-label">订货商品名称:</text>
          <input wx:if="{{showOperationPrice}}" type="text" class="input-field" bindinput="inputOrderName" value="{{orderName}}" placeholder="请输入商品名称" />
        </view>
      </view>
    </view>

    <view class="popup-actions">
      <view class="popup-btn cancel-btn" catchtap="hideMaskPrice">
        <text class="btn-text">取消</text>
      </view>
      <view class="popup-btn confirm-btn" catchtap="_updateDepGoods">
        <text class="btn-text">保存</text>
      </view>
    </view>
  </view>
</view>

<!-- 添加溯源报告弹窗 -->
<view class="trace-report-modal" wx:if="{{showAddTraceReport}}" catchtouchmove="true">
  <view class="modal-overlay" bindtap="closeAddTraceReport"></view>
  <view class="modal-content-trace" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">添加溯源报告</text>
      <view class="modal-close" bindtap="closeAddTraceReport">×</view>
    </view>
    
    <scroll-view class="modal-body" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="modal-body-content">
      <!-- 溯源报告文件 -->
      <view class="form-item">
        <text class="form-label">溯源报告文件:</text>
        <view class="file-upload-area">
          <!-- 文件预览 -->
          <view wx:if="{{traceReportFilePreview || traceReportFileName}}" class="file-preview">
            <view wx:if="{{traceReportFilePreview}}" class="preview-content">
              <image wx:if="{{isImageFile}}" src="{{traceReportFilePreview}}" mode="aspectFit" class="preview-image"></image>
              <view wx:else class="preview-pdf">
                <text>PDF文件</text>
              </view>
            </view>
            <view wx:if="{{traceReportFileName}}" class="file-name">
              <text>{{traceReportFileName}}</text>
            </view>
            <view class="file-delete" bindtap="deleteTraceReportFile">×</view>
          </view>
          <!-- 选择文件按钮 -->
          <view class="file-upload-btn" bindtap="chooseTraceReportFile">
            <text>选择文件（图片或PDF）</text>
          </view>
        </view>
      </view>

      <!-- 供应商名称 -->
      <view class="form-item">
        <text class="form-label">供应商名称:</text>
        <view class="form-input">
          <input class="input-field" type="text" value="{{nxTrSupplierName}}" placeholder="请输入供应商名称" bindinput="getSupplierName" />
        </view>
      </view>

      <!-- 供应商联系方式 -->
      <view class="form-item">
        <text class="form-label">供应商联系方式:</text>
        <view class="form-input">
          <input class="input-field" type="text" value="{{nxTrSupplierContact}}" placeholder="请输入联系方式" bindinput="getSupplierContact" />
        </view>
      </view>

      <!-- 采购日期 -->
      <view class="form-item">
        <text class="form-label">采购日期:</text>
        <view class="form-input">
          <picker mode="date" value="{{nxTrPurchaseDate}}" bindchange="getPurchaseDate">
            <view class="picker-view" style="color: {{nxTrPurchaseDate ? '#333' : '#999'}};">
              {{nxTrPurchaseDate || '请选择采购日期'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 入库日期 -->
      <view class="form-item">
        <text class="form-label">入库日期:</text>
        <view class="form-input">
          <picker mode="date" value="{{nxTrStockInDate}}" bindchange="getStockInDate">
            <view class="picker-view" style="color: {{nxTrStockInDate ? '#333' : '#999'}};">
              {{nxTrStockInDate || '请选择入库日期'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 有效期开始日期 -->
      <view class="form-item">
        <text class="form-label">有效期开始日期:</text>
        <view class="form-input">
          <picker mode="date" value="{{nxTrValidStartDate}}" bindchange="getValidStartDate">
            <view class="picker-view" style="color: {{nxTrValidStartDate ? '#333' : '#999'}};">
              {{nxTrValidStartDate || '请选择开始日期'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 有效期结束日期 -->
      <view class="form-item">
        <text class="form-label">有效期结束日期:</text>
        <view class="form-input">
          <picker mode="date" value="{{nxTrValidEndDate}}" bindchange="getValidEndDate">
            <view class="picker-view" style="color: {{nxTrValidEndDate ? '#333' : '#999'}};">
              {{nxTrValidEndDate || '请选择结束日期'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 备注说明 -->
      <view class="form-item">
        <text class="form-label">备注说明:</text>
        <view class="form-input">
          <input class="input-field" type="text" value="{{nxTrRemark}}" placeholder="请输入备注说明" bindinput="getTraceReportRemark" />
        </view>
      </view>
      </view>
    </scroll-view>

    <!-- 按钮 -->
    <view class="modal-footer">
      <view class="btn btn-cancel" bindtap="closeAddTraceReport">
        <text>取消</text>
      </view>
      <view class="btn btn-confirm" catchtap="confirmAddTraceReport">
        <text>确定</text>
      </view>
    </view>
  </view>
</view>
