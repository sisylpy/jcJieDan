          <view class="flex-row-wrap pt-10">
            <text class="standard" wx:for="{{goods.nxDistributerAliasEntities}}" wx:for-item="alias" wx:for-index="aliasIndex" bindtap="clickItem" data-itemalias="{{alias}}" data-type="alias" data-index="{{aliasIndex}}" wx:key="nxDistributerAliasId">{{alias.nxDaAliasName}}</text>
            <text class="standard" bindtap="addDisAlias" data-name="{{goods.nxGoodsEntity.nxGoodsName}}">+</text>
