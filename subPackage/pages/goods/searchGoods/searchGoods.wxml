<view class="flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="查找商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column p-20 bg-light" style="width: {{windowWidth - 40}}rpx; height: 70rpx; line-height: 70rpx;">
      <input placeholder="输入商品名称、拼音或简拼" class="text-center p-20 border radius-20  bg-white font-lg-2" style="width: {{windowWidth - 80}}rpx;height: 70rpx; line-height: 70rpx; border: 1px solid rgb(170, 169, 169);" bindconfirm="getSearchString" bindinput="isInputing" value="{{searchStr}}" hold-keyboard="true" confirm-type="search" focus="true"></input>
      <view class="plr-20" style="height: 70rpx; line-height: 70rpx;" wx:if="{{strArr.length > 0}}">搜索到商品: {{strArr.length}}个</view>
    </view>

  <!-- 页面内容 -->
  <view class="flex-column"  style="margin-top: 80rpx;">

    <view class='navbarSearch' wx:if="{{searchStr.length > 0}}"  >
        <block wx:for="{{tabsSearch}}" wx:for-item="tabsSearch" wx:key="id">
          <view id="{{index}}" class="navbar-item {{tab1IndexSearch==index?'bar-item-on':''}}" data-index='{{index}}' bindtap='onTab1ClickSearch' hover-class="hover">
            <view class='navbar-title'>{{tabsSearch.words}}
              <text >({{tabsSearch.amount}})</text>
            </view>
          </view>
        </block>

        <view class="navbar-slider" style="left: {{sliderLeftSearch}}px; width:{{windowWidth / 4}}rpx; transform: translateX({{sliderOffsetSearch}}px); -webkit-transform: translateX({{sliderOffsetSearch}}px);">
        </view>
      </view>
 
    <swiper style="height: {{windowHeight - navBarHeight * 2.5}}rpx; " bindchange='swiperChangeSearch' current="{{itemIndexSearch}}" data-index='{{itemIndexSearch}}'>

<!-- nxGoodsArr -->
<swiper-item>

  <scroll-view scroll-y style="height:{{windowHeight - navBarHeight * 2.5}}rpx; ">
    <!-- empty -->
    <view class="flex {{strArr.length == 0  && searchStr.length > 0? 'show' : 'hide'}}">
      <view class="center-content  flex-column " style="margin-top: 200rpx;">
        <image class="empty_image" src="../../../../images/xiuxi.png"></image>
        <text class="text-secondary font-md p-30">没有搜索到订购商品</text>
      </view>
    </view>
    <!-- ./empty -->

    <view class="goods-card" wx:for="{{strArr}}" wx:for-item="sons" wx:key="nxDistributerGoodsId" wx:for-index="goodsIndex">
          <view class="goods-image-section">
            <image wx:if="{{sons.nxDgGoodsFileLarge && sons.nxDgGoodsFileLarge !== 'null'}}" src="{{url + sons.nxDgGoodsFileLarge}}" mode="aspectFill" class="goods-img" bindtap="previewImage" data-item="{{sons}}" />
            <image wx:elif="{{sons.nxDgGoodsFile && sons.nxDgGoodsFile !== 'null' && sons.nxDgGoodsFile !== 'goodsImage/logo.jpg'}}" src="{{url + sons.nxDgGoodsFile}}" mode="aspectFill" class="goods-img" bindtap="previewImage" data-item="{{sons}}" />
            <view wx:else class="goods-img placeholder" bindtap="toEditGoodsImage" data-item="{{sons}}" data-index="{{goodsIndex}}">
              <image src="/images/photozhaoxiang.png" mode="aspectFill" class="camera-icon-center" />
            </view>
          </view>

          <view class="goods-info-section">
            <!-- 分类层级 - 显示在商品名称上方 -->
            <view class="category-level">
              <view class="level-item level-1">
                <text class="level-dot"></text>
                <text class="level-name font-xs">{{sons.nxDistributerFatherGoodsEntity.nxDistributerFatherGoodsEntity.nxDfgFatherGoodsName}}</text>
              </view>
              <view class="level-arrow">→</view>
              <view class="level-item level-2">
                <text class="level-dot"></text>
                <text class="level-name font-xs">{{sons.nxDistributerFatherGoodsEntity.nxDfgFatherGoodsName}}</text>
              </view>
            </view>

            <!-- 商品名称行 -->
            <view class="goods-name-row" bindtap="toDetail" data-id="{{sons.nxDistributerGoodsId}}" data-name="{{sons.nxDgGoodsName}}" data-color="{{sons.nxDgNxGoodsFatherColor}}" data-item="{{sons}}" data-index="{{goodsIndex}}" hover-class="hover">
              <view class="goods-index font-xs">{{goodsIndex + 1}}.</view>
              <view class="goods-name-wrap">
                <text class="brand" wx:if="{{sons.nxDgGoodsBrand !== null && sons.nxDgGoodsBrand.length > 0}}">{{sons.nxDgGoodsBrand}}</text>
                <text class="goods-name font-sl">{{sons.nxDgGoodsName}}</text>
                <text class="goods-detail font-xs">{{sons.nxDgGoodsDetail !== null ? sons.nxDgGoodsDetail : ''}}</text>
              </view>
              <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" />
            </view>

            <!-- 规格信息 + 外包装 -->
            <view class="spec-row">
              <view class="spec-item">
                <text class="spec-label font-xs">规格:</text>
                <text class="spec-value font-xs" wx:if="{{sons.nxDgGoodsStandardWeight !== 'null' && sons.nxDgGoodsStandardWeight.length > 0}}">{{sons.nxDgGoodsStandardWeight}}/{{sons.nxDgGoodsStandardname}}</text>
                <text class="spec-value font-xs" wx:else>{{sons.nxDgGoodsStandardname}}</text>
              </view>
              <view class="spec-item">
                <text class="spec-label font-xs">外包装:</text>
                <text class="spec-value font-xs" wx:if="{{sons.nxDgItemsPerCarton !== null && sons.nxDgCartonUnit !== ''}}">{{sons.nxDgItemsPerCarton}}{{sons.nxDgGoodsStandardname}}/{{sons.nxDgCartonUnit}}</text>
                <text class="spec-value font-xs" wx:elif="{{sons.nxDgCartonUnit !== null && sons.nxDgCartonUnit !== ''}}">{{sons.nxDgCartonUnit}}</text>
                <text class="spec-value font-xs" wx:else>无</text>
              </view>
            </view>
            <!-- 订货规格 -->
            <view class="order-spec-row">
              <text class="order-spec-label font-xs">订货规格:</text>
              <view class="order-spec-tags">
                <text class="order-spec-tag font-xs">{{sons.nxDgGoodsStandardname}}</text>
                <text class="order-spec-tag font-xs" wx:for="{{sons.nxDistributerStandardEntities}}" wx:for-item="standard">{{standard.nxDsStandardName}}</text>
              </view>
            </view>

            <!-- 自动订货商 -->
            <block wx:if="{{sons.nxDgPurchaseAuto == 1 && sons.nxJrdhSupplierEntity !== null}}">
              <view class="auto-order-row">
                <text class="auto-order-label font-xs">自动订货:</text>
                <text class="auto-order-value font-xs">{{sons.nxJrdhSupplierEntity.jrdhUserEntity.nxJrdhWxNickName}}</text>
              </view>
            </block>

            <!-- 单价：统一改价入口 -->
            <view class="flex flex-row-between p-10" bindtap="showIsPurchase" data-item="{{sons}}" data-index="{{goodsIndex}}" hover-class="hover">
              <view class="flex-column flex-1 min-w-0">
                <view class="flex-row-wrap align-center">
                  <text class="text-secondary font-md mr-10">基本单位售价</text>
                  <block wx:if="{{sons.nxDgWillPriceOne !== null && sons.nxDgWillPriceOne !== ''}}">
                    <text class="mr-20 font-md">{{sons.nxDgWillPriceOne}}元/{{sons.nxDgGoodsStandardname}}</text>
                  </block>
                  <text wx:else class="text-secondary font-sm mr-20">未设置</text>
                </view>
                <view class="flex-row-wrap align-center pt-10" wx:if="{{(sons.nxDgCartonUnit && sons.nxDgCartonUnit !== '' && sons.nxDgCartonUnit !== 'null' && (sons.nxDgItemsPerCarton > 0 || sons.nxDgWillPriceTwoWeight > 0)) || (sons.nxDgWillPriceTwoStandard && sons.nxDgWillPriceTwoStandard !== '' && sons.nxDgWillPriceTwoStandard !== 'null')}}">
                  <text class="text-secondary font-md mr-10">外包装售价</text>
                  <block wx:if="{{sons.nxDgWillPriceTwo !== null && sons.nxDgWillPriceTwo !== ''}}">
                    <text class="mr-20 font-md">{{sons.nxDgWillPriceTwo}}元/{{sons.nxDgWillPriceTwoStandard || sons.nxDgCartonUnit}}</text>
                  </block>
                  <text wx:else class="text-secondary font-sm mr-20">未设置</text>
                </view>
              </view>
              <image src="/images/edit-main.png" mode="aspectFill" class="icon" />
            </view>

            <!-- 货架信息 - 与 goods.wxml 风格一致 -->
            <view class="flex-row-default" wx:if="{{disInfo.nxDistributerBusinessTypeId > 1 && sons.nxDistributerGoodsShelfGoodsEntities.length > 0}}">
              <view class="text-secondary mr-10 flex-fixed">货架:</view>
              <view class="flex-row-wrap shelf-same-goods-chips">
                <view class="sameShelf mr-10" wx:for="{{sons.nxDistributerGoodsShelfGoodsEntities}}" wx:for-item="shelfGoods">
                  <text>{{shelfGoods.shelfName}}</text>
                  <text wx:if="{{shelfGoods.nxDgsgShelfLayer !== null}}">-L{{shelfGoods.nxDgsgShelfLayer}}</text>
                  <text>-{{shelfGoods.nxDgsgShelfLayerSeq || shelfGoods.nxDgsgSort}}</text>
                </view>
              </view>
            </view>
             

            <view class="flex-row-between" wx:if="{{sons.nxDgPullOff == 1}}">
              <text class="text-danger">暂停订货:</text>
              <switch checked="{{sons.nxDgPullOff == 1}}" />
            </view>
            <view class="flex-row-between" wx:if="{{sons.nxDgGoodsIsHidden == 1}}">
              <text class="text-danger">停止配送:</text>
              <switch checked="{{sons.nxDgGoodsIsHidden == 1}}" />
            </view>


          </view>
        </view>
        <view  class="text-secondary center-content " style="height: 100rpx;">没有数据啦!</view>
  </scroll-view>
</swiper-item>


<swiper-item>

  <scroll-view scroll-y style="height:{{windowHeight - navBarHeight * 2.5}}rpx;">

    <view class="flex-row-between border-bottom p-20" wx:for="{{nxArr}}" wx:for-item="goods" wx:for-index="index" style="width:{{windowWidth - 80}}rpx; ">
      <view class="flex-row-default font-lg">
        <text class="mr-20">{{strArr.length + index + 1}}.</text>
        <view class="flex-row-wrap" style="width:{{windowWidth - 200}}rpx; ">
          <text>{{goods.grandGoods.fatherGoods.nxGoodsName}}></text>
           <text>{{goods.grandGoods.nxGoodsName}}></text>
          <text class="brand" wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !==  'null'}}">{{goods.nxGoodsBrand}}</text>

          <text class="font-lgmr-20">{{goods.nxGoodsName}}</text>
          <text class="" wx:if="{{goods.nxDistributerAliasEntities.length > 0}}" wx:for="{{goods.nxDistributerAliasEntities}}" wx:for-item="alias">@{{alias.nxDaAliasName}}</text>
          <block wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
            <text class="font-slmr-10" wx:if="{{goods.nxGoodsStandardname !== '斤'}}">({{goods.nxGoodsStandardname}}/{{goods.nxGoodsStandardWeight}})</text>
          </block>
          <block wx:else>
            <text class="font-lgmr-10">({{goods.nxGoodsStandardname}})</text>
          </block>

          <text class="font-slmr-20text-secondary" wx:if="{{goods.nxGoodsPlace !== 'null' && goods.nxGoodsPlace.length > 0}}">产地:{{goods.nxGoodsPlace}}</text>

          <text class="font-sltext-secondary" wx:if="{{goods.nxGoodsDetail.length > 0 && goods.nxGoodsDetail !==  'null'}}">{{goods.nxGoodsDetail}}</text>
        </view>
      </view>

      <view bindtap="downLoadGoods" data-item="{{goods}}">
        <image src="/images/download.png" mode="aspectFill" class="icon" />
      </view>

    </view>

    <!-- <view class="flex-column-center" style="margin-top: 100rpx;">
      <view class="" catchtap="toAddGoods" style="width: 200rpx;height: 70rpx;line-height: 70rpx; background-color: rgb(3, 106, 240); border-radius: 20rpx;text-align: center;  padding: 10rpx 20rpx; color: #fff; font-size: 32rpx; font-weight: 500;">
        <text>nxArr添加新商品</text>
      </view>
    </view> -->

  </scroll-view>
</swiper-item>

</swiper>


  </view>
</view>




<goodsWillPirce show="{{showIsPurchase}}"   bindconfirm="confirm" bindcancle="cancleIsPurchase"  item="{{item}}" consultItem="{{consultItem}}"  windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}"  />

