<view class="flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="查找商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column p-20 bg-light" style="width: {{windowWidth - 40}}rpx; height: 70rpx; line-height: 70rpx;">
      <input placeholder="输入商品名称、拼音或简拼" class="text-center p-20 border radius-20  bg-white font-lg-2" style="width: {{windowWidth - 80}}rpx;height: 70rpx; line-height: 70rpx; border: 1px solid rgb(170, 169, 169);" bindconfirm="getSearchString" bindinput="isInputing" value="{{searchStr}}" hold-keyboard="true" confirm-type="search" focus="true"></input>
      <view class="plr-20" style="height: 70rpx; line-height: 70rpx;" wx:if="{{strArr.length > 0}}">搜索到商品: {{strArr.length}}个</view>
    </view>

  <!-- 页面内容 -->
  <view class="flex-column"  style="margin-top: 80rpx;">

    <view class='navbarSearch' wx:if="{{searchStr.length > 0}}"  >
        <block wx:for="{{tabsSearch}}" wx:for-item="tabsSearch" wx:key="id">
          <view id="{{index}}" class="navbar-item {{tab1IndexSearch==index?'bar-item-on':''}}" data-index='{{index}}' bindtap='onTab1ClickSearch' hover-class="hover">
            <view class='navbar-title'>{{tabsSearch.words}}
              <text >({{tabsSearch.amount}})</text>
            </view>
          </view>
        </block>

        <view class="navbar-slider" style="left: {{sliderLeftSearch}}px; width:{{windowWidth / 4}}rpx; transform: translateX({{sliderOffsetSearch}}px); -webkit-transform: translateX({{sliderOffsetSearch}}px);">
        </view>
      </view>
 
    <swiper style="height: {{windowHeight - navBarHeight * 2.5}}rpx; " bindchange='swiperChangeSearch' current="{{itemIndexSearch}}" data-index='{{itemIndexSearch}}'>

<!-- nxGoodsArr -->
<swiper-item>

  <scroll-view scroll-y style="height:{{windowHeight - navBarHeight * 2.5}}rpx; ">
    <!-- empty -->
    <view class="flex {{strArr.length == 0  && searchStr.length > 0? 'show' : 'hide'}}">
      <view class="center-content  flex-column " style="margin-top: 200rpx;">
        <image class="empty_image" src="../../../../images/xiuxi.png"></image>
        <text class="text-secondary font-md p-30">没有搜索到订购商品</text>
      </view>
    </view>
    <!-- ./empty -->

    <view class="flex-row border-bottom p-20 bg-white" wx:for="{{strArr}}" wx:for-item="sons" wx:key="nxDistributerGoodsId" wx:for-index="goodsIndex">
          <view class=" flex-column mr-10"  bindtap="toEditGoodsImage" 
          data-item="{{sons}}"   data-index="{{goodsIndex}}">
            <view class="flex-row">
              <image src="{{url + sons.nxDgGoodsFile}}" mode="aspectFill" class="goods_item_small" />
              <image src="/images/photozhaoxiang.png" mode="aspectFill" class="icon-lg" />
            </view>
            <image class="flex-fixed" src="{{url + sons.nxDgGoodsFileLarge}}" mode="aspectFill" class="goods_item_lg" />
          </view>

          <view class="flex-column width-100">
            <view class="flex-row-between flex" bindtap="toDetail" data-id="{{sons.nxDistributerGoodsId}}" data-name="{{sons.nxDgGoodsName}}" data-color="{{sons.nxDgNxGoodsFatherColor}}" data-item="{{sons}}" data-index="{{goodsIndex}}" hover-class="hover">
              <view class="flex-row-wrap font-lg">
                <text class=" {{sons.nxDgGoodsBrand !== null && sons.nxDgGoodsBrand.length > 0 ? 'brand' : ''}}">{{sons.nxDgGoodsBrand !== null && sons.nxDgGoodsBrand.length > 0 ? sons.nxDgGoodsBrand : ''}}</text>
                <text>{{goodsIndex + 1}}.</text>
                <text>{{sons.nxDistributerFatherGoodsEntity.nxDistributerFatherGoodsEntity.nxDfgFatherGoodsName}}>{{sons.nxDistributerFatherGoodsEntity.nxDfgFatherGoodsName}}></text>
                <text class="five-weight mr-20 font-lg">{{sons.nxDgGoodsName}}</text>
                <text class="">{{sons.nxDgGoodsDetail !== null ? sons.nxDgGoodsDetail : ''}}</text>
              </view>
              <view>
                <image src="/images/arrow-right-3.png" mode="aspectFill" class="icon p-10" />
              </view>
            </view>

            <view class="flex flex-row p-10">
              <text class="text-secondary">规格:</text>
              <block wx:if="{{sons.nxDgGoodsStandardWeight !== 'null' && sons.nxDgGoodsStandardWeight.length > 0}}">
                <text class="font-xs">{{sons.nxDgGoodsStandardWeight}}/{{sons.nxDgGoodsStandardname}}</text>
              </block>
              <block wx:else>
                <text>{{sons.nxDgGoodsStandardname}}</text>
              </block>
            </view>
            <view class="flex-row-default p-10">
              <text class="text-secondary flex-fixed">订货规格:</text>
              <view class="flex-row-wrap">
                <text class="standard mr-10">{{sons.nxDgGoodsStandardname}}</text>
                <text class="standard mr-10" wx:for="{{sons.nxDistributerStandardEntities}}" wx:for-item="standard">{{standard.nxDsStandardName}}</text>
              </view>

            </view>
         

            <block  wx:if="{{sons.nxDgPurchaseAuto == 1}}">
                <view class="flex-row p-10">
                  <text class="text-secondary">出货:</text>
                   <view class="flex-row" >
                    <text class="">{{sons.nxJrdhSupplierEntity.jrdhUserEntity.nxJrdhWxNickName}}</text>
                </view>
                </view>
             </block>

             <block wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}">
                <view class="flex flex-row-between p-10" bindtap="showIsPurchase" data-item="{{sons}}" data-index="{{goodsIndex}}" data-level="1" hover-class="hover" >
                <text class="text-secondary font-md">基本单位:</text>
                  <view class="flex-row">
                   
                  <block wx:if="{{sons.nxDgWillPriceOne !== null}}">
                    <text class="mr-20 font-md">{{sons.nxDgWillPriceOne}}元/{{sons.nxDgGoodsStandardname}}</text>
                    <image src="/images/edit-main.png" mode="aspectFill" class="icon" />
                  </block>
                  <block wx:else="">
                    <image src="/images/add.png" mode="aspectFill" class="icon p-20" />
                  </block>
                  </view>
                 
                  
                </view>
                <view class="flex flex-row-between p-10" bindtap="showIsPurchase" data-item="{{sons}}" data-index="{{goodsIndex}}" data-level="2" hover-class="hover" >
                <text class="text-secondary font-md">大单位:</text>
                  <view class="flex-row">
                   
                  <block wx:if="{{sons.nxDgWillPriceTwo !== null && sons.nxDgWillPriceTwo !== ''}}">
                    <text class="mr-20 font-md">{{sons.nxDgWillPriceTwo}}元/{{sons.nxDgWillPriceTwoStandard}}</text>
                    <image src="/images/edit-main.png" mode="aspectFill" class="icon" />
                  </block>
                  <block wx:else="">
                    <image src="/images/add.png" mode="aspectFill" class="icon p-20" />
                  </block>
                  </view>
                  
                </view>
             
              </block>

              <view class="flex-row-default plr-20">
                <view class="text-secondary mr-10 flex-fixed">货架:</view>
                <view class="flex-row-wrap ">
                  <view  class="flex-row-default bg-light p-10 font-xs radius-20   mr-20 mb-20" wx:for="{{sons.nxDistributerGoodsShelfGoodsEntities}}" wx:for-item="shelfGoods">
                <view class="flex-row">
                <text class="mainColor flex-fixed">{{shelfGoods.shelfName}}</text>
                 <view class="flex-row-wrap mr-30">
                  <text  class="plr-20" wx:for="{{shelfGoods.nxDisGoodsShelfStockEntities}}" wx:for-item="stock"> {{stock.nxDgssRestWeight}}{{sons.nxDgGoodsStandardname}}
                </text>  
                 </view>
                   
                </view>
              </view>
              
              </view>
               
              </view>
             


           

            <view class="flex-row-between" wx:if="{{sons.nxDgPullOff == 1}}">
              <text class="text-danger">暂停订货:</text>
              <switch checked="{{sons.nxDgPullOff == 1}}" />
            </view>
            <view class="flex-row-between" wx:if="{{sons.nxDgGoodsIsHidden == 1}}">
              <text class="text-danger">停止配送:</text>
              <switch checked="{{sons.nxDgGoodsIsHidden == 1}}" />
            </view>


          </view>
        </view>
        <view  class="text-secondary center-content " style="height: 100rpx;">没有数据啦!</view>
  </scroll-view>
</swiper-item>


<swiper-item>

  <scroll-view scroll-y style="height:{{windowHeight - navBarHeight * 2.5}}rpx;">

    <view class="flex-row-between border-bottom p-20" wx:for="{{nxArr}}" wx:for-item="goods" wx:for-index="index" style="width:{{windowWidth - 80}}rpx; ">
      <view class="flex-row-default font-lg">
        <text class="mr-20">{{strArr.length + index + 1}}.</text>
        <view class="flex-row-wrap" style="width:{{windowWidth - 200}}rpx; ">
          <text>{{goods.grandGoods.fatherGoods.nxGoodsName}}></text>
           <text>{{goods.grandGoods.nxGoodsName}}></text>
          <text class="brand" wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !==  'null'}}">{{goods.nxGoodsBrand}}</text>

          <text class="font-lgmr-20">{{goods.nxGoodsName}}</text>
          <text class="" wx:if="{{goods.nxDistributerAliasEntities.length > 0}}" wx:for="{{goods.nxDistributerAliasEntities}}" wx:for-item="alias">@{{alias.nxDaAliasName}}</text>
          <block wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
            <text class="font-slmr-10" wx:if="{{goods.nxGoodsStandardname !== '斤'}}">({{goods.nxGoodsStandardname}}/{{goods.nxGoodsStandardWeight}})</text>
          </block>
          <block wx:else>
            <text class="font-lgmr-10">({{goods.nxGoodsStandardname}})</text>
          </block>

          <text class="font-slmr-20text-secondary" wx:if="{{goods.nxGoodsPlace !== 'null' && goods.nxGoodsPlace.length > 0}}">产地:{{goods.nxGoodsPlace}}</text>

          <text class="font-sltext-secondary" wx:if="{{goods.nxGoodsDetail.length > 0 && goods.nxGoodsDetail !==  'null'}}">{{goods.nxGoodsDetail}}</text>
        </view>
      </view>

      <view bindtap="downLoadGoods" data-item="{{goods}}">
        <image src="/images/download.png" mode="aspectFill" class="icon" />
      </view>

    </view>

    <!-- <view class="flex-column-center" style="margin-top: 100rpx;">
      <view class="" catchtap="toAddGoods" style="width: 200rpx;height: 70rpx;line-height: 70rpx; background-color: rgb(3, 106, 240); border-radius: 20rpx;text-align: center;  padding: 10rpx 20rpx; color: #fff; font-size: 32rpx; font-weight: 500;">
        <text>nxArr添加新商品</text>
      </view>
    </view> -->

  </scroll-view>
</swiper-item>

</swiper>


  </view>
</view>




<goodsWillPirce show="{{showIsPurchase}}"   bindconfirm="confirm" level="{{level}}" bindcancle="cancleIsPurchase"  item="{{item}}" consultItem="{{consultItem}}"  binddelPrice="delPrice" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}"  />
