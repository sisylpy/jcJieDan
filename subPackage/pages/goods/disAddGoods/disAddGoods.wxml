<view class="flex flex-column height-100">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="添加商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <view class="p-20 flex-row-between mt-10">
    <view>必填:</view>
    <view class="flex-column-center">
      <view class="addBtn {{canSave ? 'is-active' : ''}}" bindtap="saveDisGoods">添加
      </view>
    </view>
  </view>

  <view class="flex-column p-20 bg-white">
    <view class=" flex-row-between p-10">
      <view class="flex-row ">
        <text class="text-secondary mr-20">所属大类:</text>
      </view>
      <view class="flex-row flex-1" bindtap="toGreatGrandGoods">
        <input class="goodsInput p-10" disabled="true" value="{{fatherName}}"></input>
        <image src="../../../../images/arrow-right-3.png" class="icon"></image>
      </view>

    </view>

    <view class=" flex-row p-10">
      <view class="flex-row flex-fixed ">
        <text class="text-secondary mr-10">新商品名称:</text>
      </view>
      <input class="goodsInput p-10" bindinput="getDisGoodsContent" data-type="0" value="{{goods.nxDgGoodsName}}"></input>
    </view>

    <view class=" flex-row p-10">
      <view class="flex-row flex-fixed">
        <text class="text-secondary mr-10">商品规格:</text>
      </view>
      <input class="goodsInput p-10" value="{{goods.nxDgGoodsStandardname}}" bindinput="getDisGoodsContent" data-type="1"></input>
    </view>
  </view>


  <view class=" p-20">可填:</view>
  <view class="flex-column p-20 bg-white">

    <view class=" flex-row  p-20">
      <view class="flex-row flex-fixed">
        <text class="text-secondary  mr-10">单位重量</text>
      </view>
      <input value="{{goods.nxDgGoodsStandardWeight !== '-1' ? goods.nxDgGoodsStandardWeight : ''}}" class="goodsInput p-10" bindinput="getDisGoodsContent" data-type="2"></input>
    </view>

    <view class=" flex-row p-20">
      <text class="text-secondary flex-fixed mr-10">品牌</text>
      <input class="goodsInput p-10" bindinput="getDisGoodsContent" data-type="3" value="{{goods.nxDgGoodsBrand !== '-1' ? goods.nxDgGoodsBrand : ''}}"></input>
    </view>

    <view class="flex-row p-20">
      <text class="text-secondary flex-fixed mr-10">产地</text>
      <input class="goodsInput p-10" value="{{goods.nxDgGoodsPlace !== '-1' ? goods.nxDgGoodsPlace  : ''}}" bindinput="getDisGoodsContent" data-type="4"></input>
    </view>
    <view class=" flex-row p-20">
      <text class="text-secondary flex-fixed mr-10">详细</text>
      <input class="goodsInput p-10" value="{{goods.nxDgGoodsDetail}}" bindinput="getDisGoodsContent" data-type="5"></input>
    </view>

  </view>

</view>




<!-- mask -->
<view class='overlay {{showTishi ? "show" : ""}}' catchtap="hideMask" style="height:{{maskHeight > windowHeight ? maskHeight : windowHeight}}rpx;">
  <!-- + scrollViewTop -->
  <view class="bg-white normal" style="margin-top:{{haveSame == 2 ? '400': '300'}}rpx;margin-left: 50rpx; width:{{windowWidth - 100}}rpx;">
    <view class="flex-column-center p-20 small" wx:if="{{haveSame == 2}}">
      <image src="/images/smile.png" mode="aspectFill" class="icon" />
      <text>已经有相同的商品啦!</text>
    </view>

    <view class="p-20">
      <view class="p-20  border-bottom" wx:for="{{showArr}}" bindtap="orderGoods" data-item="{{item}}">
        <text class="{{item.nxDgGoodsBrand !== null ? brand: ''}}"> {{item.nxDgGoodsBrand !== null ? item.nxDgGoodsBrand: ''}}</text>
        <text class="mr-20"> {{item.nxDgGoodsName}}</text>
        <text>({{item.nxDgGoodsStandardname}})</text>
      </view>
    </view>

    <view class="flex-row p-20" wx:if="{{haveSame == 1}}">
      <view class="half-row">
        关闭
      </view>
      <view class="half-row flex-column-center" bindtap="againSave">
        确定添加
      </view>

    </view>

  </view>



</view>
<!-- ./mask -->