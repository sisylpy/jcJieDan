/* 图片弹窗样式 */
.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.modal-body {
  padding: 30rpx;
  text-align: center;
}

.modal-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.image-info {
  text-align: left;
  padding: 20rpx 0;
}

.goods-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.goods-standard {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .modal-content {
    width: 95%;
    max-width: none;
  }
  
  .modal-image {
    height: 300rpx;
  }
}

/* ========== 商品转换页面紧凑列表样式 ========== */

/* 列表容器 */
.goods-list-container {
  background: #f8f9fa;
  padding: 20rpx;
}

/* 转换列表项 */
.conversion-list-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  border-left: 6rpx solid #28a745;
  transition: all 0.3s ease;
}

.conversion-list-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
}

/* 转换流程 */
.conversion-flow {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

/* 商品项 */
.goods-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.temp-goods {
  border-right: 2rpx dashed #ffc107;
  padding-right: 20rpx;
}

.formal-goods {
  padding-left: 20rpx;
}

/* 小图片容器 */
.goods-image-small {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 状态标签 */
.temp-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #ffc107;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.formal-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #28a745;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 商品信息紧凑版 */
.goods-info-compact {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.goods-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.goods-name-compact {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.goods-unit-compact {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
  flex-shrink: 0;
}

.goods-brand-compact {
  font-size: 20rpx;
  color: #1976d2;
  background: #e3f2fd;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  align-self: center;
  font-weight: 500;
}

.category-compact {
  font-size: 22rpx;
  color: #666;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 流程箭头 */
.flow-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 60rpx;
}

.arrow-symbol {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 动画效果 */
@keyframes slideInUp {
  from {
    transform: translateY(50rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-10rpx);
  }
  60% {
    transform: translateY(-5rpx);
  }
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state .empty-text {
  font-size: 28rpx;
  line-height: 1.5;
}