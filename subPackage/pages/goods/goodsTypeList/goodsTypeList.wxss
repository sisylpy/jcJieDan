

.addBtn{
  font-size: 50rpx;
  line-height: 80rpx;
  width: 100rpx;
  text-align: center;
  border-radius: 50%;
}


.inputGoods{
  padding-left: 20rpx;
  line-height: 80rpx;
  height: 80rpx;
  background: #f2f2f2;
  border-radius: 40rpx;

}

/* 商品列表容器 */
.goods-list-container {
  flex: 1;
  background-color: #f5f5f5;
}

/* 加载状态容器 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 商品项样式优化 */
.flex-row-between {
  transition: background-color 0.2s;
}

.flex-row-between:active {
  background-color: #f0f0f0;
}

