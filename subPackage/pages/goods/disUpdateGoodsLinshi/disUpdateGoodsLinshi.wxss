



page{
  background: #f5f5f5;
}

.inputAddGoods{
  border-bottom: 1px solid lightgray;
  width: 100%;
  padding-left: 10rpx;
}

.addBtn{
  border-radius: 40rpx;
  padding: 6rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  background-color: rgb(184, 183, 183);
}
.addBtn.is-active{
  color: #fff;
  background-color: #187e6e;
}

/* 新增样式 */
.label-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  min-width: 120rpx;
}

.input-field {
  flex: 1;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 34rpx;
  background: #fff;
  margin-left: 20rpx;
}

.textarea-field {
  flex: 1;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 34rpx;
  background: #fff;
  margin-left: 20rpx;
  min-height: 120rpx;
  width: 100%;
}

.image-upload-section {
  margin: 30rpx 0;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.image-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 300rpx;
  height: 300rpx;
  border-radius: 12rpx;
  border: 2px solid #e0e0e0;
  margin-bottom: 20rpx;
}

.image-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
  border: none;
  background: #007aff;
  color: white;
}

.action-btn.small {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.action-btn.delete {
  background: #ff3b30;
}

.upload-placeholder {
  width: 300rpx;
  height: 300rpx;
  border: 2px dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #fff;
  cursor: pointer;
  transition: all 0.3s ease;
}

.upload-placeholder:active {
  background: #f0f0f0;
  border-color: #007aff;
}

.add-icon {
  font-size: 80rpx;
  font-weight: bold;
  color: #ccc;
  margin-bottom: 20rpx;
  line-height: 1;
}

.upload-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.loading-container {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.button-container {
  margin: 40rpx 0;
  padding: 0 20rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #007aff, #0056cc);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.save-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 122, 255, 0.3);
}

.save-btn:disabled {
  background: #ccc;
  box-shadow: none;
  transform: none;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .preview-image,
  .upload-placeholder {
    width: 250rpx;
    height: 250rpx;
  }
  
  .action-btn {
    padding: 10rpx 20rpx;
    font-size: 22rpx;
  }
}
