
<view class="flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="指定外部供应商" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column" >

    <view class=" flex-column {{supplierArr.length == 0 ? 'show' : 'hide'}}" style="height:{{windowHeight - navBarHeight}}rpx">
      <view class="popEmpty flex-column center-content">
        <image class="empty_image" src="../../../../images/paste.png"></image>
        <text class="font-md text-secondary ">暂时无外部供应商</text>
      </view>

    </view>
    <block wx:if="{{supplierArr.length > 0}}">

      <view class="flex-row-between p-20 border-bottom bg-white" wx:for="{{supplierArr}}" wx:for-item="item" data-item="{{item}}" hover-class="hover">

        <view class="flex-row-default" style="width: {{windowWidth - 300}}rpx;">
          <view class="flex-row">
            <text class="margin-right">{{index + 1}}.</text>
          </view>
          <image src="{{item.jrdhUserEntity && item.jrdhUserEntity.nxJrdhWxAvartraUrl ? url + item.jrdhUserEntity.nxJrdhWxAvartraUrl : '/images/logo.jpg' }}" class="url margin-right"></image>
          <view class="flex-column ">
            <!-- <text class="small  gray">{{item.jrdhUserEntity.nxJrdhWxNickName !== null ? item.nxJrdhsSupplierName : '没有认证'}}</text> -->
            <text>{{item.jrdhUserEntity ? item.jrdhUserEntity.nxJrdhWxNickName : item.nxJrdhsSupplierName}}</text>
          </view>

        </view>

        <view class="" bindtap="choiceSupplier" data-item="{{item}}" wx:if="{{item.jrdhUserEntity !== null}}">
          <text class="mainBack_new_btn ">选择</text>
        </view>
        <view wx:else="">
          <view class="p-20 flex-row mainBack_new_btn" catchtap="toExternalSupplierInvitation" data-item="{{item}}">
            <image src="../../../../images/person.png" class="icon margin-l-right"></image>
            <text class="small gray">邀请外部供应商激活</text>
          </view>
        </view>


      </view>
    </block>


  </view>

</view>
