/* 容器样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面头部 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  color: white;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 信息卡片 */
.info-card {
  background-color: #ffffff;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 10rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.value.success {
  color: #52c41a;
}

.value.error {
  color: #ff4d4f;
}

/* 按钮区域 */
.button-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.test-section {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 15rpx;
  border-left: 4rpx solid #007aff;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.test-btn {
  padding: 25rpx 40rpx;
  border-radius: 25rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  background-color: #f0f0f0;
  color: #333;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.test-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.test-btn.secondary {
  background-color: #ff6b6b;
  color: white;
}

.test-btn:active {
  opacity: 0.8;
}

/* 成员列表 */
.member-list {
  max-height: 300rpx;
  overflow-y: auto;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.member-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  background-color: #e9ecef;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
}

/* 消息列表 */
.message-list {
  max-height: 400rpx;
  overflow-y: auto;
}

/* 客户群列表 */
.customer-group-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.customer-group-item {
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  border-left: 4rpx solid #52c41a;
}

.group-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.group-id {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.group-status {
  font-size: 24rpx;
  color: #666;
  background-color: #e9ecef;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.message-item {
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  border-left: 4rpx solid #007aff;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.sender {
  font-size: 26rpx;
  color: #007aff;
  font-weight: 500;
}

.time {
  font-size: 22rpx;
  color: #999;
}

.message-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 测试结果 */
.results-card {
  background-color: #ffffff;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 10rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  background-color: #f0f0f0;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
}

.results-list {
  border: 1rpx solid #f0f0f0;
  border-radius: 10rpx;
  padding: 20rpx;
  background-color: #fafafa;
}

.result-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
  padding: 15rpx;
  border-radius: 8rpx;
  background-color: #f8f9fa;
}

.result-item.success {
  background-color: #f6ffed;
  border-left: 4rpx solid #52c41a;
}

.result-item.error {
  background-color: #fff2f0;
  border-left: 4rpx solid #ff4d4f;
}

.result-item.info {
  background-color: #f0f8ff;
  border-left: 4rpx solid #1890ff;
}

.result-time {
  font-size: 22rpx;
  color: #999;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.result-message {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  line-height: 1.4;
  word-wrap: break-word;
  word-break: break-all;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .container {
    padding: 15rpx;
  }
  
  .header {
    padding: 30rpx 15rpx;
  }
  
  .info-card {
    padding: 20rpx;
    margin-bottom: 20rpx;
  }
  
  .test-btn {
    padding: 20rpx 30rpx;
    font-size: 28rpx;
  }
}
