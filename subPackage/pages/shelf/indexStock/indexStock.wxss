/* 货架商品类型筛选菜单 */
.filter-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 10000;
}

.filter-menu-panel {
  position: fixed;
  left: 20rpx;
  z-index: 10001;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  min-width: 200rpx;
}

.filter-menu-item {
  color: #515151;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-menu-item:last-child {
  border-bottom: none;
}

.filter-menu-item.active {
  color: #167063;
  font-weight: 600;
}

.shelf-tools-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 10000;
}

.shelf-tools-panel {
  position: fixed;
  right: 40rpx;
  z-index: 10001;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
}

.shelf-layer-picker-overlay {
  z-index: 10002;
}

.shelf-layer-picker-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  max-height: 70vh;
  border-radius: 20rpx;
  z-index: 10003;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.shelf-layer-picker-scroll {
  max-height: 55vh;
}

.shelf-layer-divider {
  width: 100%;
  padding: 20rpx 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider-line {
  flex: 1;
  height: 4rpx;
  background-color: #12a085;
  border-radius: 4rpx;
}

.divider-text {
  margin: 0 26rpx;
  font-size: 26rpx;
  color: #0a8a72;
  font-weight: 600;
}

.shelf-list-wrap {
  padding: 20rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.shelf-list-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1px solid #e5e5e5;
  padding: 20rpx;
  margin-bottom: 20rpx;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* 第一行：图 + 标题（库存另起一行占满宽） */
.shelf-list-top-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* 库存区：从图片下缘起与卡片同宽 */
.shelf-list-stock-full {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding-top: 0;
}

.shelf-list-same-goods-full {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.shelf-list-thumb {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.shelf-list-img {
  width: 100%;
  height: 100%;
}

.shelf-list-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shelf-list-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow-x: hidden;
  overflow-y: visible;
}

.shelf-list-title {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
}

.shelf-list-brand {
  font-size: 26rpx;
  color: #0a8a72;
  padding: 0 14rpx;
  background-color: rgba(10, 138, 114, 0.12);
  border-radius: 12rpx;
}

.shelf-list-title-text {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
}

/* 列表：序号+层级+名称同一行；规格与大包装同一行 */
.shelf-list-line-full {
  flex: 0 0 100%;
  width: 100%;
  box-sizing: border-box;
}

/* 层序、品牌、品名为并列 flex；品名区可多行换行以显示全称 */
.shelf-list-title-line1 {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.shelf-title-prefix,
.shelf-title-brand {
  flex-shrink: 0;
  line-height: 1.35;
}

.shelf-title-name-wrap {
  flex: 1;
  min-width: 0;
  overflow: visible;
}

.shelf-title-name-text {
  display: block;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  line-height: 1.35;
}

/* 规格 + 大包装：允许整行折行，避免右侧撑出屏幕 */
.shelf-list-spec-carton-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  flex-wrap: wrap;
  min-width: 0;
  margin-bottom: 0;
  padding-bottom: 0;
  /* gap: 0 8rpx; */
  /* row-gap: 6rpx; */
}

.shelf-list-spec-text {
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.shelf-list-spec-gap {
  flex-shrink: 0;
  color: #b0b8c2;
  font-size: 28rpx;
  line-height: 1.35;
}

.shelf-list-carton-inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
}

.shelf-list-carton-main,
.shelf-list-carton-unit {
  word-break: break-word;
  overflow-wrap: anywhere;
}

.shelf-list-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.shelf-list-spec {
  font-size: 28rpx;
  color: #5c6570;
}

.shelf-list-stock {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: #454545;
  gap: 12rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.shelf-list-stock .shelf-card-stock {
  flex: 1;
  min-width: 0;
}

.shelf-list-stock-label {
  color: #666;
  flex-shrink: 0;
}

/* 相同货架：卡片 / 列表统一结构，置于库存下方 */
.shelf-same-goods-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  font-size: 28rpx;
  color: #454545;
  gap: 12rpx;
