/* 货架页：防止 flex 子项被长文本/角标撑出屏宽 */
.main {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.main .flex-1 {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.main .flex-1 scroll-view {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.main .flex-1 .flex-column {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* 缩略图双列容器：占满右侧滚动区，避免百分比子项溢出 */
.main scroll-view .flex-row-wrap.p-20 {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.shelf-toolbar {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.shelf-toolbar-left {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.shelf-toolbar-actions {
  flex-shrink: 0;
}

.left {
  width: 15vw;
}

.left-item {
  padding: 30rpx 20rpx;
  background-color: rgb(247, 247, 247);
}

.left-active {
  background-color: #fff;
  border-left: 6rpx solid #167063;
  background-color: #b8e6d0 !important; /* 更强烈的绿色背景，表示已点击且可操作 */
  border-left: 6rpx solid #0d5d4f !important; /* 更深的绿色边框 */
  font-weight: 700; /* 加粗文字 */
  color: #0d5d4f !important; /* 深绿色文字，更强烈的对比 */
  box-shadow: 0 4rpx 12rpx rgba(22, 112, 99, 0.3); /* 更强的阴影效果，更突出 */
  transform: scale(1.02); /* 轻微放大，增强视觉反馈 */
}


