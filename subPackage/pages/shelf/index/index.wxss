  border-radius: 10rpx;

}

.circle.gray{
  background: #374947;
}

.circle.green{
  background-color: #0a868a;
}

.border-radius-40{
  border-radius: 40rpx;
  border: 1px solid lightgray;


}


/* 货架商品类型筛选菜单 */
.filter-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 10000;
}

.filter-menu-panel {
  position: fixed;
  left: 20rpx;
  z-index: 10001;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  min-width: 200rpx;
}

.filter-menu-item {
  color: #515151;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-menu-item:last-child {
  border-bottom: none;
}

.filter-menu-item.active {
  color: #167063;
  font-weight: 600;
}

/* 查询排序菜单：靠右，避免长文案溢出 */
.query-sort-menu-panel {
  left: auto;
  right: 20rpx;
  min-width: 420rpx;
  max-width: 710rpx;
}

/* 顶栏：货架名 + 横向排序 chip（对应 shelfGoodsQuerySort 1～4） */
.shelf-header-title-row {
  align-items: flex-start;
}

.shelf-header-left-col {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.shelf-header-title-line {
  flex-wrap: nowrap;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.shelf-header-label {
  flex-shrink: 0;
}

/* 名称独占一行可用宽度，不被排序 chip 横向挤占 */
.shelf-header-shelf-name {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  line-height: 1.35;
}

.shelf-header-actions {
  flex-shrink: 0;
  padding-top: 4rpx;
}

.shelf-header-sort-row {
  width: 100%;
  margin-top: 12rpx;
}

.shelf-sort-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #5c6570;
  background: #f0f3f5;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.shelf-sort-chip.active {
  color: #0a8a72;
  background: rgba(10, 138, 114, 0.12);
  border-color: rgba(10, 138, 114, 0.35);
  font-weight: 600;
}

.shelf-tools-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 10000;
}

.shelf-tools-panel {
  position: fixed;
  right: 40rpx;
  z-index: 10001;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
}

.shelf-layer-picker-overlay {
  z-index: 10002;
}

.shelf-layer-picker-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  max-height: 70vh;
  border-radius: 20rpx;
  z-index: 10003;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.shelf-layer-picker-scroll {
  max-height: 55vh;
}

.shelf-layer-divider {
  width: 100%;
  padding: 20rpx 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider-line {
  flex: 1;
  height: 4rpx;
  background-color: #12a085;
  border-radius: 4rpx;
}

.divider-text {
  margin: 0 26rpx;
  font-size: 26rpx;
  color: #0a8a72;
  font-weight: 600;
}

.shelf-list-wrap {
  padding: 20rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.shelf-list-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1px solid #e5e5e5;
  padding: 20rpx;
  margin-bottom: 20rpx;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

/* 第一行：图 + 标题 + 角标（库存另起一行占满宽，与 indexStock 一致） */
.shelf-list-top-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.shelf-list-stock-full {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding-top: 0;
}

.shelf-list-thumb {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.shelf-list-img {
  width: 100%;
  height: 100%;
}

.shelf-list-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shelf-list-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow-x: hidden;
  overflow-y: visible;
}

.shelf-list-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shelf-list-brand {
  font-size: 26rpx;
  color: #0a8a72;
  padding: 0 14rpx;
  background-color: rgba(10, 138, 114, 0.12);
  border-radius: 12rpx;
}

.shelf-list-title-text {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

/* 列表：序号+层级+名称同一行；规格与大包装同一行 */
.shelf-list-line-full {
  flex: 0 0 100%;
  width: 100%;
  box-sizing: border-box;
}

/* 层序、品牌、品名为并列 flex；品名区可多行换行以显示全称 */
.shelf-list-title-line1 {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.shelf-title-prefix,
.shelf-title-brand {
  flex-shrink: 0;
  line-height: 1.35;
}

.shelf-title-name-wrap {
  flex: 1;
  min-width: 0;
  overflow: visible;
}

.shelf-title-name-text {
  display: block;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  line-height: 1.35;
}

/* 规格 + 大包装：允许整行折行，避免右侧撑出屏幕 */
.shelf-list-spec-carton-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  flex-wrap: wrap;
  min-width: 0;
  gap: 0 8rpx;
  row-gap: 6rpx;
}

.shelf-goods-price-edit {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #187e6e;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(24, 126, 110, 0.35);
  border-radius: 8rpx;
}

.shelf-list-spec-text {
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.shelf-list-spec-gap {
  flex-shrink: 0;
  color: #b0b8c2;
  font-size: 28rpx;
  line-height: 1.35;
}

.shelf-list-carton-inline {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
}

.shelf-list-carton-main,
.shelf-list-carton-unit {
  word-break: break-word;
  overflow-wrap: anywhere;
}

.shelf-list-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.shelf-list-spec {
  font-size: 28rpx;
  color: #5c6570;
}

.shelf-list-stock {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: #454545;
  gap: 12rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.shelf-list-stock .shelf-card-stock {
  flex: 1;
  min-width: 0;
}

.shelf-list-stock.shelf-list-stock-full {
  margin-top: 8rpx;
}

.shelf-list-stock-label {
  color: #666;
  flex-shrink: 0;
}

/* 相同货架：卡片 / 列表统一结构，置于库存下方 */
.shelf-same-goods-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  font-size: 28rpx;
  color: #454545;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.shelf-list-same-goods {
  margin-top: 12rpx;
}

/* 同架紧跟规格行：与规格同属 title-text 列 */
.shelf-list-title-text .shelf-list-same-under-spec {
  margin-top: 0;
}

.shelf-same-goods-chips {
  flex: 1;
  min-width: 0;
}

.stock-num {
  color: #147062;
  font-weight: 600;
}

.stock-empty {
  color: #999;
}

.overlay .popup {
  top: 12% !important;
  transform: translate(-50%, 0) !important;
  width: 92% !important;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.shelf-list-tag {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  align-self: flex-start;
}

.shelf-card-wrap {
  width: 48%;
  margin: 0 2% 24rpx 0;
  position: relative;
  box-sizing: border-box;
  max-width: 48%;
  min-width: 0;
}
.shelf-card-wrap:nth-child(2n) {
  margin-right: 0;
}

.shelf-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #e9eff2;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.shelf-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.shelf-card-brand {
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  color: #0a8a72;
  background: rgba(18, 160, 133, 0.12);
  border-radius: 20rpx;
}

.shelf-card-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.sameShelf{
  border: 1px solid rgb(224, 71, 0);
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
  background-color: #f8feff;
  color: rgb(204, 1, 1);
  font-size: 24rpx;
  font-weight: 500;
  
  
}

.shelf-card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2f3d;
}

.shelf-card-spec {
  font-size: 28rpx;
  color: #454d56;
  /* font-size: 40rpx; */
  /* color: #04328c; */
}

/* 按库存金额排序时接口返回的 totalRestSubtotal */
.shelf-goods-rest-subtotal {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  width: 100%;
}

.shelf-goods-rest-subtotal--list {
  margin-top: 6rpx;
}

.shelf-goods-rest-subtotal-label {
  font-size: 24rpx;
  color: #888;
}

.shelf-goods-rest-subtotal-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #e65100;
}

/* ========== 列表库存批次：台账式「一批一条」，突出批次与时间线 ========== */
.shelf-card-stock-rows {
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 20rpx;
}

.shelf-card-stock-rows .shelf-stock-batch-card.shelf-batch-ledger {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid #e3e8ec;
  box-shadow: 0 1rpx 4rpx rgba(18, 42, 66, 0.04);
}

/* 左侧色条：一眼区分「这是另一条批次」 */
.shelf-card-stock-rows .shelf-stock-batch-card.shelf-batch-ledger {
  border-left: 8rpx solid #12a085;
}

.shelf-batch-ledger-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 18rpx 14rpx;
  border-bottom: 1rpx solid #eef2f5;
  background: #fbfcfd;
}

.shelf-batch-ledger-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
}

.shelf-batch-ledger-no {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #0a8a72;
  padding: 8rpx 14rpx;
  line-height: 1.2;
  background: rgba(18, 160, 133, 0.12);
  border-radius: 8rpx;
}

.shelf-batch-ledger-dates {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.shelf-batch-ledger-date-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx 14rpx;
}

.shelf-batch-ledger-k {
  font-size: 24rpx;
  color: #7a8490;
  font-weight: 500;
}

.shelf-batch-ledger-v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1c2430;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.shelf-batch-ledger-loc {
  flex-shrink: 0;
  max-width: 200rpx;
  font-size: 24rpx;
  color: #5c6570;
  font-weight: 500;
  line-height: 1.35;
  text-align: right;
}

/* 单行三列：单价 | 入库 | 剩余，弱化色块、用分隔线对齐 */
.shelf-batch-ledger-grid {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: #f5f7f9;
  padding: 18rpx 0;
}

.shelf-batch-ledger-cell {
  flex: 1;
  min-width: 0;
  padding: 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-align: center;
  gap: 10rpx;
  border-right: 1rpx solid #dde3e8;
  box-sizing: border-box;
}

/* 金额与数量紧挨展示，避免与「单价」列等高拉伸时在中间留大块空白 */
.shelf-batch-ledger-amount-qty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
}

.shelf-batch-ledger-cell-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}

.shelf-batch-ledger-price-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 100%;
}

.shelf-batch-ledger-cell:last-child {
  border-right: none;
}

.shelf-batch-ledger-cell--rest {
  background: rgba(255, 152, 0, 0.07);
}

.shelf-batch-ledger-metric {
  font-size: 22rpx;
  color: #6b7580;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.shelf-batch-ledger-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c2430;
  line-height: 1.35;
  word-break: break-all;
}

/* 大包装单价下：最小单位采购单价（nxDgssPrice） */
.shelf-batch-ledger-subnum {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7580;
  line-height: 1.35;
  word-break: break-all;
}

.shelf-batch-ledger-num--rest {
  font-size: 30rpx;
  color: #c66900;
  font-weight: 700;
}

.shelf-batch-ledger-note {
  font-size: 24rpx;
  color: #5c6570;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-all;
  text-align: center;
}

.shelf-batch-ledger-note--rest {
  color: #a85c00;
  font-weight: 600;
}

/* 左侧菜单已点击状态（允许点击右侧商品） */
.left-clicked {
  background-color: #b8e6d0 !important; /* 更强烈的绿色背景，表示已点击且可操作 */
  border-left: 6rpx solid #0d5d4f !important; /* 更深的绿色边框 */
  font-weight: 700; /* 加粗文字 */
  color: #0d5d4f !important; /* 深绿色文字，更强烈的对比 */
  box-shadow: 0 4rpx 12rpx rgba(22, 112, 99, 0.3); /* 更强的阴影效果，更突出 */
  transform: scale(1.02); /* 轻微放大，增强视觉反馈 */
}


.shelf-card-stock {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  align-items: flex-start;
}

.stock-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #e9efff;
  color: #3171ff;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.shelf-card-empty {
  color: #b0b7c3;
  font-size: 26rpx;
}

.shelf-card-tag {
  position: absolute;
  top: 10rpx;
  right: 0;
}
.shelf-card-tag .circle {
  margin: 0;
  width: 90rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  
}

/* 图片弹窗样式 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #666;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.modal-body {
  padding: 30rpx;
  text-align: center;
  overflow-y: auto;
  flex: 1;
}

.modal-image {
  width: 100%;
  max-height: 500rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  animation: scaleIn 0.4s ease 0.1s both;
  transition: transform 0.3s ease;
}

.image-info {
  text-align: left;
  margin-top: 20rpx;
}

.goods-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.goods-standard {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 固定货架名称区域 */
.shelf-header-fixed {
  position: relative;
  z-index: 100;
  background-color: #fff;
}