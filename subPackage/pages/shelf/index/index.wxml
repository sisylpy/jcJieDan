<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="flex flex-column height-100">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="货架" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class=" " style="margin-top: {{navBarHeight}}rpx; ">
    <view class="flex flex-row-between bg-white border-bottom shelf-toolbar" style="height:{{viewBarHeight}}rpx; ">
     
      <view class="flex flex-row p-20 mainColor shelf-toolbar-left">

<text class="" wx:if="{{shelfGoodsType == '99'}}">全部商品</text>
<text class="" wx:elif="{{shelfGoodsType == '1'}}">多货架商品</text>
<text class="" wx:elif="{{shelfGoodsType == '2'}}">有库存</text>
<text class="" wx:elif="{{shelfGoodsType == '3'}}">无库存</text>
<view class="" style="border-radius: 50%;" bindtap="openFilterMenu" hover-class="hover">
  <image src="/images/points.png" class="icon mr-10 ml-10"></image>
</view>
<!-- 货架商品类型筛选菜单 -->
<block wx:if="{{showFilterMenu}}">
  <view class="filter-menu-overlay" catchtap="closeFilterMenu"></view>
  <view class="filter-menu-panel bg-white font-md" style="top: {{navBarHeight + viewBarHeight + 10}}rpx;">
    <view class="filter-menu-item {{shelfGoodsType == '99' ? 'active' : ''}}" bindtap="selectShelfGoodsType" data-type="99">全部商品</view>
    <view class="filter-menu-item {{shelfGoodsType == '1' ? 'active' : ''}}" bindtap="selectShelfGoodsType" data-type="1">多货架商品</view>
    <view class="filter-menu-item {{shelfGoodsType == '2' ? 'active' : ''}}" bindtap="selectShelfGoodsType" data-type="2">有库存</view>
    <view class="filter-menu-item {{shelfGoodsType == '3' ? 'active' : ''}}" bindtap="selectShelfGoodsType" data-type="3">无库存</view>
  </view>
</block>
</view>
      <view class="flex flex-row shelf-toolbar-actions">

        <view class="button-container mr-20" bindtap="showType">
          <image src="{{isListView ? '/images/liebiao.png' : '/images/suoluetu.png'}}" class="icon"></image>
        </view>

        <block wx:if="{{disInfo.nxDistributerType == -1}}">
          <view class="button-container mr-20" bindtap="downLoadInitStock">
            <image src="../../../../images/Focus-Auto.png" class="icon"></image>
          </view>
          <view class="button-container mr-20" bindtap="uploadInitStock">
            <image src="../../../../images/primitive-dot.png" class="icon"></image>
          </view>
        </block>
        <!-- <block wx:if="{{disInfo.nxDistributerType  == 1}}">
          <view class="button-container mr-20" bindtap="downLoadInitShelfGoods">
          <image src="../../../../images/radiobuttonunselect-2.png" class="icon"></image>
        </view>
        <view class="button-container mr-20" bindtap="uploadInitShelfGoods">
          <image src="../../../../images/checkbox-noselected.png" class="icon"></image>
        </view>
        </block> -->


        <view class="button-container mr-20" bindtap="toSearch">
          <image src="../../../../images/search-3.png" class="icon"></image>
        </view>
        <view class="button-container mr-20" bindtap="addNew">
          <image src="../../../../images/add.png" class="icon"></image>
        </view>

        <view class="button-container mr-20" bindtap="editShelfState" data-type="sell">
          <image src="../../../../images/exchange.png" class="icon"></image>
        </view>
      
        <view class="button-container mr-20" wx:if="{{disInfo.nxDistributerBusinessTypeId > 1}}" bindtap="toPurchase" data-type="sell">
          <image src="../../../../images/jjdhn.png" class="icon"></image>
        </view>

      </view>
    </view>

    <view class="flex-column {{shelfArr.length == 0  ? 'show' : 'hide'}}" style="height: {{contentHeight }}rpx; ">
      <view class="font-lg p-30 popEmpty">
        <view class="center-content flex-column">
          <image class="empty_image" src="../../../../images/paste.png"></image>
          <text class="font-md text-secondary">暂时无货架</text>
        </view>
      </view>

    </view>

    <view class="main" wx:if="{{shelfArr.length > 0}}">

      <scroll-view class="left-menu" scroll-y="true" style="height: {{contentHeight }}rpx; width: {{leftMenuWidth}}rpx;">
        <view class="left-item border-bottom {{shelfIndex == leftIndex ? 'left-active' : ''}}" wx:key="nxDistributerGoodsShelfId" wx:for="{{shelfArr}}" wx:for-item="grand" bindtap="changeShelfId" data-item="{{grand}}" wx:for-index="leftIndex" data-index="{{leftIndex}}" data-id="{{grand.nxDistributerGoodsShelfId}}">
          <text>{{grand.nxDistributerGoodsShelfName}}({{grand.goodsCount}})</text>
        </view>

        <view class="left-item border-bottom {{shelfIndex == shelfArr.length ? 'left-active' : ''}}" bind:tap="getUnShelfGoods" wx:if="{{shelfGoodsType == '99'}}">
          <text class="font-xs text-danger">非货架({{unShelfTotalCount}})</text>
        </view>
        <view style="height: 100rpx;">

        </view>
      </scroll-view>


      <view class="flex-1" bindtap="{{isShowTools ? 'hideMask' :''}}">
        <view class="shelf-header-fixed" wx:if="{{shelfIndex != shelfArr.length}}">
          <view class="flex-row-between font-md p-10 border-bottom bg-white shelf-header-title-row">
            <!-- <text class="font-xs text-secondary">负责人:{{shelfItem.responsibleUser.nxDiuWxNickName}}</text> -->
            <view class="shelf-header-left-col">
              <view class="flex-row shelf-header-title-line">
                <text class="text-secondary mr-10 shelf-header-label">货架:</text>
                <text class="mainColor font-bold shelf-header-shelf-name">{{shelfItem.nxDistributerGoodsShelfName}}</text>
              </view>
              <view class="shelf-header-sort-row" wx:if="{{shelfGoodsQuerySort > 0}}">
                <view class="shelf-sort-chip shelf-sort-chip--current active" catchtap="toSortTools" hover-class="hover">
                  <text wx:if="{{shelfGoodsQuerySort == 1}}">金额高→低</text>
                  <text wx:elif="{{shelfGoodsQuerySort == 2}}">金额低→高</text>
                  <text wx:elif="{{shelfGoodsQuerySort == 3}}">到期晚→早</text>
                  <text wx:elif="{{shelfGoodsQuerySort == 4}}">到期早→晚</text>
                </view>
              </view>
            </view>
            <view class="flex-row-default shelf-header-actions">
              <view class="button-container-white mr-20" catchtap="toSortTools" hover-class="hover">
                <image src="{{shelfGoodsQuerySort == 0 ? '../../../../images/filter-3-fill.png' : '../../../../images/filter.png'}}" class="icon margin-left">
                </image>
              </view>
              <view class="button-container-white" catchtap="toShowTools" hover-class="hover">
                <image src="../../../../images/points.png" class="icon margin-left">
                </image>
              </view>
            </view>
          </view>
        </view>
        <scroll-view class="bg-white" scroll-y="true" style="height: {{shelfIndex != shelfArr.length ? contentHeight - 80 : contentHeight}}rpx; z-index: 9999999;" scroll-top="{{toTop}}" bindscrolltolower="onScrollToLower">
          <view class="flex-column">
            <block wx:if="{{!isListView}}">
              <view class="flex-row-wrap p-20" wx:if="{{shelfGoodsList.length > 0}}">
                <block wx:for="{{shelfGoodsList}}" wx:for-item="shelfGoods" wx:key="nxDistributerGoodsShelfGoodsId">
                  <view class="shelf-card-wrap">
                    <view class="shelf-card" bindtap="showChoice" data-arr="{{shelfGoods.nxDisGoodsShelfStockEntities}}" data-goods="{{shelfGoods.nxDistributerGoodsEntity}}" data-item="{{grand}}" data-shelfgoods="{{shelfGoods}}">
                      <view class="shelf-card-header">
                        <view class="shelf-card-title">
                            <text class="shelf-card-name"> <text class=""> L{{shelfGoods.nxDgsgShelfLayer}}</text>-{{shelfGoods.nxDgsgShelfLayerSeq}}.<text class="shelf-card-brand" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsName}}</text> 
                          
                          <text class="shelf-card-spec" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}">{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0 ? shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight + '/' : ''}}{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>

                          <block wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== null && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== ''}}">
                            <view class="flex-row shelf-card-spec">
                              <text class="">{{shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton}}{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                              <text>/{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit}}</text>
                            </view>
                          </block>

                          <block wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgNxGoodsId == null}}">
                            <text class="text-danger font-xs">[临时]</text>
                          </block>
                          <view wx:if="{{(shelfGoodsQuerySort == 1 || shelfGoodsQuerySort == 2) && shelfGoods.totalRestSubtotal != null && shelfGoods.totalRestSubtotal !== ''}}" class="shelf-goods-rest-subtotal">
                            <text class="shelf-goods-rest-subtotal-label">剩余金额</text>
                            <text class="shelf-goods-rest-subtotal-value">¥{{shelfGoods.totalRestSubtotal}}</text>
                          </view>
                        </view>
                      </view>

                      <view class="shelf-card-stock">
                        <block wx:if="{{shelfGoods.nxDisGoodsShelfStockEntities !== null && shelfGoods.nxDisGoodsShelfStockEntities.length > 0}}">
                          <view class="stock-chip-row" wx:for="{{shelfGoods.nxDisGoodsShelfStockEntities}}" wx:for-item="stock" wx:key="index">
                            <text class="stock-chip" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== '' && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(stock.nxDgssRestWeight, shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit, shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton, shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname)}}</text>
                            <text class="stock-chip" wx:else>{{stock.nxDgssRestWeight}}{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                            <text class="stock-chip-detail" catchtap="toInventoryBatchBusiness" data-stock-id="{{stock.nxDistributerGoodsShelfStockId}}">详情</text>
                          </view>
                        </block>
                        <block wx:else>
                          <text class="shelf-card-empty">暂无库存</text>
                        </block>
                      </view>
                      <view class="shelf-same-goods-row" wx:if="{{shelfGoods.sameShelfGoods.length > 0}}">
                        <text class="shelf-list-stock-label">同架：</text>
                        <view class="flex-row-wrap shelf-same-goods-chips">
                          <view class="sameShelf mr-10" wx:for="{{shelfGoods.sameShelfGoods}}" wx:for-item="same">
                            <text>{{same.shelfName}}</text>
                            <block wx:if="{{same.nxDgsgShelfLayer !== null}}">
                              <text>-L{{same.nxDgsgShelfLayer}}</text>
                            </block>
                            <text>-{{same.nxDgsgShelfLayerSeq != null && same.nxDgsgShelfLayerSeq !== '' ? same.nxDgsgShelfLayerSeq : same.nxDgsgSort}}</text>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view class="shelf-card-tag" wx:if="{{shelfGoods.shelfPurGoods !== null}}">
                      <view class="circle {{shelfGoods.shelfPurGoods.nxDpgStatus == 1 ? 'gray' : shelfGoods.shelfPurGoods.nxDpgStatus == 2 ? 'green' : ''}} center-content">
                        <view class="flex-row">
                          <text>{{shelfGoods.shelfPurGoods.nxDpgQuantity}}</text>
                          <text>{{shelfGoods.shelfPurGoods.nxDpgStandard}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view class="shelf-layer-divider" wx:if="{{shelfGoods.nxDgsgShelfLayerLast == 1}}">
                    <view class="divider-line"></view>
                    <text class="divider-text">{{layerTextMap[shelfGoods.nxDgsgShelfLayer] || ('第' + shelfGoods.nxDgsgShelfLayer + '层结束')}}</text>
                    <view class="divider-line"></view>
                  </view>
                </block>
              </view>
            </block>
            <block wx:else>
              <view class="shelf-list-wrap" wx:if="{{shelfGoodsList.length > 0}}">
                <block wx:for="{{shelfGoodsList}}" wx:for-item="shelfGoods" wx:key="nxDistributerGoodsShelfGoodsId">
                  <view class="shelf-list-item">
                    <view class="shelf-list-top-row">
                      <view class="shelf-list-thumb" bindtap="showDisImageModal" data-goods="{{shelfGoods.nxDistributerGoodsEntity}}" data-item="{{sons}}" src="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFileLarge !== null ? url + shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFileLarge : '/images/logo.jpg'}}">
                        <image wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFileLarge && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFileLarge !== 'null'}}" src="{{url + shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFileLarge}}" mode="aspectFill" class="shelf-list-img" />
                        <image wx:elif="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFile && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFile !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFile !== 'goodsImage/logo.jpg' }}" src="{{url + shelfGoods.nxDistributerGoodsEntity.nxDgGoodsFile}}" mode="aspectFill" class="shelf-list-img" />
                        <view wx:else class="shelf-list-img placeholder">
                          <image src="/images/photozhaoxiang.png" mode="aspectFill" class="icon-lg" />
                        </view>
                      </view>
                      <view class="shelf-list-info" bindtap="showChoice" data-arr="{{shelfGoods.nxDisGoodsShelfStockEntities}}" data-goods="{{shelfGoods.nxDistributerGoodsEntity}}" data-item="{{grand}}" data-shelfgoods="{{shelfGoods}}">
                        <view class="shelf-list-title">
                          <view class="shelf-list-title-text">
                            <view class="shelf-list-title-line1">
                              <text class="shelf-card-name shelf-title-prefix"> L{{shelfGoods.nxDgsgShelfLayer}}</text>
                              <text class="shelf-card-name shelf-title-prefix">-{{shelfGoods.nxDgsgShelfLayerSeq}}.</text>
                              <text class="shelf-card-brand shelf-title-brand" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                              <view class="shelf-title-name-wrap">
                                <text class="shelf-card-name shelf-title-name-text">{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                              </view>
                            </view>
                            <view class="shelf-list-line-full shelf-list-spec-carton-row" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname || (shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== null && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== '')}}">
                              <text class="shelf-card-spec shelf-list-spec-text" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}">{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0 ? shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardWeight + '/' : ''}}{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                              <text class="shelf-list-spec-gap" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== null && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== ''}}"> </text>
                              <view class="flex-row shelf-card-spec shelf-list-carton-inline" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== null && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton !== ''}}">
                                <text class="shelf-list-carton-main">{{shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton}}{{shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                                <text class="shelf-list-carton-unit">/{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit}}</text>
                              </view>
                              <text class="shelf-goods-price-edit" catchtap="showIsPurchase" data-item="{{shelfGoods.nxDistributerGoodsEntity}}" data-index="{{index}}">设价</text>
                            </view>
                            <view class="shelf-list-line-full" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgNxGoodsId == null}}">
                              <text class="text-danger font-xs">[临时]</text>
                            </view>
                            <view wx:if="{{(shelfGoodsQuerySort == 1 || shelfGoodsQuerySort == 2) && shelfGoods.totalRestSubtotal != null && shelfGoods.totalRestSubtotal !== ''}}" class="shelf-goods-rest-subtotal shelf-goods-rest-subtotal--list">
                              <text class="shelf-goods-rest-subtotal-label">剩余金额</text>
                              <text class="shelf-goods-rest-subtotal-value">¥{{shelfGoods.totalRestSubtotal}}</text>
                            </view>
                            <view class="shelf-same-goods-row shelf-list-same-goods shelf-list-same-under-spec" wx:if="{{shelfGoods.sameShelfGoods.length > 0}}">
                              <text class="shelf-list-stock-label">同架：</text>
                              <view class="flex-row-wrap shelf-same-goods-chips">
                                <view class="sameShelf mr-10" wx:for="{{shelfGoods.sameShelfGoods}}" wx:for-item="same">
                                  <text>{{same.shelfName}}</text>
                                  <block wx:if="{{same.nxDgsgShelfLayer !== null}}">
                                    <text>-L{{same.nxDgsgShelfLayer}}</text>
                                  </block>
                                  <text>-{{same.nxDgsgShelfLayerSeq != null && same.nxDgsgShelfLayerSeq !== '' ? same.nxDgsgShelfLayerSeq : same.nxDgsgSort}}</text>
                                </view>
                              </view>
                            </view>
                          </view>
                        </view>
                      </view>
                      <view class="shelf-list-tag" wx:if="{{shelfGoods.shelfPurGoods !== null}}">
                        <view class="circle_list {{shelfGoods.shelfPurGoods.nxDpgStatus == 1 ? 'gray' : shelfGoods.shelfPurGoods.nxDpgStatus == 2 ? 'green' : ''}} center-content">
                          <view class="flex-row">
                            <text>{{shelfGoods.shelfPurGoods.nxDpgQuantity}}</text>
                            <text>{{shelfGoods.shelfPurGoods.nxDpgStandard}}</text>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view class="shelf-list-stock shelf-list-stock-full" bindtap="showChoice" data-arr="{{shelfGoods.nxDisGoodsShelfStockEntities}}" data-goods="{{shelfGoods.nxDistributerGoodsEntity}}" data-item="{{grand}}" data-shelfgoods="{{shelfGoods}}">
                      <view class="shelf-card-stock shelf-card-stock-rows">
                        <block wx:if="{{shelfGoods.nxDisGoodsShelfStockEntities !== null && shelfGoods.nxDisGoodsShelfStockEntities.length > 0}}">
                          <view class="shelf-batch-ledger purchase-row-content shelf-stock-batch-card" wx:for="{{shelfGoods.nxDisGoodsShelfStockEntities}}" wx:for-item="stock" wx:for-index="stockIdx" wx:key="stockIdx">
                            <view class="shelf-batch-ledger-head" wx:if="{{stock.nxDgssProduceDate !== null && stock.nxDgssProduceDate !== ''}}">
                              <view class="shelf-batch-ledger-head-main">
                                <text class="shelf-batch-ledger-no">批次 {{stockIdx + 1}}</text>
                                <view class="shelf-batch-ledger-dates">
                                  <view class="shelf-batch-ledger-date-line">
                                    <text class="shelf-batch-ledger-k">生产</text>
                                    <text class="shelf-batch-ledger-v">{{tool.transferFullTimeString(stock.nxDgssProduceDate)}}</text>
                                  </view>
                                  <view class="shelf-batch-ledger-date-line">
                                    <text class="shelf-batch-ledger-k">到期</text>
                                    <text class="shelf-batch-ledger-v">{{tool.transferFullTimeString(stock.nxDgssExpiryDate)}}</text>
                                  </view>
                                </view>
                              </view>
                              <!-- <text class="shelf-batch-ledger-loc" wx:if="{{stock.shelfName}}">{{stock.shelfName}}</text> -->
                            </view>
                            <view class="shelf-batch-ledger-grid">
                              <view class="shelf-batch-ledger-cell">
                                <text class="shelf-batch-ledger-metric">单价</text>
                                <view class="shelf-batch-ledger-cell-body">
                                  <view class="shelf-batch-ledger-price-lines">
                                    <block wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== '' && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton > 0}}">
                                      <text class="shelf-batch-ledger-num">{{stock.nxDgssPriceCarton || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDpgBuyPrice)}}元/{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit}}</text>
                                      <text class="shelf-batch-ledger-subnum" wx:if="{{stock.nxDgssPrice != null && stock.nxDgssPrice !== ''}}">{{stock.nxDgssPrice}}元/{{(stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                                    </block>
                                    <block wx:else>
                                      <text class="shelf-batch-ledger-num">{{stock.nxDgssPrice || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDpgBuyPrice)}}元/{{(stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                                    </block>
                                  </view>
                                  <block wx:if="{{stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.purchaseDepartmentUser !== null}}">
                                    <text class="shelf-batch-ledger-note">{{stock.purchaseGoodsEntity.purchaseDepartmentUser.nxDuWxNickName}}</text>
                                  </block>
                                  <block wx:elif="{{stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxJrdhSupplierEntity !== null}}">
                                    <text class="shelf-batch-ledger-note">{{stock.purchaseGoodsEntity.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                                  </block>
                                </view>
                              </view>
                              <view class="shelf-batch-ledger-cell">
                                <text class="shelf-batch-ledger-metric">入库</text>
                                <view class="shelf-batch-ledger-amount-qty">
                                  <text class="shelf-batch-ledger-num">{{stock.nxDgssSubtotal}}元</text>
                                  <view class="shelf-batch-ledger-note">
                                    <block wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== '' && shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit !== 'null' && shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton > 0}}">
                                      {{tool.formatQuantityDisplay(stock.nxDgssWeight, shelfGoods.nxDistributerGoodsEntity.nxDgCartonUnit, shelfGoods.nxDistributerGoodsEntity.nxDgItemsPerCarton, (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || shelfGoods.nxDistributerGoodsEntity.nxDgGoodsStandardname)}}
                                    </block>
                                    <block wx:else>
