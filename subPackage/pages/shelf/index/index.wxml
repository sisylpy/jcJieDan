      <view class="p-30 flex-row border-bottom" catchtap="setShelfLayer" hover-class="hover" wx:if="{{(shelfGoods.nxDgsgShelfLayerLast == null || shelfGoods.nxDgsgShelfLayerLast  == 0)}}">
