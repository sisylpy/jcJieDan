      <view class="p-30 flex-row border-bottom  {{shelfGoods.nxDisGoodsShelfStockEntities.length > 0 ? 'text-secondary' :''}}" catchtap="deleteGoods" hover-class="hover" >

        <image src="/images/del.png" mode="aspectFill" class="icon mr-20" />
        <text>删除货架商品</text>
      </view>
    </block>



  </view>


