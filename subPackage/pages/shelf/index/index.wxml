      <view class="bg-light" style="height: 10px;"></view>

      <view class="p-30 flex-row border-bottom" catchtap="toFixedLinshi" hover-class="hover" wx:if="{{shelfGoods.nxDistributerGoodsEntity.nxDgNxGoodsId == null}}">
        <image src="/images/download.png" mode="aspectFill" class="icon mr-20" />
