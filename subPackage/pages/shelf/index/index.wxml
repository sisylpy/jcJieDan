          <text class="mr-10">{{disGoods.nxDgGoodsName}}</text>
          <text>({{disGoods.nxDgGoodsStandardname}})</text>
        </view>
      </view>

      <view class="p-30 flex-row border-bottom" catchtap="changeShelf" hover-class="hover">
        <image src="/images/exchange.png" mode="aspectFill" class="icon mr-20" />
        <text> 添加到货架</text>
      </view>

      <view class="p-30 flex-row border-bottom" catchtap="searchShelfGoods" hover-class="hover">
        <image src="/images/search-3.png" mode="aspectFill" class="icon mr-20" />
        <text> 查找货架商品</text>
      </view>
      <view class="p-30 flex-row border-bottom" catchtap="deleteDisGoods" hover-class="hover">
