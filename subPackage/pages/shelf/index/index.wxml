                      </view>
                    </view>
                  </view>
                </block>
              </view>
            </block>
            <block wx:else>
              <view class="shelf-list-wrap" wx:if="{{unShelfGoodsList.length  > 0}}">
                <block wx:for="{{unShelfGoodsList}}" wx:for-item="disGoods" wx:for-index="unshelfIdx" wx:key="unshelfIdx">
