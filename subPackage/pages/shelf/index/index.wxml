                            <text class="stock-chip" wx:else>{{stock.nxDgssRestWeight}}{{disGoods.nxDgGoodsStandardname}}</text>
                          </block>
                        </block>
                        <block wx:else>
                          <text class="shelf-card-empty">暂无库存</text>
                        </block>
                      </view>
                    </view>
                    <view class="shelf-card-tag" wx:if="{{disGoods.shelfPurGoods !== null}}">
                      <view class="circle {{disGoods.shelfPurGoods.nxDpgStatus == 1 ? 'gray' : disGoods.shelfPurGoods.nxDpgStatus == 2 ? 'green' : ''}}  center-content">
