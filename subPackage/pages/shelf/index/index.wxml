    <view class="filter-menu-item {{shelfGoodsQuerySort == 2 ? 'active' : ''}}" bindtap="selectShelfGoodsQuerySort" data-sort="2">库存金额从低到高</view>
    <view class="filter-menu-item {{shelfGoodsQuerySort == 3 ? 'active' : ''}}" bindtap="selectShelfGoodsQuerySort" data-sort="3">库存到期时间从高到低</view>
    <view class="filter-menu-item {{shelfGoodsQuerySort == 4 ? 'active' : ''}}" bindtap="selectShelfGoodsQuerySort" data-sort="4">库存到期时间从低到高</view>
  </view>
