
page {
  height: 100%;
  width: 100%;
  overflow: hidden;
}

.list-row {
  padding: 20rpx 20rpx;
  border: 1px solid #b9b9b9;
  background-color: white;
  border-radius: 20rpx;
}

.history_item {
  box-shadow: rgb(212, 212, 212) 0px 4px 6px 0px;
}

.sort-input-container {
  width: 100%;
}

.sort-input {
  width: 100%;
  height: 60rpx;
  border: 1px solid #D9D9D9;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  background-color: white;
  color: #007AFF;
  font-weight: 500;
}

.sort-input:focus {
  border-color: #007AFF;
  background-color: white;
}

.sort-input::placeholder {
  color: #999;
  font-size: 24rpx;
}

/* 底部按钮条 */
.bottom-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  text-align: center;
  background-color: #e0e0e0;
  color: #999;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.save-btn.is-active {
  background-color: #007AFF;
  color: #ffffff;
}
