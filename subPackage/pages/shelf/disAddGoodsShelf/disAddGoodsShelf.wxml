<view class="flex-column height-100 font-md">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="添加新商品商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>
 
	<view class="p-20 flex-row-between" style="margin-top: {{navBarHeight}}rpx;">
	<view >必填:</view>
		<view class="flex-column-center">
		<view class="addBtn {{canSave ? 'is-active' : ''}}" bindtap="saveDisGoods">添加
		</view>
	</view>
	</view>

	<view class="bg-white p-20 flex-column">
  
  	<view class=" flex-row mt-10">
				<text class="text-secondary m-10 flex-fixed">新商品名称:</text>
			<input class="inputAddGoods p-10" bindinput="getDisGoodsContent" data-type="0"
				value="{{goods.nxDgGoodsName}}" ></input>
		</view>

		<view class=" flex-row mt-10">
				<text class="text-secondary  m-10 flex-fixed">商品规格:</text>
			<input class="inputAddGoods p-10" value="{{goods.nxDgGoodsStandardname}}"
				bindinput="getDisGoodsContent" data-type="1"></input>
		</view>

	</view>
	

	<view class="p-20">可填:</view>
	<view class="bg-white p-20 flex-column">
	
		<view class=" flex-row">
				<text class="text-secondary  m-10 flex-fixed">单位重量:</text>
			<input value="{{goods.nxDgGoodsStandardWeight !== '-1' ? goods.nxDgGoodsStandardWeight : ''}}" class="inputAddGoods p-10"
				bindinput="getDisGoodsContent" data-type="2"></input>
		</view>

		<view class="flex-row ">
			<text class="text-secondary flex-fixed m-10">品牌:</text>
			<input class="inputAddGoods p-10" bindinput="getDisGoodsContent" data-type="3"
				value="{{goods.nxDgGoodsBrand !== '-1' ? goods.nxDgGoodsBrand : ''}}"></input>
		</view>

		<view class=" flex-row">
			<text class="text-secondary flex-fixed m-10">产地:</text>
			<input class="inputAddGoods p-10" value="{{goods.nxDgGoodsPlace !== '-1' ? goods.nxDgGoodsPlace  : ''}}" bindinput="getDisGoodsContent"
				data-type="4"></input>
		</view>
		<view class=" flex-row with-margin-bottom">
			<text class="text-secondary flex-fixed m-10">详细:</text>
			<input class="inputAddGoods p-10" value="{{goods.nxDgGoodsDetail}}" bindinput="getDisGoodsContent"
				data-type="5"></input>
		</view>
	
	</view>




</view>




<!-- mask -->
<view class='overlay {{showTishi ? "show" : ""}}' catchtap="hideMask" style="height:{{maskHeight > windowHeight ? maskHeight : windowHeight}}rpx;">
  <!-- + scrollViewTop -->
  <view class="bg-whitefont-lg" style="margin-top:{{haveSame == 2 ? '400': '300'}}rpx;margin-left: 50rpx; width:{{windowWidth - 100}}rpx;" >
    <view   class="flex-column-center p-20small" wx:if="{{haveSame == 2}}">
    <image src="/images/smile.png" mode="aspectFill" class="icon"/>
      <text>已经有相同的商品啦!</text>
    </view>
    
    <view class="p-20">
      <view class="p-20 border-bottom" wx:for="{{showArr}}" bindtap="orderGoods" data-item="{{item}}" > 
     <text class="{{item.nxDgGoodsBrand !== null ? brand: ''}}"> {{item.nxDgGoodsBrand !== null ? item.nxDgGoodsBrand: ''}}</text>
    <text class="mr-20"> {{item.nxDgGoodsName}}</text>
    <text>({{item.nxDgGoodsStandardname}})</text>
     
    </view>
    </view>
    
    <view class="flex-row p-20" wx:if="{{haveSame == 1}}">
     <view class="half-row flex-column-center">
       关闭
     </view>
      <view class="half-row flex-column-center" bindtap="againSave">
        确定添加
      </view>
     
   </view>
   
  </view>

  

</view>
<!-- ./mask -->