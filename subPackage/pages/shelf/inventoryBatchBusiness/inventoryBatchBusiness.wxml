<view class="page">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="库存批次列表"
    avatar="/images/back-gray.png"
    bindnavbuttontap="toBack">
  </back-navbar>

  <scroll-view
    class="page-scroll"
    scroll-y="true"
    refresher-enabled="true"
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="onPullDownRefresh"
    style="padding-top: {{navBarHeight}}rpx;">
    <view class="content">
      <view class="goods-summary-card">
        <view class="goods-summary-main">
          <view class="goods-summary-copy">
            <text class="goods-name">{{goodsName}}</text>
            <text class="goods-meta" wx:if="{{shelfName}}">{{shelfName}} · {{batches.length}} 个库存批次</text>
            <text class="goods-meta" wx:else>{{batches.length}} 个库存批次</text>
          </view>
          <view class="goods-total">
            <text class="goods-total-value">{{totalRemainingText}}</text>
            <text class="goods-total-unit">{{standardName}} 剩余</text>
          </view>
        </view>
        <view class="safe-tip">
          <text class="safe-tip-icon">✓</text>
          <text>批次数量调整会保留原因和责任归因，方便以后核对库存流水。</text>
        </view>
      </view>

      <view class="loading-state" wx:if="{{loading && batches.length === 0}}">
        <view class="loading-dot"></view>
        <text>正在加载库存批次...</text>
      </view>

      <view class="error-card" wx:if="{{errorText}}">
        <text>{{errorText}}</text>
        <view class="retry-button" bindtap="retryBatches">重新加载</view>
      </view>

      <view class="batch-list" wx:if="{{batches.length > 0}}">
        <view class="batch-card" wx:for="{{batches}}" wx:key="stockBatchId" wx:for-item="batch" wx:for-index="batchIndex">
          <view class="batch-card-header">
            <view>
              <text class="batch-title">批次 {{batch.displayIndex}}</text>
              <text class="batch-id">#{{batch.stockBatchId}}</text>
            </view>
            <text class="batch-status {{batch.isCompleted ? 'batch-status--done' : ''}}">{{batch.businessStatusText}}</text>
          </view>

          <view class="batch-load-error" wx:if="{{batch.loadFailed}}">
            <text>该批次经营数据加载失败</text>
            <view class="mini-retry" bindtap="retryBatches">重试</view>
          </view>

          <block wx:else>
            <view class="remaining-panel">
              <view>
                <text class="remaining-label">当前剩余</text>
                <view class="remaining-value-row">
                  <text class="remaining-value">{{batch.remainingQuantityText}}</text>
                  <text class="remaining-unit">{{batch.baseUom}}</text>
                </view>
              </view>
              <view class="remaining-progress-copy">
                <text>原始入库 {{batch.netStockInQuantityText}}{{batch.baseUom}}</text>
                <text>已销售 {{batch.soldQuantityText}}{{batch.baseUom}}</text>
              </view>
            </view>

            <view class="batch-info-grid">
              <view class="batch-info-item">
                <text class="info-label">采购单价</text>
                <text class="info-value">{{batch.unitCostDisplay}}</text>
              </view>
              <view class="batch-info-item">
                <text class="info-label">当前售价</text>
                <text class="info-value">{{batch.currentSellingPriceDisplay}}</text>
              </view>
              <view class="batch-info-item">
                <text class="info-label">入库日期</text>
                <text class="info-value">{{batch.stockInDate || '未记录'}}</text>
              </view>
              <view class="batch-info-item">
                <text class="info-label">到期日期</text>
                <text class="info-value {{batch.expiryDate ? '' : 'info-value--muted'}}">{{batch.expiryDate || '未设置'}}</text>
              </view>
            </view>

            <view class="batch-source">
              <text>{{batch.purchaserName}}</text>
              <text class="source-divider">·</text>
              <text>{{batch.supplierName}}</text>
            </view>

            <view class="batch-actions">
              <view class="detail-button" data-index="{{batchIndex}}" bindtap="toggleBatchDetail">
                {{batch.expanded ? '收起经营明细' : '查看经营明细'}}
              </view>
              <view class="edit-button" data-index="{{batchIndex}}" bindtap="openBatchEditor">修改批次</view>
            </view>

            <view class="business-detail" wx:if="{{batch.expanded}}">
              <view class="detail-metrics">
                <view><text>退货</text><text>{{batch.supplierReturnQuantityText}}{{batch.baseUom}}</text></view>
                <view><text>损耗</text><text>{{batch.lossQuantityText}}{{batch.baseUom}}</text></view>
                <view><text>报废</text><text>{{batch.discardQuantityText}}{{batch.baseUom}}</text></view>
                <view><text>当前经营结果</text><text>{{batch.currentRealizedMarginText}}</text></view>
              </view>
              <view class="conservation-warning" wx:if="{{batch.quantityConserved == null}}">数量或金额依据不足，未按0计算。</view>
              <view class="conservation-warning" wx:if="{{batch.quantityConserved === false}}">
                数量差异 {{batch.quantityConservationDelta}}，请核对历史变动
              </view>
              <view class="final-result"><text>最终经营结果</text><text>{{batch.finalMarginText}}</text></view>
              <view class="fact-section">
                <text class="fact-section-title">损耗 / 报废记录</text>
                <view class="fact-row" wx:for="{{batch.lossFacts}}" wx:key="factId" wx:for-item="fact">
                  <view class="fact-main">
                    <view class="fact-title-row">
                      <text class="fact-type">{{fact.factTypeText}} {{fact.quantityText}}{{fact.uom || batch.baseUom}}</text>
                      <text class="fact-time">{{fact.createdAt}}</text>
                    </view>
                    <text class="fact-desc">{{fact.reasonText}} · {{fact.attributionText}}</text>
                  </view>
                  <view
                    wx:if="{{fact.status === 'CONFIRMED' && fact.factType !== 'REVERSAL'}}"
                    class="reverse-button"
                    data-stock-id="{{batch.stockBatchId}}"
                    data-fact-id="{{fact.factId}}"
                    bindtap="reverseFact">冲销</view>
                </view>
                <view class="facts-empty" wx:if="{{batch.lossFacts.length === 0}}">暂无损耗或报废记录</view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="performance-entry" bindtap="toPerformance" wx:if="{{batches.length > 0}}">
        <view>
          <text class="performance-title">采购质量与经营</text>
          <text class="performance-desc">查看待处理事项与库存批次经营结果</text>
        </view>
        <text class="performance-arrow">›</text>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view class="editor-mask {{showEditSheet ? 'editor-mask--show' : ''}}" catchtouchmove="preventTouchMove" catchtap="closeBatchEditor">
    <view class="editor-sheet {{showEditSheet ? 'editor-sheet--show' : ''}}" catchtap="preventTouchMove">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view>
          <text class="sheet-title">修改批次</text>
          <text class="sheet-subtitle">批次 #{{selectedBatch.stockBatchId}}</text>
        </view>
        <view class="sheet-close" bindtap="closeBatchEditor">×</view>
      </view>

      <scroll-view class="sheet-scroll" scroll-y="true">
        <view class="sheet-section">
          <view class="section-heading">
            <view>
              <text class="section-title">盘点库存数量</text>
              <text class="section-desc">填写清点后的实际剩余数量</text>
            </view>
            <view class="current-chip">当前 {{selectedBatch.remainingQuantityText}}{{selectedBatch.baseUom}}</view>
          </view>

          <view class="quantity-input-wrap {{quantityError ? 'quantity-input-wrap--error' : ''}}">
            <input
              class="quantity-input"
              type="digit"
              value="{{actualQuantity}}"
              bindinput="onActualQuantityInput"
              placeholder="实际剩余数量" />
            <text class="quantity-unit">{{selectedBatch.baseUom}}</text>
          </view>
          <text class="field-error" wx:if="{{quantityError}}">{{quantityError}}</text>
          <view class="adjustment-preview {{canSubmitQuantity ? 'adjustment-preview--active' : ''}}">
            <text>本次减少</text>
            <text class="adjustment-value">{{adjustmentQuantityText}}{{selectedBatch.baseUom}}</text>
          </view>

          <text class="field-label">变动类型</text>
          <view class="fact-type-options">
            <view
              wx:for="{{factTypes}}"
              wx:key="code"
              class="fact-type-option {{factTypeIndex === index ? 'fact-type-option--active' : ''}}"
              data-index="{{index}}"
              bindtap="chooseFactType">
              <text class="fact-option-title">{{item.label}}</text>
              <text class="fact-option-desc">{{item.desc}}</text>
            </view>
          </view>

          <view class="picker-row">
            <text class="picker-label">原因</text>
            <picker class="picker-control" range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="onReasonChange">
              <view class="picker-value">{{reasons[reasonIndex].label}} <text>›</text></view>
            </picker>
          </view>
          <view class="picker-row">
            <text class="picker-label">责任归因</text>
            <picker class="picker-control" range="{{attributions}}" range-key="label" value="{{attributionIndex}}" bindchange="onAttributionChange">
              <view class="picker-value">{{attributions[attributionIndex].label}} <text>›</text></view>
            </picker>
          </view>
          <textarea class="note-input" value="{{note}}" bindinput="onNoteInput" placeholder="备注（可选）" maxlength="120"></textarea>

          <button
            class="save-button {{canSubmitQuantity && !saving ? '' : 'save-button--disabled'}}"
            loading="{{saving}}"
            disabled="{{!canSubmitQuantity || saving}}"
            bindtap="submitQuantityChange">确认修改库存</button>
          <text class="audit-tip">库存增加请从“采购入库”操作，批次页只处理有记录的库存减少。</text>
        </view>

        <view class="sheet-section price-section">
          <view class="section-heading">
            <view>
              <text class="section-title">调整当前售价</text>
              <text class="section-desc">不会修改原采购成本</text>
            </view>
            <view class="current-chip">当前 ¥{{selectedBatch.currentSellingPriceText}}</view>
          </view>
          <view class="quantity-input-wrap">
            <text class="currency-prefix">¥</text>
            <input class="quantity-input price-input" type="digit" value="{{newSellingPrice}}" bindinput="onPriceInput" placeholder="输入新售价" />
            <text class="quantity-unit">元/{{selectedBatch.baseUom}}</text>
          </view>
          <view class="margin-preview" wx:if="{{expectedTailMargin !== null}}">
            剩余库存预计毛利 ¥{{expectedTailMargin}}
            <text wx:if="{{belowCost}}">（低于采购成本）</text>
          </view>
          <input class="single-input" value="{{priceReason}}" bindinput="onPriceReasonInput" placeholder="调价原因" />
          <input class="single-input" value="{{priceNote}}" bindinput="onPriceNoteInput" placeholder="备注（可选）" />
          <button class="secondary-save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="submitPrice">保存新售价</button>
        </view>
        <view class="sheet-bottom-space"></view>
      </scroll-view>
    </view>
  </view>
</view>
