.page{height:100vh;background:#f4f7f6}.body{height:100%;box-sizing:border-box}.card{margin:20rpx;padding:24rpx;background:#fff;border-radius:20rpx}.title-row,.line,.form-row{display:flex;align-items:center;justify-content:space-between}.title{font-size:34rpx;font-weight:700}.section-title{font-size:30rpx;font-weight:700}.status,.link{color:#15977f}.muted{display:block;color:#7a8885;font-size:24rpx;margin:10rpx 0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:22rpx 0}.metrics view{background:#f5faf8;padding:16rpx;border-radius:12rpx}.metrics text{display:block;font-size:23rpx}.metrics .metric-value{font-size:27rpx;font-weight:700;margin-top:8rpx}.line,.form-row{padding:18rpx 0;border-bottom:1rpx solid #edf1f0}.input,.textarea{margin-top:18rpx;padding:18rpx;background:#f5f7f7;border-radius:12rpx}.textarea{width:auto;height:100rpx}.primary{margin-top:22rpx;background:#15977f;color:#fff}.history{padding:18rpx 0;border-bottom:1rpx solid #edf1f0;display:flex;justify-content:space-between;gap:10rpx}.warn{margin-top:14rpx;padding:14rpx;background:#fff2df;color:#b56c00;border-radius:10rpx}.empty{text-align:center;color:#9aa5a3;padding:30rpx}
