<back-navbar title="公告详情" avatar="/images/back-gray.png" button-text="" bindnavbuttontap="toBack"></back-navbar>

<view class="detail-page" style="padding-top: {{navBarHeight}}rpx; padding-bottom: {{announcement ? 156 : 60}}rpx;">
  <view class="loading-card" wx:if="{{loading}}">正在加载公告...</view>
  <view class="error-card" wx:elif="{{errorText}}">
    <text>{{errorText}}</text>
    <button class="retry-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{announcement}}">
    <view class="detail-card hero-card">
      <view class="hero-top">
        <text class="source-tag">{{announcement.sourceLabel}}</text>
        <text class="status-badge {{announcement.statusClass}}">{{announcement.statusLabel}}</text>
      </view>
      <text class="announcement-title">{{announcement.title}}</text>

      <view class="meta-list">
        <view class="meta-row">
          <text class="meta-label">发布人</text>
          <text class="meta-value">{{announcement.publisherLabel}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">发布时间</text>
          <text class="meta-value">{{announcement.publishedText}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">公告分类</text>
          <text class="meta-value">{{announcement.sourceLabel}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">接收范围</text>
          <text class="meta-value">{{announcement.audienceLabel}}</text>
        </view>
      </view>

      <view class="source-row" bindtap="openSource" hover-class="source-hover">
        <view class="source-main">
          <text class="source-label">关联问题</text>
          <text class="source-reference">{{announcement.sourceReference}}</text>
          <text class="source-status" wx:if="{{announcement.sourceStatusLabel}}">当前状态：{{announcement.sourceStatusLabel}}</text>
        </view>
        <text class="source-arrow">›</text>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">公告内容</text>
      <view class="content-box">{{announcement.content}}</view>
    </view>

    <view class="section-card">
      <text class="section-title">公告状态</text>
      <view class="timeline-row">
        <view class="timeline-dot {{announcement.statusClass}}"></view>
        <view class="timeline-main">
          <text class="timeline-title">{{announcement.statusLabel}}</text>
          <text class="timeline-time">最后更新 {{announcement.updatedText}}</text>
        </view>
      </view>
      <text class="status-note">公告状态只表示当前发布结果，不代表关联售后已完成。</text>
    </view>
  </block>
</view>

<view class="bottom-actions" wx:if="{{announcement}}">
  <button class="action-button source-button" bindtap="openSource">查看关联售后</button>
  <button class="action-button withdraw-button" wx:if="{{announcement.canWithdraw}}" bindtap="withdraw" loading="{{submitting}}">撤回</button>
  <button class="action-button primary-button" wx:if="{{announcement.canEdit}}" bindtap="openEditForm">{{announcement.nxDaStatus === 'PUBLISHED' ? '编辑公告' : '重新发布'}}</button>
</view>

<view class="sheet-mask" wx:if="{{showEditForm}}" bindtap="closeEditForm"></view>
<view class="edit-sheet" wx:if="{{showEditForm}}" catchtap="preventClose">
  <view class="sheet-head">
    <text class="sheet-title">编辑公告</text>
    <text class="sheet-close" bindtap="closeEditForm">×</text>
  </view>

  <text class="field-label">公告标题</text>
  <input class="field-input" value="{{editTitle}}" placeholder="请填写公告标题" maxlength="80" bindinput="onEditTitleInput"/>

  <text class="field-label">内部说明</text>
  <textarea class="field-textarea" value="{{editNote}}" placeholder="填写需要公司员工了解的内容" maxlength="1000" bindinput="onEditNoteInput"></textarea>

  <text class="field-label">谁需要看到</text>
  <view class="audience-option {{editAudienceAll ? 'selected' : ''}}" bindtap="selectAudienceAll">
    <text class="choice-mark">{{editAudienceAll ? '●' : '○'}}</text>
    <text>全公司</text>
  </view>
  <view class="role-grid">
    <view
      class="audience-option role-option {{item.selected ? 'selected' : ''}}"
      wx:for="{{roleOptions}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="toggleAudienceRole"
    >
      <text class="choice-mark">{{item.selected ? '●' : '○'}}</text>
      <text>{{item.label}}</text>
    </view>
  </view>

  <button class="save-button" bindtap="saveEdit" loading="{{submitting}}" disabled="{{submitting}}">保存公告</button>
</view>
