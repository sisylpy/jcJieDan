page {
  background: #f5f7f6;
  color: #20302a;
}

.detail-page {
  min-height: 100vh;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.loading-card,
.error-card {
  margin-top: 24rpx;
  padding: 80rpx 30rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #7d8884;
  text-align: center;
}

.error-card text {
  display: block;
}

.retry-button {
  width: 220rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #0a8a62;
  color: #fff;
  font-size: 26rpx;
}

.retry-button::after,
.action-button::after,
.save-button::after {
  border: 0;
}

.detail-card,
.section-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(32, 67, 55, 0.06);
}

.hero-card {
  border-top: 5rpx solid #8ed3b8;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.source-tag,
.status-badge {
  padding: 8rpx 15rpx;
  border-radius: 10rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.source-tag {
  background: #e8f2ff;
  color: #3978bb;
}

.status-badge {
  background: #e8f7ef;
  color: #15825e;
}

.status-badge.withdrawn {
  background: #f0f1f0;
  color: #7f8885;
}

.announcement-title {
  display: block;
  margin-top: 24rpx;
  color: #1d2c27;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.45;
}

.meta-list {
  margin-top: 24rpx;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.meta-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #87918d;
}

.meta-value {
  flex: 1;
  color: #4d5a55;
}

.source-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 0 4rpx;
  border-top: 1rpx solid #edf0ee;
}

.source-hover {
  opacity: 0.72;
}

.source-main {
  flex: 1;
  min-width: 0;
}

.source-label,
.source-reference,
.source-status {
  display: block;
}

.source-label {
  color: #8a9490;
  font-size: 23rpx;
}

.source-reference {
  margin-top: 8rpx;
  color: #2a3b35;
  font-size: 27rpx;
  font-weight: 700;
}

.source-status {
  margin-top: 5rpx;
  color: #168161;
  font-size: 23rpx;
}

.source-arrow {
  margin-left: 20rpx;
  color: #a3aca8;
  font-size: 44rpx;
}

.section-title {
  display: block;
  color: #263630;
  font-size: 31rpx;
  font-weight: 800;
}

.content-box {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f1f8f5, #f7faf8);
  color: #43524d;
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.timeline-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.timeline-dot {
  width: 17rpx;
  height: 17rpx;
  border-radius: 999rpx;
  background: #139169;
  box-shadow: 0 0 0 9rpx #e6f5ef;
}

.timeline-dot.withdrawn {
  background: #9aa29f;
  box-shadow: 0 0 0 9rpx #f0f1f0;
}

.timeline-main {
  margin-left: 25rpx;
}

.timeline-title,
.timeline-time {
  display: block;
}

.timeline-title {
  color: #2b3b35;
  font-size: 27rpx;
  font-weight: 700;
}

.timeline-time {
  margin-top: 7rpx;
  color: #8b9491;
  font-size: 23rpx;
}

.status-note {
  display: block;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0ee;
  color: #8a9490;
  font-size: 23rpx;
  line-height: 1.55;
}

.bottom-actions {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8ecea;
  background: rgba(255, 255, 255, 0.98);
}

.action-button {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.source-button {
  background: #f0f5f2;
  color: #3c554b;
}

.withdraw-button {
  border: 1rpx solid #e0aaa4;
  background: #fff;
  color: #b54840;
}

.primary-button {
  background: #098b63;
  color: #fff;
}

.sheet-mask {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 29, 24, 0.48);
}

.edit-sheet {
  position: fixed;
  z-index: 51;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  overflow-y: auto;
  padding: 28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  color: #20302a;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-close {
  width: 62rpx;
  text-align: right;
  color: #8a9490;
  font-size: 46rpx;
}

.field-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #4b5954;
  font-size: 25rpx;
  font-weight: 700;
}

.field-input,
.field-textarea {
  width: 100%;
  border: 1rpx solid #dde6e1;
  border-radius: 17rpx;
  background: #f8faf9;
  color: #263630;
  font-size: 27rpx;
  box-sizing: border-box;
}

.field-input {
  height: 82rpx;
  padding: 0 20rpx;
}

.field-textarea {
  height: 190rpx;
  padding: 18rpx 20rpx;
}

.audience-option {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e6e3;
  border-radius: 16rpx;
  color: #52605b;
  font-size: 26rpx;
  box-sizing: border-box;
}

.audience-option.selected {
  border-color: #80c6ad;
  background: #edf8f3;
  color: #087d59;
}

.choice-mark {
  margin-right: 14rpx;
}

.role-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.save-button {
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 30rpx;
  border-radius: 18rpx;
  background: #098b63;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
}
