

<view class="flex flex-column height-100">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="供货商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!-- 页面内容 -->
  <view class="content" style="margin-top: {{navBarHeight}}rpx; padding-bottom: {{tabBarHeight }}rpx;">

    <view class="flex-row-between p-20">
      <view class="flex-row">
        <view class="p-10 mainBack_new_btn" bindtap="selectAllGoods">
          {{allSelected ? '取消全选' : '全选'}}
        </view>
        <view class="p-10 text-secondary ml-10" wx:if="{{ids.length > 0}}">
          已选择 {{ids.length}} 个商品
        </view>
      </view>
      <view class="p-10 mainBack_new_btn" bindtap="choiceGoods">确认删除</view>
    </view>

   
    <view class="main" >
      <scroll-view class="left-menu" scroll-y="true" style="height: {{contentHeight}}rpx; width: {{leftMenuWidth}}rpx;">
        <block wx:for="{{grandList}}" wx:key="nxDistributerFatherGoodsId" wx:for-index="grandIndex">
          <view class="category-item {{leftGreatId === item.nxDistributerFatherGoodsId ? 'active' : ''}}" bindtap="changeGreatGrand" data-id="{{item.nxDistributerFatherGoodsId}}" data-index="{{grandIndex}}" data-name="{{item.nxDfgFatherGoodsName}}">
            <text class="">{{item.nxDfgFatherGoodsName}}</text>
          </view>
        </block>
      </scroll-view>

      <view class="flex-1" style="height: {{contentHeight}}rpx;">
        


        <scroll-view class=" bg-white " scroll-y="true" style="height: {{contentHeight}}rpx;" scroll-top="{{toTop}}" bindscrolltolower="onScrollToLower">

          <view class="flex flex-column p-10 border-bottom" wx:for="{{goodsList}}" wx:for-item="sons" wx:key="nxDistributerGoodsId" wx:for-index="goodsIndex" id="NAV{{sons.nxDgNxGrandId}}">
            <view class="flex-row-default">
            <view class=" flex-column mr-10" bindtap="toEditGoodsImage" data-goods="{{sons}}" data-item="{{sons.nxGoodsEntity}}" data-index="{{goodsIndex}}">
             
              <image class="" src="{{url + sons.nxDgGoodsFileLarge}}" mode="aspectFill" class="goods_item_lg" />
            </view>

            <view class="flex-column font-sm width-100">
              <view class="flex-row-between "  data-id="{{sons.nxDistributerGoodsId}}" data-name="{{sons.nxDgGoodsName}}" data-item="{{sons}}" data-index="{{goodsIndex}}" hover-class="hover" bindtap="choiceGoods"  >
                <view class="flex-row-wrap">
                  <text class=" {{sons.nxDgGoodsBrand !== null && sons.nxDgGoodsBrand.length > 0 ? 'brand' : ''}}">{{sons.nxDgGoodsBrand !== null && sons.nxDgGoodsBrand.length > 0 ? sons.nxDgGoodsBrand : ''}}</text>
                  <text class="font-md">{{sons.nxDgGoodsName}}</text>
                  <text class="">{{sons.nxDgGoodsDetail !== null ? sons.nxDgGoodsDetail : ''}}</text>
                  <block wx:if="{{sons.nxDistributerAliasEntities.length > 0}}">
                    <text wx:for="{{sons.nxDistributerAliasEntities}}" wx:for-item="alias">@{{alias.nxDaAliasName}}</text>
                  </block>
                
                 
                </view>
                <view>
                  <view class="flex-column">
                    <checkbox 
                      checked="{{sons.selected}}" 
                      catchtap="selectGoods" 
                      data-id="{{sons.nxDistributerGoodsId}}" 
                      data-item="{{sons}}" 
                      data-index="{{goodsIndex}}"
                    />
                  </view>            
                </view>
              </view>

              <view class="flex-row">
                <view class="flex-row half-row">
                  <text class="text-secondary">规格:</text>
                  <block wx:if="{{sons.nxDgGoodsStandardWeight !== 'null' && sons.nxDgGoodsStandardWeight.length > 0}}">
                    <text class="font-xs">{{sons.nxDgGoodsStandardWeight}}/{{sons.nxDgGoodsStandardname}}</text>
                  </block>
                  <block wx:else>
                    <text>{{sons.nxDgGoodsStandardname}}</text>
                  </block>
                </view>

              </view>
              <view class="flex-row-default">
                <text class="text-secondary flex-fixed">订货规格:</text>
                <view class="flex-row-wrap">
                  <text class="standard mr-10">{{sons.nxDgGoodsStandardname}}</text>
                  <text class="standard mr-10" wx:for="{{sons.nxDistributerStandardEntities}}" wx:for-item="standard">{{standard.nxDsStandardName}}</text>
                </view>

              </view>
              
              

            </view>
          </view>

       
          </view>

          <view class="text-center text-secondary" wx:if="{{totalPage == currentPage  }}">
            "{{greatName}}"共{{goodsList.length}}个商品
          </view>
        </scroll-view>

      </view>

    </view>

  </view>
</view>



<!-- goodsType -->
<view class='overlay {{showOperationGoods ? "show" : ""}}' catchtouchmove='ture' catchtap="hideMask">
  <view class="flex-column nnn bg-white font-lg" wx:if="{{chooseSize}}" animation='{{animationData}}'>

    <view class="flex-row p-30 border-bottom" bindtap="getGoodsType" data-type="99">
      <image src="../../images/edit.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation {{goodsType == '99' ? 'mainColor' : ''}} ">全部商品</text>
    </view>

    <view class="flex-row p-30 border-bottom" bindtap="getGoodsType" data-type="-1">
      <image src="../../images/edit.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation {{goodsType == '-1' ? 'mainColor' : ''}} ">出库商品</text>
    </view>

    <view class="flex-row p-30 border-bottom" bindtap="getGoodsType" data-type="1">
      <image src="../../images/edit.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation {{goodsType == '1' ? 'mainColor' : ''}} ">采购商品</text>
    </view>


    <view style="height: 20rpx;"></view>

  </view>
</view>

<goodsWillPirce show="{{showIsPurchase}}"   bindconfirm="confirm" level="{{level}}" bindcancle="cancleIsPurchase"  item="{{item}}" consultItem="{{consultItem}}"  binddelPrice="delPrice" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}"  />

