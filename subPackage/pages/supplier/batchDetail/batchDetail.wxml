<wxs src="../../../../utils/fn.wxs" module="tool" />

  <view class="flex-column flex">


    <back-navbar style="height: {{navBarHeight}}rpx;" title="账单" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

    <view class="p-10" >
      <view class="body " style="height:{{windowHeight - navBarHeight - 40}}rpx;">

        <!-- top -->
        <view class="flex-row with-tb-padding">
          <view class="flex-column-center third-row">
            <image src="{{url + batch.nxJrdhBuyerEntity.nxJrdhWxAvartraUrl}}"  class="face_img">
            </image>
            <view class="extreamSmall username">{{tool.getAttrName(batch.nxJrdhBuyerEntity.nxJrdhWxNickName)}}</view>
          </view>

          <view class="flex-column-center third-row">
            <image src="../../../../images/order_icon.png" class="icon"></image>
            <view class="middle flex-row">
             
            </view>
          </view>

          <view class="flex-column-center third-row">
            <block wx:if="{{batch.nxJrdhSellerEntity !== null}}">
              <image src="{{url + batch.nxJrdhSellerEntity.nxJrdhWxAvartraUrl}}" class="face_img"> </image>
            </block>
            <block wx:else>
              <image src="../../images/logo.jpg" class="face_img"> </image>
            </block>
            <view class="extreamSmall username">{{tool.getAttrName(batch.nxJrdhSellerEntity.nxJrdhWxNickName)}}</view>
          </view>
        </view>

        <!--  -->
        <view class="flex-column form_body bg-white" style="height:{{windowHeight   - navBarHeight - 280  }}rpx;  ">
          <!-- <view class="flex-row small p-20 with-dashed-bottom">
            <view class="" style="width:{{(windowWidth - 100 ) / 10 * 3 - 60 }}rpx;mr-20:20rpx; margin-left: 20rpx;">
              <text>商品</text>
            </view>
            <view class="  " style="width:{{(windowWidth - 100 ) / 10 * 2}}rpx;margin-left: 60rpx;">
              <text>订货</text>
            </view>
            <view class="" style="width:{{(windowWidth - 100 ) / 10 * 3}}rpx;">
              <text>数量</text>
            </view>
            <view class="" style="width:{{(windowWidth - 100 ) / 10 * 2}}rpx;">
              <text>小计</text>
            </view>
          </view> -->
          <scroll-view class="tui-city-scroll-y" scroll-y="true" style="height: {{windowHeight   - navBarHeight - 280}}rpx; ">
            <view class="flex-cloumn with-dashed-bottom p-20" wx:for="{{batch.nxDPGEntities}}" wx:key="nxDistributerPurchaseBatchId">
              <view class=" flex-row " style="width:{{windowWidth - 120}}rpx; " >
                <view class="flex-row-default ">
                  <text class="mr-10">{{index + 1}}.</text>
                  <view class="flex-row" style="width:{{(windowWidth - 140 ) / 10 * 3 }}rpx;">
                    <text> {{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                  </view>
                  
                </view>
                
              </view>
              <view class="flex-row with-tbl-padding middle">
              <text class="white">{{index + 1}}.</text>
              <view class="flex-column">
                <view class="flex-row small" style="width: {{windowWidth - 80}}rpx;">
                  <view class="third-row flex-row">
                    <text class="">单价:</text>
                    <block
                      wx:if="{{item.nxDpgStandard !==  item.nxDistributerGoodsEntity.nxDgGoodsStandardname  && item.nxDpgBuyScale !== '-1' && item.nxDpgStandard !== null}}">
                      <text>{{item.nxDpgBuyScalePrice}}元/{{item.nxDpgStandard}}</text>
                    </block>
                    <block wx:else>
                      <text>{{item.nxDpgBuyPrice}}元/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                    </block>
                  </view>

                  <view class="third-row flex-row">
                    <text class="">总数:</text>
                    <block
                      wx:if="{{item.nxDpgStandard !==  item.nxDistributerGoodsEntity.nxDgGoodsStandardname  && item.nxDpgBuyScale !== '-1' && item.nxDpgStandard !== null}}">
                      <text>{{item.nxDpgBuyScaleQuantity}}{{item.nxDpgStandard}}</text>
                    </block>
                    <block wx:else>
                      <text>{{item.nxDpgBuyQuantity}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                    </block>
                  </view>
                  <view class="third-row flex-row">
                    <text class="">小计:</text>
                    <text>{{item.nxDpgBuySubtotal}}元</text>
                  </view>
                </view>

                <view
                  class="flex-column middle text-secondary with-tbl-padding  border-bottom {{orderIndex + 1 == item.nxDepartmentOrdersEntities.length ? 'is-last' : ''}}"
                  wx:for="{{item.nxDepartmentOrdersEntities}}" wx:for-item="orders" wx:for-index="orderIndex"
                  bindtap="inputGoods" data-index="{{index}}" data-orderindex="{{orderIndex}}" data-item="{{item}}"
                  hover-class="hover" data-orders="{{orders}}">
                  <block wx:if="{{orders.nxDoStatus == 2}}">
                    <view class="flex-column ">
                      <view class="flex-row">
                        <view class="">
                          <block wx:if="{{orders.nxDepartmentEntity.fatherGbDepartmentEntity !== null}}">
                            <text>{{orders.nxDepartmentEntity.fatherGbDepartmentEntity.nxDepartmentName}}.</text>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                          <block wx:else>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                        </view>
                      </view>
                      <view class="flex-row" style="width: {{windowWidth - 40}}rpx; ">
                        <view class="third-row">
                          <text class="mr-10 ">订货:</text>
                          <text>{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>
                          <block
                            wx:if="{{orders.nxDoDsStandardScale !== null && orders.nxDoDsStandardScale.length > 0 && orders.nxDoDsStandardScale !== '-1'}}">
                            <text
                              class="">({{orders.nxDoDsStandardScale}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{orders.nxDoStandard}})</text>
                          </block>
                        </view>
                        <view class="third-row">
                          <text class="mr-10">数量:</text>
                          <text class="">{{orders.nxDoWeight !== null ? orders.nxDoWeight :
                            ''}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>

                        </view>
                        <view class=" third-row">
                          <text wx:if="{{orders.nxDoSubtotal !== null}}">¥{{orders.nxDoSubtotal}}</text>
                        </view>
                      </view>
                    </view>
                  </block>

                  <block wx:elif="{{orders.nxDoStatus == 3}}">
                    <view class="flex-column">
                      <view class="flex-row middle">
                        <view class="">
                          <block wx:if="{{orders.nxDepartmentEntity.fatherGbDepartmentEntity !== null}}">
                            <text>{{orders.nxDepartmentEntity.fatherGbDepartmentEntity.nxDepartmentName}}.</text>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                          <block wx:else>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                        </view>
                      </view>
                      <view class="flex-row">
                        <view class="flex-row normal" style="width: {{windowWidth - 40}}rpx; ">
                          <view class="third-row">
                            <text class="mr-10 ">订货:</text>
                            <text>{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>
                            <block
                              wx:if="{{orders.nxDoDsStandardScale !== null && orders.nxDoDsStandardScale.length > 0 && orders.nxDoDsStandardScale !== '-1'}}">
                              <text
                                class="">({{orders.nxDoDsStandardScale}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{orders.nxDoStandard}})</text>
                            </block>
                          </view>
                          <view class="third-row">
                            <text class="mr-10">数量:</text>
                            <text class="">{{orders.nxDoWeight !== null ? orders.nxDoWeight :
                              ''}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>

                          </view>
                          <view class=" third-row">
                            <text wx:if="{{orders.nxDoSubtotal !== null}}">¥{{orders.nxDoSubtotal}}</text>
                          </view>
                        </view>
                      </view>
                    </view>

                  </block>

                  <block wx:elif="{{orders.nxDoStatus == 4}}">
                    <view class="flex-column">
                      <view class="flex-row middle">
                        <view class="">
                          <block wx:if="{{orders.nxDepartmentEntity.fatherGbDepartmentEntity !== null}}">
                            <text>{{orders.nxDepartmentEntity.fatherGbDepartmentEntity.nxDepartmentName}}.</text>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                          <block wx:else>
                            <text class="mr-10">{{orders.nxDepartmentEntity.nxDepartmentName}}</text>
                          </block>
                        </view>
                      </view>
                      <view class="flex-row">
                        <view class="flex-row " style="width: {{windowWidth - 40}}rpx;">
                          <view class="third-row">
                            <text class="mr-10 ">{{order.nxDoOrderType == 7 ? '退货:' : '订货:'}}</text>
                            <text>{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>
                            <block
                              wx:if="{{orders.nxDoDsStandardScale !== null && orders.nxDoDsStandardScale.length > 0 && orders.nxDoDsStandardScale !== '-1'}}">
                              <text
                                class="">({{orders.nxDoDsStandardScale}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{orders.nxDoStandard}})</text>
                            </block>
                          </view>
                          <view class="third-row">
                            <text class="mr-10">数量:</text>
                            <block
                              wx:if="{{orders.nxDoDsStandardScale !== null && orders.nxDoDsStandardScale.length > 0 && orders.nxDoDsStandardScale !== '-1'}}">

                              <text class="">{{orders.nxDoScaleWeight !== null ? orders.nxDoScaleWeight :
                                ''}}{{orders.nxDoStandard}}</text>
                              <text class="">({{orders.nxDoWeight !== null ? orders.nxDoWeight :
                                ''}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                            </block>
                            <block wx:else>

                              <text class="">{{orders.nxDoWeight !== null ? orders.nxDoWeight :
                                ''}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                            </block>



                          </view>
                          <view class=" third-row">
                            <!-- <text class="mr-10">小计:</text> -->
                            <text wx:if="{{orders.nxDoSubtotal !== null}}">¥{{orders.nxDoSubtotal}}</text>
                          </view>
                        </view>
                      </view>
                    </view>

                  </block>


                </view>

              </view>
            </view>
            </view>
          </scroll-view>
        </view>

        <view class="flex-column   darktext-secondary">
          <view class="flex-row with-tbl-padding">
            <view class="flex-row half-row small">
              <text class="mr-10">订货时间:</text>
              <text>{{tool.getAttrDate(batch.nxDpbDate)}} {{batch.nxDpbTime}}</text>
            </view>

            <view class="flex-row half-row">
              <text class="mr-10">供货商品:</text>
              <text>{{batch.nxDPGEntities.length}}个</text>
            </view>
          </view>
        </view>

        <block wx:if="{{batchStatus == 1}}">
          <view class="flex-row-between p-20">
            <view class="finish_btn" style="width: {{windowWidth/ 3}}rpx; margin-top: 20rpx;" bindtap="toTxsIndexReceive" data-item="{{batch}}">确认收货</view>
            <view class="flex-row-reverse" style="width: {{windowWidth/ 3}}rpx; margin-top: 20rpx;">
              <text class="big mainColor">总计:{{batch.nxDpbSellSubtotal}}元</text>
            </view>
          </view>
        </block>

        <block wx:if="{{batchStatus == 2}}">
          <view class="flex-reverse" style="height: 100rpx; line-height: 100rpx; width: {{windowWidth - 80}}rpx;">
            <text class="big mainColor">总计:{{batch.nxDpbSellSubtotal}}元</text>
            <text class="small text-secondary mr-10">(待付款)</text>
          </view>
        </block>
        <block wx:if="{{batchStatus == 3}}">
          <view class="flex-row-between " style="height: 100rpx; line-height: 100rpx; width: {{windowWidth - 80}}rpx;">
            <text class="small text-secondary">付款时间: {{tool.getAttrTime(batch.nxDpbPayFullTime)}}</text>
            <block wx:if="{{batchStatus == 1}}">
                <text class="">待收货</text>
              </block>
              <block wx:if="{{batchStatus == 2}}">
                <text class="">未付款</text>
              </block>
              <block wx:if="{{batchStatus == 3}}">
                <text class="">完成付款</text>
              </block>
            <text class="big">总计:{{batch.nxDpbSellSubtotal}}元</text>
          </view>
        </block>
      </view>
    </view>

  </view>


