


  <back-navbar style="height: {{navBarHeight}}rpx;" title="调整货架顺序" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  
<view class="top_back flex-row" hidden="{{hide}}" style="padding-top: {{statusBarHeight}}rpx;">
    <image src="../../../../images/back.png" class="back_icon" bindtap="toBack"></image>
    <view class="flex-column">
      <text class="top_bar_title">{{goodsItem.nxDgGoodsName}}</text>
    </view>
  </view>


 <view style="height:110rpx; margin-top:{{100 + statusBarHeight}}rpx;">
  <view class="flex-row-between border-bottom p-20">
    <text></text>
    <!-- <view class="flex-row" bindtap="addSupplier" hover-class="hover">
      <image src="../../../../images/add-3.png" class="icon mr-10" />
      <text class="small ">新供货商</text>
    </view> -->
  </view>
  <view class="flex-column-center p-20 text-secondary">
    <text>显示注册成功的供货商</text>    
  </view>
  <view class="emptyView {{supplierArr.length == 0 ? 'is-actvie' : ''}}" style="height:110rpx; margin-top:{{100 + statusBarHeight}}rpx;">
    <view class="normal  empty_view">
      <view class="flex-column-center">
        <image class="empty_image" src="../../../../images/paste.png"></image>
        <text class="big">暂时无订货供货商</text>
        <text class="small darktext-secondary with-tb-padding">这里只显示配送到货</text>
      </view>
    </view>
  </view>
<view class="flex-row-between p-20 border-bottom bg-white normal" wx:for="{{supplierArr}}" wx:for-item="item"  bindtap="buyerCheckUnPay" data-id="{{item.nxJrdhUserId}}" data-name="{{item.nxJrdhWxNickName}}" data-item="{{item}}" hover-class="hover">
  
  <view class="flex-row-default" style="width: {{windowWidth - 300}}rpx;">
      <view class="flex-row">
        <text class="mr-20">{{index + 1}}.</text>
      </view>
      <image src="{{item.jrdhUserEntity.nxJrdhWxNickName !== null ? url + item.jrdhUserEntity.nxJrdhWxAvartraUrl : '/images/logo.jpg' }}" class="url mr-20"></image>
      <view class="flex-column ">
      <text class="small  text-secondary">{{item.jrdhUserEntity.nxJrdhWxNickName !== null ? item.nxJrdhsSupplierName : '没有认证'}}</text>
          <text> {{item.jrdhUserEntity.nxJrdhWxNickName}}</text>
        </view>
        
    </view>

    <view class="" bindtap="choiceSupplier" data-item="{{item}}"  wx:if="{{item.jrdhUserEntity !== null}}">
      <text class="mainBack_new_btn " >选择</text>
    </view>
    <view wx:else="">
      <view class=" p-20  flex-row mainBack_new_btn" bindtap="toMyJinridinghuo">
      <image src="../../../../images/person.png" class="icon mr-10"></image>
      <text class="small text-secondary">邀请注册</text>
    </view>
    </view>
    
  
</view>

</view>
