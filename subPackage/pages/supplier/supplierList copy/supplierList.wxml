</view>


<view class='overlay {{showOperation ? "show" : ""}}' catchtouchmove='ture' catchtap="hideMask" style="height:{{maskHeight > windowHeight ? maskHeight + 200 : windowHeight  + 200}}rpx;">
  <view class="flex-column nnn bg-white" wx:if="{{chooseSize}}" animation='{{animationData}}'>

    <view class="p-30  flex-row border-bottom" bindtap="buyerCheckUnPay">
      <image src="../../../../images/loanManage.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation">查询账单</text>
    </view>
    <view class="p-30  flex-row border-bottom" bindtap="toSupplierGoods"  wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}">
			<image src="../../../../images/To_Do.png" class="icon mr-20 ml-20"></image>
			<text class="text_operation">订货商品</text>
		</view>
    <view class="p-30  flex-row border-bottom" bindtap="edit">
			<image src="../../../../images/edit.png" class="icon mr-20 ml-20"></image>
			<text class="text_operation">修改订货商名称</text>
		</view>
    <view class="p-30  flex-row border-bottom" bindtap="deleteSuppler">
      <image src="../../../../images/del.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation">删除订货商</text>
    </view>

    <view class="p-20  flex-row" bindtap="toMyJinridinghuo"   wx:if="{{disInfo.nxDistributerBusinessTypeId > 2}}">
      <image src="../../../../images/wx.png" class="icon mr-20 ml-20"></image>
      <text class="text_operation">邀请注册</text>
    </view>

    <view style="height: 20rpx;"></view>



  </view>
</view>


<view class='overlay {{deleteShow ? "show" : ""}}' catchtap="hideChoiceMask" >
  <view class="popup bg-white" >
    <view class="flex-cloumn">
      <view class="weight_five  p-20 mainBack" style="text-align: center;">
        <view class="p-20 font-md">删除供货商</view>
      </view>
      <view class="flex-row p-20 font-xl">
        <view class="text-center p-30">{{supplierItem.nxJrdhsSupplierName}}</view>
      </view>
    </view>

    <view class="flex-row-between p-30">
      <view class="p-20 third-row  font-md text-center hover" bindtap="deleteNo" hover-class="hover" >取消</view>
      <view class="p-20 third-row  font-md text-center bg-success" bindtap="deleteYes" hover-class="hover">确定</view>
    </view>
  </view>
  
</view>