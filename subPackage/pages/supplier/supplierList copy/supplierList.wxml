      </view>

        <view class="flex-column" style="width: {{windowWidth - 240}}rpx;">
          <view class="five-weight">{{supplier.nxJrdhsSupplierName}}</view>
          <view class="font-xs">{{supplier.jrdhUserEntity.nxJrdhWxNickName}}</view>
        </view>
    </view>
    
  </view>

