      <image src="../../../../images/add-bold-2.png" class="icon m-10" />
      <text class="font-sl">添加供货商</text>
    </view>
  </view>

  <view class="{{arr.length == 0 ? 'show' : 'hide'}}" >
    <view class="font-lg " style="margin-top: {{navBarHeight * 2}}rpx;">
      <view class=" center-content flex-column">
        <image class="empty_image" src="../../../../images/paste.png"></image>
        <text class="big">暂时无订货订货商</text>
        <text class="font-sl  text-secondary p-20">这里只显示配送到货</text>
      </view>
    </view>
  </view>

<block wx:if="{{arr.length > 0}}">
  <view class="flex-row-between bg-white p-20 font-lg border-bottom"  wx:for="{{arr}}" wx:for-item="supplier" wx:key="nxJrdhSupplierId">

