<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="">

  <view wx:if="{{restrauntArr.length > 0}}">

    <map id="myMap" class="map" latitude="{{latitude}}" longitude="{{longitude}}" bindmarkertap="onMarkerTap"
      bindcallouttap="onCalloutTap" bindlabeltap="onLabelTap" markers="{{markers}}" scale="{{scale}}"></map>


    <view class="flex-column  whiteBack">

      <view class="flex-row with-padding normal" wx:for="{{restrauntArr}}" wx:key="nxRestrauntId" wx:for-item="res"
        wx:for-index="resIndex" bindlongpress="cancelDelivery" data-id="{{res.nxRestrauntId}}">
        <view class="flex-column ">
          <view class="flex-row-between" style="width: {{windowWidth - 40}}rpx; ">
            <view class="flex-row">
              <text class="bigYellow">{{res.duration}}分钟</text>
            </view>
            <view class="flex-row middleSmall red">
              <text class="margin-l-right five-weight middle">{{res.nxRestrauntDeliveryBoxNumber}}</text>
              <image src="../../../images/wupin.png" class="iconsmall margin-l-right"></image>
              <text wx:if="{{res.nxRestrauntWorkingStatus == 2}}">等待配送</text>
              <text wx:elif="{{res.nxRestrauntWorkingStatus == 3}}">待支付</text>
            </view>
          </view>
          <view class="flex-row" style="width: {{windowWidth - 40}}rpx;">
            <view class="left-row" style="width: 100rpx; ">
              <view class="flex-column">
                <view class="flex-column">
                  <text>{{tool.getGongli(res.distance,1)}}</text>
                  <text class="extremeSmall gray">km</text>
                </view>
              </view>
            </view>
            <view class="right-row flex-column with-border-bottom with-padding"
              style="width: {{windowWidth - 140}}rpx;">
              <view class="flex-row-between">
                <view>
                  <text class="superBig five-weight">{{res.nxRestrauntAttrName}}</text>
                </view>
                <view class="flex-column">
                  <text class="gray small">{{res.nxRestrauntMinTime}}至</text>
                  <text class="gray small">{{res.nxRestrauntMaxTime}}</text>
                </view>
              </view>
              <view>
                <text class="small gray ">{{res.nxRestrauntAddress}}</text>
              </view>
            </view>
          </view>




        </view>
      </view>
    </view>
  </view>

    <view class="emptyView"  wx:else	style="height: {{windowHeight - 360}}rpx; text-align:center;">
			<view class="normal  empty_view">
				<view class="flex-column-center">
					<image class="empty_image" src="../../../images/file-common.png"></image>
					<text class="big">暂时配送客户</text>
					<text class="small darkgray with-tb-padding">这里显示待配送的客户</text>
				</view>
			</view>
		</view>



</view>