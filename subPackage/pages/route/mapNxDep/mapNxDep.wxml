  <view wx:if="{{restrauntArr.length> 0}}">
    <map id="myMap" class="map" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}"
      scale="{{scale}}"></map>

    <view class="flex-column  whiteBack">
         <text>latitude:{{latitude}}{{longitude}}</text>
      <checkbox-group bindchange="checkboxChange">
        <checkbox class="flex-row check_row with-border-bottom with-padding normal" wx:for="{{restrauntArr}}"
          wx:for-item="res" wx:for-index="resIndex" value='{{res.nxDepartmentId}}' checked="{{bbb}}">
          <view class="flex-column p-20 ">
            <text class="font-lg"> {{res.nxDepartmentPickName}} {{res.nxDepartmentAttrName}}</text>
            <text class="small ">{{res.nxDepartment}}</text>
          </view>
        </checkbox>ß
      </checkbox-group>
    </view>

    <view class="bottom_btn show " bindtap="toDriver">
