.settings-page {
  min-height: 100vh;
  background: #f3f6f5;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.plan-summary {
  min-height: 92rpx;
  margin: 20rpx 20rpx 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dcefe8;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #ecfaf4, #ffffff);
}

.plan-label {
  display: block;
  color: #788a83;
  font-size: 21rpx;
}

.plan-name {
  display: block;
  margin-top: 5rpx;
  color: #087f5b;
  font-size: 29rpx;
  font-weight: 800;
}

.plan-status {
  padding: 8rpx 16rpx;
  border-radius: 99rpx;
  background: #dff5eb;
  color: #078654;
  font-size: 22rpx;
  font-weight: 700;
}

.usage-summary {
  margin: 14rpx 20rpx 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dfe9e5;
  border-radius: 20rpx;
  background: #fff;
}

.usage-summary-low {
  border-color: #efc999;
  background: #fffaf2;
}

.usage-summary-main {
  flex: none;
}

.usage-summary-label {
  display: block;
  color: #73837d;
  font-size: 22rpx;
}

.usage-summary-number {
  color: #087f5b;
  font-size: 38rpx;
  font-weight: 900;
}

.usage-summary-low .usage-summary-number {
  color: #c87718;
}

.usage-summary-unit {
  color: #53645e;
  font-size: 22rpx;
}

.usage-summary-detail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #7b8984;
  font-size: 21rpx;
  line-height: 1.55;
}

.usage-summary-link {
  margin-top: 3rpx;
  color: #0a8d68;
  font-weight: 700;
}

.quick-grid,
.business-section {
  margin: 20rpx;
  background: #fff;
  border: 1rpx solid #edf1ef;
  border-radius: 24rpx;
  /* box-shadow: 0 8rpx 24rpx rgba(24, 68, 53, 0.045); */
}

.quick-grid {
  display: grid;
  /* 每行 4 个按钮，平均分成 4 等份 */
  grid-template-columns: repeat(4, 1fr);
  padding: 18rpx 6rpx;
}

.quick-item {
  min-width: 0;
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.usage-purchase-item {
  grid-column: 4;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.quick-item text {
  max-width: 146rpx;
  color: #65716c;
  font-size: 24rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.business-section {
  padding: 22rpx 18rpx 18rpx;
}

.business-heading {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.heading-copy {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.heading-mark {
  width: 7rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: #12987c;
}

.heading-title {
  color: #172a24;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.heading-subtitle {
  margin-left: 24rpx;
  color: #8a9490;
  font-size: 22rpx;
}

.heading-link {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #168f78;
  font-size: 23rpx;
  font-weight: 650;
}

.business-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.two-column-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.business-tile {
  position: relative;
  min-width: 0;
  /* 正方形：边长 = 4 列网格单元宽度 (750-40-2-36-3*12)/4 ≈ 159rpx */
  height: 159rpx;
  min-height: 159rpx;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(22, 143, 120, 0.08);
  border-radius: 19rpx;
  background: linear-gradient(145deg, #f1faf7, #fbfdfc);
}

.horizontal-tile {
  height: auto;
  min-height: 122rpx;
  padding: 20rpx 24rpx;
  flex-direction: row;
  justify-content: flex-start;
}

.horizontal-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.business-icon-box {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  /* background: rgba(255, 255, 255, 0.72); */
}

.horizontal-tile .business-icon-box {
  width: 120rpx;
  height: 120rpx;
}

.business-icon {
  width: 80rpx;
  height: 80rpx;
  /* object-fit: contain; */
}

.business-letter {
  color: #0b9270;
  font-size: 34rpx;
  font-weight: 850;
}

.business-title {
  display: block;
  max-width: 100%;
  margin-top: 5rpx;
  color: #1a2d27;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.18;
  text-align: center;
  word-break: break-all;
}

.business-desc {
  display: block;
  max-width: 100%;
  margin-top: 2rpx;
  color: #7e8984;
  font-size: 19rpx;
  line-height: 1.28;
  text-align: center;
}

.horizontal-tile .business-title,
.horizontal-tile .business-desc {
  margin-top: 0;
  text-align: left;
}

.horizontal-tile .business-desc {
  margin-top: 6rpx;
}

.tone-green,
.tone-mint {
  background: linear-gradient(145deg, #edf9f5, #fbfdfc);
  border-color: #dcefe8;
}

.tone-blue {
  background: linear-gradient(145deg, #edf7ff, #fbfdff);
  border-color: #dceaf7;
}

.tone-orange {
  background: linear-gradient(145deg, #fff5e9, #fffdf9);
  border-color: #f5e4ce;
}

.tone-red {
  background: linear-gradient(145deg, #fff0f1, #fffafa);
  border-color: #f5dfe1;
}

.tone-amber {
  background: linear-gradient(145deg, #fff8e8, #fffdf7);
  border-color: #f4e6c8;
}

.tone-purple {
  background: linear-gradient(145deg, #f5f0ff, #fcfbff);
  border-color: #e8ddfa;
}

.tone-blue .business-letter { color: #337fe5; }
.tone-orange .business-letter { color: #f28c28; }
.tone-red .business-letter { color: #e84c57; }
.tone-purple .business-letter { color: #7553df; }

.pending-badge {
  position: absolute;
  top: -8rpx;
  right: -5rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  border-radius: 18rpx;
  background: #f13f3f;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
}

.logout-button {
  height: 86rpx;
  margin: 30rpx 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #efcfcb;
  border-radius: 20rpx;
  background: #fff;
  color: #cf433a;
  font-size: 28rpx;
}

.version-footer {
  height: 142rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a1aaa6;
  font-size: 23rpx;
}

.hover {
  opacity: 0.7;
  transform: scale(0.985);
}
