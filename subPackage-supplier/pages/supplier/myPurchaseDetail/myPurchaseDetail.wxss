page, .page { min-height: 100%; background: #f5f6f8; }
.content { box-sizing: border-box; padding: 20rpx; }
.summary-card, .goods-card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.summary-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; color: #222; }
.summary-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 12rpx 0; color: #666; font-size: 27rpx; }
.summary-row text:last-child { color: #222; text-align: right; }
.summary-row .status { color: #176b5d; }
.summary-row.total { margin-top: 12rpx; padding-top: 22rpx; border-top: 1rpx solid #eee; font-size: 31rpx; font-weight: 600; }
.summary-row.total text:last-child { color: #d4493d; }
.goods-head, .goods-info, .order-row { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; }
.goods-name { font-size: 30rpx; font-weight: 600; color: #222; }
.goods-subtotal { color: #d4493d; font-size: 30rpx; font-weight: 600; }
.goods-info { color: #666; font-size: 26rpx; padding: 18rpx 0; }
.order-list { border-top: 1rpx solid #eee; padding-top: 12rpx; }
.order-row { color: #777; font-size: 24rpx; padding: 8rpx 0; }
.empty { text-align: center; color: #999; padding: 100rpx 0; }
.bottom-space { height: 80rpx; }
