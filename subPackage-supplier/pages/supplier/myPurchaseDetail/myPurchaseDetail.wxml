<view class="page">
  <back-navbar title="订货明细" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view wx:if="{{batch}}" scroll-y class="content" style="height: {{windowHeight - navBarHeight}}rpx;">
    <view class="summary-card">
      <view class="summary-title">采购批次 #{{batch.nxDistributerPurchaseBatchId}}</view>
      <view class="summary-row"><text>日期</text><text>{{batch.nxDpbDate}} {{batch.nxDpbTime}}</text></view>
      <view class="summary-row"><text>供货商</text><text>{{batch.nxJrdhSupplierEntity.nxJrdhsSupplierName || batch.nxJrdhSellerEntity.nxJrdhWxNickName || '微信供货商'}}</text></view>
      <view class="summary-row"><text>支付方式</text><text>{{batch.nxDpbPayType == 0 ? '现金' : '记账'}}</text></view>
      <view class="summary-row"><text>状态</text><text class="status">{{batch.nxDpbStatus == 3 ? '已结账' : (batch.nxDpbStatus == 2 ? '待结账' : '处理中')}}</text></view>
      <view class="summary-row total"><text>订货总额</text><text>¥{{batch.nxDpbSellSubtotal || '0.0'}}</text></view>
    </view>

    <view class="goods-card" wx:for="{{goodsArr}}" wx:key="nxDistributerPurchaseGoodsId">
      <view class="goods-head">
        <text class="goods-name">{{index + 1}}. {{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
        <text class="goods-subtotal">¥{{item.nxDpgBuySubtotal || '0.0'}}</text>
      </view>
      <view class="goods-info">
        <text>{{item.nxDpgBuyQuantity || '-'}} {{item.nxDpgStandard || item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
        <text>¥{{item.nxDpgBuyPrice || '-'}} / {{item.nxDpgStandard || item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
      </view>
      <view class="order-list" wx:if="{{item.nxDistributerGoodsEntity.nxDepartmentOrdersEntities.length}}">
        <view class="order-row" wx:for="{{item.nxDistributerGoodsEntity.nxDepartmentOrdersEntities}}" wx:for-item="order" wx:key="nxDepartmentOrdersId">
          <text>{{order.nxDepartmentEntity.nxDepartmentName || '客户订单'}}</text>
          <text>{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{goodsArr.length == 0}}">该批次没有商品明细</view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
