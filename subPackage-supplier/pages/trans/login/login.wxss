
page{
  background-color: #fff;
}



.avatar-preview-wrap {
  margin-top: 20rpx;
  font-size: 34rpx;
  color: #666;
  display: flex;
  align-items: center;
}
.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  object-fit: cover;
}

.container{
  padding: 50rpx 30rpx;
}


.input{
  height: 90rpx;
  margin-left: 16rpx;
}


.inputHalf{
  height: 90rpx;
  margin-left: 16rpx;
}




.word{
  font-size: 50rpx;
  line-height: 100rpx;
  /* margin-bottom: 20rpx; */

 
}

.what{
 
  border-radius: 10rpx;
  border: 1px solid gray;
}

.reg_btn{
 
  margin-bottom: 40rpx;
  margin-top: 40rpx;
 
}

.reg_btn button{
  /* color: #fff; */
  border: none;
  border: 1px solid lightgray;
  border-radius: 0;
  background: lightgray;
  
}
.reg_btn button.is-active{
  color: #fff;
  background: #187e6e;

}

.wx_btn{
  background: red;
}


.log_btn{
  background: #187e6e;
  color: #fff;

}

.log_btn button{
  color: #fff;
  border: none;
  
}

/*  */
button.addBtn{
  padding: 0;
  background: #707070;
  line-height: 90rpx;
  font-weight: 400;
  color: #fff;
}
.addBtn.next{
  background: #234b50;
}


.radio-group {
  padding: 20rpx;
}

.radio {
  width: 100%;
  /* border:1px solid red; */
  float: left;
  line-height: 120rpx;
}
