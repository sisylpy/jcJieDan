.card {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff;
}
.title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #222;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.name { font-size: 26rpx; color: #333; }
.sub { font-size: 24rpx; color: #999; }
