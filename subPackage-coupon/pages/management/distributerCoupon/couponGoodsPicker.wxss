.goods-picker-page {
  height: 100vh;
  background: #f5f7f6;
}

.picker-search-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f3f2;
}

.picker-search-input {
  flex: 1;
  background: #f5f6f5;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  margin-right: 18rpx;
}

.picker-search-btn {
  font-size: 28rpx;
  color: #fff;
  background: #0abf6f;
  border-radius: 16rpx;
  padding: 18rpx 34rpx;
}

.picker-list-scroll {
  flex: 1;
  min-height: 0;
  padding: 18rpx 24rpx 0;
}

.picker-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 2rpx solid transparent;
}

.picker-result.active {
  border-color: #07875c;
  background: #e8f9ef;
}

.picker-result-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  padding-right: 16rpx;
}

.picker-result-index {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  margin-right: 14rpx;
  margin-top: 2rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background: #c2ccc8;
}

.picker-result-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 12rpx;
}

.picker-result-brand {
  font-size: 22rpx;
  color: #07875c;
  background: #e8f9ef;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.picker-result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d28;
}

.picker-result-detail {
  font-size: 24rpx;
  color: #8a938f;
  margin-left: 12rpx;
}

.picker-result-body {
  flex: 1;
  min-width: 0;
}

.picker-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.picker-label {
  color: #9aa39f;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.picker-val {
  color: #444;
}

.picker-standard {
  color: #1f2d28;
  font-weight: 500;
}

.picker-price-row {
  margin-top: 4rpx;
}

.picker-price-label {
  color: #e84640;
}

.picker-ml {
  margin-left: 24rpx;
}

.picker-price {
  color: #e84640;
  font-weight: 600;
}

.picker-price-muted {
  color: #bbb;
}

.picker-result-place {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #aaa;
}

.picker-check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #bbb;
  border: 2rpx solid #ddd;
}

.picker-check.checked {
  color: #fff;
  background: #07875c;
  border-color: #07875c;
}

.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.picker-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f1f3f2;
}

.picker-count {
  font-size: 28rpx;
  color: #69736f;
}

.picker-done-btn {
  font-size: 30rpx;
  color: #fff;
  background: #0abf6f;
  border-radius: 999rpx;
  padding: 18rpx 60rpx;
}
