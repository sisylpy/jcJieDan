.time-window-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 10vh 40rpx 40vh;
  box-sizing: border-box;
}

.time-window-dialog {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.time-window-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.time-window-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.time-window-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.time-window-field {
  margin-top: 24rpx;
}

.time-window-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.time-window-picker,
.time-window-input {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #222;
}

.time-window-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.time-window-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.time-window-btn-cancel {
  background: #f0f1f3;
  color: #666;
}

.time-window-btn-confirm {
  background: #008c7a;
  color: #fff;
}

.time-window-btn-disabled {
  opacity: 0.6;
}
