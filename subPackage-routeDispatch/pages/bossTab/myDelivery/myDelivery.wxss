@import '../dispatchPanelShared.wxss';

.page-tab-embed {
  min-height: 100%;
  height: 100%;
}

.page-tab-embed .page-scroll {
  height: 100%;
}

.page {
  min-height: 100%;
  height: 100%;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  height: 100%;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

.delivery-empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
  flex-direction: column;
  gap: 16rpx;
  min-height: 100%;
  box-sizing: border-box;
}

.delivery-empty-hint {
  margin-top: 8rpx;
  color: #999;
}

.delivery-progress-wrap {
  margin: 16rpx 24rpx 0;
}

.delivery-progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef0f3;
  overflow: hidden;
}

.delivery-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #34b768, #20a058);
  min-width: 0;
}

.delivery-progress-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.boss-timeline-point-name-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.boss-timeline-point-status {
  font-size: 22rpx;
  color: #34b768;
}

.boss-timeline-marker-done {
  background: #34b768 !important;
  color: #fff !important;
  border-color: #34b768 !important;
}

.timeline-stop-done .boss-timeline-stop-card {
  opacity: 0.92;
}

.boss-stop-delivered-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #34b768;
  flex-shrink: 0;
}

.delivery-stop-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.delivery-stop-action-btn {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  border: 1rpx solid transparent;
}

.delivery-stop-action-cancel {
  color: #d46b08;
  border-color: #ffd591;
  background: #fff7e6;
}

.delivery-stop-action-exception {
  color: #cf1322;
  border-color: #ffa39e;
  background: #fff1f0;
}

.delivery-stop-action-disabled {
  opacity: 0.45;
}

.timeline-stop-active .boss-timeline-stop-card {
  box-shadow: 0 0 0 2rpx rgba(52, 183, 104, 0.18);
}

.timeline-stop-warn .boss-stop-delivered-label,
.timeline-stop-warn .boss-stop-name {
  color: #d48806;
}
