@import '../dispatchPanelShared.wxss';

/* 组件内须保留本地规则，避免部分基础库仅 @import 时不加载样式 */
.page-tab-embed {
  min-height: 100%;
  height: 100%;
}

.page-tab-embed .page-scroll {
  height: 100%;
}

.page {
  min-height: 100%;
  height: 100%;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  height: 100%;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}
