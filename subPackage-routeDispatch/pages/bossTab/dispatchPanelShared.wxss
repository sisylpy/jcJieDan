.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.page-tab-embed {
  min-height: 100%;
  height: 100%;
}

.page-tab-embed .page-scroll {
  height: 100%;
}

.page-embed {
  min-height: 100%;
  height: 100%;
}

.page-embed .page-scroll {
  height: 100%;
}

.page-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding-bottom: 32rpx;
}

.page-loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.hero-card {
  margin: 18rpx 20rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(28, 43, 63, 0.05);
}

.hero-card-compact {
  display: none;
}

.hero-top {
  position: relative;
  padding: 28rpx 24rpx 20rpx;
  overflow: hidden;
}

.hero-top-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-top-glow-left {
  left: -20rpx;
  top: 10rpx;
  width: 140rpx;
  height: 140rpx;
  background: radial-gradient(circle, rgba(0, 140, 122, 0.16) 0%, rgba(0, 140, 122, 0) 70%);
}

.hero-top-glow-right {
  right: -10rpx;
  top: 0;
  width: 200rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(0, 140, 122, 0.1) 0%, rgba(0, 140, 122, 0) 72%);
}

.hero-top-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
}

.hero-clipboard-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.hero-clipboard-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  background: rgba(0, 140, 122, 0.14);
}

.hero-clipboard-icon {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
}

.hero-top-text {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  padding-right: 8rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.35;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.hero-subtitle-num {
  color: #008c7a;
  font-weight: bold;
  font-size: 26rpx;
  margin-right: 4rpx;
}

.hero-banner {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #008c7a;
  line-height: 1.4;
}

.hero-truck-icon {
  width: 132rpx;
  height: 96rpx;
  flex-shrink: 0;
  opacity: 0.92;
}

.hero-stats-bar {
  display: flex;
  margin: 0 16rpx 16rpx;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.map-overview-card {
  margin: 10rpx 8rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(28, 43, 63, 0.08);
}

.map-overview-stage {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #eef4f7;
}

.map-overview {
  width: 100%;
  height: 640rpx;
}

.map-topbar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.map-topbar-inline {
  position: relative;
  left: auto;
  right: auto;
  top: auto;
  padding: 20rpx 18rpx 12rpx;
}

.map-topbar-inline .map-overview-stat-text,
.map-topbar-inline .map-refresh-symbol {
  line-height: 1.4;
}

.map-summary-pill {
  display: flex;
  align-items: center;
  max-width: 550rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(31, 50, 71, 0.08);
}

.map-overview-stat {
  display: flex;
  align-items: center;
  min-width: 0;
}

.map-stat-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.map-stat-symbol-wait {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  color: #2f7de1;
  background: #edf5ff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  flex-shrink: 0;
}

.map-overview-stat-text {
  font-size: 24rpx;
  color: #1d2939;
  line-height: 56rpx;
  white-space: nowrap;
}

.map-pill-divider {
  width: 1px;
  height: 28rpx;
  margin: 0 18rpx;
  background: rgba(31, 50, 71, 0.12);
}

.map-overview-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(31, 50, 71, 0.08);
  font-size: 24rpx;
  color: #475467;
  line-height: 56rpx;
}

.map-refresh-symbol {
  margin-right: 8rpx;
  color: #344054;
  font-size: 28rpx;
  line-height: 56rpx;
}

.map-overview-title {
  padding: 0 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.map-empty-hint,
.map-missing-hint {
  padding: 16rpx 24rpx 0;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.map-missing-hint {
  color: #d46b08;
}

.map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 26rpx;
  padding: 18rpx 28rpx 22rpx;
}

.map-legend-cover {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 52rpx;
  padding: 12rpx 30rpx 14rpx;
  background: rgba(255, 255, 255, 0.9);
}

.map-legend-inline {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  min-height: 0;
  padding: 12rpx 28rpx 18rpx;
  background: #fff;
}

.map-legend-inline.map-legend-compact {
  padding: 12rpx 24rpx 16rpx;
}

.map-legend-item {
  display: flex;
  align-items: center;
  max-width: 100%;
}

.map-legend-line {
  width: 36rpx;
  height: 0;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
}

.map-legend-line-solid {
  height: 6rpx;
  border: none;
}

.map-legend-line-dashed {
  border-top-width: 4rpx;
  border-top-style: dashed;
  background-color: transparent !important;
}

.map-legend-label {
  font-size: 23rpx;
  color: #475467;
  line-height: 34rpx;
  white-space: nowrap;
}

.hero-stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 0;
}

.hero-stat-col + .hero-stat-col::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1px;
  background: #ececec;
}

.hero-stat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.hero-stat-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}

.hero-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
  text-align: center;
}

.dispatch-section {
  margin: 0;
}

.driver-route-card {
  margin: 16rpx 24rpx 0;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(28, 43, 63, 0.06);
}

.idle-driver-card {
  margin-top: 16rpx;
}

.driver-route-head {
  display: flex;
  align-items: center;
}

.driver-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #eef2f6;
}

.driver-route-head-main {
  flex: 1;
  min-width: 0;
}

.driver-route-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.driver-route-name-row-between {
  justify-content: space-between;
  gap: 12rpx;
}

.driver-route-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.driver-route-name-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.driver-stop-count-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #2f7de1;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.driver-summary-metrics {
  display: flex;
  align-items: stretch;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #eef1f4;
}

.driver-metric-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 8rpx;
  text-align: center;
}

.driver-metric-divider {
  width: 1rpx;
  align-self: stretch;
  margin: 4rpx 0;
  background: #e8ebef;
  flex-shrink: 0;
}

.driver-metric-label {
  font-size: 24rpx;
  color: #667085;
  line-height: 1.35;
  white-space: nowrap;
}

.driver-metric-label-accent {
  color: #008c7a;
  font-weight: 500;
}

.driver-metric-time {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

.driver-metric-time-accent {
  color: #008c7a;
}

.driver-metric-col-arrival {
  padding-bottom: 0;
}

.driver-arrival-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  max-width: 100%;
}

.driver-arrival-status-ok {
  background: #e8f8f3;
  color: #008c7a;
}

.driver-arrival-status-early {
  background: #fff7e6;
  color: #d48806;
}

.driver-arrival-status-warn {
  background: #fff1f0;
  color: #cf1322;
}

.driver-arrival-status-check {
  margin-right: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.driver-summary-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx 0;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef1f4;
}

.driver-summary-footer-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.4;
  padding: 0 20rpx;
}

.driver-summary-footer-divider {
  width: 1rpx;
  height: 24rpx;
  background: #dde1e6;
  flex-shrink: 0;
}

.driver-footer-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.driver-footer-icon-clock {
  width: auto;
  height: auto;
  font-size: 26rpx;
  line-height: 1;
  opacity: 0.65;
  color: #667085;
}

.driver-depart-line {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  line-height: 1.4;
}

.driver-recommended-depart {
  font-size: 28rpx;
  color: #008c7a;
  font-weight: 700;
}

.driver-route-highlights {
  margin-top: 8rpx;
  line-height: 1.5;
}

.driver-route-highlights-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.driver-route-highlights-sep {
  font-size: 26rpx;
  color: #333;
}

.driver-route-roundtrip {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.driver-first-window {
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f3f4f6;
  font-size: 24rpx;
  color: #666;
}

.timeline-depot-address {
  max-width: 52%;
  text-align: right;
  color: #666;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.stop-head-row-window {
  align-items: flex-start;
}

.stop-window-line {
  margin: 8rpx 0 8rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.stop-window-status-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fff7e6;
  font-size: 20rpx;
  color: #d48806;
  line-height: 1.4;
}

.stop-time-val-arrival {
  font-size: 30rpx;
  color: #111;
  font-weight: 700;
}

.stop-time-grid-boss {
  margin-top: 4rpx;
}

.stop-state-btn-edit {
  flex-shrink: 0;
}

.driver-dispatch-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f7f4;
  color: #008c7a;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.driver-dispatch-badge-ok,
.driver-dispatch-badge-active {
  background: #e6f7f4;
  color: #008c7a;
}

.driver-dispatch-badge-warn {
  background: #fff7e6;
  color: #d46b08;
}

.driver-dispatch-badge-muted {
  background: #f5f5f5;
  color: #999;
}

.driver-schedule-headline {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.driver-route-stats {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.route-timeline {
  margin-top: 24rpx;
  padding-top: 4rpx;
  padding-left: 8rpx;
}

/* —— 老板端分派中：路线 timeline（设计稿） —— */
.boss-route-timeline {
  position: relative;
  margin-top: 28rpx;
  padding-top: 8rpx;
  padding-left: 0;
  padding-bottom: 8rpx;
}

.boss-route-timeline::before {
  content: '';
  position: absolute;
  left: 23rpx;
  top: 28rpx;
  bottom: 28rpx;
  border-left: 2rpx dashed #d5dce3;
  z-index: 0;
}

.boss-timeline-node {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
  margin-bottom: 4rpx;
}

.boss-timeline-start {
  padding-bottom: 8rpx;
}

.boss-timeline-stop {
  margin-bottom: 8rpx;
}

.boss-timeline-stop-unit {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.boss-timeline-marker-stop {
  margin-top: 0;
  flex-shrink: 0;
}

.boss-timeline-unit-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #eef2f0;
  box-shadow: 0 4rpx 20rpx rgba(28, 43, 63, 0.05);
  background: #fff;
}

.boss-timeline-end-unit {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
  padding-top: 8rpx;
}

.boss-timeline-end-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f3f5f4;
}

.boss-timeline-end-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.boss-timeline-end-leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.boss-timeline-end-leg .boss-timeline-leg-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.boss-timeline-end-leg .boss-timeline-leg-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

.boss-timeline-end-divider {
  font-size: 24rpx;
  color: #c5cbc8;
  line-height: 1;
}

.boss-timeline-end-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
}

.boss-timeline-end-status {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  flex-shrink: 0;
}

.boss-timeline-end-status-done {
  background: #34b768;
  color: #fff;
}

.boss-timeline-end-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  flex-shrink: 0;
}

.boss-timeline-marker {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #5e6b7a;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(94, 107, 122, 0.2);
}

.boss-timeline-marker-end {
  background: #5e6b7a;
}

.boss-timeline-point-main {
  flex: 1;
  min-width: 0;
  padding-top: 10rpx;
}

.boss-timeline-point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.boss-timeline-point-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
}

.boss-timeline-point-time {
  font-size: 26rpx;
  color: #667085;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.35;
}

.boss-timeline-leg-wrap {
  display: flex;
  align-items: center;
  padding: 10rpx 0 14rpx;
  position: relative;
  z-index: 1;
}

.boss-timeline-leg-spacer {
  width: 64rpx;
  flex-shrink: 0;
}

.boss-timeline-leg-pill {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx 0 16rpx;
  border-radius: 0;
  background: #f3f5f7;
  border-bottom: 1rpx solid #e8eaed;
  flex-shrink: 0;
}

.boss-timeline-leg-pill-standalone {
  border-radius: 12rpx;
  border-bottom: none;
}

.boss-timeline-leg-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.boss-timeline-leg-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5e6b7a;
  font-weight: 500;
  line-height: 1.3;
}

.boss-timeline-leg-chevron {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: #98a2b3;
  line-height: 1;
  flex-shrink: 0;
}

.boss-timeline-stop-card {
  background: #fff;
  border: none;
  border-radius: 0;
  padding: 20rpx 20rpx 18rpx;
  box-shadow: none;
}

.boss-stop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.boss-stop-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.boss-stop-pin {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.boss-stop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
  max-width: 100%;
}

