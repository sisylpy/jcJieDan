<view class="page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="人工路线编辑" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-loading-wrap" wx:if="{{loading}}">
    <text class="text-secondary font-md">加载中...</text>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && loadError}}">
    <text class="text-secondary font-md">{{loadError}}</text>
  </view>

  <scroll-view scroll-y="true" class="page-scroll page-scroll-with-footer" wx:if="{{!loading && pageViewModel}}">
    <view class="compact-card bg-white">
      <view class="compact-card-label">待插入</view>
      <view class="compact-card-name">{{pageViewModel.customer.customerName}}</view>
      <view class="compact-card-sub" wx:if="{{pageViewModel.customer.goodsSummary}}">{{pageViewModel.customer.goodsSummary}}</view>
      <view class="compact-card-meta">
        <text wx:if="{{pageViewModel.customer.windowLabel}}">送达窗 {{pageViewModel.customer.windowLabel}}</text>
        <text class="compact-meta-sep" wx:if="{{pageViewModel.customer.windowLabel && pageViewModel.customer.serviceDurationLabel}}">·</text>
        <text wx:if="{{pageViewModel.customer.serviceDurationLabel}}">服务 {{pageViewModel.customer.serviceDurationLabel}}</text>
      </view>
      <view class="compact-constraint-row">
        <text class="compact-constraint-text" wx:if="{{pageViewModel.incomingManualTimeConstraint.summaryLabel}}">{{pageViewModel.incomingManualTimeConstraint.summaryLabel}}</text>
        <text class="compact-constraint-edit" catchtap="onOpenConstraintDrawer">编辑约束</text>
      </view>
    </view>

    <view class="compact-card bg-white">
      <view class="compact-driver-head">
        <text class="compact-card-name">{{pageViewModel.driver.driverName}}</text>
        <view class="compact-badge-row">
          <text class="compact-badge" wx:if="{{pageViewModel.driver.dispatchStageLabel}}">{{pageViewModel.driver.dispatchStageLabel}}</text>
          <text class="compact-badge compact-badge-warn" wx:if="{{pageViewModel.driver.confirmModeLabel}}">{{pageViewModel.driver.confirmModeLabel}}</text>
        </view>
      </view>
      <view class="compact-card-sub" wx:if="{{pageViewModel.driver.routeSummary}}">{{pageViewModel.driver.routeSummary}}</view>
      <view class="compact-card-sub" wx:if="{{pageViewModel.driver.routeMetricsLine}}">{{pageViewModel.driver.routeMetricsLine}}</view>
      <view class="compact-card-hint" wx:if="{{pageViewModel.driver.operationHint}}">{{pageViewModel.driver.operationHint}}</view>
      <view class="simulation-inline" wx:if="{{pageViewModel.hasSelectedPosition && pageViewModel.simulationSummary.routeSummary}}">
        <text>{{pageViewModel.simulationSummary.routeSummary}}</text>
        <text wx:if="{{pageViewModel.simulationSummary.deltaLine}}"> · {{pageViewModel.simulationSummary.deltaLine}}</text>
      </view>
      <view class="risk-inline" wx:for="{{pageViewModel.simulationSummary.riskHints}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="selected-position-bar" wx:if="{{pageViewModel.hasSelectedPosition && pageViewModel.selectedPositionHint}}">
      <text class="selected-position-text">{{pageViewModel.selectedPositionHint}}</text>
      <text class="selected-position-reset" catchtap="onReselectPosition">重新选择位置</text>
    </view>

    <view class="route-timeline-section">
      <view class="route-timeline">
        <block wx:for="{{pageViewModel.routeTimeline}}" wx:for-item="node" wx:key="index">
          <view class="timeline-node timeline-{{node.type}}" wx:if="{{node.type === 'start' || node.type === 'end'}}">
            <view class="timeline-marker timeline-marker-{{node.type === 'start' ? 'start' : 'end'}}">{{node.type === 'start' ? '起' : '终'}}</view>
            <view class="timeline-content timeline-point-content">
              <view class="timeline-point-row">
                <view class="timeline-title">{{node.name}}</view>
                <view class="timeline-point-time" wx:if="{{node.timeRight}}">{{node.timeRight}}</view>
              </view>
            </view>
          </view>

          <view class="timeline-insert-row" wx:if="{{node.type === 'insert'}}">
            <view class="timeline-leg-line timeline-leg-line-short"></view>
            <view
              class="timeline-insert-btn"
              catchtap="onInsertPositionTap"
              data-manual-stop-seq="{{node.manualStopSeq}}"
            >{{node.buttonLabel}}</view>
          </view>

          <view class="timeline-node timeline-stop" wx:if="{{node.type === 'stop'}}">
            <view class="timeline-marker timeline-marker-stop {{node.insertedStop ? 'timeline-marker-inserted' : ''}}">{{node.seq}}</view>
            <view class="timeline-content timeline-stop-content">
              <view class="timeline-stop-card compact-stop-card {{node.insertedStop ? 'compact-stop-inserted' : ''}}">
                <view class="stop-head-row">
                  <view class="stop-name-wrap">
                    <image class="stop-shop-icon" src="/images/app-shop.png" mode="aspectFit"></image>
                    <text class="stop-name">{{node.customerName}}</text>
                  </view>
                  <text class="stop-inserted-tag" wx:if="{{node.insertedStop}}">新增插入</text>
                </view>
                <view class="insert-seq-label" wx:if="{{node.insertedStop && node.insertSeqLabel}}">{{node.insertSeqLabel}}</view>
                <view class="timeline-stop-goods" wx:if="{{node.goodsSummary}}">{{node.goodsSummary}}</view>
                <view class="compact-stop-meta">
                  <text wx:if="{{node.windowLabel}}">送达窗 {{node.windowLabel}}</text>
                  <text wx:if="{{node.plannedArrivalLabel}}"> · 预计到达 {{node.plannedArrivalLabel}}</text>
                  <text wx:if="{{node.plannedDepartureLabel}}"> · 离开 {{node.plannedDepartureLabel}}</text>
                </view>
                <view class="compact-stop-warn" wx:if="{{node.timeWindowImpactLabel}}">{{node.timeWindowImpactLabel}}</view>
                <view class="compact-constraint-row" wx:if="{{node.insertedStop}}">
                  <text class="compact-constraint-text" wx:if="{{node.manualConstraintSummary}}">{{node.manualConstraintSummary}}</text>
                  <text class="compact-constraint-edit" catchtap="onOpenConstraintDrawer">编辑约束</text>
                </view>
              </view>
            </view>
          </view>

          <view class="timeline-leg" wx:if="{{node.type === 'leg'}}">
            <view class="timeline-leg-line"></view>
            <view class="timeline-leg-info">
              <image class="timeline-leg-car" src="/images/car.png" mode="aspectFit"></image>
              <text>{{node.legText}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-action-bar" wx:if="{{!loading && pageViewModel}}">
    <view class="bottom-action-row">
      <view class="bottom-btn bottom-btn-secondary" catchtap="onBottomReset">重置</view>
      <view class="bottom-btn bottom-btn-primary" catchtap="onBottomResimulate">重新模拟</view>
      <view class="bottom-btn bottom-btn-disabled {{pageViewModel.actions.confirmEnabled ? '' : 'bottom-btn-locked'}}" catchtap="onBottomConfirmTap">确认排单（暂未开放）</view>
    </view>
    <view class="bottom-action-hint" wx:if="{{pageViewModel.bottomHint}}">{{pageViewModel.bottomHint}}</view>
  </view>

  <view class="drawer-mask" wx:if="{{drawerVisible}}" catchtap="onDrawerMaskTap"></view>
  <view class="drawer-panel {{drawerVisible ? 'drawer-panel-show' : ''}}">
    <view class="drawer-head">
      <view class="drawer-title">编辑人工时间约束</view>
      <view class="drawer-subtitle">{{pageViewModel.drawerSubtitle}}</view>
    </view>
    <scroll-view scroll-y="true" class="drawer-body">
      <view class="drawer-row drawer-row-switch">
        <text class="drawer-label">是否人工指定送达时间</text>
        <switch checked="{{drawerForm.manualArrivalSpecified}}" bindchange="onDrawerSpecifiedChange" color="#008c7a" />
      </view>
      <view class="drawer-row">
        <text class="drawer-label">必须几点前到</text>
        <picker mode="time" value="{{drawerForm.requiredLatestArrivalTime}}" bindchange="onDrawerRequiredTimeChange">
          <view class="drawer-picker-val">{{drawerForm.requiredLatestArrivalTime || '请选择时间'}}</view>
        </picker>
      </view>
      <view class="drawer-row">
        <text class="drawer-label">最好几点到</text>
        <picker mode="time" value="{{drawerForm.preferredArrivalTime}}" bindchange="onDrawerPreferredTimeChange">
          <view class="drawer-picker-val">{{drawerForm.preferredArrivalTime || '请选择时间'}}</view>
        </picker>
      </view>
      <view class="drawer-row">
        <text class="drawer-label">是否允许晚</text>
        <view class="drawer-allow-row">
          <text class="drawer-allow-opt {{drawerForm.allowLate === true ? 'drawer-allow-selected' : ''}}" catchtap="onDrawerAllowLateTap" data-value="1">允许</text>
          <text class="drawer-allow-opt {{drawerForm.allowLate === false ? 'drawer-allow-selected' : ''}}" catchtap="onDrawerAllowLateTap" data-value="0">不允许</text>
        </view>
      </view>
      <view class="drawer-row drawer-row-column">
        <text class="drawer-label">备注原因</text>
        <textarea class="drawer-textarea" maxlength="50" placeholder="最多 50 字" value="{{drawerForm.remarkReason}}" bindinput="onDrawerRemarkInput"></textarea>
      </view>
    </scroll-view>
    <view class="drawer-footer">
      <view class="drawer-footer-btn drawer-footer-muted" catchtap="onDrawerClear">清除约束</view>
      <view class="drawer-footer-btn drawer-footer-secondary" catchtap="onCloseConstraintDrawer">取消</view>
      <view class="drawer-footer-btn drawer-footer-primary" catchtap="onDrawerSave">保存并重算</view>
    </view>
  </view>
</view>
