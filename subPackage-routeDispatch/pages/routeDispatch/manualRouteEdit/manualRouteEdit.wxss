@import '../today/today.wxss';

.page-scroll-with-footer {
  flex: 1;
  height: calc(100vh - 120rpx - 160rpx);
  padding-bottom: 24rpx;
}

.compact-card {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.compact-card-label {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 4rpx;
}

.compact-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d2b;
}

.compact-card-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5f6f6c;
  line-height: 1.4;
}

.compact-card-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.compact-meta-sep {
  margin: 0 6rpx;
}

.compact-driver-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.compact-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex-shrink: 0;
}

.compact-badge {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #e6f7f4;
  color: #008c7a;
  font-size: 20rpx;
}

.compact-badge-warn {
  background: #fff7e6;
  color: #d48806;
}

.compact-card-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #008c7a;
}

.compact-constraint-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eef2f0;
  gap: 12rpx;
}

.compact-constraint-text {
  flex: 1;
  font-size: 22rpx;
  color: #666;
}

.compact-constraint-edit {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #008c7a;
  font-weight: 500;
}

.simulation-inline {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #008c7a;
  line-height: 1.4;
}

.risk-inline {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #d48806;
  line-height: 1.4;
}

.selected-position-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #f0faf8;
  gap: 12rpx;
}

.selected-position-text {
  flex: 1;
  font-size: 24rpx;
  color: #008c7a;
}

.selected-position-reset {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #666;
  text-decoration: underline;
}

.route-timeline-section {
  margin: 16rpx 24rpx 0;
}

.timeline-insert-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 48rpx;
  position: relative;
}

.timeline-leg-line-short {
  position: absolute;
  left: 24rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  border-left: 2rpx dashed #d0d8d4;
}

.timeline-insert-btn {
  flex: 1;
  margin-left: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #008c7a;
  background: #f6fffd;
  color: #008c7a;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
}

.compact-stop-card {
  padding: 16rpx;
}

.compact-stop-inserted {
  border: 2rpx solid #008c7a;
  background: #f6fffd;
}

.stop-inserted-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #008c7a;
  color: #fff;
  font-size: 20rpx;
  flex-shrink: 0;
}

.insert-seq-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #008c7a;
  font-weight: 500;
}

.compact-stop-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.compact-stop-warn {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #d48806;
}

.timeline-marker-inserted {
  background: #008c7a !important;
  color: #fff !important;
}

.section-empty {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 16rpx;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef2f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.bottom-action-row {
  display: flex;
  gap: 12rpx;
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.bottom-btn-secondary {
  background: #f7f8fa;
  color: #333;
}

.bottom-btn-primary {
  background: #008c7a;
  color: #fff;
}

.bottom-btn-disabled {
  background: #e8eeec;
  color: #999;
}

.bottom-btn-locked {
  opacity: 0.7;
}

.bottom-action-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.drawer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.drawer-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.drawer-panel-show {
  transform: translateY(0);
}

.drawer-head {
  padding: 28rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #eef2f0;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.drawer-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.drawer-body {
  flex: 1;
  max-height: 50vh;
  padding: 16rpx 28rpx;
  box-sizing: border-box;
}

.drawer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.drawer-row-switch {
  align-items: center;
}

.drawer-row-column {
  flex-direction: column;
  align-items: flex-start;
}

.drawer-label {
  font-size: 28rpx;
  color: #333;
}

.drawer-picker-val {
  font-size: 28rpx;
  color: #008c7a;
}

.drawer-allow-row {
  display: flex;
  gap: 12rpx;
}

.drawer-allow-opt {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 24rpx;
}

.drawer-allow-selected {
  background: #e6f7f4;
  color: #008c7a;
}

.drawer-textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  box-sizing: border-box;
}

.drawer-footer {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eef2f0;
}

.drawer-footer-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.drawer-footer-muted {
  background: #f7f8fa;
  color: #666;
}

.drawer-footer-secondary {
  background: #f0faf8;
  color: #008c7a;
}

.drawer-footer-primary {
  background: #008c7a;
  color: #fff;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
