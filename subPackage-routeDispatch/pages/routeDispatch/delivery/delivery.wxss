@import '../today/today.wxss';

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
}

.stop-status-tag {
  font-size: 22rpx;
  color: #008c7a;
  flex-shrink: 0;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
