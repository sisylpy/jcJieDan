<view class="page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="我的装车" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-loading-wrap" wx:if="{{loading}}">
    <text class="text-secondary font-md">加载中...</text>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && loadError}}">
    <text class="text-secondary font-md">{{loadError}}</text>
  </view>

  <scroll-view scroll-y="true" class="page-scroll" wx:if="{{!loading && pageViewModel}}">
    <view class="hero-card" wx:if="{{pageViewModel.pageHeader.title}}">
      <view class="hero-top">
        <view class="hero-top-row">
          <view class="hero-top-text">
            <view class="hero-title">{{pageViewModel.pageHeader.title}}</view>
            <view class="hero-subtitle" wx:if="{{pageViewModel.pageHeader.subtitle}}">{{pageViewModel.pageHeader.subtitle}}</view>
          </view>
          <image class="hero-truck-icon" src="/images/car.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="driver-meta-bar">
        <text wx:if="{{pageViewModel.driverName}}">司机：{{pageViewModel.driverName}}</text>
        <text wx:if="{{pageViewModel.driverRouteId}}">路线ID：{{pageViewModel.driverRouteId}}</text>
      </view>
    </view>

    <view class="workbench-bar bg-white" wx:if="{{pageViewModel.firstScreen.statusLabel || pageViewModel.firstScreen.operationHint}}">
      <view class="workbench-status {{pageViewModel.firstScreen.statusClass}}" wx:if="{{pageViewModel.firstScreen.statusLabel}}">{{pageViewModel.firstScreen.statusLabel}}</view>
      <view class="workbench-hint" wx:if="{{pageViewModel.firstScreen.operationHint}}">{{pageViewModel.firstScreen.operationHint}}</view>
    </view>

    <view class="route-timeline" wx:if="{{pageViewModel.timeline.length > 0}}">
      <block wx:for="{{pageViewModel.timeline}}" wx:for-item="node" wx:key="index">
        <view class="timeline-node timeline-stop" wx:if="{{node.type === 'stop'}}">
          <view class="timeline-marker timeline-marker-stop">{{node.seq}}</view>
          <view class="timeline-content timeline-stop-content">
            <view class="stop-head-row">
              <text class="stop-name">{{node.name}}</text>
              <text class="stop-status-tag" wx:if="{{node.statusLabel}}">{{node.statusLabel}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="loading-stop-list" wx:if="{{pageViewModel.stopList.length > 0}}">
      <view class="loading-stop-card" wx:for="{{pageViewModel.stopList}}" wx:for-item="stop" wx:for-index="stopIndex" wx:key="deliveryStopId">
        <view class="loading-stop-head">
          <view class="loading-stop-title-row">
            <text class="loading-stop-name">{{stop.customerName}}</text>
            <text class="loading-stop-status">{{stop.loadingStatusLabel}}</text>
          </view>
          <view class="loading-stop-address" wx:if="{{stop.customerAddress}}">{{stop.customerAddress}}</view>
          <view class="loading-stop-meta">
            <text>任务状态：{{stop.statusLabel}}</text>
            <text wx:if="{{stop.deliveryStopId}}">站点ID：{{stop.deliveryStopId}}</text>
          </view>
        </view>

        <view class="order-block" wx:for="{{stop.orders}}" wx:for-item="order" wx:for-index="orderIndex" wx:key="orderId">
          <view class="order-head">
            <text class="order-title">订单 {{orderIndex + 1}}</text>
            <text class="order-status">{{order.purchaseStatusLabel}}</text>
          </view>
          <view class="loading-stop-items" wx:if="{{order.items.length > 0}}">
            <view class="loading-item-row" wx:for="{{order.items}}" wx:for-item="goods" wx:key="goodsName">
              <text class="loading-goods-name">{{goods.goodsName}}</text>
              <text class="loading-goods-qty">{{goods.quantity}}{{goods.unit}}</text>
            </view>
          </view>
        </view>

        <view class="stop-action-row">
          <view
            wx:if="{{stop.canConfirmLoad}}"
            class="stop-action-btn"
            catchtap="onConfirmLoadTap"
            data-stop-index="{{stopIndex}}"
          >确认装车</view>
          <view class="stop-blocked-reason" wx:elif="{{stop.confirmLoadBlockedReason}}">{{stop.confirmLoadBlockedReason}}</view>
        </view>
      </view>
    </view>

    <view class="driver-action-bar" wx:if="{{pageViewModel.showConfirmLoadAll || pageViewModel.showDepartAction}}">
      <view
        wx:if="{{pageViewModel.showConfirmLoadAll}}"
        class="driver-action-btn secondary {{pageViewModel.confirmLoadAllEnabled && !actionSubmitting ? '' : 'driver-action-btn-disabled'}}"
        catchtap="onConfirmLoadAllTap"
      >{{pageViewModel.confirmLoadAllLabel}}</view>
      <view
        wx:if="{{pageViewModel.showDepartAction}}"
        class="driver-action-btn primary {{pageViewModel.departActionEnabled && !actionSubmitting ? '' : 'driver-action-btn-disabled'}}"
        catchtap="onDepartTap"
      >{{pageViewModel.departActionLabel}}</view>
    </view>
  </scroll-view>
</view>
