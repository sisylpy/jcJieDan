<view class="page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="人工调度" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-loading-wrap" wx:if="{{loading}}">
    <text class="text-secondary font-md">加载中...</text>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && loadError}}">
    <text class="text-secondary font-md">{{loadError}}</text>
  </view>

  <scroll-view scroll-y="true" class="page-scroll manual-dispatch-scroll" wx:if="{{!loading && pageData}}">
    <view class="context-card bg-white unassigned-customer-card" wx:if="{{pageData.storeCard.customerName}}">
      <view class="context-card-head">
        <text class="context-card-title">待分派客户</text>
      </view>
      <store-stop-card
        mode="unassigned"
        stop="{{pageData.storeCard}}"
        badge-label="{{pageData.storeCard.dispatchStatusLabel}}"
        driver-label="无司机"
      ></store-stop-card>
      <text class="context-summary-line" wx:if="{{pageData.summary && pageData.summary.summaryLine}}">{{pageData.summary.summaryLine}}</text>
    </view>

    <view class="driver-list-head" wx:if="{{pageData.drivers.length > 0}}">
      <text class="driver-list-title">可选司机</text>
      <text class="driver-list-count">共 {{pageData.drivers.length}} 人</text>
    </view>

    <view class="driver-section" wx:if="{{pageData.drivers.length > 0}}">
      <view
        class="driver-route-card bg-white manual-driver-card {{item.cardToneClass}}"
        wx:for="{{pageData.drivers}}"
        wx:for-index="driverIndex"
        wx:key="driverUserId"
      >
        <view class="driver-route-head">
          <image
            class="driver-avatar"
            src="{{item.driverAvatarUrl || '/images/user-group-2.png'}}"
            mode="aspectFill"
          ></image>
          <view class="driver-route-head-main">
            <text class="manual-driver-name">{{item.driverName}}</text>
            <view class="driver-duty-badges">
              <text class="driver-dispatch-badge driver-dispatch-badge-{{item.dutyBadgeTone || 'ok'}}" wx:if="{{item.dutyStatusLabel}}">{{item.dutyStatusLabel}}</text>
              <text class="driver-dispatch-badge driver-dispatch-badge-{{item.stageBadgeTone || 'ok'}}" wx:if="{{item.dispatchStageLabel}}">{{item.dispatchStageLabel}}</text>
              <text class="driver-dispatch-badge driver-dispatch-badge-warn" wx:if="{{item.confirmModeLabel}}">{{item.confirmModeLabel}}</text>
            </view>
            <view class="manual-driver-headline" wx:if="{{item.headline}}">{{item.headline}}</view>
            <view class="manual-driver-metrics" wx:if="{{item.metricsLine}}">{{item.metricsLine}}</view>
            <view class="manual-driver-task" wx:if="{{item.currentTaskLine}}">{{item.currentTaskLine}}</view>
            <view class="manual-driver-hint manual-driver-hint-{{item.hintTone || 'ok'}}" wx:if="{{item.operationHint}}">{{item.operationHint}}</view>
          </view>
        </view>

        <view class="driver-duty-risk-hints" wx:if="{{item.riskHints && item.riskHints.length > 0}}">
          <view class="driver-duty-risk-item" wx:for="{{item.riskHints}}" wx:for-item="hint" wx:key="*this">{{hint}}</view>
        </view>

        <view class="driver-duty-lock-reason" wx:if="{{item.blockedReason}}">{{item.blockedReason}}</view>

        <view class="manual-driver-action-wrap" wx:if="{{item.primaryAction.label}}">
          <view
            class="route-primary-action-btn stop-state-btn {{item.primaryAction.toneClass}}"
            catchtap="onSimulateAction"
            data-driver-index="{{driverIndex}}"
          >{{item.primaryAction.label}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
