@import '../today/today.wxss';

.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.manual-dispatch-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding-bottom: 32rpx;
}

.section-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.manual-summary-line {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f0;
  font-size: 24rpx;
  color: #008c7a;
}

.driver-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

.driver-list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d2b;
}

.driver-list-count {
  font-size: 24rpx;
  color: #888;
}

.driver-duty-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.driver-duty-hint {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #008c7a;
  line-height: 1.4;
}

.driver-duty-risk-hints {
  margin-top: 16rpx;
}

.driver-duty-risk-item {
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.5;
}

.driver-duty-risk-item::before {
  content: '· ';
}

.driver-duty-lock-reason {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  line-height: 1.5;
}

.manual-driver-action-wrap {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2f0;
}

.manual-driver-action-wrap .route-primary-action-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.route-primary-action-btn.stop-state-action {
  background: #008c7a;
  color: #fff;
}

.route-primary-action-btn.stop-state-muted {
  background: #f5f5f5;
  color: #999;
}

.manual-confirm-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #008c7a;
  text-align: right;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
