@import '../routeDispatchShared.wxss';
@import '../../bossTab/dispatchPanelShared.wxss';

.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.manual-dispatch-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding-bottom: 32rpx;
}

.context-card {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.context-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.context-card-title {
  font-size: 24rpx;
  color: #888;
}

.context-customer-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d2b;
  line-height: 1.35;
}

.context-line {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5f6f6c;
  line-height: 1.45;
}

.context-meta {
  color: #888;
  font-size: 22rpx;
}

.context-summary-line {
  display: block;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef2f0;
  font-size: 24rpx;
  color: #008c7a;
}

.driver-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

.driver-list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d2b;
}

.driver-list-count {
  font-size: 24rpx;
  color: #888;
}

.driver-section {
  padding: 0 24rpx;
}

.manual-driver-card {
  margin-top: 20rpx;
}

.manual-driver-card.driver-card-blocked {
  opacity: 0.72;
}

.manual-driver-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2d2b;
  line-height: 1.3;
}

.driver-duty-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.manual-driver-headline {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.45;
}

.manual-driver-metrics {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.manual-driver-task {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.manual-driver-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.manual-driver-hint-ok {
  color: #008c7a;
}

.manual-driver-hint-warn {
  color: #d46b08;
}

.driver-duty-risk-hints {
  margin-top: 16rpx;
}

.driver-duty-risk-item {
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.5;
}

.driver-duty-risk-item::before {
  content: '· ';
}

.driver-duty-lock-reason {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  line-height: 1.5;
}

.manual-driver-action-wrap {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f0;
}

.manual-driver-action-wrap .route-primary-action-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.route-primary-action-btn.stop-state-action {
  background: #008c7a;
  color: #fff;
}

.route-primary-action-btn.stop-state-muted {
  background: #f5f5f5;
  color: #999;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
