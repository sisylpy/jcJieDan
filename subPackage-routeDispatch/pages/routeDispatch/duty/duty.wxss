@import '../routeDispatchShared.wxss';

.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.summary-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.summary-tip {
  font-size: 26rpx;
  color: #008c7a;
  font-weight: 500;
}

.summary-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.duty-page-scroll {
  flex: 1;
  height: calc(100vh - 120rpx - 140rpx);
  padding-bottom: 32rpx;
}

.driver-duty-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.duty-self-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #ecf5ff;
  color: #409eff;
  font-size: 22rpx;
}

.driver-route-name-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.duty-switch {
  flex-shrink: 0;
  transform: scale(0.88);
}

.driver-route-card-off {
  padding-bottom: 24rpx;
}

.driver-duty-hint {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #008c7a;
  line-height: 1.4;
}

.driver-duty-risk-hints {
  margin-top: 16rpx;
}

.driver-duty-risk-item {
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.5;
}

.driver-duty-lock-reason {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  line-height: 1.5;
}

.duty-toggle-off {
  background: #fff;
  color: #d46b08;
  border: 2rpx solid #f0c78a;
}

.duty-toggle-disabled {
  background: #f5f5f5;
  color: #999;
  border: none;
}

.driver-employment-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.driver-employment-label {
  color: #84918c;
  font-size: 22rpx;
}

.driver-employment-option {
  padding: 9rpx 14rpx;
  border: 1rpx solid #dce6e2;
  border-radius: 999rpx;
  color: #64746e;
  background: #fff;
  font-size: 21rpx;
}

.driver-employment-option-active {
  border-color: #128b66;
  color: #08704f;
  background: #edf8f4;
  font-weight: 700;
}

.route-primary-action-btn.stop-state-action {
  background: #008c7a;
  color: #fff;
}

.route-primary-action-btn.stop-state-muted,
.route-primary-action-btn.duty-toggle-disabled {
  background: #f5f5f5;
  color: #999;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
