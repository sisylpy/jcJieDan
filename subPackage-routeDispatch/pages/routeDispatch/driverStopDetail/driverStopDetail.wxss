@import '../today/today.wxss';
@import '../driverCommon.wxss';

.known-gap-banner {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
}

.known-gap-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #d48806;
}

.known-gap-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
