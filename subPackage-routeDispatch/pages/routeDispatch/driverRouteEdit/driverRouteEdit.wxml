<view class="page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{pageTitle}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-loading-wrap" wx:if="{{loading}}">
    <text class="text-secondary font-md">加载中...</text>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && loadError}}">
    <text class="text-secondary font-md">{{loadError}}</text>
  </view>

  <scroll-view scroll-y="{{pageScrollEnabled}}" class="page-scroll page-scroll-with-footer" wx:if="{{!loading && pageViewModel}}">
    <view class="map-overview-card" wx:if="{{pageViewModel.mapOverview}}">
      <view class="map-overview-stage" wx:if="{{pageViewModel.mapOverview.hasMap}}">
        <map
          class="map-overview"
          longitude="{{pageViewModel.mapOverview.longitude}}"
          latitude="{{pageViewModel.mapOverview.latitude}}"
          scale="{{pageViewModel.mapOverview.scale}}"
          subkey="{{pageViewModel.mapOverview.subkey}}"
          layer-style="{{pageViewModel.mapOverview.layerStyle}}"
          include-points="{{pageViewModel.mapOverview.includePoints}}"
          padding="{{mapOverviewPadding}}"
          markers="{{pageViewModel.mapOverview.markers}}"
          polyline="{{pageViewModel.mapOverview.polylines}}"
          setting="{{pageViewModel.mapOverview.setting}}"
          enable-poi="{{false}}"
          enable-building="{{false}}"
          enable-scroll="{{true}}"
          enable-zoom="{{true}}"
          enable-rotate="{{false}}"
          show-location="{{false}}"
          show-compass="{{false}}"
          enable-3D="{{false}}"
          bindtouchstart="onMapTouchStart"
          bindtouchend="onMapTouchEnd"
          bindtouchcancel="onMapTouchEnd"
        ></map>
      </view>
      <view class="map-legend map-legend-inline map-legend-compact" wx:if="{{pageViewModel.mapOverview.hasMap && pageViewModel.mapOverview.legend.length > 0}}">
        <view class="map-legend-item" wx:for="{{pageViewModel.mapOverview.legend}}" wx:for-item="legendItem" wx:for-index="legendIndex" wx:key="legendIndex">
          <view class="map-legend-line map-legend-line-{{legendItem.lineStyle === 'DASHED' ? 'dashed' : 'solid'}}" style="border-color: {{legendItem.color}}; background-color: {{legendItem.lineStyle === 'DASHED' ? 'transparent' : legendItem.color}};"></view>
          <text class="map-legend-label">{{legendItem.label}}</text>
        </view>
      </view>
      <view class="map-empty-hint" wx:if="{{!pageViewModel.mapOverview.hasMap && pageViewModel.mapOverview.emptyHint}}">
        <text>{{pageViewModel.mapOverview.emptyHint}}</text>
      </view>
      <view class="map-missing-hint" wx:if="{{pageViewModel.mapOverview.missingHint}}">
        <text>{{pageViewModel.mapOverview.missingHint}}</text>
      </view>
      <view class="map-legend" wx:if="{{!pageViewModel.mapOverview.hasMap && pageViewModel.mapOverview.legend.length > 0}}">
        <view class="map-legend-item" wx:for="{{pageViewModel.mapOverview.legend}}" wx:for-item="legendItem" wx:for-index="legendIndex" wx:key="legendIndex">
          <view class="map-legend-line map-legend-line-{{legendItem.lineStyle === 'DASHED' ? 'dashed' : 'solid'}}" style="border-color: {{legendItem.color}}; background-color: {{legendItem.lineStyle === 'DASHED' ? 'transparent' : legendItem.color}};"></view>
          <text class="map-legend-label">{{legendItem.label}}</text>
        </view>
      </view>
    </view>

    <view class="driver-route-card bg-white route-edit-card" wx:if="{{pageViewModel.driver}}">
      <view class="driver-route-head">
        <image class="driver-avatar" src="/images/user-group-2.png" mode="aspectFill"></image>
        <view class="driver-route-head-main">
          <view class="driver-route-name-row">
            <view class="driver-route-name-group">
              <text class="driver-route-name">{{pageViewModel.driver.driverName}}</text>
              <text class="driver-stop-count-badge" wx:if="{{pageViewModel.driver.customerStopCount}}">{{pageViewModel.driver.customerStopCount}} 站</text>
            </view>
          </view>
        </view>
      </view>

      <view class="driver-summary-metrics" wx:if="{{pageViewModel.driver.customerStopCount > 0}}">
        <view class="driver-metric-col driver-metric-col-depart">
          <text class="driver-metric-label driver-metric-label-accent">建议出发</text>
          <text class="driver-metric-time driver-metric-time-accent">{{pageViewModel.driver.plannedDepartLabel || '—'}}</text>
        </view>
        <view class="driver-metric-divider"></view>
        <view class="driver-metric-col driver-metric-col-arrival">
          <text class="driver-metric-label">首站预计到达</text>
          <text class="driver-metric-time">{{pageViewModel.driver.firstStopPlannedArrivalTimeLabel || '—'}}</text>
          <view
            wx:if="{{pageViewModel.driver.firstStopArrivalStatusLabel}}"
            class="driver-arrival-status-badge driver-arrival-status-{{pageViewModel.driver.firstStopArrivalStatusTone || 'ok'}}"
          >
            <text class="driver-arrival-status-check" wx:if="{{pageViewModel.driver.firstStopArrivalStatusTone === 'ok'}}">✓</text>
            <text>{{pageViewModel.driver.firstStopArrivalStatusLabel}}</text>
          </view>
        </view>
        <view class="driver-metric-divider"></view>
        <view class="driver-metric-col driver-metric-col-return">
          <text class="driver-metric-label">预计返回</text>
          <text class="driver-metric-time">{{pageViewModel.driver.plannedReturnLabel || '—'}}</text>
        </view>
      </view>

      <view class="driver-summary-footer" wx:if="{{pageViewModel.driver.customerStopCount > 0}}">
        <view class="driver-summary-footer-item" wx:if="{{pageViewModel.driver.totalRoundTripDistanceText}}">
          <image class="driver-footer-icon" src="/images/car.png" mode="aspectFit"></image>
          <text>往返 {{pageViewModel.driver.totalRoundTripDistanceText}}</text>
        </view>
        <view class="driver-summary-footer-divider" wx:if="{{pageViewModel.driver.totalRoundTripDistanceText && pageViewModel.driver.totalRoundTripDurationText}}"></view>
        <view class="driver-summary-footer-item" wx:if="{{pageViewModel.driver.totalRoundTripDurationText}}">
          <text class="driver-footer-icon driver-footer-icon-clock">◷</text>
          <text>全程 {{pageViewModel.driver.totalRoundTripDurationText}}</text>
        </view>
      </view>

      <view class="route-edit-section-hint" wx:if="{{pageViewModel.manualDispatchMode}}">拖动顺序后请点击「重新试算」更新预计时间</view>
      <view class="route-edit-section-hint" wx:elif="{{pageViewModel.removeStopMode === 'REMOTE' || pageViewModel.removeStopMode === 'RETURN_TO_SANDBOX'}}">装车中移除将立即生效</view>
      <view class="route-edit-section-hint" wx:else>调整顺序后请点击「重新试算」更新路线</view>

      <route-timeline
        wx:if="{{editTimeline.length > 0}}"
        timeline="{{editTimeline}}"
        variant="edit"
        show-incoming-tag="{{pageViewModel.manualDispatchMode}}"
        route-stops-length="{{routeStops.length}}"
        removing-stop="{{removingStop}}"
        bind:headtap="onTimelineStopHeadTap"
        bind:movestop="onMoveStop"
        bind:removestop="onRemoveStop"
      ></route-timeline>

      <view class="section-empty" wx:if="{{editTimeline.length === 0 && routeStops.length === 0}}">当前路线暂无客户</view>
    </view>

    <view class="section-card bg-white" wx:if="{{!pageViewModel.manualDispatchMode && addableStops.length > 0}}">
      <view class="section-title">可添加客户</view>
      <view class="addable-stop-item" wx:for="{{addableStops}}" wx:key="stopKey">
        <view class="addable-stop-main">
          <view class="route-stop-name">{{item.customerName}}</view>
          <view class="route-stop-goods" wx:if="{{item.goodsSummary}}">{{item.goodsSummary}}</view>
          <view class="route-stop-constraint" wx:if="{{item.constraintHint}}">{{item.constraintHint}}</view>
        </view>
        <view class="route-stop-btn route-stop-btn-primary" catchtap="onAddStop" data-stop-key="{{item.stopKey}}">添加</view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-action-bar" wx:if="{{!loading && pageViewModel}}">
    <view class="bottom-action-row">
      <view class="bottom-btn bottom-btn-secondary" catchtap="onBottomReset">重置</view>
      <view class="bottom-btn bottom-btn-primary {{previewing ? 'bottom-btn-locked' : ''}}" catchtap="onBottomPreview">重新试算</view>
      <view
        class="bottom-btn {{confirmReady ? 'bottom-btn-primary' : 'bottom-btn-disabled'}}"
        catchtap="onBottomConfirm"
      >{{pageViewModel.manualDispatchMode ? '确认排单' : '确认派单'}}</view>
    </view>
    <view class="bottom-action-hint" wx:if="{{pageViewModel.actions.confirmDisabledReason && !confirmReady}}">{{pageViewModel.actions.confirmDisabledReason}}</view>
    <view class="bottom-action-hint" wx:elif="{{pageViewModel.bottomHint}}">{{pageViewModel.bottomHint}}</view>
  </view>

  <time-window-editor
    visible="{{timeWindowModalVisible}}"
    submitting="{{timeWindowSubmitting}}"
    payload="{{timeWindowPayload}}"
    bind:cancel="closeTimeWindowModal"
    bind:confirm="submitTimeWindowModal"
  />
</view>
