<view class="page flex flex-column route-edit-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{pageTitle}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="page-loading-wrap" wx:if="{{loading}}">
    <text class="text-secondary font-md">正在加载路线...</text>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && loadError}}">
    <text class="text-secondary font-md">{{loadError}}</text>
  </view>

  <scroll-view
    scroll-y="{{pageScrollEnabled}}"
    class="page-scroll page-scroll-with-footer"
    wx:if="{{!loading && pageViewModel}}"
  >
    <view class="route-workbench-head" wx:if="{{pageViewModel.driver}}">
      <view class="route-workbench-driver">
        <image class="route-workbench-avatar" src="/images/user-group-2.png" mode="aspectFill"></image>
        <view class="route-workbench-driver-copy">
          <view class="route-workbench-title-row">
            <text class="route-workbench-title">{{pageViewModel.driver.driverName}}</text>
            <text class="route-workbench-badge">编辑中</text>
          </view>
          <text class="route-workbench-subtitle">拖动顺序、增减客户，后台会自动重新计算路线</text>
        </view>
      </view>
    </view>

    <view class="map-overview-card route-map-card" wx:if="{{pageViewModel.mapOverview}}">
      <view class="route-map-topbar">
        <view class="route-map-summary-pill">
          <text>{{routeStops.length}} 个客户</text>
          <view class="route-map-summary-divider"></view>
          <text>{{pageViewModel.driver.totalRoundTripDistanceText || '等待试算'}}</text>
        </view>
        <text class="route-map-source {{pageViewModel.driver.routeMetricEstimated ? 'is-estimated' : ''}}">
          {{pageViewModel.driver.routeMetricSourceLabel || '后台路线距离'}}
        </text>
      </view>

      <view class="map-overview-stage" wx:if="{{pageViewModel.mapOverview.hasMap}}">
        <map
          class="map-overview {{mapInteractionEnabled ? 'is-interactive' : 'is-locked'}}"
          longitude="{{pageViewModel.mapOverview.longitude}}"
          latitude="{{pageViewModel.mapOverview.latitude}}"
          scale="{{pageViewModel.mapOverview.scale}}"
          include-points="{{pageViewModel.mapOverview.includePoints}}"
          padding="{{mapOverviewPadding}}"
          markers="{{pageViewModel.mapOverview.markers}}"
          polyline="{{pageViewModel.mapOverview.polylines}}"
          setting="{{pageViewModel.mapOverview.setting}}"
          enable-poi="{{false}}"
          enable-building="{{false}}"
          enable-scroll="{{mapInteractionEnabled}}"
          enable-zoom="{{mapInteractionEnabled}}"
          enable-rotate="{{false}}"
          show-location="{{false}}"
          show-compass="{{false}}"
          enable-3D="{{false}}"
          bindtouchstart="onMapTouchStart"
          bindtouchend="onMapTouchEnd"
          bindtouchcancel="onMapTouchEnd"
        ></map>
      </view>
      <view class="map-empty-hint" wx:else>
        <text>{{pageViewModel.mapOverview.emptyHint || '仓库或客户缺少坐标，暂时无法显示路线'}}</text>
      </view>
      <view class="map-missing-hint" wx:if="{{pageViewModel.mapOverview.missingHint}}">
        <text>{{pageViewModel.mapOverview.missingHint}}</text>
      </view>

      <view class="route-map-footer">
        <view class="route-map-legend">
          <view class="route-map-legend-line"></view>
          <text>当前配送路线</text>
        </view>
        <view class="route-map-actions" wx:if="{{pageViewModel.mapOverview.hasMap}}">
          <view class="route-map-action" catchtap="onRefreshRoute">↻ 刷新路线</view>
          <view class="route-map-action route-map-action-primary" catchtap="toggleMapInteraction">
            {{mapInteractionEnabled ? '完成操作' : '操作地图'}}
          </view>
        </view>
      </view>
    </view>

    <view class="route-overview-card" wx:if="{{pageViewModel.driver}}">
      <view class="route-overview-metrics">
        <view class="route-overview-metric">
          <text class="route-overview-label">客户</text>
          <text class="route-overview-value route-overview-accent">{{routeStops.length}}</text>
        </view>
        <view class="route-overview-divider"></view>
        <view class="route-overview-metric">
          <text class="route-overview-label">{{routeEndPresentation.distanceScopeLabel}}距离</text>
          <text class="route-overview-value">{{pageViewModel.driver.totalRoundTripDistanceText || '—'}}</text>
        </view>
        <view class="route-overview-divider"></view>
        <view class="route-overview-metric">
          <text class="route-overview-label">全程时间</text>
          <text class="route-overview-value">{{pageViewModel.driver.totalRoundTripDurationText || '—'}}</text>
        </view>
        <view class="route-overview-divider"></view>
        <view class="route-overview-metric">
          <text class="route-overview-label">{{routeEndPresentation.endLabel}}时间</text>
          <text class="route-overview-value">{{routeEndTimeLabel || '—'}}</text>
        </view>
      </view>
    </view>

    <view class="route-estimate-card {{routeDirty ? 'is-dirty' : 'is-ready'}}">
      <view class="route-estimate-icon">{{autoPreviewing ? '↻' : (routeDirty ? '!' : '✓')}}</view>
      <view class="route-estimate-copy">
        <text class="route-estimate-title">{{routeDirty ? '路线正在更新' : '路线试算已完成'}}</text>
        <text class="route-estimate-message">{{routeEstimateStatus}}</text>
      </view>
      <view class="route-estimate-action" wx:if="{{routeDirty && !autoPreviewing}}" catchtap="onRefreshRoute">重试</view>
    </view>

    <view class="driver-route-card bg-white route-edit-card" wx:if="{{pageViewModel.driver}}">
      <view class="route-section-head">
        <view>
          <text class="route-section-title">调整配送顺序</text>
          <text class="route-section-subtitle">每一段距离均由后台按当前门店顺序获取</text>
        </view>
        <text class="route-section-count">{{routeStops.length}} 站</text>
      </view>

      <route-timeline
        wx:if="{{editTimeline.length > 0}}"
        timeline="{{editTimeline}}"
        variant="edit"
        show-incoming-tag="{{pageViewModel.manualDispatchMode}}"
        route-stops-length="{{routeStops.length}}"
        removing-stop="{{removingStop}}"
        show-planning-lock="{{true}}"
        bind:headtap="onTimelineStopHeadTap"
        bind:locktap="onPlanningLockTap"
        bind:movestop="onMoveStop"
        bind:removestop="onRemoveStop"
      ></route-timeline>

      <view class="section-empty" wx:if="{{editTimeline.length === 0 && routeStops.length === 0}}">
        当前路线已清空；确认后将删除路线，客户保留在待分配
      </view>
    </view>

    <view class="customer-add-card" wx:if="{{!pageViewModel.manualDispatchMode}}">
      <view class="customer-add-head">
        <view>
          <text class="customer-add-title">添加路线客户</text>
          <text class="customer-add-subtitle">人工选择客户后，后台按 Huawei 真实道路重新试算</text>
        </view>
        <text class="customer-add-count">{{candidatePoolCount}} 个候选</text>
      </view>

      <view class="customer-search-box">
        <text class="customer-search-icon">⌕</text>
        <input
          class="customer-search-input"
          value="{{customerSearchText}}"
          placeholder="搜索客户名称、地址或商品"
          confirm-type="search"
          bindinput="onCustomerSearchInput"
        />
        <text class="customer-search-clear" wx:if="{{customerSearchText}}" catchtap="onClearCustomerSearch">清除</text>
      </view>

      <view class="customer-candidate-list" wx:if="{{filteredAddableStops.length > 0}}">
        <view class="customer-candidate-item" wx:for="{{filteredAddableStops}}" wx:key="stopKey">
          <view class="customer-candidate-main">
            <view class="customer-candidate-title-row">
              <text class="customer-candidate-name">{{item.customerName}}</text>
              <text class="customer-candidate-risk" wx:if="{{item.blockedReason || item.constraintHint}}">{{item.blockedReason || item.constraintHint}}</text>
            </view>
            <text class="customer-candidate-address">{{item.address || '暂无配送地址'}}</text>
            <text class="customer-candidate-goods" wx:if="{{item.goodsSummary}}">{{item.goodsSummary}}</text>
          </view>
          <view class="customer-candidate-add {{item.blocked ? 'is-disabled' : ''}}" catchtap="onAddStop" data-stop-key="{{item.stopKey}}">{{item.blocked ? '不可添加' : '添加'}}</view>
        </view>
      </view>

      <view class="customer-candidate-empty" wx:elif="{{customerSearchText}}">
        没有找到匹配的待分配客户
      </view>
      <view class="customer-candidate-empty" wx:elif="{{candidatePoolCount === 0}}">
        当前没有可以加入这条路线的客户
      </view>
      <text class="customer-candidate-more" wx:if="{{!customerSearchText && candidatePoolCount > filteredAddableStops.length}}">
        还有 {{candidatePoolCount - filteredAddableStops.length}} 个候选，输入名称可快速查找
      </text>
    </view>

    <view class="route-expansion-card {{!expansionCapability.enabled ? 'is-disabled' : ''}}">
      <view class="route-expansion-head">
        <view class="route-expansion-copy">
          <text class="route-expansion-title">AI补充饭店部门</text>
          <text class="route-expansion-subtitle">保留当前人工路线，并优先为当前司机补满；可同步调整其他司机尚未确认的沙箱建议路线。</text>
          <text class="route-expansion-policy">饭店部门只会保留一份沙箱归属，人工锁定和正式路线不会被移动</text>
          <text class="route-expansion-end-policy">{{routeEndPresentation.policyLabel}}；可工作时长包含驾驶、等待和服务，是否包含返仓由服务端路线策略决定。</text>
        </view>
        <view
          class="route-expansion-action {{!expansionCapability.enabled || expandingRoute || adoptingExpansion || routeDirty || previewing ? 'is-disabled' : ''}}"
          catchtap="onAiExpandRoute"
        >设置条件</view>
      </view>

      <view class="route-expansion-disabled" wx:if="{{!expansionCapability.enabled}}">
        {{expansionCapability.message}}
      </view>
      <view class="route-expansion-refresh" wx:if="{{expansionNeedsRefresh}}">
        路线状态已变化，请先刷新页面再重新生成建议。
      </view>

      <view class="route-expansion-conditions" wx:if="{{expansionConditionsVisible && expansionCapability.enabled}}">
        <view class="route-expansion-condition-title">AI补充条件</view>
        <view class="route-expansion-condition-hint">以下都是整条路线的硬约束，同时填写时必须全部满足。</view>

        <view class="route-expansion-field">
          <text class="route-expansion-field-label">可工作时长</text>
          <view class="route-expansion-duration-row">
            <input
              class="route-expansion-input route-expansion-input-short"
              type="number"
              value="{{expansionForm.durationHours}}"
              placeholder="小时"
              data-field="durationHours"
              bindinput="onExpansionConstraintInput"
            />
            <text class="route-expansion-unit">小时</text>
            <input
              class="route-expansion-input route-expansion-input-short"
              type="number"
              value="{{expansionForm.durationMinutes}}"
              placeholder="分钟"
              data-field="durationMinutes"
              bindinput="onExpansionConstraintInput"
            />
            <text class="route-expansion-unit">分钟</text>
          </view>
        </view>

        <view class="route-expansion-field">
          <text class="route-expansion-field-label">最晚完成时间</text>
          <view class="route-expansion-time-row">
            <picker mode="time" value="{{expansionForm.latestFinishTime}}" bindchange="onExpansionFinishChange">
              <view class="route-expansion-picker {{expansionForm.latestFinishTime ? '' : 'is-placeholder'}}">
                {{expansionForm.latestFinishTime || '选择时间'}}
              </view>
            </picker>
            <text class="route-expansion-clear" wx:if="{{expansionForm.latestFinishTime}}" catchtap="onClearExpansionFinish">清除</text>
          </view>
        </view>

        <view class="route-expansion-field">
          <text class="route-expansion-field-label">全程距离上限</text>
          <view class="route-expansion-value-row">
            <input
              class="route-expansion-input"
              type="digit"
              value="{{expansionForm.maxRoadDistanceKm}}"
              placeholder="例如 30"
              data-field="maxRoadDistanceKm"
              bindinput="onExpansionConstraintInput"
            />
            <text class="route-expansion-unit">公里</text>
          </view>
        </view>

        <view class="route-expansion-field">
          <text class="route-expansion-field-label">最多新增饭店部门</text>
          <view class="route-expansion-value-row">
            <input
              class="route-expansion-input"
              type="number"
              value="{{expansionForm.maxAddedStops}}"
              placeholder="可不填"
              data-field="maxAddedStops"
              bindinput="onExpansionConstraintInput"
            />
            <text class="route-expansion-unit">家</text>
          </view>
        </view>

        <view class="route-expansion-error" wx:if="{{expansionConstraintError}}">{{expansionConstraintError}}</view>
        <view class="route-expansion-condition-actions">
          <view class="route-expansion-condition-cancel" catchtap="onCancelExpansionConditions">取消</view>
          <view
            class="route-expansion-generate {{expandingRoute || adoptingExpansion || routeDirty || previewing ? 'is-disabled' : ''}}"
            catchtap="onGenerateExpansionSuggestion"
          >{{expandingRoute ? '生成中…' : '生成建议'}}</view>
        </view>
        <text class="route-expansion-safety">生成建议不会立即修改正式路线，采用后仍需预览并确认。</text>
      </view>
    </view>

    <view class="route-edit-help-card">
      <text class="route-edit-help-title">编辑说明</text>
      <text class="route-edit-help-line">• 上移、下移、添加或移除门店后会自动重新试算。</text>
      <text class="route-edit-help-line">• 小程序只提交人工确定的客户顺序，不在本地估算距离或时间。</text>
      <text class="route-edit-help-line">• 道路距离、驾驶时间和预计到达均由后台 Huawei 道路服务计算。</text>
      <text class="route-edit-help-line">• 地图、预计到达和店与店之间的距离都会同步刷新。</text>
      <text class="route-edit-help-line">• 确认后只保存当前司机的这条路线。</text>
    </view>
  </scroll-view>

  <view class="bottom-action-bar" wx:if="{{!loading && pageViewModel}}">
    <view class="bottom-action-row">
      <view class="bottom-btn bottom-btn-secondary" catchtap="onBottomReset">恢复原路线</view>
      <view class="bottom-btn bottom-btn-outline {{previewing ? 'bottom-btn-locked' : ''}}" catchtap="onBottomPreview">
        {{previewing ? '计算中…' : '重新计算'}}
      </view>
      <view
        class="bottom-btn {{confirmReady && !routeDirty ? 'bottom-btn-primary' : 'bottom-btn-disabled'}}"
        catchtap="onBottomConfirm"
      >{{pageViewModel.actions.confirmWillDeleteRoute ? '删除这条路线' : (pageViewModel.manualDispatchMode ? '确认排单' : '确认这条路线')}}</view>
    </view>
    <view class="bottom-action-hint" wx:if="{{routeDirty}}">请等待后台完成路线试算后再确认</view>
    <view class="bottom-action-hint" wx:elif="{{pageViewModel.actions.confirmDisabledReason && !confirmReady}}">{{pageViewModel.actions.confirmDisabledReason}}</view>
    <view class="bottom-action-hint" wx:elif="{{pageViewModel.actions.confirmWillDeleteRoute}}">确认后路线卡片将移除，客户保留在本轮待分配</view>
    <view class="bottom-action-hint" wx:elif="{{pageViewModel.bottomHint}}">{{pageViewModel.bottomHint}}</view>
  </view>

  <view
    class="ai-review-mask"
    wx:if="{{expansionReviewVisible && expansionReview}}"
    catchtap="onCancelExpansionReview"
    catchtouchmove="stopExpansionReviewEvent"
  >
    <view class="ai-review-sheet" catchtap="stopExpansionReviewEvent">
      <view class="ai-review-header">
        <view class="ai-review-heading">
          <text class="ai-review-eyebrow">AI 路线增补建议</text>
          <text class="ai-review-title">先看清变化，再决定是否采用</text>
          <text class="ai-review-summary">{{expansionReview.summary}}</text>
          <text class="ai-review-policy">{{expansionReview.candidatePolicyLabel}}</text>
        </view>
        <view class="ai-review-close" catchtap="onCancelExpansionReview">×</view>
      </view>

      <scroll-view class="ai-review-body" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="ai-review-overview">
          <view class="ai-review-overview-item">
            <text class="ai-review-overview-value">{{expansionReview.addedStopCount}}</text>
            <text class="ai-review-overview-label">新增饭店部门</text>
          </view>
          <view class="ai-review-overview-item">
            <text class="ai-review-overview-value">{{expansionReview.originalStops.length}}</text>
            <text class="ai-review-overview-label">原路线总数</text>
          </view>
          <view class="ai-review-overview-item">
            <text class="ai-review-overview-value">{{expansionReview.finalStops.length}}</text>
            <text class="ai-review-overview-label">建议路线总数</text>
          </view>
        </view>
        <view class="ai-review-end-policy">
          <text>{{expansionReview.routeEndPolicyLabel}}</text>
          <text>· {{expansionReview.routeEndLabel}}以服务端试算为准</text>
        </view>

        <view class="ai-review-section">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">来源司机路线调整</text>
            <text class="ai-review-section-count">{{expansionReview.sourceRouteChanges.length}} 条</text>
          </view>
          <view wx:if="{{expansionReview.hasSourceRouteChanges}}">
            <view class="ai-not-selected-item" wx:for="{{expansionReview.sourceRouteChanges}}" wx:key="driverUserId">
              <text class="ai-not-selected-name">{{item.driverLabel}}：{{item.changeLabel}}</text>
              <text class="ai-not-selected-reason">{{item.routeResultLabel}}</text>
            </view>
          </view>
          <view class="ai-review-safety" wx:else>本次新增客户全部来自未分配区域，不调整其他司机路线。</view>
        </view>

        <view class="ai-review-section">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">原路线</text>
            <text class="ai-review-section-count">{{expansionReview.originalStops.length}} 家人工保留</text>
          </view>
          <scroll-view class="ai-route-flow-scroll" scroll-x="true" show-scrollbar="false">
            <view class="ai-route-flow">
              <view
                class="ai-route-chip"
                wx:for="{{expansionReview.originalStops}}"
                wx:key="stopKey"
              >
                <text class="ai-route-chip-seq">{{item.seq}}</text>
                <text class="ai-route-chip-name">{{item.customerName}}</text>
              </view>
              <text class="ai-route-empty" wx:if="{{!expansionReview.originalStops.length}}">当前没有人工保留客户</text>
            </view>
          </scroll-view>
        </view>

        <view class="ai-review-section ai-review-section-added">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">AI 新增客户</text>
            <text class="ai-review-section-count ai-review-count-added">{{expansionReview.addedStops.length}} 家</text>
          </view>
          <view class="ai-added-list" wx:if="{{expansionReview.addedStops.length}}">
            <view class="ai-added-item" wx:for="{{expansionReview.addedStops}}" wx:key="stopKey">
              <text class="ai-added-mark">+</text>
              <text class="ai-added-name">{{item.customerName}}</text>
              <text class="ai-added-label">{{item.sourceLabel}}</text>
            </view>
          </view>
          <view class="ai-added-empty" wx:else>{{expansionReview.emptyCandidateMessage}}</view>
        </view>

        <view class="ai-review-section" wx:if="{{expansionReview.hasCandidateExclusions}}">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">未进入候选的原因</text>
            <text class="ai-review-section-count">{{expansionReview.candidateExclusions.length}} 家</text>
          </view>
          <view
            class="ai-not-selected-item"
            wx:for="{{expansionReview.candidateExclusions}}"
            wx:key="stopKey"
          >
            <text class="ai-not-selected-name">{{item.customerName}}</text>
            <text class="ai-not-selected-reason">{{item.reason}}</text>
          </view>
        </view>

        <view class="ai-review-section">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">最终建议路线</text>
            <text class="ai-review-section-count">保持原客户相对顺序</text>
          </view>
          <view class="ai-final-route">
            <view class="ai-final-stop" wx:for="{{expansionReview.finalStops}}" wx:key="stopKey">
              <view class="ai-final-stop-seq {{item.isAiAdded ? 'is-added' : ''}}">{{item.seq}}</view>
              <view class="ai-final-stop-copy">
                <text class="ai-final-stop-name">{{item.customerName}}</text>
                <text class="ai-final-stop-source {{item.isAiAdded ? 'is-added' : ''}}">{{item.sourceLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="ai-review-section">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">实际使用的硬约束</text>
            <text class="ai-review-section-count">整条路线</text>
          </view>
          <view class="ai-constraint-list">
            <view class="ai-constraint-item" wx:for="{{expansionReview.constraints}}" wx:key="key">
              <text class="ai-constraint-label">{{item.label}}</text>
              <text class="ai-constraint-value">{{item.valueLabel}}</text>
            </view>
          </view>
        </view>

        <view class="ai-review-section">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">路线指标变化</text>
            <text class="ai-review-section-count">Huawei 道路数据</text>
          </view>
          <view class="ai-metric-table">
            <view class="ai-metric-head">
              <text>指标</text>
              <text>原路线</text>
              <text>建议后</text>
              <text>变化</text>
            </view>
            <view class="ai-metric-row" wx:for="{{expansionReview.metrics}}" wx:key="key">
              <text class="ai-metric-label">{{item.label}}</text>
              <text>{{item.beforeLabel}}</text>
              <text class="ai-metric-after">{{item.afterLabel}}</text>
              <text class="ai-metric-delta">{{item.deltaLabel}}</text>
            </view>
          </view>
        </view>

        <view class="ai-review-section" wx:if="{{expansionReview.notSelectedStops.length}}">
          <view class="ai-review-section-head">
            <text class="ai-review-section-title">未采用客户</text>
            <text class="ai-review-section-count">{{expansionReview.notSelectedStops.length}} 家</text>
          </view>
          <view class="ai-not-selected-list">
            <view class="ai-not-selected-item" wx:for="{{expansionReview.notSelectedStops}}" wx:key="stopKey">
              <text class="ai-not-selected-name">{{item.customerName}}</text>
              <text class="ai-not-selected-reason">{{item.reason}}</text>
            </view>
          </view>
        </view>

        <view class="ai-review-safety">
          生成建议不会修改正式路线。采用时会原子更新整个受影响沙箱；采用建议后仍需点击“确认这条路线”。
        </view>
      </scroll-view>

      <view class="ai-review-actions">
        <view class="ai-review-btn ai-review-btn-cancel" catchtap="onCancelExpansionReview">保持原路线</view>
        <view
          class="ai-review-btn {{expansionReview.hasAddedStops && !adoptingExpansion ? 'ai-review-btn-adopt' : 'ai-review-btn-disabled'}}"
          catchtap="onAdoptExpansionProposal"
        >{{adoptingExpansion ? '预览中…' : (expansionReview.hasAddedStops ? '采用并预览' : '暂无可采用饭店部门')}}</view>
      </view>
    </view>
  </view>

  <view
    class="long-term-binding-mask"
    wx:if="{{longTermBindingPickerVisible}}"
    catchtap="closeLongTermBindingPicker"
  >
    <view class="long-term-binding-sheet" catchtap="stopLongTermBindingPickerTap">
      <view class="long-term-binding-handle"></view>
      <view class="long-term-binding-head">
        <view>
          <text class="long-term-binding-eyebrow">锁定司机</text>
          <text class="long-term-binding-title">{{longTermBindingTarget.customerName}}</text>
        </view>
        <view class="long-term-binding-close" catchtap="closeLongTermBindingPicker">×</view>
      </view>
      <view class="driver-lock-mode-grid">
        <view
          class="driver-lock-mode-card {{driverLockMode === 'TODAY' ? 'is-selected' : ''}}"
          data-mode="TODAY"
          catchtap="onDriverLockModeTap"
        >
          <view class="driver-lock-mode-head">
            <text class="driver-lock-mode-title">仅今天锁定</text>
            <text class="driver-lock-mode-check" wx:if="{{driverLockMode === 'TODAY'}}">✓</text>
          </view>
          <text class="driver-lock-mode-help">
            {{longTermBindingTarget.todayLock ? '查看或取消今天的临时锁定' : '只影响今天当前配送批次，明天自动恢复'}}
          </text>
          <text class="driver-lock-mode-current" wx:if="{{longTermBindingTarget.todayLock}}">
            当前：{{longTermBindingTarget.todayLock.driverName}}
          </text>
        </view>
        <view
          class="driver-lock-mode-card {{driverLockMode === 'LONG_TERM' ? 'is-selected' : ''}}"
          data-mode="LONG_TERM"
          catchtap="onDriverLockModeTap"
        >
          <view class="driver-lock-mode-head">
            <text class="driver-lock-mode-title">长期锁定</text>
            <text class="driver-lock-mode-check" wx:if="{{driverLockMode === 'LONG_TERM'}}">✓</text>
          </view>
          <text class="driver-lock-mode-help">
            {{longTermBindingTarget.binding ? '查看、改绑或取消常送司机' : '设为常送司机，以后默认优先安排'}}
          </text>
          <text class="driver-lock-mode-current" wx:if="{{longTermBindingTarget.binding}}">
            当前：{{longTermBindingTarget.binding.driverName}}
          </text>
        </view>
      </view>
      <view class="long-term-binding-explain" wx:if="{{driverLockMode === 'TODAY'}}">
        今天锁定只固定当前路线司机；即使另有常送司机，也只临时覆盖今天，长期关系不会改变。
      </view>
      <view class="long-term-binding-explain" wx:elif="{{driverLockMode === 'LONG_TERM'}}">
        点击下方司机可以改绑；底部可以取消长期锁定。司机未上岗时，本次配送仍可临时改派。
      </view>
      <view class="driver-lock-mode-tip" wx:else>请先选择本次锁定，还是长期锁定。</view>
      <view
        class="driver-lock-primary"
        wx:if="{{driverLockMode === 'TODAY' && !longTermBindingTarget.todayLock}}"
        catchtap="onConfirmTodayDriverLock"
      >确认今天锁定给 {{longTermBindingTarget.currentRouteDriverName}}</view>
      <view
        class="driver-lock-current-status"
        wx:if="{{driverLockMode === 'TODAY' && longTermBindingTarget.todayLock}}"
      >今天已锁定给 {{longTermBindingTarget.todayLock.driverName}}</view>
      <scroll-view class="long-term-binding-list" wx:if="{{driverLockMode === 'LONG_TERM'}}" scroll-y="true" show-scrollbar="false">
        <block wx:for="{{longTermBindingDrivers}}" wx:key="driverUserId">
          <view
            wx:if="{{driverLockMode === 'LONG_TERM' || longTermBindingTarget.currentRouteDriverUserId == item.driverUserId}}"
            class="long-term-binding-driver {{driverLockMode === 'TODAY' && longTermBindingTarget.todayLock && longTermBindingTarget.todayLock.driverUserId == item.driverUserId ? 'is-bound' : ''}} {{driverLockMode === 'LONG_TERM' && longTermBindingTarget.binding && longTermBindingTarget.binding.driverUserId == item.driverUserId ? 'is-bound' : ''}}"
            data-index="{{index}}"
            catchtap="onDriverLockDriverTap"
          >
            <view class="long-term-binding-avatar">司</view>
            <view class="long-term-binding-driver-copy">
              <text class="long-term-binding-driver-name">{{item.driverName}}</text>
              <text
                class="long-term-binding-driver-status"
                wx:if="{{driverLockMode === 'TODAY' && longTermBindingTarget.todayLock && longTermBindingTarget.todayLock.driverUserId == item.driverUserId}}"
              >今天已锁定</text>
              <text
                class="long-term-binding-driver-status"
                wx:elif="{{driverLockMode === 'LONG_TERM' && longTermBindingTarget.binding && longTermBindingTarget.binding.driverUserId == item.driverUserId}}"
              >当前长期绑定</text>
              <text
                class="long-term-binding-driver-status"
                wx:elif="{{longTermBindingTarget.currentRouteDriverUserId == item.driverUserId}}"
              >当前路线司机</text>
            </view>
            <text
              class="long-term-binding-check"
              wx:if="{{driverLockMode === 'TODAY' && longTermBindingTarget.todayLock && longTermBindingTarget.todayLock.driverUserId == item.driverUserId}}"
            >✓</text>
            <text
              class="long-term-binding-check"
              wx:elif="{{driverLockMode === 'LONG_TERM' && longTermBindingTarget.binding && longTermBindingTarget.binding.driverUserId == item.driverUserId}}"
            >✓</text>
            <text class="long-term-binding-arrow" wx:else>›</text>
          </view>
        </block>
        <view class="long-term-binding-empty" wx:if="{{!longTermBindingDrivers.length}}">没有可选择的司机</view>
      </scroll-view>
      <view
        class="long-term-binding-unbind"
        wx:if="{{driverLockMode === 'TODAY' && longTermBindingTarget.todayLock}}"
        catchtap="onCancelTodayDriverLock"
      >取消今天锁定</view>
      <view
        class="long-term-binding-unbind"
        wx:if="{{driverLockMode === 'LONG_TERM' && longTermBindingTarget.binding}}"
        catchtap="onCancelLongTermBinding"
      >取消长期绑定</view>
      <view class="long-term-binding-cancel" catchtap="closeLongTermBindingPicker">返回路线</view>
    </view>
  </view>

  <time-window-editor
    visible="{{timeWindowModalVisible}}"
    submitting="{{timeWindowSubmitting}}"
    payload="{{timeWindowPayload}}"
    bind:cancel="closeTimeWindowModal"
    bind:confirm="submitTimeWindowModal"
  />
</view>
