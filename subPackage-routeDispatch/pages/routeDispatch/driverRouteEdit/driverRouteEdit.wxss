@import '../../bossTab/dispatchPanelShared.wxss';

.route-edit-page {
  background: #f3f6f5;
}

.page-scroll-with-footer {
  flex: 1;
  height: calc(100vh - 120rpx - 172rpx);
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.route-workbench-head {
  margin: 18rpx 20rpx 0;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0fbf8 100%);
  box-shadow: 0 8rpx 28rpx rgba(19, 88, 74, 0.08);
}

.route-workbench-driver {
  display: flex;
  align-items: center;
}

.route-workbench-avatar {
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #e6f4f1;
}

.route-workbench-driver-copy {
  flex: 1;
  min-width: 0;
}

.route-workbench-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-workbench-title {
  color: #18332e;
  font-size: 34rpx;
  font-weight: 700;
}

.route-workbench-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #dff5ef;
  color: #0a8f77;
  font-size: 21rpx;
  font-weight: 600;
}

.route-workbench-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #71827e;
  font-size: 23rpx;
  line-height: 1.45;
}

.route-map-card {
  overflow: hidden;
  margin: 16rpx 20rpx 0;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(26, 69, 61, 0.08);
}

.route-map-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 20rpx;
}

.route-map-summary-pill {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f0f7f5;
  color: #315c54;
  font-size: 23rpx;
  font-weight: 600;
}

.route-map-summary-divider {
  width: 1rpx;
  height: 24rpx;
  background: #c7d9d5;
}

.route-map-source {
  flex-shrink: 0;
  color: #0a8f77;
  font-size: 22rpx;
  font-weight: 600;
}

.route-map-source.is-estimated {
  color: #dc7a16;
}

.map-overview-stage {
  height: 420rpx;
  margin: 0 16rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eaf2f6;
}

.map-overview {
  width: 100%;
  height: 100%;
}

.map-overview.is-locked {
  opacity: 0.98;
}

.map-empty-hint,
.map-missing-hint {
  margin: 0 20rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff8e8;
  color: #b66f1c;
  font-size: 23rpx;
  line-height: 1.5;
}

.map-missing-hint {
  margin-top: 12rpx;
}

.route-map-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 20rpx 20rpx;
}

.route-map-legend {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #667b76;
  font-size: 22rpx;
}

.route-map-legend-line {
  width: 34rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #198f7a;
}

.route-map-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.route-map-action {
  padding: 9rpx 14rpx;
  border-radius: 10rpx;
  background: #f2f5f4;
  color: #50635f;
  font-size: 21rpx;
}

.route-map-action-primary {
  background: #e3f5f0;
  color: #087d69;
}

.route-overview-card {
  margin: 16rpx 20rpx 0;
  padding: 22rpx 12rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(26, 69, 61, 0.06);
}

.route-overview-metrics {
  display: flex;
  align-items: stretch;
}

.route-overview-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.route-overview-label {
  color: #899793;
  font-size: 20rpx;
}

.route-overview-value {
  max-width: 100%;
  margin-top: 9rpx;
  overflow: hidden;
  color: #263b37;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-overview-accent {
  color: #07917a;
  font-size: 31rpx;
}

.route-overview-divider {
  width: 1rpx;
  background: #edf1f0;
}

.route-estimate-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 16rpx 20rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #cfe8e2;
  border-radius: 18rpx;
  background: #effaf7;
}

.route-estimate-card.is-dirty {
  border-color: #f1d6a7;
  background: #fff9ed;
}

.route-estimate-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #d7f2eb;
  color: #078a74;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.is-dirty .route-estimate-icon {
  background: #ffedc9;
  color: #c47412;
}

.route-estimate-copy {
  flex: 1;
  min-width: 0;
}

.route-estimate-title {
  display: block;
  color: #29433e;
  font-size: 24rpx;
  font-weight: 700;
}

.route-estimate-message {
  display: block;
  margin-top: 4rpx;
  color: #71817d;
  font-size: 21rpx;
}

.route-estimate-action {
  flex-shrink: 0;
  color: #ba6b0e;
  font-size: 22rpx;
  font-weight: 600;
}

.route-edit-card {
  margin: 16rpx 20rpx 0;
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 69, 61, 0.07);
}

.route-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.route-section-title {
  display: block;
  color: #1f3833;
  font-size: 31rpx;
  font-weight: 700;
}

.route-section-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #85928f;
  font-size: 21rpx;
}

.route-section-count {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef7f5;
  color: #0b8974;
  font-size: 22rpx;
  font-weight: 600;
}

.route-distance-notice {
  margin-bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #b86d14;
  font-size: 22rpx;
  line-height: 1.5;
}

.section-empty {
  padding: 42rpx 20rpx;
  color: #96a19e;
  font-size: 24rpx;
  text-align: center;
}

.customer-add-card {
  margin: 16rpx 20rpx 0;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(26, 69, 61, 0.07);
}

.customer-add-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.customer-add-title {
  display: block;
  color: #203a35;
  font-size: 31rpx;
  font-weight: 700;
}

.customer-add-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #879590;
  font-size: 22rpx;
}

.customer-add-count {
  flex-shrink: 0;
  color: #0a8d76;
  font-size: 22rpx;
  font-weight: 600;
}

.customer-search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  min-height: 78rpx;
  border: 2rpx solid #dce7e4;
  border-radius: 16rpx;
  background: #f9fbfa;
}

.customer-search-icon {
  color: #83928e;
  font-size: 32rpx;
}

.customer-search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #243934;
  font-size: 25rpx;
}

.customer-search-clear {
  flex-shrink: 0;
  color: #0a8d76;
  font-size: 22rpx;
}

.route-addition-switches {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.route-addition-switch {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 16rpx;
  border: 2rpx solid #e0e9e6;
  border-radius: 16rpx;
  background: #fbfcfc;
}

.route-addition-switch.is-active {
  border-color: #159b83;
  background: #eaf8f4;
  box-shadow: 0 5rpx 14rpx rgba(8, 141, 118, 0.1);
}

.route-addition-switch-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #edf3f1;
  color: #5c746e;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.is-active .route-addition-switch-icon {
  background: #0a927a;
  color: #fff;
}

.route-addition-switch-copy {
  min-width: 0;
}

.route-addition-switch-title,
.route-addition-switch-help {
  display: block;
}

.route-addition-switch-title {
  color: #29413c;
  font-size: 23rpx;
  font-weight: 700;
}

.route-addition-switch-help {
  margin-top: 4rpx;
  overflow: hidden;
  color: #8a9793;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.constraint-editor {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #d5e8e3;
  border-radius: 18rpx;
  background: #f7fbfa;
}

.constraint-editor-head,
.constraint-current-row,
.return-distance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.constraint-editor-head {
  align-items: flex-start;
}

.constraint-editor-title,
.constraint-editor-subtitle {
  display: block;
}

.constraint-editor-title {
  color: #203c36;
  font-size: 27rpx;
  font-weight: 700;
}

.constraint-editor-subtitle {
  margin-top: 5rpx;
  color: #84938f;
  font-size: 20rpx;
}

.constraint-editor-cancel {
  flex-shrink: 0;
  padding: 5rpx 0 8rpx 16rpx;
  color: #0a8c75;
  font-size: 22rpx;
}

.constraint-current-row {
  margin-top: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #eaf5f2;
  color: #647a74;
  font-size: 22rpx;
}

.constraint-current-value {
  color: #117f6c;
  font-weight: 700;
}

.constraint-label {
  display: block;
  margin-top: 20rpx;
  color: #485f59;
  font-size: 22rpx;
  font-weight: 600;
}

.constraint-input-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 0 16rpx;
  border: 2rpx solid #cfdedb;
  border-radius: 14rpx;
  background: #fff;
}

.constraint-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #203b35;
  font-size: 28rpx;
  font-weight: 600;
}

.constraint-input-unit {
  flex-shrink: 0;
  color: #71817d;
  font-size: 22rpx;
}

.return-distance-row {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #fff;
}

.return-distance-copy {
  flex: 1;
  min-width: 0;
}

.return-distance-title,
.return-distance-help {
  display: block;
}

.return-distance-title {
  color: #334c46;
  font-size: 23rpx;
  font-weight: 650;
}

.return-distance-help {
  margin-top: 5rpx;
  color: #8a9793;
  font-size: 19rpx;
}

.route-sequence-field {
  margin-top: 20rpx;
}

.route-sequence-title {
  color: #485f59;
  font-size: 22rpx;
  font-weight: 600;
}

.route-sequence-options {
  display: block;
  margin-top: 10rpx;
}

.route-sequence-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #dde8e5;
  border-radius: 13rpx;
  background: #fff;
}

.route-sequence-option:first-child {
  margin-top: 0;
}

.route-sequence-option.is-active {
  border-color: #83cbbc;
  background: #eef9f6;
}

.route-sequence-copy {
  flex: 1;
  min-width: 0;
}

.route-sequence-name,
.route-sequence-help {
  display: block;
}

.route-sequence-name {
  color: #304a44;
  font-size: 22rpx;
  font-weight: 650;
}

.route-sequence-help {
  margin-top: 3rpx;
  color: #8b9894;
  font-size: 19rpx;
}

.constraint-feedback {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  line-height: 1.5;
}

.constraint-feedback.is-success {
  background: #e8f7f2;
  color: #197d6b;
}

.constraint-feedback.is-warning {
  background: #fff6e7;
  color: #b9711d;
}

.constraint-plan-stats {
  display: flex;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-radius: 14rpx;
  background: #fff;
}

.constraint-plan-stat {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
  border-left: 1rpx solid #edf1f0;
  text-align: center;
}

.constraint-plan-stat:first-child {
  border-left: none;
}

.constraint-plan-value,
.constraint-plan-label {
  display: block;
}

.constraint-plan-value {
  overflow: hidden;
  color: #2d4741;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.constraint-plan-value.is-add {
  color: #078a73;
}

.constraint-plan-label {
  margin-top: 5rpx;
  color: #8d9996;
  font-size: 19rpx;
}

.constraint-apply-btn {
  margin-top: 18rpx;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #078f77;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(7, 143, 119, 0.18);
}

.constraint-apply-btn.is-disabled {
  background: #dfe7e5;
  color: #98a5a1;
  box-shadow: none;
}

.constraint-footnote {
  display: block;
  margin-top: 10rpx;
  color: #8d9996;
  font-size: 19rpx;
  line-height: 1.45;
  text-align: center;
}

.constraint-result {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #cce8e1;
  border-radius: 14rpx;
  background: #edf9f6;
}

.constraint-result-mark {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #d4f0e9;
  color: #078d75;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}

.constraint-result-copy {
  flex: 1;
  min-width: 0;
}

.constraint-result-title,
.constraint-result-text {
  display: block;
}

.constraint-result-title {
  color: #276155;
  font-size: 22rpx;
  font-weight: 700;
}

.constraint-result-text {
  margin-top: 4rpx;
  color: #6c827c;
  font-size: 20rpx;
  line-height: 1.4;
}

.customer-candidate-list {
  margin-top: 12rpx;
}

.customer-candidate-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f0;
}

.customer-candidate-item:last-child {
  border-bottom: none;
}

.customer-candidate-main {
  flex: 1;
  min-width: 0;
}

.customer-candidate-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.customer-candidate-name {
  overflow: hidden;
  color: #213833;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-candidate-risk {
  flex-shrink: 0;
  max-width: 210rpx;
  padding: 3rpx 9rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff4e5;
  color: #c47517;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-candidate-address,
.customer-candidate-goods {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #899692;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-candidate-goods {
  color: #60736e;
}

.customer-candidate-add {
  flex-shrink: 0;
  min-width: 88rpx;
  padding: 13rpx 18rpx;
  border-radius: 12rpx;
  background: #e1f5ef;
  color: #07866f;
  font-size: 23rpx;
  font-weight: 650;
  text-align: center;
}

.customer-candidate-add.is-disabled {
  background: #edf1f0;
  color: #a1aaa7;
}

.customer-candidate-empty {
  padding: 34rpx 0 20rpx;
  color: #98a39f;
  font-size: 23rpx;
  text-align: center;
}

.customer-candidate-more {
  display: block;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf1f0;
  color: #899692;
  font-size: 21rpx;
  text-align: center;
}

.route-edit-help-card {
  margin: 16rpx 20rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #eaf4f1;
}

.route-edit-help-title {
  display: block;
  color: #46645d;
  font-size: 24rpx;
  font-weight: 700;
}

.route-edit-help-line {
  display: block;
  margin-top: 8rpx;
  color: #647b75;
  font-size: 22rpx;
  line-height: 1.5;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e6ecea;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 26rpx rgba(21, 54, 47, 0.08);
}

.bottom-action-row {
  display: flex;
  gap: 10rpx;
}

.bottom-btn {
  flex: 1;
  min-width: 0;
  padding: 18rpx 6rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 650;
  text-align: center;
}

.bottom-btn-secondary {
  background: #f1f4f3;
  color: #51625e;
}

.bottom-btn-outline {
  border: 2rpx solid #0b8b75;
  background: #fff;
  color: #087e6a;
}

.bottom-btn-primary {
  background: #088d76;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(8, 141, 118, 0.22);
}

.bottom-btn-disabled {
  background: #e6ecea;
  color: #9ba6a2;
}

.bottom-btn-locked {
  opacity: 0.65;
}

.bottom-action-hint {
  margin-top: 10rpx;
  color: #8a9692;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: center;
}

.page-loading-wrap,
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
.route-expansion-card {
  margin: 22rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f0faf6;
  border: 1rpx solid #cde9dc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.route-expansion-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.route-expansion-title {
  color: #183f33;
  font-size: 28rpx;
  font-weight: 700;
}

.route-expansion-subtitle {
  color: #668178;
  font-size: 23rpx;
  line-height: 1.45;
}

.route-expansion-action {
  flex: 0 0 auto;
  padding: 16rpx 22rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #159a69;
  font-size: 24rpx;
  font-weight: 600;
}

.route-expansion-action.is-disabled {
  opacity: 0.45;
}

.ai-review-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 28, 23, 0.48);
}

.ai-review-sheet {
  width: 100%;
  max-height: 91vh;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #f5f8f7;
  box-shadow: 0 -16rpx 48rpx rgba(8, 35, 28, 0.18);
}

.ai-review-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 30rpx 22rpx;
  border-bottom: 1rpx solid #e2eae7;
  background: linear-gradient(135deg, #e6f7f0 0%, #f8fbfa 100%);
}

.ai-review-heading {
  flex: 1;
  min-width: 0;
}

.ai-review-eyebrow {
  display: block;
  color: #07866f;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-review-title {
  display: block;
  margin-top: 6rpx;
  color: #173b32;
  font-size: 32rpx;
  font-weight: 750;
}

.ai-review-summary {
  display: block;
  margin-top: 8rpx;
  color: #647a74;
  font-size: 23rpx;
  line-height: 1.45;
}

.ai-review-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-left: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  color: #60736e;
  font-size: 36rpx;
  line-height: 48rpx;
  text-align: center;
}

.ai-review-body {
  height: 66vh;
  padding: 20rpx 0 28rpx;
  box-sizing: border-box;
}

.ai-review-section {
  margin: 0 22rpx 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e3eae8;
  border-radius: 20rpx;
  background: #fff;
}

.ai-review-section-added {
  border-color: #bfe7d5;
  background: #f2fbf7;
}

.ai-review-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.ai-review-section-title {
  color: #213f37;
  font-size: 27rpx;
  font-weight: 700;
}

.ai-review-section-count {
  color: #84938f;
  font-size: 21rpx;
}

.ai-review-count-added {
  color: #07866f;
  font-weight: 650;
}

.ai-route-flow-scroll {
  width: 100%;
  white-space: nowrap;
}

.ai-route-flow {
  display: inline-flex;
  align-items: center;
  min-width: 100%;
  gap: 12rpx;
}

.ai-route-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #edf3f1;
}

.ai-route-chip-seq {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #72857f;
  color: #fff;
  font-size: 19rpx;
}

.ai-route-chip-name {
  max-width: 180rpx;
  overflow: hidden;
  color: #3f5750;
  font-size: 23rpx;
  text-overflow: ellipsis;
}

.ai-route-empty,
.ai-added-empty {
  color: #8d9a96;
  font-size: 23rpx;
}

.ai-added-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-added-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #e3f6ed;
}

.ai-added-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #159a69;
  color: #fff;
  font-size: 27rpx;
  line-height: 1;
}

.ai-added-name {
  flex: 1;
  min-width: 0;
  color: #174b3b;
  font-size: 24rpx;
  font-weight: 650;
}

.ai-added-label {
  color: #4c8875;
  font-size: 20rpx;
}

.ai-final-route {
  display: flex;
  flex-direction: column;
}

.ai-final-stop {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 68rpx;
}

.ai-final-stop:not(:last-child)::after {
  position: absolute;
  left: 20rpx;
  top: 52rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #d8e4e0;
  content: '';
}

.ai-final-stop-seq {
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #72857f;
  color: #fff;
  font-size: 20rpx;
}

.ai-final-stop-seq.is-added {
  background: #159a69;
  box-shadow: 0 0 0 6rpx #dff4eb;
}

.ai-final-stop-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.ai-final-stop-name {
  overflow: hidden;
  color: #304a43;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-final-stop-source {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #edf2f0;
  color: #788782;
  font-size: 19rpx;
}

.ai-final-stop-source.is-added {
  background: #dff4eb;
  color: #07866f;
}

.ai-metric-table {
  overflow: hidden;
  border: 1rpx solid #e5ebe9;
  border-radius: 14rpx;
}

.ai-metric-head,
.ai-metric-row {
  display: grid;
  grid-template-columns: 1.15fr 1fr 1fr 0.9fr;
  align-items: center;
  column-gap: 8rpx;
  padding: 13rpx 12rpx;
  font-size: 20rpx;
  text-align: right;
}

.ai-metric-head {
  background: #f1f5f3;
  color: #84918d;
}

.ai-metric-row {
  color: #65756f;
}

.ai-metric-row + .ai-metric-row {
  border-top: 1rpx solid #edf1ef;
}

.ai-metric-head text:first-child,
.ai-metric-label {
  text-align: left;
}

.ai-metric-label {
  color: #3e544d;
  font-weight: 600;
}

.ai-metric-after {
  color: #143f32;
  font-weight: 650;
}

.ai-metric-delta {
  color: #07866f;
  font-weight: 650;
}

.ai-not-selected-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-not-selected-item {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f5f7f6;
}

.ai-not-selected-name {
  display: block;
  color: #4d605b;
  font-size: 23rpx;
  font-weight: 600;
}

.ai-not-selected-reason {
  display: block;
  margin-top: 6rpx;
  color: #8a9692;
  font-size: 21rpx;
  line-height: 1.4;
}

.ai-review-safety {
  margin: 0 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #e9f4f0;
  color: #55756b;
  font-size: 21rpx;
  line-height: 1.5;
}

.ai-review-actions {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1e8e6;
  background: #fff;
}

.ai-review-btn {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.ai-review-btn-cancel {
  background: #eef2f1;
  color: #50615c;
}

.ai-review-btn-adopt {
  background: #0b9475;
  color: #fff;
  box-shadow: 0 7rpx 18rpx rgba(11, 148, 117, 0.22);
}

.ai-review-btn-disabled {
  background: #e5ebe9;
  color: #9aa5a1;
}
