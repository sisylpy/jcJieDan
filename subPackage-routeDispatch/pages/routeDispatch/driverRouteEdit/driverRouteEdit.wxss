@import '../today/today.wxss';

.page-scroll-with-footer {
  flex: 1;
  height: calc(100vh - 120rpx - 160rpx);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.driver-summary-card,
.section-card,
.risk-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.driver-summary-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2d2b;
}

.driver-summary-metrics {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #008c7a;
  font-weight: 500;
}

.metric-sep {
  color: #999;
}

.driver-summary-sub,
.driver-summary-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.driver-summary-hint {
  color: #008c7a;
}

.edit-map-card {
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.edit-map-stage {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
  background: #eef4f7;
}

.edit-map {
  width: 100%;
  height: 400rpx;
}

.map-legend-compact {
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
}

.edit-map-card .map-empty-hint,
.edit-map-card .map-missing-hint {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.edit-map-card .map-missing-hint {
  color: #d48806;
}

.edit-map-card .map-legend {
  padding: 12rpx 24rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.section-empty {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 24rpx 0;
}

.route-stop-item,
.addable-stop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f1;
}

.route-stop-item:last-child,
.addable-stop-item:last-child {
  border-bottom: none;
  padding-bottom: 20rpx;
}

.route-stop-seq {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #008c7a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.route-stop-main,
.addable-stop-main {
  flex: 1;
  min-width: 0;
}

.route-stop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.route-stop-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.route-stop-new-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #d48806;
  font-size: 20rpx;
  font-weight: 500;
}

.route-stop-goods,
.route-stop-meta,
.route-stop-constraint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.route-stop-constraint {
  color: #d48806;
}

.route-stop-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  width: 196rpx;
}

.route-stop-btn {
  min-width: 60rpx;
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.route-stop-btn-primary {
  background: #e6f7f4;
  color: #008c7a;
}

.route-stop-btn-danger {
  background: #fff1f0;
  color: #cf1322;
}

.route-stop-btn-disabled {
  opacity: 0.35;
}

.addable-stop-item {
  align-items: center;
}

.risk-item {
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.risk-item:last-child {
  margin-bottom: 0;
}

.risk-item-warn {
  background: #fff7e6;
  color: #d48806;
}

.risk-item-error {
  background: #fff1f0;
  color: #cf1322;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef2f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.bottom-action-row {
  display: flex;
  gap: 12rpx;
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.bottom-btn-secondary {
  background: #f7f8fa;
  color: #333;
}

.bottom-btn-primary {
  background: #008c7a;
  color: #fff;
}

.bottom-btn-disabled {
  background: #e8eeec;
  color: #999;
}

.bottom-btn-locked {
  opacity: 0.7;
}

.bottom-action-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.page-loading-wrap,
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
