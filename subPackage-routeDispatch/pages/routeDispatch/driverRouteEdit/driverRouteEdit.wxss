@import '../../bossTab/dispatchPanelShared.wxss';

.page-scroll-with-footer {
  flex: 1;
  height: calc(100vh - 120rpx - 160rpx);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.route-edit-card {
  margin: 16rpx 20rpx 0;
}

.section-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.route-edit-section-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}

.boss-stop-goods {
  margin: 8rpx 20rpx 0;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.route-edit-stop-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.section-empty {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 24rpx 0;
}

.addable-stop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f1;
}

.addable-stop-item:last-child {
  border-bottom: none;
  padding-bottom: 20rpx;
}

.addable-stop-main {
  flex: 1;
  min-width: 0;
}

.route-stop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.route-stop-new-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #d48806;
  font-size: 20rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.route-stop-goods,
.route-stop-constraint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.route-stop-constraint {
  color: #d48806;
}

.route-stop-btn {
  min-width: 88rpx;
  min-height: 56rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-stop-btn-primary {
  background: #e6f7f4;
  color: #008c7a;
}

.route-stop-btn-danger {
  background: #fff1f0;
  color: #cf1322;
}

.route-stop-btn-disabled {
  opacity: 0.35;
}

.route-stop-btn-hover {
  opacity: 0.72;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef2f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.bottom-action-row {
  display: flex;
  gap: 12rpx;
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.bottom-btn-secondary {
  background: #f7f8fa;
  color: #333;
}

.bottom-btn-primary {
  background: #008c7a;
  color: #fff;
}

.bottom-btn-disabled {
  background: #e8eeec;
  color: #999;
}

.bottom-btn-locked {
  opacity: 0.7;
}

.bottom-action-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.page-loading-wrap,
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
