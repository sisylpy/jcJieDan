.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.page-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding-bottom: 32rpx;
}

.page-loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.hero-card {
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #edf9f6 0%, #dff3ee 38%, #d2ece6 100%);
  box-shadow: 0 8rpx 28rpx rgba(0, 140, 122, 0.08);
}

.hero-top {
  position: relative;
  padding: 28rpx 24rpx 20rpx;
  overflow: hidden;
}

.hero-top-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-top-glow-left {
  left: -20rpx;
  top: 10rpx;
  width: 140rpx;
  height: 140rpx;
  background: radial-gradient(circle, rgba(0, 140, 122, 0.16) 0%, rgba(0, 140, 122, 0) 70%);
}

.hero-top-glow-right {
  right: -10rpx;
  top: 0;
  width: 200rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(0, 140, 122, 0.1) 0%, rgba(0, 140, 122, 0) 72%);
}

.hero-top-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
}

.hero-clipboard-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.hero-clipboard-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  background: rgba(0, 140, 122, 0.14);
}

.hero-clipboard-icon {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
}

.hero-top-text {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  padding-right: 8rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.35;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.hero-subtitle-num {
  color: #008c7a;
  font-weight: bold;
  font-size: 26rpx;
  margin-right: 4rpx;
}

.hero-banner {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #008c7a;
  line-height: 1.4;
}

.hero-truck-icon {
  width: 132rpx;
  height: 96rpx;
  flex-shrink: 0;
  opacity: 0.92;
}

.hero-stats-bar {
  display: flex;
  margin: 0 16rpx 16rpx;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hero-stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 0;
}

.hero-stat-col + .hero-stat-col::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1px;
  background: #ececec;
}

.hero-stat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.hero-stat-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}

.hero-stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
  text-align: center;
}

.dispatch-section {
  margin: 0;
}

.driver-route-card {
  margin: 16rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.idle-driver-card {
  margin-top: 16rpx;
}

.driver-route-head {
  display: flex;
  align-items: flex-start;
}

.driver-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.driver-route-head-main {
  flex: 1;
  min-width: 0;
}

.driver-route-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.driver-route-name-row-between {
  justify-content: space-between;
}

.driver-route-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}

.driver-dispatch-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f7f4;
  color: #008c7a;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.driver-dispatch-badge-ok,
.driver-dispatch-badge-active {
  background: #e6f7f4;
  color: #008c7a;
}

.driver-dispatch-badge-warn {
  background: #fff7e6;
  color: #d46b08;
}

.driver-dispatch-badge-muted {
  background: #f5f5f5;
  color: #999;
}

.driver-schedule-headline {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.driver-route-stats {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.route-timeline {
  margin-top: 28rpx;
  padding-left: 8rpx;
}

.timeline-node {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.timeline-node::before {
  content: '';
  position: absolute;
  left: 21rpx;
  top: 44rpx;
  bottom: -8rpx;
  border-left: 2rpx dashed #d0d0d0;
}

.timeline-end::before {
  display: none;
}

.timeline-marker {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-right: 16rpx;
  z-index: 1;
}

.timeline-marker-start,
.timeline-marker-end,
.timeline-marker-stop {
  background: #008c7a;
  color: #fff;
}

.timeline-content {
  flex: 1;
  min-width: 0;
  padding-bottom: 8rpx;
}

.timeline-point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.timeline-point-time {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
  white-space: nowrap;
}

.timeline-stop {
  margin-top: 4rpx;
  margin-bottom: 4rpx;
}

.timeline-stop-content {
  padding-bottom: 16rpx;
}

.timeline-stop-card {
  background: #fff;
  border: 1px solid #eef2f0;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.timeline-stop-content .stop-time-grid {
  border-top: none;
  padding-top: 12rpx;
  margin-top: 12rpx;
}

.timeline-leg {
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 60rpx;
  position: relative;
}

.timeline-leg-line {
  position: absolute;
  left: 21rpx;
  top: 0;
  bottom: 0;
  border-left: 2rpx dashed #d0d0d0;
}

.timeline-leg-info {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.timeline-leg-next .timeline-leg-info {
  background: #edf7f9;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.timeline-leg-car {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  opacity: 0.75;
}

.timeline-leg-arrow {
  margin-right: 8rpx;
  color: #bbb;
}

.stop-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}

.stop-name-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.stop-shop-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.stop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  min-width: 0;
}

.timeline-stop-goods {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.stop-time-grid {
  display: flex;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.stop-time-col {
  flex: 1;
  min-width: 0;
  position: relative;
  padding: 0 12rpx;
}

.stop-time-col:first-child {
  padding-left: 0;
}

.stop-time-col:last-child {
  padding-right: 0;
}

.stop-time-col + .stop-time-col::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 4rpx;
  width: 1px;
  background: #ececec;
}

.stop-time-label {
  display: block;
  font-size: 20rpx;
  color: #aaa;
}

.stop-time-val {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #444;
  word-break: break-all;
}

.stop-window-val {
  color: #e6a23c;
}

.stop-window-warn {
  color: #f56c6c;
}

.stop-next-leg-hint {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f7f7;
  font-size: 22rpx;
  color: #999;
}

.stop-next-leg-car {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  opacity: 0.75;
}

.stop-state-btn {
  flex-shrink: 0;
  line-height: 1.2;
  text-align: center;
}

.stop-state-action {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #008c7a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.stop-state-status {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.stop-state-confirmed {
  background: #e6f7f4;
  color: #008c7a;
}

.stop-state-muted {
  background: #f5f5f5;
  color: #999;
}

.dispatch-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dispatch-stop-body {
  padding-bottom: 8rpx;
}

.dispatch-stop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.dispatch-stop-goods {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #444;
}

.dispatch-stop-meta,
.dispatch-stop-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.dispatch-stop-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
}

.route-primary-action-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid #eef2f0;
}

.route-primary-action-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.route-primary-action-status {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.driver-section {
  margin: 0 24rpx;
  padding-bottom: 16rpx;
}

.idle-driver-head {
  display: flex;
  align-items: flex-start;
}

.idle-driver-main {
  flex: 1;
  min-width: 0;
}

.idle-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}

.idle-title {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.idle-hint {
  font-size: 24rpx;
  color: #aaa;
  text-align: right;
  max-width: 52%;
  line-height: 1.4;
}

.empty-wrap {
  padding: 80rpx 40rpx;
  text-align: center;
}

.unassigned-customer-card {
  padding-bottom: 28rpx;
}

.unassigned-card-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.unassigned-meta-text {
  font-size: 24rpx;
  color: #888;
}

.unassigned-stop-card {
  margin: 0;
}

.unassigned-route-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.unassigned-route-meta-sep {
  margin: 0 8rpx;
}

.stop-service-duration {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
