@import './today/today.wxss';
@import './loading/loading.wxss';

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding-bottom: 32rpx;
}

.missing-field-panel {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fffbe6;
  border: 1px solid #ffe58f;
}

.missing-field-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #ad6800;
  margin-bottom: 8rpx;
}

.missing-field-item {
  font-size: 22rpx;
  color: #ad6800;
  line-height: 1.6;
}

.driver-meta-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.loading-stop-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: #888;
}

.order-block {
  border-top: 1px solid #eef2f0;
  padding: 16rpx 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.order-title {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.order-status {
  font-size: 22rpx;
  color: #008c7a;
}

.stop-action-row {
  padding: 16rpx 24rpx 20rpx;
  border-top: 1px solid #eef2f0;
}

.stop-action-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #008c7a;
  color: #fff;
  font-size: 24rpx;
}

.stop-blocked-reason {
  font-size: 22rpx;
  color: #999;
}

.driver-action-bar {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.driver-action-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.driver-action-btn.primary {
  background: #008c7a;
  color: #fff;
}

.driver-action-btn.secondary {
  background: #fff;
  color: #008c7a;
  border: 1px solid #008c7a;
}

.driver-action-btn-disabled {
  opacity: 0.45;
}

.delivery-stop-list {
  padding: 0 24rpx 24rpx;
}

.delivery-stop-card {
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.delivery-stop-head {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #f0f0f0;
}

.delivery-stop-seq {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #008c7a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.delivery-stop-main {
  flex: 1;
  min-width: 0;
}

.delivery-stop-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.delivery-stop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.delivery-stop-status {
  font-size: 22rpx;
  color: #008c7a;
}

.delivery-stop-status.delivered {
  color: #389e0d;
}

.delivery-stop-status.exception {
  color: #d48806;
}

.delivery-stop-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.delivery-stop-time {
  margin-top: 8rpx;
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #888;
}

.delivery-action-row {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1px solid #f0f0f0;
}

.delivery-action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #008c7a;
  color: #fff;
}

.delivery-action-btn.disabled {
  background: #e8e8e8;
  color: #999;
}

.delivery-action-btn.warning {
  background: #fff7e6;
  color: #d48806;
  border: 1px solid #ffd591;
}

.detail-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 12rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  margin-top: 16rpx;
}

.detail-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #888;
}

.detail-value {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

.detail-value.link {
  color: #008c7a;
}

.detail-value.status {
  color: #008c7a;
  font-weight: 600;
}

.detail-value.status.delivered {
  color: #389e0d;
}

.detail-value.status.exception {
  color: #d48806;
}

.order-section {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.section-title {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-bottom: 1px solid #f0f0f0;
}

.detail-action-bar {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-action-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #008c7a;
  color: #fff;
}

.detail-action-btn.disabled {
  background: #e8e8e8;
  color: #999;
}

.detail-action-btn.warning {
  background: #fff7e6;
  color: #d48806;
  border: 1px solid #ffd591;
}

.empty-wrap {
  padding: 80rpx 40rpx;
  text-align: center;
}
