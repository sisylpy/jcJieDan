<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="dashboard-page flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="经营看板" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="date-filter flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="date-filter-main flex-row" bindtap="toDatePage">
      <view class="p-20">
        <image src="/subPackage-charts/images/purchase/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class="small" wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view wx:if="{{startDate}}">{{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>
    <view class="dashboard-tabs">
      <view class="dashboard-tab {{activeTab == 'date' ? 'is-active' : ''}}" data-tab="date" catchtap="switchDashboardTab">日期</view>
      <view class="dashboard-tab {{activeTab == 'goods' ? 'is-active' : ''}}" data-tab="goods" catchtap="switchDashboardTab">商品</view>
    </view>
  </view>

  <view wx:if="{{activeTab == 'date'}}" class="flex-column">
    <view class="flex-column" wx:if="{{arr.length > 0}}">
      <view class="flex-column p-20 mb-20 bg-white daily-summary">
        <view class="flex-row-between p-20">
          <view class="flex-column">
            <view>
              <view class="font-xs text-secondary">采购总额</view>
              <view class="font-lg font-bold purchase-color">{{allTotal}}元</view>
            </view>
            <view class="font-sm">
              <view class="font-xs text-secondary">平均</view>
              <view class="font-lg font-bold purchase-color">{{purchasePerDay}}元/天</view>
            </view>
          </view>

          <view class="flex-column">
            <view class="flex-column">
              <view class="font-xs text-secondary">成本金额</view>
              <view class="font-lg font-bold cost-color">{{costTotal}}元</view>
              <view class="font-xs font-bold text-secondary">本期:{{costTotalPer}}元</view>
            </view>
            <view class="flex-column font-sm">
              <view class="font-xs text-secondary">平均</view>
              <view class="font-lg font-bold cost-color">{{costPerDay}}元/天</view>
            </view>
          </view>
        </view>

        <view class="daily-chart">
          <ec-canvas id="dailyChart" canvas-id="dailyChart" ec="{{ecDaily}}" style="width: 100%; height: 100%;"></ec-canvas>
        </view>
      </view>

      <view class="bg-white">
        <view class="daily-item flex-column border-bottom p-20" wx:for="{{arr}}" wx:key="day" style="width: {{windowWidth - 40}}rpx;">
          <view class="flex-row-center mb-20">
            <text class="font-md font-bold">{{tool.getMonthDay(item.day)}} {{tool.getWeekDay(item.day)}}</text>
          </view>

          <view class="daily-columns flex-row-between" wx:if="{{item.zicai || item.dinghuo || item.costTotal || item.directStock > 0}}">
            <view class="flex-column daily-column">
              <view class="metric-card flex-column p-20" bindtap="toPurGoodsFenxi" data-item="{{item}}" hover-class="hover">
                <view class="flex-row align-center mb-15">
                  <image src="/images/gouwuche.png" class="metric-icon"></image>
                  <text class="font-sm font-bold">采购</text>
                </view>
                <view class="flex-column">
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">自采:</text><text class="font-xs">{{item.zicai}}元</text></view>
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">订货:</text><text class="font-xs">{{item.dinghuo}}元</text></view>
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">入库:</text><text class="font-xs">{{item.directStock}}元</text></view>
                  <view class="flex-row-between"><text class="font-sm font-bold">合计:</text><text class="font-sm font-bold">{{item.allStock}}元</text></view>
                </view>
              </view>
            </view>

            <view class="flex-column daily-column">
              <view class="metric-card flex-column p-20" bindtap="toFenxiDate" data-index="{{index}}" hover-class="hover">
                <view class="flex-row align-center mb-15">
                  <image src="/subPackage-charts/images/purchase/qiandaizi.png" class="metric-icon"></image>
                  <text class="font-sm font-bold">支出</text>
                </view>
                <view class="flex-column">
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">销售:</text><text class="font-xs">{{item.saleCostTotal}}元</text></view>
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">损耗:</text><text class="font-xs">{{item.lossCostTotal}}元</text></view>
                  <view class="flex-row-between mb-8"><text class="font-xs text-secondary">退货:</text><text class="font-xs">{{item.returnCostTotal}}元</text></view>
                  <view class="flex-row-between"><text class="font-sm font-bold">合计:</text><text class="font-sm font-bold">{{item.costTotal}}元</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state" style="height: {{windowHeight - 360}}rpx;">
      <image class="empty_image" src="/images/cart-Empty.png"></image>
      <text class="big">无数据</text>
    </view>
  </view>

  <view wx:else class="goods-list">
    <view wx:if="{{outArr.length > 0}}">
      <view class="goods-card" wx:for="{{outArr}}" wx:for-item="great" wx:key="nxDistributerFatherGoodsId">
        <view class="flex-row-default goods-card-header">
          <image src="{{url + great.nxDfgFatherGoodsImg}}" mode="aspectFill" class="goods_item_lg mr-20" />
          <view class="font-md">{{great.nxDfgFatherGoodsName}}</view>
        </view>

        <view class="goods-columns flex-row-between">
          <view class="flex-column goods-column">
            <view class="metric-card flex-column p-20" bindtap="toPurGoodsByGreatId" data-id="{{great.nxDistributerFatherGoodsId}}" data-name="{{great.nxDfgFatherGoodsName}}" data-item="{{great.dailyData}}" hover-class="hover">
              <view class="flex-row-between mb-10">
                <view class="flex-row-default align-center mb-15">
                  <image src="/images/gouwuche.png" class="metric-icon"></image>
                  <view class="font-sm font-bold">入库</view>
                </view>
                <view class="donut-chart" style="background: {{great.conicGradient}};">
                  <text class="donut-percent">{{great.dailyData.greatPercent}}%</text>
                </view>
              </view>
              <view class="flex-column">
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">自采:</text><text class="font-xs">{{great.dailyData.zicai}}元</text></view>
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">订货:</text><text class="font-xs">{{great.dailyData.dinghuo}}元</text></view>
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">入库:</text><text class="font-xs">{{great.dailyData.directStock}}元</text></view>
                <view class="flex-row-between"><text class="font-sm font-bold">合计:</text><text class="font-sm font-bold">{{great.dailyData.greatPurTotal}}元</text></view>
              </view>
            </view>
          </view>

          <view class="flex-column goods-column">
            <view class="metric-card flex-column p-20" bindtap="toCostGoodByGreatId" data-id="{{great.nxDistributerFatherGoodsId}}" data-name="{{great.nxDfgFatherGoodsName}}" data-item="{{great.dailyData}}" hover-class="hover">
              <view class="flex-row-between mb-10">
                <view class="flex-row align-center mb-15">
                  <image src="/subPackage-charts/images/purchase/qiandaizi.png" class="metric-icon"></image>
                  <text class="font-sm font-bold">支出</text>
                </view>
                <view class="donut-chart" style="background: {{great.costConicGradient}};">
                  <text class="donut-percent">{{great.dailyData.costPercent}}%</text>
                </view>
              </view>
              <view class="flex-column">
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">销售:</text><text class="font-xs">{{great.dailyData.saleCostTotal}}元</text></view>
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">损耗:</text><text class="font-xs">{{great.dailyData.lossCostTotal}}元</text></view>
                <view class="flex-row-between mb-8"><text class="font-xs text-secondary">退货:</text><text class="font-xs">{{great.dailyData.returnCostTotal}}元</text></view>
                <view class="flex-row-between"><text class="font-sm font-bold">合计:</text><text class="font-sm font-bold">{{great.dailyData.costTotal}}元</text></view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="goods-list-end text-secondary font-xs">没有数据了！</view>
    </view>

    <view wx:else class="empty-state" style="height: {{windowHeight - 360}}rpx;">
      <image class="empty_image" src="/images/cart-Empty.png"></image>
      <text class="big">无数据</text>
    </view>
  </view>
</view>
