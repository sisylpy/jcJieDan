.dashboard-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.dashboard-tabs {
  display: flex;
  flex-shrink: 0;
  padding: 6rpx;
  border: 1rpx solid #d8e8e4;
  border-radius: 12rpx;
  background-color: #f3f8f7;
}

.dashboard-tab {
  width: 72rpx;
  height: 56rpx;
  border-radius: 8rpx;
  color: #7a817f;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
}

.dashboard-tab.is-active {
  background-color: #187e6e;
  color: #ffffff;
  font-weight: 600;
}

.date-filter {
  min-height: 120rpx;
}

.date-filter-main {
  min-width: 0;
  flex: 1;
}

.daily-summary {
  padding-bottom: 40rpx;
}

.daily-chart {
  height: 400rpx;
  margin-top: 20rpx;
}

.purchase-color {
  color: #007aff;
}

.cost-color {
  color: #05c0a7;
}

.daily-item {
  background-color: #f5f5f5;
}

.daily-columns,
.goods-columns {
  gap: 20rpx;
}

.daily-column,
.goods-column {
  flex: 1;
  min-width: 0;
}

.metric-card {
  border-radius: 12rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.metric-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.goods-list {
  min-height: 100vh;
  padding: 20rpx;
  background-color: #f5f5f5;
}

.goods-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.goods-card-header {
  align-items: center;
  margin-bottom: 24rpx;
}

.donut-chart {
  position: relative;
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  border-radius: 50%;
}

.donut-percent {
  position: relative;
  z-index: 2;
  display: flex;
  width: 60%;
  height: 60%;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #ffffff;
  color: #333333;
  font-size: 18rpx;
  font-weight: bold;
}

.goods-list-end {
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.hover {
  background-color: #f0f0f0 !important;
}
