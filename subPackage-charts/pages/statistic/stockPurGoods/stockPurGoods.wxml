<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="商品" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePageSearch">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <!-- NX系统暂不支持筛选功能 -->
  </view>



  <view class="flex-column" wx:if="{{arr.length > 0}}">



    <view class="flex-column  bg-white ">

      <!-- 商品详情卡片 -->
      <view class="flex-column border-bottom p-20" wx:for-item="goods" wx:key="nxDistributerGoodsId" wx:for="{{arr}}">
        <!-- 商品信息头部 -->
        <view class="flex-row-default mb-20">
          <image bindtap="showDialogBtn" data-item="{{goods}}" src="{{url + goods.nxDgGoodsFile}}" mode="aspectFill" class="url_item mr-20" />
          <view class="flex-column" >
            <text class="font-sm">第{{index + 1}}名/共{{totalCount}}个</text>
            <view class="flex-row mb-10">
               <text class="brand">{{goods.nxDgGoodsBrand}}</text>
              <text class="font-bold mr-10">{{goods.nxDgGoodsName}}</text>
              <block wx:if="{{goods.nxDgGoodsStandardWeight && goods.nxDgGoodsStandardWeight.length > 0}}">
                <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
              </block>
              <block wx:else>
                <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardname}})</text>
              </block>
            </view>
          </view>
        </view>

        <view class="flex-column purchase-row-container">
          <view class="flex-column mt-20" wx:for="{{goods.nxDisGoodsShelfStockEntities}}" wx:for-item="pur" wx:for-index="purIndex" catch:tap="showDetail" data-goods-index="{{index}}" data-pur-index="{{purIndex}}">
          
              <!-- 采购批次默认显示 - 蓝色主题 -->
              <view class="flex-row purchase-row purchase-row-active {{pur.expanded ? 'purchase-row-active' : ''}}">

                <!-- 左侧时间 -->
                <view class="flex-row mr-20">
                  <view class="flex-column" >
                    <view class="font-md flex-row">{{tool.transferDateString(pur.nxDgssDate)}}</view>
                    <block wx:if="{{pur.purchaseDepartmentUser !== null}}">
                      <text class="purchase-type">自采</text>
                  </block>
                  <block wx:else="">
                      <text class="purchase-type">订货</text>
                  </block>
                  </view>
                </view>
                <!-- 中间采购信息 -->
                <view class="flex-column" style="flex: 1;">
                  <view class="flex-row-between">
                    <text class="font-bold">{{pur.nxDgssWeight}}({{goods.nxDgGoodsStandardname}})</text>
                    <text class="purchase-info-value-amount mr-20">{{pur.nxDpgBuySubtotal}}元</text>
                  </view>
                  <view class="flex-row-between mt-5">
                    <text class="purchase-date">{{pur.nxDpgBuyPrice}}元/{{goods.nxDgGoodsStandardname}}</text>
                    <block wx:if="{{pur.purchaseDepartmentUser !== null}}">
                      <text class="purchase-date mr-20">{{pur.purchaseDepartmentUser.gbDuWxNickName}}</text>
                    </block>
                    <block wx:elif="{{pur.nxJrdhSupplierEntity !== null}}">
                      <text class="purchase-date mr-20">{{pur.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                    </block>

                  </view>
                </view>

                <!-- 右侧箭头 -->
                <view class="flex-column-center">
                  <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon {{pur.expanded ? 'expanded' : 'collapsed'}}" style="width: 24rpx; height: 24rpx;" />
                </view>

              </view>
      
              <!-- 库存详细信息 - 蓝色主题 wx:if="{{pur.expanded}}" -->
              <view  class="purchase-info-card expandable-content expanded" wx:if="{{pur.reduceEntityList.length > 0}}">

                <!-- 库存详细信息 -->
                <view class="purchase-detail-section" wx:for="{{pur.reduceEntityList}}" wx:for-item="stock">
         
                  <!-- 库存信息行布局 -->
                  <!-- type == 0 -->
                  <block  wx:if="{{stock.nxDgssrType == 0}}">
                    <view class="stock-info-row">
                    <!-- 左侧：部门信息 -->
                  
                    <view class="stock-department-info" >
                      <view class="font-xs">{{tool.transferDateString(stock.nxDgssrDate)}}</view>
                      <text class="font-bold">出货</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                      <view class="stock-info-column purchase-inbound">
                        <text class="column-label">{{stock.departmentName}}</text>
                        <view class="column-content">
                          <text class="amount-text">{{stock.orderQuantity}}{{stock.orderStandard}}</text>
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label rest-weight">出库</view>
                        <view class="column-content">
                          <text class="weight-text rest-weight">{{stock.nxDgssrProduceWeight}}{{goods.nxDgGoodsStandardname}}</text>
                          <text class="amount-text rest-amount">{{stock.nxDgssrProduceSubtotal}}元</text>
                      
                        </view>
                      </view>
                    </view>
                  </view>
                  </block>
                  <!-- ../type == 0 -->

                  <!-- type == 1 -->
                  <block  wx:if="{{stock.nxDgssrType == 1}}">
                    <view class="stock-info-row">
                    <!-- 左侧：部门信息 -->
                    <view class="font-md flex-row">{{tool.transferDateString(stock.nxDgssrDate)}}</view>
                    <view class="stock-department-info">
                      <text class="font-bold">{{stock.departmentName}}</text>
                    </view>
                    <view class="stock-department-info">
                      <text class="font-bold">出售</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                    
                      <view class="stock-info-column purchase-inbound">
                        <view class="column-label">入库</view>
                        <view class="column-content">
                          <text class="amount-text">{{stock.nxDgsSubtotal}}元</text>
                          <text class="weight-text">{{stock.nxDgsWeight}}{{goods.nxDgGoodsStandardname}}</text>
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label rest-weight">出库</view>
                        <view class="column-content">
                          <text class="amount-text rest-amount">{{stock.nxDgssrProduceSubtotal}}元</text>
                          <text class="weight-text rest-weight">{{stock.nxDgssrProduceWeight}}{{goods.nxDgGoodsStandardname}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  </block>
                  <!-- ../type == 1 -->


                  <!-- type == 2 -->
                  <block  wx:if="{{stock.nxDgssrType == 2}}">
                    <view class="stock-info-row">
                    <!-- 左侧：部门信息 -->
                   
                    <view class="stock-department-info" >
                      <view class="font-xs">{{tool.transferDateString(stock.nxDgssrDate)}}</view>
                      <text class="font-bold">盘库损耗</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                     
                      <view class="stock-info-column purchase-inbound" >
                        <view class="column-label">盘库人</view>
                        <view class="column-content">
                          <text class="amount-text">{{stock.doUserName}}</text>
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label rest-weight">损耗</view>
                        <view class="column-content">
                          <text class="weight-text rest-weight">{{stock.nxDgssrCostWeight}}{{goods.nxDgGoodsStandardname}}</text>
                          <text class="amount-text rest-amount">{{stock.nxDgssrCostSubtotal}}元</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  </block>

                  <!-- ../type == 2 -->

                  <!-- type == 3 -->
                  <block  wx:if="{{stock.nxDgssrType == 3}}">
                    <view class="stock-info-row">
                    <!-- 左侧：部门信息 -->
                    <view class="stock-department-info">
                      <text class="font-bold">{{stock.departmentName}}</text>
                    </view>
                  
                    <view class="stock-department-info">
                      <text class="font-bold">盘库损耗</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                     
                      <view class="stock-info-column purchase-inbound" >
                        <view class="column-label">盘库人</view>
                        <view class="column-content">
                          <text class="amount-text">{{stock.doUserName}}元</text>
                          <!-- <text class="weight-text">{{stock.nxDgsWeight}}{{goods.nxDgGoodsStandardname}}</text> -->
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label rest-weight">出库</view>
                        <view class="column-content">
                          <text class="amount-text rest-amount">{{stock.nxDgssrProduceSubtotal}}元</text>
                          <text class="weight-text rest-weight">{{stock.nxDgssrProduceWeight}}{{goods.nxDgGoodsStandardname}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  </block>

                  <!-- ../type == 3 -->

                  <!-- type == 4 -->
                  <block  wx:if="{{stock.nxDgssrType == 4}}">
                    <view class="stock-info-row">
                    <!-- 左侧：部门信息 -->
                    <view class="stock-department-info">
                      <text class="font-bold">{{stock.departmentName}}</text>
                    </view>
                   
                    <view class="stock-department-info">
                      <text class="font-bold">退货</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                      <view class="stock-info-column purchase-inbound" >
                        <view class="column-label">盘库人</view>
                        <view class="column-content">
                          <text class="amount-text">{{stock.doUserName}}元</text>
                          <!-- <text class="weight-text">{{stock.nxDgsWeight}}{{goods.nxDgGoodsStandardname}}</text> -->
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label rest-weight">出库</view>
                        <view class="column-content">
                          <text class="amount-text rest-amount">{{stock.nxDgssrProduceSubtotal}}元</text>
                          <text class="weight-text rest-weight">{{stock.nxDgssrProduceWeight}}{{goods.nxDgGoodsStandardname}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  </block>

                  <!-- ../type == 4 -->

                </view>
              </view>

          </view>
        </view>
        <!-- <view class="flex-column purchase-row-container">
          <view class="flex-column mt-20 mb-20" wx:for="{{goods.nxDisGoodsShelfStockEntities}}" wx:for-item="stock" wx:for-index="stockIndex" catch:tap="showDetail" data-goods-index="{{index}}" data-pur-index="{{stockIndex}}">
          
              <view class="flex-row purchase-row purchase-row-active">

                <view class="flex-row mr-20">
                  <view class="flex-column">
                    <view class="font-xs flex-row">{{tool.transferDateString(stock.nxDgssDate)}}</view>
                    <text class="font-bold">{{stock.nxDgssWeight}}{{goods.nxDgGoodsStandardname}}</text>
                  </view>
                </view>
                <view class="flex-column" style="flex: 1;">
                  <view class="flex-row-between">
                    <text class="font-bold">{{stock.nxDgssRestWeight}}{{goods.nxDgGoodsStandardname}}</text>
                    <text class="purchase-info-value-amount mr-20">{{stock.nxDgssRestSubtotal}}元</text>
                  </view>
                  <view class="flex-row-between mt-5">
                    <text class="purchase-date">{{stock.nxDgssPrice}}元/{{goods.nxDgGoodsStandardname}}</text>
                  </view>
                </view>

               
              </view>
      
             
          </view>
        </view> -->

        <!-- 商品库存总金额 - 在库存批次下方 -->
        <!-- <view class="flex-row-between mt-30 mb-20">
          <text class="font-bold text-secondary">库存总金额</text>
          <text class="font-bold price-value" style="color: #ff6b35; font-size: 32rpx;">¥{{goods.sellSubtotal}}</text>
        </view> -->

      </view>

    </view>


    <!-- 分页提示 -->
    <view class="font-sm center-content flex-column" wx:if="{{arr.length > 0}}">
      <view class="flex-row">
        <text class="text-secondary">共 {{totalCount}} 条记录，第 {{currentPage}}/{{totalPage}} 页</text>
      </view>
      <view class="flex-row mt-10" wx:if="{{currentPage < totalPage}}">
        <text class="text-secondary">上拉加载更多</text>
      </view>
      <view class="flex-column-center  mt-20" wx:if="{{currentPage >= totalPage}}">
        <text class="text-secondary">已加载全部数据</text>
        <view class="font-sm  flex-column-center "  wx:if="{{currentPage == totalPage}}">
          <view class="flex-row">
            <image src="{{url + '/userImage/daodile3.png'}}" mode="aspectFill" class="icon-lg margin-right" />
            <view style="line-height: 200rpx;">没有数据啦!</view>
          </view>

        </view>
      </view>
    </view>




  </view>
  <!-- </block> -->

  <view class="{{arr.length == 0 ? 'show' : 'hide'}}" style="height: {{windowHeight - 360}}rpx;">

    <view class="center-content flex-column" style="padding-top: 200rpx;">
      <image class="empty_image" src="/images/cart-Empty.png"></image>
      <text class="big">无数据</text>
    </view>

  </view>
  <!-- ./empty -->


</view>