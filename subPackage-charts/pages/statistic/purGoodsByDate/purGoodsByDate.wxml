<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="flex-column flex">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{greatId !== '-1' ? name : '日进货'}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>



  <!--  search-top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePageSearch">
        <image src="../../../../images/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <!-- NX系统暂不支持筛选功能 -->
  </view>

  <view class="page-container" >
    <scroll-view scroll-y="true" bindscrolltolower="onReachBottom" bindscroll="onScroll" style="background-color: #f5f5f5; height: {{scrollViewHeight}}rpx;">

      <!-- 顶部统计卡片 -->
      <view class="stats-container">
        <view class="stat-card purchase-card" bind:tap="onTab1Click" data-type="0" data-index="0" hover-class="hover">
          <view class="stat-title">自采</view>
          <view class="stat-value">{{zicai}}元</view>
          <view class="stat-details">
            <view class="stat-subtitle">商品{{zicaiCount}}个</view>
          </view>
        </view>
        <view class="stat-card total-card" bind:tap="onTab1Click" data-type="1" data-index="1" hover-class="hover">
          <view class="stat-title">订货</view>
          <view class="stat-value">{{dinghuo}}元</view>
          <view class="stat-details">
            <view class="stat-subtitle">商品{{dinghuoCount}}个</view>
          </view>
        </view>
        <view class="stat-card ratio-card" bind:tap="onTab1Click" data-type="10" data-index="2" hover-class="hover">
          <view class="stat-title">入库</view>
          <view class="stat-value">{{ruku}}元</view>
          <view class="stat-details">
            <view class="stat-subtitle">商品{{rukuCount}}个</view>
          </view>
        </view>
      </view>


      <view class="flex-column  bg-white" wx:if="{{arr.length > 0}}">

        <!-- 商品详情卡片 startDate=2025-11-16&stopDate=2025-11-16&type=0&hanzi=星期日&disId=151-->
        <view class="flex-column border-bottom p-20" wx:for-item="goods" wx:key="nxDistributerGoodsId" wx:for="{{arr}}" id="goods-container-{{index}}">

          <!-- 商品信息头部subPackage-charts/pages/statistic/purchaseDeatil/purchaseDeatil -->
          <view class="flex-row-between" bind:tap="showList" data-index="{{index}}">
            <view class="flex-row-default mb-20">
              <image src="{{url + goods.nxDgGoodsFile}}" mode="aspectFill" class="goods-image mr-20" />
              <view class="flex-column">
                <text class="font-sm">第{{index + 1}}名/共{{totalCount}}个</text>
                <view class="flex-row mb-10">
                  <text class="font-bold mr-10">{{goods.nxDgGoodsName}}</text>
                  <block wx:if="{{goods.nxDgGoodsStandardWeight && goods.nxDgGoodsStandardWeight.length > 0}}">
                    <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
                  </block>
                  <block wx:else>
                    <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardname}})</text>
                  </block>
                </view>

              </view>

            </view>

            <!-- 右侧总计和按钮 -->
            <view class="goods-price-section">
              <view class="price-container">
                <text class="price-label">总计</text>
                <text class="price-value">¥{{goods.sellSubtotal}}</text>
              </view>
              <!-- 右侧箭头 -->
              <view class="arrow-container {{goods.showPurchaseList ? 'expanded' : 'collapsed'}}">
                <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" style="width: 24rpx; height: 24rpx;" />
              </view>
            </view>

          </view>


          <!-- 采购详情 -->
          <!-- 采购批次列表 - 默认隐藏，点击showList后显示 -->
          <view wx:if="{{goods.showPurchaseList && goods.nxDistributerPurchaseGoodsEntities && goods.nxDistributerPurchaseGoodsEntities.length > 0}}" class="flex-column purchase-row-container expandable-content expanded">

            <view class="flex-column " wx:for="{{goods.nxDistributerPurchaseGoodsEntities}}" wx:for-item="pur" wx:for-index="purIndex" wx:key="purIndex">

              <!-- 采购批次默认显示 - 蓝色主题 -->
              <view class="flex-row purchase-row {{pur.expanded ? 'purchase-row-active' : ''}}" catch:tap="showDetail" data-goods-index="{{index}}" data-pur-index="{{purIndex}}">

                <!-- 左侧时间 -->
                <view class="flex-row mr-20">
                  <view class="flex-column">
                    <view class="font-md flex-row">{{tool.transferDateString(pur.nxDpgPurchaseDate)}}</view>
                  
                    <text class="purchase-type">{{pur.nxDpgPurchaseType == 10 ? '直接入库' : (pur.nxDpgPurchaseType == 11 ? '自采' : '订货')}}</text>
                  </view>
                </view>
                <!-- 中间采购信息 -->
                <view class="flex-column" style="flex: 1;">
                  <view class="flex-row-between">
                    <text class="font-bold">{{pur.nxDpgBuyQuantity}}{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' ? goods.nxDgCartonUnit : goods.nxDgGoodsStandardname}}</text>
                    <text class="purchase-info-value-amount mr-20">{{pur.nxDpgBuySubtotal}}元</text>
                  </view>
                  <view class="flex-row-between mt-5">
                    <text class="purchase-date">{{pur.nxDpgBuyPrice || 0}}元/{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' ? goods.nxDgCartonUnit : goods.nxDgGoodsStandardname}}</text>
                  </view>
                </view>

                <!-- 右侧箭头 -->
                <view class="flex-column-center">
                  <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon {{pur.expanded ? 'expanded' : 'collapsed'}}" style="width: 24rpx; height: 24rpx;" />
                </view>

              </view>


              <!-- 修改最新的库存样式！ -->
              <!-- 采购详细信息 - 蓝色主题 -->
              <view wx:if="{{pur.expanded}}" class="purchase-info-card expandable-content expanded">

                <!-- 库存详细信息 - NX系统 -->
                <view class="purchase-detail-section" wx:for="{{pur.nxDisGoodsShelfStockEntities}}" wx:for-item="stock" wx:key="index">

                  <!-- 库存信息行布局 -->
                  <view class="stock-info-row">
                    <!-- 左侧：货架信息 -->
                    <view class="stock-department-info">
                      <text class="font-bold">{{stock.shelfName}} L{{stock.nxDgsgShelfLayer}}-{{stock.nxDgsgShelfLayerSeq}}</text>
                    </view>

                    <!-- 右侧：金额信息对比 -->
                    <view class="stock-comparison-container">
                      <!-- 入库信息 -->
                      <view class="stock-info-column stock-inbound">
                        <view class="column-label">入库</view>
                        <view class="column-content">
                          <text class="amount-text">{{stock.nxDgssSubtotal}}元</text>
                          <text class="weight-text">
                            <block wx:if="{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' && goods.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(stock.nxDgssWeight || 0, goods.nxDgCartonUnit, goods.nxDgItemsPerCarton, goods.nxDgGoodsStandardname)}}</block>
                            <block wx:else>{{stock.nxDgssWeight || 0}}{{goods.nxDgGoodsStandardname}}</block>
                          </text>
                        </view>
                      </view>

                      <!-- 分隔线 -->
                      <view class="comparison-divider"></view>

                      <!-- 剩余信息 -->
                      <view class="stock-info-column stock-rest">
                        <view class="column-label">剩余</view>
                        <view class="column-content">
                          <text class="amount-text rest-amount">{{stock.nxDgssRestSubtotal || 0}}元</text>
                          <text class="weight-text rest-weight">
                            <block wx:if="{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' && goods.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(stock.nxDgssRestWeight || 0, goods.nxDgCartonUnit, goods.nxDgItemsPerCarton, goods.nxDgGoodsStandardname)}}</block>
                            <block wx:else>{{stock.nxDgssRestWeight || 0}}{{goods.nxDgGoodsStandardname}}</block>
                          </text>
                        </view>
                      </view>
                    </view>
                  </view>

                </view>
              </view>

            </view>


          </view>
          <!--  -->

        </view>

        <!-- 分页提示 -->
        <view class="font-sm center-content flex-column p-20" wx:if="{{arr.length > 0}}">
          <view class="flex-row">
            <text class="text-secondary">共 {{totalCount}} 条记录，第 {{currentPage}}/{{totalPage}} 页</text>
          </view>
          <view class="flex-row mt-10" wx:if="{{currentPage < totalPage}}">
            <text class="text-secondary">上拉加载更多</text>
          </view>
          <view class="flex-row mt-10" wx:if="{{currentPage >= totalPage}}">
            <text class="text-secondary">已加载全部数据</text>
          </view>
        </view>

        <view class="font-sm center-content flex-column " wx:if="{{currentPage == totalPage}}">
          <view class="flex-row">
            <image src="{{url + '/userImage/daodile3.png'}}" mode="aspectFill" class="icon-lg margin-right" />
            <view style="line-height: 200rpx;">没有数据啦!</view>
          </view>

        </view>
      </view>

  <!-- </block> -->

  <view  wx:else="" style="height: {{windowHeight - 660}}rpx;">

<view class="center-content flex-column" >
  <image class="empty_image" src="/images/cart-Empty.png"></image>
  <text class="big">无采购数据</text>
</view>

</view>
<!-- ./empty -->


    </scroll-view>
  </view>


</view>