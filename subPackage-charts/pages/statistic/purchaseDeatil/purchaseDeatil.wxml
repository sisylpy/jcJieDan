                  <view class="flex-row mb-10">
                    <text class="font-bold mr-10">{{goods.nxDgGoodsName}}</text>
                    <block wx:if="{{goods.nxDgGoodsStandardWeight && goods.nxDgGoodsStandardWeight.length > 0}}">
                      <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
                    </block>
                    <block wx:else>
                      <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardname}})</text>
                    </block>
                  </view>

                </view>

              </view>

              <!-- 右侧总计和按钮 -->
              <view class="goods-price-section">
                <view class="price-container">
                  <text class="price-label">采购</text>
                  <text class="price-value">¥{{goods.sellSubtotal}}</text>
                </view>
                <!-- 右侧箭头 -->
                <view class="arrow-container {{goods.showPurchaseList ? 'expanded' : 'collapsed'}}">
                  <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" style="width: 24rpx; height: 24rpx;" />
                </view>
              </view>
            </view>

            <!-- 采购批次列表 - 默认隐藏，点击showList后显示 -->
            <view class="flex-column purchase-row-container expandable-content {{goods.showPurchaseList ? 'expanded' : ''}}">

              <view class="flex-column " wx:for="{{goods.nxDistributerPurchaseGoodsEntities}}" wx:for-item="pur" wx:for-index="purIndex" catch:tap="showDetail" data-user-index="{{userIndex}}" data-goods-index="{{index}}" data-pur-index="{{purIndex}}">

                <!-- 采购批次默认显示 - 蓝色主题 -->
