<wxs src="../../../../utils/fn.wxs" module="tool" />


<view class="flex flex-column">


   
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{pageTitle}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <!--  top -->
  <view class=" flex-row-between pl-20 pr-20 border-bottom bg-white">
    <view class="flex-row">
      <view class="p-20" bindtap="toDatePage">
        <image src="/subPackage-charts/images/purchase/calender.png" class="icon"></image>
      </view>
      <view class="flex-column pt-10">
        <view class="font-yuan">{{hanzi}}</view>
        <view class="flex-row" wx:if="{{startDate == stopDate}}">
          <view class=" small" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
        </view>
        <view class="flex-row" wx:else>
          <view class="" wx:if="{{startDate}}"> {{tool.transferDateString(startDate)}}</view>
          <text class="plr-10">-</text>
          <view class="" wx:if="{{stopDate}}">{{tool.transferDateString(stopDate)}}</view>
        </view>
      </view>
    </view>

    <view class="flex-row p-20" bindtap="toFilterType">
      <image src="{{searchDepId !== -1 ? '../../../../../images/filter.png' : '../../../../../images/filter-3-fill.png'}}" class="icon mr-20"></image>
    </view>
  </view>

  <!-- 供货商选择显示 -->
  <view class="supplier-filter-container" wx:if="{{selectedSupplierNames && selectedSupplierNames.length > 0}}">
    <view class="supplier-filter-chip">
      <text class="supplier-filter-text">{{selectedSupplierNames}}</text>
      <view class="supplier-filter-delete" bindtap="delSupplierSearch">
        <image src="/images/del-2.png" mode="aspectFill" class="supplier-delete-icon"></image>
      </view>
    </view>
  </view>

  <!-- 采购员选择显示 -->
  <view class="supplier-filter-container" wx:if="{{selectedPurUserNames && selectedPurUserNames.length > 0}}">
    <view class="supplier-filter-chip purchase-user-chip">
      <text class="supplier-filter-text">采购员: {{selectedPurUserNames}}</text>
      <view class="supplier-filter-delete" bindtap="delPurchaseUserSearch">
        <image src="/images/del-2.png" mode="aspectFill" class="supplier-delete-icon"></image>
      </view>
    </view>
  </view>


  <!--  -->
    <block wx:if="{{type == 0 || type == 10}}">
    <block wx:if="{{purUserArr.length > 0}}">
      <view class="flex-column border-bottom  p-20 bg-white" wx:for="{{purUserArr}}" wx:for-index="userIndex" wx:key="nxDistributerUserId">

        <view class="user-info-card" bind:tap="toggleUserDetail" data-user-index="{{userIndex}}" hover-class="hover">
          <view class="user-info-header">
            <image src='{{url + item.user.nxDiuWxAvartraUrl}}' class="user-avatar"></image>
            <view class="user-details">
              <view class="flex-row">
                <text class="user-name">{{item.user.nxDiuWxNickName}}</text>
                <text class="user-self-tag" wx:if="{{item.user.nxDistributerUserId == userInfo.nxDistributerUserId}}">(你自己)</text>
              </view>
            </view>
            <text class="user-expand-icon">{{item.expanded == true ? '▼' : '▶'}}</text>
          </view>
          <view class="user-stats">
            <view class="user-stat-item">
              <text class="user-stat-label">采购商品</text>
              <text class="user-stat-value">{{item.count}}个</text>
            </view>
            <view class="user-stat-item">
              <text class="user-stat-label">采购金额</text>
              <text class="user-stat-value">{{item.purSubtotal}}元</text>
            </view>
          </view>
        </view>


        <!-- 商品详情卡片 -->
        <view class="flex-column  bg-white" wx:if="{{item.expanded}}">

          <!-- 商品详情卡片 -->
          <view class="flex-column border-bottom p-20" wx:for-item="goods" wx:key="nxDistributerGoodsId" wx:for="{{item.arr}}" id="goods-container-{{userIndex}}-{{index}}">

            <!-- 商品信息头部 -->
            <view class="flex-row-between" bind:tap="showList" data-user-index="{{userIndex}}" data-index="{{index}}">
              <view class="flex-row-default mb-20">
                <image bindtap="showDialogBtn" data-item="{{goods}}" src="{{url + goods.nxDgGoodsFile}}" mode="aspectFill" class="goods-image mr-20" />
                <view class="flex-column">
                  <text class="font-sm">第{{index + 1}}名/共{{item.count}}个</text>
                  <view class="flex-row mb-10">
                    <text class="font-bold mr-10">{{goods.nxDgGoodsName}}</text>
                    <block wx:if="{{goods.nxDgGoodsStandardWeight && goods.nxDgGoodsStandardWeight.length > 0}}">
                      <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
                    </block>
                    <block wx:else>
                      <text class="text-secondary font-xs">({{goods.nxDgGoodsStandardname}})</text>
                    </block>
                  </view>

                </view>

              </view>

              <!-- 右侧总计和按钮 -->
              <view class="goods-price-section">
                <view class="price-container">
                  <text class="price-label">采购</text>
                  <text class="price-value">¥{{goods.sellSubtotal}}</text>
                </view>
                <!-- 右侧箭头 -->
                <view class="arrow-container {{goods.showPurchaseList ? 'expanded' : 'collapsed'}}">
                  <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" style="width: 24rpx; height: 24rpx;" />
                </view>
              </view>
            </view>


            <!-- 采购详情 -->
            <!-- 采购批次列表 - 默认隐藏，点击showList后显示 -->
            <view class="flex-column purchase-row-container expandable-content {{goods.showPurchaseList ? 'expanded' : ''}}">

              <view class="flex-column " wx:for="{{goods.nxDistributerPurchaseGoodsEntities}}" wx:for-item="pur" wx:for-index="purIndex" catch:tap="showDetail" data-user-index="{{userIndex}}" data-goods-index="{{index}}" data-pur-index="{{purIndex}}">

                <!-- 采购批次默认显示 - 蓝色主题 -->
                <view class="flex-row purchase-row {{pur.expanded ? 'purchase-row-active' : ''}}">

                  <!-- 左侧时间 -->
                  <view class="flex-row mr-20">
                    <view class="flex-column">
                      <view class="font-md flex-row">{{tool.transferDateString(pur.nxDpgPurchaseDate)}}</view>
                      <text class="purchase-type">{{pur.nxDpgBusinessEventType == 'DIRECT_STOCK_IN' ? '直接入库' : (pur.nxDpgDemandSource == 'SHELF_REPLENISHMENT' ? '备货采购' : '订单采购')}}</text>
                    </view>
                  </view>
                  <!-- 中间采购信息 -->
                  <view class="flex-column" style="flex: 1;">
                    <view class="flex-row-between">
                      <text class="font-bold">{{pur.nxDpgBuyQuantity}}{{goods.nxDgGoodsStandardname}}</text>
                      <text class="purchase-info-value-amount mr-20">{{pur.nxDpgBuySubtotal}}元</text>
                    </view>
                    <view class="flex-row-between mt-5">
                      <text class="purchase-date">{{pur.nxDpgBuyPrice}}元/{{goods.nxDgGoodsStandardname}}</text>
                    </view>
                  </view>

                  <!-- 右侧箭头 -->
                  <view class="flex-column-center">
                    <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon {{pur.expanded ? 'expanded' : 'collapsed'}}" style="width: 24rpx; height: 24rpx;" />
                  </view>

                </view>


                <!-- NX系统：库存详细信息 - 注意：结构可能与GB不同 -->
                <view wx:if="{{pur.expanded}}" class="purchase-info-card expandable-content expanded">

                  <!-- 库存详细信息 - NX系统使用不同字段 -->
                  <view class="purchase-detail-section" wx:for="{{pur.nxDisGoodsShelfStockEntities}}" wx:for-item="stock" wx:key="index">

                    <!-- 库存信息行布局 -->
                    <view class="stock-info-row">
                      <!-- 左侧：货架信息 -->
                      <view class="stock-department-info">
                        <text class="font-bold">{{stock.shelfName}} L{{stock.nxDgsgShelfLayer}}-{{stock.nxDgsgShelfLayerSeq}}</text>
                      </view>

                      <!-- 右侧：金额信息对比 -->
                      <view class="stock-comparison-container">
                        <!-- 入库信息 -->
                        <view class="stock-info-column stock-inbound">
                          <view class="column-label">入库</view>
                          <view class="column-content">
                            <text class="amount-text">{{stock.nxDgssSubtotal || 0}}元</text>
                            <text class="weight-text">{{stock.nxDgssWeight}}{{goods.nxDgGoodsStandardname}}</text>
                          </view>
                        </view>

                        <!-- 分隔线 -->
                        <view class="comparison-divider"></view>

                        <!-- 剩余信息 -->
                        <view class="stock-info-column stock-rest">
                          <view class="column-label">剩余</view>
                          <view class="column-content">
                            <text class="amount-text rest-amount">{{stock.nxDgssRestSubtotal || 0}}元</text>
                            <text class="weight-text rest-weight">{{stock.nxDgssRestWeight || 0}}{{goods.nxDgGoodsStandardname}}</text>
                          </view>
                        </view>
                      </view>
                    </view>

                  </view>
                </view>

              </view>
            </view>
            <!--  -->

          </view>

          <!-- 分页提示 -->
          <view class="font-sm center-content flex-column p-20" wx:if="{{arr.length > 0}}">
            <view class="flex-row">
              <text class="text-secondary">共 {{totalCount}} 条记录，第 {{currentPage}}/{{totalPage}} 页</text>
            </view>
            <view class="flex-row mt-10" wx:if="{{currentPage < totalPage}}">
              <text class="text-secondary">上拉加载更多</text>
            </view>
            <view class="flex-row mt-10" wx:if="{{currentPage >= totalPage}}">
              <text class="text-secondary">已加载全部数据</text>
            </view>
          </view>

          <view class="font-sm center-content flex-column ">
            <view class="flex-row">
              <image src="{{url + '/userImage/daodile3.png'}}" mode="aspectFill" class="icon-lg margin-right" />
              <view style="line-height: 200rpx;">没有数据啦!</view>
            </view>

          </view>
        </view>


      </view>

    </block>


    <view class="flex-column center-content text-secondary" style="height: 100rpx;" wx:if="{{purUserArr.length == 0}}">
      <view class="empty_View flex-column-center" style="margin-top: 200rpx;">
        <image class="empty_image" src="/images/file-empty.png"></image>
        <text class="big">暂无数据</text>
      </view>
    </view>


  </block>


  <!-- 供货商 -->
  <block wx:if="{{type == 1}}">

    <block wx:if="{{supplierArr.length > 0}}">
      <view class="flex-column p-20" wx:for="{{supplierArr}}" wx:for-item="item" wx:for-index="userIndex" wx:key="nxJrdhUserId">

        <view class="supplier-info-card" bind:tap="toggleUserDetail" data-user-index="{{userIndex}}" hover-class="hover">
          <view class="supplier-info-header">
            <image src="{{url + item.user.nxJrdhWxAvartraUrl}}" class="supplier-avatar"></image>
            <view class="supplier-details">
              <view class="flex-row">
                <text class="supplier-name">{{item.user.nxJrdhWxNickName}}</text>
              </view>
            </view>
            <text class="supplier-expand-icon">{{item.expanded == true ? '▼' : '▶'}}</text>
          </view>
          <view class="supplier-stats">
            <view class="supplier-stat-item">
              <text class="supplier-stat-label">采购商品</text>
              <text class="supplier-stat-value">{{item.count}}个</text>
            </view>
            <view class="supplier-stat-item">
              <text class="supplier-stat-label">采购金额</text>
              <text class="supplier-stat-value">{{item.purSubtotal}}元</text>
            </view>
          </view>
        </view>

        <!-- 商品详情卡片 -->
        <!-- 商品详情卡片 -->
        <view class="flex-column  bg-white" wx:if="{{item.expanded}}">

          <!-- 商品详情卡片 -->
          <view class="flex-column border-bottom p-20" wx:for-item="goods" wx:key="nxDistributerGoodsId" wx:for="{{item.arr}}" id="goods-container-{{userIndex}}-{{index}}">

            <!-- 商品信息头部 -->
            <view class="flex-row-between" bind:tap="showList" data-user-index="{{userIndex}}" data-index="{{index}}">
              <view class="flex-row-default mb-20">
                <image bindtap="showDialogBtn" data-item="{{goods}}" src="{{url + goods.nxDgGoodsFile}}" mode="aspectFill" class="goods-image mr-20" />
