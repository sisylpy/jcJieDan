<back-navbar title="{{isReturn ? '发起退货申请' : '记录售后问题'}}" avatar="/images/back-gray.png" button-text="" bindnavbuttontap="toBack"></back-navbar>

<scroll-view scroll-y class="create-scroll" style="padding-top: {{navBarHeight}}rpx;">
  <view class="create-page" wx:if="{{draft}}">
    <view class="source-card">
      <text class="source-customer">{{draft.customerName}}</text>
      <text class="source-date">配送日期 {{draft.routeDate || '今天'}}</text>
      <text class="source-order">{{draft.originalShipmentTaskId ? '原配送任务 #' + draft.originalShipmentTaskId : '未关联配送任务'}}</text>
    </view>

    <view class="return-banner" wx:if="{{isReturn}}">退货先提交审核；审核通过后安排司机路线取货，仓库验收后再进行退款或账款冲减。</view>

    <view class="form-section">
      <view class="form-title">问题类型</view>
      <view class="type-options">
        <view class="type-option {{issueType === item.code ? 'selected' : ''}}" wx:for="{{issueTypeOptions}}" wx:key="code" bindtap="selectIssueType" data-code="{{item.code}}">{{item.label}}</view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-title-row" wx:if="{{!isReturn}}">
        <text class="form-title">影响范围</text>
        <text class="scope-auto" wx:if="{{issueScopeMode !== 'FLEXIBLE'}}">已按问题类型自动设置</text>
      </view>
      <view class="scope-options" wx:if="{{!isReturn && issueScopeMode === 'FLEXIBLE'}}">
        <view class="scope-option {{issueScope === 'ORDER' ? 'selected' : ''}}" bindtap="selectIssueScope" data-scope="ORDER">
          <text class="scope-title">整张送货单</text><text class="scope-description">配送或服务类问题</text>
        </view>
        <view class="scope-option {{issueScope === 'ITEM' ? 'selected' : ''}}" bindtap="selectIssueScope" data-scope="ITEM">
          <text class="scope-title">指定商品</text><text class="scope-description">只有某些商品有问题</text>
        </view>
      </view>
      <view class="order-scope-card" wx:if="{{!isReturn && issueScope === 'ORDER'}}">
        <view class="order-scope-icon">✓</view>
        <view><text class="order-scope-title">整张送货单</text><text class="order-scope-hint">无需选择商品，不会将问题归到某个商品上</text></view>
      </view>
      <block wx:if="{{issueScope === 'ITEM'}}">
        <text class="item-scope-hint">请选择实际有问题的商品</text>
        <view class="order-option {{item.selected ? 'selected' : ''}}" wx:for="{{orders}}" wx:key="historyOrderId" bindtap="toggleOrder" data-index="{{index}}">
          <view class="check-dot">{{item.selected ? '✓' : ''}}</view>
          <view class="order-text"><view><text class="order-name">{{item.goodsName}}</text><text>原配送 {{item.quantity}}{{item.standard}}</text></view>
            <view class="return-qty" wx:if="{{isReturn}}"><text>退货数量</text><input type="digit" value="{{item.returnQuantity}}" data-index="{{index}}" bindinput="onReturnQuantityInput" /></view>
          </view>
        </view>
      </block>
    </view>

    <view class="form-section">
      <view class="form-title">问题程度</view>
      <view class="severity-options">
        <view class="severity-option {{severity === item.code ? 'selected severity-' + item.code : ''}}" wx:for="{{severityOptions}}" wx:key="code" bindtap="selectSeverity" data-code="{{item.code}}">{{item.label}}</view>
      </view>
    </view>

    <view class="form-section">
      <view class="form-title">问题说明</view>
      <textarea class="description-input" maxlength="500" value="{{description}}" bindinput="onDescriptionInput" placeholder="{{issueScope === 'ORDER' ? '请描述整单配送或服务问题' : '例如：上海青太大，客户不能用'}}"></textarea>
    </view>

    <view class="form-section">
      <view class="form-title-row"><text class="form-title">问题照片</text><text class="photo-count">{{photos.length}}/20</text></view>
      <picker wx:if="{{issueScope === 'ITEM'}}" range="{{photoTargetOptions}}" range-key="label" value="{{photoTargetIndex}}" bindchange="onPhotoTargetChange">
        <view class="photo-target-picker">本次添加照片属于：{{photoTargetOptions[photoTargetIndex].label}} ›</view>
      </picker>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{photos}}" wx:key="path">
          <image src="{{item.path}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item.path}}"></image>
          <view class="photo-target-label">{{item.targetLabel || '整张售后'}}</view>
          <view class="photo-remove" wx:if="{{item.status === 'waiting'}}" bindtap="removePhoto" data-index="{{index}}">×</view>
          <view class="upload-mask" wx:if="{{item.status !== 'waiting' && item.status !== 'success'}}">{{item.statusText}}</view>
        </view>
        <view class="photo-add" bindtap="choosePhotos" wx:if="{{photos.length < 20}}"><text>＋</text><text>添加照片</text></view>
      </view>
    </view>

    <button class="save-button" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="save">{{isReturn ? '提交退货申请' : '创建售后'}}</button>
  </view>
</scroll-view>
