<back-navbar title="售后详情" avatar="/images/back-gray.png" button-text="" bindnavbuttontap="toBack"></back-navbar>

<view class="detail-page" style="padding-top: {{navBarHeight}}rpx;">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="error-card" wx:elif="{{errorText}}">{{errorText}}</view>
  <block wx:elif="{{detail}}">
    <view class="hero-card severity-{{detail.nxDasSeverity}}">
      <view><text class="customer-name">{{customerDisplayName}}</text><text class="hero-time">{{detail.createdText}}</text></view>
      <text class="after-sales-no">{{detail.nxDasNo}}</text>
      <view class="hero-status">{{detail.statusLabel}}</view>
      <view class="hero-meta"><text>{{detail.severityLabel}}</text><text>{{detail.issueTypeLabel}}</text><text>{{detail.confirmLabel}}</text></view>
      <view class="completed-time" wx:if="{{detail.completed}}">已完成 {{detail.completedText}}</view>
    </view>

    <view class="module-label">一、问题事实</view>
    <view class="section-card">
      <view class="fact-row"><text>客户</text><text>{{customerDisplayName}}</text></view>
      <view class="fact-row"><text>原订单</text><text>{{detail.nxDasOriginalHistoryOrderId || detail.nxDasOriginalLiveOrderId || '未关联'}}</text></view>
      <view class="fact-row"><text>问题类型</text><text>{{detail.issueTypeLabel}}</text></view>
      <view class="section-title issue-section-title">{{detail.orderScoped ? '问题范围' : '问题商品'}}</view>
      <view class="order-issue-summary" wx:if="{{detail.orderScoped}}">
        <view class="order-issue-badge">整张送货单</view>
        <text class="issue-description">{{detail.issueDescription}}</text>
      </view>
      <block wx:else>
        <view class="issue-item" wx:for="{{items}}" wx:key="id">
          <view class="issue-line"><text class="issue-name">{{item.goodsName}}</text><text>{{item.issueQuantity}}</text></view>
          <text class="issue-description">{{item.description}}</text>
        </view>
      </block>
    </view>

    <view class="section-card">
      <view class="section-title-row"><text class="section-title">问题照片</text><text class="text-action" wx:if="{{!detail.completed}}" bindtap="chooseEvidencePhotos">补传照片</text></view>
      <view class="empty-inline" wx:if="{{evidenceImages.length === 0}}">暂无问题照片</view>
      <view class="image-grid"><image wx:for="{{evidenceImages}}" wx:key="id" src="{{item.previewUrl}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.previewUrl}}"></image></view>
    </view>

    <view class="module-label">二、处理结果</view>
    <view class="section-card" wx:if="{{salesReturns.length}}">
      <view class="section-title">退货进度</view>
      <view class="return-card" wx:for="{{salesReturns}}" wx:key="id">
        <view class="section-title-row"><text class="return-no">{{item.returnNo}}</text><text class="status-chip">{{item.statusLabel}}</text></view>
        <text class="subtle-text">物流：{{item.logisticsLabel}}{{item.nxDsrRouteDate ? ' · ' + item.nxDsrRouteDate : ''}}</text>
        <view class="return-item" wx:for="{{item.items}}" wx:for-item="goods" wx:key="id"><text>{{goods.goodsName}}</text><text>申请 {{goods.requestedQuantity}} {{goods.nxDsriUnit}}</text></view>
        <view class="section-title-row return-amount"><text>预计/实际冲减</text><text class="money-text">{{item.amountText}}</text></view>
        <view class="inline-actions" wx:if="{{item.nxDsrBusinessStatus === 'SUBMITTED'}}">
          <button bindtap="openReturnApproval" data-id="{{item.id}}">审核</button><button class="minor-button" bindtap="rejectReturn" data-id="{{item.id}}">驳回</button>
        </view>
        <view class="inline-actions" wx:if="{{item.nxDsrLogisticsStatus === 'IN_TRANSIT'}}"><button bindtap="openReturnReceive" data-id="{{item.id}}">仓库验收</button></view>
        <view class="inline-actions" wx:if="{{item.nxDsrBusinessStatus === 'WAIT_FINANCIAL'}}"><button bindtap="openReturnFinancial" data-id="{{item.id}}">退款 / 账款冲减</button></view>
        <text class="route-tip" wx:if="{{item.nxDsrLogisticsStatus === 'WAIT_ASSIGN' || item.nxDsrLogisticsStatus === 'ASSIGNED'}}">取货任务已进入司机路线分派</text>
      </view>
    </view>
    <view class="section-card" wx:if="{{replenishments.length}}">
      <view class="section-title">补货进度</view>
      <view class="replenishment-card" wx:for="{{replenishments}}" wx:key="id">
        <view class="replenishment-head"><text>{{item.statusLabel}}</text><text>{{item.driverName}}</text></view>
        <text>{{item.goodsName}} × {{item.quantityText}}{{item.unitText}} · {{item.nxDasrStandard}}</text>
        <text>预计送达：{{item.expectedText || '未记录'}}</text>
        <text wx:if="{{item.nxDasrHandlingNote}}">处理说明：{{item.nxDasrHandlingNote}}</text>
        <text wx:if="{{item.nxDasrActualQuantityValue}}">实际送达：{{item.nxDasrActualQuantityValue}}{{item.unitText}}</text>
        <text class="failure-text" wx:if="{{item.nxDasrFailureReason || item.nxDasrCancelReason}}">{{item.nxDasrFailureReason || item.nxDasrCancelReason}}</text>
        <text class="free-tip">售后补货 · 客户不重复收费</text>
        <view class="inline-actions" wx:if="{{item.nxDasrStatus === 'ASSIGNED' && !detail.completed}}">
          <button bindtap="markDelivered" data-id="{{item.id}}">确认送达</button>
          <button class="minor-button" bindtap="openOutcomeForm" data-id="{{item.id}}" data-status="FAILED">记录失败</button>
          <button class="minor-button" bindtap="openOutcomeForm" data-id="{{item.id}}" data-status="CANCELLED">取消</button>
        </view>
        <view class="inline-actions" wx:if="{{item.nxDasrStatus === 'DELIVERED' && !detail.completed}}">
          <button bindtap="chooseResultPhotos" data-id="{{item.id}}" data-action-id="{{item.actionId}}">上传客户认可照片</button>
        </view>
      </view>
      <view class="image-subtitle" wx:if="{{resultImages.length}}">补货结果照片</view>
      <view class="image-grid"><image wx:for="{{resultImages}}" wx:key="id" src="{{item.previewUrl}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.previewUrl}}"></image></view>
    </view>

    <view class="section-card" wx:if="{{!detail.completed}}">
      <view class="section-title">处理方式</view>
      <text class="action-hint">选择本次处理方式，处理记录会保留在下方进度中</text>
      <view class="action-entry-grid">
        <view class="action-entry action-entry-{{item.code}}" wx:for="{{actionOptions}}" wx:key="code" bindtap="openActionByType" data-code="{{item.code}}">
          <text class="action-entry-title">{{item.label}}</text>
          <text class="action-entry-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title-row"><text class="section-title">处理动作时间线</text><text class="text-action" wx:if="{{!detail.completed}}" bindtap="openActionForm">记录其他处理</text></view>
      <view class="timeline-row"><view class="timeline-dot"></view><view><text>{{detail.createdText}} 创建售后</text></view></view>
      <view class="timeline-row" wx:for="{{actions}}" wx:key="id">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view><text>{{item.timeText}} {{item.operatorText}} · {{item.typeLabel}}</text><text class="status-chip">{{item.statusLabel}}</text></view>
          <text class="timeline-note" wx:if="{{item.methodCode}}">处理方式：{{item.methodCode}}</text>
          <text class="timeline-note" wx:if="{{item.remark}}">{{item.remark}}</text>
          <text class="timeline-note timeline-result" wx:if="{{item.result}}">结果：{{item.result}}</text>
          <text class="timeline-note" wx:if="{{item.structuredData.contactName}}">联系人：{{item.structuredData.contactName}}</text>
          <text class="timeline-note" wx:if="{{item.structuredData.commitmentPlan}}">承诺方案：{{item.structuredData.commitmentPlan}}</text>
          <text class="timeline-note" wx:if="{{item.expectedText}}">预计/下次：{{item.expectedText}}</text>
          <view class="image-grid compact-images" wx:if="{{item.proofImages.length}}"><image wx:for="{{item.proofImages}}" wx:for-item="proof" wx:key="id" src="{{proof.previewUrl}}" mode="aspectFill" bindtap="previewImage" data-url="{{proof.previewUrl}}"></image></view>
          <text class="text-action proof-action" wx:if="{{!detail.completed}}" bindtap="chooseActionPhotos" data-id="{{item.id}}">上传处理凭证</text>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{financialAdjustments.length}}">
      <view class="section-title">退款 / 账款冲减记录</view>
      <view class="financial-row" wx:for="{{financialAdjustments}}" wx:key="nxDasfaId">
        <view class="section-title-row"><text>{{item.typeLabel}}</text><text class="money-text">{{item.amountText}}</text></view>
        <text wx:if="{{item.nxDasfaAdjustmentNo}}">冲减单号：{{item.nxDasfaAdjustmentNo}}</text>
        <text wx:if="{{item.nxDasfaCreditBillId}}">账单凭证：#{{item.nxDasfaCreditBillId}} · {{item.postingLabel}}</text>
        <text>原因：{{item.nxDasfaReason}}</text>
        <text>处理结果：{{item.nxDasfaResultNote}}</text>
        <text class="subtle-text">{{item.processedText}} · {{item.nxDasfaStatus}}</text>
      </view>
    </view>

    <view class="section-card announcement-card">
      <view class="section-title-row"><text class="section-title">公司公告牌</text><text class="text-action" bindtap="openAnnouncementForm">{{announcement && announcement.nxDaStatus === 'PUBLISHED' ? '修改' : '发布'}}</text></view>
      <block wx:if="{{announcement && announcement.nxDaStatus === 'PUBLISHED'}}">
        <text class="announcement-title">已发布：{{announcement.nxDaTitle}}</text>
        <text class="timeline-note">{{announcement.nxDaPublisherNote}}</text>
        <button class="withdraw-button" bindtap="withdrawAnnouncement">撤回公告</button>
      </block>
      <text class="empty-inline" wx:else>未发布到公司公告牌</text>
    </view>

    <view class="module-label">三、客户反馈</view>
    <view class="section-card">
      <view class="section-title-row"><text class="section-title">最新状态：{{detail.confirmLabel}}</text></view>
      <text class="customer-feedback-note" wx:if="{{detail.nxDasCustomerConfirmRemark}}">{{detail.nxDasCustomerConfirmRemark}}</text>
      <view class="confirm-options" wx:if="{{!detail.completed}}">
        <button class="confirm-pending" bindtap="confirmCustomer" data-status="PENDING">待确认</button>
        <button class="confirm-accepted" bindtap="confirmCustomer" data-status="ACCEPTED">客户接受</button>
        <button class="confirm-unsatisfied" bindtap="confirmCustomer" data-status="UNSATISFIED">仍不满意</button>
      </view>
      <view class="feedback-history" wx:if="{{feedbackHistory.length}}">
        <view class="feedback-row" wx:for="{{feedbackHistory}}" wx:key="id">
          <view class="section-title-row"><text class="feedback-status {{item.status === 'UNSATISFIED' ? 'is-unsatisfied' : ''}}">{{item.statusLabel}}</text><text class="subtle-text">{{item.recordedText}}</text></view>
          <text>{{item.content}}</text><text class="subtle-text">反馈渠道：{{item.channel}}</text>
        </view>
      </view>
      <text class="empty-inline" wx:else>暂无客户反馈历史</text>
      <view class="final-summary" wx:if="{{detail.nxDasFinalResolutionSummary}}">最终解决摘要：{{detail.nxDasFinalResolutionSummary}}</view>
      <button class="complete-button" wx:if="{{detail.nxDasStatus === 'WAIT_CONFIRM' && detail.nxDasCustomerConfirmStatus === 'ACCEPTED'}}" bindtap="completeCase">完成售后</button>
    </view>

    <view class="section-card" wx:if="{{detail.completed && items.length}}">
      <view class="section-title-row"><text class="section-title">客户商品标准</text><text class="success-label" wx:if="{{hasWrittenBack}}">✓ 已加入</text></view>
      <text class="standard-hint">把本次人工确认的要求和照片沉淀为这个客户的长期收货标准。</text>
      <button class="standard-button" wx:if="{{!hasWrittenBack}}" bindtap="openWriteback">加入客户商品标准</button>
      <button class="standard-link" wx:if="{{hasWrittenBack}}" bindtap="viewCustomerStandard">查看客户标准 ></button>
    </view>

    <view class="sheet-mask" wx:if="{{showActionForm || showFinancialForm || showReplenishmentForm || showCompensationForm || showWritebackForm || showFeedbackForm || showDeliveryForm || showOutcomeForm || showAnnouncementForm || showReturnApprovalForm || showReturnReceiveForm}}" bindtap="closeForms"></view>
    <view class="bottom-sheet" wx:if="{{showReturnApprovalForm}}">
      <view class="sheet-title">审核退货申请</view>
      <view class="return-form-item" wx:for="{{returnApprovalItems}}" wx:key="id"><text>{{item.goodsName}} · 申请 {{item.requestedQuantity}}</text><input type="digit" value="{{item.approvedQuantity}}" data-index="{{index}}" bindinput="onReturnApprovedQuantityInput" placeholder="核准数量" /></view>
      <view class="pickup-switch"><text>安排司机上门取货</text><switch checked="{{returnPickupRequired}}" bindchange="onReturnPickupChange" color="#315f62" /></view>
      <picker mode="date" value="{{returnRouteDate}}" bindchange="onReturnRouteDateChange" wx:if="{{returnPickupRequired}}"><view class="picker-field">计划取货日期：{{returnRouteDate}}</view></picker>
      <textarea placeholder="审核备注（可选）" value="{{returnApprovalRemark}}" bindinput="onReturnApprovalRemarkInput"></textarea>
      <button class="sheet-primary" bindtap="saveReturnApproval">审核通过</button>
    </view>
    <view class="bottom-sheet" wx:if="{{showReturnReceiveForm}}">
      <view class="sheet-title">仓库退货验收</view>
      <view class="warning-banner">请按实收和可冲减数量验收；“返库”会恢复原出库批次库存。</view>
      <view class="return-form-item" wx:for="{{returnReceiveItems}}" wx:key="id">
        <text>{{item.goodsName}} · 最多 {{item.ceiling}}</text>
        <view class="quantity-row"><input type="digit" value="{{item.receivedQuantity}}" data-index="{{index}}" data-field="receivedQuantity" bindinput="onReturnReceiveInput" placeholder="实收数量"/><input type="digit" value="{{item.acceptedQuantity}}" data-index="{{index}}" data-field="acceptedQuantity" bindinput="onReturnReceiveInput" placeholder="验收通过"/></view>
        <picker range="{{returnDispositionOptions}}" value="{{item.dispositionCode === 'SCRAP' ? 1 : item.dispositionCode === 'RETURN_TO_SUPPLIER' ? 2 : 0}}" data-index="{{index}}" bindchange="onReturnDispositionChange"><view class="picker-field">库存处置：{{item.dispositionCode === 'SCRAP' ? '报损' : item.dispositionCode === 'RETURN_TO_SUPPLIER' ? '退供应商' : '返库'}}</view></picker>
        <input type="digit" value="{{item.temperature}}" data-index="{{index}}" data-field="temperature" bindinput="onReturnReceiveInput" placeholder="收货温度 ℃（可选）"/>
      </view>
      <textarea placeholder="验收备注（可选）" value="{{returnReceiveRemark}}" bindinput="onReturnReceiveRemarkInput"></textarea>
      <button class="sheet-primary" bindtap="saveReturnReceive">确认验收</button>
    </view>
    <view class="bottom-sheet" wx:if="{{showActionForm}}">
      <view class="sheet-title">{{actionType === 'COMMUNICATION' ? '解释 / 沟通' : '其它处理'}}</view>
      <block wx:if="{{actionType === 'COMMUNICATION'}}">
        <picker range="{{communicationChannels}}" range-key="label" bindchange="onCommunicationChannelChange"><view class="picker-field">沟通渠道：{{communicationChannelMap[actionMethodCode]}}</view></picker>
        <input placeholder="联系人（必填）" bindinput="onActionContactInput" value="{{actionContactName}}" />
        <textarea placeholder="沟通内容（必填）" bindinput="onActionRemarkInput" value="{{actionRemark}}"></textarea>
        <textarea placeholder="承诺方案（必填）" bindinput="onActionCommitmentInput" value="{{actionCommitmentPlan}}"></textarea>
        <picker range="{{communicationResults}}" range-key="label" bindchange="onCommunicationResultChange"><view class="picker-field">沟通结果：{{communicationResultMap[actionResultCode]}}</view></picker>
        <input placeholder="沟通结果说明（必填）" bindinput="onActionResultInput" value="{{actionResult}}" />
      </block>
      <block wx:else>
        <input placeholder="处理标题（必填）" bindinput="onOtherTitleInput" value="{{otherTitle}}" />
        <textarea placeholder="详细处理方案（必填）" bindinput="onOtherPlanInput" value="{{otherPlan}}"></textarea>
        <picker range="{{responsibleOptions}}" range-key="name" value="{{otherResponsibleIndex}}" bindchange="onOtherResponsibleChange"><view class="picker-field">负责人：{{responsibleOptions[otherResponsibleIndex].name || '请选择'}}</view></picker>
        <picker range="{{otherStatusOptions}}" range-key="label" bindchange="onOtherStatusChange"><view class="picker-field">状态：{{actionStatusMap[actionStatus]}}</view></picker>
        <input wx:if="{{actionStatus === 'COMPLETED'}}" placeholder="最终处理结果（必填）" bindinput="onActionResultInput" value="{{actionResult}}" />
      </block>
      <input placeholder="实际处理时间 YYYY-MM-DD HH:mm" bindinput="onActionOccurredInput" value="{{actionOccurredAt}}" />
      <input placeholder="预计/下次时间（可选）" bindinput="onActionExpectedInput" value="{{actionExpectedAt}}" />
      <button class="sheet-primary" bindtap="saveAction">保存处理动作</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showFinancialForm}}">
      <view class="sheet-title">退款 / 账款冲减</view>
      <picker range="{{financialTypes}}" range-key="label" value="{{financialTypeIndex}}" bindchange="onFinancialTypeChange"><view class="picker-field">处理方式：{{financialTypes[financialTypeIndex].label}}</view></picker>
      <view class="money-input"><text>¥</text><input type="digit" placeholder="金额（必填）" value="{{financialAmount}}" bindinput="onFinancialAmountInput" /></view>
      <textarea placeholder="处理原因（必填）" value="{{financialReason}}" bindinput="onFinancialReasonInput"></textarea>
      <input wx:if="{{financialTypes[financialTypeIndex].code === 'OFFLINE_REFUND'}}" placeholder="线下退款凭证号（必填）" value="{{financialExternalRefundNo}}" bindinput="onFinancialExternalRefundNoInput" />
      <textarea placeholder="处理说明与结果（必填）" value="{{financialResultNote}}" bindinput="onFinancialResultInput"></textarea>
      <view class="warning-banner">线下退款只记录真实线下结果，不会伪装成原路退款。</view>
      <button class="sheet-primary" bindtap="saveFinancialAdjustment">确认处理</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showReplenishmentForm}}">
      <view class="sheet-title">安排售后补货</view>
      <view class="free-banner">售后补货 · 客户不重复收费</view>
      <picker range="{{items}}" range-key="goodsName" value="{{replenishmentItemIndex}}" bindchange="onReplenishmentItemChange"><view class="picker-field">商品：{{items[replenishmentItemIndex].goodsName}}</view></picker>
      <view class="quantity-row"><input type="digit" placeholder="补货数量" bindinput="onReplenishmentQuantityInput"/><input placeholder="单位，如 斤" value="{{replenishmentUnit}}" bindinput="onReplenishmentUnitInput"/></view>
      <input placeholder="规格，如 5斤/箱" value="{{replenishmentStandard}}" bindinput="onReplenishmentStandardInput"/>
      <input placeholder="预计送达 YYYY-MM-DD HH:mm" value="{{replenishmentExpectedAt}}" bindinput="onReplenishmentExpectedInput"/>
      <picker range="{{drivers}}" range-key="name" value="{{driverIndex}}" bindchange="onDriverChange"><view class="picker-field">司机：{{drivers[driverIndex].name || '请选择司机'}}</view></picker>
      <textarea placeholder="补货处理说明（必填）" value="{{replenishmentNote}}" bindinput="onReplenishmentNoteInput"></textarea>
      <button class="sheet-primary" bindtap="saveReplenishment">确认补货并派单</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showDeliveryForm}}">
      <view class="sheet-title">确认补货送达</view>
      <input type="digit" placeholder="实际送达数量（必填）" value="{{deliveryActualQuantity}}" bindinput="onDeliveryActualInput"/>
      <textarea placeholder="送达结果（必填）" value="{{deliveryResult}}" bindinput="onDeliveryResultInput"></textarea>
      <button class="sheet-primary" bindtap="saveDelivery">确认送达</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showOutcomeForm}}">
      <view class="sheet-title">{{outcomeStatus === 'FAILED' ? '记录补货失败' : '取消补货'}}</view>
      <textarea placeholder="{{outcomeStatus === 'FAILED' ? '失败原因（必填）' : '取消原因（必填）'}}" value="{{outcomeReason}}" bindinput="onOutcomeReasonInput"></textarea>
      <button class="sheet-primary" bindtap="saveOutcome">确认记录</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showCompensationForm}}">
      <view class="sheet-title">发放售后补偿券</view>
      <view class="compensation-banner">补偿券由员工代客户接收反馈后人工发放，不需要客户主动领取。</view>
      <picker range="{{compensationCoupons}}" range-key="displayText" value="{{compensationCouponIndex}}" bindchange="onCompensationCouponChange">
        <view class="picker-field">{{compensationCoupons[compensationCouponIndex].displayText}}</view>
      </picker>
      <view class="compensation-meta">
        <text>{{compensationCoupons[compensationCouponIndex].compTypeText}}</text>
        <text>{{compensationCoupons[compensationCouponIndex].validityText}}</text>
      </view>
      <textarea placeholder="补偿原因（必填）" value="{{compensationRemark}}" bindinput="onCompensationRemarkInput"></textarea>
      <button class="sheet-primary compensation-primary" bindtap="saveCompensation">确认发放给客户</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showFeedbackForm}}">
      <view class="sheet-title">记录客户反馈 · {{feedbackStatus === 'ACCEPTED' ? '客户接受' : '仍不满意'}}</view>
      <picker range="{{feedbackChannels}}" range-key="label" value="{{feedbackChannelIndex}}" bindchange="onFeedbackChannelChange"><view class="picker-field">反馈渠道：{{feedbackChannels[feedbackChannelIndex].label}}</view></picker>
      <textarea placeholder="客户反馈内容（必填）" value="{{feedbackContent}}" bindinput="onFeedbackContentInput"></textarea>
      <input placeholder="实际反馈时间 YYYY-MM-DD HH:mm" value="{{feedbackRecordedAt}}" bindinput="onFeedbackRecordedInput"/>
      <button class="sheet-primary" bindtap="saveFeedback">保存客户反馈</button>
    </view>

    <view class="bottom-sheet" wx:if="{{showAnnouncementForm}}">
      <view class="sheet-title">发布公司公告</view>
      <input placeholder="公告标题（必填）" value="{{announcementTitle}}" bindinput="onAnnouncementTitleInput"/>
      <view class="audience-title">谁需要看到</view>
      <view class="audience-option {{announcementAudienceAll ? 'selected' : ''}}" bindtap="selectAnnouncementAll">
        <text class="radio-mark">{{announcementAudienceAll ? '●' : '○'}}</text><text>全公司</text>
      </view>
      <view class="role-grid">
        <view class="audience-option {{item.selected ? 'selected' : ''}}" wx:for="{{announcementRoles}}" wx:key="code" bindtap="toggleAnnouncementRole" data-code="{{item.code}}">
          <text class="radio-mark">{{item.selected ? '■' : '□'}}</text><text>{{item.label}}</text>
        </view>
      </view>
      <textarea placeholder="内部提醒（不会复制售后事实）" value="{{announcementNote}}" bindinput="onAnnouncementNoteInput"></textarea>
      <button class="sheet-primary" bindtap="saveAnnouncement">{{announcement && announcement.nxDaStatus === 'PUBLISHED' ? '保存修改' : '发布'}}</button>
    </view>

    <view class="bottom-sheet writeback-sheet" wx:if="{{showWritebackForm}}">
      <view class="sheet-title">加入客户商品标准</view>
      <picker range="{{items}}" range-key="goodsName" value="{{writebackItemIndex}}" bindchange="onWritebackItemChange"><view class="picker-field">商品：{{items[writebackItemIndex].goodsName}}</view></picker>
      <picker range="{{dimensionOptions}}" range-key="label" value="{{writebackDimensionIndex}}" bindchange="onDimensionChange"><view class="picker-field">标准维度：{{dimensionOptions[writebackDimensionIndex].label}}</view></picker>
      <input class="standard-input" placeholder="例如：小颗" value="{{writebackRequirement}}" bindinput="onWritebackRequirementInput"/>
      <picker mode="selector" range="{{importanceOptions}}" value="{{writebackImportance - 1}}" bindchange="onImportanceChange"><view class="picker-field">重要度：{{writebackImportance}} 星</view></picker>
      <block wx:for="{{images}}" wx:key="id">
        <view class="writeback-image" wx:if="{{item.writebackEligible}}" bindtap="toggleWritebackImage" data-id="{{item.id}}">
          <image src="{{item.previewUrl}}" mode="aspectFill"></image>
          <view class="writeback-image-text"><text>{{item.stage === 'EVIDENCE' ? '原问题照片 → 禁止这样' : '补货认可照片 → 合格参考'}}</text></view>
          <text class="check-mark">{{item.writebackSelected ? '✓' : ''}}</text>
        </view>
      </block>
      <button class="sheet-primary" bindtap="saveWriteback">确认加入客户标准</button>
    </view>
  </block>
</view>
