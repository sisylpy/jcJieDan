


<view class="flex flex-column">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="采购分析" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

 <!--  top -->
 <view class="date-bar bg-white border-bottom">
   <image src="../../../../images/calender.png" class="date-icon"></image>
   <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange" class="date-picker">
     <view class="date-value">{{startDate}}</view>
   </picker>
   <text class="date-sep">至</text>
   <picker mode="date" value="{{stopDate}}" bindchange="onEndDateChange" class="date-picker">
     <view class="date-value">{{stopDate}}</view>
   </picker>
 </view>



  <view class="flex-column p-20" wx:if="{{mapEveryDay !== null}}">

    <view class="flex-column bg-white radius-10 border p-20 mt-30">
      <view class="flex-column p-20" style="height: 400rpx;">
        <view class="flex-row-between">
          <view class="font-sm mb-20">自采购总额</view>
          <view class="button-container-white" bind:tap="toPurchaser" hover-class="hover">
          <image src="/images/points.png" mode="aspectFill" class="icon"/>
          </view>
        </view>
       
        <ec-canvas id="purUserChart" canvas-id="purUserChart" ec="{{ ecPurUser }}" style="width: 100%; height: 100%;"></ec-canvas>
      </view>
    </view>

    <!-- 供货商采购总额图表 -->
    <view class="flex-column bg-white radius-10 border p-20 mt-20 mb-30">
      <view class="flex-column p-20" style="height: 400rpx;">
        <view class="flex-row-between">
          <view class="font-sm mb-20">供货商</view>
          <view class="button-container-white" bind:tap="toSupplier" hover-class="hover">
          <image src="/images/points.png" mode="aspectFill" class="icon"/>
          </view>
        </view>
        <ec-canvas id="supplierChart" canvas-id="supplierChart" ec="{{ ecSupplier }}" style="width: 100%; height: 100%;"></ec-canvas>
      </view>
    </view>



    <view class="analysis-section">
      <view class="analysis-title-row">
        <view><strong>单价波动商品</strong><text>优先关注进价变化较大的商品</text></view>
        <text class="section-count">前 10</text>
      </view>
      <view class="analysis-goods-card" wx:for="{{topGoodsPrice}}" wx:key="nxDistributerGoodsId" wx:if="{{index < (showAllPriceGoods ? topGoodsPrice.length : 4)}}" data-id="{{item.nxDistributerGoodsId}}" bind:tap="toGoodsPage" data-goods="{{item}}" hover-class="analysis-card-hover">
        <image src="{{item.goodsImageUrl}}" mode="aspectFill" class="analysis-goods-image"></image>
        <view class="analysis-goods-main">
          <strong>{{item.nxDgGoodsName}}</strong>
          <text>{{item.goodsSpecificationText}}</text>
          <view class="price-range">
            <text>最低 ¥{{item.nxDgGoodsLowestPrice}}</text>
            <text>最高 ¥{{item.nxDgGoodsHighestPrice}}</text>
          </view>
        </view>
        <view class="analysis-metric warning"><strong>{{item.goodsPriceFluctuation}}%</strong><text>波动率</text><small>差价 ¥{{item.goodsPriceDiff}}</small></view>
      </view>
      <view class="expand-link" wx:if="{{topGoodsPrice.length > 4}}" bind:tap="togglePriceGoodsList">
        <text>{{showAllPriceGoods ? '收起商品' : '展开更多商品（共' + topGoodsPrice.length + '个）'}}</text><image class="expand-btn {{showAllPriceGoods ? 'expanded' : ''}}" src="/images/arrow-down-3.png"></image>
      </view>
      <view class="expand-tip" wx:elif="{{topGoodsPrice.length > 0}}">共 {{topGoodsPrice.length}} 个商品，已全部展示</view>
    </view>

    <view class="analysis-section">
      <view class="analysis-title-row">
        <view><strong>采购次数排名</strong><text>一眼看清最常采购的商品</text></view>
        <text class="section-count">前 10</text>
      </view>
      <view class="analysis-goods-card" wx:for="{{topTimesGoods}}" wx:key="nxDistributerGoodsId" wx:if="{{index < (showAllGoods ? topTimesGoods.length : 4)}}" data-id="{{item.nxDistributerGoodsId}}" bind:tap="toGoodsPage" data-goods="{{item}}" hover-class="analysis-card-hover">
        <image src="{{item.goodsImageUrl}}" mode="aspectFill" class="analysis-goods-image"></image>
        <view class="analysis-goods-main"><strong>{{item.nxDgGoodsName}}</strong><text>{{item.goodsSpecificationText}}</text><small>点击查看采购明细</small></view>
        <view class="analysis-metric"><strong>{{item.nxDgQuantityDays}}</strong><text>次采购</text></view>
      </view>
      <view class="expand-link" wx:if="{{topTimesGoods.length > 4}}" bind:tap="toggleGoodsList">
        <text>{{showAllGoods ? '收起商品' : '展开更多商品（共' + topTimesGoods.length + '个）'}}</text><image class="expand-btn {{showAllGoods ? 'expanded' : ''}}" src="/images/arrow-down-3.png"></image>
      </view>
      <view class="expand-tip" wx:elif="{{topTimesGoods.length > 0}}">共 {{topTimesGoods.length}} 个商品，已全部展示</view>
    </view>

    <view class="analysis-section">
      <view class="analysis-title-row">
        <view><strong>采购金额排名</strong><text>前 10 商品合计 ¥{{topSubtotalGoodsSubtotal}}，占总额 {{topSubtotalGoodsPercent}}%</text></view>
        <text class="section-total">总额 ¥{{purTotal}}</text>
      </view>
      <view class="analysis-goods-card" wx:for="{{topSubtotalGoods}}" wx:key="nxDistributerGoodsId" wx:if="{{index < (showAllSubtotalGoods ? topSubtotalGoods.length : 4)}}" data-id="{{item.nxDistributerGoodsId}}" bind:tap="toGoodsPage" data-goods="{{item}}" hover-class="analysis-card-hover">
        <image src="{{item.goodsImageUrl}}" mode="aspectFill" class="analysis-goods-image"></image>
        <view class="analysis-goods-main"><strong>{{item.nxDgGoodsName}}</strong><text>{{item.goodsSpecificationText}}</text><small>点击查看采购明细</small></view>
        <view class="analysis-metric amount"><strong>¥{{item.goodsPurTotalSubtotal}}</strong><text>采购金额</text></view>
      </view>
      <view class="expand-link" wx:if="{{topSubtotalGoods.length > 4}}" bind:tap="toggleSubtotalGoodsList">
        <text>{{showAllSubtotalGoods ? '收起商品' : '展开更多商品（共' + topSubtotalGoods.length + '个）'}}</text><image class="expand-btn {{showAllSubtotalGoods ? 'expanded' : ''}}" src="/images/arrow-down-3.png"></image>
      </view>
      <view class="expand-tip" wx:elif="{{topSubtotalGoods.length > 0}}">共 {{topSubtotalGoods.length}} 个商品，已全部展示</view>
    </view>





     <view style="height: 100rpx;"></view>

  </view>


  <view wx:else="" style="height: {{windowHeight - 360}}rpx;">

    <view class="center-content flex-column" style="padding-top: 200rpx;">
      <image class="empty_image" src="/images/cart-Empty.png"></image>
      <text class="big">无数据</text>
    </view>

  </view>
  <!-- ./empty -->

</view>



<view class="overlay {{showStar ? 'show' : 'hide'}}" bind:tap="hideMask">

  <view class="flex-column font-md popup p-20">
    <view class="flex-row p-20">
      <text>{{showGoods.nxDgGoodsName}}</text>
      <text>(<block wx:if="{{showGoods.nxDgCartonUnit && showGoods.nxDgCartonUnit !== '' && showGoods.nxDgCartonUnit !== 'null' && showGoods.nxDgItemsPerCarton > 0}}">{{showGoods.nxDgCartonUnit}}</block><block wx:else>{{showGoods.nxDgGoodsStandardname}}</block>)</text>
    </view>

    <view class="flex-column p-30">
      <view class="flex-row p-10" wx:if="{{showGoods.goodsData.starsCount.starsFive > 0}}">
        <view class="flex-row-default" style="width: {{windowWidth / 6}}rpx; ">
          <image wx:for="11111" src="/images/starGreen.png" mode="aspectFill" class="icon-sm" />
        </view>

        <text class="ml-20">{{showGoods.goodsData.starsCount.starsFive}}次</text>
      </view>


      <view class="flex-row  p-10" wx:if="{{showGoods.goodsData.starsCount.starsFour > 0}}">

        <view class="flex-row-default" style="width: {{windowWidth / 6}}rpx; ">
          <image wx:for="1111" src="/images/starGreen.png" mode="aspectFill" class="icon-sm" />
          <image src="/images/starGray.png" mode="aspectFill" class="icon-sm" />
        </view>
        <text class="ml-20">{{showGoods.goodsData.starsCount.starsFour}}次</text>
      </view>


      <view class="flex-row  p-10" wx:if="{{showGoods.goodsData.starsCount.starsThree > 0}}">
        <view class="flex-row-default" style="width: {{windowWidth / 6}}rpx; ">
          <image wx:for="111" src="/images/starGreen.png" mode="aspectFill" class="icon-sm" />
          <image wx:for="11" src="/images/starGray.png" mode="aspectFill" class="icon-sm" />
        </view>
        <text class="ml-20">{{showGoods.goodsData.starsCount.starsThree}}次</text>
      </view>


      <view class="flex-row  p-10" wx:if="{{showGoods.goodsData.starsCount.starsTwo > 0}}">
        <view class="flex-row-default" style="width: {{windowWidth / 6}}rpx; ">
          <image wx:for="11" src="/images/starGreen.png" mode="aspectFill" class="icon-sm" />
          <image wx:for="111" src="/images/starGray.png" mode="aspectFill" class="icon-sm" />

        </view>
        <text class="ml-20">{{showGoods.goodsData.starsCount.starsTwo}}次</text>
      </view>
      <view class=" p-10 flex-row" wx:if="{{showGoods.goodsData.starsCount.starsOne > 0}}">
        <image src="/images/starGreen.png" mode="aspectFill" class="icon-sm" />
        <image wx:for="1111" src="/images/starGray.png" mode="aspectFill" class="icon-sm" />
        <text class="ml-20">{{showGoods.goodsData.starsCount.starsOne}}次</text>
      </view>

    </view>

  </view>
</view>
