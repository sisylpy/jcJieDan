

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 8rpx 0;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}


.legend-label {
  color: #666;
  font-size: 24rpx;
  margin-bottom: 4rpx;
  font-weight: 500;
  margin-right: 10rpx;
}

.legend-value {
  color: #333;
  font-weight: bold;
  font-size: 26rpx;
}

/* 图表容器样式 */
.mb-20 {
  margin-bottom: 20rpx;
}

/* 确保图表有足够的显示空间 */
ec-canvas {
  width: 100% !important;
  height: 100% !important;
}

/* 图表间距 */
.mt-20 {
  margin-top: 20rpx;
}

/* 文本样式 */
.font-sm {
  font-size: 28rpx;
}

.font-xs {
  font-size: 24rpx;
}

.text-gray {
  color: #999;
}

.text-primary {
  color: #007aff;
}

.border-bottom {
  border-bottom: 1rpx solid #f0f0f0;
}

.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-5 {
  margin-top: 10rpx;
}


/* 展开按钮样式 */
.expand-btn {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s ease;
}

/* 日期选择器 */
.date-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  height: 96rpx;
  box-sizing: border-box;
}

.date-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.date-value {
  background-color: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 0;
}

.date-sep {
  color: #999;
  font-size: 24rpx;
  padding: 0 16rpx;
  flex-shrink: 0;
}

.analysis-section {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 24rpx;
  background: #fffdf9;
  box-shadow: 0 8rpx 24rpx rgba(37, 72, 54, .06);
}

.analysis-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.analysis-title-row > view {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.analysis-title-row strong {
  color: #203028;
  font-size: 30rpx;
}

.analysis-title-row view > text {
  color: #7d8b83;
  font-size: 22rpx;
  line-height: 1.45;
}

.section-count,
.section-total {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e9f6ef;
  color: #108650;
  font-size: 20rpx;
  font-weight: 700;
}

.section-total {
  background: #fff0d9;
  color: #a7650b;
}

.analysis-goods-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e5ebe7;
  border-radius: 20rpx;
  background: #fff;
}

.analysis-card-hover {
  background: #f3faf6;
}

.analysis-goods-image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border: 1rpx solid #e4e9e6;
  border-radius: 22rpx;
  background: #f5f7f6;
}

.analysis-goods-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.analysis-goods-main > strong {
  overflow: hidden;
  color: #223129;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-goods-main > text,
.analysis-goods-main > small {
  overflow: hidden;
  color: #7d8982;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-goods-main > small {
  color: #a0aaa4;
  font-size: 19rpx;
}

.price-range {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
}

.price-range text {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #f4f7f5;
  color: #5d6b63;
  font-size: 19rpx;
}

.analysis-metric {
  min-width: 105rpx;
  flex: none;
  text-align: right;
}

.analysis-metric strong,
.analysis-metric text,
.analysis-metric small {
  display: block;
}

.analysis-metric strong {
  color: #0f8c53;
  font-size: 30rpx;
}

.analysis-metric text {
  margin-top: 4rpx;
  color: #75837b;
  font-size: 20rpx;
}

.analysis-metric small {
  margin-top: 7rpx;
  color: #9ba59f;
  font-size: 18rpx;
}

.analysis-metric.warning strong,
.analysis-metric.amount strong {
  color: #ed7418;
}

.expand-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 18rpx 0;
  border: 1rpx solid #cfe3d8;
  border-radius: 999rpx;
  background: #f2faf6;
  color: #39715a;
  font-size: 26rpx;
  font-weight: 700;
}

.expand-tip {
  margin-top: 18rpx;
  padding: 14rpx 0 4rpx;
  text-align: center;
  color: #9aa5a0;
  font-size: 22rpx;
}

.expand-btn.expanded {
  transform: rotate(180deg);
}
