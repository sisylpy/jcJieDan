<wxs src="../../../../utils/fn.wxs" module="tool" />
<view class="page">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="销售分析"
    avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"
  ></back-navbar>

  <view class="page-body" style="margin-top: {{navBarHeight}}rpx; height: {{contentHeight}}rpx;">
    <view wx:if="{{loading}}" class="page-state">
      <view class="state-icon">析</view>
      <text class="state-title">正在统计历史销售数据</text>
      <text class="state-desc">只读取已经完成的配送订单</text>
    </view>

    <view wx:elif="{{pageError}}" class="page-state error-state">
      <view class="state-icon">!</view>
      <text class="state-title">{{pageError}}</text>
      <view class="retry-button" bindtap="refreshReport">重新加载</view>
    </view>

    <block wx:else>
      <scroll-view scroll-y="true" class="top-scroll">
        <report-date-filter label="{{hanzi}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bind:select="toDatePage"></report-date-filter>

        <view class="summary-grid">
          <view class="summary-card money-card">
            <text>成交销售额</text>
            <strong>{{summary.salesAmountText}}</strong>
            <small>已完成历史订单</small>
          </view>
          <view class="summary-card">
            <text>使用客户</text>
            <strong>{{summary.customerCount}}家</strong>
            <small>按父客户去重</small>
          </view>
          <view class="summary-card">
            <text>成交商品</text>
            <strong>{{summary.goodsCount}}种</strong>
            <small>覆盖{{summary.subcategoryCount}}个小类</small>
          </view>
          <view class="summary-card">
            <text>主要销售数量</text>
            <strong>{{summary.quantityText}}</strong>
            <small>{{summary.quantityNote}}</small>
          </view>
        </view>

        <view class="mode-toggle">
          <view class="mode-option {{viewMode==='goods' ? 'active' : ''}}" bindtap="switchMode" data-mode="goods">按商品</view>
          <view class="mode-option {{viewMode==='customer' ? 'active' : ''}}" bindtap="switchMode" data-mode="customer">按客户</view>
        </view>

        <view class="data-note">
          <text>数据只来自已完成历史订单</text>
          <text>数量和平均价按原交易单位分别统计</text>
          <text wx:if="{{qualityIssueCount > 0}}">有{{qualityIssueCount}}条数据需要核对</text>
          <text wx:else>有效成交行的数据质量检查通过</text>
        </view>
      </scroll-view>

      <view class="analysis-body">
        <scroll-view scroll-y="true" class="tree-pane" bindscrolltolower="onTreeScrollToLower">
          <view wx:for="{{categories}}" wx:key="id" class="tree-node">
            <view class="tree-category {{expandedCategoryId==item.id ? 'open' : ''}}" bindtap="toggleCategory" data-id="{{item.id}}">
              <view class="tree-category-main">
                <text class="caret">{{expandedCategoryId==item.id ? '▾' : '▸'}}</text>
                <strong>{{item.name}}</strong>
              </view>
              <view class="tree-category-meta">
                <text>{{item.amountText}}</text>
                <text class="tree-share">{{item.shareText}}</text>
              </view>
              <view class="bar-track"><view class="bar-fill" style="width: {{item.shareWidth}}%;"></view></view>
            </view>

            <view wx:if="{{expandedCategoryId==item.id}}" class="tree-children">
              <block wx:if="{{viewMode==='goods'}}">
                <view wx:if="{{goodsDetail[item.id].loadingChildren}}" class="tree-loading">正在加载小类…</view>
                <block wx:elif="{{goodsDetail[item.id].subcategories.length}}">
                  <view
                    wx:for="{{goodsDetail[item.id].subcategories}}"
                    wx:for-item="sub"
                    wx:key="id"
                    class="tree-child {{selectedSubcategoryId==sub.id ? 'active' : ''}}"
                    bindtap="selectSubcategory"
                    data-category="{{item.id}}"
                    data-id="{{sub.id}}"
                  >
                    <view class="tree-child-main"><strong>{{sub.name}}</strong><text>{{sub.amountText}}</text></view>
                    <text class="tree-child-meta">{{sub.quantityText}} · {{sub.customerText}}</text>
                  </view>
                </block>
                <view wx:else class="tree-empty">{{goodsDetail[item.id].error || '该大类暂无小类'}}</view>
              </block>

              <block wx:else>
                <view wx:if="{{customerList[item.id].loading && customerList[item.id].page<=1}}" class="tree-loading">正在加载客户…</view>
                <block wx:elif="{{customerList[item.id].list.length}}">
                  <view
                    wx:for="{{customerList[item.id].list}}"
                    wx:for-item="cust"
                    wx:key="customerId"
                    class="tree-child {{selectedCustomerId==cust.customerId ? 'active' : ''}}"
                    bindtap="selectCustomer"
                    data-category="{{item.id}}"
                    data-id="{{cust.customerId}}"
                  >
                    <view class="tree-child-main"><strong>{{cust.customerName}}</strong><text>{{cust.amountText}}</text></view>
                    <text class="tree-child-meta">{{cust.shareText}} · {{cust.goodsCount}}种商品</text>
                    <view class="bar-track"><view class="bar-fill" style="width: {{cust.barWidth}}%;"></view></view>
                  </view>
                  <view
                    wx:if="{{!customerList[item.id].finished}}"
                    class="tree-loadmore"
                    bindtap="loadMoreCustomers"
                    data-id="{{item.id}}"
                  >{{customerList[item.id].loading ? '加载中…' : '加载更多客户'}}</view>
                </block>
                <view wx:else class="tree-empty">{{customerList[item.id].error || '该大类暂无可分析客户'}}</view>
              </block>
            </view>
          </view>
        </scroll-view>

        <scroll-view scroll-y="true" class="detail-pane" bindscrolltolower="onProductScrollToLower">
          <block wx:if="{{viewMode==='goods'}}">
            <view class="detail-head">
              <strong>{{selectedSubcategoryName}} · 商品明细</strong>
              <text>{{visibleProducts.length}}个商品</text>
            </view>
            <view class="product-search">
              <image src="/images/search-3.png" mode="aspectFit"></image>
              <input value="{{keyword}}" placeholder="搜索商品名称、规格" bindinput="onSearchInput"></input>
              <text wx:if="{{keyword}}" bindtap="clearSearch">×</text>
            </view>
            <view wx:if="{{visibleProducts.length}}" class="product-list">
              <view wx:for="{{visibleProducts}}" wx:key="goodsId" class="product-row">
                <view class="product-title">
                  <image src="{{item.goodsImageUrl}}" mode="aspectFill" class="product-image"></image>
                  <view class="product-title-copy"><strong>{{item.goodsName}}</strong><text>{{item.goodsStandard || '未标规格'}}</text></view>
                </view>
                <view class="product-metrics">
                  <view><text>成交销售额</text><strong class="money">{{item.amountText}}</strong></view>
                  <view><text>销售数量</text><strong>{{item.quantityText}}</strong></view>
                  <view><text>加权平均价</text><strong>{{item.averagePriceText}}</strong></view>
                  <view><text>使用客户</text><strong>{{item.customerCountText}}</strong></view>
                  <view><text>订货次数</text><strong>{{item.orderCountText}}</strong></view>
                </view>
                <text class="top-customer">重要客户：{{item.topCustomerText}}</text>
              </view>
            </view>
            <view wx:else class="panel-empty large">请选择左侧小类查看商品</view>
          </block>

          <block wx:else>
            <view class="detail-head">
              <strong>{{selectedCustomerName || '客户商品'}} · 商品明细</strong>
              <text>{{customerProducts.length}}/{{customerProductTotal}}</text>
            </view>
            <view wx:if="{{productError}}" class="inline-error">{{productError}}</view>
            <view wx:if="{{!selectedCustomerId}}" class="panel-empty large">请选择左侧客户查看商品</view>
            <view wx:elif="{{customerProductLoading && customerProductPage<=1}}" class="panel-empty large">正在加载商品…</view>
            <block wx:elif="{{customerProducts.length}}">
              <view class="product-list">
                <view wx:for="{{customerProducts}}" wx:key="goodsId" class="product-row">
                  <view class="product-title">
                    <image src="{{item.goodsImageUrl}}" mode="aspectFill" class="product-image"></image>
                    <view class="product-title-copy"><strong>{{item.goodsName}}</strong><text>{{item.goodsStandard || '未标规格'}}</text></view>
                  </view>
                  <view class="product-metrics">
                    <view><text>成交销售额</text><strong class="money">{{item.amountText}}</strong></view>
                    <view><text>销售数量</text><strong>{{item.quantityText}}</strong></view>
                    <view><text>加权平均价</text><strong>{{item.averagePriceText}}</strong></view>
                    <view><text>订货次数</text><strong>{{item.orderCountText}}</strong></view>
                  </view>
                </view>
                <view
                  wx:if="{{!customerProductFinished}}"
                  class="tree-loadmore detail-loadmore"
                  bindtap="loadMoreCustomerProducts"
                >{{customerProductLoading ? '加载中…' : '加载更多'}}</view>
              </view>
            </block>
            <view wx:else class="panel-empty large">该客户在此大类下暂无商品</view>
          </block>
        </scroll-view>
      </view>
    </block>
  </view>
</view>
