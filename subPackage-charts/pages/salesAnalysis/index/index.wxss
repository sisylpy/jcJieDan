page {
  background: #f3f7f5;
  color: #203028;
}

.page {
  height: 100vh;
  overflow: hidden;
}

.page-scroll {
  box-sizing: border-box;
}

.date-bar {
  align-items: center;
  padding: 6rpx 0;
}

.retry-button {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 25rpx;
  font-weight: 750;
  background: #109c5c;
  border-radius: 12rpx;
}

.report {
  padding: 18rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-card {
  min-width: 0;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 67, 47, 0.035);
}

.summary-card text,
.summary-card small,
.summary-card strong {
  display: block;
}

.summary-card text {
  color: #7b8881;
  font-size: 22rpx;
}

.summary-card strong {
  margin-top: 8rpx;
  overflow: hidden;
  color: #24342c;
  font-size: 33rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-card small {
  margin-top: 8rpx;
  color: #0b8c52;
  font-size: 19rpx;
}

.money-card strong {
  color: #098b51;
}

.panel {
  margin-top: 16rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 16rpx;
}

.panel-heading {
  min-height: 92rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e7eeea;
}

.panel-heading > view > strong,
.panel-heading > view > text {
  display: block;
}

.panel-heading > view > strong {
  color: #223129;
  font-size: 29rpx;
}

.panel-heading > view > text,
.panel-heading > text {
  margin-top: 5rpx;
  color: #829089;
  font-size: 20rpx;
}

.category-list {
  padding: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.category-card {
  min-width: 0;
  padding: 18rpx;
  background: #f7faf8;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
}

.category-card.selected {
  background: #ebf8f1;
  border-color: #16a05f;
}

.category-main,
.category-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.category-main strong {
  overflow: hidden;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-main text {
  color: #0b8b52;
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
}

.category-meta {
  margin-top: 12rpx;
  color: #7f8b85;
  font-size: 19rpx;
}

.bar-track {
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  background: #e9efec;
  border-radius: 8rpx;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #15a161, #52bd80);
  border-radius: 8rpx;
}

.customer-bars {
  padding: 8rpx 22rpx 18rpx;
}

.customer-bar-row {
  padding: 17rpx 0;
  border-bottom: 1rpx solid #edf1ef;
}

.customer-bar-row:last-child {
  border-bottom: 0;
}

.customer-bar-head,
.drawer-customer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.customer-bar-head strong,
.drawer-customer-head strong {
  font-size: 25rpx;
}

.customer-bar-head text,
.drawer-customer-head text {
  color: #0b8b52;
  font-size: 21rpx;
  font-weight: 650;
}

.customer-caption {
  display: block;
  margin-top: 8rpx;
  color: #84908a;
  font-size: 19rpx;
}

.subcategory-scroll {
  width: 100%;
  white-space: nowrap;
}

.subcategory-row {
  padding: 16rpx;
  display: inline-flex;
  gap: 12rpx;
}

.subcategory-card {
  width: 236rpx;
  min-height: 156rpx;
  padding: 18rpx;
  display: inline-flex;
  flex-direction: column;
  box-sizing: border-box;
  white-space: normal;
  background: #f8faf9;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
}

.subcategory-card.selected {
  background: #eaf7f0;
  border-color: #16a05f;
}

.subcategory-card strong {
  font-size: 26rpx;
}

.subcategory-card text {
  margin-top: 7rpx;
  color: #7e8b84;
  font-size: 19rpx;
}

.subcategory-card .subcategory-money {
  color: #088b50;
  font-size: 24rpx;
  font-weight: 750;
}

.product-search {
  height: 70rpx;
  margin: 14rpx 18rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f3f6f4;
  border-radius: 12rpx;
}

.product-search image {
  width: 27rpx;
  height: 27rpx;
  opacity: 0.65;
}

.product-search input {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
}

.product-search > text {
  padding: 8rpx;
  color: #89938e;
  font-size: 31rpx;
}

.product-row {
  padding: 20rpx 22rpx;
  border-top: 1rpx solid #e9eeeb;
}

.product-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.product-image {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  background: #f1f6f3;
  border: 1rpx solid #e0e9e4;
  border-radius: 15rpx;
}

.product-title-copy {
  min-width: 0;
  flex: 1;
}

.product-title view strong,
.product-title view text {
  display: block;
}

.product-title view strong {
  color: #24322b;
  font-size: 30rpx;
}

.product-title view text {
  margin-top: 5rpx;
  color: #7c8982;
  font-size: 21rpx;
}

.row-arrow {
  color: #139358;
  font-size: 43rpx;
  line-height: 45rpx;
}

.product-metrics {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.product-metrics view {
  min-width: 0;
  padding: 13rpx 15rpx;
  background: #f7faf8;
  border-radius: 10rpx;
}

.product-metrics text,
.product-metrics strong {
  display: block;
}

.product-metrics text {
  color: #84908a;
  font-size: 18rpx;
}

.product-metrics strong {
  margin-top: 6rpx;
  overflow: hidden;
  color: #34423b;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-metrics strong.money {
  color: #088b50;
  font-size: 25rpx;
}

.top-customer {
  display: block;
  margin-top: 14rpx;
  color: #63716a;
  font-size: 21rpx;
}

.panel-empty {
  padding: 48rpx 20rpx;
  color: #89958f;
  font-size: 23rpx;
  text-align: center;
}

.panel-empty.large {
  padding: 90rpx 20rpx;
}

.inline-error {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  color: #a94349;
  font-size: 22rpx;
  background: #fff0f1;
  border-radius: 12rpx;
}

.data-note {
  margin: 18rpx 5rpx 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  color: #7e8b84;
  font-size: 19rpx;
}

.page-state {
  min-height: 720rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.state-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07864e;
  font-size: 34rpx;
  font-weight: 850;
  background: #e4f5ec;
  border-radius: 25rpx;
}

.state-title {
  margin-top: 24rpx;
  color: #33423a;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.state-desc {
  margin-top: 10rpx;
  color: #87938d;
  font-size: 21rpx;
}

.error-state .state-icon {
  color: #b83d46;
  background: #fde8ea;
}

.retry-button {
  width: 190rpx;
  height: 66rpx;
  margin-top: 24rpx;
}

.drawer-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 31, 24, 0.52);
}

.drawer {
  width: 100%;
  height: 82vh;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f7faf8;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -14rpx 44rpx rgba(16, 42, 28, 0.18);
}

.drawer-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 14rpx auto 4rpx;
  background: #ccd7d1;
  border-radius: 8rpx;
}

.drawer-heading {
  padding: 18rpx 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.drawer-product {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.drawer-product-image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  background: #eef5f1;
  border: 1rpx solid #dde8e2;
  border-radius: 18rpx;
}

.drawer-product-copy {
  min-width: 0;
  flex: 1;
}

.drawer-product-copy > text,
.drawer-product-copy > strong {
  display: block;
}

.drawer-product-copy > strong,
.drawer-product-copy > text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-product-copy > text:last-child {
  margin-top: 5rpx;
  color: #7d8983;
  font-size: 22rpx;
}

.drawer-heading view:first-child > text,
.drawer-heading view:first-child > strong {
  display: block;
}

.drawer-heading .drawer-eyebrow {
  color: #0b8b52;
  font-size: 20rpx;
  font-weight: 700;
}

.drawer-heading strong {
  margin-top: 6rpx;
  color: #223129;
  font-size: 34rpx;
}

.drawer-heading view:first-child > text:last-child {
  margin-top: 5rpx;
  color: #7d8983;
  font-size: 22rpx;
}

.drawer-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64716b;
  font-size: 40rpx;
  background: #eaf0ed;
  border-radius: 50%;
}

.drawer-summary {
  margin: 0 20rpx 16rpx;
  padding: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 15rpx;
}

.drawer-summary view {
  min-width: 0;
  padding: 10rpx;
}

.drawer-summary text,
.drawer-summary strong {
  display: block;
}

.drawer-summary text {
  color: #84908a;
  font-size: 18rpx;
}

.drawer-summary strong {
  margin-top: 5rpx;
  overflow: hidden;
  color: #26362e;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-customers {
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
}

.drawer-customer {
  margin: 0 20rpx 14rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e0e9e4;
  border-radius: 14rpx;
}

.drawer-customer-meta {
  margin-top: 13rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: #75827b;
  font-size: 19rpx;
}

.drawer-customer.others {
  background: #f0f4f2;
}

.drawer-state {
  padding: 80rpx 24rpx;
  color: #829089;
  font-size: 24rpx;
  text-align: center;
}

.error-text {
  color: #ad3f47;
}

/* ===== 主从布局：顶部概要 + 开关，下方左树右详情 ===== */
.page-body {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  background: #f3f7f5;
}

.top-scroll {
  flex: none;
  box-sizing: border-box;
  padding: 18rpx 20rpx 8rpx;
}

.top-bar {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.top-date {
  flex: 1;
  min-width: 0;
}

.mode-toggle {
  flex: none;
  width: 250rpx;
  display: flex;
  box-sizing: border-box;
  padding: 6rpx;
  background: #e7eeea;
  border-radius: 14rpx;
}

.mode-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d6a63;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 10rpx;
  transition: all 0.15s ease;
}

.mode-option.active {
  color: #0d7d49;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(28, 67, 47, 0.1);
}

.analysis-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  padding: 14rpx 16rpx calc(20rpx + env(safe-area-inset-bottom));
  gap: 14rpx;
}

.tree-pane {
  width: 268rpx;
  flex: none;
  height: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 16rpx;
}

.detail-pane {
  flex: 1;
  min-width: 0;
  height: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 16rpx;
}

.tree-node {
  border-bottom: 1rpx solid #eef2f0;
}

.tree-node:last-child {
  border-bottom: 0;
}

.tree-category {
  padding: 18rpx 16rpx;
  cursor: pointer;
}

.tree-category.open {
  background: #f1f8f4;
}

.tree-category-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tree-category-main strong {
  overflow: hidden;
  font-size: 26rpx;
  color: #233129;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.caret {
  color: #0b8b52;
  font-size: 22rpx;
  flex: none;
}

.tree-category-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  color: #7f8b85;
  font-size: 19rpx;
}

.tree-share {
  color: #0b8b52;
  font-weight: 650;
}

.tree-children {
  padding: 6rpx 12rpx 14rpx 30rpx;
  background: #f7faf8;
}

.tree-child {
  padding: 15rpx 14rpx;
  margin-top: 8rpx;
  background: #fff;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  cursor: pointer;
}

.tree-child.active {
  background: #eaf7f0;
  border-color: #16a05f;
}

.tree-child-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.tree-child-main strong {
  overflow: hidden;
  font-size: 24rpx;
  color: #24322b;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tree-child-main text {
  color: #0b8b52;
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
}

.tree-child-meta {
  display: block;
  margin-top: 7rpx;
  color: #7e8b84;
  font-size: 18rpx;
}

.tree-loading,
.tree-empty {
  padding: 24rpx 14rpx;
  color: #89958f;
  font-size: 21rpx;
  text-align: center;
}

.tree-loadmore {
  margin: 14rpx 8rpx 6rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0d7d49;
  font-size: 22rpx;
  font-weight: 700;
  background: #eef6f1;
  border-radius: 12rpx;
}

.detail-head {
  min-height: 84rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #e7eeea;
}

.detail-head strong {
  color: #223129;
  font-size: 28rpx;
}

.detail-head > text {
  color: #829089;
  font-size: 20rpx;
  white-space: nowrap;
}

.detail-loadmore {
  margin: 16rpx 22rpx 24rpx;
}

/* 商品明细列里的搜索框与列表沿用既有 .product-search / .product-row 样式 */
.detail-pane .product-search {
  margin: 14rpx 18rpx;
}

.detail-pane .product-list {
  padding-bottom: 20rpx;
}

/* ===== 2026-10：同步桌面端统计口径，并按移动端主从列表重新排版 ===== */
.top-scroll {
  padding-bottom: 12rpx;
  background: #f7faf8;
}

.summary-grid {
  margin-top: 14rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 67, 47, 0.035);
}

.summary-card {
  min-height: 116rpx;
  padding: 16rpx 12rpx;
  border: 0;
  border-right: 1rpx solid #e1e9e5;
  border-radius: 0;
  box-shadow: none;
}

.summary-card:last-child {
  border-right: 0;
}

.summary-card.profit-card {
  background: #f2faf6;
}

.summary-card text {
  font-size: 18rpx;
}

.summary-card strong,
.summary-card strong.money {
  margin-top: 7rpx;
  font-size: 27rpx;
  line-height: 34rpx;
}

.summary-card small {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 16rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-card .negative,
.negative {
  color: #c43e48 !important;
}

.data-note {
  margin: 12rpx 4rpx 0;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4rpx 14rpx;
  font-size: 17rpx;
}

.analysis-body {
  padding: 0 14rpx calc(18rpx + env(safe-area-inset-bottom));
  gap: 0;
}

.tree-pane {
  width: 218rpx;
  background: #f2f5f3;
  border-radius: 16rpx 0 0 16rpx;
}

.detail-pane {
  border-left: 0;
  border-radius: 0 16rpx 16rpx 0;
}

.tree-category {
  padding: 16rpx 12rpx;
}

.tree-category.open {
  background: #eef8f3;
  box-shadow: inset 4rpx 0 0 #12a060;
}

.tree-category-main {
  position: relative;
  align-items: center;
  gap: 9rpx;
}

.tree-category-main .caret {
  width: 16rpx;
  font-size: 21rpx;
  text-align: center;
}

.tree-category-visual {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  overflow: hidden;
  background: #e6f5ed;
  border-radius: 50%;
}

.tree-category-visual image {
  width: 100%;
  height: 100%;
}

.tree-category-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #15985b;
  font-size: 23rpx;
  font-weight: 800;
}

.tree-category-copy {
  min-width: 0;
  flex: 1;
}

.tree-category-copy strong,
.tree-category-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tree-category-copy strong {
  color: #24322b;
  font-size: 24rpx;
}

.tree-category-copy text {
  margin-top: 5rpx;
  color: #42534a;
  font-size: 19rpx;
  font-weight: 700;
}

.tree-category-meta {
  margin: 8rpx 0 0 83rpx;
  justify-content: flex-start;
  font-size: 19rpx;
}

.tree-category > .bar-track {
  margin: 8rpx 0 0 83rpx;
}

.tree-children {
  padding: 6rpx 8rpx 14rpx 24rpx;
  background: #f7faf8;
}

.tree-child {
  padding: 13rpx 10rpx;
  margin-top: 7rpx;
  border-width: 1rpx;
  border-radius: 10rpx;
}

.tree-child-main {
  align-items: flex-start;
  flex-direction: column;
  gap: 5rpx;
}

.tree-child-main strong {
  width: 100%;
  font-size: 22rpx;
}

.tree-child-main text {
  font-size: 19rpx;
}

.tree-child-meta {
  margin-top: 5rpx;
  font-size: 17rpx;
}

.detail-head {
  min-height: 76rpx;
  padding: 14rpx 18rpx;
}

.detail-head > view {
  min-width: 0;
}

.detail-head strong,
.detail-head text {
  display: block;
}

.detail-head strong {
  overflow: hidden;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-head view > text {
  margin-top: 4rpx;
  color: #839089;
  font-size: 18rpx;
}

.detail-kpis {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-bottom: 1rpx solid #e7eeea;
  background: #f8fbf9;
}

.detail-kpis > view {
  min-width: 0;
  padding: 12rpx 10rpx;
  border-right: 1rpx solid #e2eae6;
}

.detail-kpis > view:last-child {
  border-right: 0;
}

.detail-kpis text,
.detail-kpis strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-kpis text {
  color: #829089;
  font-size: 17rpx;
}

.detail-kpis strong {
  margin-top: 5rpx;
  color: #087f4c;
  font-size: 22rpx;
}

.detail-pane .product-search {
  height: 62rpx;
  margin: 12rpx 14rpx;
  padding: 0 14rpx;
}

.detail-pane .product-search input {
  font-size: 21rpx;
}

.product-row {
  padding: 20rpx 18rpx;
  border-top: 1rpx solid #e7edea;
  background: #fff;
}

.product-row:active {
  background: #f0f9f4;
}

.product-image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 13rpx;
}

.product-title {
  justify-content: flex-start;
  gap: 13rpx;
}

.product-title view strong {
  font-size: 28rpx;
}

.product-title view text {
  font-size: 20rpx;
}

.row-arrow {
  width: 40rpx;
  height: 40rpx;
  margin-left: auto;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfe1d7;
  border-radius: 10rpx;
  background: #f7fbf9;
  font-size: 34rpx;
  line-height: 1;
}

.product-metrics {
  margin-top: 17rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  border-top: 1rpx solid #edf1ef;
  border-bottom: 1rpx solid #edf1ef;
}

.product-metrics view {
  padding: 13rpx 9rpx;
  background: transparent;
  border-right: 1rpx solid #edf1ef;
  border-radius: 0;
}

.product-metrics view:last-child {
  border-right: 0;
}

.product-metrics text {
  font-size: 17rpx;
}

.product-metrics strong,
.product-metrics strong.money {
  margin-top: 5rpx;
  font-size: 24rpx;
}

.product-metrics strong.profit {
  color: #087f4c;
}

.product-secondary {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7rpx 14rpx;
  color: #65736c;
  font-size: 19rpx;
}

.product-secondary text {
  position: relative;
}

.product-secondary text:not(:last-child)::after {
  position: absolute;
  right: -9rpx;
  color: #c9d3ce;
  content: '·';
}

.top-customer {
  margin-top: 9rpx;
  overflow: hidden;
  color: #75827b;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer {
  height: 78vh;
}

.drawer-share-title {
  margin: 0 20rpx 12rpx;
  padding: 17rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1rpx solid #dfe8e3;
  border-radius: 15rpx;
}

.drawer-share-title strong {
  color: #213029;
  font-size: 32rpx;
}

.drawer-share-title text {
  padding: 5rpx 13rpx;
  color: #087f4c;
  font-size: 20rpx;
  font-weight: 800;
  background: #e9f6ef;
  border-radius: 18rpx;
}

.drawer-customer-head > view {
  flex: none;
  text-align: right;
}

.drawer-customer-head > view text,
.drawer-customer-head > view small {
  display: block;
}

.drawer-customer-head > view text {
  color: #087f4c;
  font-size: 25rpx;
  font-weight: 800;
}

.drawer-customer-head > view small {
  margin-top: 4rpx;
  color: #7b8881;
  font-size: 18rpx;
}

.drawer-customer-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13rpx 18rpx;
}

.drawer-customer-meta view {
  min-width: 0;
}

.drawer-customer-meta view text,
.drawer-customer-meta view strong {
  display: block;
}

.drawer-customer-meta view text {
  color: #7d8983;
  font-size: 21rpx;
}

.drawer-customer-meta view strong {
  margin-top: 5rpx;
  overflow: hidden;
  color: #405049;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 真机可读性：主体贴合可视区，统计与明细统一放大 ===== */
.top-scroll {
  width: 100%;
  flex: none;
  box-sizing: border-box;
}

.mode-toggle {
  width: 270rpx;
}

.mode-option {
  font-size: 28rpx;
}

.summary-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  overflow: visible;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.summary-card,
.summary-card:last-child {
  min-height: 122rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 14rpx;
}

.summary-card text {
  font-size: 22rpx;
}

.summary-card strong,
.summary-card strong.money {
  margin-top: 7rpx;
  font-size: 32rpx;
  line-height: 39rpx;
}

.summary-card small {
  margin-top: 7rpx;
  font-size: 20rpx;
  line-height: 26rpx;
}

.data-note {
  font-size: 20rpx;
  line-height: 29rpx;
}

.analysis-body {
  min-height: 0;
  overflow: hidden;
}

.tree-pane,
.detail-pane {
  min-height: 0;
}

.tree-category-main .caret {
  font-size: 25rpx;
}

.tree-category-placeholder {
  font-size: 26rpx;
}

.tree-category-copy strong {
  font-size: 27rpx;
  line-height: 34rpx;
}

.tree-category-copy text {
  font-size: 22rpx;
  line-height: 29rpx;
}

.tree-category-meta {
  font-size: 22rpx;
}

.tree-child-main strong {
  font-size: 25rpx;
  line-height: 32rpx;
}

.tree-child-main text {
  font-size: 22rpx;
  line-height: 29rpx;
}

.tree-child-meta {
  font-size: 20rpx;
  line-height: 27rpx;
}

.tree-loading,
.tree-empty,
.tree-loadmore {
  font-size: 23rpx;
}

.detail-head strong {
  font-size: 30rpx;
  line-height: 38rpx;
}

.detail-head view > text,
.detail-head > text {
  font-size: 22rpx;
}

.detail-kpis text {
  font-size: 20rpx;
}

.detail-kpis strong {
  font-size: 25rpx;
  line-height: 32rpx;
}

.detail-pane .product-search {
  height: 70rpx;
}

.detail-pane .product-search input {
  font-size: 24rpx;
}

.product-title view strong {
  font-size: 31rpx;
  line-height: 39rpx;
}

.product-title view text {
  font-size: 23rpx;
}

.product-metrics text {
  font-size: 20rpx;
  line-height: 27rpx;
}

.product-metrics strong,
.product-metrics strong.money {
  font-size: 27rpx;
  line-height: 34rpx;
}

.product-secondary {
  font-size: 22rpx;
  line-height: 29rpx;
}

.top-customer {
  font-size: 21rpx;
  line-height: 29rpx;
}

.panel-empty,
.drawer-state {
  font-size: 25rpx;
}

.drawer-heading .drawer-eyebrow {
  font-size: 22rpx;
}

.drawer-heading strong {
  font-size: 36rpx;
}

.drawer-product-copy > text:last-child,
.drawer-heading view:first-child > text:last-child {
  font-size: 24rpx;
}

.drawer-share-title strong {
  font-size: 34rpx;
}

.drawer-share-title text {
  font-size: 22rpx;
}

.drawer-customer-head strong {
  font-size: 29rpx;
}

.drawer-customer-head > view text {
  font-size: 28rpx;
}

.drawer-customer-head > view small {
  font-size: 21rpx;
}

.drawer-customer-meta view text {
  font-size: 23rpx;
}

.drawer-customer-meta view strong {
  font-size: 27rpx;
}
