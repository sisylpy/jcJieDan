<!-- goodsOperation -->
<view class='overlay {{showOperation ? "show" : ""}}' catchtouchmove='ture' catchtap="hideMask" >
  <view class="flex-column nnn bg-white font-lg">

    <view class="font-lg-2 font-bold center-content border-bottom">
      <text class="p-30">{{depName}}</text>
    </view>

   <block wx:if="{{environment == 'wxwork'}}">
    <view class="flex flex-row p-20" catchtap="toRecord" hover-class="hover">
      <image src="/images/voice-2.png" class="icon mr-20"></image>
      <text class="">语音下单</text>
    </view>
   </block>
   

    <view class=" flex  flex-row p-30 border-bottom "  catchtap="toPaste" hover-class="hover">
      <image src="/images/paste.png" class="icon mr-20" ></image>
      <text class="">粘贴下单</text>
    </view>
   
    <view class="flex flex-row p-30 border-bottom" catchtap="toResGoods" hover-class="hover" data-id="{{applyItem.nxDepartmentOrdersId}}">
      <image src="../../../../images/add.png" class="icon mr-20"></image>
      <text class="">添加订单</text>
    </view>
    <view class="flex flex-row p-30" catchtap="toResGoodsList" hover-class="hover" data-id="{{applyItem.nxDepartmentOrdersId}}">
      <image src="../../../../images/cg.png" class="icon mr-20"></image>
      <text class="">客户订货端</text>
    </view>
    <view style="height: 40rpx;"></view>

  </view>

</view>
