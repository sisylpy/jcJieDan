 
 
 <view class="flex-column flex">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{depName}}" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column">
    <view class="flex-row-between p-20" >
          <view class=" flex-row  mainBack_btn" bindtap="reuploadOrders">
            <image src="/images/add-active.png" class="icon-sm mr-10 ml-10"></image>
            <text class="font-xs pr-10">重新上传</text>
          </view>
          <view class=" flex-row   mainBack_btn" bindtap="showCorrectionModal" >
            <image src="/images/edit-main.png" class="icon-sm mr-10 ml-10"></image>
            <text class="font-xs pr-10">AI调整</text>
          </view>
        
          <!-- 非朗读模式下的朗读模式按钮 -->
          <view class="flex-row mainBack_btn" bindtap="colseCheck" wx:if="{{isCheckMode}}">
            <image src="/images/add-active.png" class="icon-sm mr-10 ml-10"></image>
            <text class="font-xs pr-10">关闭</text>
          </view>
          <view class="flex-row mainBack_btn" bindtap="enterReadingMode" wx:else="">
            <image src="/images/add-active.png" class="icon-sm mr-10 ml-10"></image>
            <text class="font-xs pr-10">检查</text>
          </view>


        </view>
      <!-- 朗读模式/检查模式：上下布局（文字自适应，最大1/3 + 订单灵活占据剩余空间） -->
      <view wx:if="{{isTTSReading || isCheckMode}}" class="flex-column reading-mode-container" style="position: relative; flex: 1; min-height: 0; height: {{windowHeight - navBarHeight}}rpx;">
        <!-- 上半部分：文字内容显示区域（自适应高度，最大不超过1/3页面高度） -->
        <view class="text-content-container" style="max-height: {{(windowHeight - navBarHeight) / 3}}rpx; flex-shrink: 0;">
         
          <scroll-view scroll-y="true" class="text-content-scroll" style="max-height: {{(windowHeight - navBarHeight) / 3 - 80}}rpx;">
            <view class="text-content-wrapper">
              <rich-text wx:if="{{highlightedText}}" class="text-content" nodes="{{highlightedText}}"></rich-text>
              <text wx:else class="text-content">{{task.nxOcrTaskOcrText || '暂无文字内容'}}</text>
            </view>
          </scroll-view>
        </view>

        <!-- 下半部分：订单列表（灵活占据剩余空间，编辑时占据更多空间） -->
        <scroll-view scroll-y="true" class="order-list-scroll-view {{orderArrIndex >= 0 ? 'order-list-expanded' : ''}}" id="order-list-scroll-view-reading" style="flex: 1; min-height: 0; padding-bottom: 160rpx;" scroll-top="{{scrollTop}}" scroll-with-animation="true" enhanced="true" show-scrollbar="false">
          <ocrOrderList
            list="{{orderArr}}"
            active-index="{{currentTTSIndex}}"
            is-reading-mode="{{isTTSReading && !isCheckMode}}"
            is-playing="{{isTTSPlaying}}"
            stopped-index="{{stoppedIndex}}"
            order-arr-index="{{orderArrIndex}}"
            str-arr="{{strArr}}"
            nx-arr="{{nxArr}}"
            window-width="{{windowWidth}}"
            scroll-into-view-id="{{scrollIntoViewId}}"
            dep-id="{{depId}}"
            dep-father-id="{{depFatherId}}"
            dis-id="{{disId}}"
            user-id="{{userId}}"
            bind:edit="onOrderEdit"
            bind:editName="onOrderEditName"
            bind:focus="onOrderFocus"
            bind:showGoods="onOrderShowGoods"
            bind:closeGoods="onOrderCloseGoods"
            bind:saveOrder="onOrderSaveOrder"
            bind:downloadGoods="onOrderDownloadGoods"
            bind:showOperation="onOrderShowOperation"
            bind:scrollToItem="onScrollToItem"
            bind:confirmSearch="confirmSearchGoods"
            bind:orderUpdated="onOrderUpdated"
          ></ocrOrderList>
           <view  class="flex-column-center text-secondary font-xs" style="height: 200rpx;">没有订单了</view>
        </scroll-view>

      </view>

      <!-- 非朗读模式：完整布局（订单占满） -->
      <view wx:else class="flex-column" style="flex: 1; min-height: 0; background-color: #f5f5f5;">
        


        <scroll-view scroll-y="true" class="order-list-scroll-view" id="order-list-scroll-view-normal" style="height: {{windowHeight - 120 - navBarHeight}}rpx; padding-bottom: {{(isTTSReading || isCheckMode) ? '160rpx' : '0'}};" scroll-into-view="{{scrollIntoViewId}}" scroll-with-animation="true">
          <ocrOrderListNormal
            list="{{orderArr}}"
            active-index="{{currentTTSIndex}}"
            order-arr-index="{{orderArrIndex}}"
            str-arr="{{strArr}}"
            nx-arr="{{nxArr}}"
            window-width="{{windowWidth}}"
            bind:edit="onOrderEdit"
            bind:editName="onOrderEditName"
            bind:focus="onOrderFocus"
            bind:showGoods="onOrderShowGoods"
            bind:closeGoods="onOrderCloseGoods"
            bind:saveOrder="onOrderSaveOrder"
            bind:downloadGoods="onOrderDownloadGoods"
            bind:showOperation="onOrderShowOperation"
            bind:confirmSearch="confirmSearchGoods"
          ></ocrOrderListNormal>
          <view  class="flex-column-center text-center text-secondary font-xs" style="height: 200rpx;">没有订单了！</view>
        </scroll-view>
        <view style="height: 200rpx; padding: 60rpx 0;" class="text-secondary font-xs center-content">
          <text style="color: #999; font-size: 36rpx;">没有更多数据了</text>
      </view>

      <view class="empty-tip" wx:if="{{orderArr.length === 0}}">
        <image src="/images/robot-solid.png" mode="aspectFit" style="width: 120rpx; height: 120rpx; opacity: 0.5; margin-bottom: 20rpx;"></image>
        <text style="display: block; margin-top: 20rpx; color: #999; font-size: 30rpx;">没有识别到订单信息</text>
        <text style="display: block; margin-top: 10rpx; color: #bbb; font-size: 30rpx;">请重新上传图片识别</text>
        </view>
      </view>

  </view>

  <!-- 固定在底部的 TTS 播放器（仅在确认订单页面且朗读/检查模式下显示，操作菜单打开时隐藏，因订单状态-2停止时隐藏） -->
  <block wx:if="{{ (isTTSReading || isCheckMode) && !playerHidden && !isStoppedByStatusMinus2}}">
    <view class="fixed-player-container">
      <ocrTTSPlayer
        is-playing="{{isTTSPlaying}}"
        is-loading="{{isTTSLoading}}"
        is-paused="{{stoppedIndex >= 0}}"
        current-text="{{currentReadingText}}"
        current-index="{{currentTTSIndex}}"
        total-count="{{ttsQueue.length}}"
        error="{{ttsError}}"
        order-count="{{orderArr.length}}"
        is-reading-mode="{{isCheckMode}}"
        bind:play="readOrderList"
        bind:pause="pauseReading"
        bind:continue="continueReading"
        bind:restart="restartReading"
        bind:close="closeReading"
      ></ocrTTSPlayer>
    </view>
  </block>

</view>

<!-- pasteOperation 操作菜单 -->
<view class='overlay {{showOperationPaste ? "show" : "hide"}}' catchtouchmove='ture' catchtap="hideMask">
  <view class="nnn bg-white  font-lg" >
    <view class="center-content border-bottom">
      <text class="p-30">{{orderItem && orderItem.nxDoGoodsName ? orderItem.nxDoGoodsName : ''}}</text>
    </view>
    <view class="flex-column">
      <!-- 已保存订单显示修改订单，草稿订单显示删除订单 -->
      <view class="flex-row p-30 border-bottom" catchtap="{{orderItem && orderItem.nxDoStatus == 0 ? 'editOrderItem' : 'delOrder'}}" hover-class="hover" wx:if="{{orderItem && orderItem.nxDoStatus == 0}}">
        <image src="/images/edit.png" class="icon mr-20"></image>
        <text class="">修改订单</text>
      </view>
      <view class="flex-row p-30 border-bottom" catchtap="delOrder" hover-class="hover" wx:if="{{orderItem && orderItem.nxDoStatus != 0}}">
        <image src="/images/edit.png" class="icon mr-20"></image>
        <text class="">删除订单</text>
      </view>


      <view class="flex-row p-30" catchtap="addNewPasteOrderBefore" hover-class="hover">
        <image src="/images/add-bold-2.png" class="icon mr-20"></image>
        <text class="">在之前加新订单</text>
      </view>
      <view class="flex-row p-30" catchtap="addDisAlias" hover-class="hover" wx:if="{{orderItem && orderItem.nxDoStatus == -2}}">
        <image src="/images/add-bold-2.png" class="icon mr-20"></image>
        <text class="">添加临时商品</text>
      </view>
      <view class="flex-row p-30" catchtap="startReadingFromHere" hover-class="hover" >
        <image src="/images/add-bold-2.png" class="icon mr-20"></image>
        <text class="">从这里开始朗读</text>
      </view>
    </view>

    <view style="height: 20rpx;"></view>
  </view>
</view>
<!-- ../pasteOperation -->

<!-- 编辑订单弹窗 -->
<addOrder visible="{{show}}" bindconfirm="confirm" bindcancle="cancle" binddelApply="delApply" binddelStandard="delStandard" applyStandardName="{{applyStandardName}}" bindconfirmStandard="confirmStandard" applyNumber="{{applyNumber}}" applyRemark="{{applyRemark}}" editApply="{{editApply}}" bindchangeStandard="changeStandard" applyGoodsName="{{applyGoodsName}}" applyGoodsId="{{applyGoodsId}}" item="{{itemDis}}" windowWidth="{{windowWidth}}" newStandardName="{{newStandardName}}" />

<!-- 警告弹窗 -->
<delWarnModal wx:if="{{showPopupWarn}}" type="{{popupType}}" warnContent="{{warnContent}}" bind:closeWarn="closeWarn" bind:confirmWarn="confirmWarn" />

<!-- 订单修正弹窗 -->
<correctionModal show="{{showCorrectionModal}}" defaultText="{{correctionDefaultText}}" bind:cancel="onCorrectionModalCancel" bind:confirm="onCorrectionModalConfirm" />