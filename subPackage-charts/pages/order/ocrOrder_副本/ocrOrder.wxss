/* 文字内容容器 */
.text-content-container {
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-bottom: 2px solid #e5e5e5;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  /* 自适应高度，但不超过max-height */
}

.text-content-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1px solid #e5e5e5;
  flex-shrink: 0;
  height: 80rpx;
  box-sizing: border-box;
}

.text-content-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.text-content-scroll {
  width: 100%;
  overflow-y: auto;
  /* 自适应高度，根据内容调整 */
}

.text-content-wrapper {
  padding: 30rpx;
  box-sizing: border-box;
  /* 允许文本选择 */
  user-select: text;
  -webkit-user-select: text;
}

.text-content {
  display: block;
  font-size: 34rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
  word-break: break-all;
  background-color: #fafafa;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1px solid #e5e5e5;
  /* 允许文本选择 */
  user-select: text;
  -webkit-user-select: text;
}

/* 加载更多容器 */
.load-more-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  min-height: 120rpx;
}

.load-more-loading {
  color: #999;
  font-size: 28rpx;
}

.load-more-tip {
  color: #999;
  font-size: 28rpx;
}

/* 朗读模式容器 */
.reading-mode-container {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease;
}

/* 订单列表 - flex 填满剩余空间 */
.order-list-scroll-view {
  transition: height 0.3s ease, padding-top 0.3s ease;
  background-color: transparent;
  padding-top: 0;
  flex: 1 1 0; /* flex-grow:1 flex-shrink:1 flex-basis:0 确保正确分配高度 */
  min-height: 0;
  box-sizing: border-box;
}

.order-list-scroll-view.order-list-expanded {
  /* 编辑时占据更多空间 */
  flex: 1;
}

/* 识别弹窗打开时提高 z-index，使弹窗不被上半部分图片遮挡 */
.order-list-scroll-view.order-list-recognition-modal-open {
  position: relative;
  z-index: 10010;
}

/* 固定在底部的播放器容器 */
