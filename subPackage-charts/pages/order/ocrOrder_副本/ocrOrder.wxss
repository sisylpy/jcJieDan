.page-bg {
  background: linear-gradient(180deg, #f8f9fa 0%, #f5f5f5 100%);
  /* min-height: 100vh; */
}

.upload-section,
.recognizing-section,
.confirm-section {
  width: 100%;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.image-item {
  position: relative;
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.image-item:active {
  transform: scale(0.98);
}

.image-preview {
  width: 100%;
  height: 100%;
}

/* 图片画布容器 */
.image-canvas-container {
  position: relative;
  overflow: hidden;
}

/* 无限画布 - 超大画布，居中偏移 */
.big-canvas {
  width: 300vw;
  height: 300vh;
  position: absolute;
  left: -100vw;
  top: -100vh;

}

/* 图片层 */
/* .image-view {
  will-change: transform;
  box-sizing: border-box;
} */
.image-view {
  width: 350px; 
  height: 600px;
  border: 10px solid rgb(255, 0, 76);
}


/* 图片本体 - 尺寸固定，不随 scale 变化 */
.image-view .image-preview {
  width: 100%;
  height: 100%;
  pointer-events: none;
  display: block;
  object-fit: contain;
}

/* 缩放工具栏 */
.zoom-panel {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 70rpx;
  height: 360rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  z-index: 100;
  pointer-events: auto; /* 确保工具栏可以点击 */
}

/* + / - 按钮 */
.zoom-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  color: #000;
  text-align: center;
  line-height: 48rpx;
  font-size: 32rpx;
  margin: 10rpx 0;
  flex-shrink: 0;
}

/* 滑动条 */
.zoom-slider {
  flex: 1;
  margin: 10rpx 0;
}

/* 工具条样式 */
.image-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.toolbar-btn {
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.toolbar-btn:active {
  transform: scale(0.9);
  opacity: 0.8;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.image-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 196, 140, 0.9);
  padding: 8rpx;
  text-align: center;
}

.image-status.error {
  background-color: rgba(255, 0, 0, 0.9);
}

.status-text {
  color: #fff;
  font-size: 26rpx;
}

.add-image {
  border: 2rpx dashed #00c48c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0fdfa 0%, #e6faf5 100%);
  transition: all 0.3s ease;
}

.add-image:active {
  border-color: #00a876;
  background: linear-gradient(135deg, #e6faf5 0%, #d4f5eb 100%);
}

.add-icon {
  font-size: 68rpx;
  color: #00c48c;
  line-height: 1;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.add-text {
  font-size: 30rpx;
  color: #00a876;
  font-weight: 500;
}

/* 识别中页面 */
.recognizing-section {
  padding: 40rpx 0;
}

.progress-container {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 196, 140, 0.15);
}

.progress-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #e5e5e5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00c48c, #00a876);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.image-status-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.status-item:active {
  transform: scale(0.98);
}

.status-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.status-label {
  font-size: 32rpx;
  color: #333;
}


.icon-sm {
  width: 24rpx;
  height: 24rpx;
}

/* 朗读模式容器：整体向上推 1/3 */
.reading-mode-container {
  transition: transform 0.3s ease;
}

.container-pushed-up {
  transform: translateY(-33.33%);
}

/* 图片预览容器 */
.image-preview-container {
  transition: transform 0.3s ease;
}

/* 订单列表展开状态 */
.order-list-scroll-view {
  transition: height 0.3s ease, padding-top 0.3s ease;
  background-color: transparent;
  padding-top: 0;
}

/* 固定在底部的播放器容器 */
.fixed-player-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: red;
}




/* ocrOrder 页面布局 - 用 100vh 撑满视口，消除底部约 100px 空白 */
.ocr-order-page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.ocr-order-content {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.page-bg {
  background: linear-gradient(180deg, #f8f9fa 0%, #f5f5f5 100%);
}

/* 非朗读模式：列表底部「加载更多」 */
.order-list-loading-more {
  padding: 32rpx 0 48rpx;
  gap: 16rpx;
}
.order-list-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: order-list-spin 0.8s linear infinite;
}
.order-list-loading-text {
  font-size: 24rpx;
  color: #999;
}
@keyframes order-list-spin {
  to { transform: rotate(360deg); }
}

