<view class="flex flex-column">

  <back-navbar style="height: {{navBarHeight}}rpx;" title="{{depName}}" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <view class="flex-column p-10" style="position: relative; overflow: visible;">
    <view class="flex-column p-20" wx:if="{{orderArr.length == 0}}">
      <view class="flex-row p-10">
        <text>录音时长：{{duration}}秒</text>
        <text class="ml-20 text-danger ">{{isRecording ? '录音中': ''}}</text>
      </view>
      <view class="flex-row">

        <textarea class="mr-20 p-20 sentence {{sentence !== null ? 'is-active' : ''}}" value="{{sentence}}" style="width: {{windowWidth - 220}}rpx; height: {{orderArr.length == 0 ? windowHeight  - navBarHeight -  140 : windowHeight  - navBarHeight - 300}}rpx; font-size: 42rpx; margin-right: 20rpx;" bindinput="onInput" maxlength="-1" />

        <view class="flex-column center-content flex-1 ">

          <view bindtap="{{isRecording ? 'stopRecord' : 'startRecord'}}" class="third_btn  mb-20 {{isRecording ? 'recording' : ''}}" hover-class="thirdHover" style="text-align: center; font-size: 32rpx; margin-bottom: 40rpx;"> {{isRecording ? '停止录音' : '开始录音'}}</view>
          <view bindtap="aiRecogniseFirst" class="third_btn mt-10 mb-20">AI识别</view>

          <view class="" style="border: 1px solid #c9f1eb; width: 100%;height: 1rpx; margin-bottom: 40rpx;"></view>

          <view bindtap="clearSentence" class="third_btn mt-10">清除</view>
        </view>
      </view>
    </view>

    <view wx:else="" class="flex-row-between">

      <!-- 状态1：saveCount == null 时显示草稿编辑状态的按钮 -->
      <block wx:if="{{saveCount == null}}">
        <view class="flex-row-between p-20" style="margin-top: 20rpx; width: {{windowWidth - 40}}rpx; ">

          <view class="flex-row bg-gray radius-10 p-10" bindtap="againPaste">
            <text>重新粘贴</text>
          </view>
          <!-- <view class="flex-row bg-success radius-10 p-10" bindtap="againAi">
            <text>再次AI识别</text>
          </view> -->

          <text bindtap="pasteSearchGoods" class='mainBack_new_btn mr-20'>保存订单</text>
        </view>
      </block>
      
      <!-- 状态2：saveCount != null 时，已保存订单状态，不显示保存按钮 -->

    </view>

    <scroll-view scroll-y="true" style="height: {{windowHeight - navBarHeight - (saveCount == null ? 120 : 40)}}rpx; overflow: visible;" wx:if="{{orderArr.length > 0}}" class="table">

      <!-- 状态1：saveCount == null 时显示草稿编辑界面 -->
      <block wx:if="{{saveCount == null}}">

        <view class="flex-row" style="background-color: #eeeeee; padding: 10rpx;">
          <text class="" style="width: {{windowWidth * 11 / 20}}rpx; margin-left: 60rpx;">商品名称</text>
          <text class="" style="width: {{windowWidth * 3 / 20}}rpx;">数量</text>
          <text class="" style="width: {{windowWidth * 3 / 20}}rpx; ">规格</text>
        </view>
        <view class="p-20  flex-row border-bottom" wx:for="{{orderArr}}" wx:for-index="orderIndex" wx:key="orderIndex">
          <view class="flex-column">
            <view class="flex-row-default">
              <view class="flex-row font-bold" style="width: {{windowWidth * 11 / 20}}rpx; ">
                <text class="mr-10 text-secondary">{{orderIndex + 1}}.</text>
                <!-- name -->
                <view class="flex-column">
                  <input class="input" style="width: {{windowWidth / 2 - 80}}rpx; " type="text" bindinput="editOrder" data-type="name" data-index="{{orderIndex}}" value="{{item.nxDoGoodsName}}" />
                </view>
              </view>
              <!-- ../name -->

              <!-- quantity -->
              <input class="input  p-10 mr-10" type="number" bindinput="editOrder" data-type="quantity" data-index="{{orderIndex}}" value="{{item.nxDoQuantity}}" style="width: {{windowWidth / 7 - 20}}rpx; " />
              <!-- ../quantity -->
              <!-- standard -->
              <input class="input p-10 mr-10" type="text" bindinput="editOrder" data-type="standard" data-index="{{orderIndex}}" value="{{item.nxDoStandard}}" style="width: {{windowWidth / 7}}rpx;" />

              <!-- ../standard -->

              <!-- </view> -->
            </view>
            <view class="flex-row" wx:if="{{item.standardWeight !== '' && item.standardWeight !== '500g'}}">
              <text class="mr-10 text-white pt-10">{{orderIndex + 1}}.</text>

               <view class="flex-row">
                <text>规格重量:</text>
                <text>{{item.standardWeight}}/{{item.itemUnit}}</text>
               </view>
               <view class="flex-row ">
                <text wx:if="{{item.itemsPerCarton !== ''}}">*{{item.itemsPerCarton}}{{item.itemUnit}}</text>
                <text  wx:if="{{item.cartonUnit !== ''}}">{{item.cartonUnit}}</text>
               </view>
              
              </view>
              <view class="flex-row p-10" wx:if="{{item.nxDoAddRemark || item.nxDoRemark}}" style="margin-top: 12rpx; padding-left: 60rpx;">
                <text class="mr-10 text-secondary font-sl" style="color: #999; font-size: 34rpx;">备注:</text>
                <text wx:if="{{item.nxDoStatus == 0}}" style="flex: 1; font-size: 36rpx; color: #333333;">{{item.nxDoRemark || ''}}</text>
                <input wx:else class="input p-10 {{item.nxDoStatus == -2 ? 'status-draft' : 'status-saved'}}" type="text" bindinput="editOrder" data-type="remark" data-index="{{orderIndex}}" value="{{item.nxDoRemark}}" style="flex: 1; font-size: 36rpx; color: #333333; border-color: {{item.nxDoStatus == -2 ? '#00c48c' : '#e0e0e0'}};" placeholder="添加备注信息" />
              </view>

           
          </view>


          <view class="button-container" bindtap="showPasteOperation" data-index="{{orderIndex}}">
            <image src="/images/points.png" mode="aspectFill" class="icon" />
          </view>

          <!-- </view> -->
        </view>
        <view style="height: 200rpx;" class="text-secondary font-xs center-content">没有数据啦！</view>
      </block>

      <view class="flex-column" wx:else="">

        <view class="flex-row">
            <text class="mainBack_new_btn" bind:tap="clearSave" style="width: {{windowWidth / 6}}rpx; margin-left: 10rpx;" wx:if="{{hasCache}}">除缓存</text>

            <text class="mainBack_new_btn" bind:tap="reuploadOrders" style="width: {{windowWidth / 6}}rpx; margin-left: 10rpx;" wx:if="{{hasCache}}">重新上传</text>
            
            <text class="mainBack_new_btn" bind:tap="showCorrectionModal" style="width: {{windowWidth / 6}}rpx; margin-left: 10rpx;" wx:if="{{hasCache}}">调整订单内容</text>
           </view>

        <view class="flex-row border-bottom" style="padding: 10rpx;">
          <text class="" style="width: {{windowWidth / 2}}rpx; margin-left: 60rpx;">商品名称</text>
          <text class="" style="width: {{windowWidth / 5}}rpx;">数量</text>
          <text class="" style="width: {{windowWidth / 5}}rpx; ">规格</text>
         
        </view>

        <view class="flex-row-default border-bottom" wx:for="{{orderArr}}" wx:for-index="orderIndex" wx:key="orderIndex" style="position: relative; width: {{windowWidth - 140}}rpx;">
          <view class="flex-row-default  p-20 " style="width: 100%;">
            <text class="mr-10">{{orderIndex + 1}}.</text>

            <block wx:if="{{item.nxDoStatus == -2}}">

              <view class="flex-column">
                <view class="flex-row-default" style=" width: {{windowWidth - 180}}rpx; ">

                  <view class="flex-column" style="position: relative; width: {{windowWidth * 11 / 20}}rpx; ">
                    <input class="input  mainColor " style="width: 80%;" type="text" bindinput="editOrderName" data-type="name" data-index="{{orderIndex}}" value="{{item.nxDoGoodsName}}" adjust-position="true" />
                  </view>
                  <!-- ../name -->

                  <!-- quantity -->
                  <input class="input mr-20 mainColor" type="number" bindinput="editOrder" data-type="quantity" data-index="{{orderIndex}}" value="{{item.nxDoQuantity}}" style="width: {{windowWidth * 3 / 20}}rpx;" />
                  <!-- ../quantity -->
                  <!-- standard -->
                  <input class="input mr-20 mainColor" type="text" bindinput="editOrder" data-type="standard" data-index="{{orderIndex}}" value="{{item.nxDoStandard}}" style="width: {{windowWidth * 3 / 20}}rpx;" />
                  <!-- ../standard -->
                </view>

                <view class="flex-row" wx:if="{{item.standardWeight !== '' && item.standardWeight !== '500g'}}">
               <view class="flex-row">
                <text>规格重量:</text>
                <text>{{item.standardWeight}}/{{item.itemUnit}}</text>
               </view>
               <view class="flex-row ">
                <text wx:if="{{item.itemsPerCarton !== ''}}">*{{item.itemsPerCarton}}{{item.itemUnit}}</text>
                <text  wx:if="{{item.cartonUnit !== ''}}">{{item.cartonUnit}}</text>
               </view>
              
              </view>
              <view class="flex-row p-10" wx:if="{{item.nxDoAddRemark || item.nxDoRemark}}" style="margin-top: 12rpx; padding-left: 60rpx;">
                <text class="mr-10 text-secondary font-sl" style="color: #999; font-size: 34rpx;">备注:</text>
                <text wx:if="{{item.nxDoStatus == 0}}" style="flex: 1; font-size: 36rpx; color: #333333;">{{item.nxDoRemark || ''}}</text>
                <input wx:else class="input p-10 {{item.nxDoStatus == -2 ? 'status-draft' : 'status-saved'}}" type="text" bindinput="editOrder" data-type="remark" data-index="{{orderIndex}}" value="{{item.nxDoRemark}}" style="flex: 1; font-size: 36rpx; color: #333333; border-color: {{item.nxDoStatus == -2 ? '#00c48c' : '#e0e0e0'}};" placeholder="添加备注信息" />
              </view>



                <!-- 搜索结果商品 - 移到 flex-row-default 外面，不受商品名称列宽度限制 -->
                <!-- 如果有搜索结果，且当前订单索引匹配，则显示（包括从缓存恢复的情况） -->
                <block wx:if="{{orderArrIndex == orderIndex && (strArr.length > 0 || nxArr.length > 0)}}">
                  <scroll-view scroll-y="true" style="position: absolute; left: 20rpx; top: 0; margin-top: 80rpx; width: {{windowWidth - 140}}rpx; z-index: 9999; max-height: 700rpx; border: 1px solid #e0e0e0; background-color: #ffffff; border-radius: 12rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);" class="">
                        <view class="main_background flex-row-between p-20" wx:if="{{strArr.length > 0 || nxArr.length > 0}}">
                          <text></text>
                          <view class="plr-20" bindtap="closeStr" data-index="{{orderIndex}}">
                            <image src="/images/del.png" mode="aspectFill" class="icon" />
                          </view>
                        </view>

                        <block wx:if="{{strArr.length > 0}}">
                          <view class="flex-row p-20 border-bottom" wx:for="{{strArr}}" wx:for-item="goods" wx:for-index="goodsIndex" wx:key="nxDistributerGoodsId" style="background-color: #ffffff; border-bottom: 1px solid #f0f0f0; padding: 24rpx 20rpx; align-items: center;">
                            <text class="mr-10" style="color: #666; font-weight: 500; font-size: 32rpx; min-width: 40rpx;">{{goodsIndex + 1}}.</text>
                            <view class="flex-1" style="min-width: 0; flex: 1;">
                              <view class="flex-row-wrap" style="align-items: center;">
                                <block wx:if="{{goods.nxDgGoodsBrand !== 'null' && goods.nxDgGoodsBrand.length > 0}}">
                                  <text class="brand" style="margin-right: 8rpx;">{{goods.nxDgGoodsBrand}}</text>
                                </block>
                                <text class="" style="color: #333; font-size: 32rpx; font-weight: 500; line-height: 1.5;">{{goods.nxDgGoodsName}}</text>
                                <block wx:if="{{goods.nxDgGoodsStandardWeight !== 'null' && goods.nxDgGoodsStandardWeight.length > 0}}">
                                  <text class="" style="color: #666; font-size: 32rpx; margin-left: 8rpx;">({{goods.nxDgGoodsStandardWeight}}/{{goods.nxDgGoodsStandardname}})</text>
                                </block>
                                <block wx:else>
                                  <text style="color: #666; font-size: 32rpx; margin-left: 8rpx;">({{goods.nxDgGoodsStandardname}})</text>
                                </block>
                              </view>
                            </view>

                            <block wx:if="{{goods.nxDgNxGoodsId !== null}}">
                              <view class="ml-20" style="flex-shrink: 0; width: 100rpx;" bindtap="saveOrder" data-id="{{goods.nxDistributerGoodsId}}" data-index="{{orderIndex}}" data-name="{{goods.nxDgGoodsName}}">
                                <text class="bg-success font-xs p-10 radius-10" style="display: inline-block; text-align: center; min-width: 80rpx; padding: 8rpx 16rpx; font-size: 32rpx;">选择</text>
                              </view>
                            </block>
                            <block wx:else="">
                              <view class="ml-20" style="flex-shrink: 0; width: 100rpx;" bindtap="saveOrder" data-id="{{goods.nxDistributerGoodsId}}" data-index="{{orderIndex}}" data-name="{{goods.nxDgGoodsName}}">
                                <text class="bg-warning font-xs p-10 radius-10" style="display: inline-block; text-align: center; min-width: 80rpx; padding: 8rpx 16rpx; font-size: 32rpx;">临时</text>
                              </view>
                            </block>

                          </view>
                         
                        </block>

                        <block wx:if="{{nxArr.length > 0}}">
                        <!-- 加阴影 -->
                           <view class="flex-column" style="border: 1px solid #e0e0e0; border-radius: 8rpx; box-shadow: 0 12rpx 12rpx rgba(70, 69, 69, 0.08); overflow: hidden; margin: 10rpx 0;"> 
                           <view class="p-10 font-xs text-secondary" style="background-color: #f5f7fa; color: #666; font-size: 26rpx; padding: 16rpx 20rpx; border-bottom: 1px solid #e8e8e8; font-weight: 500;">下载商品库{{nxArr.length}}个:</view>
                          <view class="flex-row-between border-bottom p-20" wx:for="{{nxArr}}" wx:for-item="goods" wx:for-index="nxIndex" wx:key="nxGoodsId" style="background-color: #ffffff; border-bottom: 1px solid #f0f0f0; padding: 24rpx 20rpx; align-items: center;">
                            <view class="flex-row-default font-lg flex-1" style="min-width: 0; flex: 1;">
                              <text class="text-secondary mr-10" style="color: #666; font-weight: 500; font-size: 32rpx; min-width: 40rpx;">{{nxIndex + 1}}.</text>
                              <view class="flex-row-wrap flex-1" style="min-width: 0; align-items: center;">

                                <text class="brand" wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !==  'null'}}" style="margin-right: 8rpx;">{{goods.nxGoodsBrand}}</text>

                                <text class="font-lg mr-20" style="color: #333; font-size: 32rpx; font-weight: 500; line-height: 1.5;">{{goods.nxGoodsName}}</text>
                               
                                <block wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
                                  <text class="small mr-10"   style="color: #666; font-size: 32rpx; margin-right: 12rpx;">({{goods.nxGoodsStandardname}}/{{goods.nxGoodsStandardWeight}})</text>
                                </block>
                                <block wx:else>
                                  <text class="normalmr-10" style="color: #666; font-size: 32rpx; margin-right: 12rpx;">({{goods.nxGoodsStandardname}})</text>
                                </block>

                                <text class="small mr-20 gray" wx:if="{{goods.nxGoodsPlace !== 'null' && goods.nxGoodsPlace.length > 0}}" style="color: #666; font-size: 26rpx; margin-right: 12rpx;">产地:{{goods.nxGoodsPlace}}</text>

                                <text class="small gray" wx:if="{{goods.nxGoodsDetail.length > 0 && goods.nxGoodsDetail !==  'null'}}" style="color: #666; font-size: 26rpx;">{{goods.nxGoodsDetail}}</text>
                              </view>
                            </view>

                            <view class="p-20" style="flex-shrink: 0; padding: 20rpx; display: flex; align-items: center; justify-content: center;" bindtap="downLoadGoodsNx" data-item="{{goods}}" data-index="{{orderIndex}}">
                              <image src="../../../../images/download.png" mode="aspectFill" class="icon" style="opacity: 0.7; width: 44rpx; height: 44rpx;" />
                            </view>
                           
                          </view>
                        </view>
                        </block>

                      </scroll-view>
                    </block>

                <!-- 订单自带商品 - 移到 flex-row-default 外面，不受商品名称列宽度限制 -->
                <scroll-view scroll-y="true" style="max-height: 400rpx; width: 100%;" wx:if="{{orderArrIndex !== orderIndex}}">
                   <!-- 订单自带配送商品 -->
                <view class="flex-column" wx:if="{{item.nxDistributerGoodsEntityList.length > 0}}" style="width: 100%; border-left: 1px solid gray;">
                  <view class="flex-row p-20 border-bottom" wx:for="{{item.nxDistributerGoodsEntityList}}" wx:for-item="orderGoods" wx:for-index="orderGoodsIndex" bindtap="saveOrder" data-id="{{orderGoods.nxDistributerGoodsId}}" data-index="{{orderIndex}}" data-name="{{item.nxDoGoodsName}}" wx:key="nxDistributerGoodsId" style="width: 95%; background-color: #ffffff; border-bottom: 1px solid #f0f0f0;  padding: 24rpx 20rpx; align-items: center; box-sizing: border-box; ">
                    <view class="flex-row-wrap flex-1" >
                      <text class="" style="color: #666; font-weight: 500; font-size: 32rpx; min-width: 50rpx;">({{orderGoodsIndex + 1}}).</text>
                      <block wx:if="{{orderGoods.nxDgGoodsBrand !== 'null' && orderGoods.nxDgGoodsBrand.length > 0}}">
                        <text class="brand" style="margin-right: 8rpx;">{{orderGoods.nxDgGoodsBrand}}</text>
                      </block>
                      <text class="" style="color: #333; font-size: 32rpx; font-weight: 500; line-height: 1.5;">{{orderGoods.nxDgGoodsName}}</text>
                      <block wx:if="{{orderGoods.nxDgGoodsStandardWeight !== 'null' && orderGoods.nxDgGoodsStandardWeight.length > 0}}">
                        <text class="" style="color: #666; font-size: 32rpx; margin-left: 8rpx;">({{orderGoods.nxDgGoodsStandardWeight}}/{{orderGoods.nxDgGoodsStandardname}})</text>
                      </block>
                      <block wx:else>
                        <text class="" style="color: #666; font-size: 32rpx; margin-left: 8rpx;">({{orderGoods.nxDgGoodsStandardname}})</text>
                      </block>
                    </view>
                    <text class="bg-success font-xs p-10 radius-10" style="flex-shrink: 0; display: inline-block; text-align: center; min-width: 80rpx; padding: 8rpx 16rpx; font-size: 32rpx;">选择</text>
                  </view>
                </view>
                <!-- 订单自带系统下载商品 -->
                <block wx:if="{{item.nxGoodsEntities.length > 0 }}">
                   <view class="flex-column " style="border-left: 1px solid gray; border-right: 1px solid gray; border-bottom: 1px solid gray;">
                  <view class="border-bottom p-20" wx:for="{{item.nxGoodsEntities}}" wx:for-item="goods" wx:for-index="nxIndex" wx:key="nxGoodsId" style="width: 100%; border-bottom: 1px solid #f0f0f0; padding: 24rpx 20rpx; align-items: center; box-sizing: border-box; display: flex; flex-direction: row;">
                    <view class="flex-row" style="flex: 1; align-items: center;padding: 10rpx; min-height: 60rpx; margin-right: 20rpx; width: calc(100% - 100rpx);">
                      <text class="" style="color: #666; font-weight: 500; font-size: 32rpx; min-width: 40rpx; flex-shrink: 0;">{{nxIndex + 1}}.</text>
                      <view class="flex-row-wrap" style="flex: 1; align-items: center; display: flex; flex-direction: row; flex-wrap: nowrap;  padding: 10rpx; min-height: 40rpx; overflow: hidden;">
                        <text class="brand" wx:if="{{goods.nxGoodsBrand.length > 0 && goods.nxGoodsBrand !==  'null'}}" style="margin-right: 8rpx;">{{goods.nxGoodsBrand}}</text>
                        <text class="font-lg mr-20" style="color: #333; font-size: 32rpx; font-weight: 500; line-height: 1.5;">{{goods.nxGoodsName}}</text>
                        <text class="" wx:if="{{goods.nxAliasEntities.length > 0}}" wx:for="{{goods.nxAliasEntities}}" wx:for-item="alias" wx:key="nxDaAliasName" style="color: #1c7efb; font-size: 32rpx; margin-right: 8rpx;">@{{alias.nxDaAliasName}}</text>
                        <block wx:if="{{goods.nxGoodsStandardWeight !== 'null' && goods.nxGoodsStandardWeight.length > 0}}">
                          <text class="small mr-10" wx:if="{{goods.nxGoodsStandardname !== '斤'}}" style="color: #666; font-size: 32rpx; margin-right: 12rpx;">({{goods.nxGoodsStandardWeight}}/{{goods.nxGoodsStandardname}})</text>
                        </block>
                        <block wx:else>
                          <text class="font-lg mr-10" style="color: #666; font-size: 32rpx; margin-right: 12rpx;">({{goods.nxGoodsStandardname}})</text>
                        </block>

                        <text class="small mr-20 gray" wx:if="{{goods.nxGoodsPlace !== 'null' && goods.nxGoodsPlace.length > 0}}" style="color: #666; font-size: 26rpx; margin-right: 12rpx;">产地:{{goods.nxGoodsPlace}}</text>
                        <text class="small gray" wx:if="{{goods.nxGoodsDetail.length > 0 && goods.nxGoodsDetail !==  'null'}}" style="color: #666; font-size: 26rpx;">{{goods.nxGoodsDetail}}</text>
                      </view>
                    </view>

                    <view class="p-20 center-content" style="flex-shrink: 0; padding: 20rpx; display: flex; align-items: center; justify-content: center;  width: 40rpx;" bindtap="downLoadGoodsNx" data-index="{{orderIndex}}" data-item="{{goods}}">
                      <image src="../../../../images/download.png" mode="aspectFill" class="icon" style="opacity: 0.7; width: 44rpx; height: 44rpx;" />
                    </view>

                  </view>
                </view>
                </block>
                </scroll-view>

              </view>
            </block>

            <block wx:else="">
               <view class="flex-column">
                <view class="flex-row" style="width: {{windowWidth - 240}}rpx;">
                <text class="half-row">{{item.nxDoGoodsName}}</text>
                <text class="quarter-row">{{item.nxDoQuantity}}</text>
                <text class="quarter-row">{{item.nxDoStandard}}</text>
              </view>

                <view class="flex-row" wx:if="{{item.standardWeight !== '' && item.standardWeight !== '500g'}}">
               <view class="flex-row">
                <text>规格重量:</text>
                <text>{{item.standardWeight}}/{{item.itemUnit}}</text>
               </view>
               <view class="flex-row ">
                <text wx:if="{{item.itemsPerCarton !== ''}}">*{{item.itemsPerCarton}}{{item.itemUnit}}</text>
                <text  wx:if="{{item.cartonUnit !== ''}}">{{item.cartonUnit}}</text>
               </view>
              
              </view>
              <view class="flex-row p-10" wx:if="{{item.nxDoAddRemark || item.nxDoRemark}}" style="margin-top: 12rpx; padding-left: 60rpx;">
                <text class="mr-10 text-secondary font-sl" style="color: #999; font-size: 34rpx;">备注:</text>
                <text wx:if="{{item.nxDoStatus == 0}}" style="flex: 1; font-size: 36rpx; color: #333333;">{{item.nxDoRemark || ''}}</text>
                <input wx:else class="input p-10 {{item.nxDoStatus == -2 ? 'status-draft' : 'status-saved'}}" type="text" bindinput="editOrder" data-type="remark" data-index="{{orderIndex}}" value="{{item.nxDoRemark}}" style="flex: 1; font-size: 36rpx; color: #333333; border-color: {{item.nxDoStatus == -2 ? '#00c48c' : '#e0e0e0'}};" placeholder="添加备注信息" />
              </view>
               
               </view>
            
              
            </block>
          </view>

          <view class="flex-row" wx:if="{{item.nxDoStatus == -2}}">
            <view class="p-20" bindtap="addDisAlias" data-index="{{orderIndex}}" >
              <text class="mainColor big five-weight">@</text>
            </view>
          </view>

          <view class="flex-row" wx:else="">
            <view class="p-20 ">
              <image src="/images/correct-2.png" mode="aspectFill" class="icon" />
            </view>
            <view class="p-20 " bindtap="showOperation" data-index="{{orderIndex}}" data-id="{{applyItem.nxDepartmentOrdersId}}">
              <image src="/images/points.png" mode="aspectFill" class="icon" />
            </view>
          </view>

        </view>
