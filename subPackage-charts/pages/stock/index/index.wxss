page {
  background: #f4f6f5;
  color: #25312f;
}

.stock-page {
  min-height: 100vh;
  overflow: hidden;
}

.stock-content {
  background: #f4f6f5;
}

.stock-toolbar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #ffffff;
}

.toolbar-title {
  display: flex;
  align-items: baseline;
  color: #187e6e;
  font-size: 30rpx;
  font-weight: 600;
}

.toolbar-count {
  font-size: 24rpx;
  font-weight: 400;
}

.toolbar-actions {
  display: flex;
  align-items: center;
}

.toolbar-mode-switch,
.toolbar-refresh {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f5f4;
  color: #187e6e;
}

.toolbar-mode-switch {
  margin-right: 18rpx;
}

.mode-switch-icon {
  width: 36rpx;
  height: 36rpx;
}

.toolbar-refresh {
  flex-shrink: 0;
}

.refresh-icon {
  margin-top: -4rpx;
  font-size: 42rpx;
  line-height: 1;
}

.toolbar-refresh--loading .refresh-icon {
  opacity: 0.45;
}

.stock-main {
  display: flex;
  overflow: hidden;
}

.category-menu {
  flex-shrink: 0;
  box-sizing: border-box;
  background: #f1f3f2;
  border-right: 1rpx solid #e4e8e6;
}

.category-item {
  position: relative;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 20rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #dde2df;
  color: #454b49;
  font-size: 25rpx;
  line-height: 1.35;
  text-align: center;
}

.category-item--active {
  background: #dff3ed;
  color: #187e6e;
  font-weight: 600;
}

.category-item--active::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: #159681;
  content: '';
}

.category-name {
  word-break: break-all;
}

.category-count {
  margin-top: 4rpx;
  font-size: 23rpx;
}

.menu-bottom-space {
  height: 120rpx;
}

.goods-panel {
  min-width: 0;
  background: #f5f7f6;
}

.category-header {
  box-sizing: border-box;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 1rpx solid #dde3e0;
}

.category-header-main {
  min-width: 0;
  display: flex;
  align-items: center;
}

.category-header-label {
  flex-shrink: 0;
  color: #7b8481;
  font-size: 25rpx;
}

.category-header-name {
  overflow: hidden;
  margin-left: 8rpx;
  color: #187e6e;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-header-count {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #8c9492;
  font-size: 22rpx;
}

.goods-scroll {
  box-sizing: border-box;
}

.goods-list {
  padding: 16rpx;
}

.goods-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid #dfe6e3;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(40, 74, 65, 0.05);
}

.goods-overview {
  display: flex;
  padding: 18rpx;
}

.goods-image-wrap {
  flex-shrink: 0;
}

.goods-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
  background: #f2f3f3;
}

.goods-image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.45;
}

.goods-info {
  min-width: 0;
  flex: 1;
  padding-left: 18rpx;
}

.goods-name {
  display: block;
  color: #24302e;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.goods-spec-row {
  margin-top: 9rpx;
  display: flex;
  flex-wrap: wrap;
  color: #606a67;
  font-size: 24rpx;
}

.goods-carton {
  margin-left: 22rpx;
}

.goods-shelf-row {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.5;
}

.goods-shelf-label {
  flex-shrink: 0;
  color: #808886;
}

.goods-shelf-value {
  margin-left: 8rpx;
  color: #e65f42;
  word-break: break-all;
}

.goods-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1rpx solid #edf0ef;
  border-bottom: 1rpx solid #e4eae7;
  background: #fafcfb;
}

.summary-cell {
  min-width: 0;
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #e6ebe9;
}

.summary-cell:last-child {
  border-right: 0;
}

.summary-cell--amount,
.batch-metric--rest {
  background: #fff9f2;
}

.summary-label {
  color: #8c9491;
  font-size: 20rpx;
}

.summary-value {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #33403d;
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-value--amount,
.metric-value--rest {
  color: #e77824;
}

.batch-list {
  padding: 14rpx;
  background: #f7faf8;
}

.batch-card {
  overflow: hidden;
  margin-bottom: 12rpx;
  border-left: 6rpx solid #22aa8f;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(25, 102, 84, 0.06);
}

.batch-card:last-child {
  margin-bottom: 0;
}

.batch-header {
  padding: 13rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eaf8f4;
}

.batch-tag {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #ccefe5;
  color: #177d6c;
  font-size: 21rpx;
  font-weight: 600;
}

.batch-location {
  overflow: hidden;
  max-width: 65%;
  color: #187e6e;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-date-row {
  padding: 10rpx 16rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx;
  color: #69726f;
  font-size: 20rpx;
}

.batch-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1rpx solid #e8edeb;
}

.batch-metric {
  min-width: 0;
  padding: 12rpx 7rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #e8edeb;
}

.batch-metric:last-child {
  border-right: 0;
}

.metric-label {
  color: #8a9290;
  font-size: 19rpx;
}

.metric-value {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #37413f;
  font-size: 20rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-sub {
  overflow: hidden;
  max-width: 100%;
  margin-top: 2rpx;
  color: #6f7775;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-page,
.initial-loading,
.category-empty {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7d8683;
}

.empty-image {
  width: 110rpx;
  height: 110rpx;
  opacity: 0.55;
}

.empty-title {
  margin-top: 24rpx;
  color: #58615f;
  font-size: 30rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #9aa19f;
  font-size: 23rpx;
}

.category-empty {
  min-height: 520rpx;
  font-size: 25rpx;
}

.category-empty-image {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
  opacity: 0.45;
}

.initial-loading,
.list-status {
  color: #929a97;
  font-size: 23rpx;
}

.list-status {
  padding: 26rpx 0;
  text-align: center;
}

.page-bottom-space {
  height: 80rpx;
}

.hover {
  opacity: 0.72;
}

/* 按货架显示：布局与货架页缩略图模式一致。 */
.shelf-mode {
  background: #f4f6f5;
}

.shelf-menu {
  flex-shrink: 0;
  box-sizing: border-box;
  background: #f3f4f4;
  border-right: 1rpx solid #e1e5e3;
}

.shelf-menu-item {
  position: relative;
  box-sizing: border-box;
  min-height: 145rpx;
  padding: 18rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #dfe3e1;
  color: #333b39;
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
}

.shelf-menu-item--active {
  background: #cceee4;
  color: #147e6c;
  font-weight: 600;
}

.shelf-menu-item--active::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: #148b76;
  content: '';
}

.shelf-menu-item--unshelved {
  color: #f04f52;
  font-weight: 600;
}

.shelf-menu-name {
  word-break: break-all;
}

.shelf-menu-count {
  margin-top: 5rpx;
  font-size: 23rpx;
}

.shelf-goods-panel {
  min-width: 0;
  background: #f7f9f8;
}

.shelf-grid {
  box-sizing: border-box;
  padding: 18rpx 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
}

.shelf-grid-card {
  box-sizing: border-box;
  width: 48.5%;
  min-height: 214rpx;
  margin: 0 3% 22rpx 0;
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  border: 1rpx solid #e4e9e7;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 20rpx rgba(29, 64, 55, 0.055);
}

.shelf-grid-card:nth-child(2n) {
  margin-right: 0;
}

.shelf-grid-title {
  color: #263330;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.42;
  word-break: break-all;
}

.shelf-grid-spec-row {
  margin-top: 9rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  color: #555f5c;
  font-size: 23rpx;
  line-height: 1.45;
}

.temporary-mark {
  margin-right: 7rpx;
  color: #ff595d;
  font-weight: 600;
}

.carton-mark {
  color: #f1a527;
  font-weight: 600;
}

.spec-divider {
  margin: 0 7rpx;
  color: #919896;
}

.shelf-grid-spec {
  color: #56605d;
}

.shelf-position {
  margin-top: 10rpx;
  color: #87908d;
  font-size: 21rpx;
}

.shelf-stock-chip {
  align-self: flex-start;
  margin-top: auto;
  padding: 7rpx 16rpx;
  border-radius: 18rpx;
  background: #e8f0ff;
  color: #3979f4;
  font-size: 23rpx;
  font-weight: 600;
}

.shelf-grid-status {
  width: 100%;
}
