<wxs src="../../../../utils/fn.wxs" module="tool" />



<view class="flex flex-column">

  <back-navbar title="{{fatherName}}" style="height: {{navBarHeight}}rpx;" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


  <!-- 根据 whichDay 显示对应的库存卡片 -->
  <view class="time-card1  {{currentOpen ? 'has-stock' : ''}}" bindtap="open">
    <view class="card-header p-20">
      <view class="time-title-section">
        <!-- 根据 whichDay 显示不同的图标和文字 -->
        <view class="time-icon {{whichDay == 1 ? 'today' : (whichDay == 0 ? 'one-day' : (whichDay == 1 ? 'two-days' : (whichDay == 3 ? 'three-days' : (whichDay == 99 ? 'all-stock' : 'more-days'))))}}">
          {{whichDay == 0 ? '今' : (whichDay == 1 ? '1' : (whichDay == 2 ? '2' : (whichDay == 3 ? '3' : (whichDay == 99 ? '总' : '3+'))))}}
        </view>
        <view class="flex-column">
          <text class="time-text">{{dateString}}
          </text>
          <view class="font-yuan"> 商品:{{oneDay.arr.length}}个</view>
        </view>
      </view>
      <view class="stock-amount-section flex-column">
        <text class="stock-amount">{{oneDay ? oneDay.total : 0}}元</text>
      </view>
      <image src="{{currentOpen ? '/images/arrow-down-3.png' : '/images/arrow-right-3.png'}}" mode="aspectFill" class="expand-arrow {{currentOpen ? 'expanded' : ''}}" />
    </view>

    <!-- 展开的商品列表 -->
    <view class="flex-column" wx:if="{{oneDay && oneDay.total > 0 && currentOpen}}">
      <view class="flex-column bg-white border-bottom p-20" wx:for="{{oneDay.arr}}" wx:for-item="goods" wx:for-index="stockIndex" wx:key="nxDistributerGoodsId">

        <view class="flex-row-between" catch:tap="showList" data-index="{{stockIndex}}">
          <view class="flex-row-default">
            <image src="{{goods.nxDgGoodsFile || goods.gbDgGoodsFile ? (url + (goods.nxDgGoodsFile || goods.gbDgGoodsFile)) : ''}}" mode="aspectFill" class="goods-image" binderror="onImageError" />
            <view class="goods-details">
              <text class="flex-row font-xs ">第{{stockIndex + 1}}/{{oneDay.arr.length}}个</text>
              <text class="goods-name">{{goods.nxDgGoodsName || goods.gbDgGoodsName}}</text>
              <view class="flex-row text-secondary font-xs" wx:if="{{goods.nxDgGoodsStandardname || (goods.nxDgItemsPerCarton !== null && goods.nxDgItemsPerCarton !== '')}}">
                            <text class="" wx:if="{{goods.nxDgGoodsStandardname}}">{{goods.nxDgGoodsStandardWeight !== 'null' && goods.nxDgGoodsStandardWeight.length > 0 ? goods.nxDgGoodsStandardWeight + '/' : ''}}{{goods.nxDgGoodsStandardname}}</text>
                            <text class="shelf-list-spec-gap" wx:if="{{goods.nxDgGoodsStandardname && goods.nxDgItemsPerCarton !== null && goods.nxDgItemsPerCarton !== ''}}"> * </text>
                            <view class="flex-row shelf-card-spec shelf-list-carton-inline" wx:if="{{goods.nxDgItemsPerCarton !== null && goods.nxDgItemsPerCarton !== ''}}">
                              <text class="shelf-list-carton-main">{{goods.nxDgItemsPerCarton}}{{goods.nxDgGoodsStandardname}}</text>
                              <text class="shelf-list-carton-unit">/{{goods.nxDgCartonUnit}}</text>
                            </view>
                          </view>
                          <!-- ././ -->
            </view>
          </view>

          <!-- youuce -->
          <!-- 右侧总计和按钮 -->
          <view class="goods-price-section"> 
            <view class="price-container stock-type1 mr-10">
              <text class="price-label  rest-weight">剩余</text>
              <text class="price-value1">¥{{goods.goodsStockTotal}}</text>
            </view>
            <!-- 右侧箭头 -->
            <view class="arrow-container {{goods.showStockList ? 'expanded' : 'collapsed'}}">
              <image src="/images/arrow-right-3.png" mode="aspectFill" class="arrow-icon" style="width: 24rpx; height: 24rpx;" />
            </view>
          </view>

        </view>


        <!-- 库存批次列表 - 默认隐藏，点击showList后显示 -->
        <view class="purchase-row-content  expandable-content {{goods.showStockList ? 'expanded' : ''}}" wx:for="{{goods.nxDisGoodsShelfStockEntities || goods.nxDistributerGoodsShelfStockEntities || goods.gbDepartmentGoodsStockEntities}}" wx:for-item="stock" wx:for-index="stockBatchIndex" catchtap="showOneDayStock" data-item-index="{{stockIndex}}" data-batch-index="{{stockBatchIndex}}" style="cursor: pointer;">

          <!-- 库存部分 -->
          <view class="flex-row">


            <!-- 第1部分：部门信息 -->
            <view class="purchase-section">
              <view class="flex-column-center">
                <view class="purchase-date">
                  <text>{{tool.getHowManyDays(stock.nxDgssDate || stock.gbDgsDate)}}天库存</text>
                </view>
                <text class="font-sm">{{stock.shelfName}}</text>
              </view>
            </view>

            <!-- 第2部分 单价信息 -->
            <view class="purchase-info purchase-inbound">
              <view class="column-label purchase-price">单价</view>
              <view class="column-content">
                <!-- 根据是否有大包装显示不同的单价 -->
                <block wx:if="{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' && goods.nxDgItemsPerCarton > 0}}">
                  <!-- 有大包装：显示箱单价 -->
                  <view class="amount-text">{{stock.nxDgssPriceCarton || stock.gbDgsPriceCarton || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDpgBuyPrice) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDpgBuyPrice)}}元/{{goods.nxDgCartonUnit || goods.gbDgCartonUnit}}</view>
                </block>
                <block wx:else>
                  <!-- 无大包装：显示最小单位单价 -->
                  <view class="amount-text">{{stock.nxDgssPrice || stock.gbDgsPrice || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDpgBuyPrice) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDpgBuyPrice)}}元/{{(stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity.gbDgGoodsStandardname) || goods.nxDgGoodsStandardname || goods.gbDgGoodsStandardname}}</view>
                </block>
                <block wx:if="{{stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.purchaseDepartmentUser !== null}}">
                  <text class="weight-text purchase-price">{{stock.purchaseGoodsEntity.purchaseDepartmentUser.nxDuWxNickName || stock.purchaseGoodsEntity.purchaseDepartmentUser.gbDuWxNickName}}</text>
                </block>
                <block wx:elif="{{stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxJrdhSupplierEntity !== null}}">
                  <text class="weight-text">{{stock.purchaseGoodsEntity.nxJrdhSupplierEntity.nxJrdhsSupplierName}}</text>
                </block>
              </view>
            </view>

             <!-- 分隔线 -->
             <view class="comparison-divider"></view>

         <!-- 第3部分 入库信息 -->
                <view class="purchase-info-column purchase-inbound">
                  <view class="column-label">入库</view>
                  <view class="column-content">
                    <text class="amount-text">{{stock.nxDgssSubtotal || stock.gbDgsSubtotal}}元</text>
                    <text class="weight-text">
                      <block wx:if="{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' && goods.nxDgItemsPerCarton > 0}}">
                        {{tool.formatQuantityDisplay(stock.nxDgssWeight || stock.gbDgsWeight, goods.nxDgCartonUnit, goods.nxDgItemsPerCarton, (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity.gbDgGoodsStandardname) || goods.nxDgGoodsStandardname || goods.gbDgGoodsStandardname)}}
                      </block>
                      <block wx:else>
                        {{stock.nxDgssWeight || stock.gbDgsWeight}}{{(stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity.gbDgGoodsStandardname) || goods.nxDgGoodsStandardname || goods.gbDgGoodsStandardname}}
                      </block>
                    </text>
                  </view>
                </view>

                <!-- 分隔线 -->
                <view class="comparison-divider"></view>

                <!-- 第4部分 剩余信息 -->
                <view class="purchase-info-column purchase-rest">
                  <view class="column-label">剩余</view>
                  <view class="column-content">
                    <text class="amount-text rest-amount flex-row">{{stock.nxDgssRestSubtotal || stock.gbDgsRestSubtotal}}元</text>
                    <text class="weight-text rest-weight">
                      <block wx:if="{{goods.nxDgCartonUnit && goods.nxDgCartonUnit !== '' && goods.nxDgCartonUnit !== 'null' && goods.nxDgItemsPerCarton > 0}}">
                        {{tool.formatQuantityDisplay(stock.nxDgssRestWeight || stock.gbDgsRestWeight, goods.nxDgCartonUnit, goods.nxDgItemsPerCarton, (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity.gbDgGoodsStandardname) || goods.nxDgGoodsStandardname || goods.gbDgGoodsStandardname)}}
                      </block>
                      <block wx:else>
                        {{stock.nxDgssRestWeight || stock.gbDgsRestWeight}}{{(stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity && stock.purchaseGoodsEntity.nxDistributerGoodsEntity.nxDgGoodsStandardname) || (stock.purchaseGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity && stock.purchaseGoodsEntity.gbDistributerGoodsEntity.gbDgGoodsStandardname) || goods.nxDgGoodsStandardname || goods.gbDgGoodsStandardname}}
                      </block>
                    </text>

                  </view>
                </view>
            
          </view>

        </view>

      </view>
    </view>
  </view>

</view>