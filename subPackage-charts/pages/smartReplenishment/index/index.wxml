<wxs src="../../../../utils/fn.wxs" module="tool" />

<view class="page">
  <back-navbar
    style="height: {{navBarHeight}}rpx;"
    title="智能备货"
    avatar="/images/back-gray.png"
    bindnavbuttontap="toBack"
  ></back-navbar>

  <scroll-view
    scroll-y="true"
    class="page-scroll"
    style="top: {{navBarHeight}}rpx;"
  >
    <view class="smart-control-panel">
      <view class="smart-control-heading">
        <view class="current-date-copy">
          <text>备货日期</text>
          <strong wx:if="{{startDate == endDate}}">{{dateModeLabel}} · {{tool.transferDateString(startDate)}}</strong>
          <strong wx:else>{{dateModeLabel}} · {{tool.transferDateString(startDate)}} - {{tool.transferDateString(endDate)}}</strong>
        </view>
        <view class="customer-filter-button" bindtap="toCustomerPicker" hover-class="card-hover">
          <image src="{{hasCustomerFilter ? '/images/filter.png' : '/images/filter-3-fill.png'}}"></image>
        </view>
      </view>

      <view class="date-mode-tabs">
        <view class="date-mode-tab {{dateMode == 'TODAY' ? 'active' : ''}}" data-mode="TODAY" bindtap="selectDateMode">今天</view>
        <view class="date-mode-tab {{dateMode == 'TOMORROW' ? 'active' : ''}}" data-mode="TOMORROW" bindtap="selectDateMode">明天</view>
        <view class="date-mode-tab {{dateMode == 'NEXT_7' ? 'active' : ''}}" data-mode="NEXT_7" bindtap="selectDateMode">未来7天</view>
        <view class="date-mode-tab {{dateMode == 'CUSTOM' || showCustomDate ? 'active' : ''}}" data-mode="CUSTOM" bindtap="selectDateMode">自定义</view>
      </view>

      <view class="selected-customer-row" wx:if="{{hasCustomerFilter}}">
        <view class="selected-customer-chip">
          <text>{{selectedDepartmentName}}</text>
          <image src="/images/del.png" catchtap="clearCustomerFilter"></image>
        </view>
      </view>

      <block wx:if="{{!loading && !pageError}}">
        <view class="prediction-summary-strip">
          <text>智能预测</text>
          <view class="level-a"><text>A级</text><strong>{{predictionSummary.levelA}}</strong></view>
          <view class="level-b"><text>B级</text><strong>{{predictionSummary.levelB}}</strong></view>
        </view>
        <view class="goods-type-filters">
          <view class="goods-type-filter {{activeGoodsType === '' ? 'active' : ''}}" data-type="" bindtap="selectGoodsType">全部 {{goodsTypeSummary.total}}</view>
          <view class="goods-type-filter self {{activeGoodsType === -1 ? 'active' : ''}}" data-type="-1" bindtap="selectGoodsType">自采商品 {{goodsTypeSummary.self}}</view>
          <view class="goods-type-filter stock {{activeGoodsType === 1 ? 'active' : ''}}" data-type="1" bindtap="selectGoodsType">出库商品 {{goodsTypeSummary.stock}}</view>
        </view>
        <view class="goods-search">
          <image src="/images/search-3.png" mode="aspectFit"></image>
          <input value="{{keyword}}" placeholder="搜索商品名称、规格" bindinput="onKeywordInput"></input>
          <text wx:if="{{keyword}}" bindtap="clearKeyword">×</text>
        </view>
      </block>
    </view>

    <view wx:if="{{loading}}" class="page-state">
      <view class="state-icon loading-icon">备</view>
      <text class="state-title">正在生成智能备货清单</text>
      <text class="state-desc">正在读取数据</text>
    </view>

    <view wx:elif="{{pageError}}" class="page-state error-state">
      <view class="state-icon">!</view>
      <text class="state-title">{{pageError}}</text>
      <view class="retry-button" bindtap="refreshPage">重新加载</view>
    </view>

    <block wx:else>
      <view wx:if="{{contextNotice}}" class="context-notice">{{contextNotice}}</view>

      <view wx:if="{{categories.length}}" class="compact-workspace">
        <view class="compact-left-menu">
          <view
            wx:for="{{categories}}"
            wx:key="key"
            class="compact-left-item {{activeCategory == item.key ? 'active' : ''}}"
            data-category="{{item.key}}"
            bindtap="selectCategory">
            <text>{{item.name}}</text>
            <text>({{item.count}})</text>
          </view>
        </view>
        <view class="compact-right-list">
          <view class="compact-category-header">
            <text>{{activeCategoryName}}</text>
          </view>
          <block wx:if="{{visibleProducts.length}}">
            <view
              wx:for="{{visibleProducts}}"
              wx:key="key"
              class="product-card compact-product-card simple-product-card">
              <view class="simple-product-main">
                <image src="{{item.imageUrl}}" mode="aspectFill" class="goods-photo"></image>
                <view class="goods-info">
                  <view class="goods-name-line">
                    <strong>{{item.goodsName}}</strong>
                    <text>预计 {{item.predictedQuantityText}}{{item.predictedUnit}}</text>
                  </view>
                  <view class="prediction-confidence">
                    <text class="goods-type-tag {{item.goodsTypeClass}}">{{item.goodsTypeText}}</text>
                    <text class="prediction-level-tag {{item.levelClass}}">{{item.levelLetter}}级</text>
                    <text>{{item.trustText}} 可信度</text>
                  </view>
                </view>
                <view
                  wx:if="{{item.context.activePurchaseCount}}"
                  class="current-purchase-button {{item.context.canEdit ? 'editable' : ''}} {{item.creating ? 'disabled' : ''}}"
                  data-id="{{item.goodsId}}"
                  catchtap="editProcurement">
                  <strong>{{item.context.purchaseText}}</strong>
                  <text wx:if="{{item.context.canEdit}}">修改/删除</text>
                </view>
                <view
                  wx:elif="{{item.context.canCreate}}"
                  class="add-button {{item.creating ? 'disabled' : ''}}"
                  data-id="{{item.goodsId}}"
                  catchtap="addProcurement">{{item.creating ? '添加中…' : '+ 添加采购'}}</view>
                <view wx:else class="purchase-readonly">{{item.context.purchaseText}}</view>
              </view>

              <view class="demand-block simple-demand-block">
                <view wx:for="{{item.departmentLines}}" wx:for-item="line" wx:key="key" class="department-forecast-row">
                  <strong class="department-name">{{line.departmentName}}</strong>
                  <view class="forecast-chip-grid">
                    <view class="forecast-chip-list">
                      <view wx:for="{{line.forecastItems}}" wx:for-item="forecast" wx:key="key" class="forecast-chip">
                        <text>{{forecast.dateText}}</text>
                        <strong>{{forecast.quantityText}}{{forecast.unit}}</strong>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </block>
          <view wx:else class="compact-empty-result">
            <strong>当前分类没有符合条件的商品</strong>
            <text>可切换商品类型或清除搜索条件</text>
          </view>
        </view>
      </view>

      <view wx:else class="empty-result">
        <view class="empty-check">✓</view>
        <strong>{{goodsTypeSummary.total ? '当前筛选下没有商品' : '当前无需提前备货'}}</strong>
        <text>{{goodsTypeSummary.total ? '可以切换商品类型或清除搜索条件' : '暂无商品'}}</text>
      </view>
    </block>
  </scroll-view>

  <view
    class="custom-date-mask"
    wx:if="{{showCustomDate}}"
    bindtap="closeCustomDate"
    catchtouchmove="preventMove">
    <view class="custom-date-sheet" catchtap="preventMove">
      <view class="custom-date-title">选择备货日期</view>
      <view class="custom-date-range">
        <picker
          mode="date"
          value="{{customStartDate}}"
          start="{{forecastToday}}"
          end="{{maxForecastDate}}"
          bindchange="onCustomStartDateChange">
          <view class="custom-date-picker">
            <text>开始日期</text>
            <strong>{{customStartDate}}</strong>
          </view>
        </picker>
        <text class="custom-date-arrow">至</text>
        <picker
          mode="date"
          value="{{customEndDate}}"
          start="{{customStartDate}}"
          end="{{maxForecastDate}}"
          bindchange="onCustomEndDateChange">
          <view class="custom-date-picker">
            <text>结束日期</text>
            <strong>{{customEndDate}}</strong>
          </view>
        </picker>
      </view>
      <view class="custom-date-limit">可选范围：{{forecastToday}} 至 {{maxForecastDate}}</view>
      <view class="custom-date-actions">
        <button bindtap="closeCustomDate">取消</button>
        <button class="confirm" bindtap="confirmCustomDate">确定</button>
      </view>
    </view>
  </view>

  <view
    class="purchase-modal-mask"
    wx:if="{{showPurchaseModal}}"
    style="padding-bottom: {{purchaseKeyboardHeight ? purchaseKeyboardHeight + 30 : 30}}rpx;"
    catchtouchmove="preventMove">
    <view class="purchase-modal">
      <view class="purchase-modal-title">{{purchaseDraft.goodsName}}</view>
      <view class="purchase-modal-body">
        <view class="purchase-modal-row">
          <text>采购数量：</text>
          <input
            type="digit"
            value="{{purchaseQuantity}}"
            focus
            adjust-position="{{false}}"
            bindinput="onPurchaseQuantityInput"
            bindkeyboardheightchange="onPurchaseKeyboardHeightChange"></input>
          <strong>{{purchaseUnit}}</strong>
        </view>
        <view class="purchase-modal-row">
          <text>采购规格：</text>
          <input
            type="text"
            value="{{purchaseUnit}}"
            maxlength="32"
            adjust-position="{{false}}"
            bindinput="onPurchaseUnitInput"
            bindkeyboardheightchange="onPurchaseKeyboardHeightChange"></input>
        </view>
      </view>
      <view class="purchase-modal-actions">
        <button wx:if="{{purchaseModalMode == 'edit'}}" class="delete" bindtap="deleteProcurement">删除</button>
        <button bindtap="closePurchaseModal">取消</button>
        <button class="confirm" bindtap="confirmPurchase">{{purchaseModalMode == 'edit' ? '保存' : '确定采购'}}</button>
      </view>
    </view>
  </view>
</view>
