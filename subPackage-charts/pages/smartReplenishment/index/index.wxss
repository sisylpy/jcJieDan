}
.purchase-modal-actions { display: flex; gap: 24rpx; padding: 28rpx 36rpx 34rpx; }
.purchase-modal-actions button {
  flex: 1;
  margin: 0;
  border-radius: 14rpx;
  color: #65716c;
  background: #f2f4f3;
  font-size: 28rpx;
}
.purchase-modal-actions button.confirm { color: #087c6d; background: #e5f4f0; font-weight: 700; }
.purchase-modal-actions button.delete { color: #c8443c; background: #fdeceb; font-weight: 700; }
.purchase-modal-actions button::after { border: 0; }
