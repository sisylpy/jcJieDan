page { background: #f3f7f5; color: #203028; }
.page { min-height: 100vh; background: #f3f7f5; }
.page-scroll {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
}
.smart-control-panel {
  margin: 14rpx 16rpx 0;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #dbe8e1;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(39, 78, 58, .05);
}
.smart-control-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.current-date-copy { min-width: 0; display: flex; flex-direction: column; }
.current-date-copy text { color: #84918a; font-size: 20rpx; }
.current-date-copy strong {
  margin-top: 4rpx;
  overflow: hidden;
  color: #26352e;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.date-mode-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}
.date-mode-tab {
  min-height: 60rpx;
  display: flex;
  padding: 0 8rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8e2dd;
  border-radius: 30rpx;
  color: #5b6962;
  background: #fff;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}
.date-mode-tab.active { border-color: #168878; color: #fff; background: #168878; }
.customer-filter {
  display: flex;
  max-width: 285rpx;
  padding: 12rpx 8rpx 12rpx 24rpx;
  box-sizing: border-box;
  align-items: flex-end;
  justify-content: center;
  flex-direction: column;
  text-align: right;
}
.customer-filter-label { color: #168878; font-size: 21rpx; }
.customer-filter strong {
  max-width: 240rpx;
  overflow: hidden;
  color: #25342e;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.customer-filter > text:last-child {
  max-width: 250rpx;
  overflow: hidden;
  color: #8a9690;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.customer-filter-button {
  width: 68rpx;
  height: 64rpx;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f2f7f5;
}
.customer-filter-button image { width: 38rpx; height: 38rpx; }
.selected-customer-row {
  display: flex;
  padding-top: 16rpx;
  align-items: center;
  justify-content: center;
}
.selected-customer-chip {
  width: auto;
  max-width: 100%;
  display: inline-flex;
  min-height: 62rpx;
  padding: 13rpx 16rpx 13rpx 24rpx;
  box-sizing: border-box;
  align-items: center;
  border-radius: 36rpx;
  background: #168878;
}
.selected-customer-chip text {
  min-width: 0;
  flex: 0 1 auto;
  color: #fff;
  font-size: 27rpx;
  line-height: 1.45;
  white-space: normal;
}
.selected-customer-chip image {
  width: 38rpx;
  height: 38rpx;
  flex: none;
  margin-left: 15rpx;
  filter: brightness(0) invert(1);
}
.customer-card, .filter-panel, .product-card, .boundary-note {
  margin: 20rpx 22rpx 0;
  border: 1rpx solid #dbe8e1;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}
.customer-card { display: flex; align-items: center; gap: 20rpx; padding: 25rpx 24rpx; }
.card-hover { background: #f4faf7; }
.customer-icon { width: 70rpx; height: 70rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #11965a; color: #fff; font-size: 28rpx; font-weight: 800; }
.customer-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.customer-main .eyebrow { color: #0e8b53; font-size: 21rpx; font-weight: 750; }
.customer-main strong { overflow: hidden; color: #1f3027; font-size: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.customer-main text:last-child { color: #849188; font-size: 23rpx; }
.customer-action { color: #198b58; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.page-state { min-height: 510rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 50rpx; text-align: center; }
.state-icon { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fdebea; color: #b54b46; font-size: 34rpx; font-weight: 850; }
.loading-icon { background: #e6f6ed; color: #0d8d53; }
.state-title { margin-top: 24rpx; color: #28372f; font-size: 31rpx; font-weight: 800; }
.state-desc { margin-top: 10rpx; color: #859189; font-size: 24rpx; }
.retry-button { margin-top: 28rpx; padding: 18rpx 34rpx; border-radius: 16rpx; background: #11975a; color: #fff; font-size: 25rpx; font-weight: 750; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin: 20rpx 22rpx 0; }
.summary-card { min-width: 0; padding: 22rpx 18rpx; border: 1rpx solid #dce7e1; border-radius: 20rpx; background: #fff; }
.summary-card text, .summary-card small, .summary-card strong { display: block; }
.summary-card text { color: #637169; font-size: 22rpx; }
.summary-card strong { margin-top: 9rpx; color: #183b2b; font-size: 41rpx; line-height: 1; }
.summary-card small { margin-top: 9rpx; color: #98a29c; font-size: 19rpx; }
.a-card { border-color: #bfe5d0; background: #f1faf5; }
.b-card { border-color: #ecd8ae; background: #fff9ed; }
.b-card strong { color: #ae7012; }
.context-notice { margin: 18rpx 22rpx 0; padding: 18rpx 22rpx; border: 1rpx solid #ecd6a9; border-radius: 16rpx; background: #fff8e9; color: #986319; font-size: 23rpx; line-height: 1.55; }
.filter-panel { padding: 22rpx; }
.prediction-summary-strip {
  height: 54rpx;
  display: flex;
  margin: 16rpx 0 14rpx;
  padding: 0 14rpx;
  align-items: center;
  gap: 22rpx;
  border-radius: 12rpx;
  color: #738078;
  background: #f4f7f5;
  font-size: 21rpx;
}
.prediction-summary-strip > text { margin-right: auto; color: #3d4e45; font-weight: 700; }
.prediction-summary-strip > view { display: flex; align-items: center; gap: 7rpx; }
.prediction-summary-strip strong { font-size: 25rpx; }
.prediction-summary-strip .level-a strong { color: #118958; }
.prediction-summary-strip .level-b strong { color: #b97818; }
.goods-type-filters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.goods-type-filter {
  min-height: 66rpx;
  display: flex;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d8e2dd;
  border-radius: 14rpx;
  color: #596860;
  background: #fff;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}
.goods-type-filter.active { border-color: #168878; color: #fff; background: #168878; }
.goods-type-filter.self.active { border-color: #079b70; background: #079b70; }
.goods-type-filter.stock.active { border-color: #2878bf; background: #2878bf; }
.level-filters { display: flex; gap: 12rpx; overflow-x: auto; }
.level-filter { flex: none; padding: 14rpx 20rpx; border: 1rpx solid #dce5e0; border-radius: 999rpx; background: #fff; color: #56655d; font-size: 23rpx; font-weight: 750; }
.level-filter.active { border-color: #139357; background: #139357; color: #fff; }
.b-filter.active { border-color: #bf7b17; background: #bf7b17; }
.goods-search { height: 76rpx; display: flex; align-items: center; gap: 15rpx; margin-top: 18rpx; padding: 0 20rpx; border: 1rpx solid #dbe5df; border-radius: 17rpx; background: #f8faf9; }
.goods-search image { width: 30rpx; height: 30rpx; opacity: .7; }
.goods-search input { min-width: 0; flex: 1; font-size: 25rpx; }
.goods-search > text { padding: 12rpx; color: #7f8c84; font-size: 30rpx; }
.category-scroll { margin-top: 18rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.category-chip { flex: none; padding: 13rpx 20rpx; border-radius: 14rpx; background: #eef3f0; color: #59675f; font-size: 22rpx; font-weight: 700; }
.category-chip.active { background: #dff3e8; color: #087c49; }
.product-list { padding-bottom: 2rpx; }
.product-card { overflow: hidden; background: #fffdf9; box-shadow: 0 8rpx 24rpx rgba(37, 72, 54, .06); }
.product-card.level-a { border-left: 7rpx solid #159459; }
.product-card.level-b { border-left: 7rpx solid #d69a39; }
.product-overview { display: flex; align-items: stretch; gap: 22rpx; padding: 26rpx 24rpx 22rpx; }
.goods-photo-wrap { width: 146rpx; height: 146rpx; flex: none; position: relative; border: 1rpx solid #e2e9e5; border-radius: 26rpx; background: #f4f7f5; overflow: hidden; }
.goods-photo { width: 100%; height: 100%; display: block; }
.level-badge { width: 48rpx; height: 48rpx; position: absolute; left: 8rpx; top: 8rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid rgba(255,255,255,.92); border-radius: 50%; background: #e4f6ec; color: #0c8750; font-size: 23rpx; font-weight: 850; box-shadow: 0 4rpx 12rpx rgba(25, 93, 59, .16); }
.level-b .level-badge { background: #fff0d4; color: #af6c0d; }
.goods-summary { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.goods-title-row { min-width: 0; display: flex; align-items: flex-start; gap: 12rpx; }
.goods-info { min-width: 0; flex: 1; }
.goods-info strong, .goods-info text { display: block; }
.goods-info strong { overflow: hidden; color: #1f2e26; font-size: 32rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.goods-info text { margin-top: 7rpx; overflow: hidden; color: #829087; font-size: 21rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.trust-value { flex: none; text-align: right; }
.trust-value strong, .trust-value text { display: block; }
.trust-value strong { color: #0c8a51; font-size: 28rpx; line-height: 1.1; }
.level-b .trust-value strong { color: #ad6c10; }
.trust-value text { margin-top: 3rpx; color: #929d96; font-size: 19rpx; }
.recommend-line { display: flex; align-items: baseline; gap: 12rpx; margin-top: 17rpx; }
.recommend-line > text { color: #66746c; font-size: 22rpx; }
.recommend-line > strong { color: #f07818; font-size: 34rpx; line-height: 1; }
.recommend-line small { margin-left: 5rpx; font-size: 22rpx; font-weight: 700; }
.action-tip { align-self: flex-start; margin-top: 12rpx; padding: 7rpx 15rpx; border-radius: 999rpx; background: #e9f7ef; color: #0b8650; font-size: 20rpx; font-weight: 750; }
.action-tip.level-b { background: #fff0d7; color: #a7680e; }
.metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 24rpx; border: 1rpx solid #ebefec; border-radius: 18rpx; background: #f7f9f7; overflow: hidden; }
.metric-grid > view { min-width: 0; padding: 19rpx 15rpx; border-right: 1rpx solid #e2e9e5; }
.metric-grid > view:last-child { border-right: 0; }
.metric-grid text, .metric-grid strong { display: block; }
.metric-grid text { color: #829087; font-size: 20rpx; }
.metric-grid strong { margin-top: 7rpx; overflow: hidden; color: #24372d; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.metric-grid .purchase-metric.active { color: #0d8a51; }
.metric-grid .purchase-metric.unknown { color: #a36a16; }
.demand-block { padding: 22rpx 24rpx 10rpx; }
.block-label { display: block; margin-bottom: 8rpx; color: #87948c; font-size: 21rpx; }
.department-line { display: flex; align-items: flex-start; gap: 15rpx; padding: 7rpx 0; }
.department-line strong { max-width: 190rpx; flex: none; overflow: hidden; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.department-line text { min-width: 0; flex: 1; color: #526159; font-size: 23rpx; line-height: 1.5; }
.procurement-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 10rpx 24rpx 0; padding: 19rpx 0; border-top: 1rpx solid #edf1ef; }
.purchase-state text, .purchase-state strong { display: block; }
.purchase-state text { color: #87938c; font-size: 20rpx; }
.purchase-state strong { margin-top: 4rpx; color: #536159; font-size: 25rpx; }
.purchase-state.active strong { color: #0d8a51; }
.purchase-state.unknown strong { color: #a36a16; }
.add-button { flex: none; padding: 15rpx 23rpx; border: 2rpx solid #119459; border-radius: 15rpx; color: #0c8650; font-size: 23rpx; font-weight: 800; }
.add-button.disabled { opacity: .5; }
.evidence-toggle { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; border-top: 1rpx solid #edf1ef; color: #617169; font-size: 22rpx; }
.evidence-panel { padding: 4rpx 24rpx 24rpx; background: #f7faf8; }
.reason-group { padding-top: 16rpx; }
.reason-group strong, .reason-group text { display: block; }
.reason-group strong { color: #246a49; font-size: 23rpx; }
.reason-group text { margin-top: 7rpx; color: #56655d; font-size: 22rpx; line-height: 1.5; }
.risk-group strong { color: #9b681b; }
.quantity-method, .empty-evidence { display: block; margin-top: 17rpx; color: #7b8981; font-size: 21rpx; line-height: 1.55; }
.empty-result { min-height: 330rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; margin: 20rpx 22rpx 0; border: 1rpx solid #dbe8e1; border-radius: 24rpx; background: #fff; text-align: center; }
.empty-check { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e4f5ec; color: #0d8d53; font-size: 34rpx; font-weight: 800; }
.empty-result strong { margin-top: 20rpx; font-size: 30rpx; }
.empty-result text { margin-top: 10rpx; color: #87938c; font-size: 23rpx; }
.boundary-note { padding: 24rpx; background: #f8fbf9; }
.boundary-note strong, .boundary-note text { display: block; }
.boundary-note strong { color: #42534a; font-size: 24rpx; }
.boundary-note text { margin-top: 8rpx; color: #7d8b83; font-size: 21rpx; line-height: 1.55; }
.compact-workspace {
  display: flex;
  min-height: 620rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #e1e5e3;
  border-bottom: 1rpx solid #e1e5e3;
  background: #f5f5f5;
}
.compact-left-menu {
  width: 126rpx;
  flex: none;
  border-right: 1rpx solid #e0e0e0;
  background: #eee;
}
.compact-left-item {
  display: flex;
  min-height: 106rpx;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-bottom: 1rpx solid #dedede;
  color: #263a35;
  font-size: 25rpx;
  line-height: 1.3;
  text-align: center;
}
.compact-left-item.active {
  border-left: 6rpx solid #168878;
  color: #087c6d;
  background: #fff;
  font-weight: 700;
}
.compact-right-list { min-width: 0; flex: 1; background: #fff; }
.compact-category-header {
  display: flex;
  min-height: 96rpx;
  padding-left: 24rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e2e5e4;
  color: #66736f;
  font-size: 30rpx;
  font-weight: 600;
}
.compact-empty-result {
  min-height: 300rpx;
  display: flex;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #7c8983;
  text-align: center;
}
.compact-empty-result strong { color: #43534b; font-size: 25rpx; }
.compact-empty-result text { margin-top: 10rpx; font-size: 21rpx; }
.smart-tag, .goods-type-tag {
  flex: none;
  margin-left: 9rpx;
  padding: 4rpx 8rpx;
  border-radius: 7rpx;
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}
.smart-tag { color: #a66c13; background: #fff0cf; }
.goods-type-tag.self { color: #11856d; background: #e4f6f0; }
.goods-type-tag.stock { color: #3778a7; background: #e7f2fa; }
.goods-type-tag.unset { color: #8a8f8d; background: #eff1f0; }
.goods-type-line { display: flex; align-items: center; margin-top: 8rpx; }
.compact-product-card { margin: 14rpx 12rpx 0; border-radius: 18rpx; }
.compact-product-card .product-overview { gap: 14rpx; padding: 20rpx 16rpx 18rpx; }
.compact-product-card .goods-photo-wrap { width: 112rpx; height: 112rpx; border-radius: 18rpx; }
.compact-product-card .level-badge { width: 40rpx; height: 40rpx; font-size: 20rpx; }
.compact-product-card .goods-info strong { font-size: 29rpx; }
.compact-product-card .trust-value strong { font-size: 25rpx; }
.compact-product-card .recommend-line { flex-wrap: wrap; margin-top: 13rpx; }
.compact-product-card .recommend-line > strong { font-size: 31rpx; }
.compact-product-card .metric-grid { margin: 0 16rpx; }
.compact-product-card .metric-grid > view { padding: 16rpx 9rpx; }
.compact-product-card .metric-grid strong { font-size: 22rpx; }
.compact-product-card .demand-block { padding: 18rpx 16rpx 8rpx; }
.compact-product-card .department-line strong { max-width: 150rpx; }
.compact-product-card .procurement-row { margin: 8rpx 16rpx 0; }
.simple-product-card { border-left: 5rpx solid #168878; background: #fff; }
.simple-product-main {
  display: flex;
  min-height: 126rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 14rpx;
}
.simple-product-main > .goods-photo {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border: 1rpx solid #e1e8e4;
  border-radius: 16rpx;
  background: #f5f7f6;
}
.simple-product-main .goods-info strong { font-size: 29rpx; }
.simple-product-main .goods-info > text { font-size: 21rpx; }
.prediction-confidence { display: flex; margin-top: 7rpx; align-items: center; gap: 10rpx; }
.prediction-confidence text { margin-top: 0; font-size: 20rpx; }
.prediction-confidence .prediction-level-tag {
  padding: 3rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 700;
}
.prediction-confidence .level-a { color: #0b8650; background: #e5f5ec; }
.prediction-confidence .level-b { color: #a66b12; background: #fff0d4; }
.prediction-confidence .goods-type-tag { margin-left: 0; }
.goods-name-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; }
.goods-name-line > strong { font-size: 28rpx; color: #1e2924; }
.goods-name-line > text { font-size: 22rpx; font-weight: 700; color: #ef7b28; }
.simple-product-main .goods-type-line { margin-top: 6rpx; }
.simple-product-main .goods-type-tag { margin-left: 0; }
.current-purchase-button, .purchase-readonly {
  min-width: 104rpx;
  flex: none;
  text-align: center;
}
.current-purchase-button {
  padding: 12rpx 10rpx;
  border-radius: 13rpx;
  color: #0b805d;
  background: #e5f5ef;
}
.current-purchase-button.editable { color: #fff; background: #168878; }
.current-purchase-button strong, .current-purchase-button text { display: block; }
.current-purchase-button strong { font-size: 27rpx; white-space: nowrap; }
.current-purchase-button text { margin-top: 3rpx; font-size: 18rpx; }
.purchase-readonly { color: #718078; font-size: 22rpx; }
.simple-demand-block {
  margin: 0 16rpx;
  padding: 13rpx 0 16rpx;
  border-top: 1rpx solid #edf0ee;
}
.department-forecast-row { padding: 4rpx 0; }
.department-forecast-row + .department-forecast-row { margin-top: 12rpx; }
.department-name {
  display: block;
  overflow: hidden;
  color: #33453c;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.forecast-chip-grid { width: 100%; margin-top: 10rpx; }
.forecast-chip-list { width: 100%; display: flex; flex-wrap: wrap; gap: 10rpx; }
.forecast-chip {
  width: calc((100% - 40rpx) / 5);
  min-width: 0;
  display: flex;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx solid #cdebe0;
  border-radius: 15rpx;
  background: #edf9f4;
}
.forecast-chip > text { color: #6c7c74; font-size: 20rpx; }
.forecast-chip > strong { margin-top: 4rpx; color: #087c5c; font-size: 30rpx; line-height: 1.15; }

.custom-date-mask {
  position: fixed;
  z-index: 520;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .45);
}
.custom-date-sheet {
  width: 100%;
  padding: 30rpx 30rpx calc(env(safe-area-inset-bottom) + 28rpx);
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}
.custom-date-title { color: #203028; font-size: 32rpx; font-weight: 800; }
.custom-date-range {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
  align-items: center;
}
.custom-date-picker {
  min-height: 104rpx;
  display: flex;
  padding: 15rpx 18rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2rpx solid #bcded5;
  border-radius: 16rpx;
  background: #f7fbfa;
}
.custom-date-picker text { color: #77847e; font-size: 22rpx; }
.custom-date-picker strong { margin-top: 7rpx; color: #168878; font-size: 27rpx; }
.custom-date-arrow { color: #7d8983; font-size: 24rpx; }
.custom-date-limit { margin-top: 18rpx; color: #8b9691; font-size: 21rpx; text-align: center; }
.custom-date-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.custom-date-actions button {
  flex: 1;
  margin: 0;
  border-radius: 14rpx;
  color: #65716c;
  background: #f2f4f3;
  font-size: 28rpx;
}
.custom-date-actions button.confirm { color: #fff; background: #168878; font-weight: 700; }
.custom-date-actions button::after { border: 0; }

.purchase-modal-mask {
  position: fixed;
  z-index: 500;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 30rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, .48);
  transition: padding-bottom .15s ease-out;
}
.purchase-modal {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}
.purchase-modal-title {
  padding: 34rpx 36rpx;
  color: #fff;
  background: #168878;
  font-size: 34rpx;
  font-weight: 700;
}
.purchase-modal-body { padding: 30rpx 36rpx 12rpx; }
.purchase-modal-row {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  color: #4f5c57;
  font-size: 28rpx;
}
.purchase-modal-row > text { width: 180rpx; flex: none; }
.purchase-modal-row > strong { color: #263a35; font-size: 28rpx; }
.purchase-modal-row input {
  width: 190rpx;
  height: 68rpx;
  margin-right: 14rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #168878;
  border-radius: 14rpx;
  color: #1e302a;
  background: #f8fbfa;
  font-size: 30rpx;
  text-align: center;
}
.purchase-modal-tip {
  display: block;
  padding-top: 16rpx;
