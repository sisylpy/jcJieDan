/* app.wxss */

/* 全局页面样式 */
page {
  height: 100%;
  background-color: #f5f5f5;
}

.liziBack{
  background: #e5f8f6;
}
.clll_back{
  background: #f6fdf9;
}
.liziCollBack{
  background: #e8f2d7;
}


.liziClock{
  background: #ebebeb;
}

.liziDelivery{
  background: #cfcfcf;
}

/* main 类，使用 flex 布局 */
.main {
  display: flex;
}

/* content 类 */
.content {
  width: 100%;
}

.flex-fixed {
  flex-shrink: 0;
}

.flex-changed {
  flex-shrink: 1;
}


.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

.flex-row-default {
  display: flex;
  flex-flow: row nowrap;
}


.flex-row-reverse{
  display: flex;
  flex-flow: row-reverse;
  align-items: center; 
}

.center-content {
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  /* width: 100%; 确保占满整个行 */
}

.third-row {
  width: 33.33%;
}

.half-row {
  width: 50%;
}


/* Flex 布局 */
.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.flex-row {
  flex-direction: row;
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center; 
}

.flex-column {
  flex-direction: column;
}


.flex-column-center {
  display: flex;
  flex-flow: column nowrap;
  justify-content: space-around;
  align-items: center;
}

.flex-end {
  display: flex;
  justify-content: flex-end;
  /* 从右侧排列 */

}

.flex-row-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}


.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

