<view wx:if="{{loginInProgress && !registrationReady}}" class="auto-login-gate">
  <image src="/images/logo.jpg" class="auto-login-logo"></image>
  <text class="auto-login-title">正在进入配送工作台</text>
  <text class="auto-login-desc">正在确认当前微信账号，请稍候</text>
</view>

<view wx:elif="{{loginFailed && !registrationReady}}" class="auto-login-gate">
  <image src="/images/logo.jpg" class="auto-login-logo"></image>
  <text class="auto-login-title">暂时无法进入工作台</text>
  <text class="auto-login-desc">请检查网络后重新尝试</text>
  <button class="auto-login-retry" bindtap="retryAutomaticLogin">重新尝试</button>
</view>

<block wx:if="{{registrationReady}}">
<!-- 隐私授权弹窗（只在Server确认是新用户、准备注册时显示） -->
<view class="privacy-mask" wx:if="{{showPrivacy}}">
  <view class="privacy-modal">
    <view class="privacy-title">用户协议与隐私政策</view>
    <view class="privacy-desc">我们需收集您的头像、昵称、手机号、位置等信息以提供配送管理服务。请阅读并同意相关协议后继续。</view>
    <view class="privacy-btns">
      <button class="privacy-btn secondary" bindtap="handleOpenPrivacyContract">查看隐私指引</button>
      <button id="agree-privacy-btn" class="privacy-btn primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacy">同意并继续</button>
    </view>
  </view>
</view>

<view class="registration-page">
  <back-navbar style="height: {{navBarHeight}}rpx;" title="配送商注册" avatar="/images/logo.jpg" button-text="设置" bindnavbuttontap="toBack"></back-navbar>

  <scroll-view scroll-y="true" class="registration-scroll" style="top: {{navBarHeight}}rpx;">
    <view class="registration-content">
      <view class="registration-hero">
        <view class="hero-logo-wrap"><image src="/images/logo.jpg" class="hero-logo"></image></view>
        <view class="hero-copy">
          <text class="hero-kicker">配送经营管理工作台</text>
          <strong>京采接单</strong>
          <text>填写基础资料，创建您的配送商账号</text>
        </view>
      </view>

      <view wx:if="{{environment == 'wxwork'}}" class="wxwork-tip">
        <image src="/images/wx.png" class="wxwork-icon"></image>
        <text>当前通过企业微信注册</text>
      </view>

      <view class="registration-card">
        <view class="section-heading">
          <view><strong>配送商资料</strong><text>请填写真实信息，注册后可在设置中修改</text></view>
          <text class="step-badge">01</text>
        </view>

        <view class="form-field">
          <text class="field-label">所在市场</text>
          <view class="field-control market-control" bindtap="showMarket">
            <text class="{{marketName ? 'has-value' : 'placeholder'}}">{{marketName || '请选择所在市场'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">商铺地址</text>
          <view class="field-control">
            <input type="text" placeholder="例如：大厅号 + 摊位号" name="address" value="{{address}}" bindblur="getAddress"></input>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">批发商名称</text>
          <view class="field-control">
            <input type="text" placeholder="请输入配送商或商铺名称" name="name" value="{{disName}}" bindblur="getName" bindconfirm="_canLogin"></input>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">联系手机</text>
          <view class="field-control">
            <input type="number" placeholder="请输入联系人手机号码" name="phone" value="{{phone}}" bindblur="getPhone" bindconfirm="_canLogin"></input>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">联系人</text>
          <view class="field-control">
            <input placeholder="请输入业务联系人姓名" value="{{userName}}" bindinput="getUserName" bindconfirm="_canLogin"></input>
          </view>
        </view>
      </view>

      <view class="agreement-card">
        <checkbox-group bindchange="onAgreeProtocolChange">
          <label class="agree-label">
            <checkbox value="agree" checked="{{agreeProtocol}}" color="#0a9b61" />
            <view class="agreement-copy">
              <text>我已阅读并同意</text>
              <text class="link" catchtap="toUserAgreement">《用户服务协议》</text>
              <text>和</text>
              <text class="link" catchtap="toPrivacyPolicy">《隐私政策》</text>
            </view>
          </label>
        </checkbox-group>
      </view>

      <view wx:if="{{avatarUrl}}" class="avatar-preview-wrap">
        <image src="{{avatarUrl}}" class="avatar-preview"></image>
        <view><strong>头像已选择</strong><text>注册时将使用此头像</text></view>
      </view>

      <view class="registration-action">
        <button wx:if="{{canLogin && environment == 'wxwork'}}" class="register-button ready" bindtap="_registerWork" plain="true">注册企业微信配送商</button>
        <button wx:elif="{{canLogin}}" class="register-button ready" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" plain="true">注册并进入工作台</button>
        <button wx:else class="register-button" bindtap="tishi" plain="true">请完善注册信息</button>
        <text class="register-hint">资料仅用于配送业务管理与账号服务</text>
      </view>
    </view>
  </scroll-view>
</view>


<view class="overlay {{showSelect ? 'show' : 'hide'}}">

  <view class='popup p-30'>

      <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text> 请选择您的经营方式。</text>
        <view bindtap="closeType">
          <image src="../../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row p-10'>
        <radio-group class="radio-group" bindchange="radioChange" >
          <label class="radio" wx:for="{{items}}" wx:key="value">
            <radio value="{{item.name}}" checked="{{item.checked}}" />{{item.value}}
          </label>
        </radio-group>
      </view>
  </view>

</view>


<view class="overlay {{showMarket ? 'show' : 'hide'}}">
  <view class='popup'>
  <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text>请选择所在市场</text>
        <view bindtap="closeMarket">
          <image src="../../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row'>
        <radio-group class="radio-group" bindchange="radioChangeMarket" >
          <label class="radio" wx:for="{{itemsMarket}}" wx:key="sysCityMarketId">
            <radio value="{{index}}" data-name="{{item.sysCmMarketName}}" checked="{{item.sysCityMarketId == marketId}}" />{{item.sysCmMarketName}}
          </label>
        </radio-group>
      </view>
  </view>

</view>

</block>
