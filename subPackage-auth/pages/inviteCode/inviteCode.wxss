page {
  background-color: #f5f5f5;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.center-content {
  align-items: center;
  justify-content: center;
}

.p-20 {
  padding: 20rpx;
}

.word {
  font-size: 50rpx;
  line-height: 100rpx;
  font-weight: bold;
  color: #333;
}

.small {
  font-size: 28rpx;
}

.gray {
  color: #999;
}

.invite-container {
  /* margin-top: 80rpx; */
  padding: 60rpx 40rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.invite-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.invite-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 60rpx;
}

.input-container {
  margin-bottom: 40rpx;
}

.invite-input {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  background-color: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
}

.invite-input:focus {
  border-color: #234b50;
  background-color: #fff;
}

.btn-container {
  margin-top: 40rpx;
}

.verify-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #234b50;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.verify-btn.disabled {
  background-color: #ccc;
  color: #999;
}

.verify-btn::after {
  border: none;
}

/* 隐私授权弹窗 */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.privacy-modal {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.privacy-links {
  margin-bottom: 20rpx;
}

.privacy-links .link {
  font-size: 28rpx;
  color: #234b50;
  text-decoration: underline;
  margin-right: 20rpx;
}

.privacy-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.privacy-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.privacy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  border: none;
}

.privacy-btn.primary {
  background: #234b50;
  color: #fff;
}

.privacy-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.privacy-btn::after {
  border: none;
}








