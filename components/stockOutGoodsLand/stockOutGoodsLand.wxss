
.aaastock {
  position: fixed;
  left: 0;
  right: 0;
  /* top: 0; */
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 9999999;
  padding-left: 5%;
  padding-right: 5%;
}

.modal-content {
  background-color: #fff;
  width: 100%;
  height: 100%;

}


.goodsTitle {
  background: #187e6e;
  color: #fff;
  font-size: 6vmin;
   padding: 2vmin 4vmin;

}




.goods_contents {
  width: 100%;
  display: flex;
  flex-flow: column nowrap;
  justify-content: space-around;
  padding: 1vmin 4vmin;
  font-size: 5vmin; 
}

.input{
  border-bottom: 1px solid #f3f6f8;
  padding: 1vmin 4vmin;
  color: #187e6e;
 
}

.inputView{
  border: 1px solid lightgray;
  border-radius: 2vmin;
}


.gray{
  color: gray;
}


.btn-wrapper {
  /* background: gray; */
  flex-basis: 25%;
  display: flex;
  flex-flow: row nowrap;
  /* justify-content: center; */

}

.btn_left{
  width: 50%;
  /* background: red; */
 
  font-size: 5vmin;
  color: red;

  
}

.btn_row{
  width: 50%;
  display: flex;
  flex-flow: row nowrap;
  justify-content: space-around;
  font-size: 6vmin;
  align-items: center; 
  margin-left: 50%;
  /* background: yellow; */
 
  
  }

.confirm-btn {
  /* background: red; */
    color:#187e6e;
    width: 40%;
    text-align: center;
    padding: 3vmin 0;
   
}
.cancel-btn{
  /* background: purple; */
  color: gray;
  width: 40%;
  text-align: center;
  padding: 3vmin 0;
 
}



.shrink_fix{
  flex-shrink: 0;
}

.shrink_change{
  flex-shrink: 1;
}


.flex-row {
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center;
}

.flex-row-wrap{
  display: flex;
  flex-flow: row wrap;
}
.border-bottom{
  border-bottom: 1px solid rgb(206, 206, 206);
}
.hover{
  background-color: lightgrey;
}
.flex-row-end{
  display: flex;
  flex-flow: row nowrap;
  align-items: flex-end;
}
.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

.p-20{
 
  padding-left: 6vmin;
  padding-right: 6vmin;
  padding-top: 2vmin;
  padding-bottom: 2vmin;
}

.flex-row-default {
  display: flex;
  flex-flow: row nowrap;
  /* justify-items: flex-end; */
  /* justify-content: flex-end; */
  /* align-items: flex-end; */
  /* align-items: center; */
  /* justify-content: space-between; */
}

.flex_row_between {
  /* background: green; */
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;

}



.brand{
  border: 1px solid #fff;
  color: #fff;
  font-weight: 300;
  /* padding: 0 6rpx;
  border-radius: 10rpx; */
  

}


.mr-20{
  padding: 4vmin;
}
.m-10{
  padding: 2vmin;
}
.url{
  width: 10vmin;
  height: 10vmin;
  border-radius: 50%;

}

.flex-column {
  display: flex;
  flex-flow: column nowrap;
  justify-content: flex-start;
}



/*  */

.num{
  text-align: center;
  font-size: 8vmin;
  box-sizing:border-box;

  
}
.double_num{
  text-align: center;
  box-sizing:border-box;
}

.num_one{
  border: 1px solid gray;
  border-radius: 8vmin;
  margin-bottom: 3vmin;
  padding: 1vmin 4vmin;
  font-size: 5vmin;
  line-height: 10vmin;
  text-align: center;
}
.hover-num{
  background-color: greenyellow;
}

.num_one.is-active{
  background-color: #187e6e;
  color: #fff;
}


.order-row{

}
.order-row.is-active{
  background-color: #8fe9db;
  /* color: #fff; */
}

.weightInput{
  border-radius: 2vmin;
  line-height: 6vmin;
  height: 6vmin;
  text-align: center;
  font-size: 6vmin;
  padding: 1vmin 1vmin;
  width: 50%;
  border: 1px solid #838383;


}

.weightInput.is-active{
  border: 1px solid #020202;


}
.input_number{
  padding: 1.4vmin;
}
.input_number.is-active{
  color: #000000;
}
.analog_cursor{
  height: 5vmin;
  width: 0.4vmin;
  background: hsl(0, 0%, 100%);
  display: none;
}

.analog_cursor1.is-active{
  display: block;
}
