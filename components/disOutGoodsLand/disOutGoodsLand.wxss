
.aaa {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 999999;
  padding-left: 5%;
  padding-right: 5%;
}
.aaabbb{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 99999999;
  padding-left: 5%;
  padding-right: 5%;
  display: none;
}

.aaabbb.is-active{
  display: block;
}


