<wxs src="../../utils/fn.wxs" module="tool" />

<!-- 批次列表弹窗 -->
<view class='modal-overlay {{showStockList ? "show" : ""}}' catchtouchmove='true' catchtap="closeStockList">
  <view class='modal-content' catchtap='preventClose'>

    <!-- 商品信息 -->
    <view class="goods-header flex-row-between">
      <view class="flex-row"> 
        <text class="goods-name">{{goodsInfo.nxDgGoodsName}}</text>
      <block wx:if="{{goodsInfo.gbDgGoodsStandardWeight !== 'null' && goodsInfov.gbDgGoodsStandardWeight.length > 0}}">
        <text wx:if="{{goodsInfo.gbDdgShowStandardName !== '斤'}}">({{goodsInfo.nxDgGoodsStandardname}}/{{goodsInfo.gbDgGoodsStandardWeight}})</text>
      </block>
      <block wx:else>
        <text>({{goodsInfo.nxDgGoodsStandardname}})</text>
      </block>
      </view>
     
      <view class="" bindtap="closeStockList">
        <image src="/images/del.png" mode="aspectFill" class="icon"/>
      </view>
    </view>

    <!-- 盘库模式选择 -->
    <view class="inventory-mode-selector">
      <view class="mode-title">请选择盘库方式：</view>
      <radio-group bindchange="onInventoryModeChange">
        <label class="mode-label">
          <radio value="1" checked="{{inventoryMode == 1}}" />
          <text>按批次盘库（精确）</text>
        </label>
        <label class="mode-label">
          <radio value="2" checked="{{inventoryMode == 2}}" />
          <text>按总数盘库（批量）</text>
        </label>
      </radio-group>
    </view>

    <!-- 按批次模式时显示批次列表 -->
    <scroll-view class="stock-list" scroll-y="true" wx:if="{{inventoryMode == 1}}">
      <view style="text-align: left; font: 18rpx; color: gray; padding: 20rpx 20rpx;">选择批次（精确盘库）：</view>
      <view class="stock-item {{selectedStock && selectedStock.nxDistributerGoodsShelfStockId === item.nxDistributerGoodsShelfStockId ? 'selected' : ''}}" wx:for="{{stockList}}" wx:key="index" bindtap="selectStock" data-index="{{index}}">
        <view class="stock-content">
          <text class="stock-text" wx:if="{{item.nxDgssDate}}">入库日期 <text class="stock-number">{{tool.getAttrDate(item.nxDgssDate)}}</text></text>
          <text class="stock-divider" wx:if="{{item.nxDgssDate}}">·</text>
          <text class="stock-text">入库 <text class="stock-number">¥{{item.nxDgssWeight}}</text>{{goodsInfo.nxDgGoodsStandardname}}</text>

          <text class="stock-divider">·</text>
          <text class="stock-text">剩余 <text class="stock-number">{{item.nxDgssRestWeight}}</text>{{goodsInfo.nxDgGoodsStandardname}}</text>
        </view>
        <view class="stock-content">
          <text class="stock-text" wx:if="{{item.nxDgssDate}}">入库日期 <text class="stock-number">{{tool.getAttrDate(item.nxDgssDate)}}</text></text>
          <text class="stock-divider" wx:if="{{item.nxDgssDate}}">·</text>
          <text class="stock-text">单价 <text class="stock-number">¥{{item.nxDgssPrice}}</text></text>

          <text class="stock-divider">·</text>
          <text class="stock-text">建议售价 <text class="stock-number">¥{{item.nxDgssSellingPrice}}</text></text>
        </view>
        <!-- 选中标记 -->
        <view class="selected-tag" wx:if="{{selectedStock && selectedStock.nxDistributerGoodsShelfStockId === item.nxDistributerGoodsShelfStockId}}">已选择</view>
      </view>
    </scroll-view>

    <!-- 按总数模式时显示确认按钮 -->
    <view class="stock-list" wx:if="{{inventoryMode == 2}}">
      <view style="text-align: left; font: 18rpx; color: gray; padding: 20rpx 20rpx;">批量盘库说明：</view>
      <view style="padding: 20rpx; color: #666; font-size: 28rpx;">
        <text>系统将按批次顺序自动分配损耗（先进先出）</text>
      </view>
      <view class="info-row" style="padding: 20rpx;">
        <text class="label">商品总剩余：</text>
        <text class="value">{{totalRestWeightDisplay}}{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="modal-footer">
      <view class="btn cancel" bindtap="closeStockList">
        <text>取消</text>
      </view>
      <view class="btn confirm" bindtap="confirmModeSelect">
        <text>确定</text>
      </view>
    </view>

  </view>
</view>

<!-- 修改批次弹窗 -->
<view class='modal-overlay {{showEditModal ? "show" : ""}}' catchtouchmove='true' catchtap="closeEditModal">
  <view class='modal-content modal-edit' catchtap='preventClose'>

    <!-- 商品信息 -->
    <view class="goods-header">
      <text class="goods-name">{{goodsInfo.nxDgGoodsName}}</text>
    </view>

    <!-- 批次信息 -->
    <view class="stock-info-display">
      <!-- 当前盘库模式提示 -->
      <view class="info-row" style="color: #666; font-size: 24rpx;">
        <text>当前模式：{{inventoryMode == 1 ? '按批次盘库' : '按总数盘库'}}</text>
        <text wx:if="{{inventoryMode == 1 && selectedStock}}"> · 批次：{{tool.getAttrDate(selectedStock.nxDgssDate)}}</text>
      </view>
      <view class="info-row">
        <text class="label">总剩余数量：</text>
        <text class="value">{{totalRestWeightDisplay}}{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>
      <block wx:if="{{selectedStock}}">
      <view class="info-row">
        <text class="label">批次剩余：</text>
        <text class="value">{{selectedStock.nxDgssRestWeight}}{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>
      <view class="info-row">
        <text class="label">采购单价：</text>
        <text class="value">¥{{selectedStock.nxDgssPrice}}</text>
      </view>
      </block>
    </view>

    

    <!-- 输入区域 -->
    <view class="input-section">
      <view class="input-row">
        <text class="label">实际剩余数量：</text>
        <view class="input-wrapper">
          <input class="input" type="digit" placeholder="请输入数量" value="{{inputWeight}}" bindinput="onWeightInput" />
          <text class="unit">{{goodsInfo.nxDgGoodsStandardname}}</text>
        </view>
      </view>
      <!-- <view class="input-row">
        <text class="label">说明：</text>
        <view class="input-wrapper">
          <input class="input" placeholder="请输入说明" value="{{reason}}" bindinput="onReasonInput" />
        </view>
      </view> -->
    </view>

    <!-- 按钮 -->
    <view class="modal-footer">
      <view class="btn cancel" bindtap="closeEditModal">
        <text>取消</text>
      </view>
      <view class="btn cancel" style="margin-right: 20rpx;" bindtap="backToStockList">
        <text>返回</text>
      </view>
      <view class="btn confirm {{canSubmit ? '' : 'disabled'}}" catchtap="submit">
        <text>确定</text>
      </view>
    </view>
  </view>
</view>