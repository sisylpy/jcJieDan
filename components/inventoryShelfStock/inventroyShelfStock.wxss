/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 9999;
  padding: 40rpx 40rpx;
}

.modal-overlay.show {
  display: flex;
}

/* 弹窗内容 */
.modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 95%;
  max-width: 600rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 商品头部 */
.goods-header {
  padding: 30rpx;
  background-color: #187e6e;
  color: #fff;
}

.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

.icon{
  width: 40rpx;
  height: 40rpx;
}


.goods-name {
  font-size: 36rpx;
  font-weight: bold;
}

/* 批次列表 */
.stock-list {
  flex: 1;
  max-height: 70vh;
  /* padding: 20rpx; */
  box-sizing: border-box;
  overflow: hidden;
}

.stock-item {
  /* margin-bottom: 20rpx; */
  /* background-color: #f8f8f8; */
  /* border: 1px solid #e0e0e0; */
  transition: all 0.2s;
  position: relative;
  border-bottom: 1px solid gray;
  /* box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05); */
  box-sizing: border-box;
  width: 100%;
  padding:  30rpx 0;
}

.stock-item:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  opacity: 0.9;
}

.stock-top-bar {
  /* width: 100%; */
  height: 8rpx;
  background-color: #d0d0d0;
}

.stock-header {
  background: linear-gradient(135deg, #187e6e 0%, #2d9a8a 100%);
  padding: 20rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.stock-item:hover .stock-header {
  background: linear-gradient(135deg, #2d9a8a 0%, #187e6e 100%);
}

.stock-number {
  font-size: 32rpx;
  font-weight: bold;
}

.stock-arrow {
  font-size: 28rpx;
  opacity: 0.8;
}

.stock-content {
  padding: 5rpx 20rpx;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
}

.stock-text {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.stock-number {
  color: #333;
  font-weight: 600;
}

.stock-divider {
  font-size: 24rpx;
  color: #ccc;
  margin: 0 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* 批次信息显示 */
.stock-info-display {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 28rpx;
  color: #666;
}

.info-row .value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 操作类型 */
.operation-type {
  padding: 30rpx;
  border-bottom: 1px solid #eee;
}

.operation-type .title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.radio-label {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.radio-label:last-child {
  margin-bottom: 0;
}

/* 输入区域 */
.input-section {
  padding: 30rpx;
}

.input-row {
  margin-bottom: 30rpx;
}

.input-row:last-child {
  margin-bottom: 0;
}

.input-row .label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.unit {
  font-size: 28rpx;
  color: #666;
  margin-left: 10rpx;
}

/* 按钮区域 */
.modal-footer {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn.cancel {
  background-color: #f5f5f5;
  color: #333;
}

.btn.confirm {
  background-color: #187e6e;
  color: #fff;
}

.btn.confirm.disabled {
  background-color: #ccc;
  color: #999;
}

/* 编辑弹窗特殊样式 */
.modal-edit {
  max-height: 85vh;
}

