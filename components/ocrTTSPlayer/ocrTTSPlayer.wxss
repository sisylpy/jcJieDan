/* TTS 播放器容器样式已在主页面定义，这里可以添加组件特定的样式 */




.flex-column {
  flex-direction: column;
}


.flex-column-center {
  display: flex;
  flex-flow: column nowrap;
  justify-content: space-around;
  align-items: center;
}


.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}


/* Flex 布局 */
.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.flex-row {
  flex-direction: row;
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center; 
}

/* 播放按钮容器（可拖拽，固定定位） */
.play-button-container {
  position: fixed;
  z-index: 10000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  width: 80rpx;
  height: 80rpx;
  transition: transform 0.1s ease-out;
}

.draggable-button {
  touch-action: none;
  user-select: none;
}

/* 圆形播放按钮 */
.play-button-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #333333;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  pointer-events: none; /* 让触摸事件穿透到父容器 */
}

.play-icon-img {
  width: 50rpx;
  height: 50rpx;
}

/* 播放器容器 */
.player-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

/* 深色药丸形状播放器 */
.player-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #333333;
  border-radius: 60rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
  gap: 40rpx;
}

/* 左侧按钮组 */
.player-controls-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 40rpx;
}

/* 播放器控制按钮 */
.player-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  padding: 8rpx 12rpx;
  cursor: pointer;
  transition: opacity 0.2s;
}

.player-control:active {
  opacity: 0.6;
}

/* 控制图标 */
.control-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

/* 播放图标（绿色） */
.control-icon.play-icon {
  color: #07c160;
}

/* 停止图标（白色） */
.control-icon.stop-icon {
  color: #ffffff;
}

/* 重播图标（白色） */
.control-icon.replay-icon {
  color: #ffffff;
  font-size: 36rpx;
}

/* 关闭图标（白色） */
.control-icon.close-icon {
  color: #ffffff;
  font-size: 28rpx;
}

/* 控制文字 */
.control-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.2;
}

/* 右侧播放按钮特殊样式 */
.play-control-right {
  margin-left: auto;
  flex-shrink: 0;
  padding: 0;
  min-width: auto;
}

/* 绿色小喇叭图标 */
.play-icon-green {
  width: 48rpx;
  height: 48rpx;
  /* 如果图标本身不是绿色，可以使用 filter 转换为绿色 */
  /* filter: brightness(0) saturate(100%) invert(48%) sepia(79%) saturate(2476%) hue-rotate(130deg) brightness(98%) contrast(101%); */
}