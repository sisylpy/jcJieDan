.recognizing-section {
  padding: 40rpx 0;
}

.progress-container {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 196, 140, 0.15);
}

.progress-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #e5e5e5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00c48c, #00a876);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.image-status-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.status-item:active {
  transform: scale(0.98);
}

.status-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.status-label {
  font-size: 32rpx;
  color: #333;
}

