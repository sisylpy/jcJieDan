<view class='overlay' wx:if='{{show}}'>
  <view class='popup'>
    <view class="top">
      <view class='goodsTitle flex-row'>
        <text class="brand" wx:if="{{item.nxDgGoodsBrand.length > 0 && item.nxDgGoodsBrand !== 'null'}}">{{item.nxDgGoodsBrand}}</text>
        <text>{{item.nxDgGoodsName}}</text>
        <block wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">
          <text class="" wx:if="{{item.nxDgGoodsStandardname !== '斤'}}">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
        </block>
        <block wx:else>
          <text class="" wx:if="{{item.nxDgGoodsStandardname !== '斤' }}">({{item.nxDgGoodsStandardname}})</text>
        </block>
      </view>
    </view>

    <view class="flex-row-between" style="padding: 30rpx 20rpx;">

      <text class="">今日进价:(元/{{item.nxDgGoodsStandardname}})</text>
      <view class="flex-row">
        <view class="add_btn" hover-class="hover" bindtap="changePrice" data-type="reduce">
          <image src="../../images/reduce.png" class="add_btn_icon"></image>
        </view>
        <view class="">
          <input class='popInput' type='digit' value="{{item.nxDgBuyingPrice}}" bindinput="getBuyingPrice" hold-keyboard='true'></input>
        </view>
        <view class="add_btn" hover-class="hover" bindtap="changePrice" data-type="add">
          <image src="../../images/add.png" class="add_btn_icon"></image>
        </view>
      </view>
    </view>


    <view class="flex-column">

     

      <view class="flex-column">

        <!-- leve-----one -->
        <view class="body" wx:if="{{level == 1}}">

          <!-- level == 1 -->
            <view class="flex-row-between" style="padding: 30rpx 20rpx;">

              <text class="m-10">售价:(元/{{item.nxDgGoodsStandardname}})</text>
              <view class="flex-row" >
                <view class="add_btn" hover-class="hover" bindtap="changeWillPrice" data-type="reduce">
                  <image src="../../images/reduce.png" class="add_btn_icon"></image>
                </view>
                <view class="" >
                  <input class='popInput'  type='digit' value="{{item.nxDgWillPrice}}" bindinput="getWillPrice" hold-keyboard='true'></input>
                </view>
                <view class="add_btn" hover-class="hover" bindtap="changeWillPrice" data-type="add">
                  <image src="../../images/add.png" class="add_btn_icon"></image>
                </view>
              </view>
            </view>

          <view class='flex-row'>

            <view class="btn_row">
              <text></text>
              <view class="btn_row_finish">
                <view class='cancel-btn' bindtap="cancle" hover-class="hoverBtn">关闭</view>
                <view class='confirm-btn' catchtap='confirm' hover-class="hoverBtn">完成</view>
              </view>

            </view>

          </view>
        </view>


      </view>

    </view>




  </view>
</view>