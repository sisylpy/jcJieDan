/* 美化输入框 */
.input {
  border: 2rpx solid #18d3e4;
  border-radius: 12rpx;
  padding: 0 16rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
  transition: all 0.3s ease;
  /* font-size: 34rpx; */
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  vertical-align: middle;
}


/* 根据订单状态设置输入框样式 */

/* 根据订单状态设置输入框样式 */
.input.slock,
input.input.slock {
  border-color: #c9c9c9 !important;
  color: #972828 !important;
}

.input.status-draft,
input.input.status-draft {
  border-color: #0870d1 !important;
  color: #333333 !important;
}

.input.status-saved {
  border-color: #f53030;
  color: #333333;
}

.orderReading{
  background-color: #00a876;
  color: #fff;
}

.orderstop{
  background-color: #d9e4fb;
}

/* 刚修改的订单：蓝色字体提醒，无背景 */
.order-recently-modified,
.order-recently-modified text,
.order-recently-modified input {
  color: #1890ff !important;
}

/* 美化操作按钮 */
.button-container {
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.icon{
  width: 40rpx;
  height: 40rpx;
}

.button-container:active {
  background: linear-gradient(135deg, #e0e0e0 0%, #d8d8d8 100%);
  transform: scale(0.95);
}

/* 美化保存按钮 */
.mainBack_new_btn {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 196, 140, 0.3);
  transition: all 0.3s ease;
}

.mainBack_new_btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 196, 140, 0.25);
}

/* 美化重新识别按钮 */
.bg-gray {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  color: #666;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.bg-gray:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
  transform: translateY(2rpx);
}


/* 美化搜索结果下拉框 */
.scroll-view[style*="position: fixed"] {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15) !important;
  border: 2rpx solid #e0e0e0 !important;
}

/* 美化商品选择按钮 */
.bg-success {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%) !important;
  color: #fff !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 196, 140, 0.3);
  transition: all 0.2s ease;
}
.bg-success {
  background: linear-gradient(135deg, #ffffff 0%, #e8e8e8 100%) !important;
  color: #484848 !important;
  /* box-shadow: 0 2rpx 8rpx rgba(0, 196, 140, 0.3); */
  transition: all 0.2s ease;
}


.bg-success:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 196, 140, 0.25);
}

.bg-warning {
  background: linear-gradient(135deg, #ffa726 0%, #fb8c00 100%) !important;
  color: #fff !important;
  box-shadow: 0 2rpx 8rpx rgba(255, 167, 38, 0.3);
  transition: all 0.2s ease;
}

.bg-warning:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(255, 167, 38, 0.25);
}

/* 操作按钮栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 40rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 196, 140, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  opacity: 0.9;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 196, 140, 0.25);
}

.btn-secondary {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  color: #666;
  border: 2rpx solid #e5e5e5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 展开/关闭按钮样式 - 无背景，只有箭头 */
.toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  transition: all 0.3s ease;
}

.toggle-btn:active {
  opacity: 0.6;
  transform: scale(0.9);
}

.toggle-arrow-down {
  transition: transform 0.3s ease;
}

.toggle-arrow-up {
  transition: transform 0.3s ease;
  transform: rotate(180deg);
}



.flex-row {
  flex-direction: row;
  display: flex;
  flex-flow: row nowrap;
  justify-content: flex-start;
  align-items: center; 
}

.flex-column {
  flex-direction: column;
}


.flex-column-center {
  display: flex;
  flex-flow: column nowrap;
  justify-content: space-around;
  align-items: center;
}


.flex-row-between {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
}

.flex-row-default {
  display: flex;
  flex-flow: row nowrap;
}

