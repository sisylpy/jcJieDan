
.mask {
  position: fixed;
  left: 0;
  right: 0;
  /* top: 0; */
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 999999999;
  padding-left: 5%;
  padding-right: 5%;
  
}

.modal-content {
  /* width: 90%;
  height: 50%;
