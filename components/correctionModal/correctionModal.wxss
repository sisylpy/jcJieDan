.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999999;
}

.popup-content {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.correction-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 400rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
  background-color: #fafafa;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.correction-textarea:focus {
  border-color: #1976d2;
  background-color: #fff;
}

.correction-hint {
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.button-group {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.cancel-button,
.confirm-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.cancel-button {
  background: #f5f5f5;
  color: #666;
}

.confirm-button {
  background: #1976d2;
  color: white;
}

.flex-row-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

