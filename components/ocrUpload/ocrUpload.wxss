.upload-section {
  width: 100%;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.excel-section {
  margin-top: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.image-item {
  position: relative;
  width: calc(33.33% - 14rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.image-item:active {
  transform: scale(0.98);
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.image-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 196, 140, 0.9);
  padding: 8rpx;
  text-align: center;
}

.image-status.error {
  background-color: rgba(255, 0, 0, 0.9);
}

.status-text {
  color: #fff;
  font-size: 26rpx;
}

.add-image {
  border: 2rpx dashed #00c48c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0fdfa 0%, #e6faf5 100%);
  transition: all 0.3s ease;
}

.add-image:active {
  border-color: #00a876;
  background: linear-gradient(135deg, #e6faf5 0%, #d4f5eb 100%);
}

.add-icon {
  font-size: 68rpx;
  color: #00c48c;
  line-height: 1;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.add-text {
  font-size: 30rpx;
  color: #00a876;
  font-weight: 500;
}

/* 按钮样式 */
.btn {
  border: none;
  border-radius: 12rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, #00c48c 0%, #00a876 100%);
  color: #fff;
}

.btn-primary:active {
  background: linear-gradient(135deg, #00a876 0%, #008c65 100%);
}

.btn-secondary {
  background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);
  color: #333;
}

.btn-secondary:active {
  background: linear-gradient(135deg, #e5e5e5 0%, #d5d5d5 100%);
}

.btn-large {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.action-bar {
  padding: 30rpx 20rpx;
}

/* Excel 文件信息 */
.excel-file-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.excel-icon {
  font-size: 48rpx;
}

.excel-info {
  flex: 1;
}

.excel-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.excel-size {
  font-size: 28rpx;
  color: #999;
}

.excel-delete {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff4444;
  border-radius: 50%;
}

.excel-delete-icon {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.excel-action-bar {
  padding: 30rpx 20rpx 0;
}
