:host{display:block}.date-filter{min-height:108rpx;display:flex;align-items:center;box-sizing:border-box;padding:14rpx 22rpx;background:#fff;border:1rpx solid #e3ebe8}.date-filter-hover{background:#f5faf8}.calendar{position:relative;width:34rpx;height:34rpx;margin-right:20rpx;border:4rpx solid #15917c;border-radius:4rpx;box-sizing:border-box}.calendar-rings:before,.calendar-rings:after{content:'';position:absolute;top:-9rpx;width:4rpx;height:10rpx;background:#15917c;border-radius:2rpx}.calendar-rings:before{left:5rpx}.calendar-rings:after{right:5rpx}.calendar-line{position:absolute;left:0;right:0;top:8rpx;height:3rpx;background:#15917c}.date-copy{flex:1;min-width:0}.date-copy text{display:block}.date-label{font-size:23rpx;color:#50625e}.date-range{margin-top:3rpx;font-size:31rpx;line-height:1.25;font-weight:650;color:#172d29}
