.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1200;
}

.popup-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx 32rpx;
  width: 82%;
  max-width: 640rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}

.dep-scroll {
  max-height: 52vh;
  width: 100%;
}

.radio-group {
  width: 100%;
}

.dep-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 12rpx;
  border-bottom: 1rpx solid #eee;
}

.dep-row:last-child {
  border-bottom: none;
}

.dep-radio {
  margin-right: 16rpx;
  transform: scale(0.92);
}

.dep-body {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.dep-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dep-total {
  font-size: 30rpx;
  color: #008dce;
  font-weight: 700;
  flex-shrink: 0;
}

.empty-tip {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

.btn-row {
  width: 100%;
  margin-top: 24rpx;
  padding-top: 8rpx;
}

.flex {
  display: flex;
}

.flex-row-between {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.cancel-button {
  font-size: 32rpx;
  padding: 20rpx;
  background: #f0f0f0;
  color: #333;
  border-radius: 8rpx;
  text-align: center;
}

.confirm-button {
  font-size: 32rpx;
  padding: 20rpx;
  background: #008dce;
  color: #fff;
  border-radius: 8rpx;
  text-align: center;
}

.half-row {
  width: 44%;
}

.btn-disabled {
  background: #b8d4e8;
  color: rgba(255, 255, 255, 0.85);
  pointer-events: none;
}
