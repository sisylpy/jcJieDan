<view class='mask' wx:if='{{show}}' catchtouchmove='ture' style="height:{{maskHeight}}rpx;top:-{{scrollViewTop}}px;">
	<view class='modal-content' style=" margin-top:{{scrollViewTop}}px;">

		<view class="top">
			<view class='goodsTitle flex-row'>
				<text>完成收货</text>
			</view>
		</view>

		<view class="body">
			<view class='goods_contents'>

				<view class="flex_row_between p-20" style="font-size: 45rpx;">
					<text class="explain">金额</text>
					<view class="rightPart">
						<text>{{item.nxDpbSellSubtotal}}元</text>
					</view>
				</view>

				<view class="flex_row_between p-20 time_part">
					<text class="explain">付款</text>
					<view class="rightPart">
						<radio-group class="radio-group" bindchange="radioChange" >
						<label class="radio"><radio value="0" checked="{{item.nxDpbPayType == 0}}" />已付款</label>
						<label class="radio"><radio value="1" checked="{{item.nxDpbPayType == 1}}" />未付款</label>
						</radio-group>
					</view>
				</view>

        <view class="flex_row_between p-20" bindtap="{{hasSupplier ? '' : 'toSupplier'}}">
					<text class="explain">供货商:</text>
					<view class=" {{hasSupplier ? 'is-text-secondary' : ''}}" >
					{{item.nxJrdhSupplierEntity.nxJrdhsSupplierName}}
					</view>
				</view>

					<view class="flex_row_between p-20" >
					<text class="explain">自动订货</text>
					<view class="rightPart">
           <switch checked="{{item.nxDpbOrderIsNotice == 1}}" bindchange="changeNotice"/>
					</view>
				</view>
			
			
			</view>

			<view class='btn-wrapper'>
				<view class="btn_row" >
					<text class='cancel-btn' bindtap="cancle" hover-class="hoverBtn">取消</text>
					<text class='confirm-btn' catchtap='confirm' hover-class="hoverBtn">确定</text>
				</view>
			</view>
		</view>

	</view>
</view>