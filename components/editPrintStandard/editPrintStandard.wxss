/* 打印规格修改 tip 弹窗 */
.print-standard-tip {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 9999;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 200rpx;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  pointer-events: none;
}

.print-standard-tip.show {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.tip-content {
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  padding: 24rpx;
  min-width: 300rpx;
  margin-top: 8rpx;
  position: relative;
}

.tip-content::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 40rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.tip-goods-info {
  margin-bottom: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tip-goods-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.tip-goods-quantity {
  font-size: 32rpx;
  color: #666;
}

.tip-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 3rpx solid #007aff;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #333;
  background: #fff;
  box-sizing: border-box;
  font-weight: 500;
}

.tip-input:focus {
  border-color: #0056d6;
  background: #f8f9ff;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.1);
}

.tip-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 40rpx;
}

.tip-btn {
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  min-width: 120rpx;
}

.tip-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.tip-btn-cancel:active {
  background: #e0e0e0;
}

.tip-btn-confirm {
  background: #007aff;
  color: #fff;
}

.tip-btn-confirm:active {
  background: #0056d6;
}

