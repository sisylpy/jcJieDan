
<!-- 图片预览缩放组件 -->
<!-- 最外层容器，确保组件能渲染 -->
<view class="image-preview-container" style="width: 100%; height: 100%; position: relative; ">
  
  
  <view class="image-canvas-container">
    <movable-area class="big-canvas" scale-area="true">
      <movable-view 
        class="image-view" 
        direction="all" 
        inertia="{{false}}" 
        out-of-bounds="{{false}}" 
        scale 
        scale-min="0.5" 
        scale-max="5" 
        scale-value="{{imageTransform.scale || 1}}" 
        x="{{imageTransform.x !== undefined ? imageTransform.x : 390}}" 
        y="{{imageTransform.y !== undefined ? imageTransform.y : 844}}" 
        bindchange="onImageMove" 
        bindscale="onImageScale" 
        bindscaleend="onImageScaleEnd"
        style="width: {{imageTransform.width || 390}}px; height: {{imageTransform.height || 844}}px; box-sizing: border-box;"
      >
        <image 
          src="{{imagePath}}" 
          mode="aspectFit" 
          style="width:100%; height: 100%; display: block;" 
          draggable="false" 
          bindload="initImageTransform" 
          binderror="onImageError"
          lazy-load="{{false}}"
        />
      </movable-view>
    </movable-area>

  </view>

  <!-- 底部统计蒙板（showStatsMask 为 false 时由父级 resize-bar 展示） -->
  <view wx:if="{{showStatsMask && (totalOrders > 0 || completedOrders > 0 || pendingOrders > 0)}}" class="image-stats-mask">
    <view class="image-stats-row">
      <text class="image-stats-item">订单: {{totalOrders}}个</text>
      <text class="image-stats-item">成功: {{completedOrders}}个</text>
      <text class="image-stats-item">未成功: {{pendingOrders}}个</text>
    </view>
  </view>
 
</view>

