.preview-nav-btn {
  padding: 20rpx 40rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  color: #fff;
  font-size: 28rpx;
}

.preview-nav-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
}
