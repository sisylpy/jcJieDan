<view class='mask' wx:if='{{show}}' catchtouchmove='ture'>
  <view class='modal-content' style=" margin-top:{{statusBarHeight + 200}}px;">

    <view class="top">
      <view class='goodsTitle flex-row-wrap'>
        <text class="brand" wx:if="{{item.nxDgGoodsBrand.length > 0 && item.nxDgGoodsBrand !== 'null'}}">{{item.nxDgGoodsBrand}}</text>
        <text style="margin-right: 10rpx;">{{item.nxDgGoodsName}}</text>
        <text style="font-size: 40rpx;">{{item.nxDgGoodsDetail !== null ? item.nxDgGoodsDetail : ''}}
        </text>
        <text class="" style="font-size: 40rpx;" wx:if="{{item.nxAliasEntities.length > 0}}" wx:for="{{item.nxAliasEntities}}" wx:for-item="alias" wx:key="nxDistributerAliasId">@{{alias.nxDaAliasName}}</text>
        <block wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">
          <text style="font-size: 40rpx;" >({{item.nxDgGoodsStandardname}}/{{item.nxDgGoodsStandardWeight}})</text>
        </block>
        <block wx:else>
          <text style="font-size: 40rpx;" >({{item.nxDgGoodsStandardname}})</text>
        </block>
      </view>
    </view>

    <view class="body">
      <view class='goods_contents'>
        <view class="flex_row_between p-20">
          <text class="explain">s数量</text>
          <view class="rightPart">
            <input class='numberInput' focus='true' type='digit' value="{{applyNumber}}" bindinput="getApplyNumber" hold-keyboard='true'></input>
            <!-- <text>{{applyStandardName}}</text> -->
          </view>
        </view>

        <view class="flex-row-default  p-20">
          <text class="explain shrink_fix">单位</text>
          <view class=" flex-row-wrap shrink_change rightPart">
            <text class="standardName {{applyStandardName == item.nxDgGoodsStandardname ? 'is-active' : ''}}" bindtap="changeStandard" data-name="{{item.nxDgGoodsStandardname}}">{{item.nxDgGoodsStandardname}}</text>

            <text class="standardName {{applyStandardName == standard.nxDsStandardName ? 'is-active' : ''}}" catchtap="changeStandard" data-name="{{standard.nxDsStandardName}}" catchlongpress="delStandard" data-id="{{standard.nxDistributerStandardId}}" wx:for="{{item.nxDistributerStandardEntities}}" wx:key="nxDistributerStandardId" wx:for-item="standard">{{standard.nxDsStandardName}}</text>

            <text class="standardName" bindtap="showInputStandard">+</text>

          </view>
        </view>
      
        

        <view class="flex_row_between p-20" wx:if="{{showAddStandard}}">
          <text class="" style="width: 300rpx;">添加规格</text>
          <view class="flex_row_between" style="width: {{windowWidth - 300}}rpx; ">
            <input class="standardInput" focus="{{showAddStandard ? 'true' : ''}}" bindinput="addStanard" value="{{newStandardName}}"></input>
            <view class="flex-row" style="width: 200rpx;">
              <text class='cancel-btn' bindtap="cancleStandard" hover-class="hoverBtn">取消</text>
              <text class='confirm-btn' catchtap='confirmStandard' hover-class="hoverBtn">保存</text>
            </view>
          </view>
        </view>

        <view class="flex_row_between p-20">
          <text class="explain">备注</text>
          <view class="rightPart">

            <input class="remarkInput" bindinput="addRemark" value="{{applyRemark}}"></input>
          </view>
        </view>
      </view>

      <view class='btn-wrapper'>

        <view class="btn_row">
          <text wx:if="{{editApply}}" class="del-btn" bindtap="delApply">删除订单</text>
          <text class='cancel-btn' bindtap="cancle" hover-class="hoverBtn">取消</text>
          <text class='{{showAddStandard ? "cancel-btn" : "confirm-btn"}}' catchtap='confirm' hover-class="hoverBtn">确定</text>
        </view>
      </view>
    </view>

  </view>
</view>