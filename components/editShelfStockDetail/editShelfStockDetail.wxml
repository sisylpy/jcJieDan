<wxs src="../../utils/fn.wxs" module="tool" />

<!-- 批次列表弹窗 -->
<view class='modal-overlay {{showStockList ? "show" : ""}}' catchtouchmove='true' catchtap="closeStockList">
  <view class='modal-content' catchtap='preventClose'>

    <!-- 商品信息 -->
    <view class="goods-header flex-row-between">
      <view class="flex-row"> 
        <text class="goods-name">{{goodsInfo.nxDgGoodsName}}</text>
      <block wx:if="{{goodsInfo.gbDgGoodsStandardWeight !== 'null' && goodsInfo.gbDgGoodsStandardWeight.length > 0}}">
        <text >({{goodsInfo.nxDgGoodsStandardname}}/{{goodsInfo.gbDgGoodsStandardWeight}})</text>
      </block>
      <block wx:else>
        <text>({{goodsInfo.nxDgGoodsStandardname}})</text>
      </block>
      </view>
     
      <view class="" bindtap="closeStockList">
        <image src="/images/del.png" mode="aspectFill" class="icon"/>
      </view>
    </view>

    <!-- 批次列表 -->
    <scroll-view class="stock-list" scroll-y="true">
      <view class="stock-item" wx:for="{{stockList}}" wx:key="index" bindtap="selectStock" data-index="{{index}}">
        <view class="stock-content-row">
          <view class="stock-content-half">
            <text class="stock-text" wx:if="{{item.nxDistributerPurchaseGoodsEntity.nxDpgPurchaseType == -1}}">录入员: <text class="stock-number">{{item.nxDistributerPurchaseGoodsEntity.nxPurchaserEntity.nxDiuWxNickName}}</text></text>
            <text class="stock-text" wx:else="">采购员: <text class="stock-number">{{item.nxDistributerPurchaseGoodsEntity.nxPurchaserEntity.nxDiuWxNickName}}</text></text>
          </view>
          <view class="stock-content-half">
            <text class="stock-text" wx:if="{{item.nxDgssDate}}">入库日期 <text class="stock-number">{{tool.getAttrDate(item.nxDgssDate)}}</text></text>
          </view>
        </view>

        <view class="stock-content-row">
          <view class="stock-content-half">
            <text class="stock-text">入库: <text class="stock-number" wx:if="{{goodsInfo.nxDgCartonUnit && goodsInfo.nxDgCartonUnit !== '' && goodsInfo.nxDgCartonUnit !== 'null' && goodsInfo.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(item.nxDgssWeight, goodsInfo.nxDgCartonUnit, goodsInfo.nxDgItemsPerCarton, goodsInfo.nxDgGoodsStandardname)}}
              </text>
              <text wx:else>{{goodsInfo.nxDgGoodsStandardname}}</text>
            </text>
            <text class="">¥{{item.nxDgssSubtotal}}</text>
          </view>
          <view class="stock-content-half">
            <text class="stock-text">剩余 <text class="stock-number">
              <text wx:if="{{goodsInfo.nxDgCartonUnit && goodsInfo.nxDgCartonUnit !== '' && goodsInfo.nxDgCartonUnit !== 'null' && goodsInfo.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(item.nxDgssRestWeight, goodsInfo.nxDgCartonUnit, goodsInfo.nxDgItemsPerCarton, goodsInfo.nxDgGoodsStandardname)}}
              </text>
              <text wx:else>{{item.nxDgssRestWeight}}{{goodsInfo.nxDgGoodsStandardname}}</text>
            </text></text>
            <text class="">¥{{item.nxDgssRestSubtotal}}</text>
          </view>
        </view>
        <view class="stock-content-row" wx:if="{{item.nxDgssProduceDate || item.nxDgssShelfLife || item.nxDgssExpiryDate}}">
          <view class="stock-content-full">
            <text class="stock-text" wx:if="{{item.nxDgssProduceDate}}">生产日期 {{item.nxDgssProduceDate}}</text>
            <text class="stock-text" wx:if="{{item.nxDgssShelfLife}}">保质期 {{item.nxDgssShelfLife}}{{item.nxDgssShelfLifeUnit || ''}}</text>
            <text class="stock-text" wx:if="{{item.nxDgssExpiryDate}}">过期日期 {{item.nxDgssExpiryDate}}</text>
          </view>
        </view>
        <view class="stock-content-row">
          <view class="stock-content-half">
            <block wx:if="{{goodsInfo.nxDgCartonUnit && goodsInfo.nxDgCartonUnit !== '' && goodsInfo.nxDgCartonUnit !== 'null' && goodsInfo.nxDgItemsPerCarton > 0}}">
              <view wx:if="{{item.nxDgssPriceCarton}}">
                <text class="stock-text">外包单价</text>
                <text class="stock-number">¥{{item.nxDgssPriceCarton}}元/{{goodsInfo.nxDgCartonUnit}}</text>
              </view>
              <view wx:if="{{item.nxDgssPrice}}">
                <text class="stock-text">单价</text>
                <text class="stock-number">¥{{item.nxDgssPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
              </view>
            </block>
            <block wx:else>
              <text class="stock-text">单价</text>
              <text class="stock-number">¥{{item.nxDgssPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
            </block>
          </view>
          <view class="stock-content-half">
            <block wx:if="{{goodsInfo.nxDgCartonUnit && goodsInfo.nxDgCartonUnit !== '' && goodsInfo.nxDgCartonUnit !== 'null' && goodsInfo.nxDgItemsPerCarton > 0}}">
              <view wx:if="{{item.nxDgssSellingPriceCarton}}">
                <text class="stock-text">建议大售价</text>
                <text class="stock-number">¥{{item.nxDgssSellingPriceCarton}}元/{{goodsInfo.nxDgCartonUnit}}</text>
              </view>
              <view wx:if="{{item.nxDgssSellingPrice}}">
                <text class="stock-text">建议售价</text>
                <text class="stock-number">¥{{item.nxDgssSellingPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
              </view>
            </block>
            <block wx:else>
              <text class="stock-text">建议售价</text>
              <text class="stock-number">¥{{item.nxDgssSellingPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
            </block>
          </view>
        </view>
      </view>
     
    </scroll-view>

  </view>
</view>

<!-- 修改批次弹窗 -->
<view class='modal-overlay {{showEditModal ? "show" : ""}}' catchtouchmove='true' catchtap="closeEditModal">
  <view class='modal-content modal-edit' catchtap='preventClose'>

    <!-- 商品信息 -->
    <view class="goods-header">
      <text class="goods-name">{{goodsInfo.nxDgGoodsName}}</text>
      
    </view>

    <!-- 批次信息 -->
   
    <view class="input-section" wx:if="{{selectedStock}}">
      <view class="info-row">
        <text class="label">入库日期：</text>
        <text class="value">{{selectedStock.nxDgssDate ? tool.getAttrDate(selectedStock.nxDgssDate) : '--'}}</text>
      </view>
      <view class="input-row readonly-row">
        <text class="label">剩余数量：</text>
        <!-- <text class="value">{{selectedStock.nxDgssRestWeight}}{{goodsInfo.nxDgCartonUnit !== null && goodsInfo.nxDgCartonUnit !== undefined && goodsInfo.nxDgCartonUnit !== '' ? goodsInfo.nxDgCartonUnit : goodsInfo.nxDgGoodsStandardname}}</text> -->
        <text class="stock-chip" wx:if="{{goodsInfo.nxDgCartonUnit && goodsInfo.nxDgCartonUnit !== '' && goodsInfo.nxDgCartonUnit !== 'null' && goodsInfo.nxDgItemsPerCarton > 0}}">{{tool.formatQuantityDisplay(selectedStock.nxDgssRestWeight, goodsInfo.nxDgCartonUnit, goodsInfo.nxDgItemsPerCarton, goodsInfo.nxDgGoodsStandardname)}}</text>
                            <text class="stock-chip" wx:else>{{shelfGoods.totalRestWeight}}{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>

      <view class="input-row readonly-row">
        <text class="label">采购单价：</text>
        <text class="value">¥{{cartonBuyPrice || (goodsInfo.nxDgCartonUnit !== null && goodsInfo.nxDgCartonUnit !== undefined && goodsInfo.nxDgCartonUnit !== '' ? (selectedStock.nxDgssPriceCarton || selectedStock.nxDgssPrice) : selectedStock.nxDgssPrice)}}元/{{goodsInfo.nxDgCartonUnit !== null && goodsInfo.nxDgCartonUnit !== undefined && goodsInfo.nxDgCartonUnit !== '' ? goodsInfo.nxDgCartonUnit : goodsInfo.nxDgGoodsStandardname}}</text>
        <text class="value" wx:if="{{averageBuyPrice}}" style="margin-left: 20rpx;">平均单价：{{averageBuyPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>

      <view class="input-row">
        <text class="label">生产日期</text>
        <picker mode="date" value="{{editProduceDate || ''}}" bindchange="onProduceDateChange">
          <view class="input-wrapper picker-tap">
            <text class="{{editProduceDate ? '' : 'picker-placeholder'}}">{{editProduceDate || '请选择'}}</text>
          </view>
        </picker>
      </view>
      <view class="input-row">
        <text class="label">保质期</text>
        <view class="flex-shelf-life">
          <view class="input-wrapper shelf-life-num">
            <input class="input" type="number" value="{{editShelfLife}}" placeholder="数值" bindinput="onShelfLifeInput" hold-keyboard="true" />
          </view>
          <picker mode="selector" range="{{shelfLifeUnitOptions}}" range-key="label" value="{{shelfLifeUnitIndex}}" bindchange="onShelfLifeUnitChange">
            <view class="input-wrapper picker-tap shelf-life-unit">
              <text class="{{editShelfLifeUnit ? '' : 'picker-placeholder'}}">{{editShelfLifeUnit || '单位'}}</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="input-row">
        <text class="label">过期日期</text>
        <picker mode="date" value="{{editExpiryDate || calculatedExpiryDate || ''}}" bindchange="onExpiryDateChange">
          <view class="input-wrapper picker-tap">
            <text class="{{(editExpiryDate || calculatedExpiryDate) ? '' : 'picker-placeholder'}}">{{editExpiryDate || calculatedExpiryDate || '根据生产日期推算'}}</text>
          </view>
        </picker>
      </view>

    <!-- 输入区域 -->
      <view class="input-row">
        <text class="label">建议售价：</text>
        <view class="input-wrapper">
          <input class="input" type="digit" placeholder="请输入建议售价" value="{{cartonExpectPrice}}" bindinput="onSellingPriceInput" bindblur="_checkPrice" hold-keyboard='true' />
          <text class="unit">元/{{goodsInfo.nxDgCartonUnit !== null && goodsInfo.nxDgCartonUnit !== undefined && goodsInfo.nxDgCartonUnit !== '' ? goodsInfo.nxDgCartonUnit : goodsInfo.nxDgGoodsStandardname}}</text>
        </view>
      </view>

      <view class="input-row readonly-row" wx:if="{{averageExpectPrice}}">
        <text class="label">平均建议售价：</text>
        <text class="value">{{averageExpectPrice}}元/{{goodsInfo.nxDgGoodsStandardname}}</text>
      </view>
    </view>

    <!-- 按钮 -->
    <view class="modal-footer">
      <view class="btn cancel" bindtap="closeEditModal">
        <text>取消</text>
      </view>
      <view class="btn confirm {{canSubmit ? '' : 'disabled'}}" catchtap="submit">
        <text>确定</text>
      </view>
    </view>
  </view>
</view>