.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  max-width: 620rpx;
  max-height: 82vh;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.25);
}

.modal-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 24rpx 30rpx;
  background: #1e82b4;
  color: #fff;
}

.modal-brand {
  border: 1rpx solid #fff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.modal-name {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-spec {
  font-size: 26rpx;
  opacity: 0.9;
  margin-left: 6rpx;
}

.modal-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 10rpx 0;
}

.section {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.field-label {
  font-size: 30rpx;
  color: #333;
}

.field-input {
  width: 240rpx;
  height: 64rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

.field-unit {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.profit {
  font-size: 26rpx;
  color: #999;
  padding: 6rpx 0;
}

.profit-num {
  color: #e63946;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  gap: 80rpx;
  padding: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  font-size: 32rpx;
  padding: 10rpx 40rpx;
}

.btn-cancel {
  color: #888;
}

.btn-confirm {
  color: #1e82b4;
  font-weight: 600;
}
