<view class="modal-mask" wx:if="{{show}}">
  <view class="modal">
    <view class="modal-header">
      <text wx:if="{{form.nxDgGoodsBrand && form.nxDgGoodsBrand !== 'null' && form.nxDgGoodsBrand.length > 0}}" class="modal-brand">{{form.nxDgGoodsBrand}}</text>
      <text class="modal-name">{{form.nxDgGoodsName}}</text>
      <text class="modal-spec" wx:if="{{form.nxDgGoodsStandardname && form.nxDgGoodsStandardname !== '斤'}}">（{{form.nxDgGoodsStandardWeight && form.nxDgGoodsStandardWeight !== 'null' ? form.nxDgGoodsStandardWeight + '/' : ''}}{{form.nxDgGoodsStandardname}}）</text>
    </view>

    <view class="modal-body">
      <!-- 一档：基本单位 -->
      <view class="section">
        <view class="section-title">基本单位</view>

        <view class="field">
          <text class="field-label">基本单位采购价</text>
          <input class="field-input" type="digit" value="{{form.nxDgBuyingPriceOne}}" data-level="1" bindinput="getBuyingPrice" hold-keyboard="true" />
        </view>

        <view class="field">
          <text class="field-label">基本单位售价</text>
          <input class="field-input" type="digit" value="{{form.nxDgWillPriceOne}}" data-level="1" bindinput="getWillPrice" hold-keyboard="true" />
        </view>

        <view class="profit">毛利率：<text class="profit-num">{{form.nxDgPriceProfitOne !== undefined && form.nxDgPriceProfitOne !== '' ? form.nxDgPriceProfitOne : '—'}}%</text></view>
      </view>

      <!-- 二档：外包装（有外包装时才显示） -->
      <view class="section" wx:if="{{hasOuter}}">
        <view class="section-title">外包装</view>

        <view class="field">
          <text class="field-label">外包装采购价</text>
          <input class="field-input" type="digit" value="{{form.nxDgBuyingPriceTwo}}" data-level="2" bindinput="getBuyingPrice" hold-keyboard="true" />
        </view>

        <view class="field">
          <text class="field-label">外包装售价</text>
          <input class="field-input" type="digit" value="{{form.nxDgWillPriceTwo}}" data-level="2" bindinput="getWillPrice" hold-keyboard="true" />
          <text class="field-unit">/{{form.nxDgCartonUnit}}</text>
        </view>

        <view class="profit">外包装数量：{{form.nxDgItemsPerCarton}}{{form.nxDgGoodsStandardname}}/{{form.nxDgCartonUnit}}</view>

        <view class="profit">毛利率：<text class="profit-num">{{form.nxDgPriceProfitTwo !== undefined && form.nxDgPriceProfitTwo !== '' ? form.nxDgPriceProfitTwo : '—'}}%</text></view>
      </view>
    </view>

    <view class="modal-footer">
      <view class="btn btn-cancel" bindtap="cancle">关闭</view>
      <view class="btn btn-confirm" catchtap="confirm">完成</view>
    </view>
  </view>
</view>
