
<!-- 引入 template -->
<import src="../../../template/copySwiperItem/copySwiperItem.wxml" />

<view class="flex flex-column">

  <custom-navbar style="height: {{navBarHeight}}rpx;" title="协作伙伴" avatar="{{url + userInfo.nxDiuWxAvartraUrl}}"
    button-text="设置" bindnavbuttontap="onNavButtonTap"></custom-navbar>

  <view class="content flex-1 flex-column">

    <view class="flex-row" style="height: {{viewBarHeight}}rpx; ">
      <view class="navbar">
        <block wx:for="{{tabs_wx}}" wx:key="name">
          <view id="{{index}}"
            class="half-row text-center navbar-item-sub {{innerCurrent == index ? 'bar-item-sub-on':''}}"
            data-current='{{index}}' bindtap='onTab1ClickSub' hover-class="hover">
            <view class='navbar-title-sub' style="line-height: {{viewBarHeight}}rpx;">{{item.name}}({{item.amount}})
            </view>
          </view>
        </block>
      </view>
    </view>

    <swiper style="height: {{contentHeight }}rpx; " current="{{innerCurrent}}" bindchange='onInnerSwiperChange'>

      <swiper-item>

        <view class="" wx:if="{{goodsCataArr.length == 0}}">
            <view class="flex-column center-content" style="height: {{windowHeight - 500}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">协作商家暂时没有未出货订单</text>
            </view>
          </view>
        <view class="main flex-1"
          wx:if="{{(viewMode === 'category' && goodsCataArr.length > 0) || (viewMode === 'department' && depArr.length > 0)}}">

          <!-- 左侧菜单 - 始终显示 -->
          <scroll-view class="left-menu " scroll-y="true" scroll-top="{{scrollTopLeft}}"
            style="height:{{contentHeight}}rpx;width: {{leftMenuWidth}}rpx;">
            <!-- 按类别模式 -->
            <block wx:if="{{viewMode === 'category'}}">
              <view wx:if="{{goodsCataArr.length > 0}}">
                <view
                  class="left-item flex-column-center border-bottom {{selectedSub == leftIndex ? 'left-active' : ''}}"
                  wx:key="index" wx:for="{{goodsCataArr}}" wx:for-item="grand" bindtap="toScrollView"
                  data-index="{{leftIndex}}" wx:for-index="leftIndex">
                  <text class="font-sm text-center">{{grand.nxDfgFatherGoodsName}}({{grand.newOrderCount}})</text>
                  <!-- <view class="font-sm">({{grand.newOrderCount}})</view> -->
                </view>
              </view>
            </block>
            <!-- 按客户模式 -->
            <block wx:else>
              <view wx:if="{{depArr.length > 0}}">
                <view
                  class="left-item flex-column-center border-bottom {{selectedSub == leftIndex ? 'left-active' : ''}}"
                  wx:key="index" wx:for="{{depArr}}" wx:for-item="dep" bindtap="toScrollView" data-index="{{leftIndex}}"
                  wx:for-index="leftIndex">
                  <text class="font-sm text-center">{{dep.depAttrName}}</text>
                  <view class="font-sm">({{dep.orderCount}})</view>
                </view>
              </view>
            </block>

            <view style="height: 200rpx;"></view>
          </scroll-view>

          <!-- 右侧内容区域 -->
          <view class="flex-column">
            <!-- 空状态显示 -->


            <!-- 有数据时显示商品列表 -->
            <block
              wx:if="{{(viewMode === 'category' && goodsCataArr.length > 0) || (viewMode === 'department' && depArr.length > 0)}}">
              <scroll-view scroll-y="true" class=" goods-list" scroll-into-view="{{toView}}" scroll-top="0"
                bindscroll="scrollTo" bindscrolltolower="onReachBottom" lower-threshold="100" scroll-with-animation
                style="height:{{contentHeight - 20 }}rpx; ">
                <!-- 部门模式下的全选按钮 -->
                <view wx:if="{{viewMode === 'department' && goodsArr.length > 0}}"
                  class="flex flex-row-between bg-white border-bottom"
                  style="width: {{windowWidth - leftMenuWidth - 10}}rpx; padding: 20rpx;">
                  <view class="flex flex-row" style="align-items: center;">
                    <text class="font-md text-primary" wx:if="{{selDepName}}">{{selDepName}}</text>
                  </view>
                  <view class="flex flex-row plr-20" style="align-items: center;" bindtap="selectAllDepartmentGoods">
                    <text class="font-md text-secondary mr-10">全选</text>
                    <view class="custom-checkbox {{isAllDepartmentSelected ? 'checked' : ''}}">
                      <text class="checkbox-icon" wx:if="{{isAllDepartmentSelected}}">✓</text>
                    </view>
                  </view>
                </view>
                <view class=" " wx:for="{{goodsArr}}" wx:key="index" wx:for-index="goodsIndex">

                  <!-- 为每个分类的第一个商品添加分类锚点 -->
                  <view
                    wx:if="{{goodsIndex === 0 || goodsArr[goodsIndex-1].nxDgDfgGoodsGreatGrandId !== item.nxDgDfgGoodsGreatGrandId}}"
                    id="category{{item.nxDgDfgGoodsGreatGrandId}}"
                    class="goods-category-title category-anchor text-danger font-lg">
                  </view>
                  <!-- 分隔线只在分类的第一个商品时显示 -->
                  <view
                    wx:if="{{goodsIndex === 0 || goodsArr[goodsIndex-1].nxDgDfgGoodsGreatGrandId !== item.nxDgDfgGoodsGreatGrandId}}"
                    class="category-anchor p-10 text-secondary">
                    <text class="mr-10">{{item.nxDgDfgGoodsGreatGrandName}}</text>
                    <text class="font-xs mainColor">[{{item.nxDgDistributerName}}]</text>
                  </view>

                  <!-- 部门模式：商品和订单在一行显示 -->
                  <block wx:if="{{viewMode === 'department'}}">
                    <view wx:for="{{item.nxDepartmentOrdersEntities}}" wx:for-item="order" wx:key="orderIndex"
                      wx:for-index="orderIndex"
                      class="flex flex-row-between border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}"
                      style="width: {{windowWidth - leftMenuWidth - 20}}rpx; padding: 20rpx;" bindtap="choiceStock"
                      data-item="{{item}}" data-goodsindex="{{goodsIndex}}">
                      <!-- 左侧：序号、选择框、商品信息、订单信息 -->
                      <view class="flex flex-row flex-1">
                        <!-- 序号 -->
                        <text class="font-md mr-10" style="min-width: 40rpx; flex-shrink: 0;">{{goodsIndex + 1}}.</text>
                        <!-- 选择框 -->
                        <view class="flex-column-center mr-10" style="flex-shrink: 0;">
                          <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                            <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                          </view>
                        </view>
                        <!-- 商品信息 -->
                        <view class="flex-row flex-1 mr-15"
                          style="flex-shrink: 1; min-width: 0; flex-wrap: wrap; align-items: flex-start;">
                          <view class="flex-row" style="flex-shrink: 0; white-space: nowrap;">
                            <text class="brand"
                              wx:if="{{item.nxDgGoodsBrand !== 'null' && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                            <text class="font-md font-bold" style="white-space: nowrap;">{{item.nxDgGoodsName}}</text>
                          </view>
                          <text class="font-sm"
                            wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}"
                            style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                          <text class="font-sm" wx:else
                            style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardname}})</text>
                        </view>
                        <!-- 订单信息（客户名称） -->

                      </view>
                      <!-- 右侧：数量和备注 -->
                      <view class="flex flex-row"
                        style="flex-shrink: 0; align-items: center; margin-left: 20rpx; margin-right: 20rpx;">
                        <text class="font-lg font-bold">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                        <text wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}"
                          class="red ml-10 font-sm">({{order.nxDoRemark}})</text>
                      </view>
                    </view>
                  </block>

                  <!-- 类别模式：原有布局 -->
                  <block wx:else>
                    <view class=" flex-column p-20 border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}"
                      style="width: {{windowWidth - leftMenuWidth - 20}}rpx; ">
                      <view class="flex flex-row-between" bindtap="choiceStock" data-item="{{item}}"
                        data-goodsindex="{{goodsIndex}}" style="width: {{windowWidth - leftMenuWidth - 40}}rpx;">
                        <view class="flex-row-wrap">
                          <text class="brand"
                            wx:if="{{item.nxDgGoodsBrand !== 'null' && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                          <text class=" font-lg font-bold">{{item.nxDgGoodsName}}</text>
                          <text class=""
                            wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                          <text class="" wx:else>({{item.nxDgGoodsStandardname}})</text>
                          <text class="text-secondary"
                            wx:if="{{item.nxDgGoodsPlace !== null && item.nxDgGoodsPlace.length > 0}}">{{item.nxDgGoodsPlace}}</text>
                          <text class="text-secondary  text-secondary"
                            wx:if="{{item.nxDgGoodsDetail.length > 0 && item.nxDgGoodsDetail !==  'null'}}">{{item.nxDgGoodsDetail}}</text>
                        </view>
                        <view class="">
                          <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                            <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                          </view>
                        </view>
                      </view>

                      <view class="flex-column">

                        <view class="flex flex-row font-md p-10" wx:for="{{item.nxDepartmentOrdersEntities}}"
                          wx:for-item="order" wx:key="index" wx:for-index="orderIndex" data-orderindex="{{orderIndex}}"
                          data-goodsindex="{{goodsIndex}}" bindtap="choiceOrders"
                          style="width: {{windowWidth - leftMenuWidth -10}}rpx;">
                          <view class="flex-column-center" wx:if="{{item.isSelected}}">
                            <image
                              src="{{!order.purSelected ? '../../../images/checkbox-noselected.png' : '../../../images/selected-2.png'}}"
                              class="icon "></image>
                          </view>

                          <view class="circle_default" wx:else=""></view>
                          <!-- GB部门（扁平化） -->
                          <block wx:if="{{order.nxDoGbDepartmentId  !== -1}}">
                            <view class="flex-row ">
                              <text wx:if="{{order.fatherGbDepartmentName}}">{{order.fatherGbDepartmentName}}.</text>
                              <text>{{order.gbDepartmentName}}</text>
                            </view>
                          </block>
                          <!-- 餐厅（扁平化） -->
                          <block wx:elif="{{order.nxDoNxCommRestrauntId !== -1}}">
                            <view class="flex-row ">
                              <text>{{order.nxRestrauntAttrName}}</text>
                            </view>
                          </block>
                          <!-- NX部门（扁平化） -->
                          <block wx:else>

                            <view class="flex-row ">
                              <text
                                wx:if="{{order.nxDoDepartmentFatherId  !== order.nxDoDepartmentId}}">{{order.fatherDepartmentAttrName}}.{{order.nxDepartmentOrderCode}}</text>
                              <text class="" wx:else="">{{order.nxDepartmentAttrName}}</text>
                            </view>
                          </block>

                          <text class="ml-20">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                          <text wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}"
                            class="red">({{order.nxDoRemark}})</text>
                        </view>
                      </view>

                    </view>
                  </block>


                  <!-- ../here -->
                </view>
                <!-- 加载更多状态 -->
                <view wx:if="{{isLoading}}" class="loading-more">
                  <view class="loading-text">正在加载更多...</view>
                </view>

                <!-- 没有更多数据 -->
                <view wx:if="{{!hasMore && goodsArr.length > 0}}" class="no-more">
                  <view class="no-more-text">没有更多数据了</view>
                </view>

                <!-- 没有数据 -->
                <view wx:if="{{goodsArr.length === 0}}" class="text-secondary font-sm center-content"
                  style="height: 120rpx;">没有数据啦!</view>
              </scroll-view>

            </block>

          </view>

        </view>
      </swiper-item>


      <swiper-item>
        <scroll-view scroll-y="true" style="height: {{contentHeight}}rpx;">

          <view class="" wx:if="{{list.length == 0}}">
            <view class="flex-column center-content" style="height: {{windowHeight - 500}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">没有协作商家的出货订单</text>
            </view>
          </view>
          <view class="flex-column p-20 bg-white " wx:for="{{list}}" wx:for-item="collNxDis" wx:for-index="batchIndex"
            wx:key="nxDistributerPurchaseBatchId">

            <view class="body" style="width:{{windowWidth - 40}}rpx;  ">
              <view class=" flex-row-between p-20 border-bottom font-xs" style="background-color: rgb(238, 238, 238);">

                <view class="flex-column">
                  <view class="flex-row font-lg">
                    <text>协作配送商:</text>
                    <text>{{collNxDis.nxDistributerShowName}}</text>
                  </view>
                  <view class="flex-row text-secondary">
                    <text>订单来源:</text>
                    <text>{{disInfo.nxDistributerShowName}}</text>
                  </view>
                </view>

                <view class="flex-column center-content third-row">
                  <image src="{{url + collNxDis.nxDistributerImg}}" class="button-container-white"> </image>
                </view>
              </view>

              <view class="flex-column">
                <view class="flex flex-row-default p-10 border-bottom  font-lg"
                  wx:for="{{collNxDis.nxDistributerGoodsEntities}}" wx:key="nxDistributerPurchaseGoodsId"
                  wx:for-index="goodsIndex">

                  <view class="flex-column p-10" style="width:{{windowWidth - 80}}rpx;  ">
                   
                      <view class="flex-row" style="width: {{windowWidth - 80}}rpx; ">
                        <text class="">{{goodsIndex + 1}}.</text>
                        <text class="brand"
                          wx:if="{{item.nxDgGoodsBrand !== null && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                        <text class="">{{item.nxDgGoodsName}}</text>
                        <block
                          wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">
                          <text class=""
                            wx:if="{{item.nxDgGoodsStandardname !== '斤'}}">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                        </block>
                        <block wx:else>
                          <text class="">({{item.nxDgGoodsStandardname}})</text>
                        </block>
                      </view>
                   

                    <view class="flex-cloumn font-md" style=" width: {{windowWidth - 80}}rpx; ">
                      <view class="flex-row-default pb-10" wx:for-item="order"
                        wx:for="{{item.nxDepartmentOrdersEntities}}" wx:for-index="orderIndex"
                        wx:key="nxDepartmentOrdersId">

                        <view class="flex-column">
                          <view class="flex flex-row-between "
                            style="width: {{windowWidth - 80}}rpx; border-bottom: 1px dashed lightgray;">
                            <view class="flex-row">
                              <image src="/images/canyinfandian.png" mode="aspectFill" class="icon mr-10" />
                              <view class="flex-column"
                                wx:if="{{order.nxDepartmentEntity.fatherDepartmentEntity !== null}}">
                                <view class='flex-row-default '>
                                  <text
                                    class="">{{order.nxDepartmentEntity.fatherDepartmentEntity.nxDepartmentOrderCode}}.</text>
                                  <text class="">{{order.nxDepartmentEntity.nxDepartmentOrderCode}}</text>

                                </view>
                                <view class="text-secondary"
                                  wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                  <text>备注:</text>
                                  <text class="text-danger">{{order.nxDoRemark}}</text>
                                </view>

                              </view>
                              <view wx:else class="flex-column">
                                <text class="">{{order.nxDepartmentEntity.nxDepartmentOrderCode}}</text>
                                <view class="text-secondary"
                                  wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                  <text>备注:</text>
                                  <text class="text-danger">{{order.nxDoRemark}}</text>
                                </view>
                              </view>
                            </view>
                            <view class="flex-row">
                              <text class="ml-20 mainColor">下单数量:</text>
                              <text class="">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                            </view>

                          </view>

                          <view class="flex-row-default">
                            <view class="flex-row-default" style="margin-top: 24rpx;">
                              <text class="circle_default"></text>
                            </view>
                            <view class="flex-column">
                              <view class="flex-row-between p-10" style="width:{{(windowWidth - 120)}}rpx;;">
                                <text class="text-secondary">供货数量:</text>
                                <view class="flex-row">
                                  <text class="text-secondary">数量:</text>
                                  <text>{{order.nxDoWeight}}{{item.nxDgGoodsStandardname}}</text>
                                </view>
                              </view>

                              <view class="flex-row-between pl-10" style="width:{{(windowWidth - 120)}}rpx; " wx:if="{{order.nxDoCostPrice > 0.1}}" >

                                <view class="half-row">
                                  <text class="text-secondary">供货单价:</text>
                                  <text class="">{{order.nxDoCostPrice}}元</text>
                                </view>
                                <view class="half-row flex-row-reverse">
                                  <text>{{order.nxDoCostSubtotal}}元</text>
                                  <text class="text-secondary">小计:</text>
                                </view>
                              </view>
                             
                            </view>
                          </view>


                        </view>
                      </view>
                    </view>

                  </view>
                </view>


              </view>
            </view>


            <!-- </view> -->
          </view>

        </scroll-view>
      </swiper-item>

    </swiper>


  </view>

</view>



<!-- 确认弹窗 -->
<view class="modal-overlay" wx:if="{{showConfirmModal}}" bindtap="closeConfirmModal" catchtouchmove="preventScroll">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="flex-column">
        <text class="modal-title">复制内容预览：</text>
      </view>
      <view class="flex-column">
        <view class="modal-title mt-10 mb-10" style="font-size: 24rpx; margin-right: 10rpx;">隐藏订单</view>
        <switch checked="{{onlyGoodsNameAndTotal}}" bindchange="changeShowOrder" />
      </view>
      <!-- <view class="modal-close" bindtap="closeConfirmModal">×</view> -->
    </view>
    <scroll-view class="modal-body" scroll-y="true" enable-back-to-top="true">
      <view class="content-preview">
        <view class="preview-content">
          <text>{{pasteContent}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="closeConfirmModal">关闭</view>
      <view class="modal-btn confirm-btn" bindtap="confirmUpdatePasteContent">确认更新</view>
    </view>
  </view>
</view>

<!-- 删除确认弹窗 -->
<view class="modal-overlay" wx:if="{{showDeleteConfirmModal}}" bindtap="cancelDeleteBatchItem"
  catchtouchmove="preventScroll">
  <view class="modal-content delete-modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">取消订货</text>
    </view>
    <view class="modal-body p-30">
      <text class="delete-confirm-text">将"{{deleteGoodsName}}"撤回到“采购”？</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="cancelDeleteBatchItem">取消</view>
      <view class="modal-btn confirm-btn" bindtap="confirmDeleteBatchItem">确认</view>
    </view>
  </view>
</view>