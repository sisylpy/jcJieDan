<wxs src="../../../utils/fn.wxs" module="tool" />



<view class="flex flex-column">

  <custom-navbar style="height: {{navBarHeight}}rpx;" title="采购中" avatar="{{url + userInfo.nxDiuWxAvartraUrl}}" button-text="设置" bindnavbuttontap="onNavButtonTap"></custom-navbar>

  <view class="content flex-1 flex-column">

    <view class="flex-row" style="height: {{viewBarHeight}}rpx; ">
      <view class="navbar">
        <block wx:for="{{tabs_wx}}" wx:key="name">
          <view id="{{index}}" class="half-row text-center navbar-item-sub {{innerCurrent == index ? 'bar-item-sub-on':''}}" data-current='{{index}}' bindtap='onTab1ClickSub' hover-class="hover">
            <view class='navbar-title-sub' style="line-height: {{viewBarHeight}}rpx;">{{item.name}}({{item.amount}})</view>
          </view>
        </block>       
      </view>
    </view>

    <swiper style="height: {{contentHeight }}rpx; " current="{{innerCurrent}}" bindchange='onInnerSwiperChange'>
      <!-- 打印 -->
      <swiper-item class=''>
        <!-- 下拉刷新容器 -->
        <scroll-view scroll-y="true" refresher-enabled="true" refresher-triggered="{{refresherTriggered1}}" bindrefresherrefresh="onRefresh1" scroll-into-view="{{toViewWx}}" scroll-top="0" bindscroll="scrollToWx" bindscrolltolower="onReachBottom" scroll-with-animation style="height: {{contentHeight}}rpx;">
          <!-- emptyView -->
          <view class="{{batchArr.length == 0  ? 'show' : 'hide'}}">
            <view class="flex-column center-content" style="height: {{windowHeight - 500}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">没有打印采购单</text>
            </view>
          </view>
          <!-- ./emptyView -->
          <block wx:if="{{batchArr.length > 0}}">

            <view class="flex-column p-20 bg-white " wx:for="{{batchArr}}" wx:for-item="batch" wx:for-index="batchIndex" wx:key="nxDistributerPurchaseBatchId">

              <view class="body" style="width:{{windowWidth - 40}}rpx;  ">
                <view class="flex flex-row-between p-20 border-bottom" >
                  <view class="flex-column  font-xs">
                    <view>采购打印:</view>
                    <view>{{batch.nxDpbTime}}</view>
                  </view>

                  <view class="button-container"  bindtap="printBatchContent" data-batch-id="{{batch.nxDistributerPurchaseBatchId}}" data-batch-index="{{batchIndex}}">
                  <image src="/images/print-4.png" mode="aspectFill" class="icon"/>
                </view>
               
                </view>
                <view class="flex-column">
                  <view class="flex flex-row-default p-10 border-bottom  font-lg" wx:for="{{batch.nxDPGEntities}}" wx:key="nxDistributerPurchaseGoodsId" wx:for-index="goodsIndex">
                    <text class="pt-10 mt-10">{{goodsIndex + 1}}.</text>
                    <view class="flex-column p-10" style="width:{{windowWidth - 100}}rpx;  ">
                      <view class="flex-row-between">
                        <view class="flex-row" style="width: {{windowWidth - 140}}rpx; ">
                          <text class="brand" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== null && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                          <text class="">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>

                          <block wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                          <block wx:else>
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                        </view>
                        <view class="button-container-white">
                          <view class="" bindtap="cancelDisBatchItem" hover-class="hover" data-id="{{item.nxDistributerPurchaseGoodsId}}">
                            <image src="../../../images/del-6.png" class="icon"></image>
                          </view>


                        </view>
                      </view>



                      <view class="flex-cloumn font-md" style=" width: {{windowWidth - 160}}rpx; ">
                        <view class="flex-row-default pt-10 pb-10" wx:for-item="order" wx:for="{{item.nxDistributerGoodsEntity.nxDepartmentOrdersEntities}}" wx:for-index="orderIndex" wx:key="nxDepartmentOrdersId">

                          <view class="flex-column">
                            <view class="flex-row-between p-10 {{order.nxDoPurchaseStatus == 4 ? 'bg-white' :'liziBack'}}  {{order.nxDoPurchaseStatus == 5 ? 'liziDelivery' : ''}} {{order.nxDoPurchaseStatus == 3 ? 'liziClock' : ''}}" style="width: {{windowWidth - 160}}rpx;">
                              <view class="flex-row">
                                <text class="circle_default"></text>

                                <block wx:if="{{order.gbDepartmentEntity !== null}}">
                                  <view class="flex-column p-10 mr-20" wx:if="{{order.gbDepartmentEntity.fatherGbDepartmentEntity !== null}}">
                                    <view class='flex-row '>
                                      <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                      <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>

                                    </view>
                                    <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      <text>备注:</text>
                                      <text class="red">{{order.nxDoRemark}}</text>
                                    </view>

                                  </view>
                                  <view wx:else class="flex-column p-10 mr-20">
                                    <text class=' '>{{order.gbDepartmentEntity.gbDepartmentName}}</text>
                                    <text wx:if="{{batch.nxDpbStatus <  0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                    <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      备注:<text class="red">{{order.nxDoRemark}}</text>
                                    </view>
                                  </view>
                                </block>
                                <block wx:elif="{{order.nxRestrauntEntity !== null}}">
                                  <view class="flex-row p-10 mr-20" wx:if="{{order.nxRestrauntEntity.gbDepartmentSubAmount > 1}}">
                                    <view class='flex-row '>

                                      <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                      <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>

                                    </view>
                                    <view class="text-secondary flex-column" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      <text>备注:</text>
                                      <text class="red">{{order.nxDoRemark}}</text>
                                    </view>

                                  </view>
                                  <view wx:else class="flex-column p-10 mr-20">
                                    <text class=' '>{{order.nxRestrauntEntity.nxRestrauntAttrName}}</text>
                                    <text wx:if="{{batch.nxDpbStatus < 0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                    <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      备注:<text class="red">{{order.nxDoRemark}}</text>
                                    </view>
                                  </view>
                                </block>

                                <block wx:else>
                                  <view class="flex-column" wx:if="{{order.nxDepartmentEntity.fatherDepartmentEntity !== null}}">
                                    <view class='flex-row-default '>
                                      <text class="">{{order.nxDepartmentEntity.fatherDepartmentEntity.nxDepartmentAttrName}}.</text>
                                      <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>

                                    </view>
                                    <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      <text>备注:</text>
                                      <text class="text-danger">{{order.nxDoRemark}}</text>
                                    </view>

                                  </view>
                                  <view wx:else class="flex-column">
                                    <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>
                                    <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                      <text>备注:</text>
                                      <text class="text-danger">{{order.nxDoRemark}}</text>
                                    </view>
                                  </view>
                                </block>

                                <text class="ml-20">订:{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                              </view>

                              <block wx:if="{{order.nxDoPurchaseStatus == 4}}">
                                <image src="/images/select-6.png" mode="aspectFill" class="icon" />
                              </block>

                            </view>


                          </view>
                        </view>
                      </view>

                    </view>
                  </view>

                </view>
              

              </view>

            </view>

            <view class="" style="height: 300rpx;">
              <view class="p-20 " style="text-align:center;margin-top: 40rpx;">没有数据啦！</view>
            </view>

          </block>
        </scroll-view>
      </swiper-item>

      <!-- 复制 -->
      <swiper-item class=''>
        <!-- 下拉刷新容器 -->
        <scroll-view scroll-y="true" refresher-enabled="true" refresher-triggered="{{refresherTriggered2}}" bindrefresherrefresh="onRefresh2" style="height: {{contentHeight}}rpx;">
          <!-- emptyView -->
          <view class="{{batchArr.length == 0  ? 'show' : 'hide'}}">
            <view class="flex-column center-content" style="height: {{windowHeight - 500}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">没有复制订单</text>
            </view>
          </view>
          <!-- ./emptyView -->
          <block wx:if="{{batchArr.length > 0}}">

            <view class="flex-column p-20 bg-white " wx:for="{{batchArr}}" wx:for-item="batch" wx:for-index="batchIndex" wx:key="nxDistributerPurchaseBatchId">

              
              <view class="body" style="width:{{windowWidth - 60}}rpx;  ">
               
                <view class="copy-content-card">
                            <view class="copy-header">
                              <view class="copy-icon">📋</view>
                              <text class="copy-title">复制内容</text>
                              <view class="copy-tag" bindtap="updatePasteBatchContent" data-batch-id="{{batch.nxDistributerPurchaseBatchId}}" data-batch-index="{{batchIndex}}">再次复制</view>
                            </view>
                            <text class="copy-content-text">{{batch.nxDpbPasteContent}}</text>
                          </view>

                <view class="flex-column">
                  <view class="flex-row-default p-20 border-bottom  font-lg" wx:for="{{batch.nxDPGEntities}}" wx:key="nxDistributerPurchaseGoodsId" wx:for-index="goodsIndex">

                    <text class="p-10">{{goodsIndex + 1}}.</text>

                    <view class="flex-column">
                      <view class="flex-row-between">
                        <view class="flex-row" style="width: {{windowWidth - 220}}rpx; ">
                          <text class="brand" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== null && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                          <text class="">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>

                          <block wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                          <block wx:else>
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                        </view>
                        <view class="button-container-white">
                          <view class="" bindtap="cancelDisBatchItem" hover-class="hover" data-id="{{item.nxDistributerPurchaseGoodsId}}">
                            <image src="../../../images/del-6.png" class="icon"></image>
                          </view>
                        </view>
                      </view>


                      <view class="flex-cloumn font-sl" style=" width: {{windowWidth - 160}}rpx; ">
                        <view class="flex flex-row" wx:for-item="order" wx:for="{{item.nxDistributerGoodsEntity.nxDepartmentOrdersEntities}}" wx:for-index="orderIndex" wx:key="nxDepartmentOrdersId">

                          <view class="flex-row-between">
                            <view class="flex flex-row " style="width: {{windowWidth - 200}}rpx;">
                              <text class="circle_default"></text>
                              <block wx:if="{{order.gbDepartmentEntity !== null}}">
                                <view class="flex-column p-10 mr-20" wx:if="{{order.gbDepartmentEntity.fatherGbDepartmentEntity !== null}}">
                                  <view class='flex-row '>
                                    <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                    <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>

                                  </view>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="red">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-column p-10 mr-20">
                                  <text class=' '>{{order.gbDepartmentEntity.gbDepartmentName}}</text>
                                  <text wx:if="{{batch.nxDpbStatus <  0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    备注:<text class="red">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>
                              <block wx:elif="{{order.nxRestrauntEntity !== null}}">
                                <view class="flex-row p-10 mr-20" wx:if="{{order.nxRestrauntEntity.gbDepartmentSubAmount > 1}}">
                                  <view class='flex-row '>

                                    <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                    <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>

                                  </view>
                                  <view class="text-secondary flex-column" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="red">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-column p-10 mr-20">
                                  <text class=' '>{{order.nxRestrauntEntity.nxRestrauntAttrName}}</text>
                                  <text wx:if="{{batch.nxDpbStatus < 0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    备注:<text class="red">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>

                              <block wx:else>
                                <view class="flex-row" wx:if="{{order.nxDepartmentEntity.fatherDepartmentEntity !== null}}">
                                  <view class='flex-row '>
                                    <text class="">{{order.nxDepartmentEntity.fatherDepartmentEntity.nxDepartmentName}}.</text>
                                    <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>

                                  </view>
                                  <view class="text-secondary flex-column" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="red">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-row ">
                                  <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>

                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="red">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>

                              <text class="ml-20">订:{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>

                            </view>

                          </view>
                        </view>
                      </view>

                    </view>

                  </view>
                 
                </view>
              </view>


            </view>

            <view class="" style="height: 300rpx;">
              <view class="p-20 " style="text-align:center;margin-top: 40rpx;">没有数据啦！</view>
            </view>

          </block>
        </scroll-view>
      </swiper-item>

      <!-- 小程序 -->
      <swiper-item class='' wx:if="{{disInfo.nxDistributerBusinessTypeId == 2}}">
        <!-- 下拉刷新容器 -->
        <scroll-view scroll-y="true" refresher-enabled="true" refresher-triggered="{{refresherTriggered3}}" bindrefresherrefresh="onRefresh3" style="height: {{contentHeight}}rpx;">
          <!-- emptyView -->
          <view class="{{batchArr.length == 0  ? 'show' : 'hide'}}">
            <view class="flex-column center-content" style="height: {{windowHeight - 500}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">没有微信订货订单</text>
            </view>
          </view>
          <!-- ./emptyView -->
          <block wx:if="{{batchArr.length > 0}}">

            <view class="flex-column p-20 bg-white " wx:for="{{batchArr}}" wx:for-item="batch" wx:for-index="batchIndex" wx:key="nxDistributerPurchaseBatchId">

              <view class="body" style="width:{{windowWidth - 40}}rpx;  ">
                <view class="flex flex-row p-20 border-bottom font-xs" style="background-color: rgb(238, 238, 238);">

                  <view class="flex-column center-content third-row">
                    <image src="{{url + batch.nxJrdhBuyerEntity.nxJrdhWxAvartraUrl}}" class="button-container-white">
                    </image>
                    <view class="username">
                      {{tool.getAttrName(batch.nxJrdhBuyerEntity.nxJrdhWxNickName) }}
                    </view>
                  </view>

                  <view class="flex-column center-content  third-row">
                   
                    <image src="../../../images/primitive-dot.png" class="icon"></image>
                    <view class="font-xs  pb-10 text-center" wx:if="{{batch.nxDpbNxDepartmentName !== null}}">
                      {{batch.nxDpbNxDepartmentName}}
                    </view>
                    <!-- <view class="text-secondary flex-row">
                      <text class="">{{batch.nxDpbTime}}</text>
                    </view> -->
                  </view>

                  <view class="flex-column center-content third-row" bind:tap="toShareBatch" data-id="{{batch.nxDistributerPurchaseBatchId}}">
                    <view wx:if="{{batch.nxJrdhSellerEntity == null}}">
                      <image src="/images/logo.jpg" class="icon-lg"> </image>
                    </view>
                    <image wx:else src="{{url + batch.nxJrdhSellerEntity.nxJrdhWxAvartraUrl}}" class="button-container-white"> </image>
                    <view class="username" wx:if="{{batch.nxDpbStatus > -1}}">
                      {{batch.nxJrdhSellerEntity.nxJrdhWxNickName}}
                    </view>
                    <view class="text-danger" wx:else>卖家未读</view>
                  </view>
                </view>
                <view class="flex-column">
                  <view class="flex flex-row-default p-10 border-bottom  font-lg" wx:for="{{batch.nxDPGEntities}}" wx:key="nxDistributerPurchaseGoodsId" wx:for-index="goodsIndex">
                    <text class="pt-10 mt-10">{{goodsIndex + 1}}.</text>
                    <view class="flex-column p-10" style="width:{{windowWidth - 100}}rpx;  ">
                      <view class="flex-row-between">
                        <view class="flex-row" style="width: {{windowWidth - 140}}rpx; ">
                          <text class="brand" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== null && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                          <text class="">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>

                          <block wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                          <block wx:else>
                            <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                          </block>
                        </view>
                        <view class="button-container-white" wx:if="{{batch.nxDpbStatus < 1}}">
                          <view class="" bindtap="cancelDisBatchItem" hover-class="hover" data-id="{{item.nxDistributerPurchaseGoodsId}}" wx:if="{{item.nxDpgFinishAmount == 0 && item.nxDpgStatus < 2}}">
                            <image src="../../../images/del-6.png" class="icon"></image>
                          </view>
                          <view class="" hover-class="hover" data-id="{{item.nxDistributerPurchaseGoodsId}}" wx:if="{{item.nxDpgStatus > 2 && item.nxDpgFinishAmount == 0}}">
                            <image src="../../../images/selected-2.png" class="icon"></image>
                          </view>

                        </view>
                      </view>

                      <view class="flex flex-row font-md pt-10 pb-10" wx:if="{{batch.nxDpbStatus  > 0}}">
                        <view class="flex-row third-row">
                          <text class="text-secondary">单价:</text>
                          <text>{{item.nxDpgBuyPrice}}元/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                        </view>
                        <view class="flex-row third-row" wx:if="{{item.nxDpgBuyQuantity !== null && item.nxDpgBuyQuantity !== '' && item.nxDpgBuyQuantity > 0 }}">
                          <text class="text-secondary">进货:</text>
                          <text>{{item.nxDpgBuyQuantity}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                        </view>
                        <view class="flex-row third-row" wx:if="{{item.nxDpgBuyQuantity !== null &&  item.nxDpgBuyQuantity > 0 }}">
                          <text class="text-secondary">小计:</text>
                          <text>{{item.nxDpgBuySubtotal}}元</text>
                        </view>
                      </view>

                      <view class="flex-cloumn font-md" style=" width: {{windowWidth - 160}}rpx; ">
                        <view class="flex-row-default pt-10 pb-10" wx:for-item="order" wx:for="{{item.nxDistributerGoodsEntity.nxDepartmentOrdersEntities}}" wx:for-index="orderIndex" wx:key="nxDepartmentOrdersId">

                          <view class="flex-column">
                            <view class="flex flex-row" style="width: {{windowWidth - 160}}rpx;">
                              <text class="circle_default"></text>

                              <block wx:if="{{order.gbDepartmentEntity !== null}}">
                                <view class="flex-column p-10 mr-20" wx:if="{{order.gbDepartmentEntity.gbDepartmentSubAmount > 1}}">
                                  <view class='flex-row '>
                                    <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                    <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>
                                  </view>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="text-danger">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-column p-10 mr-20">
                                  <text class=' '>{{order.gbDepartmentEntity.gbDepartmentName}}</text>
                                  <text wx:if="{{batch.nxDpbStatus <  0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                  <view class="text-secondary flex-row" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="text-danger">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>
                              <block wx:elif="{{order.nxRestrauntEntity !== null}}">
                                <view class="flex-row-default p-10 mr-20" wx:if="{{order.nxRestrauntEntity.gbDepartmentSubAmount > 1}}">
                                  <view class='flex-column '>
                                    <text>{{order.gbDepartmentEntity.fatherGbDepartmentEntity.gbDepartmentName}}.</text>
                                    <text>{{order.gbDepartmentEntity.gbDepartmentName}}</text>
                                  </view>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="red">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-column p-10 mr-20">
                                  <text class=' '>{{order.nxRestrauntEntity.nxRestrauntAttrName}}</text>
                                  <text wx:if="{{batch.nxDpbStatus < 0}}">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    备注:<text class="text-danger">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>

                              <block wx:else>
                                <view class="flex-column" wx:if="{{order.nxDepartmentEntity.fatherDepartmentEntity !== null}}">
                                  <view class='flex-row-default '>
                                    <text class="">{{order.nxDepartmentEntity.fatherDepartmentEntity.nxDepartmentAttrName}}.</text>
                                    <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>

                                  </view>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="text-danger">{{order.nxDoRemark}}</text>
                                  </view>

                                </view>
                                <view wx:else class="flex-column">
                                  <text class="">{{order.nxDepartmentEntity.nxDepartmentName}}</text>
                                  <view class="text-secondary" wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}">
                                    <text>备注:</text>
                                    <text class="text-danger">{{order.nxDoRemark}}</text>
                                  </view>
                                </view>
                              </block>

                              <text class="ml-20">订:{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>

                            </view>

                            <view class="flex flex-row font-xs" wx:if="{{batch.nxDpbStatus > 0}}" style="width:{{(windowWidth - 140)}}rpx;;">
                              <text class="circle_default_white"></text>

                              <view class="third-row">
                                <text class="text-secondary">数量:</text>
                                <text>{{order.nxDoWeight}}{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                              </view>
                              <view class="third-row">
                                <text class="text-secondary">单价:</text>
                                <text class="">{{order.nxDoCostPrice}}元</text>
                              </view>
                              <view class="third-row">
                                <text class="text-secondary">小计:</text>
                                <text>{{order.nxDoCostSubtotal}}元</text>
                              </view>
                            </view>

                          </view>
                        </view>
                      </view>

                    </view>
                  </view>

                  <block wx:if="{{batch.nxDpbStatus > 0}}">
                    <view class="flex-row-reverse p-30">
                      <text>元</text>
                      <text class="big">{{batch.nxDpbSellSubtotal}}</text>
                      <text>总计:</text>
                    </view>
                    <view class="flex-column p-20">
                      <view class="finish_btn" style="width: {{windowWidth - 120}}rpx;" bindtap="showFinish" data-item="{{batch}}">完成订货</view>
                    </view>
                  </block>
                </view>
              </view>


            </view>

            <view class="" style="height: 300rpx;">
              <view class="p-20 " style="text-align:center;margin-top: 40rpx;">没有数据啦！</view>
            </view>

          </block>
        </scroll-view>
      </swiper-item>
    </swiper>
  </view>

</view>



<stockOutGoods show="{{showDisOutGoods}}" bindconfirm="confirm" bindconfirmSave="confirmSave" bindneednot="confirmNeedNotPurchse" bindcancle="cancle" item="{{item}}" bindgetFocus="getFocus" bindcancle="cancle" modalHeight="{{windowHeight > maskHeight ? windowHeight : maskHeight }}" scrollViewTop="{{scrollViewTop}}" modalContentHeight="{{modalContentHeight}}" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}" ids="{{ids}}" />


<view animation="{{buttonAnimation}}" class="flex flex-row bottom-button-container-pur {{selectedArr.length > 0 ? 'is-active' : ''}}" style="z-index: 100000;">
  <view class="flex flex-row pt-10">
    <view class="third-row center-content" bindtap="showCar">
      <view class="dotPur" style="margin-left: {{windowWidth / 10}}rpx;">{{selectedArr.length}}</view>
      <image class="pur_icon" src="/images/a-gouwuchejinhuocaigouhuo.png"></image>
    </view>
    <view class="stock_order_btn is-paste third-row mr-30" bindtap="toPaste">
      复制订货
    </view>
    <view class="stock_order_btn is-wx third-row mr-30" bindtap="saveBatchOrder">
      小程序订货
    </view>

  </view>

</view>


<view class='overlay {{showOperationCar ? "show" : ""}}' catchtouchmove='ture' catch:tap="closeCar">
  <view class="flex-column orderBottom" animation='{{animationData}}' style="max-height:{{windowHeight  - 320}}rpx;">

    <view class="flex-row-between p-20">
      <view class="text-secondary">选择了{{selectedArr.length}}个商品:</view>
      <view bindtap="closeCar" class="p-10">
        关闭
      </view>
    </view>
    <scroll-view scroll-y="true" style="max-height: {{windowHeight - 520}}rpx; padding-bottom: 100rpx; ">
      <view class="flex-row-wrap p-20">
        <view class="flex-row  goodsBack p-20" wx:for="{{selectedArr}}" wx:key="purGoodsId">
          <text class="text_operation">{{index+ 1}}.{{item.item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
          <image catchtap="deleteOrderGoods" data-index="{{index}}" data-id="{{item.purGoodsId}}" src="../../../images/Delete-2.png" style="width: 50rpx; height: 50rpx; position: absolute; top: -10rpx; right: -30rpx; "></image>
        </view>
      </view>
    </scroll-view>

  </view>
</view>



<payType show="{{showPay}}" bindconfirmPay="confirmPay" bindcancle="cancle" item="{{batch}}" maskHeight="{{maskHeight > windowHeight ? maskHeight : windowHeight}}" scrollViewTop="{{scrollViewTop}}" url="{{url}}" bindtoSupplier="toSupplier" hasSupplier="{{hasSupplier}}" />

<!-- 确认弹窗 -->
<view class="modal-overlay" wx:if="{{showConfirmModal}}" bindtap="closeConfirmModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">复制内容预览：</text>
      <view class="modal-close" bindtap="closeConfirmModal">×</view>
    </view>
    <view class="modal-body">
      <view class="content-preview">
        <view class="preview-content">
          <text>{{pasteContent}}</text>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="closeConfirmModal">取消</view>
      <view class="modal-btn confirm-btn" bindtap="confirmUpdatePasteContent">确认更新</view>
    </view>
  </view>
</view>