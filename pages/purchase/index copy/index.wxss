.page-root {
  height: 100vh;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.swiper-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.scroll-content {
  flex: 1;
  min-height: 0;
}

/* 新增样式 */
.main {
  display: flex;
  flex-direction: row;
  height: 100%;
}

.left-menu {
  background-color: #f5f5f5;
  border-right: 1rpx solid #eee;
}

.right-content {
  /* background-color: #fff; */
  flex: 1;
}

/* 按部门模式下的商品和订单样式 */
.goods-orders-department {
  flex: 1;
}

.goods-order-row-department {
  align-items: center;
  /* padding: 15rpx 0; */
  min-height: 70rpx;
  flex-wrap: wrap;
}

.goods-name-department {
  flex: 1;
  min-width: 200rpx;
  margin-right: 20rpx;
}

.goods-name-department .brand {
  font-size: 26rpx;
  color: #999;
  margin-right: 10rpx;
}

.goods-name-department .font-lg {
  font-size: 32rpx;
}

.order-info-department {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  flex: 1;
  min-width: 200rpx;
}

.order-info-department text {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.order-info-department .order-quantity {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.order-info-department .order-scale {
  font-size: 26rpx;
  color: #666;
}

.order-info-department .order-remark {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 自定义选择框样式 */
.custom-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 6rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.custom-checkbox.checked {
  background-color: #187e6e;
  border-color: #187e6e;
}

.checkbox-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
}

/* 类别标题区域样式 - 微调，只增加间距 */
.category-header-wrapper {
  margin-top: 24rpx;
}

.category-header-wrapper:first-child {
  margin-top: 0;
}
