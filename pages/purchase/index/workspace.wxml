<view class="flex flex-column">

  <custom-navbar wx:if="{{!embedded}}" style="height: {{navBarHeight}}rpx;" title="外采" avatar="{{url + userInfo.nxDiuWxAvartraUrl}}"
    button-text="设置" bindnavbuttontap="onNavButtonTap"></custom-navbar>

    <view class="merged-work-tabs" wx:if="{{!embedded}}">
      <view class="merged-work-tab" bindtap="openStockWorkspace">出货中</view>
      <view class="merged-work-tab is-active">外采</view>
      <view class="merged-work-tab" bindtap="openPartnerWorkspace">协作伙伴</view>
    </view>

    <view
      class=" flex flex-row-between bg-white border-bottom pt-20"
      style="height: {{purchaseAppEntryBarHeight}}rpx;"
      wx:if="{{embedded}}">
      <view></view>
      <view class="flex flex-row">
      <!-- 增加外采按照客户的切换 -->
        <view class="button-container mr-40" bindtap="changeShwoType">
          <image src="{{viewMode === 'category' ? '/images/icon_goods_active.png' : '/images/dianpu.png'}}" class="icon"></image>
        </view>


      <view class="button-container mr-40" aria-label="打开精彩订货"
      bindtap="openPurchaseApp">
      <image src="/images/jjdhn.png" class="icon"></image>
    </view>
    </view>
      
    </view>

    <!-- 外采工作区只展示未采购数据，不再提供“采购中”二级页签。 -->
    <view style="height: {{purchaseWorkspaceHeight}}rpx;">

        <view class="content flex-1 flex-column">
          <view
            class="{{(viewMode === 'category' && purCataArr.length == 0) || (viewMode === 'department' && depArr.length == 0) ? 'show' : 'hide'}}">
            <view class="flex-column center-content" style="height: {{purchaseWorkspaceHeight}}rpx;">
              <image class="empty_image " src="../../../images/xiuxi.png"></image>
              <text class="font-md text-secondary p-20">没有未采购订单</text>
            </view>
          </view>

          <!-- 下拉刷新容器 -->
          <view
            wx:if="{{(viewMode === 'category' && purCataArr.length > 0) || (viewMode === 'department' && depArr.length > 0)}}">

            <view class="main">
              <scroll-view class="left-menu" scroll-y="true"
                style="height: {{purchaseWorkspaceHeight - 40}}rpx; width: {{leftMenuWidth}}rpx;"
                scroll-top="{{scrollTopLeftWx}}">
                <!-- 按类别模式 -->
                <block wx:if="{{viewMode === 'category'}}">
                  <view
                    class="left-item flex-row-between border-bottom {{selectedSubWx == leftIndex ? 'left-active' : ''}}"
                    wx:key="index" wx:for="{{purCataArr}}" wx:for-item="grand" wx:for-index="leftIndex">
                    <view class="flex-column-center flex-1" bindtap="toScrollViewWx" data-index="{{leftIndex}}"
                      style="flex: 1;">
                      <text class="font-sm text-center">{{grand.nxDfgFatherGoodsName}}</text>
                      <text class="font-sm">({{grand.newOrderCount}})</text>
                    </view>

                  </view>
                </block>
                <!-- 按客户模式 -->
                <block wx:else>
                  <view
                    class="left-item flex-column-center border-bottom {{selectedSubWx == leftIndex ? 'left-active' : ''}}"
                    wx:key="index" wx:for="{{depArr}}" wx:for-item="dep" bindtap="toScrollViewWx"
                    data-index="{{leftIndex}}" wx:for-index="leftIndex">
                    <text class="font-sm text-center">{{dep.depOrderCode}}</text>
                    <text class="font-sm">({{dep.orderCount}})</text>
                  </view>
                </block>
                <view style="height: 20rpx;"></view>
              </scroll-view>

              <scroll-view class="right-content" scroll-y="true" refresher-enabled="true"
                refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onRefresh"
                scroll-into-view="{{toViewWx}}" scroll-top="0" bindscroll="scrollToWx" bindscrolltolower="onReachBottom"
                scroll-with-animation
                style="height: {{purchaseWorkspaceHeight}}rpx; width : {{windowWidth - leftMenuWidth}}rpx; ">
                <!-- 部门模式下的全选按钮 -->
                <view wx:if="{{viewMode === 'department' && purGoodsArr.length > 0}}"
                  class="flex flex-row-reverse bg-white border-bottom"
                  style="width: {{windowWidth - leftMenuWidth - 60}}rpx; padding: 20rpx;"
                  bindtap="selectAllDepartmentGoods">
                  <view class="flex flex-row" style="align-items: center;">
                    <text class="font-md mr-10 text-secondary">全选</text>
                    <image
                      src="{{isAllDepartmentSelected ? '/images/checkboxchecked.png' : '/images/checkbox-noselected.png'}}"
                      mode="aspectFill" class="icon"></image>
                  </view>
                </view>

                <!-- here -->
                <view wx:for="{{purGoodsArr}}" wx:for-item="item" wx:key="nxDistributerPurchaseGoodsId"
                  wx:for-index="goodsIndex">

                  <!-- 为每个分类的第一个商品添加分类锚点 -->
                  <block wx:if="{{viewMode !== 'department'}}">
                    <view
                      wx:if="{{goodsIndex === 0 || purGoodsArr[goodsIndex-1].nxDgDfgGoodsGreatGrandId !== item.nxDgDfgGoodsGreatGrandId}}"
                      id="category{{item.nxDgDfgGoodsGreatGrandId}}" class="category-header-wrapper">
                      <view class="flex-row-between p-20 bg-white border-bottom">
                        <text
                          class="goods-category-title category-anchor text-secondary font-sm">{{item.nxDgDfgGoodsGreatGrandName}}</text>
                        <view class="flex-column-center button-container-white" catchtap="selectAllCategoryGoods"
                          data-category-id="{{item.nxDgDfgGoodsGreatGrandId}}">
                          <image
                            src="{{item.categoryIsAllSelected ? '/images/checkboxchecked.png' : '/images/checkbox-noselected.png'}}"
                            mode="aspectFill" class="icon"></image>
                        </view>
                      </view>
                    </view>
                  </block>


                  <!-- 按类别模式：保持原有布局r -->
                  <view wx:if="{{viewMode === 'category'}}"
                    class="flex-column-center  border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}"
                    style="width: {{windowWidth - leftMenuWidth }}rpx; ">

                    <view class="flex-column">
                      <view class="flex flex-row-between p-20" bindtap="selectItem" data-index="{{goodsIndex}}"
                        data-id="{{item.nxDistributerPurchaseGoodsId}}"
                        style="width: {{windowWidth - leftMenuWidth - 20}}rpx;  ">
                        <view class="flex-column">
                          <view class="flex-row font-md">
                            <text class="brand"
                              wx:if="{{item.nxDgGoodsBrand !== null && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                            <text class="font-bold font-lg">{{item.nxDgGoodsName}}</text>
                            <text class="font-sm"
                              wx:if="{{item.nxDgGoodsStandardWeight !== null && item.nxDgGoodsStandardWeight.length > 0}}"
                              style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                            <text class="font-sm" wx:else
                              style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardname}})</text>
                          </view>
                        </view>
                        <view class="flex-column-center p-10 mr-20">
                          <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                            <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                          </view>
                        </view>
                      </view>

                      <view class="flex-column">
                        <!-- bindtap="choiceOrders" data-index="{{goodsIndex}}" data-fatherindex="{{fatherIndex}}" data-orderindex="{{orderIndex}}" -->
                        <block wx:for="{{item.orders}}" wx:for-item="orders" wx:for-index="orderIndex"
                          wx:key="uniqueKey">
                          <view class="flex-row plr-20" style="width: {{windowWidth - leftMenuWidth - 40}}rpx;  ">

                            <view class="flex-column-center" wx:if="{{item.isSelected}}">
                              <image src="../../../images/selected-2.png" class="icon "></image>
                            </view>
                            <view class="circle_default" wx:else=""></view>
                            <block wx:if="{{orders.nxDoRequestDisId == -1}}">
                              <view class="flex-row mr-30">
                              <!-- GB部门名称（扁平化） -->
                              <block wx:if="{{orders.gbDepName}}">
                                <text>{{orders.gbDepName}}</text>
                              </block>

                              <!-- NX部门名称（扁平化） -->
                              <block wx:if="{{orders.depName}}">
                                <text>{{orders.depName}}</text>
                              </block>

                              <text class="ml-10">{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>

                            </view>
                            </block>
                            <block wx:else="">
                              <view class="flex-row mr-30">
                                <text class="mr-10">[{{orders.nxDoRequestDistributerName}}]</text>
                              <text class="ml-10">{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>
                            </view>
                            </block>
                           
                          </view>
                          <view wx:if="{{orders.customerStandardText}}" class="customer-standard-workline" style="width: {{windowWidth - leftMenuWidth - 40}}rpx;">
                            <text class="customer-standard-work-title">客户要求</text>
                            <text class="customer-standard-work-content">{{orders.customerStandardText}}</text>
                          </view>
                        </block>
                      </view>

                    </view>

                    <!-- 删除按钮 -->
                    <block wx:if="{{item.nxDgPurchaseAuto == -1}}">
                      <view class="flex-row-reverse p-20" style="width: {{windowWidth - 200}}rpx;"
                        catchtap="deletePlanPurchseOrders" data-item="{{item}}" data-index="{{goodsIndex}}">
                        <view class="flex-row">
                          <image src="/images/del-6.png" mode="aspectFill" class="icon-sm mr-10" />
                          <view class=" text-secondary font-xs">取消采购</view>
                        </view>

                      </view>
                    </block>

                  </view>

                  <!-- 按部门模式：商品和订单在一行显示，样式与 stock 页面一致 -->
                  <view wx:else>
                    <block wx:for="{{item.orders}}" wx:for-item="orders" wx:for-index="orderIndex"
                      wx:key="nxDepartmentOrdersId">
                      <view
                        class="flex flex-row-between customer-standard-order-row border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}"
                        style="width: {{windowWidth - leftMenuWidth - 40}}rpx; padding: 20rpx;" bindtap="selectItem"
                        data-index="{{goodsIndex}}" data-id="{{item.nxDistributerPurchaseGoodsId}}">
                        <!-- 左侧：删除按钮（如果有）、序号、选择框、商品信息、订单信息 -->
                        <view class="flex flex-row flex-1" style="min-width: 0; flex-shrink: 1;">

                          <!-- 序号 -->
                          <text class="font-md mr-10"
                            style="min-width: 40rpx; flex-shrink: 0;">{{goodsIndex + 1}}.</text>
                          <!-- 选择框 -->
                          <view class="flex-column-center mr-10" style="flex-shrink: 0;">
                            <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                              <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                            </view>
                          </view>
                          <!-- 商品信息 -->
                          <view class="flex-row flex-1"
                            style="flex-shrink: 1; min-width: 0; flex-wrap: wrap; align-items: flex-start;">
                            <view class="flex-row" style="flex-shrink: 0; white-space: nowrap;">
                              <text class="brand"
                                wx:if="{{item.nxDgGoodsBrand !== null && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                              <text class="font-md font-bold" style="white-space: nowrap;">{{item.nxDgGoodsName}}</text>
                            </view>
                            <text class="font-sm"
                              wx:if="{{item.nxDgGoodsStandardWeight !== null && item.nxDgGoodsStandardWeight.length > 0}}"
                              style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                            <text class="font-sm" wx:else
                              style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardname}})</text>
                          </view>
                        </view>
                        <!-- 右侧：数量和备注 -->
                        <view class="flex flex-row" style="flex-shrink: 0; align-items: center; margin-left: 20rpx;">
                          <text class="font-lg font-bold ml-10">{{orders.nxDoQuantity}}{{orders.nxDoStandard}}</text>
                          <block
                            wx:if="{{orders.nxDoDsStandardScale !== null && orders.nxDoDsStandardScale.length > 0 && orders.nxDoDsStandardScale !== '-1'}}">
                            <text
                              class="font-sm ml-10">({{orders.nxDoDsStandardScale}}{{item.nxDgGoodsStandardname}}/{{orders.nxDoStandard}})</text>
                          </block>
                          <text
                            wx:if="{{orders.nxDoRemark !== null && orders.nxDoRemark.length > 0 && orders.nxDoRemark !== 'null'}}"
                            class="red ml-10 font-sm">({{orders.nxDoRemark}})</text>
                        </view>
                        <view wx:if="{{orders.customerStandardText}}" class="customer-standard-workline">
                          <text class="customer-standard-work-title">客户要求</text>
                          <text class="customer-standard-work-content">{{orders.customerStandardText}}</text>
                        </view>
                      </view>
                    </block>
                  </view>

                </view>
                <!-- ../here -->

                <!-- 加载状态提示 -->
                <view wx:if="{{isLoading}}" class="center-content text-secondary font-md" style="height: 100rpx;">
                  加载中...
                </view>
                <view wx:elif="{{!hasMore && purGoodsArr.length > 0}}" class="center-content text-secondary font-md"
                  style="height: 100rpx;">
                  没有更多数据了
                </view>
                <view wx:elif="{{purGoodsArr.length === 0}}" class="center-content text-secondary font-md"
                  style="height: 100rpx;">
                  没有数据啦！
                </view>
              </scroll-view>
            </view>
          </view>
        </view>
    </view>



</view>

<!-- 采购页已从原生 tabBar 中隐藏；保留同一套自定义底栏，视觉上仍属于第 2 个入口。 -->
<local-tab-bar id="local-tab-bar" wx:if="{{!embedded}}"></local-tab-bar>



<stockOutGoods show="{{showDisOutGoods}}" bindconfirm="confirm" bindconfirmSave="confirmSave"
  bindneednot="confirmNeedNotPurchse" bindcancle="cancle" item="{{item}}" bindgetFocus="getFocus" bindcancle="cancle"
  modalHeight="{{windowHeight > maskHeight ? windowHeight : maskHeight }}" scrollViewTop="{{scrollViewTop}}"
  modalContentHeight="{{modalContentHeight}}" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}"
  ids="{{ids}}" />


<view class='overlay {{showOperationCar ? "show" : ""}}' catchtouchmove='ture' catch:tap="closeCar">
  <view class="flex-column orderBottom" animation='{{animationData}}' style="max-height:{{windowHeight  - 320}}rpx;">

    <view class="flex-row-between p-20">
      <view class="text-secondary">选择了{{selectedArr.length}}个商品:</view>

      <view class="flex-row">

        <view catchtap="clearSelectedGoods" class="p-10">
          清除
        </view>

        <view bindtap="closeCar" class="p-10">
          关闭
        </view>

      </view>

    </view>
    <scroll-view scroll-y="true" style="max-height: {{windowHeight - 520}}rpx; padding-bottom: 100rpx; ">
      <view class="flex-row-wrap p-20">
        <view class="flex-row  goodsBack p-20" wx:for="{{selectedArr}}" wx:key="purGoodsId">
          <text class="text_operation">{{index+ 1}}.{{item.item.nxDgGoodsName}}</text>
          <image catchtap="deleteOrderGoods" data-index="{{index}}" data-id="{{item.purGoodsId}}"
            src="../../../images/Delete-2.png"
            style="width: 50rpx; height: 50rpx; position: absolute; top: -5rpx; right: -15rpx; "></image>
        </view>
      </view>
    </scroll-view>

  </view>
</view>


<!-- 确认弹窗 -->
<view class="modal-overlay" wx:if="{{showConfirmModal}}" bindtap="closeConfirmModal" catchtouchmove="preventScroll">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="flex-column">
        <text class="modal-title">复制内容预览：</text>
      </view>
      <view class="flex-column">
        <view class="modal-title mt-10 mb-10" style="font-size: 24rpx; margin-right: 10rpx;">隐藏订单</view>
        <switch checked="{{onlyGoodsNameAndTotal}}" bindchange="changeShowOrder" />
      </view>
    </view>
    <scroll-view class="modal-body" scroll-y="true" enable-back-to-top="true">
      <view class="content-preview">
        <view class="preview-content">
          <text>{{pasteContent}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="closeConfirmModal">关闭</view>
      <view class="modal-btn confirm-btn" bindtap="confirmUpdatePasteContent">确认更新</view>
    </view>
  </view>
</view>

<!-- 删除确认弹窗 -->
<view class="modal-overlay" wx:if="{{showDeleteConfirmModal}}" bindtap="cancelDeleteBatchItem" catchtouchmove="preventScroll">
  <view class="modal-content delete-modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">取消订货</text>
    </view>
    <view class="modal-body p-30">
      <text class="delete-confirm-text">将"{{deleteGoodsName}}"撤回到“采购”？</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel-btn" bindtap="cancelDeleteBatchItem">取消</view>
      <view class="modal-btn confirm-btn" bindtap="confirmDeleteBatchItem">确认</view>
    </view>
  </view>
</view>
