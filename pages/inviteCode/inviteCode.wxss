page {
  background-color: #f5f5f5;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.center-content {
  align-items: center;
  justify-content: center;
}

.p-20 {
  padding: 20rpx;
}

.word {
  font-size: 50rpx;
  line-height: 100rpx;
  font-weight: bold;
  color: #333;
}

.small {
  font-size: 28rpx;
}

.gray {
  color: #999;
}

.invite-container {
  /* margin-top: 80rpx; */
  padding: 60rpx 40rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.invite-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.invite-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 60rpx;
}

.input-container {
  margin-bottom: 40rpx;
}

.invite-input {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  background-color: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
}

.invite-input:focus {
  border-color: #234b50;
  background-color: #fff;
}

.btn-container {
  margin-top: 40rpx;
}

.verify-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #234b50;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.verify-btn.disabled {
  background-color: #ccc;
  color: #999;
}

.verify-btn::after {
  border: none;
}








