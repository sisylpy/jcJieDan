
page{
  background-color: #fff;
}

.avatar-preview-wrap {
  margin-top: 20rpx;
  font-size: 34rpx;
  color: #666;
  display: flex;
  align-items: center;
}
.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  object-fit: cover;
}

.container{
  padding: 50rpx 30rpx;
}


.input{
  height: 90rpx;
  margin-left: 16rpx;
}


.inputHalf{
  height: 90rpx;
  margin-left: 16rpx;
}




.word{
  font-size: 50rpx;
  line-height: 100rpx;
  /* margin-bottom: 20rpx; */

 
}

.what{
 
  border-radius: 10rpx;
  border: 1px solid gray;
}

.reg_btn{
 
  margin-bottom: 40rpx;
  margin-top: 40rpx;
 
}

.reg_btn button{
  /* color: #fff; */
  border: none;
  border: 1px solid lightgray;
  border-radius: 0;
  background: lightgray;
  
}
.reg_btn button.is-active{
  color: #fff;
  background: #187e6e;

}

.wx_btn{
  background: red;
}


.log_btn{
  background: #187e6e;
  color: #fff;

}

.log_btn button{
  color: #fff;
  border: none;
  
}

/*  */
button.addBtn{
  padding: 0;
  background: #707070;
  line-height: 90rpx;
  font-weight: 400;
  color: #fff;
}
.addBtn.next{
  background: #234b50;
}


.radio-group {
  padding: 20rpx;
}

.radio {
  width: 100%;
  /* border:1px solid red; */
  float: left;
  line-height: 120rpx;
}

/* 企业微信提示样式 */
.wxwork-tip {
  background-color: #f0f9ff;
  border: 1px solid #0ea5e9;
  border-radius: 8rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0ea5e9;
  font-size: 28rpx;
}

.wxwork-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* 用户协议同意区域 */
.agree-protocol-wrap {
  margin: 24rpx 0;
  font-size: 26rpx;
  color: #666;
}

.agree-label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  line-height: 1.6;
}

.agree-label .link {
  color: #234b50;
  text-decoration: underline;
  margin: 0 4rpx;
}

/* 隐私授权弹窗 */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.privacy-modal {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.privacy-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.privacy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  border: none;
}

.privacy-btn.primary {
  background: #234b50;
  color: #fff;
}

.privacy-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.privacy-btn::after {
  border: none;
}
