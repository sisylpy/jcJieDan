      <view class="flex-row" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx;">
        <text class="mr-10" style="width: 220rpx;text-align: right;">联系手机:</text>
        <view class='what' style="width: {{windowWidth - 280}}rpx;">
          <input class='inputHalf middle' type='number' placeholder='手机号码' name='phone' value='{{phone}}' bindblur="getPhone" bindconfirm="_canLogin"></input>
        </view>
      </view>

      <view class="flex-row" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx;">
        <text class="mr-10" style="width: 220rpx;text-align: right;">联系人:</text>
        <view class='what' style="width: {{windowWidth - 280}}rpx;">
          <input class='inputHalf middle'  placeholder='业务联系人' value='{{userName}}' bindinput="getUserName" bindconfirm="_canLogin"></input>
        </view>
      </view>

    </view>

<!-- 用户协议与隐私政策同意（平台规范3.4：取得用户授权同意后才能收集用户信息） -->
<view class="agree-protocol-wrap">
  <checkbox-group bindchange="onAgreeProtocolChange">
    <label class="agree-label">
      <checkbox value="agree" checked="{{agreeProtocol}}" />
      <text>我已阅读并同意</text>
      <text class="link" catchtap="toUserAgreement">《用户服务协议》</text>
      <text>和</text>
      <text class="link" catchtap="toPrivacyPolicy">《隐私政策》</text>
    </label>
  </checkbox-group>
</view>

<!-- 预览已选头像(若有) -->
<view wx:if="{{avatarUrl}}" class="avatar-preview-wrap">
    <text>已选头像预览：</text>
    <image 
      src="{{avatarUrl}}" 
      class="avatar-preview" 
    />
  </view>
    <!-- 登录按钮 -->
    <view class=' reg_btn  ' style="width: {{windowWidth - 40}}rpx;">
      <!-- 企业微信环境：直接注册，不需要选择头像 -->
      <button wx:if="{{canLogin && environment == 'wxwork'}}" class="addBtn next" bindtap="_registerWork" plain='true' style="width: {{windowWidth - 80}}rpx;">
        注册企业微信配送商用户
      </button>
      <!-- 普通微信环境：需要选择头像 -->
      <button wx:elif="{{canLogin}}" class="addBtn next" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" plain='true' style="width: {{windowWidth - 80}}rpx;">
        注册专业配送商用户
      </button>
      <!-- 条件不满足时的提示按钮 -->
      <button wx:else class="addBtn" bindtap="tishi" plain='true' style="width: {{windowWidth - 80}}rpx;">
        注册批发市场专业配送商用版
      </button>
    </view>
    
  </view>
</view>


<view class="overlay {{showSelect ? 'show' : 'hide'}}">

  <view class='popup p-30'>

      <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text> 请选择您的经营方式。</text>
        <view bindtap="closeType">
          <image src="../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row p-10'>
        <radio-group class="radio-group" bindchange="radioChange" >
          <label class="radio" wx:for="{{items}}" wx:key="value">
            <radio value="{{item.name}}" checked="{{item.checked}}" />{{item.value}}
          </label>
        </radio-group>
      </view>
  </view>

</view>


<view class="overlay {{showMarket ? 'show' : 'hide'}}">
  <view class='popup'>
  <!-- 文字 -->
      <view class='flex-row-between p-30'>
        <text> 请选所在位置</text>
        <view bindtap="closeMarket">
          <image src="../../images/del.png" class="icon"></image>
        </view>
      </view>
      <view class='flex-row'>
        <radio-group class="radio-group" bindchange="radioChangeMarket" >
          <label class="radio" wx:for="{{itemsMarket}}" wx:key="value">
            <radio value="{{index}}" data-name="{{item.sysCmMarketName}}" checked="{{item.sysCityMarketId == marketId}}" />{{item.sysCmMarketName}}
          </label>
        </radio-group>
      </view>
  </view>

</view>