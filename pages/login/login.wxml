<!-- 隐私授权弹窗（符合平台规范3.4） -->
<view class="privacy-mask" wx:if="{{showPrivacy}}">
  <view class="privacy-modal">
    <view class="privacy-title">用户协议与隐私政策</view>
    <view class="privacy-desc">我们需收集您的头像、昵称、手机号、位置等信息以提供配送管理服务。请阅读并同意相关协议后继续。</view>
    <view class="privacy-btns">
      <button class="privacy-btn secondary" bindtap="handleOpenPrivacyContract">查看隐私指引</button>
      <button id="agree-privacy-btn" class="privacy-btn primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacy">同意并继续</button>
    </view>
  </view>
</view>

<view class='flex-column'>



  <back-navbar style="height: {{navBarHeight}}rpx;" title="配送商注册" avatar="/images/logo.jpg" button-text="设置" bindnavbuttontap="toBack"></back-navbar>
  
  <view class='flex-column p-20' style="margin-top: {{navBarHeight}}rpx;">

    <view class="flex-column center-content">
    <view class='word'>京采接单</view>
    <view class="font-xs gray" style="margin-bottom: 40rpx;">专业配送商户专用版</view>
    
    <!-- 企业微信环境提示 -->
    <view wx:if="{{environment == 'wxwork'}}" class="wxwork-tip">
      <image src="/images/wx.png" class="wxwork-icon"></image>
      <text>您正在使用企业微信登录</text>
    </view>
  </view>

    <view class="flex-column">

    
     
     
      <view class="flex-row" style="width: {{windowWidth - 40}}rpx; ">
        <text class="mr-10" style="width: 220rpx; text-align: right;">所在位置:</text>
        <view class='what' style="width: {{windowWidth - 280}}rpx;">
          <input class='input middle' type='text' placeholder='批发市场' name='marketName' value='{{marketName}}' bindtap='showMarket' disabled="false"></input>
        </view>
      </view>


      <view class="flex-row" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx;">
        <text class="mr-10" style="width: 220rpx;text-align: right;">商铺地址:</text>
        <view class='what' style="width: {{windowWidth - 280}}rpx;">
          <input class='inputHalf middle' type='text' placeholder='大厅号+摊位号' name='address' value='{{address}}' bindblur='getAddress' ></input>
        </view>
      </view>

      <view class="flex-row mt-10" style="width: {{windowWidth - 40}}rpx; ">
        <text class="mr-10" style="width: 220rpx; text-align: right;">批发商名称:</text>
        <view class='what' style="width: {{windowWidth - 280}}rpx;">
          <input class='input middle' type='text' placeholder='批发商名称' name='name' value='{{name}}' bindblur='getName' bindconfirm="_canLogin"></input>
        </view>
      </view>


     


