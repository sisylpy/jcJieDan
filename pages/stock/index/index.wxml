<view class="flex flex-column">

  <custom-navbar style="height: {{navBarHeight}}rpx;" title="库存" avatar="{{url + userInfo.nxDiuWxAvartraUrl}}" button-text="设置" bindnavbuttontap="onNavButtonTap"></custom-navbar>

  <view class="content flex-1 flex-column">

    <view class="flex  flex-row-between bg-white border-bottom pt-20" style=" height: {{viewBarHeight}}rpx; ">

      <view class="flex-row">
        <view class=" button-container mr-30 ml-20" bind:tap="setPrint">
          <image src="{{printOk ? '/images/print-4.png' : '/images/0dayinji-05.png'}}" class="icon"></image>
        </view>
        <view class=" button-container mr-30 ml-20" bind:tap="setPaperSize">

          <text wx:if="{{paperSize == 1}}">小</text>
          <text wx:elif="{{paperSize == 2}}">中</text>
          <text wx:elif="{{paperSize == 3}}">大</text>
        </view>

        <view class=" button-container ml-20" bindtap="toMyShelf" wx:if="{{disInfo.nxDistributerBusinessTypeId  > 1}}">
          <image src="/images/Focus-Auto.png" class="icon"></image>
        </view>

      </view>

      <view class="flex flex-row p-20" style="height: {{viewBarHeight}}rpx; align-items: center;">
        <view class="button-container mr-40" bindtap="changeShwoType">
          <image src="{{viewMode === 'category' ? '/images/icon_goods_active.png' : '/images/dianpu.png'}}" class="icon"></image>
        </view>
      </view>
    </view>

    <view class="{{(viewMode === 'category' && goodsCataArr.length == 0) || (viewMode === 'department' && depArr.length == 0 && offArr.length == 0) ? 'show' : 'hide'}}">
      <view class="flex-column center-content" style="height: {{windowHeight - 300}}rpx;">
        <image class="empty_image" src="../../../images/xiuxi.png"></image>
        <text class="font-lg text-secondary p-30">没有出库中订单</text>
      </view>
    </view>

    <view class="main flex-1" wx:if="{{(viewMode === 'category' && goodsCataArr.length > 0) || (viewMode === 'department' && (depArr.length > 0 || offArr.length > 0))}}">

      <!-- 左侧菜单 - 始终显示 -->
      <scroll-view class="left-menu " scroll-y="true" scroll-top="{{scrollTopLeft}}" style="height:{{contentHeight - viewBarHeight}}rpx;width: {{leftMenuWidth}}rpx;">
        <!-- 按类别模式 -->
        <block wx:if="{{viewMode === 'category'}}">
          <view wx:if="{{goodsCataArr.length > 0}}">
            <view class="left-item flex-column-center border-bottom {{selectedSub == leftIndex ? 'left-active' : ''}}" wx:key="index" wx:for="{{goodsCataArr}}" wx:for-item="grand" bindtap="toScrollView" data-index="{{leftIndex}}" wx:for-index="leftIndex">
              <text class="font-sm text-center">{{grand.nxDfgFatherGoodsName}}</text>
              <view class="font-sm">({{grand.newOrderCount}})</view>
            </view>
          </view>
        </block>
        <!-- 按客户模式 -->
        <block wx:else>
          <view wx:if="{{offArr.length > 0}}">
            <view class="left-item flex-column-center border-bottom {{selectedCollDisId == dis.nxDistributerId ? 'left-active' : ''}}" wx:key="nxDistributerId" wx:for="{{offArr}}" wx:for-item="dis" bindtap="toScrollView" data-is-coll="true" data-coll-dis-id="{{dis.nxDistributerId}}" wx:for-index="leftIndex" >
              <text class="font-sm text-center">{{dis.nxDistributerShowName}}</text>
              <view class="font-sm">({{dis.aaa.orderCount}})</view>
            </view>
          </view>
          <view wx:if="{{depArr.length > 0}}">
            <block wx:for="{{depArr}}" wx:for-item="dep" wx:key="depId" wx:for-index="leftIndex">
              <view wx:if="{{leftIndex === 0 && dep.isPlatformCustomer === 1}}" class="dep-section-header">平台客户</view>
              <view wx:if="{{dep.isPlatformCustomer !== 1 && (leftIndex === 0 || depArr[leftIndex - 1].isPlatformCustomer === 1)}}" class="dep-section-header">我的客户</view>
              <view class="left-item flex-column-center border-bottom {{selectedDepId == dep.depId ? 'left-active' : ''}}" bindtap="toScrollView" data-is-coll="false" data-dep-id="{{dep.depId}}" data-index="{{leftIndex}}">
                <text wx:if="{{dep.isPlatformCustomer === 1}}" class="platform-tag-sm">平台</text>
                <text class="font-sm text-center">{{dep.depAttrName}}</text>
                <view class="font-sm">({{dep.orderCount}})</view>
              </view>
            </block>
          </view>
        </block>

        <view style="height: 200rpx;"></view>
      </scroll-view>

      <!-- 右侧内容区域 -->
      <view class="flex-column">
        <!-- 空状态显示 -->


        <!-- 有数据时显示商品列表 -->
        <block wx:if="{{(viewMode === 'category' && goodsCataArr.length > 0) || (viewMode === 'department' && (depArr.length > 0 || offArr.length > 0))}}">
          <scroll-view scroll-y="true" class=" goods-list" scroll-into-view="{{toView}}" scroll-top="0" bindscroll="scrollTo" bindscrolltolower="onReachBottom" lower-threshold="100" scroll-with-animation style="height:{{contentHeight - viewBarHeight }}rpx; ">
            <!-- 部门模式下的全选按钮 -->
            <view wx:if="{{viewMode === 'department' && goodsArr.length > 0}}" class="flex flex-row-between bg-white border-bottom" style="width: {{windowWidth - leftMenuWidth - 10}}rpx; padding: 20rpx;">
              <view class="flex flex-row" style="align-items: center;">
                <text class="font-md text-primary" wx:if="{{selDepName}}">{{selDepName}}</text>
              </view>
              <view class="flex flex-row plr-20" style="align-items: center;" bindtap="selectAllDepartmentGoods">
                <text class="font-md text-secondary mr-10">全选</text>
                <view class="custom-checkbox {{isAllDepartmentSelected ? 'checked' : ''}}">
                  <text class="checkbox-icon" wx:if="{{isAllDepartmentSelected}}">✓</text>
                </view>
              </view>
            </view>
            <view class=" " wx:for="{{goodsArr}}" wx:key="index" wx:for-index="goodsIndex">

              <!-- 为每个分类的第一个商品添加分类锚点 -->
              <view wx:if="{{goodsIndex === 0 || goodsArr[goodsIndex-1].nxDgDfgGoodsGreatGrandId !== item.nxDgDfgGoodsGreatGrandId}}" id="category{{item.nxDgDfgGoodsGreatGrandId}}" class="goods-category-title category-anchor text-danger font-lg">
              </view>
              <!-- 分隔线只在分类的第一个商品时显示 -->
              <view wx:if="{{goodsIndex === 0 || goodsArr[goodsIndex-1].nxDgDfgGoodsGreatGrandId !== item.nxDgDfgGoodsGreatGrandId}}" class="category-anchor p-10 text-secondary">{{item.nxDgDfgGoodsGreatGrandName}}</view>

              <!-- 部门模式：商品和订单在一行显示 -->
              <block wx:if="{{viewMode === 'department'}}">
                <view wx:for="{{item.nxDepartmentOrdersEntities}}" wx:for-item="order" wx:key="orderIndex" wx:for-index="orderIndex" class="flex flex-row-between border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}" style="width: {{windowWidth - leftMenuWidth - 20}}rpx; padding: 20rpx;" bindtap="choiceStock" data-item="{{item}}" data-goodsindex="{{goodsIndex}}">
                  <!-- 左侧：序号、选择框、商品信息、订单信息 -->
                  <view class="flex flex-row flex-1" >
                    <!-- 序号 -->
                    <text class="font-md mr-10" style="min-width: 40rpx; flex-shrink: 0;">{{goodsIndex + 1}}.</text>
                    <!-- 选择框 -->
                    <view class="flex-column-center mr-10" style="flex-shrink: 0;">
                      <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                        <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                      </view>
                    </view>
                    <!-- 商品信息 -->
                    <view class="flex-row flex-1 mr-15" style="flex-shrink: 1; min-width: 0; flex-wrap: wrap; align-items: flex-start;">
                      <view class="flex-row" style="flex-shrink: 0; white-space: nowrap;">
                        <text class="brand" wx:if="{{item.nxDgGoodsBrand !== 'null' && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                        <text class="font-md font-bold" style="white-space: nowrap;">{{item.nxDgGoodsName}}</text>
                      </view>
                      <text class="font-sm" wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}" style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                      <text class="font-sm" wx:else style="flex-shrink: 1; min-width: 0; word-break: break-all;">({{item.nxDgGoodsStandardname}})</text>
                    </view>
                    <!-- 订单信息（客户名称） -->
                    <view class="flex-row font-sm ml-10" style="flex-shrink: 1; min-width: 0;">
                      <text wx:if="{{order.isPlatformOrder === 1}}" class="platform-tag mr-10">{{order.platformLabel || '平台'}}</text>
                      <block wx:if="{{order.nxDoCollaborativeNxDisId == -1}}">
                        <block wx:if="{{order.nxDoGbDepartmentId !== -1}}">
                          <text wx:if="{{order.fatherGbDepartmentName}}">{{order.fatherGbDepartmentName}}.</text>
                          <text>{{order.gbDepartmentName}}</text>
                        </block>
                        <block wx:elif="{{order.nxDoNxCommRestrauntId !== -1}}">
                          <text>{{order.nxRestrauntAttrName}}</text>
                        </block>
                        <block wx:else>
                          <text wx:if="{{order.nxDoDepartmentFatherId !== order.nxDoDepartmentId}}">{{order.fatherDepartmentAttrName}}.{{order.nxDepartmentOrderCode}}</text>
                          <text wx:else>{{order.nxDepartmentAttrName}}</text>
                        </block>
                      </block>
                      <block wx:else>
                        <text>[{{order.nxDoCollaborativeDistributerName}}]</text>
                      </block>
                    </view>
                  </view>
                  <!-- 右侧：数量和备注 -->
                  <view class="flex flex-column" style="flex-shrink: 0; align-items: flex-end; margin-left: 20rpx; margin-right: 20rpx;">
                    <view class="flex flex-row" style="align-items: center;">
                      <text class="font-lg font-bold">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                      <text wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}" class="red ml-10 font-sm">({{order.nxDoRemark}})</text>
                    </view>
                    <view wx:if="{{order.isPlatformOrder === 1}}" class="flex-row font-sm text-secondary mt-5">
                      <text class="mr-10">期望:{{order._displayExpectPrice}}</text>
                      <text class="mr-10">实际:{{order._displayActualPrice}}</text>
                      <text>差:{{order._displayPriceDiff}}</text>
                    </view>
                  </view>
                </view>
              </block>

              <!-- 类别模式：原有布局 -->
              <block wx:else>
                <view class=" flex-column p-20 border-bottom bg-white {{item.isSelected ? 'bg-mainColor' : ''}}" style="width: {{windowWidth - leftMenuWidth - 20}}rpx; ">
                  <view class="flex flex-row-between" bindtap="choiceStock" data-item="{{item}}" data-goodsindex="{{goodsIndex}}" style="width: {{windowWidth - leftMenuWidth - 40}}rpx;">
                  <view class="flex-row-wrap">
                      <text class="brand" wx:if="{{item.nxDgGoodsBrand !== 'null' && item.nxDgGoodsBrand.length > 0}}">{{item.nxDgGoodsBrand}}</text>
                      <text class=" font-lg font-bold">{{item.nxDgGoodsName}}</text>
                      <text class="" wx:if="{{item.nxDgGoodsStandardWeight !== 'null' && item.nxDgGoodsStandardWeight.length > 0}}">({{item.nxDgGoodsStandardWeight}}/{{item.nxDgGoodsStandardname}})</text>
                      <text class="" wx:else>({{item.nxDgGoodsStandardname}})</text>
                      <text class="text-secondary" wx:if="{{item.nxDgGoodsPlace !== null && item.nxDgGoodsPlace.length > 0}}">{{item.nxDgGoodsPlace}}</text>
                      <text class="text-secondary  text-secondary" wx:if="{{item.nxDgGoodsDetail.length > 0 && item.nxDgGoodsDetail !==  'null'}}">{{item.nxDgGoodsDetail}}</text>
                    </view>
                    <view class="goods-qty-summary font-sm mt-5" wx:if="{{item._hasPlatformQty || item._hasOwnQty}}">
                      <text class="text-secondary">合计{{item._totalQuantity}}{{item.nxDgGoodsStandardname}}</text>
                      <text wx:if="{{item._hasPlatformQty}}" class="platform-tag ml-10">平台 {{item.platformQuantity}}{{item.nxDgGoodsStandardname}}</text>
                      <text wx:if="{{item._hasOwnQty}}" class="text-secondary ml-10">自有 {{item.ownQuantity}}{{item.nxDgGoodsStandardname}}</text>
                    </view>
                    <view class="">
                      <view class="custom-checkbox {{item.isSelected ? 'checked' : ''}}">
                        <text class="checkbox-icon" wx:if="{{item.isSelected}}">✓</text>
                      </view>
                    </view>
                  </view>

                  <view class="flex-column">

                    <view class="flex flex-row font-md p-10 flex-column" wx:for="{{item.nxDepartmentOrdersEntities}}" wx:for-item="order" wx:key="index" wx:for-index="orderIndex" data-orderindex="{{orderIndex}}" data-goodsindex="{{goodsIndex}}" bindtap="choiceOrders" style="width: {{windowWidth - leftMenuWidth -10}}rpx;">
                      <view class="flex-row" style="width: 100%;">
                      <view class="flex-column-center" wx:if="{{item.isSelected}}">
                        <image src="{{!order.purSelected ? '../../../images/checkbox-noselected.png' : '../../../images/selected-2.png'}}" class="icon "></image>
                      </view>

                      <view class="circle_default" wx:else=""></view>

                      <text wx:if="{{order.isPlatformOrder === 1}}" class="platform-tag mr-10">{{order.platformLabel || '平台'}}</text>

                      <block wx:if="{{order.nxDoCollaborativeNxDisId == -1}}">
                         <!-- GB部门（扁平化） -->
                      <block wx:if="{{order.nxDoGbDepartmentId  !== -1}}">
                        <view class="flex-row ">
                          <text wx:if="{{order.fatherGbDepartmentName}}">{{order.fatherGbDepartmentName}}.</text>
                          <text>{{order.gbDepartmentName}}</text>
                        </view>
                      </block>
                      <!-- 餐厅（扁平化） -->
                      <block wx:elif="{{order.nxDoNxCommRestrauntId !== -1}}">
                        <view class="flex-row ">
                          <text>{{order.nxRestrauntAttrName}}</text>
                        </view>
                      </block>
                      <!-- NX部门（扁平化） -->
                      <block wx:else>

                        <view class="flex-row ">
                          <text wx:if="{{order.nxDoDepartmentFatherId  !== order.nxDoDepartmentId}}">{{order.fatherDepartmentAttrName}}.{{order.nxDepartmentOrderCode}}</text>
                          <text class="" wx:else="">{{order.nxDepartmentAttrName}}</text>
                        </view>
                      </block>
                      </block>
                      <block wx:else="">
                        <text class="mr-10">[{{order.nxDoCollaborativeDistributerName}}]</text>
                      </block>
                    
                      <text class="ml-20">{{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                      <text wx:if="{{order.nxDoRemark !== 'null' && order.nxDoRemark.length > 0}}" class="red">({{order.nxDoRemark}})</text>
                      </view>
                      <view wx:if="{{order.isPlatformOrder === 1}}" class="flex-row font-sm text-secondary pl-40">
                        <text class="mr-15">期望:{{order._displayExpectPrice}}</text>
                        <text class="mr-15">实际:{{order._displayActualPrice}}</text>
                        <text>差价:{{order._displayPriceDiff}}</text>
                      </view>
                    </view>
                  </view>

                </view>
              </block>


              <!-- ../here -->
            </view>
            <!-- 加载更多状态 -->
            <view wx:if="{{isLoading}}" class="loading-more">
              <view class="loading-text">正在加载更多...</view>
            </view>

            <!-- 没有更多数据 -->
            <view wx:if="{{!hasMore && goodsArr.length > 0}}" class="no-more">
              <view class="no-more-text">没有更多数据了</view>
            </view>

            <!-- 没有数据 -->
            <view wx:if="{{goodsArr.length === 0}}" class="text-secondary font-sm center-content" style="height: 120rpx;">没有数据啦!</view>

            <!-- 底部提示和空白区域 -->
            <view class="bottom-tip-container">
              <view class="bottom-tip-text">到底部啦！</view>
            </view>

          </scroll-view>

        </block>

      </view>

    </view>

  </view>
</view>





<view class='overlay {{showOperationCarStock ? "show" : ""}}' catchtouchmove='ture' catch:tap="closeStockCar">
  <view class="flex-column orderBottomStock" animation='{{animationData}}'>

    <view class="flex flex-row-between p-30" style="background-color: azure;">
      <text class="text-white1 ">选择了{{choiceStockArr.length}}个商品:</text>
      <view class="flex flex-row">
        <view bindtap="clearAllSelected" class="p-10 mr-20">
          <text>清除</text>
        </view>
        <view bindtap="closeStockCar" class="p-10">
          <text>关闭</text>
        </view>
      </view>
    </view>

    <scroll-view scroll-y="true" style="max-height: {{windowHeight - 520}}rpx; padding-bottom: 100rpx; ">

      <view class="flex-row-wrap p-20">
        <view class="flex-row  goodsBack p-20" style="margin-right: 60rpx;" wx:for="{{choiceStockArr}}" wx:key="index">
          <text class="">{{index+ 1}}.{{item.item.nxDgGoodsName}}</text>
          <image catchtap="deleteSelectStockGoods" data-index="{{index}}" data-id="{{item.item.nxDistributerGoodsId}}" src="../../../images/Delete-2.png" style="width: 50rpx; height: 50rpx; position: absolute; top: -10rpx; right: -30rpx; "></image>

        </view>
      </view>
    </scroll-view>

  </view>
</view>




<view animation="{{buttonAnimation}}" class="flex flex-row bottom-button-container {{choiceStockArr.length > 0 ? 'is-active' : ''}}" style="z-index: 100000;">
  <view class="flex flex-row-between bottom-button">
    <view class="" bindtap="showCarStock" style="width: 120rpx; margin-left: 40rpx;">
      <view class="dotWx">{{choiceStockArr.length}}</view>
      <image class="wx_icon" src="/images/gouwuche.png"></image>
    </view>
    <!-- 有标签打印机缓存时显示正常按钮 -->
    <view wx:if="{{hasLabelPrinter}}" class="stock_order_btn is-active" style="width: 260rpx; margin-right: 30rpx;" bindtap="toPrintSize" data-type="wx">
      打印标签
    </view>
    <!-- 没有标签打印机缓存时显示禁用状态，点击跳转到设置页面 -->
    <view wx:else class="stock_order_btn" style="width: 260rpx; margin-right: 30rpx; opacity: 0.5;" bindtap="toPrinterSet">
      打印标签
    </view>
    <view class="stock_order_btn is-active" style="width: 260rpx; margin-right: 30rpx;" bindtap="toPrint" data-type="wx" wx:if="{{userInfo.nxDiuPrintDeviceId !== '-1'}}">
      打印出库单
    </view>
    <view class="stock_order_btn is-active" style="width: 260rpx; margin-right: 30rpx;" bindtap="savePlanPurchase" data-type="wx">
      去采购
    </view>

  </view>

</view>