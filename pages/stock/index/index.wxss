/* 加载更多相关样式 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #f8f8f8;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.loading-text::before {
  content: '';
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #ddd;
  border-top: 3rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #f8f8f8;
}

.no-more-text {
  font-size: 28rpx;
  color: #999;
}

/* 自定义选择框样式 */
.custom-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 6rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.custom-checkbox.checked {
  background-color: #187e6e;
  border-color: #187e6e;
}

.checkbox-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
}

/* 底部提示区域 */
.bottom-tip-container {
  padding: 40rpx 0;
  padding-bottom: 200rpx; /* 留出足够的空白，避免被底部栏遮挡 */
  display: flex;
  justify-content: center;
  align-items: center;
}

.dep-section-header {
  padding: 10rpx 8rpx 4rpx;
  font-size: 22rpx;
  color: #666;
  background: #eef2f6;
  text-align: center;
