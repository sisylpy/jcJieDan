.bottom-button-container {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 140rpx;
  background-color: #fff;
  
  /* 初始状态下隐藏在底部 */
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: none;
}
.bottom-button-container.is-active{
  display: block;
}



.bottom-button-container-pur {
  position: absolute;
  bottom: 10rpx;
  width: 100%;
  height: 120rpx;
  background-color: rgb(41, 41, 41);
  
  /* 初始状态下隐藏在底部 */
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: none;
}
.bottom-button-container-pur.is-active{
  display: block;
}

