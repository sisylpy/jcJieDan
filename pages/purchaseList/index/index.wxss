.purchase-page {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  overflow: hidden;
  color: #20322e;
  background: #f4f6f5;
}

.voice-purchase-entry {
  flex-direction: column;
  border: 1rpx solid #f2c5c5;
  color: #c84242;
  background: #fff5f5;
}

.voice-purchase-icon {
  width: 31rpx;
  height: 31rpx;
}

.voice-purchase-label {
  margin-top: 3rpx;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.tool-bar {
  position: relative;
  flex-shrink: 0;
  width: 100%;
  height: 100rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.button-container.purchase-app-entry {
  position: absolute;
  z-index: 2;
  top: 10rpx;
  left: 50%;
  margin-left: -40rpx;
  border: 1rpx solid #cde6e0;
  color: #168c78;
  background: #edf8f5;
}

.purchase-app-entry-text {
  display: flex;
  align-items: center;
  flex-direction: column;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.2;
}

.main-scroll {
  width: 100%;
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
}

.main-scroll.has-selection {
  padding-bottom: 118rpx;
}

.purchase-workspace {
  position: relative;
  width: 100%;
  min-height: 0;
  flex: 1;
  overflow: hidden;
}

.category-main {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: row;
  overflow: hidden;
}

.left-menu {
  flex-shrink: 0;
  border-right: 1rpx solid #eee;
  box-sizing: border-box;
  background: #eee;
}

.left-item {
  display: flex;
  min-height: 106rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-bottom: 1rpx solid #dedede;
  color: #263a35;
  background: #eee;
  font-size: 25rpx;
  text-align: center;
}

.left-item.left-active {
  border-left: 6rpx solid #167063;
  color: #167063;
  background: #fff;
  font-weight: 600;
}

.left-category-name {
  max-width: 92rpx;
  line-height: 1.35;
  word-break: break-all;
}

.left-category-count {
  margin-top: 5rpx;
  font-size: 22rpx;
}

.left-menu-space {
  height: 30rpx;
}

.right-content {
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  background: #f5f5f5;
}

.category-header-wrapper {
  padding-top: 22rpx;
}

.category-header-wrapper.first {
  padding-top: 0;
}

.category-header {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  padding: 0 18rpx 0 24rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e2e5e4;
  background: #fff;
}

.category-title {
  color: #66736f;
  font-size: 30rpx;
  font-weight: 600;
}

.category-select-all {
  display: flex;
  min-width: 150rpx;
  min-height: 96rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-end;
  color: #77827f;
  font-size: 29rpx;
  font-weight: 500;
}

.category-select-all .custom-checkbox {
  width: 38rpx;
  height: 38rpx;
  margin-left: 16rpx;
}

.category-select-all.disabled {
  opacity: .45;
}

.purchase-goods-row {
  min-height: 86rpx;
  padding: 14rpx 20rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e5e8e7;
  background: #fff;
}

.purchase-goods-row.selected {
  background: #edf8f5;
}

.purchase-goods-line {
  display: flex;
  min-width: 0;
  align-items: center;
}

.purchase-goods-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  overflow: hidden;
}

.purchase-goods-row .goods-name {
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
  color: #111;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  flex-shrink: 0;
  margin-left: 10rpx;
  color: #5f6b68;
  font-size: 24rpx;
  white-space: nowrap;
}

.source-quantity-group {
  display: flex;
  flex-shrink: 0;
  margin-left: 12rpx;
  align-items: center;
}

.goods-quantity {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: #263a35;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
}

.purchase-edit-trigger {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.purchase-edit-icon {
  width: 25rpx;
  height: 25rpx;
  opacity: .68;
}

.goods-select-area {
  display: flex;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 18rpx 26rpx 18rpx 18rpx;
  align-items: center;
  justify-content: center;
}

.goods-select-area .custom-checkbox {
  width: 36rpx;
  height: 36rpx;
}

.custom-checkbox {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d0d0d0;
  border-radius: 6rpx;
  box-sizing: border-box;
  background: #fff;
}

.custom-checkbox.checked {
  border-color: #187e6e;
  background: #187e6e;
}

.checkbox-icon {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.unavailable-text {
  flex-shrink: 0;
  color: #a0a8a6;
  font-size: 21rpx;
}

.purchase-goods-detail {
  padding: 14rpx 0;
}

.purchase-detail-line {
  color: #4e605b;
  font-size: 23rpx;
  line-height: 1.65;
}

.purchase-detail-line.secondary {
  margin-top: 4rpx;
  color: #89938f;
  font-size: 21rpx;
}

.purchase-goods-actions {
  min-height: 58rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eef0ef;
}

.purchase-edit-mask {
  position: fixed;
  z-index: 100001;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 30rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, .48);
  transition: padding-bottom .15s ease-out;
}

.purchase-edit-modal {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}

.purchase-edit-title {
  padding: 34rpx 36rpx;
  color: #fff;
  background: #168878;
  font-size: 34rpx;
  font-weight: 700;
}

.purchase-edit-body {
  padding: 30rpx 36rpx 12rpx;
}

.purchase-edit-row {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  color: #4f5c57;
  font-size: 28rpx;
}

.purchase-edit-row > text {
  width: 180rpx;
  flex: none;
}

.purchase-edit-row > strong {
  max-width: 120rpx;
  overflow: hidden;
  color: #263a35;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.purchase-edit-row input {
  width: 210rpx;
  height: 68rpx;
  margin-right: 14rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #168878;
  border-radius: 14rpx;
  color: #1e302a;
  background: #f8fbfa;
  font-size: 30rpx;
  text-align: center;
}

.purchase-edit-actions {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 30rpx 34rpx;
}

.purchase-edit-actions button {
  min-width: 0;
  padding: 0;
  margin: 0;
  flex: 1;
  border-radius: 14rpx;
  color: #65716c;
  background: #f2f4f3;
  font-size: 27rpx;
}

.purchase-edit-actions button.confirm {
  color: #087c6d;
  background: #e5f4f0;
  font-weight: 700;
}

.purchase-edit-actions button.delete {
  color: #c8443c;
  background: #fdeceb;
  font-weight: 700;
}

.purchase-edit-actions button::after {
  border: 0;
}

.loading,
.empty {
  display: flex;
  min-height: 600rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #87928f;
  font-size: 27rpx;
}

.empty-icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #aab2b0;
  border-radius: 50%;
  color: #7d8986;
  font-size: 48rpx;
}

.empty-title {
  color: #52615d;
  font-size: 31rpx;
}

.empty-copy {
  margin-top: 14rpx;
  color: #9aa3a1;
  font-size: 24rpx;
}

.goods-list {
  padding: 20rpx;
}

.goods-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(32, 50, 46, .06);
}

.goods-card.selected {
  border-color: #168c78;
  background: #effaf7;
}

.goods-card.self-buy {
  border-left: 6rpx solid #168c78;
}

.card-head,
.goods-foot {
  display: flex;
  align-items: center;
}

.card-head,
.goods-foot {
  justify-content: space-between;
}

.goods-name-wrap {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  flex-wrap: wrap;
}

.source-tag {
  display: inline-block;
  padding: 4rpx 10rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.4;
}

.source-tag.shelf {
  color: #147965;
  background: #e3f5f0;
}

.source-tag.smart {
  color: #9a650e;
  background: #fff2d6;
}

.source-tag.unshelved {
  color: #586864;
  background: #edf2f0;
}

.source-tag.voice {
  color: #b83f37;
  background: #fff0ee;
}

.source-tag.unresolved {
  color: #7b6b57;
  background: #f5f1eb;
}

.goods-name {
  color: #182d28;
  font-size: 31rpx;
  font-weight: 600;
}

.goods-standard {
  margin-left: 8rpx;
  color: #7a8783;
  font-size: 23rpx;
}

.select-circle {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #bfc8c5;
  border-radius: 50%;
  color: #fff;
  background: #fff;
  font-size: 24rpx;
}

.selected .select-circle {
  border-color: #168c78;
  background: #168c78;
}

.goods-meta {
  display: flex;
  padding: 20rpx 0;
  margin-top: 16rpx;
  border-top: 1rpx solid #edf0ef;
  border-bottom: 1rpx solid #edf0ef;
}

.meta-item {
  display: flex;
  width: 50%;
  flex-direction: column;
  color: #30443f;
  font-size: 27rpx;
}

.meta-label {
  margin-bottom: 8rpx;
  color: #8a9693;
  font-size: 22rpx;
}

.goods-foot {
  padding-top: 18rpx;
}

.mode-tag {
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
}

.mode-tag.self {
  color: #147965;
  background: #e7f5f1;
}

.mode-tag.supplier {
  color: #336f9a;
  background: #e8f3fb;
}

.direct-button,
.selection-action {
  padding: 0;
  margin: 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.direct-button::after,
.selection-action::after {
  border: 0;
}

.direct-button {
  width: 190rpx;
  color: #fff;
  background: #168c78;
}

.select-tip {
  color: #8a9693;
  font-size: 23rpx;
}

.selection-bar {
  position: fixed;
  z-index: 100000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 120rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  align-items: center;
  background: #768f8a;
  box-shadow: 0 -5rpx 18rpx rgba(30, 50, 44, .08);
  animation: selection-bar-slide-up .2s ease-out;
}

@keyframes selection-bar-slide-up {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.selection-cart {
  position: relative;
  display: flex;
  width: 92rpx;
  height: 82rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.selection-number {
  position: absolute;
  z-index: 2;
  top: -8rpx;
  right: 0;
  display: flex;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #fff;
  background: #00c967;
  font-size: 22rpx;
}

.selection-cart-icon {
  width: 70rpx;
  height: 70rpx;
}

.selection-copy {
  min-width: 120rpx;
  margin-left: 14rpx;
  flex: 1;
  color: #fff;
  font-size: 25rpx;
}

.selection-action {
  width: 144rpx;
  margin-left: 10rpx;
  color: #fff;
  line-height: 66rpx;
}

.selection-action.wechat {
  width: 150rpx;
  border-radius: 38rpx;
  background: #04c273;
  font-size: 25rpx;
  line-height: 72rpx;
}

.selection-action.stock-in {
  width: 206rpx;
  border-radius: 38rpx;
  background: #168c78;
  font-size: 25rpx;
  line-height: 72rpx;
}

.selection-overlay {
  position: fixed;
  z-index: 99999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, .45);
}

.selection-drawer {
  position: absolute;
  right: 0;
  bottom: 120rpx;
  left: 0;
  max-height: 600rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  background: #ebf2f5;
}

.selection-drawer-head,
.selection-drawer-actions {
  display: flex;
  align-items: center;
}

.selection-drawer-head {
  min-height: 84rpx;
  padding: 14rpx 22rpx;
  box-sizing: border-box;
  justify-content: space-between;
  color: #62716d;
  font-size: 25rpx;
}

.selection-drawer-actions text {
  padding: 12rpx;
  margin-left: 12rpx;
  color: #354a44;
}

.selection-drawer-scroll {
  max-height: 480rpx;
}

.selection-chips {
  display: flex;
  padding: 10rpx 22rpx 40rpx;
  flex-wrap: wrap;
}

.selection-chip {
  position: relative;
  padding: 22rpx 42rpx 22rpx 22rpx;
  margin: 0 28rpx 22rpx 0;
  border-radius: 16rpx;
  color: #354a44;
  background: #fff;
  font-size: 24rpx;
}

.selection-chip-delete {
  position: absolute;
  top: -13rpx;
  right: -13rpx;
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #d65749;
  font-size: 31rpx;
}

.safe-space {
  height: 160rpx;
}

.purchase-workspace.has-selection .safe-space {
  height: 260rpx;
}
