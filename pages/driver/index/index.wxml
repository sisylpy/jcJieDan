<wxs src="../../../utils/fn.wxs" module="fn" />

<view class="flex flex-column">

  <custom-navbar style="height: {{navBarHeight}}rpx; " title="订单" avatar="{{ url + userInfo.nxDiuWxAvartraUrl}}" button-text="设置" bindnavbuttontap="onNavButtonTap"></custom-navbar>

  <view class="content  flex-column" style=" padding-bottom: {{tabBarHeight}}rpx;">
    
    <!-- 调试信息 -->
    <view class="debug-info" style="margin: 20rpx; font-size: 24rpx; opacity: 0.8; text-align: center;" wx:if="{{nxDepArr.length > 0}}">
      <text>客户数量: {{nxDepArr.length}} | 点击"参数"按钮进行智能排单配置</text>
    </view>

    <!-- 智能排单参数配置 -->
    <view class="smart-order-config" wx:if="{{showSmartOrderConfig}}">
      <text class="section-title">⚙️ 智能排单参数配置</text>
      
      <!-- 出发坐标设置 -->
      <view class="location-config-section">
        <text class="config-section-title">📍 出发坐标设置</text>
        <view class="location-info">
          <text class="location-text">当前坐标: {{fromLat || '未设置'}}, {{fromLng || '未设置'}}</text>
          <text class="location-address" wx:if="{{fromAddress}}">地址: {{fromAddress}}</text>
          <view class="location-buttons">
            <button class="location-btn" bindtap="setStartLocation">设置坐标</button>
            <button class="location-btn" bindtap="getCurrentLocation">获取当前位置</button>
          </view>
        </view>
      </view>
      
      <!-- 智能排单参数 -->
      <view class="smart-order-params-section">
        <view class="config-grid">
          <view class="config-item">
            <text class="config-label">司机人数:</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.driverCount}}" bindinput="onDriverCountInput" placeholder="1-5" />
          </view>
          <view class="config-item">
            <text class="config-label">超窗宽容度(分钟):</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.timeWindowTolerance}}" bindinput="onTimeWindowToleranceInput" placeholder="15" />
          </view>
          <view class="config-item">
            <text class="config-label">最大趟数:</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.maxTrips}}" bindinput="onMaxTripsInput" placeholder="1" />
          </view>
          <view class="config-item">
            <text class="config-label">优先级权重:</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.priorityWeight}}" bindinput="onPriorityWeightInput" placeholder="20" />
          </view>
          <view class="config-item">
            <text class="config-label">出发时间(小时):</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.startTime}}" bindinput="onStartTimeInput" placeholder="8" />
          </view>
          <view class="config-item">
            <text class="config-label">最大工作时长(小时):</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.maxWorkHours}}" bindinput="onMaxWorkHoursInput" placeholder="8" />
          </view>
          <view class="config-item">
            <text class="config-label">客户服务时间(分钟):</text>
            <input class="config-input" type="number" value="{{smartOrderConfig.customerServiceTime}}" bindinput="onCustomerServiceTimeInput" placeholder="30" />
          </view>
        </view>
      </view>
      
      <view class="config-actions">
        <button class="config-btn cancel-btn" bindtap="hideSmartOrderConfig">取消</button>
        <button class="config-btn confirm-btn" bindtap="applySmartOrderConfig">应用配置</button>
      </view>
    </view>

    <!-- 已废弃：多司机路线优化区域（现在使用智能排单结果） -->
    <!--
