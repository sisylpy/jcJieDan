            </view>
          </view>
        </view>
      </view>

      <view class="route-recommendations" wx:if="{{multiDriverResult.report.recommendations.length > 0}}">
        <text class="recommendations-title">💡 优化建议</text>
        <view class="recommendation-item" wx:for="{{multiDriverResult.report.recommendations}}" wx:key="index">
          <text class="recommendation-text">{{item}}</text>
        </view>
      </view>
    </view>
  

    <!-- 智能排单结果显示区域 -->
    <view class="route-optimization-section" wx:if="{{smartOrderResult && smartOrderResult.drivers}}">
      <view class="debug-info" style="color: white; font-size: 24rpx; margin-bottom: 20rpx;">
        调试: smartOrderResult存在，司机数: {{smartOrderResult.drivers.length}}
      </view>
      <view class="route-header">
        <text class="route-title">🤖 智能排单结果</text>
        <view class="route-summary">
          <text class="summary-item">总客户: {{smartOrderResult.report.summary.totalCustomers}}</text>
          <text class="summary-item">已分配: {{smartOrderResult.report.summary.allocatedCustomers}}</text>
          <text class="summary-item">总距离: {{parseFloat(smartOrderResult.report.summary.totalDistance || 0).toFixed(1)}}km</text>
        </view>
      </view>
      
      <view class="drivers-container">
        <view class="driver-card" wx:for="{{smartOrderResult.drivers}}" wx:key="driverId" wx:if="{{item.route.length > 0}}">
          <view class="driver-header">
            <text class="driver-name">{{item.driverName}}</text>
            <view class="driver-stats">
              <text class="stat-item">{{item.route.length}}个客户</text>
              <text class="stat-item">{{parseFloat(item.totalDistance || 0).toFixed(1)}}km</text>
              <text class="stat-item">{{item.totalDuration}}分钟</text>
            </view>
          </view>
          
          <view class="driver-timeline">
            <text class="timeline-text">出发: {{item.startTime}}</text>
            <text class="timeline-text">结束: {{item.endTime}}</text>
          </view>
          
                      <view class="route-stops">
            <view class="stop-item" wx:for="{{item.route}}" wx:key="index" wx:for-item="stop">
              <view class="stop-header">
                <text class="stop-number">{{index + 1}}</text>
                <text class="stop-name">{{stop.name}}</text>
                <text class="stop-time">到达时间：{{stop.arrivalTimeStr || '--:--'}}</text>
              </view>
              <view class="stop-details">
                <text class="stop-address">{{stop.address || '地址未设置'}}</text>
                <text class="stop-window">{{stop.earliestTimeStr || '--:--'}} - {{stop.latestTimeStr || '--:--'}}</text>
                <text class="stop-distance">{{stop.distanceKm}}km / {{stop.durationMinutes}}分钟</text>
                <text class="stop-unload">卸货时间: {{stop.unloadMinutes}}分钟</text>
                <text class="stop-time-details">出发: {{stop.departureTimeStr}} → 到达: {{stop.arrivalTimeStr}} → 卸货: {{stop.serviceStartStr}} → 离开: {{stop.departureFromCustomerStr}}</text>
                <text class="stop-score" wx:if="{{stop.scoreStr}}">评分: {{stop.scoreStr}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 未分配客户区域 -->
      <view class="unallocated-section" wx:if="{{smartOrderResult.unassignedCustomers && smartOrderResult.unassignedCustomers.length > 0}}">
        <text class="unallocated-title">❌ 未分配客户 ({{smartOrderResult.unassignedCustomers.length}}个)</text>
        <view class="unallocated-customer" wx:for="{{smartOrderResult.unassignedCustomers}}" wx:key="index">
          <view class="customer-header">
            <text class="customer-name">{{item.name}}</text>
            <text class="customer-address">{{item.address || '地址未设置'}}</text>
            <text class="customer-unload">卸货时间: {{item.unloadDuration || 30}}分钟</text>
          </view>
          <view class="failure-reasons" wx:if="{{item.failureReasons}}">
            <text class="reason-title">无法分配原因:</text>
            <view class="reason-item" wx:for="{{item.failureReasons}}" wx:key="reasonIndex" wx:for-item="reason">
              <text class="reason-text">{{reason}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="route-recommendations" wx:if="{{smartOrderResult.report.recommendations.length > 0}}">
        <text class="recommendations-title">💡 优化建议</text>
        <view class="recommendation-item" wx:for="{{smartOrderResult.report.recommendations}}" wx:key="index">
          <text class="recommendation-text">{{item}}</text>
        </view>
      </view>
    </view>
   
  </view>



