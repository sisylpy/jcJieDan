      <!-- 未分配客户区域 -->
      <view class="unallocated-section" wx:if="{{multiDriverResult.unallocatedCustomers && multiDriverResult.unallocatedCustomers.length > 0}}">
        <text class="unallocated-title">❌ 未分配客户 ({{multiDriverResult.unallocatedCustomers.length}}个)</text>
        <view class="unallocated-customer" wx:for="{{multiDriverResult.unallocatedCustomers}}" wx:key="index">
          <view class="customer-header">
            <text class="customer-name">{{item.name}}</text>
            <text class="customer-address">{{item.address || '地址未设置'}}</text>
            <text class="customer-unload">卸货时间: {{item.unloadDuration || 30}}分钟</text>
          </view>
          <view class="failure-reasons">
            <text class="reason-title">无法分配原因:</text>
            <view class="reason-item" wx:for="{{item.failureReasons}}" wx:key="reasonIndex" wx:for-item="reason">
