<view class="flex flex-column">
  <custom-navbar style="height: {{navBarHeight}}rpx;" title="配送" avatar="/images/icons/icon_prepare.png"></custom-navbar>

  <view class="flex-row navbar" style="height: {{viewBarHeight}}rpx;">
    <block wx:for="{{tabs}}" wx:key="name">
      <view id="{{index}}" class="half-row text-center navbar-item-sub {{innerCurrent == index ? 'bar-item-sub-on' : ''}}" data-current="{{index}}" bindtap="onTabClick" hover-class="hover">
        <view class="navbar-title-sub" style="line-height: {{viewBarHeight}}rpx;">{{item.name}}</view>
      </view>
    </block>
  </view>

  <swiper class="dispatch-swiper" style="height: {{contentHeight}}rpx;" current="{{innerCurrent}}" bindchange="onSwiperChange">
    <swiper-item class="dispatch-swiper-item">
      <boss-tab-sandbox class="dispatch-panel" active="{{tabActive[0]}}" load-key="{{panelLoadKey}}"></boss-tab-sandbox>
    </swiper-item>
    <swiper-item class="dispatch-swiper-item">
      <boss-tab-my-loading class="dispatch-panel" active="{{tabActive[1]}}" load-key="{{panelLoadKey}}"></boss-tab-my-loading>
    </swiper-item>
    <swiper-item class="dispatch-swiper-item">
      <boss-tab-my-delivery class="dispatch-panel" active="{{tabActive[2]}}" load-key="{{panelLoadKey}}"></boss-tab-my-delivery>
    </swiper-item>
  </swiper>
</view>
