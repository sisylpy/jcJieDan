<wxs src="../../../utils/fn.wxs" module="tool" />


<view class="flex flex-column">

<back-navbar style="height: {{navBarHeight}}rpx;" title="{{name}}-价格" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>



   <!-- 单部门 -->
    <view wx:if="{{depHasSubs  == 0}}">
     
      <view class="flex-column section_body bg-white" >
        <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV{{focusIndex}}" scroll-with-animation="true">
          <!-- single bumen -->
          <view class="flex-column border-bottom p-20 bg-white" wx:for="{{applyArr}}" wx:key="nxDepartmentOrdersId" wx:for-index="index" data-id="{{item.nxDepartmentOrdersId}}"  id="NAV{{index}}">
                <view class="flex-row">
                  <text class="">{{index + 1}}.</text>
                  <view class="flex-row-wrap font-lg font-bold" bindtap="toGoodsDetail" data-item="{{item.nxDistributerGoodsEntity}}" >
                    <text class="brand" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                    <text class="margin-l-right">{{item.nxDistributerGoodsEntity.nxDgGoodsName}}</text>
                    <block wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                      <text class="" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}})</text>
                    </block>
                    <block wx:else>
                      <text class="">({{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                    </block>

                    <text class=" mr-10 gray" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && item.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">{{item.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                    <text class=" gray" wx:if="{{item.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && item.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{item.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>

                  </view>
                </view>
                <view class="flex-row">
                  <text class="text-white">{{index + 1}}.</text>
                  <view class="flex-column" >
                      <view class="flex-row-between small" style="width: {{windowWidth / 3 * 2 }}rpx; ">
                        <view class="flex-row half-row">
                          <text class=" mr-10 flex-fixed ">订货:</text>
                           <view class="flex-column">
                            <text class="">{{item.nxDoQuantity}}{{item.nxDoStandard}}</text>
                        
                           </view>  
                        </view>
                        <view class="flex-row half-row">
                          <text class=" mr-10 flex-fixed ">出货:</text>
                          <view class="flex-row" wx:if="{{item.nxDoWeight !== null}}">
                            <text class="">{{item.nxDoWeight}}</text>
                            <text class="">{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                          </view>
                        </view>
                      </view>
                      <view class="flex-row">
                        <text class="red " wx:if="{{item.nxDoRemark.length > 0}}">({{item.nxDoRemark}})</text> 
                      </view>

                      <block wx:if="{{disInfo.nxDistributerBusinessTypeId  == 6}}">
                        <view class="flex-row">
                        <view class="flex-row half-row">
                         <text class="margin-l-right">利润:</text>
                         <text >{{item.nxDoProfitSubtotal == null ? '0': item.nxDoProfitSubtotal}}元</text>
                       </view>
                      <view class="flex-row half-row">
                         <text class="margin-l-right">利润率:</text>
                         <text >{{item.nxDoProfitScale == null ? '0': item.nxDoProfitScale}}%</text>
                       </view>
                     
                     </view>
                      <view class="flex-row" wx:if="{{item.nxDoCostPrice !== null}}" style="width: {{windowWidth / 3 * 2 }}rpx;">
                        <view class="flex-row half-row">
                          <text class="margin-l-right">进货:</text>
                          <text class="margin-l-right">{{tool.transferDateString(item.nxDoCostPriceUpdate)}}</text>
                        </view>
                        <view class="flex-row half-row">
                          <text class="margin-l-right">进价:</text>
                          <text>{{item.nxDoCostPrice}}</text>
                          <text class="mr-10">元/{{item.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                        </view>
                      </view> 
                      </block>
                     
                  </view>
                  <view class="flex-row">
                   
                    <view class="flex-row ">
                      <view class=" weightInput mr-10 flex-row {{index == focusIndex ? 'is-active' : ''}}" catchtap="toInputOrder"  hover-class="hover"  data-index="{{index}}" data-id="{{item.gbDepartmentOrdersEntity.gbDoPurchaseGoodsId}}"  style="width: {{item.nxDepartmentDisGoodsEntity !== null &&  item.nxDoPrice == null ? windowWidth / 3 - 200 : windowWidth / 3 - 140}}rpx;">
                        <text class="input_number" wx:if="{{item.nxDoPrice !== null && item.nxDoPrice !== '-1'}}">{{item.nxDoPrice}}</text>
                        <!-- <view class='analog_cursor {{index == focusIndex && parentIndex == focusParentIndex ? "is-active" : "" }}'></view> -->
                      </view>
                      
                    </view>
                    <view class=" flex-row margin_l_bottom" wx:if="{{item.nxDepartmentDisGoodsEntity !== null &&  item.nxDoPrice == null}}">
                        <text class="quickBtn" bindtap="quickPrice" data-index="{{index}}"> {{item.nxDepartmentDisGoodsEntity.nxDdgOrderPrice}}</text>
                      </view>
                     
                  </view>

                </view>

          </view>
          <!-- ./single bumen -->
                    <view class="bottom_place"></view>

          </scroll-view>
       
      </view>

    </view>

    <!-- 多部门 -->

    <view class="flex-column" wx:if="{{depHasSubs  > 0}}">
    
      <view class=" "  >
        <scroll-view class="tui-city-scroll-y" scroll-y="true" scroll-into-view="NAV_{{focusParentIndex}}_{{focusIndex}}" scroll-with-animation="true" >

          <view class="pt-10 flex-column" wx:for="{{depArr}}" wx:for-index="parentIndex" wx:for-item="dep" wx:key="depId" wx:for-index="parentIndex" style="background-color: aliceblue; width: {{windowWidth}}rpx;"> 
            <view class="p-20">#{{dep.depName}}</view>
            <view class="flex-row border-bottom bg-white p-20" wx:for="{{dep.depOrders}}" wx:for-item="order" id="NAV_{{parentIndex}}_{{index}}" data-id="{{order.nxDepartmentOrdersId}}">

              <view class="flex-column ">
                <view class="flex-row ">
                  <text class="">{{index + 1}}.</text>
                  <view class="flex-row-wrap">
                    <text class="brand" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsBrand !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsBrand.length > 0}}">{{order.nxDistributerGoodsEntity.nxDgGoodsBrand}}</text>
                    <text class="">{{order.nxDistributerGoodsEntity.nxDgGoodsName}} </text>
                    <block wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight.length > 0}}">
                      <text class="mr-10" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname !== '斤'}}">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}}/{{order.nxDistributerGoodsEntity.nxDgGoodsStandardWeight}})</text>
                    </block>
                    <block wx:else>
                      <text class="">({{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}})</text>
                    </block>

                    <text class="" wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsPlace !== 'null' && order.nxDistributerGoodsEntity.nxDgGoodsPlace.length > 0}}">产地:{{order.nxDistributerGoodsEntity.nxDgGoodsPlace}}</text>

                    <text class=" " wx:if="{{order.nxDistributerGoodsEntity.nxDgGoodsDetail.length > 0 && order.nxDistributerGoodsEntity.nxDgGoodsDetail !==  'null'}}">{{order.nxDistributerGoodsEntity.nxDgGoodsDetail}}</text>
                  </view>
                </view>

                <view class="flex-row">
                  <text class="text-white">{{index + 1}}.</text>
                  <view class="flex-column" style="width: {{windowWidth / 3 * 2 }}rpx;">
                    <view class="flex-row-wrap" >
                      <text class="flex-fixed">今日订货: {{order.nxDoQuantity}}{{order.nxDoStandard}}</text>
                      <text class="red " wx:if="{{order.nxDoRemark.length > 0}}">({{order.nxDoRemark}})</text>
                    </view>
                    <view class="" wx:if="{{order.gbDepartmentOrdersEntity.gbDepartmentDisGoodsEntity !== null }}">
                      <text>上次价格:</text>
                      <text>{{order.nxDepartmentDisGoodsEntity.nxDdgOrderPrice}}/{{order.nxDistributerGoodsEntity.nxDgGoodsStandardname}}</text>
                    </view>
                  </view>
                </view>
              </view>
          
                <view class="weightInput mr-10 flex-row" catchtap="toInputOrderDep"  hover-class="hover" data-fatherindex="{{parentIndex}}"  data-index="{{index}}" data-id="{{order.gbDepartmentOrdersEntity.gbDoPurchaseGoodsId}}"  style="width: {{order.nxDepartmentDisGoodsEntity !== null &&  order.nxDoPrice == null ? windowWidth / 3 - 200 : windowWidth / 3 - 140}}rpx; ">
                  <text class="input_number" wx:if="{{order.nxDoPrice !== null && order.nxDoPrice !== '-1'}}">{{order.nxDoPrice}}</text>
                  <view class='analog_cursor {{index == focusIndex && parentIndex == focusParentIndex ? "is-active" : "" }}'></view>
                </view>
            
            </view>
          </view>

          <view class="bottom_place"></view>

        </scroll-view>
      </view>

    </view>

</view>



<inputPurGoodsGb show="{{show}}" bindconfirm="confirm" bindcancle="cancle" bindfinish="markGbPurGoodsFinish" item="{{item}}" maskHeight="{{maskHeight > windowHeight ? maskHeight : windowHeight}}" scrollViewTop="{{scrollViewTop}}" scaleInput="{{scaleInput}}" windowHeight="{{windowHeight}}" windowWidth="{{windowWidth}}" />

