/* 待解析任务：横向滚动卡片 */
.task-scroll-wrap {
  flex-shrink: 0;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 16rpx 0;
}
.task-scroll-view {
  white-space: nowrap;
  width: 100%;
}
.task-scroll-inner {
  display: inline-flex;
  flex-direction: row;
  padding: 0 20rpx;
  gap: 20rpx;
}
.task-card {
  flex-shrink: 0;
  width: 200rpx;
  height: 170rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}
.task-card-hover {
  background: #eef1f4;
}
.task-card-loading {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}
.task-loading-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 8rpx;
}
.task-dep-name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.task-status-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.task-card-body {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 12rpx;
}
.task-thumb {
  width: 100%;
  height: 80rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.task-file-icon {
  width: 56rpx;
  height: 56rpx;
  background: #e8ecf0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-bottom: 8rpx;
}
.task-icon-img {
  width: 32rpx;
  height: 32rpx;
}
.task-info {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.task-type-tag {
  font-size: 20rpx;
  color: #8b9dc3;
  margin-bottom: 4rpx;
}
.task-file-name {
  font-size: 32rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
  background-color: #FFF;
}

.task-stats {
  font-size: 22rpx;
  /* color: #262626; */
  margin-bottom: 20rpx;
}

.page-root {
  height: 100vh;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.scroll-content {
  flex: 1;
  min-height: 0;
}

.customer-section-header {
  padding: 16rpx 20rpx 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f4f8;
  font-weight: 600;
}

.platform-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #fff;
  background: #187e6e;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.sales-return-section-header {
  padding: 18rpx 20rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff4ea;
  border-top: 1rpx solid #f5dfcc;
  border-bottom: 1rpx solid #f5dfcc;
}

.sales-return-section-title {
  display: flex;
  align-items: center;
  color: #8f481d;
  font-size: 28rpx;
  font-weight: 600;
}

.sales-return-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  color: #fff;
  background: #d66b2c;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.sales-return-section-tip {
  color: #9c765e;
  font-size: 22rpx;
}

.sales-return-card {
  margin: 14rpx 20rpx;
  padding: 18rpx 20rpx 14rpx;
  background: #fff;
  border: 1rpx solid #ecd9ca;
  border-left: 7rpx solid #d66b2c;
  border-radius: 12rpx;
  box-shadow: 0 3rpx 12rpx rgba(102, 57, 26, 0.06);
}

.sales-return-card-hover {
  background: #fffaf6;
}

.sales-return-card-head,
.sales-return-customer-line,
.sales-return-no-line,
.sales-return-goods,
.sales-return-meta,
.sales-return-action-line {
  display: flex;
  align-items: center;
}

.sales-return-card-head,
.sales-return-no-line,
.sales-return-goods,
.sales-return-meta,
.sales-return-action-line {
  justify-content: space-between;
}

.sales-return-customer-line {
  min-width: 0;
  flex: 1;
}

.sales-return-index {
  margin-right: 4rpx;
  color: #9a9a9a;
  font-size: 28rpx;
}

.sales-return-customer {
  max-width: 330rpx;
  overflow: hidden;
  color: #2f2f2f;
  font-size: 31rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sales-return-tag {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  color: #b64f21;
  background: #fff0e4;
  border: 1rpx solid #efc9ad;
  border-radius: 6rpx;
  font-size: 21rpx;
}

.sales-return-status {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tone-pending {
  color: #a54b1c;
  background: #fff0e4;
}

.status-tone-assigned,
.status-tone-transit {
  color: #176a60;
  background: #e6f5f2;
}

.status-tone-financial,
.status-tone-confirm {
  color: #7a5a12;
  background: #fff7d8;
}

.status-tone-received,
.status-tone-processing {
  color: #52606d;
  background: #eef2f5;
}

.sales-return-no-line {
  margin-top: 8rpx;
  color: #929292;
  font-size: 21rpx;
}

.sales-return-goods {
  margin-top: 13rpx;
  padding: 10rpx 12rpx;
  color: #4a4a4a;
  background: #faf7f4;
  border-radius: 6rpx;
  font-size: 25rpx;
}

.sales-return-goods-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sales-return-quantity {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #b64f21;
  font-weight: 600;
}

.sales-return-meta {
  margin-top: 14rpx;
  color: #333;
  font-size: 24rpx;
}

.sales-return-meta-item {
  display: flex;
  align-items: center;
}

.sales-return-meta-label {
  margin-right: 10rpx;
  color: #888;
}

.sales-return-money {
  color: #b64f21;
  font-weight: 600;
}

.sales-return-action-line {
  margin-top: 13rpx;
  padding-top: 12rpx;
  color: #7b6a60;
  border-top: 1rpx solid #f0e7e0;
  font-size: 22rpx;
}

.sales-return-arrow {
  width: 28rpx;
  height: 28rpx;
}
