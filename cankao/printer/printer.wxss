.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 状态区域 */
.status-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.status-info {
  margin-bottom: 30rpx;
}

.status-text {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 28rpx;
  opacity: 0.9;
  word-break: break-all;
}

/* 按钮样式 */
.btn {
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary {
  background-color: #167063;
  color: #fff;
}

.btn-secondary {
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

/* 设备列表区域 */
.device-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 设备列表 */
.device-list {
  max-height: 60vh;
  overflow-y: auto;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
  border: 2rpx solid #e0e0e0;
}

.device-item:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

.device-info {
  flex: 1;
  margin-right: 20rpx;
}

.device-name-item {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.device-id {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
}

.connect-btn {
  padding: 15rpx 30rpx;
  background-color: #167063;
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
