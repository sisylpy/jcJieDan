/* 切换按钮样式 */
.switch-container {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 6rpx;
  display: flex;
  width: 320rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 34rpx;
  font-size: 28rpx;
  color: #1a1a1a; /* 更深的黑色，从 #666 改为 #1a1a1a */
  transition: all 0.3s;
  position: relative;
  font-weight: 500;
}

.switch-item.active {
  /* background: #167063; */
  color: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22, 112, 99, 0.3);
}

.switch-item text {
  display: block;
}

/* 按钮容器激活状态 */
.button-container.active {
  background: #167063;
  box-shadow: 0 2rpx 8rpx rgba(22, 112, 99, 0.3);
}

.button-container .icon {
  width: 40rpx;
  height: 40rpx;
}


