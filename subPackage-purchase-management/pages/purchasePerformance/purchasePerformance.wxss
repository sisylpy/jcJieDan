.page{height:100vh;background:#f4f7f6;color:#163d35}
.body{height:100%;box-sizing:border-box}
.main-tabs{position:fixed;left:0;right:0;z-index:30;height:90rpx;display:flex;background:#fff;border-bottom:1rpx solid #dfe8e5}
.main-tab{flex:1;text-align:center;line-height:86rpx;color:#687a76;font-size:28rpx}
.main-tab.on{color:#118c76;font-weight:700;border-bottom:5rpx solid #118c76}
.intro,.filter-card,.source-card,.section{margin:18rpx 20rpx;background:#fff;border:1rpx solid #e2eae8}
.intro{padding:22rpx;border-left:6rpx solid #15977f;line-height:1.65;color:#647a75;font-size:24rpx}
.intro-title{display:block;color:#143f36;font-weight:700;font-size:29rpx}
.section{padding:20rpx}
.section-title-row,.card-head,.source-head,.stock-head,.panel-head,.summary-line,.stock-quantities,.result-line,.dates{display:flex;justify-content:space-between;align-items:flex-start}
.section-title{display:block;font-weight:700;font-size:30rpx}
.section-note{display:block;margin-top:6rpx;color:#71817e;font-size:22rpx}
.section-count{min-width:44rpx;height:44rpx;line-height:44rpx;text-align:center;color:#fff;background:#15977f;border-radius:4rpx}
.section-count.waiting{background:#81918e}
.section-count.blocked{background:#c25f3d}
.section-count.history{background:#8b8b8b}
.pending-card{padding:22rpx 0;border-top:1rpx solid #e9efed}
.pending-card:first-of-type{margin-top:16rpx}
.subject-block{max-width:72%}
.subject,.event-title{display:block;font-weight:700;color:#183e36}
.subject{font-size:29rpx}
.event-title{margin-top:18rpx;font-size:26rpx}
.meta,.stock-meta,.source-meta{display:block;color:#84928f;font-size:21rpx;margin-top:5rpx}
.status{padding:5rpx 10rpx;font-size:21rpx;color:#875200;background:#fff1d2}
.status.BLOCKED{color:#a83e2b;background:#fde9e4}
.status.WAITING,.status.READ_ONLY{color:#586b67;background:#edf2f1}
.fact-line{display:flex;margin-top:14rpx;font-size:23rpx;line-height:1.55}
.fact-label{width:128rpx;flex:none;color:#758682}
.fact-value{color:#344f49}
.responsibility{margin-top:14rpx;padding:12rpx 14rpx;background:#f3f8f6;font-size:23rpx}
.actions{display:flex;justify-content:flex-end;margin-top:16rpx}
.primary-button,.text-button{margin:0 0 0 16rpx;padding:0 24rpx;height:64rpx;line-height:64rpx;border-radius:4rpx;font-size:24rpx}
.primary-button{background:#15977f;color:#fff}
.text-button{background:#eef7f5;color:#118c76}
.no-action{display:block;margin-top:14rpx;color:#8a7770;font-size:21rpx}
.state{margin:30rpx 20rpx;padding:80rpx 24rpx;text-align:center;color:#788985;background:#fff}
.error-state{color:#b44b38}
.retry{display:block;margin-top:18rpx;color:#118c76}
.success-state{color:#168a73}
.filter-card{padding:22rpx}
.filter-title{font-size:28rpx;font-weight:700}
.dimension-tabs{display:flex;margin:18rpx 0}
.dimension-tab{flex:1;padding:16rpx 0;text-align:center;background:#f1f5f4;color:#5d716d}
.dimension-tab.on{background:#15977f;color:#fff}
.filter-label{display:block;margin-top:6rpx;color:#637773;font-size:22rpx}
.dates{align-items:center;margin-top:10rpx}
.dates picker{padding:14rpx 20rpx;background:#f5f8f7}
.time-note,.basis-note{display:block;margin-top:15rpx;color:#7c6961;font-size:21rpx;line-height:1.5}
.coverage-note{margin:18rpx 20rpx;padding:16rpx;background:#fff4df;color:#96610b;font-size:22rpx}
.source-card{padding:22rpx}
.source-name{display:block;font-size:29rpx;font-weight:700}
.attention{color:#bd4f34;font-size:22rpx}
.summary-line{margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid #edf1f0;font-size:22rpx}
.unit-block{margin-top:18rpx;padding:15rpx;background:#f3f8f6;font-size:22rpx;color:#405a54}
.unit-block text{display:block;margin-top:5rpx}
.unit-title{font-weight:700;color:#146f60}
.stock-card{margin-top:18rpx;padding:18rpx;border:1rpx solid #dbe7e3;background:#fff}
.goods-name{display:block;font-size:27rpx;font-weight:700}
.stock-status{color:#118c76;font-size:21rpx}
.stock-quantities{margin-top:13rpx;color:#304f48;font-size:23rpx}
.stock-source{display:block;margin-top:14rpx;color:#788985;font-size:20rpx}
.issue{display:inline-block;margin:12rpx 10rpx 0 0;padding:6rpx 10rpx;background:#fdeee8;color:#a74b35;font-size:20rpx}
.result-line{margin-top:14rpx;padding-top:12rpx;border-top:1rpx solid #edf1f0;font-size:22rpx}
.detail-link{color:#118c76}
.mask{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.46);display:flex;align-items:flex-end}
.assignment-panel{width:100%;max-height:72vh;padding:25rpx;background:#fff;box-sizing:border-box}
.panel-title{display:block;font-size:31rpx;font-weight:700}
.panel-note{display:block;margin-top:6rpx;color:#6d807c;font-size:22rpx}
.panel-close{color:#118c76}
.panel-explain{display:block;margin:20rpx 0;padding:16rpx;background:#eef7f5;color:#48645e;font-size:22rpx;line-height:1.55}
.purchaser-list{max-height:48vh}
.purchaser-row{display:flex;justify-content:space-between;align-items:center;padding:22rpx 4rpx;border-top:1rpx solid #e8eeec;color:#118c76}
.purchaser-name{display:block;color:#173f36;font-size:27rpx}
.purchaser-status{display:block;margin-top:5rpx;color:#7d8c89;font-size:21rpx}
.bottom-space{height:40rpx}
