.page{height:100vh;background:#f4f7f6;color:#163d35}.body{height:100%;box-sizing:border-box}.filter-card,.source-card{margin:18rpx 20rpx;background:#fff;border:1rpx solid #e2eae8}.filter-card{padding:20rpx}.filter-label{display:block;margin-top:18rpx;color:#637773;font-size:22rpx}.dimension-tabs{display:flex;margin-top:10rpx}.dimension-tab{flex:1;padding:16rpx 0;text-align:center;background:#f1f5f4;color:#5d716d}.dimension-tab.on{background:#15977f;color:#fff}.time-note,.basis-note{display:block;margin-top:15rpx;color:#7c6961;font-size:21rpx;line-height:1.5}.state{margin:30rpx 20rpx;padding:80rpx 24rpx;text-align:center;color:#788985;background:#fff}.error-state{color:#b44b38}.retry{display:block;margin-top:18rpx;color:#118c76}.coverage-note{margin:18rpx 20rpx;padding:16rpx;background:#fff4df;color:#96610b;font-size:22rpx}.source-card{padding:22rpx}.source-head,.stock-head,.summary-line,.stock-quantities,.result-line{display:flex;justify-content:space-between;align-items:flex-start}.source-name{display:block;font-size:29rpx;font-weight:700}.source-meta,.stock-meta{display:block;color:#84928f;font-size:21rpx;margin-top:5rpx}.attention{color:#bd4f34;font-size:22rpx}.summary-line{margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid #edf1f0;font-size:22rpx}.unit-block{margin-top:18rpx;padding:15rpx;background:#f3f8f6;font-size:22rpx;color:#405a54}.unit-block text{display:block;margin-top:5rpx}.unit-title{font-weight:700;color:#146f60}.stock-card{margin-top:18rpx;padding:18rpx;border:1rpx solid #dbe7e3;background:#fff}.goods-name{display:block;font-size:27rpx;font-weight:700}.stock-status{color:#118c76;font-size:21rpx}.stock-quantities{margin-top:13rpx;color:#304f48;font-size:23rpx}.stock-source{display:block;margin-top:14rpx;color:#788985;font-size:20rpx}.issue{display:inline-block;margin:12rpx 10rpx 0 0;padding:6rpx 10rpx;background:#fdeee8;color:#a74b35;font-size:20rpx}.result-line{margin-top:14rpx;padding-top:12rpx;border-top:1rpx solid #edf1f0;font-size:22rpx}.detail-link{color:#118c76}.bottom-space{height:40rpx}
