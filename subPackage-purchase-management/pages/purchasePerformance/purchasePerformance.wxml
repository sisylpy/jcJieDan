<view class="page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="库存经营" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="body" style="padding-top:{{navBarHeight}}rpx">
    <view class="filter-card">
      <report-date-filter label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>
      <text class="filter-label">来源归属</text>
      <view class="dimension-tabs"><text class="dimension-tab {{dimension==='PURCHASER'?'on':''}}" data-value="PURCHASER" bindtap="changeDimension">按采购员</text><text class="dimension-tab {{dimension==='SUPPLIER'?'on':''}}" data-value="SUPPLIER" bindtap="changeDimension">按供应方</text></view>
      <text class="time-note">{{timeBasisText||'按入库日期筛选库存批次；批次内经营事实显示截至当前的累计结果'}}</text>
    </view>

    <view wx:if="{{error}}" class="state error-state"><text>{{error}}</text><text class="retry" bindtap="retry">重新加载</text></view>
    <view wx:elif="{{loading}}" class="state">正在读取库存批次…</view>
    <view wx:elif="{{!groups.length}}" class="state">所选入库日期范围没有可核实的库存批次</view>
    <block wx:else>
      <view class="coverage-note" wx:if="{{excludedCount}}">另有 {{excludedCount}} 条记录因不属于库房库存或来源未解析而未纳入；未按0计算。</view>
      <view class="source-card" wx:for="{{groups}}" wx:key="id">
        <view class="source-head"><view><text class="source-name">{{item.name}}</text><text class="source-meta">{{item.stockBatchCount}} 个库存批次 · 经营中 {{item.operatingStockBatchCount}} · 完结 {{item.completedStockBatchCount}}</text></view><text wx:if="{{item.attentionCount}}" class="attention">{{item.attentionCount}} 项注意</text></view>
        <view class="summary-line"><text>入库成本 {{item.grossPurchaseCostText}}</text><text>当前经营结果 {{item.currentRealizedMarginText}}</text></view>
        <view class="summary-line"><text>损耗成本 {{item.lossCostText}}（{{item.lossCostRateText}}）</text><text>废弃成本 {{item.discardCostText}}（{{item.discardCostRateText}}）</text></view>
        <text class="basis-note" wx:if="{{item.costBasisUnknownCount}}">{{item.costBasisUnknownCount}} 个批次成本依据不足，来源合计和损耗成本率未强行补0。</text>

        <view class="unit-block" wx:for="{{item.unitSummaries}}" wx:key="uom" wx:for-item="unit"><text class="unit-title">{{unit.uom}}口径</text><text>入库 {{unit.stockInText}} · 剩余 {{unit.remainingText}}</text><text>损耗 {{unit.lossText}} · 废弃 {{unit.discardText}}</text><text wx:if="{{unit.basisStatus==='PARTIAL'}}" class="basis-note">同单位仍有数量依据缺失，未合计为0。</text></view>

        <view class="stock-card" wx:for="{{item.stockBatches}}" wx:key="stockBatchId" wx:for-item="batch" data-id="{{batch.stockBatchId}}" bindtap="openBatch">
          <view class="stock-head"><view><text class="goods-name">{{batch.goodsName||('库存批次 #'+batch.stockBatchId)}}</text><text class="stock-meta">库存批次 #{{batch.stockBatchId}} · 入库 {{batch.stockInDate||'日期未记录'}}</text></view><text class="stock-status">{{batch.businessStatusText}}</text></view>
          <view class="stock-quantities"><text>入库 {{batch.stockInText}}</text><text>当前剩余 {{batch.remainingText}}</text></view><view class="stock-quantities"><text>损耗 {{batch.lossText}}</text><text>废弃 {{batch.discardText}}</text></view><text class="stock-source">{{batch.purchaserText}} · {{batch.supplierText}}</text><view class="issue" wx:for="{{batch.issues}}" wx:key="*this" wx:for-item="issue">{{issue}}</view><view class="result-line"><text>当前结果 {{batch.currentResultText}}</text><text>{{batch.resultStatusText}}</text></view><view class="result-line"><text>最终结果 {{batch.finalResultText}}</text><text class="detail-link">查看库存详情 ›</text></view>
        </view>
      </view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
