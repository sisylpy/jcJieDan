<view class="page">
  <back-navbar style="height:{{navBarHeight}}rpx" title="采购经营分析" avatar="/images/back-gray.png" bindnavbuttontap="toBack"></back-navbar>
  <scroll-view scroll-y class="body" style="padding-top:{{navBarHeight}}rpx">
    <view class="query-card">
      <report-date-filter label="{{dateLabel}}" start-date="{{startDate}}" stop-date="{{stopDate}}" bindselect="toDatePage"></report-date-filter>
      <text class="time-note">{{timeBasisText||'订单、采购与损耗分别按真实业务发生日期归期'}}</text>
    </view>

    <view wx:if="{{error}}" class="state error-state"><text>采购经营分析读取失败</text><text class="state-detail">{{error}}</text><text class="retry" bindtap="retry">重新加载</text></view>
    <view wx:elif="{{loading}}" class="state">正在核对期间订单、采购与损耗…</view>
    <block wx:else>
      <view class="result-card {{summary.resultStatus==='PARTIAL'?'partial':''}}">
        <view class="result-heading">
          <view><text class="eyebrow">期间经营结果</text><text class="result-value {{summary.operatingResultNegative?'negative':''}}">{{summary.operatingResultText}}</text></view>
          <text class="status-pill {{summary.resultStatus==='COMPLETE'?'complete':summary.resultStatus==='PARTIAL'?'warning':'muted'}}">{{summary.resultStatusText}}</text>
        </view>
        <text class="recognized-result" wx:if="{{summary.resultStatus==='PARTIAL'}}">已核算部分 {{summary.recognizedOperatingResultText}}，待核算数据未按 0 计入</text>
        <view class="result-grid">
          <view class="metric"><text class="metric-label">销售收入</text><text class="metric-value">{{summary.salesRevenueText}}</text></view>
          <view class="metric"><text class="metric-label">订单采购成本</text><text class="metric-value">{{summary.orderPurchaseCostText}}</text></view>
          <view class="metric"><text class="metric-label">订单毛利</text><text class="metric-value">{{summary.orderMarginText}}</text><text class="metric-note">毛利率 {{summary.orderMarginRateText}}</text></view>
          <view class="metric"><text class="metric-label">库存损耗</text><text class="metric-value cost">{{summary.lossCostText}}</text><text class="metric-note">{{summary.lossFactCount}} 笔</text></view>
          <view class="metric"><text class="metric-label">库存废弃</text><text class="metric-value cost">{{summary.discardCostText}}</text><text class="metric-note">{{summary.discardFactCount}} 笔</text></view>
          <view class="metric"><text class="metric-label">可核算订单</text><text class="metric-value">{{summary.profitEligibleOrderCount}} / {{summary.periodOrderLineCount}}</text><text class="metric-note">经营率 {{summary.operatingMarginRateText}}</text></view>
        </view>
        <text class="result-note">未售库存仍属于库存资产，不把本期全部采购额直接认定为成本；降价已体现在真实销售收入中，不重复扣减。</text>
      </view>

      <view class="issue-card" wx:if="{{summary.dataIssueCount}}">
        <view class="issue-mark">!</view>
        <view class="issue-copy"><text class="issue-title">有 {{summary.dataIssueCount}} 项依据需要补充</text><text class="issue-detail" wx:if="{{summary.profitIneligibleOrderCount}}">{{summary.profitIneligibleOrderCount}} 条订单缺少销售额、成本价或实际数量</text><text class="issue-detail" wx:if="{{summary.unresolvedProfitSourceOrderCount}}">{{summary.unresolvedProfitSourceOrderCount}} 条已核算订单尚未归到明确采购来源</text><text class="issue-detail" wx:if="{{summary.unresolvedLossAmountCount}}">{{summary.unresolvedLossAmountCount}} 条损耗事实缺少成本金额</text><text class="issue-detail" wx:if="{{summary.legacyLossFactCount}}">{{summary.legacyLossFactCount}} 条历史损耗缺少新事实快照</text><text class="issue-detail" wx:if="{{purchaseAmount.unresolvedAmountCount||purchaseAmount.conflictRecordCount}}">采购记录中有 {{purchaseAmount.unresolvedAmountCount}} 条金额未形成、{{purchaseAmount.conflictRecordCount}} 条来源冲突</text><text class="issue-detail" wx:if="{{purchaseAmount.historicalBillUnresolvedCount}}">{{purchaseAmount.historicalBillUnresolvedCount}} 条历史协作账单缺少可核对订单关联</text></view>
      </view>

      <view class="section-card">
        <view class="section-heading"><view><text class="section-title">订单利润来源</text><text class="section-subtitle">只汇总具备销售额、采购成本和实际数量的订单</text></view><text class="section-count">{{summary.profitEligibleOrderCount}} 条</text></view>
        <view wx:if="{{!orderSourceGroups.length}}" class="empty-inline">所选日期内暂无可核算订单</view>
        <view wx:else class="source-list">
          <view class="source-row" wx:for="{{orderSourceGroups}}" wx:key="sourceType">
            <view class="source-mark {{item.tone}}">{{item.mark}}</view>
            <view class="source-copy"><view class="source-title-row"><text class="source-title">{{item.sourceTypeText}}</text><text class="source-count">{{item.orderCount}} 条</text></view><text class="source-description">{{item.sourceDescription}}</text><view class="source-metrics"><text>收入 {{item.salesRevenueText}}</text><text>成本 {{item.purchaseCostText}}</text><text class="source-margin {{item.marginNegative?'negative':''}}">毛利 {{item.orderMarginText}} · {{item.orderMarginRateText}}</text></view></view>
          </view>
        </view>
      </view>

      <view class="section-card purchase-card">
        <view class="section-heading"><view><text class="section-title">采购覆盖</text><text class="section-subtitle">采购额用于规模核对，不直接等同期间利润成本</text></view><text class="detail-link" bindtap="openPurchaseRecords">查看明细 ›</text></view>
        <view class="purchase-total"><view><text class="purchase-label">已识别采购额</text><text class="purchase-value">{{purchaseAmount.recognizedAmountText}}</text></view><view class="purchase-counts"><text>{{purchaseAmount.includedRecordCount}} 条已识别</text><text wx:if="{{purchaseAmount.unresolvedAmountCount}}">{{purchaseAmount.unresolvedAmountCount}} 条待形成</text></view></view>
        <view class="purchase-groups">
          <view class="purchase-group" wx:for="{{purchaseAmount.groups}}" wx:key="sourceType"><text class="purchase-group-name">{{item.sourceTypeText}}</text><text class="purchase-group-amount">{{item.recognizedAmountText}}</text><text class="purchase-group-count">{{item.includedRecordCount}} 条<text wx:if="{{item.unresolvedAmountCount}}"> · {{item.unresolvedAmountCount}} 条待核对</text></text></view>
        </view>
        <text class="purchase-note" wx:if="{{purchaseAmount.pendingDemandCount||purchaseAmount.undatedRecordCount}}">另有 {{purchaseAmount.pendingDemandCount}} 条待采购需求、{{purchaseAmount.undatedRecordCount}} 条缺少可靠业务日期，均未补入本期金额。</text>
      </view>

      <view class="section-card product-section">
        <view class="section-heading"><view><text class="section-title">商品经营明细</text><text class="section-subtitle">本期采购、订单及期间库存损耗涉及的全部商品，按商品大类查看</text></view><text class="section-count">{{productCount}} 种</text></view>
        <view wx:if="{{!productCount}}" class="empty-inline">所选日期内暂无采购、订单或确认的库存损耗商品</view>
        <view wx:else class="inventory-layout">
          <scroll-view scroll-y class="category-rail">
            <view wx:for="{{categories}}" wx:key="id" class="category-item {{activeCategoryId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory"><text>{{item.name}}</text><text class="category-count">{{item.count}}</text></view>
          </scroll-view>
          <view class="product-column">
            <view class="list-heading"><text>共 {{products.length}} 种商品</text><text class="sort-note">订单商品优先</text></view>
            <view class="product-card" wx:for="{{products}}" wx:key="id">
              <view class="product-main">
                <image class="goods-image" src="{{item.goodsImageUrl}}" mode="aspectFill"></image>
                <view class="product-copy">
                  <view class="product-title-row"><text class="goods-name">{{item.goodsName}}</text><text class="product-status {{item.statusClass}}">{{item.resultStatusText}}</text></view>
                  <text class="product-orders">采购 {{item.purchaseRecordCount}} 条 · 已识别采购额 {{item.recognizedPurchaseAmountText}}</text>
                  <text class="product-orders">订单 {{item.orderLineCount}} 条 · 可核算 {{item.profitEligibleOrderCount}} 条</text>
                  <text class="product-loss">{{item.lossSummary}} · 损耗 {{item.lossCostText}} · 废弃 {{item.discardCostText}}</text>
                </view>
              </view>
              <view class="product-metrics">
                <view><text>销售收入</text><text class="product-metric-value">{{item.salesRevenueText}}</text></view>
                <view><text>订单毛利</text><text class="product-metric-value">{{item.orderMarginText}}</text></view>
                <view><text>经营结果</text><text class="product-metric-value {{item.operatingResultNegative?'negative':''}}">{{item.operatingResultText}}</text></view>
              </view>
              <text class="product-recognized" wx:if="{{item.resultStatus==='PARTIAL'}}">已核算部分 {{item.recognizedOperatingResultText}}；另有 {{item.issueCount}} 项依据待补充，未按 0 计入</text>
              <text class="product-recognized" wx:elif="{{item.purchaseIssueCount}}">另有 {{item.purchaseIssueCount}} 条采购金额或来源待核对，未按 0 计入</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
