/* 页面容器：flex 布局，自适应填充 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}
.content-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

/* 搜索框 */
.search-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1px solid #eee;
}
.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 28rpx;
}
.search-actions {
  display: flex;
  gap: 12rpx;
}
.btn-search {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  background: #0a8a72;
  color: #fff;
  border-radius: 32rpx;
  border: none;
}
.btn-search::after { border: none; }
.btn-cancel {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 32rpx;
  border: none;
}
.btn-cancel::after { border: none; }

/* 搜索结果 */
.search-result-scroll {
  flex: 1;
  min-height: 0;
  background: #f5f5f5;
}
.search-result-wrap {
  padding-bottom: 40rpx;
}
.search-section {
  margin-bottom: 24rpx;
}
.search-section-title {
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  background: #fff;
  border-bottom: 1px solid #eee;
}

/* Tabs */
.tabs-bar {
  flex-shrink: 0;
  background: #fff;
  border-bottom: 1px solid #eee;
  padding: 0 20rpx;
}
.tabs-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #666;
  padding: 20rpx 0;
}
.tab-item.tab-active {
  color: #0a8a72;
  font-weight: 600;
  border-bottom: 4rpx solid #0a8a72;
}
.tab-count {
  font-size: 28rpx;
  color: #999;
  margin-left: 4rpx;
}
.tab-item.tab-active .tab-count {
  color: #0a8a72;
}

.swiper-wrap {
  flex: 1;
  min-height: 0;
  background: #f5f5f5;
}
swiper-item {
  height: 100%;
}
.scroll-content {
  height: 100%;
  background: #f5f5f5;
}

/* 未处理 / 申请添加 列表 */
.goods-list-wrap {
  background: #fff;
  margin-bottom: 2rpx;
}
.goods-row {
  align-items: flex-start;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 推荐 tab */
.recommend-wrap {
  padding-bottom: 16rpx;
}
.recommend-parent {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-bottom: 1px solid #eee;
}
.recommend-parent-name {
  font-size: 28rpx;
  color: #333;
}
.recommend-parent-spec {
  font-size: 24rpx;
  color: #7a8594;
}

.shelf-list-wrap {
  padding: 12rpx 20rpx 0;
}
.recommend-goods-wrap {
  padding: 8rpx 20rpx 12rpx;
}
.shelf-list-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1px solid #e5e5e5;
}
/* 推荐商品紧凑样式 */
.recommend-wrap .shelf-list-item {
  padding: 12rpx 16rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
}
.recommend-wrap .shelf-list-thumb {
  width: 100rpx;
  height: 100rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
}

.recommend-wrap .shelf-list-title-text {
  gap: 2rpx;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
}
.recommend-wrap .shelf-list-info {
  gap: 8rpx;
}
.recommend-wrap .recommend-actions {
  margin-top: 6rpx;
  gap: 12rpx;
}
.recommend-wrap .btn-download,
.recommend-wrap .btn-equal,
.recommend-wrap .btn-apply-add-inline {
  padding: 14rpx 16rpx;
  font-size: 24rpx;
}
.recommend-wrap .btn-download .icon-sm {
  width: 28rpx;
  height: 28rpx;
}
.shelf-list-thumb {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}
.shelf-list-thumb .goods_item_lg,
.shelf-list-img {
  width: 100%;
  height: 100%;
}
.shelf-list-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.shelf-list-img.placeholder .placeholder-img,
.goods-img.placeholder .placeholder-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.shelf-list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.shelf-list-title {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex-wrap: wrap;
}
.shelf-list-brand {
  font-size: 24rpx;
  color: #0a8a72;
  padding: 2rpx 10rpx;
  background: rgba(10, 138, 114, 0.12);
  border-radius: 8rpx;
}
.shelf-list-title-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.shelf-list-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.shelf-list-spec {
  font-size: 24rpx;
  color: #7a8594;
}
.recommend-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
}
.btn-download {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.btn-download .icon-sm {
  width: 32rpx;
  height: 32rpx;
}
.btn-equal {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #fff;
}

.btn-equal-active {
  background: #00a398;
  color: #ffffff;
}
.btn-equal-disabled {
  background: #ccc !important;
  color: #999;
  opacity: 0.7;
}
.btn-apply-add-inline {
  padding: 26rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #e65100;
  background: #fff3e0;
  border: 1px dashed #ff9800;
}
.apply-add-wrap {
  padding: 20rpx 0;
}
.btn-apply-add {
  padding: 20rpx;
  text-align: center;
  background: #fff3e0;
  color: #e65100;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 1px dashed #ff9800;
}

.recommend-readonly {
  padding: 10rpx 0;
}
.mt-10 { margin-top: 10rpx; }

/* 已处理 - 转换记录 */
.conversion-list {
  padding: 4rpx 10rpx;
}
.done-item-row {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.done-item-left {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-right: 20rpx;
  gap: 12rpx;
  border-right: 1rpx solid #eee;
}
.done-temp-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.done-temp-info .font-xs {
  color: #999;
}
.done-temp-info .font-lg {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.btn-customer-service {
  width: 100%;
  padding: 16rpx 0;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
  border: 1rpx solid #e8e8e8;
}
.btn-cs-icon {
  width: 32rpx;
  height: 32rpx;
}
.btn-cs-text {
  font-size: 24rpx;
  font-weight: 500;
}
.done-item-right {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
  padding-left: 20rpx;
}
.done-goods-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f5f5f5;
}
.done-goods-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.done-goods-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.done-goods-img.placeholder .placeholder-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.done-goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.done-row-1 {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6rpx;
}
.done-goods-name {
  font-size: 32rpx;
  color: #333;
}
.done-goods-spec {
  font-size: 24rpx;
  color: #666;
}
.done-row-2,
.done-row-3 {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8rpx;
}
.done-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
.done-tags-wrap {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}
.done-tags-wrap .standard {
  padding: 4rpx 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
}
.standard-hover {
  background: #e0e0e0 !important;
}
.done-item-simple .done-item-right {
  align-items: center;
  justify-content: center;
}
.done-goods-info-simple {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
}
.done-item-simple .done-goods-info-simple {
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
.goods-brand-compact {
  font-size: 24rpx;
  color: #666;
}

/* 规格/别名 编辑删除弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: none;
  align-items: flex-end;
  justify-content: center;
}
.overlay.show {
  display: flex;
}
.overlay .popup-wrap {
  /* width: 90%; */
  padding: 0 40rpx;
  box-sizing: border-box;
}
.overlay .popup {
  /* width: 100%; */
  background: #fff;
  border-radius: 24rpx 24rpx 24rpx 24rpx;
  padding: 20rpx;
}

.bg-light { background: #f8f9fa; }
.empty-hint {
  text-align: center;
  line-height: 80rpx;
}

.sameShelf {
  border: 1px solid rgb(231, 153, 8);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

/* 图片弹窗 */
.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 0.3s ease;
}
.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #666;
}
.modal-body {
  padding: 30rpx;
  text-align: center;
}
.modal-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.image-info {
  text-align: left;
  padding: 20rpx 0;
}
.goods-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}
.goods-standard {
  display: block;
  font-size: 28rpx;
  color: #666;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slideUp {
  from { transform: translateY(100rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
