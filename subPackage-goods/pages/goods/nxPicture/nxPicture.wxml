

<view class="flex-column flex">


  <back-navbar style="height: {{navBarHeight}}rpx;" title="修改图片" avatar="/images/back-gray.png" button-text="设置" bindnavbuttontap="toBack"></back-navbar>


	<view class="p-20 flex-row-default border-bottom">
   <text class="margin-right" >商品名称:</text>
   <input class="group_input normal"  disabled="true" value="{{editItem.nxGoodsName}}" > </input>
 </view>


 <view class="flex-column p-20 font-md">
 
 <button bindtap="chooseImage" style="margin-bottom: 100rpx; margin-top: 40rpx;">上传图片</button>
 <view class="flex-row-default">
 <text class="margin-right">浏览图:</text>
 <image wx:if="{{thumbnailPath}}" src="{{thumbnailPath}}" style="width: 100px; height: 100px; margin-bottom: 20rpx;" />
 </view>

 <view class="flex-row-default with-padding">
   <text class="margin-right">大图:</text>
   <image wx:if="{{largeImagePath}}" src="{{largeImagePath}}" style="width: 300px; height: 300px;" />

 </view>
<canvas canvas-id="myCanvas" style="width: 300px; height: 300px;" />

</view>



</view>