  font-size: 26rpx;
  color: #fff;
  background-color: #187e6e;
}

.tier-row{
  border-bottom: 1px solid rgb(233, 231, 231);
}

/* ===== Tab 导航栏（固定在导航栏下方，top 由 wxml 内联 style 设为 navBarHeight） ===== */
.page-header-placeholder {
  width: 100%;
}

.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  flex-direction: row;
  background-color: #fff;
  border-bottom: 1px solid rgb(233, 231, 231);
}

.tab-item {
  flex: 1;
  text-align: center;
  line-height: 104rpx;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.tab-active {
  color: #187e6e;
  font-weight: bold;
}

.tab-item.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #187e6e;
  border-radius: 2rpx;
}
